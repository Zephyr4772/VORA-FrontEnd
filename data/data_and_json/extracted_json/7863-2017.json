    "full_text": "1 \n \n\u0905\u092a\u094d\u0930\u0924\u093f\u0935\u0947\u0926\u094d\u092f  \n\u092d\u093e\u0930\u093f\u0940\u092f \u0938\u0935\u094b\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \n\u0926\u093e\u093e\u0902\u0921\u093f\u0915 \u0905\u092a\u0940\u0932\u0940\u092f \u0905\u0927\u093f\u0915\u093e\u0930\u0930\u093f\u093e \n\u0926\u093e\u093e\u0902\u0921\u093f\u0915 \u0905\u092a\u0940\u0932 \u0938\u093e\u0902. 1157/2019 \n(\u090f\u0938.\u090f\u0932.\u092a\u0940. (\u0926\u093e\u093e\u0902\u0921\u093f\u0915) \u0938\u093e\u0902. 2663/2017 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928) \n \n\u0905\u0928\u093f\u0932 \u0916\u095c\u0915\u0940\u0935\u093e\u0932\u093e    \n      \n..............\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940(\u0917\u0923) \n\u092c\u093f\u093e\u092e \n\u0930\u093e\u091c\u094d\u092f (\u0930\u093e.\u0930\u093e.\u0915\u094d\u0937\u0947. \u0926\u093f\u0932\u094d\u0932\u0940 \u0938\u0930\u0915\u093e\u0930) \u090f\u0935\u0902 \u0905\u0928\u094d\u092f        .................\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940(\u0917\u0923) \n \n\u0924\u0928\u0930\u094d\u0923\u092f  \n\u0928\u0935\u0940\u0928 \u0938\u0938\u0928\u094d\u0939\u093e, \u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0924\u093f\u0923 \n\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u093f\u0902\u0921 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0902\u0926\u093f\u0924\u093e \u0915\u0940 \u0927\u093e\u0930\u093e 482 \u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \u093f\u093e\u0916\u0916\u0932 \n\u0915\u0940 \u0917\u0908 \u0936\u093f\u0915\u093e\u092f\u0924 \u0935\u093e\u093f \u0938\u0902. 3403/1/2015 \u092e\u0947\u0902 \u091c\u093e\u0930\u0940 \u0938\u092e\u094d\u092e\u093f \u0915\u094b \u0905\u092e\u093e\u0928\u094d\u092f \n\u0920\u093f\u0930\u093e\u093f\u0947 \u093f\u0947\u0924\u0941 \u0926\u093f\u090f \u0917\u090f \u0906\u0935\u0947\u093f\u093f \u0915\u094b \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u093f \u0935\u0935\u091a\u093e\u0930 \u0915\u0930\u0924\u0947 \n\u093f\u0941\u090f \u0930\u0926\u094d\u093f \u0915\u094d\u0930\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e \u0915\u094d\u0930\u0915, \u0915\u094d\u092f\u094b\u0902\u0915\u094d\u0930\u0915 \u0907\u0938\u0940 \u0930\u093e\u093f\u0924 \u093f\u0947\u0924\u0941 \u092a\u0942\u0935\u0917 \u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u0935\u0935\u0935\u0935\u0927 \n\u0935\u093e\u093f \u0938\u0902. 877/2005 \u092a\u093f\u0932\u0947 \u0938\u0947 \u093f\u0940 \u0916\u093e\u0930\u0930\u091c \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u093f\u0948, \u093f\u0942\u0938\u0930\u093e \u0906\u0935\u0947\u093f\u093f \n\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u093f\u0947 \u092f\u094b\u0917\u094d\u092f \u093f\u093f\u0940\u0902 \u093f\u0948 |  \n2. \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0938\u0902. 2 \u093f\u0947 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0915\u0947 \u0916\u0916\u0932\u093e\u092b \u092a\u0930\u093f\u093e\u092e\u094d\u092f \u0936\u0932\u0916\u0924 \u0905\u0927\u0927\u0928\u093f\u092f\u092e \n(\u0907\u0938\u0915\u0947 \u092c\u093e\u093f \"\u0905\u0927\u0927\u0928\u093f\u092f\u092e\" \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0902\u093f\u0936\u092d\u0917\u0924) \u0915\u0940 \u0927\u093e\u0930\u093e 142 \u0938\u093f\u092a\u0926\u0920\u0924 \u0927\u093e\u0930\u093e \n138 \u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \u0936\u093f\u0915\u093e\u092f\u0924 \u093f\u091c\u0917 \u0915\u0940 \u091c\u094b \u092a\u094d\u0930\u0936\u094d\u093f\u0917\u0924 \u0915\u0902\u092a\u093f\u0940 \u092e\u0947\u0938\u0938\u0917 \u0908.\u091f\u0940.\u0906\u0908. \n\u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u094d\u0938 \u0936\u0932\u0936\u092e\u091f\u0947\u0921 \u0915\u0947 \u0928\u093f\u093f\u0947\u093f\u0915 \u0930\u094d\u0925\u0947\u0964 \u092f\u093f \u0906\u0930\u094b\u092a \u0932\u0917\u093e\u092f\u093e \u0917\u092f\u093e \u0915\u094d\u0930\u0915 \u0906\u0930\u094b\u092a\u0940 \n\n2 \n \n\u0935\u094d\u092f\u0915\u094d\u0915\u094d\u0924 \u093f\u0947 \u0926\u093f\u093f\u093e\u0902\u0915 15.02.2001 \u0914\u0930 28.02.2001 \u0915\u0947 \u091a\u0947\u0915 \u091c\u093e\u0930\u0940 \u0915\u094d\u0930\u0915\u090f \u0930\u094d\u0925\u0947, \u091c\u094b \n\u0915\u094d\u0930\u0915 \u091a\u0947\u0915 \u0909\u0924\u094d\u0924\u0930-\u0926\u093f\u093f\u093e\u0902\u0915\u094d\u0930\u0915\u0924 \u0930\u094d\u0925\u0947 | \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u093f\u0947 \u0907\u0938\u0947 \u0930\u0926\u094d\u093f \u0915\u0930\u093f\u0947 \u0915\u0947 \u0936\u0932\u090f \n\u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u0935\u0935\u0935\u0935\u0927 \u092f\u093e\u0927\u091a\u0915\u093e \u0938\u0902. 1459/2005 \u093f\u093e\u092f\u0930 \u0915\u0940 | \u0909\u0928\u094d\u093f\u094b\u0902\u093f\u0947 \u092c\u092c\u093f\u093e \u0915\u094d\u0930\u0915\u0938\u0940 \n\u0938\u092c\u0942\u0924 \u0915\u0947 \u092f\u093f \u092c\u091a\u093e\u0935 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u094d\u0930\u0915\u092f\u093e \u0915\u094d\u0930\u0915 \u0909\u0928\u094d\u093f\u094b\u0902\u093f\u0947 \u092a\u093f\u0932\u0947 \u093f\u0940 \u0926\u093f\u093f\u093e\u0902\u0915 20.12.2000 \n\u0915\u094b \u0915\u0902\u092a\u093f\u0940 \u0938\u0947 \u0907\u0938\u094d\u0924\u0940\u092b\u093e \u093f\u0947 \u0926\u093f\u092f\u093e \u0930\u094d\u0925\u093e \u0914\u0930 \u0915\u094d\u091c\u0938\u0947 \u0928\u093f\u093f\u0947\u093f\u0915 \u092e\u0902\u0921\u0932 \u093f\u0947 20.01.2001 \n\u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0936\u0932\u092f\u093e \u0930\u094d\u0925\u093e | \u0907\u0938\u094d\u0924\u0940\u092b\u0947 \u0915\u0947 \u0928\u093f\u0935\u0947\u093f\u093f \u0915\u094b \u093f\u0947\u0916\u093f\u0947 \u0915\u0947 \u092c\u093e\u093f \u0926\u093f\u093f\u093e\u0902\u0915 \n18.09.2007 \u0915\u094b \u0906\u0935\u0947\u093f\u093f \u0915\u0947\u0935\u0932 \u0907\u0938 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0916\u093e\u0930\u0930\u091c \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e \n\u0915\u094d\u0930\u0915 \u091a\u0947\u0915 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0915\u0947 \u093f\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0938\u0947 \u091c\u093e\u0930\u0940 \u0915\u094d\u0930\u0915\u090f \u0917\u090f \u0930\u094d\u0925\u0947 |  \n3. \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u093f\u0947 \u0907\u0938\u0915\u0947 \u092a\u0936\u094d\u091a\u093e\u0924 \u0927\u093e\u0930\u093e 482 \u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \u0935\u0924\u0917\u092e\u093e\u093f \u0915\u093e\u092f\u0917\u0935\u093e\u093f\u0940 \u0915\u094b \n\u092a\u094d\u0930\u093e\u0930\u092e\u094d\u092d \u0915\u0930\u093f\u0947 \u0935\u093e\u0932\u093e \u090f\u0915 \u093f\u092f\u093e \u0906\u0935\u0947\u093f\u093f \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u094d\u0930\u0915\u092f\u093e | \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u093f\u0947 \n\u0915\u0902\u092a\u093f\u0940 \u0905\u0927\u0927\u0928\u093f\u092f\u092e, 1956 \u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \u0915\u0902\u092a\u093f\u0940 \u0930\u0915\u094d\u091c\u0938\u094d\u0930\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u092b\u0949\u092e\u0917 32 \n\u092a\u0930 \u0928\u093f\u092d\u0917\u0930\u0924\u093e \u0915\u094b \u093f\u0947\u0916\u0924\u0947 \u093f\u0941\u090f, \u091a\u0947\u0915 \u091c\u093e\u0930\u0940 \u0915\u0930\u093f\u0947 \u0938\u0947 \u092a\u093f\u0932\u0947 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0926\u094d\u0935\u093e\u0930\u093e \n\u0907\u0938\u094d\u0924\u0940\u092b\u0947 \u0915\u0947 \u092a\u094d\u0930\u092e\u093e\u0923 \u092e\u0947\u0902, \u093f\u094b\u0926\u091f\u0938 \u091c\u093e\u0930\u0940 \u0915\u094d\u0930\u0915\u092f\u093e, \u0915\u094d\u091c\u0938\u0938\u0947 \u092c\u093e\u093f \u092e\u0947\u0902 \u092c\u0916\u093e\u0917\u0938\u094d\u0924\u0917\u0940 \u0915\u093e \n\u092a\u094d\u0930\u0936\u094d\u093f\u0917\u0924 \u0906\u093f\u0947\u093f \u091c\u093e\u0930\u0940 \u093f\u094b \u0917\u092f\u093e\u0964 \n4. \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0935\u0935\u0926\u094d\u0935\u093e\u093f \u0905\u0927\u0927\u0935\u0915\u094d\u0924\u093e \u093f\u0947 \u0928\u093f\u0935\u0947\u093f\u093f \u0915\u094d\u0930\u0915\u092f\u093e \u0915\u094d\u0930\u0915 \u092e\u093e\u092e\u0932\u0947 \n\u0915\u0947 \u0905\u0938\u093e\u0927\u093e\u0930\u0923 \u0924\u0925\u094d\u092f\u094b\u0902 \u0914\u0930 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u092e\u0947\u0902 \u0927\u093e\u0930\u093e 482, \u093f\u0902\u0921 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0902\u0926\u093f\u0924\u093e \u0915\u0947 \n\u0905\u0902\u0924\u0917\u0917\u0924 \u093f\u0942\u0938\u0930\u0947 \u0906\u0935\u0947\u093f\u093f \u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u092f\u0917\u0924\u093e \u092a\u0930 \u0915\u094b\u0908 \u0930\u094b\u0915 \u093f\u093f\u0940\u0902 \u0930\u094d\u0925\u0940, \n\n3 \n \nSuperintendent and Remembrancer of Legal Affiars, West \nBengal Vs. Mohan Singh and Ors., AIR 1975 SC 1002 \u092e\u093e\u092e\u0932\u0947 \n\u0915\u094b \u0906\u0927\u093e\u0930 \u092c\u093f\u093e\u0924\u0947 \u093f\u0941\u090f |  \n5. \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0938\u0902. 2 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0935\u0935\u0926\u094d\u0935\u093e\u093f \u0905\u0927\u0927\u0935\u0915\u094d\u0924\u093e \u093f\u0947 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \n\u092e\u093e\u092e\u0932\u0947 \u0905\u0924\u0941\u0932 \u093f\u0941\u0915\u094d\u0932\u093e \u092c\u093f\u093e\u092e \u092e\u0927\u094d\u092f \u092a\u094d\u0930\u093f\u0947\u093f \u0930\u093e\u091c\u094d\u092f \u0935 \u0905\u0928\u094d\u092f (\u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u0905\u092a\u0940\u0932 \n\u0938\u0902. 837/2019) \u0915\u0947 \u0906\u093f\u0947\u093f \u0926\u093f\u093f\u093e\u0902\u0915 06.05.2019 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u091c\u0924\u093e\u092f\u093e \u093f\u0948 \u0914\u0930 \n\u0924\u0915\u0917 \u0926\u093f\u092f\u093e \u093f\u0948 \u0915\u094d\u0930\u0915 \u0910\u0938\u093e \u0906\u0935\u0947\u093f\u093f \u0938\u094d\u0935\u0940\u0915\u093e\u092f\u0917 \u093f\u093f\u0940\u0902 \u093f\u0948 | \u091a\u0947\u0915\u094b\u0902 \u0915\u0947 \u0909\u0924\u094d\u0924\u0930-\u0926\u093f\u093f\u093e\u0902\u0915\u094d\u0930\u0915\u0924 \n\u091c\u093e\u0930\u0940 \u093f\u094b\u093f\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923, \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0905\u092a\u093f\u0940 \u091c\u0935\u093e\u092c\u093f\u0947\u093f\u0940 \u0938\u0947 \u092c\u091a \u093f\u093f\u0940\u0902 \u0938\u0915\u0924\u093e |  \n6. \u093f\u092e\u093f\u0947 \u092a\u0915\u094d\u0937\u0915\u093e\u0930\u094b\u0902 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u0927\u0924 \u0928\u093f\u0935\u0947\u093f\u093f\u094b\u0902 \u092a\u0930 \u0935\u0935\u091a\u093e\u0930 \u0915\u094d\u0930\u0915\u092f\u093e \u093f\u0948 \u0914\u0930 \n\u093f\u092e\u093e\u0930\u0940 \u0930\u093e\u092f \u093f\u0948 \u0915\u094d\u0930\u0915 \u0907\u0938\u0915\u0947 \u092c\u093e\u093f \u0935\u0916\u0923\u0917\u0924 \u0915\u093e\u0930\u0923\u094b\u0902 \u0938\u0947 \u0905\u092a\u0940\u0932 \u0915\u0940 \u0905\u093f\u0941\u092e\u0928\u0924 \u093f\u0940 \u091c\u093e\u093f\u0940 \n\u091a\u093e\u0926\u093f\u090f \u0964  \n7. \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0938\u0902. 2 \u0926\u094d\u0935\u093e\u0930\u093e \u093f\u093e\u092f\u0930 \u0936\u093f\u0915\u093e\u092f\u0924 \u092e\u0947\u0902 \u0906\u0930\u094b\u092a \u0932\u0917\u093e\u092f\u093e \u0917\u092f\u093e \u093f\u0948 \u0915\u094d\u0930\u0915 \n\u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u093f\u0947\u093f\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u093f\u093f\u093e\u0902\u0915 15.02.2001 \u0924\u0930\u094d\u0925\u093e \n28.02.2001 \u0915\u094b \u091a\u0947\u0915 \u091c\u093e\u0930\u0940 \u0915\u094d\u0930\u0915\u092f\u0947 \u0917\u090f \u0930\u094d\u0925\u0947 |  \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u093f\u0947 \u0938\u093e\u0902\u0935\u0935\u0927\u0927\u0915 \u0938\u0942\u091a\u093f\u093e \n\u0915\u0947 \u092a\u094d\u0930\u0928\u0924 \u0905\u092a\u093f\u0947 \u091c\u0935\u093e\u092c \u0926\u093f\u093f\u093e\u0902\u0915 31.08.2001 \u092e\u0947\u0902 \u0926\u093f\u093f\u093e\u0902\u0915 20.01.2001 \u0915\u094b \n\u0905\u092a\u093f\u093e \u0907\u0938\u094d\u0924\u0940\u092b\u093e \u093f\u0947 \u093f\u0947\u093f\u0947 \u0915\u0947 \u092e\u0926\u094d\u093f\u0947\u093f\u095b\u0930 \u0905\u092a\u093f\u0940 \u091c\u0935\u093e\u092c\u093f\u0947\u093f\u0940 \u0938\u0947 \u0907\u0902\u0915\u093e\u0930 \u0915\u094d\u0930\u0915\u092f\u093e \u093f\u0948 |  \n\u0907\u0938 \u0924\u0925\u094d\u092f \u0915\u093e \u0936\u093f\u0915\u093e\u092f\u0924 \u092e\u0947\u0902 \u0909\u0932\u094d\u0932\u0947\u0916 \u093f\u093f\u0940\u0902 \u0936\u092e\u0932\u0924\u093e \u093f\u0948 | \u0936\u093f\u0915\u093e\u092f\u0924 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0910\u0938\u093e \n\n4 \n \n\u0906\u0930\u094b\u092a \u093f\u093f\u0940\u0902 \u093f\u0948 \u0915\u094d\u0930\u0915 \u091a\u0947\u0915 \u0909\u0924\u094d\u0924\u0930-\u0926\u093f\u093f\u093e\u0902\u0915\u094d\u0930\u0915\u0924 \u0930\u094d\u0925\u0947 | \u0915\u094d\u0930\u092b\u0930 \u092d\u0940, \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u093f\u0947 \u093f\u0902\u0921 \n\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0902\u0926\u093f\u0924\u093e \u0915\u0940 \u0927\u093e\u0930\u093e 482 \u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \u0905\u092a\u093f\u0947 \u092a\u093f\u0932\u0947 \u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u092e\u0947\u0902 \u090f\u0915 \n\u0935\u0935\u0936\u093f\u0937\u094d\u091f \u0906\u092a\u0935\u0924\u094d\u0924 \u0909\u0920\u093e\u0908 \u0915\u0940 \u0930\u094d\u0925\u0940 \u0915\u094d\u0930\u0915 \u0909\u0928\u094d\u093f\u094b\u0902\u093f\u0947 \u0926\u093f\u093f\u093e\u0902\u0915 20.01.2001 \u0915\u094b \u0915\u0902\u092a\u093f\u0940 \u0938\u0947 \n\u0907\u0938\u094d\u0924\u0940\u092b\u093e \u093f\u0947 \u0926\u093f\u092f\u093e \u0930\u094d\u0925\u093e \u0915\u094d\u091c\u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0936\u0932\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e\u0964 \u0907\u0938\u0938\u0947 \u092a\u0942\u0935\u0917 \u0909\u091a\u094d\u091a \n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0906\u093f\u0947\u093f \u0915\u0947 \u0938\u093e\u0930 \u0938\u0947 \u092f\u093f \u092a\u094d\u0930\u0924\u0940\u0924 \u093f\u093f\u0940\u0902 \u093f\u094b\u0924\u093e \u093f\u0948 \u0915\u094d\u0930\u0915 \u0915\u0902\u092a\u093f\u0940 \u0930\u0915\u094d\u091c\u0938\u094d\u0930\u093e\u0930 \n\u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u092b\u093e\u092e\u0917 32 \u0915\u094b \u0907\u0938\u094d\u0924\u0940\u092b\u0947 \u0915\u0947 \u0938\u092e\u0930\u094d\u0925\u0917\u093f \u092e\u0947\u0902 \u0905\u0936\u092d\u0936\u0932\u0916\u0916\u0924 \u0915\u094d\u0930\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e\u0964 \n\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u093f\u0947 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0907\u0938 \u0924\u0915\u0917 \u092a\u0930 \u0935\u0935\u091a\u093e\u0930 \u0915\u094d\u0930\u0915\u090f \u092c\u092c\u093f\u093e \u0915\u094d\u0930\u0915 \u0909\u0928\u094d\u093f\u094b\u0902\u093f\u0947 \n\u091a\u0947\u0915 \u091c\u093e\u0930\u0940 \u0915\u0930\u093f\u0947 \u0938\u0947 \u092a\u093f\u0932\u0947 \u0915\u0902\u092a\u093f\u0940 \u0915\u0947 \u0928\u093f\u093f\u0947\u093f\u0915 \u0915\u0947 \u092a\u093f \u0938\u0947 \u0907\u0938\u094d\u0924\u0940\u092b\u093e \u093f\u0947 \u0926\u093f\u092f\u093e \u0930\u094d\u0925\u093e \n\u0914\u0930 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0924\u0925\u094d\u092f\u094b\u0902 \u0914\u0930 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u092a\u0930 \u0909\u0938\u0915\u093e \u0915\u094d\u092f\u093e \u092a\u094d\u0930\u092d\u093e\u0935 \u092a\u095c\u093e, \n\u0905\u0936\u092d\u0916\u0902\u0921\u0921\u0924 \u0915\u0930\u093f\u0947 \u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u0915\u094b \u0916\u093e\u0930\u0930\u091c \u0915\u0930 \u0926\u093f\u092f\u093e | \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u093f\u0902\u0921 \n\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0902\u0926\u093f\u0924\u093e \u0915\u0940 \u0927\u093e\u0930\u093e 482 \u0915\u0947 \u0924\u093f\u0924 \u093f\u090f \u0906\u0935\u0947\u093f\u093f \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u092e\u0947\u0902 \u092b\u093e\u092e\u0917 32 \n\u092a\u094d\u0930\u092e\u093e\u0923 \u092a\u0924\u094d\u0930 \u093f\u0947\u0916\u093f\u0947 \u0915\u0947 \u092c\u093e\u093f \u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u093f\u094b\u0926\u091f\u0938 \u091c\u093e\u0930\u0940 \u0915\u0930\u093f\u0947 \u093f\u0947\u0924\u0941 \u0938\u0902\u0924\u0941\u0937\u094d\u091f \u0930\u094d\u0925\u093e | \n\u0938\u094d\u0935\u093e\u092d\u093e\u0935\u0935\u0915 \u0930\u0942\u092a \u0938\u0947 \u092a\u0942\u0935\u0917 \u0906\u0935\u0947\u093f\u093f \u0914\u0930 \u092c\u093e\u093f \u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u092e\u0947\u0902 \u0905\u0902\u0924\u0930 \u0930\u094d\u0925\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u094d\u0930\u0915 \u0907\u0938\u0938\u0947 \n\u092a\u0942\u0935\u0917 \u0935\u0948\u0927\u093e\u0928\u093f\u0915 \u092b\u0949\u092e\u0917 32 \u092a\u0930 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u0935\u091a\u093e\u0930 \u093f\u093f\u0940\u0902 \u093f\u0941\u0906 \u0930\u094d\u0925\u093e | \u0907\u0938\u094d\u0924\u0940\u092b\u0947 \u0915\u093e \n\u0924\u0925\u094d\u092f \u092a\u0915\u094d\u0937\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0935\u0935\u0935\u093e\u093f \u092e\u0947\u0902 \u093f\u093f\u0940\u0902 \u093f\u0948 \u0964 \u0905\u0924\u0903 \u092c\u093e\u093f \u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u0915\u094b, \u0915\u095c\u0947 \n\u093f\u092c\u094d\u093f\u094b\u0902 \u092e\u0947\u0902, \u0909\u0928\u094d\u093f\u0940\u0902 \u0938\u092e\u093e\u093f \u0924\u0925\u094d\u092f\u094b\u0902 \u0914\u0930 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0924\u092f\u094b\u0902 \u092a\u0930 \u0906\u0927\u093e\u0930\u0930\u0924 \u092a\u0941\u093f\u0930\u093e-\u0906\u0935\u0947\u093f\u093f \n\u093f\u093f\u0940\u0902 \u0915\u093f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u093f\u0948 |  \n\n5 \n \n8. \u092e\u094b\u0939\u0928 \u0938\u0938\u093e\u0902\u0939 (Supra) \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902, \u092f\u093f \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u094d\u0930\u0915\u092f\u093e \u0917\u092f\u093e \u0915\u094d\u0930\u0915 \u093f\u0902\u0921 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \n\u0938\u0902\u0926\u093f\u0924\u093e \u0915\u0940 \u0927\u093e\u0930\u093e 482 \u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \u090f\u0915 \u0905\u0928\u094d\u092f \u0905\u093f\u0941\u093f\u0936\u092e\u0915 \u0906\u0935\u0947\u093f\u093f \u092a\u0930\u0930\u0935\u0928\u0924\u0917\u0924 \n\u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u094d\u0935\u0940\u0915\u093e\u092f\u0917 \u0930\u094d\u0925\u093e \u0924\u0930\u094d\u0925\u093e \u092a\u0942\u0935\u0917 \u0906\u0935\u0947\u093f\u093f \u0915\u093e \u0930\u0926\u094d\u093f \u0915\u094d\u0930\u0915\u092f\u093e \u091c\u093e\u093f\u093e \u0907\u0938\u0915\u0947 \n\u0936\u0932\u090f \u0915\u094b\u0907 \u092c\u093e\u0927\u094d\u092f\u0924\u093e \u093f\u093f\u0940\u0902 \u093f\u0948, \u0924\u0930\u094d\u0925\u093e \u092f\u093f \u0935\u0935\u091a\u093e\u0930 \u0915\u0930\u0924\u0947 \u093f\u0941\u090f: \n\u201c2. .... \u092f\u093f\u093e\u093e\u0901 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924 \u092a\u0942\u0930\u0940 \u0924\u0930\u093f \u0936\u092d\u0928\u094d\u093f \u093f\u0948 | \u0935\u092a\u091b\u094d\u0932\u093e \n\u0906\u0935\u0947\u093f\u093f \u0915\u094d\u091c\u0938\u0947 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0930\u0926\u094d\u093f \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \n\u0930\u094d\u0925\u093e \u093f\u0902\u0921 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0902\u0926\u093f\u0924\u093e \u0915\u0940 \u0927\u093e\u0930\u093e 561-\u090f \u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \n\u0915\u093e\u092f\u0917\u0935\u093e\u093f\u0940 \u0915\u094b \u0905\u0936\u092d\u0916\u0902\u0921\u0921\u0924 \u0915\u0930\u093f\u0947 \u0915\u093e \u0906\u0935\u0947\u093f\u093f \u0930\u094d\u0925\u093e \u0924\u0930\u094d\u0925\u093e \u0909\u091a\u094d\u091a \n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u093f\u0947 \u0907\u0938\u0947 \u0907\u0938 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0916\u093e\u0930\u0930\u091c \u0915\u0930 \u0926\u093f\u092f\u093e \u0930\u094d\u0925\u093e \u0915\u094d\u0930\u0915 \n\u0905\u092d\u0940 \u0938\u093e\u0915\u094d\u0937\u094d\u092f \u093f\u094b\u093f\u093e \u092c\u093e\u0915\u0940 \u0930\u094d\u0925\u093e \u0924\u0930\u094d\u0925\u093e \u0909\u0938 \u0938\u094d\u0924\u0930 \u092a\u0930 \u0915\u093e\u092f\u0917\u0935\u093e\u093f\u0940 \u092e\u0947\u0902 \n\u093f\u0916\u0932 \u093f\u0947\u093f\u093e \u0935\u093e\u0902\u091b\u093f\u0940\u092f \u093f\u093f\u0940\u0902 \u0930\u094d\u0925\u093e | \u0932\u0947\u0915\u094d\u0930\u0915\u093f, \u0907\u0938\u0915\u0947 \u092a\u0936\u094d\u091a\u093e\u0924, \n\u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u092e\u093e\u092e\u0932\u093e \u0932\u0917\u092d\u0917 \u0921\u0947\u095d \u0935\u0930\u094d\u0917 \u0915\u0940 \u0905\u0935\u0927\u0927 \u0924\u0915 \u092c\u092c\u093f\u093e \n\u0915\u094d\u0930\u0915\u0938\u0940 \u092a\u094d\u0930\u0917\u0928\u0924 \u0915\u0947 \u0916\u0916\u0902\u091a\u0924\u093e \u0930\u093f\u093e \u0914\u0930 \u0910\u0938\u0940 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u092e\u0947\u0902 \n\u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0938\u0902. 1 \u0935 2 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u0927\u093e\u0930\u093e 561-\u090f \n\u0915\u0947 \u0905\u0902\u0924\u0917\u0917\u0924 \u0915\u093e\u092f\u0917\u0935\u093e\u093f\u0940 \u0915\u094b \u0905\u0936\u092d\u0916\u0902\u0921\u0921\u0924 \u0915\u0930\u093f\u0947 \u093f\u0947\u0924\u0941 \u093f\u092f\u093e \u0906\u0935\u0947\u093f\u093f \n\u0915\u0930\u093f\u0947 \u0915\u0947 \u0936\u0932\u090f \u092c\u093e\u0927\u094d\u092f \u0930\u094d\u0925\u0947 | \u0910\u0938\u093e \u093f\u0947\u0916\u093f\u093e \u0915\u0926\u0920\u093f \u093f\u0948 \u0915\u094d\u0930\u0915 \u0910\u0938\u0940 \n\u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u092e\u0947\u0902 \u0915\u094d\u0930\u0915\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0910\u0938\u093e \u0935\u0935\u0930\u094b\u0927 \u0915\u094d\u0930\u0915\u092f\u093e \n\u091c\u093e\u0924\u093e \u0915\u094d\u0930\u0915  \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0938\u0947 \u0905\u093f\u0941\u093f\u0936\u092e\u0915 \u0906\u0935\u0947\u093f\u093f \u093f\u093e\u0916\u0916\u0932 \n\u0915\u0930\u0915\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u093f\u0947 \u0915\u094b \u0915\u093f\u093e \u091c\u093e \u0930\u093f\u093e \u0930\u094d\u0925\u093e \u0915\u094d\u0930\u0915 \u0935\u093f \u0907\u0938\u0938\u0947 \u092a\u0942\u0935\u0917 \n\u0906\u0935\u0947\u093f\u093f \u092a\u0930 \u0909\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u0930\u0924 \u0906\u093f\u0947\u093f \u0915\u093e \u092a\u0941\u093f\u0930\u093e\u0935\u0932\u094b\u0915\u093f \n\u0915\u0930\u0947 \u0905\u0930\u094d\u0925\u0935\u093e \u0938\u0902\u093f\u094b\u0927\u093f \u0915\u0930\u0947 | \u0927\u093e\u0930\u093e 561-\u090f \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0940 \n\u0905\u0902\u0924\u0928\u093f\u0917\u0926\u093f\u0924 \u093f\u0915\u094d\u0915\u094d\u0924 \u0915\u094b \u0907\u0938 \u0924\u0930\u093f \u0915\u0947 \u0906\u093f\u0947\u093f \u093f\u0947\u093f\u0947 \u0915\u0947 \u0936\u0932\u090f \n\u0938\u0902\u0930\u0915\u094d\u0937\u0915\u094d\u0937\u0924 \u0915\u0930\u0924\u093e \u093f\u0948 \u091c\u0948\u0938\u093e \u0915\u094d\u0930\u0915 \u0935\u094b \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \n\u093f\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0915\u094b \u0930\u094b\u0915\u093f\u0947 \u0905\u0930\u094d\u0925\u0935\u093e \u0928\u094d\u092f\u093e\u092f \u093f\u0947\u0924\u0941 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0938\u092e\u091d\u0947 \u0914\u0930 \n\u0907\u0938\u0936\u0932\u090f \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0905\u092a\u093f\u0940 \n\u0905\u0902\u0924\u0928\u093f\u0917\u0926\u093f\u0924 \u093f\u0915\u094d\u0915\u094d\u0924\u092f\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0905\u0935\u0936\u094d\u092f \u0915\u0930\u093f\u093e \u091a\u093e\u0926\u093f\u090f \n\u0916\u093e\u0938\u0924\u094c\u0930 \u092a\u0930 \u0909\u0938 \u0938\u092e\u092f \u091c\u092c \u0907\u0938\u0915\u0947 \u0905\u0902\u0924\u0928\u093f\u0917\u0926\u093f\u0924 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0927\u0927\u0915\u093e\u0930 \n\u0926\u093f\u0916\u093e\u093f\u0947 \u0915\u0940 \u092e\u093e\u0902\u0917 \u0915\u0940 \u091c\u093e\u090f | \u0910\u0938\u0940 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u092e\u0947\u0902 \u0909\u091a\u094d\u091a \n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0938\u0902. 1 \u0935 2 \u0915\u0947 \u092c\u093e\u093f \u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u0915\u094b \n\u0938\u0941\u093f\u093f\u0947 \u0915\u093e \u0905\u0927\u0927\u0915\u093e\u0930 \u0930\u094d\u0925\u093e \u0914\u0930 \u092f\u093f \u0935\u0935\u091a\u093e\u0930 \u0915\u0930\u093f\u0947 \u0915\u093e \u092d\u0940 \u0915\u094d\u0930\u0915 \n\n6 \n \n\u0915\u094d\u092f\u093e \u0924\u0925\u094d\u092f\u094b\u0902 \u0914\u0930 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u0926\u093f\u092f\u094b\u0902 \u0915\u0947 \n\u0935\u0935\u0930\u0941\u0926\u094d\u0927 \u0915\u093e\u092f\u0917\u0935\u093e\u093f\u0940 \u0915\u094b \u091c\u093e\u0930\u0940 \u0930\u0916\u093f\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u093e \n\u093f\u0941\u0930\u0942\u092a\u092f\u094b\u0917 \u0930\u094d\u0925\u093e \u0905\u0930\u094d\u0925\u0935\u093e \u0907\u0938\u0947 \u0930\u0926\u094d\u093f \u0915\u0930\u093f\u093e \u0928\u094d\u092f\u093e\u092f \u0915\u0947 \u0926\u093f\u0924 \u092e\u0947\u0902 \n\u091c\u0930\u0942\u0930\u0940 \u0930\u094d\u0925\u093e \u0964 \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0938\u0902. 1 \u0935 2 \u0915\u0947 \u092c\u093e\u093f \u0906\u0935\u0947\u093f\u093f \u0915\u0947 \u0938\u092e\u092f \n\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0924\u0925\u094d\u092f \u0935 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u093e\u093e\u0901 \u0909\u093f\u0915\u0947 \u092a\u094d\u0930\u0930\u094d\u0925\u092e \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0915\u0947 \u092a\u093f\u0932\u0947 \n\u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u0915\u0947 \u0938\u092e\u092f \u0938\u0947 \u092c\u092c\u0932\u0915\u0941\u0932 \u0936\u092d\u0928\u094d\u093f \u0930\u094d\u0925\u0940\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u094d\u0930\u0915 \u092a\u094d\u0930\u0930\u094d\u0925\u092e \n\u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \u0915\u0947 \u092a\u0942\u0935\u0917 \u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u0915\u0947 \u0930\u0926\u094d\u093f \u093f\u094b\u093f\u0947 \u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u093f, \n\u0905\u0936\u092d\u092f\u094b\u091c\u093f \u092a\u0915\u094d\u0937 \u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0915\u094d\u0930\u0915\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \n\u0915\u0930\u093f\u0947 \u092e\u0947\u0902 \u0935\u0935\u092b\u0932 \u0930\u093f\u093e \u093f\u0948 \u092d\u0932\u0947 \u093f\u0940 \u092f\u093f \u092c\u093f\u0941\u0924 \u092a\u093f\u0932\u0947 1965 \u092e\u0947\u0902 \n\u093f\u093e\u0916\u0916\u0932 \u0915\u094d\u0930\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e \u0914\u0930 \u092e\u093e\u092e\u0932\u093e \u0935\u093f\u0940\u0940\u0901 \u0905\u091f\u0915\u093e \u0930\u093f\u093e \u091c\u093f\u093e\u0902 \n\u0935\u093f \u0921\u0947\u095d \u0935\u0930\u094d\u0917 \u0938\u0947 \u092a\u0942\u0935\u0917 \u0930\u094d\u0925\u093e........ \n9. \u0939\u0930\u094d\u0937\u0947\u0928\u094d\u0930 \u0915\u0941\u092e\u093e\u0930 \u093f\u0940. \u092c\u0928\u093e\u092e \u0930\u0947\u092c\u093e\u0924\u093f\u0932\u093f\u093e \u0915\u094b\u0932\u0947 \u0935 \u0905\u0928\u094d\u092f, 2011 Crl. L.J. \n1626, \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u093f\u0947 \u092e\u093e\u093f\u093e:  \n22. \u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u0905\u0936\u092d\u092f\u094b\u091c\u093f \u090f\u0915 \u0917\u0902\u092d\u0940\u0930 \u092e\u093e\u092e\u0932\u093e \u093f\u0948; \u092f\u093f \n\u0935\u094d\u092f\u0915\u094d\u0915\u094d\u0924 \u0915\u0940 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u0924\u093e \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u0935\u0924 \u0915\u0930\u0924\u093e \u093f\u0948 | \u0915\u094d\u0930\u0915\u0938\u0940 \u0935\u094d\u092f\u0915\u094d\u0915\u094d\u0924 \n\u0915\u094b \u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0918\u0938\u0940\u091f\u093f\u0947 \u0938\u0947 \u091c\u094d\u092f\u093e\u093f\u093e \u0909\u0938\u0915\u0940 \u0907\u091c\u094d\u091c\u0924 \n\u0915\u094b \u0914\u0930 \u0905\u0927\u0927\u0915 \u093f\u0941\u0915\u0938\u093e\u093f \u093f\u093f\u0940\u0902 \u092a\u093f\u0941\u093e\u0901\u091a\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e | \u093f\u092e\u093e\u0930\u0940 \n\u0930\u093e\u092f \u092e\u0947\u0902, \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u093f\u0947 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0915\u0947 \u0915\u0902\u092a\u093f\u0940 \u0915\u0947 \n\u0928\u093f\u093f\u0947\u093f\u0915 \u092a\u093f \u0938\u0947 \u0924\u094d\u092f\u093e\u0917 \u092a\u0924\u094d\u0930 \u093f\u0947\u093f\u0947 \u0938\u0947 \u0938\u092e\u094d\u092c\u0902\u0927\u0927\u0924 \u0928\u093f\u0935\u0935\u0917\u0935\u093e\u093f\u0940\u092f \n\u093f\u0938\u094d\u0924\u093e\u0935\u0947\u091c \u092a\u0930 \u0927\u094d\u092f\u093e\u093f \u093f \u093f\u0947\u0915\u0930 \u0917\u0902\u092d\u0940\u0930 \u091a\u0942\u0915 \u0915\u0940 \u093f\u0948 | \u092f\u0926\u093f \u0909\u091a\u094d\u091a \n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0907\u093f \u093f\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u092a\u0930 \u0935\u0935\u091a\u093e\u0930 \u0915\u094d\u0930\u0915\u092f\u093e \u0917\u092f\u093e \u093f\u094b\u0924\u093e \n\u0924\u094b \u092f\u093f \u0938\u094d\u092a\u0937\u094d\u091f \u093f\u094b \u0917\u092f\u093e \u093f\u094b\u0924\u093e \u0915\u094d\u0930\u0915 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u093f\u0947 \u0915\u0902\u092a\u093f\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \n\u091a\u0947\u0915 \u091c\u093e\u0930\u0940 \u093f\u094b\u093f\u0947 \u0938\u0947 \u092c\u093f\u0941\u0924 \u092a\u093f\u0932\u0947 \u093f\u0940 \u0924\u094d\u092f\u093e\u0917 \u092a\u0924\u094d\u0930 \u093f\u0947 \u0926\u093f\u092f\u093e \u0930\u094d\u0925\u093e | \n\u091c\u0948\u0938\u093e \u0915\u094d\u0930\u0915 \u090a\u092a\u0930 \u093f\u0947\u0916\u093e \u0917\u092f\u093e \u093f\u0948, \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u093f\u0947 \u0926\u093f\u093f\u093e\u0902\u0915 \n02.03.2004 \u0915\u094b \u0928\u093f\u093f\u0947\u093f\u0915 \u0915\u0947 \u092a\u093f \u0938\u0947 \u0924\u094d\u092f\u093e\u0917 \u092a\u0924\u094d\u0930 \u0926\u093f\u092f\u093e \u0930\u094d\u0925\u093e | \n\u0915\u0902\u092a\u093f\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091a\u0947\u0915 \u0926\u093f\u093f\u093e\u0902\u0915 30.04.2004 \u0915\u094b \u091c\u093e\u0930\u0940 \n\u0915\u094d\u0930\u0915\u092f\u0947 \u0917\u090f \u0930\u094d\u0925\u0947 \u0905\u0930\u094d\u0925\u093e\u0917\u0924 \u091c\u092c \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0915\u094b \u0915\u092e\u094d\u092a\u093f\u0940 \u0915\u0947 \u0928\u093f\u093f\u0947\u093f\u0915 \n\u0915\u0947 \u092a\u093f \u0938\u0947 \u0924\u094d\u092f\u093e\u0917 \u092a\u0924\u094d\u0930 \u0926\u093f\u090f \u0915\u093e\u092b\u0940 \u0938\u092e\u092f \u093f\u094b \u091a\u0941\u0915\u093e \u0930\u094d\u0925\u093e | \n\u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0915\u0947 \u0924\u094d\u092f\u093e\u0917 \u092a\u0924\u094d\u0930 \u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0928\u0924 \u0926\u093f\u093f\u093e\u0902\u0915 02.03.2004 \n\u0915\u0947 \u0938\u0902\u0915\u0932\u094d\u092a \u092e\u0947\u0902 \u0935\u0935\u0927\u0927\u0935\u0924 \u092a\u0930\u0930\u0932\u0915\u094d\u0937\u0915\u094d\u0937\u0924 \u093f\u094b\u0924\u0940 \u093f\u0948 \u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u093f \n\u0928\u093f\u0927\u093e\u0917\u0930\u0930\u0924 \u092a\u094d\u0930\u092a\u0924\u094d\u0930 (\u092b\u0949\u092e\u0917 \u093f\u0902\u092c\u0930 32) \u092e\u0947\u0902 \u0915\u0902\u092a\u093f\u0940 \u093f\u0947 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \n\u0924\u094d\u092f\u093e\u0917 \u092a\u0924\u094d\u0930 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 04.03.2004 \u0915\u094b \u0915\u0902\u092a\u093f\u0940 \u0930\u0915\u094d\u091c\u0938\u094d\u0930\u093e\u0930 \u0915\u094b \n\n7 \n \n\u0938\u0942\u0927\u091a\u0924 \u0915\u094d\u0930\u0915\u092f\u093e\u0964 \u0936\u093f\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u0917\u0913\u0902 \u0915\u093e \u092f\u093f \u092e\u093e\u092e\u0932\u093e \u092d\u0940 \u093f\u093f\u0940\u0902 \u093f\u0948 \n\u0915\u094d\u0930\u0915 \u0905\u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u091a\u0947\u0915 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0926\u094d\u0935\u093e\u0930\u093e \u091c\u093e\u0930\u0940 \u0915\u094d\u0930\u0915\u090f \u0917\u090f \u0930\u094d\u0925\u0947\u0964 \u0907\u093f \n\u0924\u0925\u094d\u092f\u094b\u0902 \u0938\u0947 \u0907\u0938 \u092c\u093e\u0924 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u0902\u093f\u0947\u093f \u093f\u093f\u0940\u0902 \u0930\u093f\u0924\u093e \u093f\u0948 \u0915\u094d\u0930\u0915 \u0915\u094d\u091c\u0938 \n\u0924\u093e\u0930\u0940\u0916 \u0915\u094b \u0915\u0902\u092a\u093f\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0930\u093e\u0927 \u0915\u094d\u0930\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e, \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \n\u0928\u093f\u093f\u0947\u093f\u0915 \u093f\u093f\u0940\u0902 \u0930\u094d\u0925\u093e; \u0909\u093f\u0915\u093e \u0915\u0902\u092a\u093f\u0940 \u0915\u0947 \u092e\u093e\u092e\u0932\u094b\u0902 \u0938\u0947 \u0915\u094b\u0908 \u0932\u0947\u093f\u093e-\u093f\u0947\u093f\u093e \n\u093f\u093f\u0940\u0902 \u0930\u094d\u0925\u093e \u0964 \u092e\u093e\u092e\u0932\u0947 \u0915\u094b \u0927\u094d\u092f\u093e\u093f \u092e\u0947\u0902 \u0930\u0916\u0924\u0947 \u093f\u0941\u090f \u092f\u0926\u093f \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \n\u0916\u0916\u0932\u093e\u092b \u0906\u092a\u0930\u093e\u0927\u0927\u0915 \u0936\u093f\u0915\u093e\u092f\u0924\u094b\u0902 \u092a\u0930 \u0915\u093e\u092f\u0917\u0935\u093e\u093f\u0940 \u0915\u0940 \u091c\u093e\u0924\u0940 \u093f\u0948 \u0924\u094b \n\u092f\u093f \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0938\u093e\u0930\u094d\u0925 \u0918\u094b\u0930 \u0905\u0928\u094d\u092f\u093e\u092f \u093f\u094b\u0917\u093e \u0914\u0930 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \n\u0915\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947 \u093f\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u0915\u0947 \u0938\u092e\u093e\u093f \u093f\u094b\u0917\u093e\u0964\u201d \n \n10. \u0905\u093f\u0941\u0932 \u0936\u0941\u0915\u094d\u0932\u093e (supra) \u092e\u093e\u092e\u0932\u093e \u0905\u092a\u093f\u0947 \u0924\u0925\u094d\u092f\u094b\u0902 \u092a\u0930 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0905\u0932\u0917 \u093f\u0948 \n\u0915\u094d\u092f\u094b\u0902\u0915\u094d\u0930\u0915 \u0907\u0938\u092e\u0947\u0902 \u092e\u093e\u0902\u0917\u0940 \u0917\u0908 \u0930\u093e\u093f\u0924 \u0928\u094d\u092f\u093e\u092f \u0915\u0947 \u0926\u093f\u0924 \u092e\u0947\u0902 \u092c\u0916\u093e\u0917\u0938\u094d\u0924\u0917\u0940 \u0915\u0947 \u092a\u0942\u0935\u0917 \u0915\u0947 \u0906\u093f\u0947\u093f \n\u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e/\u0935\u093e\u092a\u0938 \u092c\u0941\u0932\u093e\u093f\u0947/\u0938\u0902\u093f\u094b\u0927\u0927\u0924 \u0915\u0930\u093f\u0947 \u0915\u0947 \u0936\u0932\u090f \u0930\u094d\u0925\u0940 \u0964 \u093f\u0924\u0940\u091c\u0924\u093f, \u092c\u0916\u093e\u0917\u0938\u094d\u0924\u0917\u0940 \n\u0915\u0947 \u092a\u0942\u0935\u0917 \u0915\u0947 \u0906\u093f\u0947\u093f \u0915\u094b \u0935\u093e\u092a\u0938 \u0932\u0947 \u0936\u0932\u092f\u093e \u0917\u092f\u093e\u0964 \u0909\u0938 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924 \u092e\u0947\u0902 \u092f\u093f \u092e\u093e\u093f\u093e \n\u0917\u092f\u093e \u0930\u094d\u0925\u093e \u0915\u094d\u0930\u0915 \u093f\u0902\u0921 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0902\u0926\u093f\u0924\u093e \u0915\u0940 \u0927\u093e\u0930\u093e 362 \u0915\u094b \u0927\u094d\u092f\u093e\u093f \u092e\u0947\u0902 \u0930\u0916\u0924\u0947 \u093f\u0941\u090f, \n\u0905\u0936\u092d\u0916\u0902\u0921\u0921\u0924 \u0915\u0930\u093f\u0947 \u0915\u0947 \u0906\u0935\u0947\u093f\u093f \u0915\u094b \u0916\u093e\u0930\u0930\u091c \u0915\u0930\u0924\u0947 \u093f\u0941\u090f \u092a\u093e\u0930\u0930\u0924 \u092a\u0942\u0935\u0917 \u0915\u0947 \u0906\u093f\u0947\u093f \u0915\u094b \n\u0935\u093e\u092a\u0938 \u093f\u093f\u0940\u0902 \u0936\u0932\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0930\u094d\u0925\u093e | \u092e\u093e\u092e\u0932\u093e \u0905\u092a\u093f\u0947 \u0924\u0925\u094d\u092f\u094b\u0902 \u092a\u0930 \u092a\u0942\u0930\u0940 \u0924\u0930\u093f \u0938\u0947 \n\u0905\u0932\u0917 \u093f\u0948 |  \n11. \u0915\u094d\u091c\u0938 \u0915\u0902\u092a\u093f\u0940 \u092e\u0947\u0902 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0928\u093f\u093f\u0947\u093f\u0915 \u0930\u094d\u0925\u0947, \u0936\u093f\u0915\u093e\u092f\u0924 \u092e\u0947\u0902 \u0935\u093f \u092a\u093e\u091f\u0940 \u092a\u094d\u0930\u0928\u0924\u0935\u093e\u093f\u0940 \n\u093f\u0948 | \u0907\u0938\u0936\u0932\u090f \u0936\u093f\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u0917 \u0915\u0947 \u0926\u093f\u0924\u094b\u0902 \u0915\u0940 \u092a\u092f\u093e\u0917\u092a\u094d\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0940 \u091c\u093e\u0924\u0940 \u093f\u0948 | \u092e\u093e\u092e\u0932\u0947 \n\u0915\u0947 \u0924\u0925\u094d\u092f\u094b\u0902 \u0914\u0930 \u092a\u0930\u0930\u0915\u094d\u0938\u094d\u0930\u094d\u0925\u0928\u0924\u092f\u094b\u0902 \u0915\u0940 \u0938\u0902\u092a\u0942\u0923\u0917\u0924\u093e \u092e\u0947\u0902, \u093f\u092e \u092f\u093f \u093f\u093f\u0940\u0902 \u092e\u093e\u093f \u092a\u093e \u0930\u093f\u0947 \u093f\u0948\u0902 \u0915\u094d\u0930\u0915 \n\n8 \n \n\u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u094b \u0905\u0936\u092d\u0916\u0902\u0921\u0921\u0924 \u0915\u0930\u093f\u0947 \u0915\u0947 \u0936\u0932\u090f \u093f\u0942\u0938\u0930\u093e \u0906\u0935\u0947\u093f\u093f \u0915\u0947\u0935\u0932 \u092a\u093f\u0932\u0947 \u0915\u0947 \n\u0906\u0935\u0947\u093f\u093f \u0915\u094b \u0916\u093e\u0930\u0930\u091c \u093f\u094b\u093f\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0938\u094d\u0935\u0940\u0915\u093e\u092f\u0917 \u093f\u093f\u0940\u0902 \u0930\u094d\u0925\u093e \u0964 \n12. \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0906\u0915\u094d\u0937\u0947\u0935\u092a\u0924 \u0906\u093f\u0947\u093f \u0915\u094b \u0905\u092a\u093e\u0938\u094d\u0924 \u0915\u094d\u0930\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u093f\u0948 | \u0905\u092a\u0940\u0932 \n\u0915\u0940 \u0905\u093f\u0941\u092e\u0928\u0924 \u093f\u0940 \u091c\u093e\u0924\u0940 \u093f\u0948 \u0914\u0930 \u0905\u0915\u0947\u0932\u0947 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u0917 \u0915\u0947 \u0916\u0916\u0932\u093e\u092b \u0915\u093e\u092f\u0917\u0935\u093e\u093f\u0940 \u0930\u0926\u094d\u093f \n\u0915\u0940 \u091c\u093e\u0924\u0940 \u093f\u0948 |  \n........................... \u0928\u094d\u092f\u093e\u092f\u093e\u093f\u0940\u0936 \n(\u0905\u0936\u094b\u0915 \u092d\u0942\u0930\u094d\u0937\u0930\u094d) \n \n \n \n........................... \u0928\u094d\u092f\u093e\u092f\u093e\u093f\u0940\u0936  \n(\u0928\u0935\u0940\u0928 \u0938\u0938\u0928\u094d\u0939\u093e) \n\u093f\u0908 \u0926\u093f\u0932\u094d\u0932\u0940, \n\u091c\u0941\u0932\u093e\u0908 30, 2019 \n \n \n \n \n \n \n \n \n \n \n\u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923: \u093f\u0947\u093f\u0940 \u092d\u093e\u0930\u094d\u093e \u092e\u0947\u0902 \u0928\u093f\u0923\u0917\u092f \u0915\u093e \u0905\u093f\u0941\u0935\u093e\u093f \u092e\u0941\u0915\u0926\u094d\u0926\u094d\u092e\u0947\u092c\u093e\u095b \u0915\u0947 \u0938\u0940\u0936\u092e\u0924 \u092a\u094d\u0930\u092f\u094b\u0917 \u093f\u0947\u0924\u0941 \u0915\u094d\u0930\u0915\u092f\u093e \n\u0917\u092f\u093e \u093f\u0948 \u0924\u093e\u0915\u094d\u0930\u0915 \u0935\u094b \u0905\u092a\u093f\u0940 \u092d\u093e\u0930\u094d\u093e \u092e\u0947\u0902 \u0907\u0938\u0947 \u0938\u092e\u091d \u0938\u0915\u0947\u0902 \u090f\u0935\u0902 \u092f\u093f \u0915\u094d\u0930\u0915\u0938\u0940 \u0905\u0928\u094d\u092f \u092a\u094d\u0930\u092f\u094b\u091c\u093f \u093f\u0947\u0924\u0941 \u092a\u094d\u0930\u092f\u094b\u0917 \n\u093f\u093f\u0940\u0902 \u0915\u094d\u0930\u0915\u092f\u093e \u091c\u093e\u090f\u0917\u093e| \u0938\u092e\u0938\u094d\u0924 \u0915\u093e\u092f\u093e\u0917\u0932\u092f\u0940 \u090f\u0935\u0902 \u0935\u094d\u092f\u093e\u0935\u093f\u093e\u0930\u0930\u0915 \u092a\u094d\u0930\u092f\u094b\u091c\u093f\u094b\u0902 \u093f\u0947\u0924\u0941 \u0928\u093f\u0923\u0917\u092f \u0915\u093e \u0905\u0902\u0917\u094d\u0930\u0947\u095b\u0940 \n\u0938\u094d\u0935\u0930\u0942\u092a \u093f\u0940 \u0905\u0936\u092d\u092a\u094d\u0930\u092e\u093e\u0916\u0923\u0924 \u092e\u093e\u093f\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0915\u093e\u092f\u093e\u0917\u0928\u094d\u0935\u092f\u093f \u0924\u0930\u094d\u0925\u093e \u0932\u093e\u0917\u0942 \u0915\u094d\u0930\u0915\u090f \u091c\u093e\u093f\u0947 \u093f\u0947\u0924\u0941 \u0909\u0938\u0947 \u093f\u0940 \n\u0935\u0930\u0940\u092f\u0924\u093e \u093f\u0940 \u091c\u093e\u090f\u0917\u0940 | \n"
}