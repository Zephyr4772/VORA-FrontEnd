    "full_text": "\u092a\u094d\u0930\u0924\u0924\u093f\u0935\u0935\u0947\u0926\n\u0938\u092e\u0915\u094d\u0937 \u092d\u092d\u093e\u0930\u0924\u093f \u0915\u092d\u093e \u0938\u0935\u0930\u094d\u0935\u094b\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f\n\u0926\u092d\u093e\u0926\u093e\u0902\u0924\u0921\u093f\u0915 \u0905\u092a\u092a\u0940\u0932\u092a\u0940\u092f \u0905\u0927\u0927\u093f\u0915\u092d\u093e\u0930\u0930\u0924\u093f\u092d\u093e \n\u0926\u092d\u093e\u0926\u093e\u0902\u0924\u0921\u093f\u0915 \u0905\u092a\u092a\u0940\u0932 \u0938\u0926\u093e\u0902\u0916\u094d\u092f\u092d\u093e   2025-2028/2011\n\u092c\u092a\u0940\u0930\u092c\u0932 \u092c\u092a\u0940. \u091a\u091a\u094c\u0939\u092d\u093e\u0928 \u090f\u0935\u0926\u093e\u0902  \u090f\u0915 \u0905\u0928\u094d\u092f \u0907\u0924\u094d\u092f\u092d\u093e\u0924\u0926                   ............   \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \n\u092c\u0928\u092d\u093e\u092e\n\u091b\u0924\u092a\u0940\u0938\u0917\u095d \u0930\u092d\u093e\u091c\u094d\u092f \u0907\u0924\u094d\u092f\u092d\u093e\u0924\u0926                                       ................   \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u0930\u094d\u0925\u0940\u0917\u0923\n\u0924\u0928\u0923\u0930\u092f \n\u091f\u092a\u0940\n  .   \u090f\u0938\n  .   \u0920\u092d\u093e\u0915\u0915\u0930\n \n ,   \u0928\u092f\u092d\u093e\n  .    \n1.     \u0907\u0928 \u0905\u092a\u092a\u0940\u0932\u0932\u094b\u0902 \u092e\u092e \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0924\u0926\u094d\u0935\u093f\u0924\u093f\u092a\u0940\u092f  \u0905\u0935\u0930 \u0938\u0924\u094d\u0930 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0927\u093f\u092a\u0940\u0936 \u0930\u092d\u093e\u092f\u092a\u0915\u0930 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0938\u0924\u094d\u0930\n\u0924\u0935\u091a\u092d\u093e\u0930\u0923  \u0938\u0926\u093e\u0902\u0916\u094d\u092f\u092d\u093e 103/92  \u092e\u092e \u092d\u092d\u093e\u0930\u0924\u093f\u092a\u0940\u092f \u0926\u0926\u093e\u0902\u0921\u093f \u0938\u0926\u093e\u0902\u0924\u0939\u0924\u093f\u092d\u093e, 1860 \u0915\u0915\u0940  \u0927\u093f\u092d\u093e\u0930\u092d\u093e 399 \u0924\u093f\u0930\u092d\u093e\n402 \u0915\u0935\u0947  \u0905\u0926\u093e\u0902\u0924\u093f\u0917\u0930\u0924\u093f \u0926\u0926\u093e\u0902\u0921\u093f\u0928\u092a\u0940\u092f \u0905\u092a\u0930\u092d\u093e\u0927\u093f \u0915\u0935\u0947 \u0927\u0932\u090f \u092a\u0930\u092a\u0940\u0924\u0915\u094d\u0937\u0924\u093f \u0924\u0915\u092f\u0935\u0947 \u0917\u090f \u0914\u0930 \u0926\u0926\u094b\u0928\u0932\u094b\u0902 \u0938\u094d\u0924\u093f\u0930\u0932\u094b\u0902 \u092a\u0930 \u0926\u0926\u094b\u0937\u092a\u0940\n\u0920\u0939\u0930\u092d\u093e\u090f \u0917\u090f \u0924\u093f\u0930\u092d\u093e \u092a\u092d\u093e\u0926\u093e\u0902\u091a \u0935\u0937\u0930 \u0915\u0915\u0940 \u0905\u0935\u0927\u0927\u093f  \u0915\u0935\u0947 \u0927\u0932\u090f \u0915\u0920\u0926\u094b\u0930 \u0915\u092d\u093e\u0930\u092d\u093e\u0935\u092d\u093e\u0938 \u092d\u0915\u0917\u0924\u093f\u0928\u0935\u0947 \u0939\u0935\u0947\u0924\u093f\u0915 \u0926\u0926\u093e\u0902\u0924\u0921\u093f\u0924\u093f \u0924\u0915\u092f\u0935\u0947\n\u0917\u090f\u0964  \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0926\u092d\u093e\u0927\u0916\u093f\u0932 \u0915\u0915\u0940 \u0917\u0908 \u0905\u092a\u092a\u0940\u0932 \u0938\u0926\u093e\u0902\u0916\u094d\u092f\u092d\u093e\u090f\u0926\u093e\u0902  603/1993,\n643/1993, 881/1993, 1172/1993, 1173/1993  \u0914\u0930 1174/1993\n\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u091b\u0924\u092a\u0940\u0938\u0917\u095d, \u0924\u092c\u0932\u092d\u093e\u0938\u092a\u0915\u0930 \u0905\u092a\u0928\u0935\u0947 \u0906\u0926\u0935\u0947\u0936 \u0924\u0926\u0928\u092d\u093e\u0926\u093e\u0902\u0915 9 \u091c\u0915\u0932\u092d\u093e\u0908 2010 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e\n\u0959\u092d\u093e\u0930\u0930\u091c \u0915\u0930 \u0926\u092a\u0940 \u0917\u0908\u0964   \u0935\u0924\u093f\u0930\u092e\u092d\u093e\u0928 \u0905\u092a\u092a\u0940\u0932\u092e \u0909\u0915\u094d\u0924 \u0906\u0926\u0935\u0947\u0936 \u0924\u093f\u0930\u092d\u093e \u0924\u0928\u0923\u0930\u092f \u0915\u0915\u0940 \u0935\u0935\u0948\u0927\u093f\u0924\u093f\u092d\u093e \u0915\u0926\u094b \u091a\u0915\u0928\u091a\u094c\u0924\u093f\u092a\u0940\n\u0926\u0935\u0947\u0928\u0935\u0947 \u0915\u0935\u0947 \u0927\u0932\u090f \u0926\u092d\u093e\u0927\u0916\u093f\u0932 \u0915\u0915\u0940 \u0917\u0908 \u0939\u0935\u0948\u0964\n\n \n2.        \u0938\u0926\u093e\u0902\u0924\u0915\u094d\u0937\u092a\u094d\u0924 \u0930\u0942\u092a \u092e\u092e \u0935\u0924\u0923\u0930\u0924\u093f, \u0905\u0924\u092d\u092f\u0926\u094b\u091c\u0928 \u092e\u092d\u093e\u092e\u0932\u092d\u093e \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0915\u0935\u0947 \u0924\u0935\u0930\u0941\u0926\u094d\u0927 \u092f\u0939 \u0939\u0935\u0948 \u0924\u0915\n\u0924\u0926\u0928\u092d\u093e\u0926\u093e\u0902\u091510 \u095e\u0930\u0935\u0930\u092a\u0940 1992 (\u0905.\u0938\u092d\u093e.1)  \u0915\u0926\u094b  \u0932\u0926\u094b\u0915\u0935\u0947\u0936 \u0905\u0917\u094d\u0930\u0935\u092d\u093e\u0932 \u0905\u092a\u0928\u0935\u0947 \u0924\u092e\u0924\u094d\u0930 \u0930\u0936\u092a\u0940\u0926 \u0915\u0935\u0947 \u0938\u092d\u093e\u0930\n\u092a\u0915\u0938\u091a\u094c\u0930 \u0938\u0935\u0947 \u0930\u092d\u093e\u092f\u0917\u095d \u0926\u0935\u0947\u0930 \u0936\u092d\u093e\u092e \u090f\u0915 \u092e\u0926\u094b\u091f\u0930 \u092c\u092d\u093e\u0907\u0915 \u092a\u0930 \u092f\u092d\u093e\u0924\u094d\u0930\u092d\u093e \u0915\u0930 \u0930\u0939\u092d\u093e \u0930\u092d\u093e \u0924\u093f\u092c  \u0909\u0938\u0928\u0935\u0947  8 \u0938\u0935\u0947 10\n\u0935\u094d\u092f\u0924\u0915\u094d\u0924\u092f\u0932\u094b\u0902 \u0915\u0926\u094b \u0905\u092a\u0928\u0935\u0947 \u0939\u092d\u093e\u0930\u0932\u094b\u0902 \u092e\u092e \u0921\u093f\u0926\u093e\u0902\u0921\u093f\u092d\u093e \u0927\u0932\u090f \u0939\u0939\u090f \u0915\u0926\u094b\u091f\u092d\u093e \u0924\u093f\u0930\u092d\u093e\u0908 \u0939\u0935\u092d\u093e\u0908 \u0905\u0921\u092d\u093e \u0915\u0935\u0947 \u092a\u092d\u093e\u0938  \u0926\u0935\u0947\u0916\u093f\u092d\u093e\u0964\n\u0909\u0928\u094d\u0939\u0932\u094b\u0902\u0928\u0935\u0947 \u0930\u0926\u094b\u0915\u0928\u0935\u0947 \u0915\u092d\u093e \u092a\u094d\u0930\u092f\u092d\u093e\u0938 \u0924\u0915\u092f\u092d\u093e \u0914\u0930 \u0907\u0928  \u0926\u0926\u094b\u0928\u0932\u094b\u0902 \u0915\u092d\u093e \u092a\u092a\u0940\u091b\u092d\u093e \u0924\u0915\u092f\u092d\u093e \u091c\u0926\u094b \u0938\u094d\u0930\u0932 \u0938\u0935\u0947 \u092d\u092d\u093e\u0917\u0935\u0947 \u0914\u0930\n\u0938\u092a\u0940\u0927\u093f\u0935\u0947 \u0930\u092d\u093e\u092f\u0917\u095d \u092a\u0915\u0927\u0932\u0938 \u0915\u0935\u0947 \u092a\u092d\u093e\u0938 \u0918\u091f\u0928\u092d\u093e \u0915\u0935\u0947 \u092c\u092d\u093e\u0930\u0935\u0947 \u092e\u092e \u0930\u0930\u092a\u0926\u094b\u091f\u0930 \u0915\u0930\u0928\u0935\u0947 \u092a\u0939\u0939\u0926\u093e\u0902\u091a\u0935\u0947\u0964   \u0909\u092a\u0924\u0928\u0930\u092a\u0940\u0915\u094d\u0937\u0915 \u090f. \u0915\u0935\u0947.\n\u0916\u093f\u092d\u093e\u0928 (\u0905.\u0938\u092d\u093e.5) \u0928\u0935\u0947 \u0930\u0930\u092a\u0926\u094b\u091f\u0930 \u0927\u0932\u0916\u093f\u092d\u093e \u0914\u0930 \u0930\u092d\u093e\u0928\u092d\u093e \u092a\u094d\u0930\u092d\u092d\u093e\u0930\u092a\u0940, \u0915\u0926\u094b\u0924\u093f\u0935\u092d\u093e\u0932\u092a\u0940 \u0930\u092d\u093e\u092f\u0917\u095d \u0924\u093f\u0930\u092d\u093e \u092a\u0915\u0938\u0915\u0930 \u0915\u0926\u094b\n\u0918\u091f\u0928\u092d\u093e\u0938\u094d\u0930\u0932 \u092a\u0939\u0939\u0941\u0901\u091a\u0928\u0935\u0947  \u0915\u0915\u0940 \u092a\u094d\u0930\u092d\u093e\u0930\u0930\u0928\u092d\u093e  \u0915\u0935\u0947 \u0938\u092d\u093e\u0930 \u0938\u0938\u0942\u091a\u0928\u092d\u093e \u0924\u0926\u092f\u092d\u093e\u0964  \u092a\u0915\u0927\u0932\u0938 \u0915\u0935\u0947 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0918\u091f\u0928\u092d\u093e \u0938\u094d\u0930\u0932\n\u092a\u0939\u0939\u0941\u0901\u091a\u0928\u0935\u0947 \u0915\u0935\u0947 \u0927\u0932\u090f \u091a\u092d\u093e\u0930 \u091b\u0926\u094b\u091f\u0935\u0947 \u0938\u092e\u0938\u0942\u0939 \u0917\u0924\u0920\u0924\u093f \u0924\u0915\u092f\u0935\u0947  \u091c\u0939\u092d\u093e\u0939\u0941\u0901 \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0905\u092a\u0928\u0935\u0947 \u0939\u092d\u093e\u0930\u0932\u094b\u0902 \u092e\u092e \u0918\u092d\u093e\u0924\u093f\u0915\n\u0939\u0927\u0930\u092f\u092d\u093e\u0930\u0932\u094b\u0902 \u0915\u0935\u0947 \u0938\u092d\u093e\u0930 \u090f\u0915 \u092a\u0935\u0947\u095c \u0915\u0935\u0947 \u0928\u092a\u0940\u091a\u0935\u0947 \u092c\u0935\u0948\u0920\u0935\u0947 \u0930\u0935\u0947\u0964  \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0918\u0935\u0947\u0930 \u0927\u0932\u090f \u0917\u090f \u0927\u091c\u0928\u094d\u0939\u0935\u0947\n\u0906\u0924\u094d\u092e\u0938\u092e\u092a\u0930\u0923 \u0915\u0930\u0928\u0935\u0947  \u0915\u0935\u0947 \u0927\u0932\u090f \u0915\u0939\u092d\u093e \u0917\u092f\u092d\u093e \u0927\u091c\u0938\u092a\u0930 \u0909\u0928\u094d\u0939\u0932\u094b\u0902\u0928\u0935\u0947 \u0938\u094d\u0930\u0932 \u0938\u0935\u0947 \u092d\u092d\u093e\u0917\u0928\u0935\u0947 \u0915\u0915\u0940 \u0915\u0926\u094b\u0924\u0936\u0936\n\u0924\u0915\u092f\u092d\u093e \u0932\u0935\u0947\u0924\u0915\u0928 \u092a\u0915\u0927\u0932\u0938 \u0926\u0932 \u0928\u0935\u0947 \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0915\u0926\u094b \u0939\u0927\u0930\u092f\u092d\u093e\u0930\u0932\u094b\u0902 \u0938\u0924\u0939\u0924\u093f  \u092a\u0915\u095c \u0927\u0932\u092f\u092d\u093e,  \u0938\u092d\u093e\u0930 \u0939\u092a\u0940\n\u0916\u093f\u092d\u093e\u0928\u0935\u0947 \u0915\u0935\u0947 \u0938\u092d\u093e\u092e\u0917\u094d\u0930\u092a\u0940  \u0914\u0930 \u0936\u0930\u092d\u093e\u092c \u092d\u092a\u0940\u0964   \u0909\u0928\u092e\u0935\u0947 \u0938\u0935\u0947 \u0915\u0915\u091b \u0938\u094d\u0930\u0932 \u092a\u0930 \u0907\u0915\u091f\u092d\u093e \u0939\u0939\u090f \u0932\u0926\u094b\u0917 \u0905\u0939\u0941\u0901\u0927\u093f\u0935\u0947\u0930\u0935\u0947  \u0915\u0935\u0947\n\u0932\u092d\u093e\u092d \u0909\u0920\u092d\u093e\u0915\u0930 \u092d\u092d\u093e\u0917 \u0917\u090f \u0964\n3.    \u092e\u092d\u093e\u092e\u0932\u0935\u0947 \u092e\u092e \u0924\u0935\u0935\u0935\u0947\u091a\u0928\u092d\u093e \u0938\u092e\u092d\u093e\u0924\u092a\u094d\u0924 \u0915\u0935\u0947 \u092c\u092d\u093e\u0926 \u0917\u094d\u092f\u092d\u093e\u0930\u0939 \u0935\u094d\u092f\u0924\u0915\u094d\u0924\u092f\u0932\u094b\u0902 \u0915\u0935\u0947 \u0924\u0935\u0930\u0941\u0926\u094d\u0927 \u0927\u093f\u092d\u093e\u0930\u092d\u093e  399 \u0914\u0930\n402 \u092d\u092d\u093e. \u0926\u0926\u093e\u0902. \u0938\u0926\u093e\u0902. \u0915\u0935\u0947 \u0905\u0926\u093e\u0902\u0924\u093f\u0917\u0930\u0924\u093f \u0926\u0923\u094d\u0921\u093f\u0928\u092a\u0940\u092f\u0935\u0947 \u0905\u092a\u0930\u092d\u093e\u0927\u093f\u0932\u094b\u0902 \u0915\u0935\u0947 \u0927\u0932\u090f  \u0906\u0930\u0926\u094b\u092a \u092a\u0924\u094d\u0930 \u0926\u092d\u093e\u0927\u0916\u093f\u0932 \u0924\u0915\u092f\u092d\u093e\n\u0917\u092f\u092d\u093e\u0964   \u0938\u092e\u094d\u092c\u0926\u093e\u0902\u0927\u0927\u093f\u0924\u093f \u0926\u0926\u093e\u0902\u0921\u093f\u092d\u093e\u0927\u0927\u093f\u0915\u092d\u093e\u0930\u092a\u0940 \u0928\u0935\u0947 \u0936\u092a\u0940\u0918, \u0909\u0938\u0915\u0935\u0947 \u092c\u092d\u093e\u0926,  \u0938\u0924\u094d\u0930 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0927\u093f\u092a\u0940\u0936 \u0930\u092d\u093e\u092f\u0917\u095d \u0915\u0935\u0947 \u0938\u092e\u0915\u094d\u0937\n\u0924\u0935\u091a\u092d\u093e\u0930\u0923  \u0915\u0935\u0947 \u0927\u0932\u090f \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0915\u0926\u094b  \u0909\u092a\u092d\u093e\u0924\u092a\u0930\u0924\u093f \u0915\u0930 \u0924\u0926\u092f\u092d\u093e \u0927\u091c\u0938\u0928\u0935\u0947 \u0924\u0926\u094d\u0935\u093f\u0924\u093f\u092a\u0940\u092f \u0905\u0935\u0930 \u0938\u0924\u094d\u0930\n\u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0927\u093f\u092a\u0940\u0936, \u0930\u092d\u093e\u092f\u0917\u095d \u0915\u0926\u094b \u092e\u092d\u093e\u092e\u0932\u092d\u093e \u092d\u0935\u0947\u091c \u0924\u0926\u092f\u092d\u093e\u0964\u0964  \n4.     \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f  \u092e\u092e  \u0905\u0924\u092d\u092f\u0926\u094b\u091c\u0928 \u0928\u0935\u0947 9 \u0938\u092d\u093e\u0915\u094d\u0937\u092a\u0940\u0917\u0923 \u0915\u0926\u094b  \u092a\u0930\u092a\u0940\u0924\u0915\u094d\u0937\u0924\u093f  \u0915\u0930\u092d\u093e\u092f\u092d\u093e\n\u091c\u092c\u0924\u0915 \u092a\u094d\u0930\u0924\u0924\u093f\u0930\u0915\u094d\u0937\u092d\u093e \u092e\u092e 5 \u0938\u092d\u093e\u0915\u094d\u0937\u092a\u0940\u0917\u0923 \u092a\u0930\u092a\u0940\u0924\u0915\u094d\u0937\u0924\u093f \u0924\u0915\u092f\u0935\u0947 \u0917\u090f\u0964  \u0905\u0924\u092d\u092f\u0926\u094b\u091c\u0928 \u0928\u0935\u0947 \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0938\u0935\u0947\n\n\u0939\u0927\u0930\u092f\u092d\u093e\u0930\u0932\u094b\u0902  \u091c\u0935\u0948\u0938\u0935\u0947 \u090f\u0915 \u0924\u093f\u0932\u0935\u092d\u093e\u0930, \u0916\u093f\u0926\u093e\u0902\u091c\u0930,   \u090f\u0915 \u092c\u0935\u0947\u0924\u093f\u092a\u0940\u0932 \u0915\u0915\u0932\u094d\u0939\u092d\u093e\u095c\u092a\u0940 \u0924\u093f\u0930\u092d\u093e \u090f\u0915 \u091f\u0926\u094b\u091a\u0930, \u0921\u093f\u0926\u093e\u0902\u0921\u093f\u092d\u093e ,\n\u0936\u0930\u092d\u093e\u092c \u0915\u0915\u0940 \u092c\u0926\u094b\u0924\u093f\u0932\u0935\u0947, \u0915\u0915\u091b \u0916\u093f\u092d\u093e\u0928\u0935\u0947 \u0915\u0915\u0940 \u0938\u092d\u093e\u092e\u0917\u094d\u0930\u092a\u0940 \u0924\u093f\u0930\u092d\u093e  \u090f\u0915 \u092e\u0926\u094b\u092e\u092c\u0924\u092a\u0940  \u0915\u0935\u0947  \u091c\u092a\u094d\u0924\u092a\u0940  \u092a\u0930 \u0924\u0935\u0936\u094d\u0935\u092d\u093e\u0938\n\u091c\u0924\u093f\u092d\u093e\u092f\u092d\u093e\u0964  \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0928\u0935\u0947 \u0918\u091f\u0928\u092d\u093e\u0924\u094d\u092e\u0915 \u0930\u0942\u092a \u092e\u092e \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0915\u0926\u094b\u0906\u0930\u0926\u094b\u0924\u092a\u0924\u093f \u0905\u092a\u0930\u092d\u093e\u0927\u093f\u0932\u094b\u0902\n\u0915\u092d\u093e \u0926\u0926\u094b\u0937\u092a\u0940 \u092a\u092d\u093e\u092f\u092d\u093e  \u0914\u0930 \u0939\u0930 \u0938\u094d\u0924\u093f\u0930 \u092a\u0930 \u092a\u092d\u093e\u0926\u093e\u0902\u091a \u0935\u0937\u0930 \u0915\u092d\u093e \u0915\u0920\u0926\u094b\u0930 \u0915\u092d\u093e\u0930\u092d\u093e\u0935\u092d\u093e\u0938 \u092d\u0915\u0917\u0924\u093f\u0928\u0935\u0947 \u0915\u0915\u0940 \u0938\u091c\u092d\u093e \u0926\u092a\u0940\n\u092f\u0930\u092d\u093e \u092a\u0939\u0932\u0935\u0947 \u0939\u092a\u0940 \u090a\u092a\u0930 \u0909\u0932\u0935\u0947\u0927\u0916\u093f\u0924\u093f \u0939\u0935\u0948\u0964   \u0905\u0924\u092d\u092f\u0915\u094d\u0924 \u0935\u094d\u092f\u0924\u0915\u094d\u0924\u092f\u0932\u094b\u0902 \u092e\u092e \u091a\u092d\u093e\u0930 \u0905\u0930\u092d\u093e\u0930\u0924\u093f \u091c\u0926\u094b\u0917\u0935\u0947\u0936\u094d\u0935\u0930, \u0936\u0928\u092a\u0940\n\u0930\u092d\u093e\u0935\u0924\u093f, \u092a\u092d\u093e\u0932\u0938\u0942 \u0930\u092d\u093e\u092e \u0924\u093f\u0930\u092d\u093e \u0939\u092a\u0940\u0930\u092d\u093e\u0935\u0923 \u0909\u095e\u0930 \u0905\u0924\u0939\u0935\u0930\u0928 \u0915\u0926\u094b, \u0924\u093f\u0930\u092d\u093e\u0924\u092a, \u0938\u0926\u093e\u0902\u0926\u0935\u0947\u0939 \u0915\u092d\u093e \u0932\u092d\u093e\u092d \u0924\u0926\u092f\u092d\u093e \u0914\u0930\n\u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0905\u092a\u0930\u092d\u093e\u0927\u093f \u092e\u0915\u094d\u0924\n \u0924\u0915\u092f\u092d\u093e \u0917\u092f\u092d\u093e\u0964   \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0928\u0935\u0947 \u0924\u0928\u0923\u0930\u094d\u0925\u0940\u0924\u093f\n\u0924\u0915\u092f\u092d\u093e \u0924\u0915 \u0905\u0924\u092d\u092f\u0915\u094d\u0924\u0917\u0923 \u090f\u0915 \u0938\u0915\u0928\u0938\u092d\u093e\u0928 \u091c\u0917\u0939 \u092a\u0930 \u0905\u0939\u0941\u0901\u0927\u093f\u0935\u0947\u0930\u092a\u0940 \u0930\u092d\u093e\u0924\u093f \u092e\u092e \u090f\u0915\u0924\u094d\u0930 \u0939\u0939\u090f \u0924\u093f\u0930\u092d\u093e \u0932\u0926\u094b\u0915\u0935\u0947\u0936\n\u0905\u0917\u094d\u0930\u0935\u092d\u093e\u0932 (\u0905.\u0938\u092d\u093e.5) \u0915\u0926\u094b \u0930\u0926\u094b\u0915\u0928\u0935\u0947 \u0915\u092d\u093e \u092a\u094d\u0930\u092f\u092d\u093e\u0938 \u0924\u0915\u092f\u092d\u093e \u0914\u0930 \u0918\u092d\u093e\u0924\u093f\u0915 \u0939\u0927\u0930\u092f\u092d\u093e\u0930\u0932\u094b\u0902 \u0938\u0935\u0947 \u0938\u0915\u0938\u091c\u091c\u094d\u091c\u0924\u093f\n\u0939\u0926\u094b\u0928\u0935\u0947 \u0915\u0935\u0947 \u0928\u092d\u093e\u0924\u093f\u0935\u0947 \u0905\u092a\u0930\u092d\u093e\u0927\u093f \u0915\u092d\u093e\u0930\u0930\u0924\u093f \u0915\u0930\u0928\u0935\u0947 \u0915\u0935\u0947 \u0924\u093f\u0935\u0948\u092f\u092d\u093e\u0930\u092a\u0940 \u0915\u0930 \u0930\u0939\u0935\u0947 \u0930\u0935\u0947 \u091c\u0926\u094b \u0915\u0915\u0924\u093f \u0927\u093f\u092d\u093e\u0930\u092d\u093e 399 \u0924\u093f\u0930\u092d\u093e\n302 \u092d\u092d\u093e. \u0926. \u0938\u0926\u093e\u0902. \u0915\u0935\u0947 \u0905\u0926\u093e\u0902\u0924\u093f\u0917\u0930\u0924\u093f \u0926\u0923\u094d\u0921\u093f\u0928\u092a\u0940\u092f \u0939\u0935\u0948\u0964\n5.    \u0905\u092a\u092a\u0940\u0932 \u092e\u092e \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0928\u0935\u0947 \u0905\u0924\u092d\u092f\u0926\u094b\u091c\u0928 \u0914\u0930 \u092a\u094d\u0930\u0924\u0924\u093f\u0930\u0915\u094d\u0937\u092d\u093e \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e  \u092a\u094d\u0930\u0938\u094d\u0924\u093f\u0915\u0924\u093f  \u0938\u092d\u093e\u0915\u094d\u0937\u094d\u092f\u0932\u094b\u0902 \u0915\u092d\u093e\n\u092a\u0915\u0928\u092e\u0938\u0942\u0930\u0932\u094d\u092f\u092d\u093e\u0926\u093e\u0902\u0915\u0928 \u0924\u0915\u092f\u092d\u093e \u0914\u0930 \u092a\u0930\u0930\u0915\u094d\u0937\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0905\u0924\u092d\u0927\u0932\u0927\u0916\u093f\u0924\u093f  \u0924\u0928\u0937\u094d\u0915\u0937\u0930\u094d\u0935\u094b\u0926\u093e\u0902  \u0915\u0926\u094b \u0905\u0924\u092d\u092a\u0915\u0924\u0937\n\u092f\u0939 \u0905\u0935\u0927\u093f\u092d\u093e\u0930\u0930\u0924\u093f \u0915\u0930\u0924\u093f\u0935\u0947 \u0939\u0939\u090f \u0924\u0915\u092f\u092d\u093e \u0924\u0915  \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0915\u0935\u0947 \u0938\u092e\u0915\u094d\u0937 \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u091c\u0926\u094b \u0905\u0932\u0917\n\u0905\u0932\u0917  \u0917\u092d\u093e\u0935\u0932\u094b\u0902 \u0915\u0935\u0947 \u0924\u0928\u0935\u092d\u093e\u0938\u092a\u0940 \u0930\u0935\u0947, \u0918\u092d\u093e\u0924\u093f\u0915 \u0939\u0927\u0930\u092f\u092d\u093e\u0930\u0932\u094b\u0902 \u0938\u0924\u0939\u0924\u093f \u090f\u0915 \u092a\u0935\u0947\u095c \u0915\u0935\u0947 \u0928\u092a\u0940\u091a\u0935\u0947 \u0938\u0915\u0928\u0938\u092d\u093e\u0928 \u0938\u094d\u0930\u092d\u093e\u0928\n\u092a\u0930 \u0905\u0939\u0941\u0901\u0927\u093f\u0935\u0947\u0930\u0935\u0947  \u092e\u092e  \u090f\u0915\u0924\u094d\u0930 \u0939\u0939\u090f \u0930\u0935\u0947, \u0927\u091c\u0938 \u0906\u091a\u0930\u0923 \u0915\u0935\u0947 \u0927\u0932\u090f \u0909\u0928\u0915\u0935\u0947 \u092a\u092d\u093e\u0938  \u0915\u0926\u094b\u0908 \u0938\u094d\u092a\u0937\u092a\u0940\u0915\u0930\u0923 \u0928\u0939\u0939\n\u0930\u092d\u093e \u091c\u0926\u094b \u0915\u092e \u0938\u094d\u0935\u092a\u0940\u0915\u092d\u093e\u092f\u0930 \u0939\u0926\u094b\u0924\u093f\u092d\u093e\u0964   \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u0932\u092f  \u0915\u092d\u093e \u0924\u0935\u091a\u092d\u093e\u0930 \u0930\u092d\u093e \u0924\u0915 \u0905\u0924\u092d\u092f\u0926\u094b\u091c\u0928 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e\n\u092a\u094d\u0930\u0938\u094d\u0924\u093f\u0915\u0924\u093f \u0924\u0915\u092f\u092d\u093e \u0917\u092f\u092d\u093e \u0938\u092d\u093e\u0915\u094d\u0937\u094d\u092f \u0938\u092c\u0932 \u0924\u093f\u0930\u092d\u093e \u0938\u094d\u0935\u092a\u0940\u0915\u092d\u093e\u092f\u0930 \u0930\u0935\u0947 \u0927\u091c\u0938\u0928\u0935\u0947 \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e\n\u0905\u0924\u092d\u0927\u0932\u0927\u0916\u093f\u0924\u093f  \u0926\u0926\u094b\u0937\u0927\u0938\u0924\u0926\u094d\u0927 \u0924\u093f\u0930\u092d\u093e \u0938\u091c\u092d\u093e \u0915\u0935\u0947 \u0906\u0926\u0935\u0947\u0936 \u092e\u092e \u0939\u0938\u094d\u0924\u093f\u0915\u094d\u0937\u0935\u0947\u092a \u0915\u0915\u0940 \u0915\u0926\u094b\u0908 \u0917\u0915\u0926\u093e\u0902\u091c\u092d\u093e\u0907\u0938 \u0928\u0939\u0939\n\u091b\u0926\u094b\u095c\u092a\u0940\u0964   \u0935\u0924\u093f\u0930\u092e\u092d\u093e\u0928 \u0905\u092a\u092a\u0940\u0932\u092e \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f  \u0915\u0935\u0947 \u0909\u092a\u0930\u0926\u094b\u0915\u094d\u0924   \u092b\u0935\u0948\u0938\u0932\u0935\u0947 \u0915\u0915\u0940 \u0935\u0935\u0948\u0926\u0924\u093f\u092d\u093e \u092a\u0930 \u0906\u0915\u094d\u0930\u092e\u0923\n\u0915\u0930\u0924\u093f\u092a\u0940  \u0939\u0935\u0948  \u091c\u0935\u0948\u0938\u092d\u093e \u0924\u0915 \u092a\u0939\u0932\u0935\u0947 \u0926\u0935\u0947\u0916\u093f\u092d\u093e \u0917\u092f\u092d\u093e\u0964 \n\n6.     \u0924\u0935\u0936\u0935\u0947\u0937 \u0905\u0928\u0915\u092e\u0924\u0924\u093f \u092f\u092d\u093e\u0924\u091a\u0915\u092d\u093e\u0913\u0926\u093e\u0902 \u0915\u0935\u0947 \u0938\u092d\u093e\u0930 \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0928\u0935\u0947 \u0909\u0928\u0915\u0935\u0947 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0938\u092e\u092a\u0923\u0930 \u0938\u0935\u0947 \u091b\u0938\u0942\u091f\n\u0915\u0935\u0947 \u0927\u0932\u090f \u092a\u094d\u0930\u092d\u093e\u0930\u0930\u0928\u092d\u093e \u0924\u0915\u092f\u092d\u093e \u091c\u0926\u094b \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0927\u093f\u092a\u0940\u0936 \u091a\u0935\u0948\u092e\u094d\u092c\u0930 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0906\u0926\u0935\u0947\u0936 \u0924\u0926\u0928\u092d\u093e\u0924\u0915\u0926\u093e\u0902\u0924\u093f 8 \u0928\u0935\u092e\u094d\u092c\u0930, 2011\n\u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0959\u092d\u093e\u0930\u0930\u091c \u0915\u0930 \u0926\u092a\u0940 \u0917\u0908\u0964  \u0924\u093f\u092c 8  \u0938\u091c\u092d\u093e \u092a\u094d\u0930\u092d\u093e\u092a\u094d\u0924 \u0905\u0924\u092d\u092f\u0915\u094d\u0924\u0932\u094b\u0902 \u0928\u0935\u0947  \u0938\u092e\u092a\u0930\u0923 \u0924\u0915\u092f\u092d\u093e \u091c\u092c\u0924\u0915\n\u092a\u0939\u092d\u093e\u0924\u095c\u092f\u092d\u093e \u0909\u095e\u0930 \u0917\u0926\u094b\u0935\u0927\u093f\u0930\u0928 \u0924\u093f\u0930\u092d\u093e \u0917\u0926\u094b\u0935\u0935\u0947\u0927\u093f\u0930\u0928 \u0959\u092d\u093e\u0927\u0938\u092f\u092d\u093e  \u0924\u0935\u0936\u0935\u0947\u0937 \u0905\u0928\u0915\u092e\u0924\u0924\u093f \u092f\u092d\u093e\u0924\u091a\u0915\u092d\u093e \u0938\u0926\u093e\u0902. 21927\n\u0924\u093f\u0930\u092d\u093e 21929 \u092e\u092e \u092f\u092d\u093e\u091a\u092a\u0940\u0917\u0923 \u0928\u0935\u0947 \u0938\u092e\u092a\u0930\u0923 \u0928\u0939\u0939 \u0924\u0915\u092f\u092d\u093e \u0964  \u0907\u0938\u0927\u0932\u090f, \u0926\u0926\u094b \u0938\u091c\u092d\u093e \u092a\u094d\u0930\u092d\u093e\u092a\u094d\u0924 \u0935\u094d\u092f\u0924\u0915\u094d\u0924\u092f\u0932\u094b\u0902\n\u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0926\u092d\u093e\u0927\u0916\u093f\u0932 \u0915\u0915\u0940 \u0917\u0908 \u0924\u0935\u0936\u0935\u0947\u0937 \u0905\u0928\u0915\u092e\u0924\u0924\u093f \u092f\u092d\u093e\u0924\u091a\u0915\u092d\u093e\u090f\u0926\u093e\u0902  \u0907\u0938 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0915\u0935\u0947 \u0906\u0926\u0935\u0947\u0936 \u0924\u0926\u0928\u092d\u093e\u0926\u093e\u0902\u0915  10\n\u095e\u0930\u0935\u0930\u092a\u0940 2011 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0924\u0928\u0930\u0938\u094d\u0924\u093f \u0915\u092d\u093e \u0926\u092a\u0940 \u0917\u0908 \u0964\n7.  \u0939\u092e \u0932\u0926\u094b\u0917\u0932\u094b\u0902 \u0928\u0935\u0947 \u0936\u0935\u0947\u0937 \u0906\u0920 \u0935\u094d\u092f\u0924\u0915\u094d\u0924\u092f\u0932\u094b\u0902 \u0915\u0935\u0947 \u0905\u0927\u0927\u093f\u0935\u0915\u094d\u0924\u092d\u093e \u0915\u0926\u094b \u0938\u0915\u0928 \u0927\u0932\u092f\u092d\u093e \u0939\u0935\u0948 \u0924\u093f\u0930\u092d\u093e \u091a\u0915\u0928\u091a\u094c\u0924\u093f\u092a\u0940 \u0915\u0935\u0947\n\u0905\u0926\u093e\u0902\u0924\u093f\u0917\u0930\u0924\u093f \u0906\u0926\u0935\u0947\u0936 \u0915\u092d\u093e \u0905\u0928\u0915\u0936\u092a\u0940\u0932\u0928 \u0924\u0915\u092f\u092d\u093e \u0939\u0935\u0948 \u0964  \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0915\u0935\u0947 \u0905\u0927\u0927\u093f\u0935\u0915\u094d\u0924\u092d\u093e \u0905\u0927\u093f\u092a\u0940\u0928\u0938\u094d\u0930\n\u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f\u0932\u094b\u0902 \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u092a\u092d\u093e\u0930\u0930\u0924\u093f \u0906\u0926\u0935\u0947\u0936 \u092e\u092e \u0924\u093f\u0925\u094d\u092f \u0905\u0930\u0935\u092d\u093e \u0924\u0935\u0927\u0927\u093f \u092e\u092e \u0915\u0926\u094b\u0908 \u0924\u094d\u0930\u0915\u0924\u091f \u092c\u0924\u093f\u092d\u093e\u0928\u0935\u0947 \u092e\u092e \u0905\u0938\u092e\u0930\u0930 \u0930\u0939\u0935\u0947\n\u0939\u0935\u0948 \u0964  \u0905\u0928\u094d\u092f\u0930\u092d\u093e \u092d\u092a\u0940 \u091a\u0915\u0928\u091a\u094c\u0924\u093f\u092a\u0940 \u0915\u0935\u0947 \u0905\u0926\u093e\u0902\u0924\u093f\u0917\u0930\u0924\u093f \u0924\u0915\u0938\u092a\u0940 \u0924\u0935\u0927\u0927\u093f\u0915 \u0926\u0926\u094b\u0937 \u0938\u0935\u0947 \u092a\u094d\u0930\u092d\u092d\u093e\u0924\u0935\u0924\u093f \u0928\u0939\u0939 \u0939\u0935\u0948 \u0928 \u0935\u0935\u0947 \u092a\u0915\u094d\u0937\u0932\u094b\u0902\n\u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u093f\u0915\u0924\u093f \u0924\u0915\u092f\u0935\u0947 \u0917\u090f \u0938\u092d\u093e\u0915\u094d\u0937\u094d\u092f \u0915\u0935\u0947 \u092e\u0938\u0942\u0932\u094d\u092f\u092d\u093e\u0926\u093e\u0902\u0915\u0928 \u092e\u092e \u0924\u0915\u0938\u092a\u0940 \u092a\u094d\u0930\u0924\u0924\u093f\u0915\u0938\u0942\u0932\u0924\u093f\u092d\u093e \u0938\u0935\u0947 \u092a\u092a\u0940\u0924\u095c\u0924\u093f \u0939\u0935\u0948 \u0964\n\u0907\u0938\u0927\u0932\u090f,  \u0909\u0938 \u0926\u0943\u0924\u0937\u0915\u0926\u094b\u0923 \u0938\u0935\u0947,   \u0939\u092e\u092e \u0905\u0935\u0927\u093f\u092d\u093e\u0930\u0930\u0924\u093f \u0915\u0930\u0928\u0935\u0947 \u092e\u092e \u0915\u0926\u094b\u0908 \u0924\u0939\u091a\u0915 \u0928\u0939\u0939 \u0939\u0935\u0948 \u0924\u0915\n\u0905\u0927\u093f\u092a\u0940\u0928\u0938\u094d\u0930 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0915\u092d\u093e  \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0915\u0935\u0947 \u0924\u0935\u0930\u0941\u0926\u094d\u0927 \u0926\u0926\u094b\u0937\u0927\u0938\u0924\u0926\u094d\u0927 \u0915\u092d\u093e \u0905\u0924\u092d\u0927\u0932\u0927\u0916\u093f\u0924\u093f \u0906\u0926\u0935\u0947\u0936\n\u0909\u092a\u092f\u0915\u0930\u0915\u094d\u0924 \u0930\u0935\u0947 \u0964 \u0932\u0935\u0947\u0924\u0915\u0928, \u0939\u092e\u0932\u0926\u094b\u0917 \u092e\u0939\u0938\u0938\u0942\u0938 \u0915\u0930\u0924\u093f\u0935\u0947 \u0939\u0935\u0948 \u0924\u0915 \u092e\u092d\u093e\u092e\u0932\u0935\u0947 \u0915\u0935\u0947 \u0924\u093f\u0925\u094d\u092f\u0932\u094b\u0902  \u0924\u093f\u0930\u092d\u093e \u092a\u0930\u092a\u0940\u091c\u0938\u094d\u0930\u0924\u0924\u093f\u092f\u092d\u093e\u0926\u093e\u0902\n\u092e\u092e \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0915\u0926\u094b \u0926\u092a\u0940 \u0917\u0908  \u0938\u091c\u092d\u093e \u0915\u0915\u091b \u0939\u0926 \u0924\u093f\u0915 \u0915\u0920\u0926\u094b\u0930 \u0939\u0935\u0948 \u0914\u0930 \u0909\u0924\u091a\u0924\u093f \u0930\u0942\u092a \u0938\u0935\u0947 \u0915\u092e \u0924\u0915\u092f\u0935\u0947\n\u091c\u092d\u093e\u0928\u0935\u0947 \u0915\u0915\u0940 \u091c\u0930\u0941\u0930\u0924\u093f \u0939\u0935\u0948\u0964  \u0924\u093f\u0926\u0928\u0915\u0938\u092d\u093e\u0930 \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0905\u0924\u092d\u0927\u0932\u0927\u0916\u093f\u0924\u093f \u092f\u0930\u092d\u093e \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0926\u094d\u0935\u093f\u092d\u093e\u0930\u092d\u093e \u0905\u0924\u092d\u092a\u0915\u0937  \u0938\u091c\u092d\u093e \u0915\u0926\u094b \u0909\u0938 \u0938\u092a\u0940\u092e\u092d\u093e \u0924\u093f\u0915 \u092a\u0930\u0930\u092e\u092d\u093e\u0927\u091c\u0930\u0924\u093f \u0915\u0930\u0924\u093f\u0935\u0947 \u0939\u0935\u0948 \u0924\u0915 \u092a\u092d\u093e\u0926\u093e\u0902\u091a \u0935\u0937\u0930 \u0915\u0935\u0947\n\u092c\u091c\u092d\u093e\u092f \u0905\u092a\u092a\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\u0917\u0923 \u0926\u0926\u094b\u0928\u0932\u094b\u0902 \u0938\u094d\u0924\u093f\u0930\u0932\u094b\u0902 \u092a\u0930 \u0915\u0935\u0947\u0935\u0932 \u0924\u093f\u092a\u0940\u0928 \u0935\u0937\u0930 \u0915\u0915\u0940 \u0905\u0935\u0927\u0927\u093f  \u0915\u0935\u0947 \u0927\u0932\u090f \u0915\u0920\u0926\u094b\u0930\n\u0915\u092d\u093e\u0930\u092d\u093e\u0935\u092d\u093e\u0938 \u092d\u0915\u0917\u0924\u093f\u0928\u0935\u0947 \u0939\u0935\u0947\u0924\u093f\u0915 \u0926\u091c\u0923\u094d\u0921\u093f\u0924\u093f \u0939\u0932\u094b\u0902\u0917\u0935\u0947 \u0964  \u0926\u092a\u0940 \u0917\u0908 \u0938\u091c\u092d\u093e\u092f\u092e \u0938\u092d\u093e\u0930 \u0938\u092d\u093e\u0930 \u091a\u0932\u0935\u0947\u0917\u092a\u0940 \u0964\n\n\u096e.  \u0905\u092a\u092a\u0940\u0932\u092e \u0909\u092a\u0930\u0926\u094b\u0915\u094d\u0924  \u092a\u0930\u0930\u092e\u092d\u093e\u091c\u0930\u0928 \u0915\u0935\u0947 \u0938\u092d\u093e\u0930 \u0924\u0928\u0938\u094d\u0924\u093f\u092d\u093e\u0930\u0930\u0924\u093f \u0915\u0915\u0940 \u091c\u092d\u093e\u0924\u093f\u092a\u0940 \u0939\u0935\u0948 \u0964\n\u2026.........................\n(\u0921\u093f\u0921.  \u092c\u092a\u0940.\u090f\u0938. \u091a\u091a\u094c\u0939\u092d\u093e\u0928)\n\u0928\u0908 \u0924\u0926\u0932\u092a\u0940 \n\u2026..........................\n\u0928\u0935\u092e\u094d\u092c\u0930 14, 2011 \n    \n      (\u091f\u092a\u0940. \u090f\u0938.  \u0920\u092d\u093e\u0915\u0915\u0930 )\n-------------------------------------------\n\u0916\u093f\u0926\u093e\u0902\u0921\u093f\u0928 (\u0924\u0921\u093f\u0938\u094d\u0915\u094d\u0932\u0935\u0947\u092e\u0930): \u0938\u094d\u0930\u092d\u093e\u0928\u092a\u0940\u092f \u092d\u092d\u093e\u0937\u092d\u093e \u092e\u092e \u0924\u0928\u0923\u0930\u092f \u0915\u0935\u0947 \u0905\u0928\u0915\u0935\u092d\u093e\u0926 \u0915\u092d\u093e \u0906\u0936\u092f, \u092a\u0915\u094d\u0937\u0915\u092d\u093e\u0930\u0932\u094b\u0902 \u0915\u0926\u094b \u0907\u0938\u0935\u0947 \u0905\u092a\u0928\u092a\u0940 \u092d\u092d\u093e\u0937\u092d\u093e\n\u092e\u092e \u0938\u092e\u091d\u0928\u0935\u0947 \u0915\u0935\u0947 \u0909\u092a\u092f\u0926\u094b\u0917 \u0924\u093f\u0915 \u0939\u092a\u0940 \u0927\u0938\u0924\u092e\u0924\u093f \u0939\u0935\u0948 \u0914\u0930 \u0905\u0928\u094d\u092f \u092a\u094d\u0930\u092f\u0926\u094b\u091c\u0928\u092d\u093e\u0930\u0930 \u0907\u0938\u0915\u092d\u093e \u0909\u092a\u092f\u0926\u094b\u0917 \u0928\u0939\u0939 \u0924\u0915\u092f\u092d\u093e \u091c\u092d\u093e \u0938\u0915\u0924\u093f\u092d\u093e\u0964\n\u0938\u092e\u0938\u094d\u0924\u093f \u0935\u094d\u092f\u0935\u0939\u092d\u093e\u0930\u0930\u0915 \u090f\u0935\u0926\u093e\u0902 \u0915\u092d\u093e\u092f\u092d\u093e\u0930\u0932\u092f\u092a\u0940\u0928 \u092a\u094d\u0930\u092f\u0926\u094b\u091c\u0928\u092d\u093e\u0930\u0930, \u0924\u0928\u0923\u0930\u092f \u0915\u092d\u093e \u0905\u0926\u093e\u0902\u0917\u094d\u0930\u0935\u0947\u091c\u092a\u0940 \u0938\u0926\u093e\u0902\u0938\u094d\u0915\u0930\u0923 \u0939\u092a\u0940 \u092a\u094d\u0930\u092d\u093e\u092e\u092d\u093e\u0924\u0923\u0915 \u0939\u0926\u094b\u0917\u092d\u093e \u090f\u0935\u0926\u093e\u0902\n\u0924\u0928\u0937\u094d\u092a\u092d\u093e\u0926\u0928 \u0924\u093f\u0930\u092d\u093e \u0915\u092d\u093e\u092f\u092d\u093e\u0930\u0928\u094d\u0935\u092f\u0928 \u0915\u0935\u0947 \u092a\u094d\u0930\u092f\u0926\u094b\u091c\u0928\u092d\u093e\u0930\u0930 \u0915\u094d\u0937\u0935\u0947\u0924\u094d\u0930\u092d\u093e\u0927\u0927\u093f\u0915\u092d\u093e\u0930\u0930\u0924\u093f\u092d\u093e \u0915\u0930\u0935\u0947\u0917\u092d\u093e\u0964\n------------------------------------------\n"
