    "full_text": "\u092a\u094d\u0930\u0924\u093f\u0003\u0935\u0947\u0926\u094d\u092f\n\u092d\u093e\u0930\u0003 \u0915\u0940 \u0938\u0935\u000e\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902\n\u0906\u092a\u0930\u093e\u0924\u093f\u0017\u0915 \u0905\u092a\u0940\u0932\u0940\u092f \u0905\u0924\u093f\u0017\u0915\u093e\u0930\n\u0906\u092a\u0930\u093e\u0924\u093f\u0017\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902\n \n .(  \u0913\u0902\n  ) 1085/2019\n \n \n(\u090f\u0938\u090f\u0932\u092a\u0940 (\u0906\u092a\u0930\u093e\u0924\u093f\u0017\u0915) \u0938\u0902.(\u0913\u0902) 9004 \u0938\u0928\u094d 2017 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928)\n\u0930\u093e\u092e \u0917\u094b\u092a\u093e\u0932\n...\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u09401(\u0917\u0923)\n\u092c\u0928\u093e\u092e\n\u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0940\u092f \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u092c\u094d\u092f\u0942\u0930\u094b, \u0926\u0947\u0939\u0930\u093e\u0926\u0942\u0928\n...\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u09401(\u0917\u0923)\n\u0938\u0939\n\u0906\u092a\u0930\u093e\u0924\u093f\u0017\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902\n \n .(  \u0913\u0902\n  ) 1086 \n \n \u0938\u0928\u094d \n \n 2019\n \n \n(\u090f\u0938\u090f\u0932\u092a\u0940 (\u0906\u092a\u093e\u0930\u093e\u0924\u093f\u0017\u0915) \u0938\u0902(\u0913\u0902) 1981 \u0938\u0928\u094d 2018 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928)\n\u092a\u0902\u0915\u091c \u0915\u0941\u092e\u093e\u0930 \u091c\u0948\u0928\n...\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u09401(\u0917\u0923)\n\u092c\u0928\u093e\u092e\n\u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0940\u092f \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u092c\u094d\u092f\u0942\u0930\u094b, \u0926\u0947\u0939\u0930\u093e\u0926\u0942\u0928\n...\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u09401(\u0917\u0923)\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj\nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds\nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds\nfy;s ekU; gksxk\u00dfA\n\n\u0928\u093f\u0928\u0923@\u092f\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0003 \u0928\u0935\u0940\u0928 \u0938\u093f\u0938\u0928\u094d\u0939\u093e\n\u0905\u0928\u0941\u092e\u0924\u093f\u0003 \u0905\u0928\u0941\u0926\u0924\u094d\u0924\u0964\n2. \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0928\u0947 \u0017\u093e\u0930\u093e 120-\u092c\u0940, 420, 467, 468, 471, 477-\u090f,\n201 \u0906\u0908\u092a\u0940\u0938\u0940 \u0938\u092a\u0928\u093fG\u0003 \u0017\u093e\u0930\u093e 13(1)(\u0921\u0940) \u0914\u0930 13(2), \u092d\u094d\u0930\u0937\u094d\u091f\u093e\u091a\u093e\u0930 \u0928\u093f\u0928\u0935\u093e\u0930\u0923\n\u0905\u0924\u093f\u0017\u0928\u093f\u0928\u092f\u092e \u0915\u0947 \u0905\u0928\u094d\u0003\u0917@\u0003 \u0905\u092a\u0928\u0940 \u0926\u094b\u0937\u0938\u093f\u0938\u0924\u093fN \u0915\u094b \u091a\u0941\u0928\u094c\u0003\u0940 \u0926\u0940 \u0939\u0948\u0902\u0964\n3. \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u092c\u094d\u092f\u0942\u0930\u094b \u0928\u0947 \u0930\u093e\u091c \u0915\u0941\u092e\u093e\u0930 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0928\u093f\u0926\u0928\u093e\u0902\u0915 13.07.1992\n\u0915\u094b \u090f\u0915 \u091c\u093e\u0932\u0940 \u092c\u0948\u0902\u0915 \u0916\u093e\u0003\u093e \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0938\u0902\u092c\u0902\u0017 \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0915 \u092e\u0939\u093e\u092a\u094d\u0930\u092c\u0902\u0017\u0915, \u092d\u093e\u0930\u0003\u0940\u092f\n\u0938\u094d\u091f\u0947\u091f \u092c\u0948\u0902\u0915, \u0917\u093e\u0938\u093f\u091c\u092f\u093e\u092c\u093e\u0926 \u0915\u0947 \u092c\u092f\u093e\u0928 \u0915\u0947 \u0906\u0017\u093e\u0930 \u092a\u0930 \u0928\u093f\u0926\u0928\u093e\u0902\u0915 12.04.1994 \u0915\u094b\n\u090f\u0915 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0940\u0928\u093f\u092e\u0915\u0940 \u0926\u091c@ \u0915\u0940\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 23.07.1992 \u0938\u0947 31. 10. 1992 \u0915\u0940\n\u0905\u0935\u0924\u093f\u0017 \u0915\u0947 \u092c\u0940\u091a \u0905\u0932\u0917-\u0905\u0932\u0917 \u092b\u091c1 \u091c\u092e\u093e \u092a\u094d\u0930\u0928\u093f\u0935\u0928\u093f\u0937\u094d\u091f\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u093e\u0003\u0947 \u092e\u0947\u0902\n3,22,056.00 \u0930\u0941\u092a\u092f\u0947 \u091c\u092e\u093e \u0928\u093f\u0915\u090f \u0917\u092f\u0947\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0905\u0932\u0917-\u0905\u0932\u0917 \u0003\u093e\u0930\u0940\u0916\u094b\u0902 \u092a\u0930\n3,22,000.00  \u0930\u0941\u092a\u092f\u0947 \u0915\u0940 \u0930\u093e\u0936\u093fZ \u0938\u0924\u094d\u0930\u0939 \u091a\u0947\u0915 \u0926\u094d\u0935\u093e\u0930\u093e 322.85 \u0930\u0941 \u0915\u0940 \u0930\u093e\u0936\u093fZ\n\u091b\u094b\u0921\u093c\u0915\u0930 \u0928\u093f\u0928\u0915\u093e\u0932 \u0932\u0940 \u0917\u092f\u0940\u0964 \u092e\u0942\u0932 \u0930\u0942\u092a \u0938\u0947 \u092c\u0948\u0902\u0915 \u0915\u0947 \u0926\u094b \u092c\u093e\u092c\u0942 \u0928\u093f\u0926\u0928\u0947Z \u0915\u0941\u092e\u093e\u0930 Z\u092e\u093e@\n\u0914\u0930 \u0936\u094d\u0930\u0940\u092e\u0003\u0940 \u0935\u0902\u0926\u0928\u093e \u0915\u0941\u0902\u0926\u094d\u0930\u093e \u0915\u094b \u0905\u0928\u094d\u092f \u0905\u091c\u094d\u091e\u093e\u0003 \u0935\u094d\u092f\u0928\u093fb\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0930\u094d\u0925\u0940 \u0906\u0930\u094b\u092a\u0940 \u0915\u0947 \u0930\u0942\u092a\n\u092e\u0947\u0902 \u0928\u093e\u0928\u093f\u092e\u0003 \u0928\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947 \u0928\u093e\u092e \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0915\u0947\u0935\u0932\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj\nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds\nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds\nfy;s ekU; gksxk\u00dfA\n\n\u0909\u0928\u0915\u0947 \u0916\u093f\u0916\u0932\u093e\u092b \u0906\u0930\u094b\u092a \u092a\u0924\u094d\u0930 \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0906\u092f\u0947 \u0930\u094d\u0925\u0940\u0947 \u0914\u0930 \u0928\u093f\u0935\u091a\u093e\u0930\u0923 \u0915\u0947\n\u0938\u092e\u093e\u092a\u0928 \u0915\u0947 \u092c\u093e\u0926 \u0909\u0928\u094d\u0939\u0947\u0902 \u0926\u094b\u0937\u0940 G\u0939\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964\n4. \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947 \u0928\u093f\u0935\u0926\u094d\u0935\u0003 \u0905\u0924\u093f\u0017\u0935b\u093e \u0928\u0947 \u0003\u0915@  \u0928\u093f\u0926\u092f\u093e \u0928\u093f\u0915 \u0909\u0928\u094d\u0939\u0947\u0902 \u092b\u0902\u0938\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948,\n\u091c\u092c\u0928\u093f\u0915 \u092e\u0942\u0932 \u0928\u093e\u092e\u091c\u0926 \u0905\u0936\u093f\u092d\u092f\u0941b\u094b\u0902 \u0915\u094b \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u091b\u094b\u0921\u093c \u0928\u093f\u0926\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n\u0909\u0928\u0915\u0947 \u0905\u0936\u093f\u092d\u092f\u094b\u091c\u0928 \u0915\u0940 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f\u0003 \u0928\u093f\u0935\u0924\u093f\u0017 \u0938\u092e\u094d\u092e\u0003 \u0928\u0939\u0940\u0902 \u0930\u094d\u0925\u0940\u0940\u0964 \u0907\u0938 \u092c\u093e\u0003 \u0915\u093e \u0915\u094b\u0908\n\u0938\u092c\u0942\u0003 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0928\u093f\u0915 \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u0947 \u0915\u094b \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0938\u0902\u092c\u0902\u0017 \u092e\u0947\u0902 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@ \u0928\u093f\u0915\u0938\u0940 \u092d\u0940\n\u0003\u0930\u0939 \u0938\u0947 \u0938\u0939\u093e\u092f\u0915 \u0930\u094d\u0925\u0940\u0947\u0964 \u0906\u092a\u0930\u093e\u0924\u093f\u0017\u0915 \u0938\u093e\u0938\u093f\u091cZ \u0915\u0947 \u0938\u092e\u0930\u094d\u0925\u0940@\u0928 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u092c\u0942\u0003 \u0928\u0939\u0940\u0902 \u0928\u093f\u0926\u092f\u093e\n\u0917\u092f\u093e \u0939\u0948\u0964 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947 \u0916\u093f\u0932\u090f \u0916\u093e\u0003\u093e \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u092b\u0949\u092e@, \u0916\u093e\u0003\u093e\u0017\u093e\u0930\u0915 \u0915\u0947 \u0928\u092e\u0942\u0928\u093e\n\u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930 \u092f\u093e \u0916\u093e\u0003\u093e \u092c\u0939\u0940 \u092e\u0947\u0902 \u091c\u093e\u0932\u0940 \u091c\u092e\u093e \u092f\u093e \u0928\u093f\u0928\u0915\u093e\u0938\u0940 \u092a\u094d\u0930\u0928\u093f\u0935\u0928\u093f\u0937\u094d\u091f\u092f\u094b\u0902 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0938\u0902\u092c\u0902\u0017\n\u092e\u0947\u0902 \u0938\u093e\u0915\u094d\u0937\u094d\u092f \u0915\u094b \u0928\u0937\u094d\u091f \u0915\u0930\u0928\u093e \u0938\u0902\u092d\u0935 \u0928\u0939\u0940\u0902 \u0930\u094d\u0925\u0940\u093e\u0964 \u091a\u0947\u0915 \u092a\u0930 \u0932\u0947\u0916\u0928 \u0914\u0930 \u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930 \u0915\u0947\n\u0938\u0902\u092c\u0902\u0017  \u092e\u0947\u0902 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u0928\u093f\u0935Z\u0947\u0937\u091c\u094d\u091e \u0915\u0940 \u0930\u093f\u0930\u092a\u094b\u091f@ \u0930\u093e\u092f \u0915\u0940 \u0905\u0936\u093f\u092d\u0935\u094d\u092f\u0928\u093fb \u092e\u093e\u0924\u094d\u0930 \u0930\u094d\u0925\u0940\u0940\u0964\n\u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u0928\u093f\u0935Z\u0947\u0937\u091c\u094d\u091e \u0921\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u09421 \u0928\u0947 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947\n\u0938\u092e\u093e\u0928 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u0914\u0930 \u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930 \u092a\u0930 \u0938\u0902\u0926\u0947\u0939 \u0928\u093f\u0915\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964 \u0907\u0938\u0916\u093f\u0932\u090f \u0935\u0947 \u0938\u0902\u0926\u0947\u0939 \u0915\u0947 \u0932\u093e\u092d\n\u0915\u0947 \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0902\u0964 \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u093e \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0916\u093f\u0932\u090f \u0938\u093f\u091c\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0938\u0902\u092c\u0902\u0924\u093f\u0017\u0003  \u092c\u0948\u0902\u0915\n\u0915\u092e@\u091a\u093e\u0930\u093f\u0930\u092f\u094b\u0902 \u0915\u0947 \u0916\u093f\u0916\u0932\u093e\u092b \u0915\u094b\u0908 \u0915\u093e\u0930@\u0935\u093e\u0908 \u0928\u0939\u0940\u0902 \u0915\u0940 \u0917\u0908 \u0939\u0948, \u0914\u0930 \u0928 \u0939\u0940 \u0905\u0936\u093f\u092d\u092f\u094b\u091c\u0928\n\u092a\u0915\u094d\u0937 \u0928\u0947 \u0910\u0938\u0947 \u0935\u094d\u092f\u0928\u093fb\u092f\u094b\u0902 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u091c\u093e\u0902\u091a \u0915\u0930\u0928\u0947 \u0915\u093e \u092d\u0940 \u092a\u094d\u0930\u092f\u093e\u0938 \u0928\u093f\u0915\u092f\u093e \u0939\u0948\u0964\n\u0935\u093e\u0939\u0915 \u091a\u0947\u0915 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u0947 \u0938\u0947 \u0928\u093f\u0928\u0915\u093e\u0938\u0940 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924\n\u0928\u0939\u0940\u0902 \u0915\u0940 \u0917\u092f\u0940 \u0930\u094d\u0925\u0940\u0940 \u091c\u0948\u0938\u093e \u0928\u093f\u0915 \u092a\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u09423 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u094d\u0935\u0940\u0915\u0943\u0003 \u0939\u0948\u0964\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj\nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds\nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds\nfy;s ekU; gksxk\u00dfA\n\n5. \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u092c\u094d\u092f\u0942\u0930\u094b \u0915\u0947 \u0928\u093f\u0935\u0926\u094d\u0935\u0003 \u0905\u0924\u093f\u0017\u0935b\u093e \u0928\u0947 \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0928\u093f\u0915\u092f\u093e \u0928\u093f\u0915 \u0938\u093e\u0915\u094d\u0937\u094d\u092f \u0915\u093e\n\u0917\u0939\u0928 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0928\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948,  \u0938\u093f\u091c\u0938\u092e\u0947\u0902 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u0928\u093f\u0935Z\u0947\u0937\u091c\u094d\u091e Z\u093e\u0928\u093f\u092e\u0932 \u0939\u0948\u0902 \u0914\u0930\n\u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947 \u0928\u093f\u0935\u0930\u0942N \u0906\u0930\u094b\u092a \u0938\u093e\u0928\u093f\u092c\u0003 \u0939\u094b\u0003\u093e \u0939\u0948\u0964\n6.  \u0939\u092e\u0928\u0947 \u092a\u0915\u094d\u0937\u0915\u093e\u0930\u094b\u0902 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0928\u093f\u0926\u090f \u0917\u090f \u0003\u0915o \u0914\u0930 \u0930\u093f\u0930\u0915\u0949\u0921@ \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0017\n\u0938\u093e\u092e\u0928\u093fp\u092f\u094b\u0902 \u092a\u0930 \u0928\u093f\u0935\u091a\u093e\u0930 \u0928\u093f\u0915\u092f\u093e \u0939\u0948\u0902\u0964 \u092f\u0939 \u090f\u0915 \u0928\u093f\u0928\u0930\u094d\u0935\u093f\u0935\u0935\u093e\u0926 \u0003\u0925\u094d\u092f \u0939\u0948 \u0928\u093f\u0915 \u092c\u0948\u0902\u0915\u093f\u0902\u0915\u0917\n\u092a\u094d\u0930\u0928\u093ft\u092f\u093e\u0913\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0909\u0924\u093f\u091a\u0003 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u0928\u093f\u092c\u0928\u093e \u090f\u0915 \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u093e \u0916\u094b\u0932\u093e \u0917\u092f\u093e\n\u0930\u094d\u0925\u0940\u093e\u0964 \u0926\u0941\u092d\u093e@\u0917\u094d\u092f \u0938\u0947 \u0907\u0938\u0947 \u091c\u093e\u0902\u091a \u0915\u093e \u0928\u093f\u0935\u0937\u092f \u0928\u0939\u0940\u0902 \u092c\u0928\u093e\u092f\u093e \u091c\u093e\u0928\u093e \u092a\u094d\u0930\u0003\u0940\u0003 \u0939\u094b\u0003\u093e \u0939\u0948 \u0914\u0930\n\u0938\u093f\u091c\u0938\u0938\u0947 \u0917\u092c\u0928 \u0915\u0940 \u092a\u094d\u0930\u0915\u0943\u0924\u093f\u0003 \u0914\u0930 \u0003\u0930\u0940\u0915\u0947 \u0915\u0947 \u0938\u0902\u092c\u0902\u0017 \u092e\u0947\u0902 \u0905\u0924\u093f\u0017\u0915 \u0003\u0925\u094d\u092f \u0938\u093e\u092e\u0928\u0947 \u0906\n\u0938\u0915\u0003\u0947 \u0930\u094d\u0925\u0940\u0947,  \u091c\u094b \u0918\u0928\u093f\u091f\u0003 \u0939\u0941\u090f \u0914\u0930 \u0907\u0938\u0938\u0947 \u091c\u0941\u0921\u0947 \u0935\u094d\u092f\u0928\u093fb \u091c\u094b \u0907\u0938\u092e\u0947\u0902 Z\u093e\u0928\u093f\u092e\u0932 \u0930\u094d\u0925\u0940\u0947\u0964\n\u0928\u093f\u0935\u091a\u093e\u0930\u0923 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0938\u0939\u0940 \u0922\u0902\u0917 \u0938\u0947 \u0905\u0935\u0932\u094b\u0915\u0928 \u0928\u093f\u0915\u092f\u093e \u0939\u0948 \u0928\u093f\u0915 \u092c\u0948\u0902\u0915\u093f\u0902\u0915\u0917 \u092a\u094d\u0930\u0928\u093ft\u092f\u093e\u0913\u0902\n\u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930,  \u0916\u093e\u0003\u0947 \u0915\u093e \u0916\u094b\u0932\u0928\u093e,  \u0907\u0938\u092e\u0947\u0902 \u091c\u092e\u093e \u0914\u0930 \u0928\u093f\u0928\u0915\u093e\u0938\u0940 \u0905\u0915\u0947\u0932\u0947\n\u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0940 \u0915\u0930\u0003\u0942\u0003 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0003\u0940 \u0930\u094d\u0925\u0940\u0940\u0964 \u0932\u0947\u0928\u093f\u0915\u0928 \u092e\u093e\u0924\u094d\u0930 \u0907\u0938\u0916\u093f\u0932\u090f \u0928\u093f\u0915 \u091c\u093e\u0902\u091a\n\u092e\u093e\u0928\u0915 \u0914\u0930 \u0907\u0938 \u092a\u094d\u0930\u0915\u0943\u0924\u093f\u0003 \u0915\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u0003\u0940 \u0939\u0948 \u0928\u093f\u0915 \u0909\u0928\u0915\u0947 \u0928\u093f\u0935\u0930\u0942N \u0909\u092a\u0932\u092c\u094d\u0017\n\u0938\u093e\u0915\u094d\u0937\u094d\u092f\u094b\u0902 \u0914\u0930 \u0938\u093e\u092e\u0928\u093fp\u092f\u094b\u0902 \u0915\u0940 \u092a\u094d\u0930\u0915\u0943\u0924\u093f\u0003 \u0915\u0947 \u092e\u0926\u094d\u0926\u0947\u0928\u091c\u0930 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947 \u0932\u093e\u092d \u0915\u0947 \u0916\u093f\u0932\u090f\n\u0907\u0938\u0947 \u0928\u093f\u0926\u092f\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0003\u093e \u0939\u0948\u0964\n7. \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947 \u0928\u093f\u0935\u0930\u0942N \u0905\u0936\u093f\u092d\u092f\u094b\u091c\u0928 \u0915\u0947 \u0916\u093f\u0932\u090f \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f\u0003 \u0915\u0940 \u0935\u0948\u0017\u0003\u093e, \u091c\u094b\n\u0928\u093f\u0928\u0930\u094d\u0935\u093f\u0935\u0935\u093e\u0926 \u0930\u0942\u092a \u0938\u0947 \u090f\u0915 \u0939\u0940 Z\u093e\u0916\u093e \u092e\u0947\u0902 t\u092eZ\u0903 \u0938\u0902\u0926\u0947Z\u0935\u093e\u0939\u0915 \u0914\u0930 \u0938\u0939\u093e\u092f\u0915 \u0915\u094d\u0932\u0915@  \u0915\u0947\n\u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u093e\u092f@\u0930\u0003 \u0930\u094d\u0925\u0940\u0947, \u092a\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u09421 \u0914\u0930 \u092a\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u09422 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u093e\u0928\u093f\u092c\u0003 \u0915\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0909\u092a\n\u0928\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915,  \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u091c\u093e\u0902\u091a \u092c\u094d\u092f\u0942\u0930\u094b \u092a\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u0942-23  \u0928\u0947 \u0938\u093e\u0928\u093f\u092c\u0003  \u0928\u093f\u0915\u092f\u093e \u0928\u093f\u0915\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj\nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds\nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds\nfy;s ekU; gksxk\u00dfA\n\n\u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0928\u0947 \u0905\u0928\u094d\u0935\u0947\u0937\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0905\u092a\u0928\u0947 \u0928\u092e\u0942\u0928\u093e \u0932\u0947\u0916\u0928 \u0914\u0930 \u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930 \u0928\u093f\u0926\u090f\n\u0930\u094d\u0925\u0940\u0947\u0964 \u092a\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u094218, \u0938\u0940\u090f\u092b\u090f\u0938\u090f\u0932 \u0915\u0947 \u092a\u094d\u0930\u0017\u093e\u0928 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0928\u0915 \u0905\u0924\u093f\u0017\u0915\u093e\u0930\u0940 \u0928\u0947 \u0917\u0935\u093e\u0939\u0940 \u0926\u0940\n\u0928\u093f\u0915 \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u0947 \u0915\u093e \u0916\u093e\u0003\u093e \u0916\u094b\u0932\u0928\u0947 \u0915\u093e \u092b\u0949\u092e@ \u0905\u092a\u0940\u0932\u0915\u0003\u093e@ \u092a\u0902\u0915\u091c \u0915\u0941\u092e\u093e\u0930 \u091c\u0948\u0928 \u0915\u0940\n\u0916\u093f\u0932\u0916\u093e\u0935\u091f \u092e\u0947\u0902 \u0930\u094d\u0925\u0940\u093e, \u091c\u094b \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u093e \u0017\u093e\u0930\u0915 \u0930\u093e\u091c \u0915\u0941\u092e\u093e\u0930 \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u0003\u0930\u0942\u0928\u093f\u092a\u0003 \u0915\u0930 \u0930\u0939\u093e\n\u0930\u094d\u0925\u0940\u093e\u0964 \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u093e \u0017\u093e\u0930\u0915 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u092c\u0948\u0902\u0915 \u0905\u0936\u093f\u092d\u0932\u0947\u0916 \u0938\u0947 \u091a\u0947\u0915 \u092c\u0941\u0915 \u0914\u0930 \u092a\u093e\u0938\n\u092c\u0941\u0915 \u0915\u0940 \u092a\u093e\u0935\u0003\u0940 \u0930\u0938\u0940\u0926 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@ \u092a\u0902\u0915\u091c \u0915\u0941\u092e\u093e\u0930 \u091c\u0948\u0928 \u0915\u0940 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u092e\u0947\u0902 \u0930\u094d\u0925\u0940\u0940\u0964\n\u0909b \u0930\u093e\u091c \u0915\u0941\u092e\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930\u093f\u0930\u0003 \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u0947 \u092a\u0930 '\u0938\u094d\u0935\u092f\u0902' \u0915\u094b \u0926\u0947\u092f \u0926\u094b \u0928\u093f\u0928\u0915\u093e\u0938\u0940\n\u091a\u0947\u0915 \u092a\u0930 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u0905\u092a\u0940\u0932\u0915\u0003\u093e@ \u0930\u093e\u092e \u0917\u094b\u092a\u093e\u0932 \u0915\u0947 \u0939\u0938\u094d\u0003\u0932\u0947\u0916 \u092e\u0947\u0902 \u0930\u094d\u0925\u0940\u093e\u0964 '\u0938\u094d\u0935\u092f\u0902' \u0926\u094d\u0935\u093e\u0930\u093e\n\u0928\u093f\u0928\u0915\u093e\u0938\u0940 \u0915\u0947 \u0916\u093f\u0932\u090f \u0938\u092d\u0940 17 \u091c\u093e\u0932\u0940 \u091a\u0947\u0915 \u092a\u0930 \u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930 \u0905\u092a\u0940\u0932\u0940\u092f \u092a\u0902\u0915\u091c \u0915\u0941\u092e\u093e\u0930\n\u091c\u0948\u0928 \u0915\u0940 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u092e\u0947\u0902 \u0930\u094d\u0925\u0940\u0947 \u091c\u094b \u091c\u093e\u0932\u0940 \u0916\u093e\u0003\u093e \u0017\u093e\u0930\u0915 \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u0003\u0930\u0942\u0928\u093f\u092a\u0003 \u0915\u0930 \u0930\u0939\u0947 \u0930\u094d\u0925\u0940\u0947\u0964\n\u0939\u092e\u093e\u0930\u0940 \u0930\u093e\u092f \u092e\u0947\u0902 \u092f\u0947 \u0937\u0921\u093c\u092f\u0902\u0924\u094d\u0930 \u0938\u094d\u0930\u094d\u0925\u0940\u093e\u0928\u093f\u092a\u0003 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0916\u093f\u0932\u090f \u092a\u092f\u093e@\u092a\u094d\u0924 \u0930\u094d\u0925\u0940\u0947\u0964 \u0939\u0938\u094d\u0003\u0932\u0947\u0916 \u0928\u093f\u0935Z\u0947\u0937\u091c\u094d\u091e\n\u0921\u0940\u0921\u092c\u094d\u0932\u094d\u092f\u09421 \u0928\u0947 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0940 \u0916\u093f\u0932\u0916\u093e\u0935\u091f \u0914\u0930 \u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930 \u0915\u0940 \u091b\u093e\u092f\u093e\u092a\u094d\u0930\u0924\u093f\u0003 \u0915\u0947\n\u0906\u0017\u093e\u0930 \u092a\u0930 \u0905\u092a\u0928\u0940 \u0930\u093f\u0930\u092a\u094b\u091f@ \u0926\u0940 \u0930\u094d\u0925\u0940\u0940 \u0914\u0930 \u0909\u0928\u0915\u0947 \u0928\u092e\u0942\u0928\u093e \u0939\u0938\u094d\u0003\u093e\u0915\u094d\u0937\u0930 \u0915\u0947 \u0906\u0017\u093e\u0930 \u092a\u0930\n\u0928\u0939\u0940\u0902 \u0926\u0940 \u0930\u094d\u0925\u0940\u0940\u0964 \u0938\u0941\u0928\u0935\u093e\u0908 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0939\u092e\u0928\u0947 \u0905\u092a\u0940\u0932\u0915\u0003\u093e@\u0913\u0902 \u0915\u0947 \u0905\u0924\u093f\u0017\u0935b\u093e \u0938\u0947 \u092a\u0942\u091b\u093e \u0928\u093f\u0915\n\u0915\u094d\u092f\u093e \u0909\u0928\u094d\u0939\u094b\u0