\u0c28 \n\u0c38\u0c4d\u0c25\u0c30\u0c42\u0c2a\u0c4d\u0c3e \n\u0c35\u0c38\u0c4d\u0c24\u0c35\u0c41\u0c32\u0c41 \n\u0c35\u0c38\u0c4d\u0c24\u0c35\u0c41\u0c32\u0c28 \n\u0c0f\u0c15\u0c40\u0c15\u0c43\u0c24\u0c02 \n\u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f] \n\u0c15\u0c3e\u0c3e\u0c30\u0c47\u0c1c\u0c4d \n\u0c15\u0c4b\u0c38\u0c02 \n\u0c05\u0c24\u0c28\u0c3f\u0c15 \n\u0c05\u0c2a\u0c4d\u0c2a\u0c17\u0c02\u0c30\u0c30\u0c41, \u0c24\u0c2a\u0c4d\u0c2a \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c17\u0c3e\u0c2f\u0c02 \u0c17\u0c41\u0c30\u0c02\u0c1a\u0c3f \n\u0c2a\u0c4d\u0c30\u0c35\u0c3e\u0c24\u0c2a\u0c42\u0c30\u0c4d\u0c3e\u0c15\u0c02\u0c17\u0c3e \n\u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \n\u0c07\u0c35\u0c3e\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \n\u0c05\u0c24\u0c28\u0c3f\u0c28\u0c3f \n\u0c26\u0c3e\u0c35\u0c3e \u0c2f\u0c4a\u0c15\u0c15 \u0c38\u0c02\u0c38\u0c3e \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2e\u0c30\u0c2f\u0c41 \u0c06\u0c30\u0c41 \u0c32\u0c4b\u0c2a\u0c4d\u0c32 \n\u0c28\u0c37\u0c4d\u0c3f\u0c02 \n\u0c32\u0c47\u0c26\u0c3e \n\u0c17\u0c3e\u0c2f\u0c02 \n\u0c2e\u0c4a\u0c26\u0c1f \n\u0c35\u0c1a\u0c3f\u0c41\u0c28 \n\u0c28\u0c46\u0c32\u0c32 \n\u0c38\u0c2e\u0c2f\u0c02 \u0c35\u0c3e\u0c26\u0c3f \u0c2f\u0c4a\u0c15\u0c15 \u0c36\u0c4d\u0c3e\u0c28\u0c28\u0c02.\". \u0c05\u0c28\u0c3f \u0c05\u0c28\u0c4d\u0c28\u0c28\u0c30\u0c41.  \n \n9. \n\u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c4d \u0c2f\u0c3e\u0c15\u0c4d\u0c38\u0c3f, 1865\u0c32\u0c4b\u0c28\u0c3f \u0c2a\u0c48 \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 10 \u0c28\u0c3f\u0c37\u0c47\u0c27\u0c3f\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c3f. \u0c28\u0c37\u0c4d\u0c3f\u0c02 \n\u0c15\u0c4b\u0c38\u0c02 \u0c12\u0c15 \u0c38\u0c4d\u0c25\u0c27\u0c3e\u0c30\u0c4d\u0c23 \u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c2a\u0c48 \u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47 \u0c26\u0c3e\u0c35\u0c3e \u0c38\u0c02\u0c38\u0c3e \n\u0c38\u0c4d\u0c25\u0c27\u0c3e\u0c30\u0c4d\u0c23 \u0c15\u0c3e\u0c3e\u0c30\u0c47\u0c1c\u0c40\u0c15 \u0c05\u0c2a\u0c4d\u0c2a\u0c17\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c35\u0c38\u0c4d\u0c24\u0c35\u0c41\u0c32\u0c41, \u0c32\u0c47\u0c26\u0c3e \u0c17\u0c3e\u0c2f\u0c02 \n\u0c2a\u0c4d\u0c30\u0c35\u0c3e\u0c24\u0c2a\u0c42\u0c30\u0c4d\u0c3e\u0c15\u0c02\u0c17\u0c3e \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \u0c07\u0c35\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c4d\u0c35 \u0c15\u0c3e\u0c3e\u0c30\u0c47\u0c1c\u0c4d \u0c2f\u0c4a\u0c15\u0c15 \u0c09\u0c26\u0c4d\u0c26\u0c3e\u0c36\u0c3e\u0c02 \n\u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c17\u0c3e\u0c2f\u0c02 \u0c2e\u0c4a\u0c26\u0c1f\u0c3f \u0c35\u0c1a\u0c3f\u0c41\u0c28 \u0c06\u0c30\u0c41 \u0c28\u0c46\u0c32\u0c32\u0c4b\u0c41 \u0c06\u0c30\u0c4d\u0c35\u0c2a\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \n\u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c35\u0c3e\u0c26\u0c3f \u0c2f\u0c4a\u0c15\u0c15 \u0c36\u0c4d\u0c3e\u0c28\u0c28\u0c02 \u0c35\u0c30\u0c4d\u0c15\u0c41. \u0c2e\u0c30\u0c4d\u0c35 \u0c2e\u0c3e\u0c1f\u0c32\u0c4b \u0c1a\u0c46\u0c2a\u0c3e\u0c2a\u0c32\u0c02\u0c1f\u0c47, \n\u0c12\u0c15 \u0c26\u0c3e\u0c35\u0c3e \u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47. \u0c35\u0c38\u0c4d\u0c24\u0c35\u0c41\u0c32 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c17\u0c3e\u0c2f\u0c02 \u0c15\u0c4b\u0c38\u0c02 \n\u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c28 \u0c24\u0c3f\u0c30\u0c17 \u0c4a\u0c02\u0c26\u0c21\u0c02, \u0c15\u0c3e\u0c3e\u0c30\u0c47\u0c1c\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c4d\u0c25\u0c27\u0c3e\u0c30\u0c4d\u0c23 \u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c15\u0c41 \n\n5 \n \n\u0c05\u0c2a\u0c4d\u0c2a\u0c17\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28\u0c26\u0c3f \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c4d\u0c35 \u0c28\u0c3f\u0c37\u0c47\u0c27\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c12\u0c15 \u0c32\u0c40\u0c30\u0c32\u0c4d \n\u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d, \u0c2a\u0c48\u0c28 \u0c1a\u0c46\u0c2a\u0c3f\u0c2a\u0c28\u0c1f\u0c41\u0c41\u0c17\u0c3e \u0c15\u0c3e\u0c28\u0c40 \u0c07\u0c24\u0c30\u0c4d \u0c38\u0c3e\u0c2d\u0c3e\u0c35\u0c02 \u0c2f\u0c4a\u0c15\u0c15 \n\u0c38\u0c4d\u0c24\u0c1f\u0c4d\u0c32\u0c41 \u0c15\u0c3e\u0c26\u0c41, \u0c15\u0c3e\u0c30\u0c4d\u0c23\u0c02\u0c17\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c17\u0c3e\u0c2f\u0c02 \u0c15\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c4d\u0c35 \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \n\u0c2e\u0c4a\u0c24\u0c24\u0c02 \u0c30\u0c15\u0c35\u0c30\u0c40 \u0c30\u0c4d\u0c35\u0c3e\u0c23\u0c3e \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c2a\u0c4d\u0c2a\u0c17\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c38\u0c4d\u0c24\u0c35\u0c41\u0c32\u0c41.           \n10. \u0c2a\u0c3e\u0c24 \u0c1a\u0c1f\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c28 \u0c2d\u0c4d\u0c30\u0c40\u0c24 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c15\u0c3e\u0c3e\u0c30\u0c47\u0c1c\u0c4d \u0c2c\u0c48 \u0c30\u0c4d\u0c35\u0c21\u0c4d \u0c1a\u0c1f\u0c3f\u0c2e\u0c41, 2007 (\u0c15\u0c4a\u0c24\u0c24\u0c26\u0c3f) \n\u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 16 \u0c15\u0c02\u0c26 \u0c08 \u0c2a\u0c4d\u0c30\u0c15\u0c02\u0c26\u0c3f \u0c05\u0c02\u0c36\u0c3e\u0c32\u0c28 \u0c4a\u0c02\u0c26\u0c41\u0c2a\u0c4d\u0c30\u0c4d\u0c1a\u0c3f\u0c02\u0c26\u0c3f\u0c40\u0c03  \n\u201c\u0c38\u0c30\u0c4d\u0c15\u0c41 \u0c30\u0c4d\u0c35\u0c3e\u0c23\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c41 \u0c38\u0c30\u0c41\u0c15\u0c41 \u0c2c\u0c41\u0c15\u0c4d\u0c38 \u0c1a\u0c47\u0c38\u0c4d\u0c15\u0c41\u0c28\u0c28 \u0c24\u0c47\u0c26 \n\u0c28\u0c02\u0c21\u0c3f \u0c28\u0c42\u0c1f \u0c0e\u0c28\u0c2d\u0c48 \u0c30\u0c4d\u0c35\u0c1c\u0c41\u0c32\u0c4b\u0c41\u0c17\u0c3e, \u0c15\u0c47\u0c38\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c07\u0c24\u0c30\u0c4d \n\u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32 \u0c36\u0c4d\u0c38\u0c4d\u0c25\u0c3e\u0c2a\u0c4d\u0c28\u0c15\u0c41 \u0c2e\u0c41\u0c02\u0c26\u0c41, \u0c38\u0c30\u0c41\u0c15\u0c41 \n\u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c17\u0c41\u0c30\u0c02\u0c1a\u0c3f \u0c32\u0c3f\u0c16\u0c3f\u0c24\u0c2a\u0c42\u0c30\u0c4d\u0c3e\u0c15 \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \n\u0c3e\u0c30\u0c40 \n\u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c24\u0c47\u0c28\u0c47 \n\u0c24\u0c2a\u0c4d\u0c2a, \n\u0c38\u0c30\u0c4d\u0c15\u0c41 \n\u0c30\u0c4d\u0c35\u0c3e\u0c23\u0c3e\u0c28 \n\u0c15\u0c4b\u0c32\u0c4b\u0c2a\u0c2f\u0c3f\u0c28\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c28\u0c02\u0c26\u0c41\u0c15\u0c41, \u0c09\u0c2e\u0c2e\u0c21\u0c3f \n\u0c30\u0c4d\u0c35\u0c3e\u0c23\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c28\u0c3f\u0c15 \u0c35\u0c3e\u0c24\u0c3f\u0c30\u0c47\u0c15\u0c02\u0c17\u0c3e \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c26\u0c3e\u0c35\u0c3e \u0c32\u0c47\u0c26\u0c3e \n\u0c07\u0c24\u0c30\u0c4d \u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c41 \u0c1a\u0c47\u0c2a\u0c4d\u0c1f\u0c3f\u0c15\u0c42\u0c21\u0c26\u0c41.\" \u0c05\u0c28\u0c3f \n\u0c05\u0c28\u0c4d\u0c28\u0c28\u0c30\u0c41.  \n11. \u0c15\u0c4a\u0c24\u0c24 \u0c1a\u0c1f\u0c3f\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 16 \u0c2a\u0c4d\u0c30\u0c32\u0c4b \u0c0e\u0c15\u0c41\u0c15\u0c35 \u0c32\u0c47\u0c26\u0c3e \n\u0c24\u0c15\u0c41\u0c15\u0c35 \u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c4d \u0c1a\u0c1f\u0c3f\u0c02, 1865\u0c32\u0c4b\u0c28\u0c3f \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 10\u0c24\u0c4b \u0c2e\u0c46\u0c1f\u0c40\u0c30\u0c2f\u0c3e \n\u0c09\u0c02\u0c26\u0c3f \u0c30\u0c4d\u0c26\u0c41\u0c3e \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c26\u0c3e\u0c35\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c41 \n\u0c32\u0c47\u0c35\u0c28\u0c3f \u0c15\u0c42\u0c21\u0c4d\u0c35 \u0c07\u0c26\u0c3f \u0c28\u0c3f\u0c30\u0c47\u0c3e\u0c36\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c3f. \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c15 \u0c38\u0c4d\u0c25\u0c27\u0c3e\u0c30\u0c4d\u0c23 \n\u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c15\u0c41 \u0c35\u0c3e\u0c24\u0c3f\u0c30\u0c47\u0c15\u0c02\u0c17\u0c3e \u0c0f\u0c30\u0c4d\u0c27\u0c2a\u0c1f\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c32\u0c47\u0c26\u0c3e \n\u0c28\u0c37\u0c4d\u0c3f\u0c02, \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c15 \u0c2a\u0c4d\u0c30\u0c35\u0c3e\u0c24\u0c2a\u0c42\u0c30\u0c4d\u0c3e\u0c15 \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \u0c24\u0c2a\u0c4d\u0c2a \u0c38\u0c30\u0c41\u0c15\u0c41 \n\u0c38\u0c30\u0c41\u0c15\u0c41\u0c15\u0c41 \n\u0c2e\u0c41\u0c02\u0c26\u0c41 \n\u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c2a\u0c48 \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \n\u0c26\u0c3e\u0c35\u0c3e \n\n6 \n \n\u0c2f\u0c4a\u0c15\u0c15 \u0c38\u0c02\u0c38\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c06\u0c30\u0c41 \u0c28\u0c46\u0c32\u0c32\u0c32\u0c4b\u0c2a\u0c41 \u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c41 \n\u0c30\u0c4d\u0c35\u0c3e\u0c23\u0c3e\u0c26\u0c3e\u0c30\u0c41 \u0c26\u0c3e\u0c3e\u0c30\u0c4d\u0c27 \u0c38\u0c30\u0c41\u0c15\u0c41\u0c28 \u0c2c\u0c41\u0c15\u0c02\u0c17\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c47\u0c26 \u0c28\u0c02\u0c21\u0c3f \u0c2a\u0c48 \n\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c28 \n\u0c28\u0c3f\u0c36\u0c24\u0c02\u0c17\u0c3e \n\u0c2a\u0c4d\u0c30\u0c30\u0c32\u0c3f\u0c38\u0c4d\u0c24\u0c24 \n\u0c05\u0c26\u0c3f \n\u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47 \n\u0c15\u0c3e\u0c26\u0c28\u0c3f \n\u0c24\u0c46\u0c32\u0c41\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c3f. \n\u0c26\u0c3e\u0c35\u0c3e\u0c28 \n\u0c28\u0c3f\u0c37\u0c47\u0c27\u0c3f\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c3f \n\u0c15\u0c3e\u0c28\u0c40 \n\u0c1a\u0c47\u0c30\u0c4d\u0c41\u0c2c\u0c21\u0c28\u0c3f \n\u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c28 \u0c15\u0c42\u0c21\u0c4d\u0c35 \u0c05\u0c21\u0c41\u0c21\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c02\u0c26\u0c3f. \u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c4d \n\u0c1a\u0c1f\u0c3f\u0c02, 1865\u0c32\u0c4b\u0c28\u0c3f \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 10 \u0c2f\u0c4a\u0c15\u0c15 \u0c2e\u0c41\u0c28\u0c2a\u0c4d\u0c1f\u0c3f \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c4b, \n\u0c07\u0c24\u0c30\u0c4d \n\u0c35\u0c3f\u0c1a\u0c32\u0c28\u0c02 \n\u0c36\u0c4d\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02\u0c32\u0c4b \n\"\u0c38\u0c30\u0c41\u0c15\u0c41\" \n\u0c05\u0c28\u0c47 \n\u0c2a\u0c4d\u0c26\u0c3e\u0c28\u0c3f\u0c28 \n\u0c09\u0c2a\u0c4d\u0c2f\u0c4b\u0c17\u0c02\u0c1a\u0c21\u0c02 \"\u0c05\u0c2a\u0c4d\u0c2a\u0c17\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c38\u0c4d\u0c24\u0c35\u0c41\u0c32\u0c41\". \u0c2e\u0c30\u0c4d\u0c35 \u0c2e\u0c3e\u0c1f\u0c32\u0c4b \n\u0c1a\u0c46\u0c2a\u0c3e\u0c2a\u0c32\u0c02\u0c1f\u0c47, \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \u0c30\u0c02\u0c21\u0c42 \u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c4d \u0c1a\u0c1f\u0c3f\u0c02\u0c32\u0c4b\u0c28\u0c3f \n\u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 10 \u0c30\u0c4d\u0c26\u0c41\u0c3e \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41 \u0c2e\u0c30\u0c2f\u0c41 \n\u0c05\u0c2e\u0c32\u0c41\u0c32\u0c4b \u0c28\u0c3f\u0c32\u0c3f\u0c2a\u0c3f\u0c35\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f, \u0c36\u0c4d\u0c38\u0c4d\u0c25\u0c3e\u0c2a\u0c3f\u0c02\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \n\u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c3f. \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \u0c12\u0c15 \u0c38\u0c4d\u0c25\u0c27\u0c3e\u0c30\u0c4d\u0c23 \u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c2a\u0c48 \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \n\u0c26\u0c3e\u0c35\u0c3e/\u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c41 \u0c38\u0c30\u0c41\u0c15\u0c41\u0c15\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02. \u0c2a\u0c48\u0c28 \n\u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28 \u0c26\u0c3e\u0c35\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c35\u0c3f\u0c30\u0c30\u0c4d\u0c23 \u0c2f\u0c4a\u0c15\u0c15 \n\u0c38\u0c02\u0c38\u0c3e \u0c38\u0c02\u0c26\u0c30\u0c4d\u0c2d\u0c02\u0c32\u0c4b \u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47, \u0c38\u0c30\u0c41\u0c15\u0c41\u0c15\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \n\u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c30\u0c2f\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c15\u0c3e\u0c26\u0c41. \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \u0c07\u0c24\u0c30\u0c4d \u0c30\u0c4d\u0c15\u0c2e\u0c48\u0c28 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \n\u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \u0c15\u0c3e\u0c15\u0c41\u0c02\u0c21\u0c4d\u0c35 \u0c38\u0c30\u0c41\u0c15\u0c41\u0c15\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \n\u0c28\u0c37\u0c4d\u0c3f\u0c02.  \n\n7 \n \n12. \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d VIII \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28 6-\u0c0e (4) \u0c38\u0c3f. \u0c2a\u0c3f. \u0c38\u0c3f. \u0c26\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c3e, \u0c15\u0c02\u0c1f\u0c30\u0c4d-\u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \n\u0c28\u0c3f\u0c3e\u0c28\u0c3f\u0c15 \u0c12\u0c15 \u0c26\u0c3e\u0c35\u0c3e \u0c2e\u0c30\u0c2f\u0c41 \u0c38\u0c3e\u0c24\u0c02\u0c2a\u0c4d\u0c30\u0c24 \u0c26\u0c3e\u0c35\u0c3e. VII \u0c38\u0c40\u0c2a\u0c4d\u0c2a\u0c38\u0c40 \n\u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c4b\u0c28\u0c3f 11\u0c35 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28 \n\u0c15\u0c02\u0c26 \n\u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \n\u0c37\u0c4d\u0c30\u0c4d\u0c24\u0c41\u0c32 \n\u0c2a\u0c4d\u0c30\u0c27\u0c3f\u0c32\u0c4b\u0c15 \n\u0c35\u0c1a\u0c47\u0c41 \n\u0c06\u0c30\u0c4d\u0c35\u0c2a\u0c4d\u0c23\u0c32\u0c41 \n\u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47 \n\u0c2a\u0c4d\u0c30\u0c30\u0c23\u0c28\u0c32\u0c4b\u0c15 \n\u0c24\u0c40\u0c38\u0c4d\u0c15\u0c4b\u0c35\u0c3e\u0c32\u0c3f\u0c4d\u0c28 \n\u0c05\u0c35\u0c38\u0c30\u0c4d\u0c02 \n\u0c09\u0c28\u0c28\u0c02\u0c26\u0c41\u0c28 \n\u0c24\u0c3f\u0c30\u0c4d\u0c38\u0c15\u0c30\u0c02\u0c30\u0c32\u0c3f\u0c4d\u0c28 \n\u0c05\u0c35\u0c38\u0c30\u0c4d\u0c02 \u0c09\u0c02\u0c26\u0c28\u0c3f \u0c07\u0c26\u0c3f \u0c36\u0c3e\u0c38\u0c28\u0c2e\u0c41 \u0c2f\u0c4a\u0c15\u0c15 \u0c36\u0c4d\u0c38\u0c3f\u0c3e\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c24\u0c3f\u0c2a\u0c3e\u0c26\u0c28.  \n13. \u0c2a\u0c48\u0c28 \n\u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \n\u0c35\u0c3e\u0c38\u0c24\u0c35\u0c3e\u0c32\u0c41 \n\u0c2e\u0c30\u0c2f\u0c41 \n\u0c2a\u0c4d\u0c30\u0c38\u0c3f\u0c3e\u0c24\u0c41\u0c32 \n\u0c26\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c3e, \n\u0c2b\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c26\u0c41\u0c26\u0c3e\u0c30\u0c41-\u0c2e\u0c4a\u0c26\u0c1f\u0c3f \u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c24\u0c3f\u0c35\u0c3e\u0c26\u0c3f \u0c06\u0c30\u0c4d\u0c21\u0c30\u0c4d VII \u0c30\u0c42\u0c32\u0c4d 11 \u0c38\u0c3f. \u0c2a\u0c3f. \u0c38\u0c3f. \u0c15\u0c02\u0c26 \n\u0c05\u0c2a\u0c4d\u0c2a\u0c2a\u0c32\u0c41\u0c26\u0c3e\u0c30\u0c41-\u0c2e\u0c4a\u0c26\u0c1f\u0c3f \n\u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c24\u0c3f\u0c35\u0c3e\u0c26\u0c3f \n\u0c0f\u0c30\u0c4d\u0c27\u0c2a\u0c1f\u0c41 \n\u0c1a\u0c47\u0c38\u0c3f\u0c28 \n\u0c15\u0c02\u0c1f\u0c30\u0c4d-\n\u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c2e\u0c41\u0c28 \u0c24\u0c3f\u0c30\u0c4d\u0c38\u0c15\u0c30\u0c02\u0c30\u0c32\u0c28\u0c3f \u0c12\u0c24\u0c3f\u0c24\u0c21\u0c3f \u0c1a\u0c47\u0c36\u0c3e\u0c30\u0c41, \u0c0e\u0c02\u0c26\u0c41\u0c15\u0c02\u0c1f\u0c47 \u0c07\u0c26\u0c3f \n\u0c15\u0c3e\u0c3e\u0c30\u0c2f\u0c30\u0c4d\u0c4d \u0c1a\u0c1f\u0c3f\u0c2e\u0c41, 1865 \u0c2f\u0c4a\u0c15\u0c15 \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 10 \u0c26\u0c3e\u0c3e\u0c30\u0c4d\u0c27 \u0c4a\u0c30\u0c4d\u0c2a\u0c3e\u0c1f\u0c41\u0c28 \n\u0c06\u0c32\u0c4b\u0c1a\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c27\u0c02\u0c17\u0c3e \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30 \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d\u0c28 \u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c15\u0c41\u0c02\u0c21\u0c4d\u0c35, \n\u0c15\u0c3e\u0c28\u0c40 \u0c35\u0c3e\u0c38\u0c24\u0c35\u0c3e\u0c28\u0c3f\u0c15 \u0c15\u0c4a\u0c24\u0c24 \u0c1a\u0c1f\u0c3f\u0c2e\u0c41 \u0c2f\u0c4a\u0c15\u0c15 \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 16 \u0c26\u0c3e\u0c3e\u0c30\u0c4d\u0c27 \u0c2a\u0c4d\u0c30\u0c2a\u0c3e\u0c27\u0c3e\u0c28\u0c3e\u0c24 \n\u0c07\u0c35\u0c3e\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.  \n14. \u0c15\u0c02\u0c1f\u0c30\u0c4d-\u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \u0c38\u0c2e\u0c30\u0c2a\u0c02\u0c1a\u0c21\u0c4d\u0c35\u0c28\u0c3f\u0c15 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30 \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \n\u0c3e\u0c30\u0c40 \u0c1a\u0c47\u0c2f\u0c28\u0c02\u0c26\u0c41\u0c28 \u0c2a\u0c4d\u0c30\u0c41\u0c35\u0c40\u0c15\u0c30\u0c4d\u0c23 \u0c24\u0c3f\u0c30\u0c4d\u0c38\u0c15\u0c30\u0c02\u0c30\u0c32\u0c28\u0c3f \u0c2e\u0c4a\u0c26\u0c1f\u0c3f \n\u0c09\u0c26\u0c3e\u0c39\u0c30\u0c4d\u0c23 \u0c15\u0c4b\u0c30\u0c41\u0c3f \u0c06\u0c26\u0c4d\u0c26\u0c36\u0c02\u0c1a\u0c3f\u0c02\u0c26\u0c3f.  \n\n8 \n \n15. \u0c2a\u0c4d\u0c30\u0c15\u0c02\u0c26 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \u0c15\u0c4b\u0c30\u0c41\u0c3f\u0c32 \u0c06\u0c26\u0c4d\u0c26\u0c36\u0c3e\u0c32\u0c28 \u0c35\u0c3f\u0c2e\u0c30\u0c36\u0c38\u0c4d\u0c24\u0c24, \u0c15\u0c4a\u0c24\u0c24 \u0c1a\u0c1f\u0c3f\u0c2e\u0c41 \n\u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 16 \u0c2f\u0c4a\u0c15\u0c15 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c41\u0c28 \u0c26\u0c3e\u0c28\u0c3f \u0c38\u0c2a\u0c37\u0c4d\u0c3f\u0c2e\u0c48\u0c28 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c4d\u0c27\u0c30\u0c4d\u0c3e \n\u0c2d\u0c3e\u0c35\u0c02\u0c32\u0c4b \u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c36\u0c02\u0c38\u0c3f\u0c02\u0c1a\u0c15\u0c2a\u0c4b\u0c35\u0c21\u0c02\u0c32\u0c4b \u0c15\u0c4b\u0c30\u0c41\u0c3f\u0c32\u0c41 \u0c38\u0c2a\u0c37\u0c4d\u0c3f\u0c02\u0c17\u0c3e \u0c24\u0c2a\u0c41\u0c2a \n\u0c1a\u0c47\u0c36\u0c3e\u0c2f\u0c28\u0c3f \u0c38\u0c2e\u0c30\u0c2a\u0c02\u0c30\u0c30\u0c41.\u0c38\u0c30\u0c41\u0c15\u0c41 \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \n\u0c15\u0c4b\u0c38\u0c02 \u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \u0c09\u0c28\u0c28\u0c2a\u0c41\u0c2a\u0c21\u0c41 \u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47 \u0c08 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28 \u0c35\u0c30\u0c24\u0c36\u0c4d\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c3f, \n\u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c2f\u0c4a\u0c15\u0c15 \u0c07\u0c24\u0c30\u0c4d \u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \n\u0c15\u0c3e\u0c26\u0c41.\u0c35\u0c3e\u0c3e\u0c2a\u0c3e\u0c30\u0c4d \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c3e\u0c32\u0c28 \u0c15\u0c4b\u0c32\u0c4b\u0c2a\u0c35\u0c21\u0c02, \u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c24\u0c3f\u0c37\u0c4d\u0c20 \u0c15\u0c4b\u0c32\u0c4b\u0c2a\u0c35\u0c21\u0c02, \n\u0c2e\u0c28\u0c37\u0c41\u0c32\u0c41, \u0c2f\u0c02\u0c2a\u0c4d\u0c30\u0c3e\u0c32\u0c41, \u0c13\u0c35\u0c30\u0c4d \u0c39\u0c46\u0c21\u0c4d\u0c4d \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28 \u0c35\u0c3e\u0c1f\u0c3f \u0c35\u0c32\u0c41 \n\u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c1c\u0c30\u0c17\u0c02\u0c26\u0c28\u0c3f, \u0c38\u0c30\u0c4d\u0c15\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c1c\u0c30\u0c17\u0c02\u0c26\u0c28\u0c3f \u0c05\u0c2a\u0c4d\u0c2a\u0c2a\u0c32\u0c41\u0c26\u0c3e\u0c30\u0c41\u0c21\u0c41 \n\u0c35\u0c3e\u0c26\u0c3f\u0c02\u0c30\u0c30\u0c41.  \n16. \u0c15\u0c4a\u0c24\u0c24 \u0c1a\u0c1f\u0c3f\u0c2e\u0c41 \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 16 \u0c28 \u0c1a\u0c26\u0c3f\u0c35\u0c3f\u0c28\u0c2a\u0c41\u0c21\u0c41, \u0c38\u0c30\u0c41\u0c15\u0c41 \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \n\u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c38\u0c4d\u0c25\u0c27\u0c3e\u0c30\u0c4d\u0c23 \u0c30\u0c4d\u0c35\u0c3e\u0c23\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c28\u0c3f\u0c15 \u0c35\u0c3e\u0c24\u0c3f\u0c30\u0c47\u0c15\u0c02\u0c17\u0c3e \u0c26\u0c3e\u0c35\u0c3e \n\u0c32\u0c47\u0c26\u0c3e \n\u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \n\u0c1a\u0c30\u0c4d\u0c3e\u0c32 \n\u0c35\u0c3f\u0c37\u0c4d\u0c2f\u0c02\u0c32\u0c4b \n\u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47 \n\u0c07\u0c26\u0c3f \n\u0c35\u0c30\u0c24\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c28\u0c3f \u0c24\u0c47\u0c32\u0c3f\u0c02\u0c26\u0c3f.\"\u0c08 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c4b\" \"\u0c38\u0c30\u0c41\u0c15\u0c41\" \"\u0c05\u0c28\u0c47 \u0c2a\u0c4d\u0c26\u0c3e\u0c28\u0c3f\u0c28 \n\u0c09\u0c2a\u0c4d\u0c2f\u0c4b\u0c17\u0c02\u0c1a\u0c21\u0c02 \u0c30\u0c32\u0c3e \u0c38\u0c4d\u0c25\u0c30\u0c4d\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28\u0c26\u0c3f.\"\u0c38\u0c30\u0c41\u0c15\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \n\u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c15 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c26\u0c3e\u0c35\u0c3e \u0c2e\u0c30\u0c2f\u0c41 \u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c41 \n\u0c2e\u0c3e\u0c2a\u0c4d\u0c30\u0c24\u0c2e\u0c47 \u0c26\u0c3e\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c27\u0c3f\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c28\u0c2f\u0c28\u0c3f, \u0c26\u0c28\u0c3f \u0c15\u0c4b\u0c38\u0c02 \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \n\u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30 \u0c05\u0c28\u0c3f \u0c07\u0c26\u0c3f \u0c38\u0c4d\u0c24\u0c1a\u0c3f\u0c38\u0c4d\u0c24\u0c02\u0c26\u0c3f.\u0c08 \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28 \u0c0f \u0c07\u0c24\u0c30\u0c4d \u0c30\u0c4d\u0c15\u0c02 \n\n9 \n \n\u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c26\u0c30\u0c4d\u0c16\u0c4d\u0c2f\u0c38\u0c4d\u0c24,  \u0c35\u0c30\u0c24\u0c02\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \n\u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c35\u0c30\u0c24\u0c02\u0c1a\u0c26\u0c41. \u0c35\u0c3f\u0c35\u0c3f\u0c27 \u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c15\u0c43\u0c24\u0c3f \u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c32\u0c15\u0c41 \n\u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \n\u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c32 \n\u0c35\u0c38\u0c4d\u0c24\u0c32\u0c41 \n\u0c1a\u0c47\u0c2f\u0c41\u0c1f \n\u0c15\u0c4b\u0c38\u0c02 \n\u0c0f\u0c30\u0c4d\u0c27\u0c2a\u0c1f\u0c41 \n\u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c1c\u0c30\u0c17\u0c02\u0c26\u0c3f.  \n17. \u0c15\u0c02\u0c1f\u0c30\u0c4d-\u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \u0c28 \u0c1a\u0c26\u0c3f\u0c35\u0c3f \u0c1a\u0c42\u0c38\u0c4d\u0c24\u0c24, \u0c35\u0c3e\u0c3e\u0c2a\u0c3e\u0c30\u0c4d \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c3e\u0c32\u0c28 \n\u0c15\u0c4b\u0c32\u0c4b\u0c2a\u0c35\u0c21\u0c02, \u0c2e\u0c28\u0c37\u0c41\u0c32\u0c41, \u0c2f\u0c02\u0c2a\u0c4d\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c2f\u0c41 \u0c13\u0c35\u0c30\u0c4d \u0c39\u0c46\u0c21\u0c4d\u0c4d \n\u0c15\u0c3e\u0c30\u0c4d\u0c23\u0c02\u0c17\u0c3e \n\u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c24\u0c3f\u0c37\u0c4d\u0c3f\u0c28 \n\u0c15\u0c4b\u0c32\u0c4b\u0c2a\u0c35\u0c21\u0c02 \n\u0c2e\u0c30\u0c2f\u0c41 \n\u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c15 \n\u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c05\u0c2a\u0c4d\u0c2a\u0c2a\u0c32\u0c41\u0c26\u0c3e\u0c30\u0c41-\u0c2e\u0c4a\u0c26\u0c1f\u0c3f \u0c2a\u0c4d\u0c30\u0c2a\u0c4d\u0c24\u0c3f\u0c35\u0c3e\u0c26\u0c3f \u0c0f\u0c30\u0c4d\u0c27\u0c2a\u0c1f\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \n\u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c15 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c32\u0c41 \u0c38\u0c2a\u0c37\u0c4d\u0c3f\u0c02\u0c17\u0c3e \u0c35\u0c46\u0c32\u0c41\u0c21\u0c3f \n\u0c05\u0c35\u0c41\u0c3e\u0c2f\u0c3f.\u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \u0c38\u0c30\u0c41\u0c15\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c15\u0c02\u0c1f\u0c30\u0c4d \n\u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d \u0c35\u0c02\u0c1f\u0c3f \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c26\u0c3e\u0c35\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c1a\u0c1f\u0c3f\u0c2a\u0c4d\u0c30\u0c4d\u0c2e\u0c48\u0c28 \u0c1a\u0c30\u0c4d\u0c3e\u0c32\u0c28 \n\u0c07\u0c26\u0c3f \u0c2a\u0c4d\u0c30\u0c2a\u0c3e\u0c30\u0c4d\u0c02\u0c2d\u0c02\u0c1a\u0c32\u0c47\u0c26\u0c41.\u0c26\u0c3f\u0c17\u0c41\u0c35 \u0c15\u0c4b\u0c30\u0c41\u0c3f\u0c32\u0c41 \u0c08 \u0c35\u0c3f\u0c37\u0c4d\u0c2f\u0c02\u0c32\u0c4b \u0c2a\u0c48\u0c28 \n\u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \n\u0c05\u0c02\u0c36\u0c3e\u0c28\u0c3f\u0c28 \n\u0c38\u0c2a\u0c37\u0c4d\u0c3f\u0c02\u0c17\u0c3e \n\u0c35\u0c3f\u0c38\u0c2e\u0c30\u0c02\u0c30\u0c2f\u0c3f \n\u0c2e\u0c30\u0c2f\u0c41 \n\u0c30\u0c4d\u0c35\u0c3e\u0c23\u0c3e\u0c15\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c2e\u0c41\u0c32\u0c41 \u0c2e\u0c3f\u0c28\u0c39\u0c3e \u0c07\u0c24\u0c30\u0c4d \n\u0c30\u0c4d\u0c15\u0c3e\u0c32 \u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c2e\u0c41 \u0c2e\u0c27\u0c3e \u0c0e\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c35\u0c3e\u0c3e\u0c3e\u0c38\u0c02 \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c4d\u0c35, \u0c15\u0c02\u0c1f\u0c30\u0c4d-\n\u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c2e\u0c41\u0c28 \u0c24\u0c3f\u0c30\u0c4d\u0c38\u0c15\u0c30\u0c02\u0c30\u0c32\u0c28\u0c3f \u0c1a\u0c1f\u0c3f\u0c35\u0c3f\u0c30\u0c41\u0c26\u0c3e\u0c02\u0c17\u0c3e \u0c06\u0c26\u0c4d\u0c26\u0c36\u0c02\u0c30\u0c2f\u0c3f.  \n18. \u0c15\u0c4a\u0c24\u0c24 \u0c1a\u0c1f\u0c3f\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d 16\u0c32\u0c4b\u0c28\u0c3f \u0c28\u0c3f\u0c2c\u0c02\u0c27\u0c28 \u0c05\u0c2e\u0c32\u0c41\u0c32\u0c4b\u0c15 \u0c30\u0c4d\u0c27\u0c26\u0c41, \n\n1\n \n\u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d\u0c32\u0c15\u0c41 \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f \u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d \u0c07\u0c35\u0c3e\u0c3e\u0c32\u0c28\u0c47 \u0c37\u0c4d\u0c30\u0c4d\u0c24\u0c41\u0c28 \u0c35\u0c3f\u0c38\u0c4d-\u0c0e-\n\u0c35\u0c3f\u0c38\u0c4d \u0c36\u0c4d\u0c2a\u0c47\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c16\u0c4d\u0c2f\u0c3e\u0c24\u0c3f, \u0c35\u0c3e\u0c3e\u0c2a\u0c3e\u0c30\u0c4d \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c02 \u0c2e\u0c4a\u0c26\u0c32\u0c48\u0c28 \u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c32\u0c15\u0c41 \n\u0c28\u0c37\u0c4d\u0c3f\u0c2a\u0c4d\u0c30\u0c39\u0c3e\u0c30\u0c4d\u0c02 \u0c15\u0c4b\u0c38\u0c02, \u0c05\u0c1f\u0c41\u0c35\u0c02\u0c1f\u0c3f \u0c36\u0c4d\u0c46\u0c41\u0c2f\u0c3f\u0c4d\u0c32\u0c41 \u0c28\u0c37\u0c4d\u0c3f\u0c02 \u0c32\u0c47\u0c26\u0c3e \u0c28\u0c37\u0c4d\u0c1f\u0c3f\u0c28\u0c3f\u0c15 \n\u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c02\u0c1a\u0c3f\u0c28\u0c35\u0c3f \u0c15\u0c3e\u0c35\u0c41 \u0c38\u0c30\u0c41\u0c15\u0c41. \n19. \u0c2a\u0c48\u0c28 \u0c2a\u0c47\u0c30\u0c4d\u0c15\u0c15\u0c28\u0c28 \u0c35\u0c3e\u0c38\u0c24\u0c35\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c38\u0c3f\u0c3e\u0c24\u0c41\u0c32 \u0c26\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c3e, \u0c2e\u0c47\u0c2e\u0c41 \n\u0c15\u0c4a\u0c24\u0c24 \n\u0c1a\u0c1f\u0c3f\u0c02\u0c32\u0c4b\u0c28\u0c3f \n\u0c38\u0c46\u0c15\u0c4d\u0c37\u0c28\u0c4d \n16 \n\u0c15\u0c02\u0c26 \n\u0c0e\u0c32\u0c3e\u0c02\u0c1f\u0c3f \n\u0c28\u0c4b\u0c1f\u0c40\u0c38\u0c4d\u0c32\u0c41 \n\u0c07\u0c35\u0c3e\u0c32\u0c47\u0c26\u0c28\u0c3f \u0c05\u0c2d\u0c2a\u0c4d\u0c30\u0c2a\u0c3e\u0c2f\u0c2a\u0c4d\u0c21\u0c4d\u0c35\u0c21\u0c30\u0c41. \u0c0f\u0c26\u0c48\u0c28\u0c4d\u0c28 \u0c26\u0c3e\u0c35\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c32\u0c40\u0c30\u0c32\u0c4d \n\u0c2a\u0c4d\u0c30\u0c4a\u0c38\u0c40\u0c21\u0c3f\u0c02\u0c17\u0c4d\u0c32\u0c41 \u0c30\u0c32\u0c3e \u0c24\u0c15\u0c41\u0c15\u0c35\u0c17\u0c3e \u0c0f\u0c30\u0c4d\u0c27\u0c2a\u0c1f\u0c41 \u0c1a\u0c47\u0c2f\u0c21\u0c4d\u0c35\