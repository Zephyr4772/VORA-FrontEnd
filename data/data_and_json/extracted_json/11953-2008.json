    "full_text": "\u0905\u092a\u094d\u0930\u0924\u093f\u0004\u0935\u0947\u0926\u094d\u092f\n\u092d\u093e\u0930\u0004\u0940\u092f \u0938\u0935\u000f\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\n\u0938\u093f\u0938\u0935\u093f\u0935\u0932 \u0905\u092a\u0940\u0932\u0940\u092f \u0905\u0924\u093f\u0016\u0915\u093e\u0930\u093f\u0930\u0004\u093e\n\u0938\u093f\u0938\u0935\u093f\u0935\u0932 \u0905\u092a\u0940\u0932 \u0938\u0902\n \n . (S) 10208 S) 10208 ) 10208 \n \n \u0938\u0928\u094d \n \n 2010\n \n \n\u0930\u093e\u0016\u0947 \u0936\u094d\u092f\u093e\u092e \u092a\u093e\u0923\u094d\u0921\u0947\u092f\n\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940!(S) 10208 \u0917\u0923)\n\u092c\u0928\u093e\u092e   \n\u0915\u093e\u0928\u092a\u0941\u0930 \u0935\u093f\u0935\u0915\u093e\u0938 \u092a\u094d\u0930\u093e\u0924\u093f\u0016\u0915\u0930\u0923\n\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940!(S) 10208 \u0917\u0923)\n\u0935\u093f\u0928\u0923'\u092f \n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0004\n \n ,   \u092d\u093e\u0928\u0941\u092e\u0924\u093f\u0004\n \n :-\n  \n(1) \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u094b \u0938\u0928\u094d 1963 \u092e\u0947\u0902 \u0004\u0943\u0004\u0940\u092f \u0936\u094d\u0930\u0947\u0923\u0940 \u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947\n\u092a\u0926 \u092a\u0930 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e \u0914\u0930 \u0935\u093f\u0926\u0928\u093e\u0902\u0915\n23.10.1969  \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u0939 \u0938\u094d\u0930\u094d\u0925\u0940\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947\n\u0935\u093f\u0926\u094d\u0935\u0004\u0940\u092f \u0936\u094d\u0930\u0947\u0923\u0940 \u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u092a\u0926 \u092a\u0930 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0939\u0941\u0906\u0964 \u0907\u0938\u0915\u0947 \u092a\u0936\u094d\u091a\u093e\u0004\u094d\n\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0935\u093f\u0926\u0928\u093e\u0902\u0915\n12.12.1969\n \u0004\u0915 \u0004\u0926\u0930\u094d\u0925\u0940'\n\u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0939\u0941\u0906\u0964 \u092c\u093e\u0926 \u092e\u0947\u0902,  \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940!\n05.07.1973  \u0915\u094b \u0935\u093e\u092a\u0938 \u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924\n\u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e  \u0914\u0930 \u0932\u0917\u093e\u0004\u093e\u0930 \u0907\u0938 \u092a\u0926 \u092a\u0930 \u0915\u093e\u092f' \u0935\u093f\u0915\u092f\u093e\u0964\n\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0935\u093f\u0926\u0928\u093e\u0902\u0915 19.09.1973  \u0938\u0947 24.08.1974\n\u0004\u0915 \u0905\u0935\u0915\u093e\u0936 \u092a\u0930 \u0930\u094d\u0925\u0940\u093e \u0907\u0938 \u0905\u0935\u0924\u093f\u0016 \u092e\u0947\u0902 \u0909\u0938\u0947 \u0935\u0947\u0004\u0928 \u0915\u093e \u092d\u0941\u0917\u0004\u093e\u0928\n\u0928\u0939\u0940 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e\u0964 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u0947\n \u0905\u0928\u0941\u0938\u093e\u0930\n\u0935\u093f\u0926\u0928\u093e\u0902\u091501.01.1976 \u0914\u0930 30.11.1987 \u0915\u0947 \u092c\u0940\u091a \u0915\u0947\n\u0905\u0935\u0924\u093f\u0016 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u093e\u092e\n\u0935\u093f\u0915\u092f\u093e, \u0932\u0947\u0935\u093f\u0915\u0928 \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u0947\u0935\u0932 \u0935\u093f\u0926\u094d\u0935\u0004\u0940\u092f \u0936\u094d\u0930\u0947\u0923\u0940 \u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj\nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds\nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds\nfy;s ekU; gksxk\u00dfA\n\n\u0935\u0947\u0004\u0928 \u0915\u093e \u092d\u0941\u0917\u0004\u093e\u0928 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964 \u091c\u092c \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0928\u0947\n\u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092c\u0915\u093e\u092f\u093e \u0930\u093e\u0936\u093f\u0936 \u0914\u0930 \u092d\u0924\u094d\u0924\u0947 \u0915\u093e \u092d\u0941\u0917\u0004\u093e\u0928\n\u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u092d\u094d\u092f\u093e\u0935\u0947\u0926\u0928 \u0935\u093f\u0915\u092f\u093e, \u0004\u094b \u0909\u0938 \u092a\u0930 \u0935\u093f\u0935\u091a\u093e\u0930 \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e\n\u0917\u092f\u093e\u0964 \n(2)  16.12.1988  \u0935\u093f\u0926\u0928\u093e\u0902\u0935\u093f\u0915\u0004 \u0915\u0947 \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e,  \u0928\u0917\u0930\n\u092e\u0939\u093e\u092a\u093e\u0932\u093f\u0932\u0915\u093e \u0915\u093e\u0928\u092a\u0941\u0930 \u0915\u0947 \u092a\u094d\u0930\u0936\u093e\u0938\u0915 \u0928\u0947 01.07.1975 ,\u0938\u0947\n\u092a\u0942\u0935'\u0935\u094d\u092f\u093e\u092a\u0940 \u092a\u094d\u0930\u092d\u093e\u0935 \u0938\u0947 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u094b \u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\n\u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u092f\u093e,\u091c\u0948\u0938\u093e \u0935\u093f\u0915 \u092a\u0939\u0932\u0947 \u092f\u0930\u094d\u0925\u0940\u093e \u092a\u0942\u0935'\u0004  \u0927\u094d\u092f\u093e\u0004\u0935\u094d\u092f\n\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0928\u0947 \u0935\u0947\u0004\u0928 \u0915\u0947 \u0914\u0930 \u0905\u0928\u094d\u092f \u0905\u0928\u0941\u0937\u0902\u0935\u093f\u0917\u0915 \u0932\u093e\u092d \u0915\u0947\n\u092c\u0915\u093e\u092f\u093e \u0930\u093e\u0936\u093f\u0936 \u0915\u0940 \u092e\u093e\u0901\u0917 \u0915\u0940\u0964 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0932\u094b\u0915 \u0938\u0947\u0935\n\u0928\u094d\u092f\u093e\u092f\u093e\u0924\u093f\u0016\u0915\u0930\u0923 \u0938\u0902\u0916\u094d\u092f\u093e II,  \u091c\u0935\u093e\u0939\u0930 \u092d\u0935\u0928,  \u0932\u0916\u0928\u090a \u0928\u0947,\n13.11.1991  \u0935\u093f\u0926\u0928\u093e\u0902\u0935\u093f\u0915\u0004  \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u0947\n\u0906\u0935\u0947\u0926\u0928 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u0943\u0004  \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0914\u0930 \u0905\u0924\u093f\u0016\u0915\u093e\u0930\u093f\u0930\u092f\u094b\u0902 \u0915\u094b\n\u0935\u093f\u0928\u0926M\u0936 \u0935\u093f\u0926\u092f\u093e \u0935\u093f\u0915 \u0935\u0939 \u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u094b \u0926\u0947\u092f \u0935\u0947\u0004\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\n\u092c\u0915\u093e\u092f\u093e \u0930\u093e\u0936\u093f\u0936 \u0915\u093e \u092d\u0941\u0917\u0004\u093e\u0928 \u0915\u0930\u0947\u0902\u0964\n(3)  \u0935\u094d\u092f\u0936\u093f\u0930\u094d\u0925\u0940\u0004 \u0939\u094b\u0915\u0930,  \u0915\u093e\u0928\u092a\u0941\u0930 \u0935\u093f\u0935\u0915\u093e\u0938 \u092a\u094d\u0930\u093e\u0924\u093f\u0016\u0915\u0930\u0923 \u0928\u0947 \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u0930\u093f\u0930\u091f \u092f\u093e\u0924\u093f\u091a\u0915\u093e \u0926\u093e\u092f\u0930 \u0915\u0940\u0964 \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0004 \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0939 \u0915\u0939\u093e \u0917\u092f\u093e \u0935\u093f\u0915\n\u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0940 \u0938\u0947\u0935\u093e \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0928\u0917\u0930 \u092f\u094b\u091c\u0928\u093e \u0914\u0930\n\u0935\u093f\u0935\u0915\u093e\u0938 \u0905\u0924\u093f\u0016\u0935\u093f\u0928\u092f\u092e 1973,  \u0915\u0940 \u0016\u093e\u0930\u093e 5-A w.e.fA  w.e.f\n22.10.1984 \u0915\u0947 \u0906\u0016\u093e\u0930 \u092a\u0930 \u0915\u0947\u0928\u094d\u0926\u094d\u0930\u0940\u0915\u0943\u0004 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964\n\u0905\u0924\u093f\u0016\u0935\u093f\u0928\u092f\u092e 1973  \u0915\u0940 \u0016\u093e\u0930\u093e 5-A w.e.fA  \u0915\u0947 \u0905\u0016\u0940\u0928,  \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0915\u0939\u093e \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u094b \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f\n\u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0928\u093e\u0935\u093f\u092e\u0004 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e \u0914\u0930 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936\n\u0930\u093e\u091c\u094d\u092f \u0915\u093e \u092a\u094d\u0930\u093e\u0924\u093f\u0016\u0915\u093e\u0930\u0940 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\n\u0928\u0947 \u092f\u0939 \u0915\u0939\u0004\u0947 \u0939\u0941\u090f \u0935\u093f\u0915 \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u0906\u0935\u0936\u094d\u092f\u0915 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0930\u0941\u092a\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj\nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds\nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds\nfy;s ekU; gksxk\u00dfA\n\n\u092e\u0947\u0902 \u0935\u093f\u0928\u0935\u093f\u0939\u0004 \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u0004\u093e \u0939\u0948, \u0905\u0924\u093f\u0016\u0915\u0930\u0923  \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u094b\n\u0905\u092a\u093e\u0938\u094d\u0004 \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u0004\u093e \u0939\u0948 \u0914\u0930 \u0915\u093e\u0928\u092a\u0941\u0930 \u0935\u093f\u0935\u0915\u093e\u0938 \u092a\u094d\u0930\u093e\u0924\u093f\u0016\u0915\u0930\u0923\n\u0915\u094b \u092e\u0902\u091c\u0942\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u091c\u093e\u0004\u0940 \u0939\u0948\u0964 \u0935\u094d\u092f\u0936\u093f\u0930\u094d\u0925\u0940\u0004 \u0939\u094b\u0915\u0930, \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940!\n\u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u092e\u0928\u0947 \u0939\u0948\u0964\n(4)  \u0939\u092e\u0928\u0947\u0902 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u0947 \u0935\u093f\u0935\u0926\u094d\u0935\u0004 \u0905\u0924\u093f\u0016\u0935\u0915\u094d\u0924\u093e \u0936\u094d\u0930\u0940 \u0936\u093f\u0936\u094d\u0930\u0937 \u0915\u0941\u092e\u093e\u0930\n\u0935\u093f\u092e\u0936\u094d\u0930\u093e, \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940! \u0915\u0947 \u0935\u093f\u0935\u0926\u094d\u0935\u0004 \u0905\u0924\u093f\u0016\u0935\u0915\u094d\u0924\u093e \u0938\u0941\u0936\u094d\u0930\u0940 \u0930\u0940\u0928\u093e \u0938\u093f\u0902\u0938\u0939,\n\u0915\u094b \u0938\u0941\u0928\u093e \u0914\u0930 \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0004 \u0906\u0926\u0947\u0936 \u0915\u093e \u092a\u0930\u0940\u0936\u0940\u0932\u0928 \u0935\u093f\u0915\u092f\u093e\u0964\n(5)   \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0932\u0917\u093e\u092f\u0947 \u0917\u090f \u0906\u0926\u0947\u0936 \u0915\u094b \u092e\u0941\u0916\u094d\u092f \u0930\u0942\u092a\n\u0938\u0947 \u0907\u0938 \u0906\u0016\u093e\u0930 \u092a\u0930 \u0905\u0924\u093f\u0016\u0915\u0930\u0923  \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u094b \u0930\u0926\u094d\u0926 \u0915\u0930 \u0935\u093f\u0926\u092f\u093e\n\u0935\u093f\u0915 \u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u094b\n\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u0915\u0943\u0004 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e \u0914\u0930 \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u0915\u094b \u0935\u093f\u0928\u092f\u0941\u0935\u093f\u0915\u094d\u0924\n\u092a\u094d\u0930\u093e\u0924\u093f\u0016\u0915\u093e\u0930\u0940 \u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e,  \u0938\u093f\u091c\u0938\u0947 \u092a\u093e\u091f! \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\n\u0905\u0936\u093f\u092d\u092f\u094b\u0938\u093f\u091c\u0004 \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964\n(6)  \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0915\u0947 \u0935\u093f\u0935\u0926\u094d\u0935\u0004 \u0905\u0924\u093f\u0016\u0935\u0915\u094d\u0924\u093e \u0936\u094d\u0930\u0940 \u0936\u093f\u0936\u094d\u0930\u0937 \u0915\u0941\u092e\u093e\u0930 \u0935\u093f\u092e\u0936\u094d\u0930,\n\u0928\u0947 \u0004\u0915'  \u092a\u094d\u0930\u0938\u094d\u0004\u0941\u0004 \u0935\u093f\u0915\u092f\u093e \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940! \u0905\u092a\u0928\u0940 \u0938\u0947\u0935\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e\n\u0938\u0947 \u0915\u0947\u0935\u0932 \u090f\u0915 \u0906\u0936\u0941\u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0915\u0004'\u0935\u094d\u092f\u094b\u0902 \u0915\u093e\n\u0935\u093f\u0928\u0935'\u0939\u0928 \u0915\u0930 \u0930\u0939\u093e \u0930\u094d\u0925\u0940\u093e \u0932\u0947\u0935\u093f\u0915\u0928 \u0909\u0938\u0947 \u0932\u093f\u0932\u0935\u093f\u092a\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\n\u0935\u0947\u0004\u0928\u092e\u093e\u0928 \u0915\u093e \u092d\u0941\u0917\u0004\u093e\u0928 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n(7)  \u091a\u0942\u0902\u0935\u093f\u0915 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0905\u0924\u093f\u0016\u0915\u0930\u0923 \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u094b \u0907\u0938\n\u0906\u0016\u093e\u0930 \u092a\u0930 \u0905\u092a\u093e\u0938\u094d\u0004 \u0935\u093f\u0915\u092f\u093e \u0935\u093f\u0915 \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u0915\u094b \u0915\u093e\u092f'\u0935\u093e\u0939\u0940\n\u092e\u0947\u0902 \u090f\u0915 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u0936\u093f\u092d\u092f\u094b\u0938\u093f\u091c\u0004 \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948,\n\u0907\u0938\u0932\u093f\u0932\u090f \u0932\u0917\u093e\u090f \u0917\u090f \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0004 \u0906\u0926\u0947\u0936 \u0915\u094b \u0905\u092a\u093e\u0938\u094d\u0004 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e\n\u0914\u0930 \u0905\u092a\u0940\u0932 \u0915\u094b \u0905\u0928\u0941\u092e\u0924\u093f\u0004 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u091c\u093e\u0004\u0940 \u0939\u0948\u0964 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936\n\u0930\u093e\u091c\u094d\u092f \u0915\u094b \u092f\u0939 \u0906\u0926\u0947\u0936 \u0935\u093f\u0926\u092f\u093e \u091c\u093e\u0004\u093e \u0939\u0948 \u0935\u093f\u0915 \u0935\u0939 \u0938\u0940.  \u090f\u092e.\n\u0921\u092c\u094d\u0932\u0942. \u092a\u0940. \u0938\u0902\u0916\u094d\u092f\u093e 6637 \u0938\u0928\u094d 1992 \u092e\u0947\u0902 \u0004\u0940\u0938\u0930\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940! \u0915\u0947\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj\nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds\nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds\nfy;s ekU; gksxk\u00dfA\n\n\u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u0936\u093f\u092d\u092f\u094b\u0938\u093f\u091c\u0004 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092e\u093e\u092e\u0932\u0947\u0902 \u0915\u094b \u0928\u090f \u0938\u093f\u0938\u0930\u0947 \u0938\u0947 \u0935\u093f\u0935\u091a\u093e\u0930\n\u0915\u0947 \u0932\u093f\u0932\u090f \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0935\u093e\u092a\u0938 \u092d\u0947\u0902\u091c \u0926\u0947\u0902\u0964 \u0938\u0940.\u090f\u092e.\u0921\u092c\u094d\u0932\u0942.\u092a\u0940.\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0004 \u0928\u093e\u0917\u0947\u0936\u094d\u0935\u0930 \u0930\u093e\u0935\u0938\u0902\u0916\u094d\u092f\u093e 6637  \u0938\u0928\u094d 1992 \u0905\u092a\u0928\u0940\n\u092e\u0942\u0932 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0947 \u0932\u093f\u0932\u090f \u092c\u0939\u093e\u0932 \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u092f\u0947\u0917\u093e\u0964 \u0939\u092e \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0938\u0947 \u0905\u092a\u0940\u0932 \u0915\u0930\u0004\u0947 \u0939\u0948 \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u0915\u0004\u093e' \u0915\u094b \u0905\u0924\u093f\u0004\u0930\u093f\u0930\u0915\u094d\u0924\n\u092a\u094d\u0930\u0924\u093f\u0004\u0936\u092a\u0930\u094d\u0925\u0940 \u092a\u0924\u094d\u0930 \u0926\u093e\u0932\u093f\u0916\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u092f\u093e'\u092a\u094d\u0924 \u0938\u092e\u092f \u0935\u093f\u0926\u092f\u093e\n\u091c\u093e\u090f \u0914\u0930 \u0926\u094b\u0928\u094b\u0902 \u092a\u0915\u094d\u0937\u094b\u0902 \u0915\u094b \u0938\u0941\u0928\u0935\u093e\u0908 \u0915\u0947 \u092a\u092f\u093e'\u092a\u094d\u0924 \u0905\u0935\u0938\u0930 \u0915\u0940\n\u0930\u093f\u0930\u0915\u093e\u0930\u094d\u0921\u093f\u0902\u0921\u0917 \u0915\u0947 \u092c\u093e\u0926 \u0907\u0938 \u0906\u0926\u0947\u0936 \u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0004 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0004\u093e\u0930\u093f\u0930\u0916\n\u0938\u0947 6 \u092e\u0935\u093f\u0939\u0928\u0947 \u0905\u0935\u0924\u093f\u0016 \u0915\u0947 \u092d\u0940\u0004\u0930 \u092a\u094d\u0930\u093e\u0930\u092e\u094d\u092d\u093f^\u092d\u0915 \u0924\u093f\u0004\u0936\u093f\u0930\u094d\u0925\u0940 \u092a\u0930 \u092e\u093e\u092e\u0932\u0947\u0902\n\u0915\u093e \u0935\u093f\u0928\u092a\u091f\u093e\u0930\u093e \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u090f\u0964 \u0915\u094b\u0908 \u092d\u0940 \u0932\u093e\u0917\u0004 \u0928\u0939\u0940\u0964\n..........\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0004  \u0906\u0930. \u092d\u093e\u0928\u094