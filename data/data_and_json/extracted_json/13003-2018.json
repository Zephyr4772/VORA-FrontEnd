    "full_text": "   \u0905\u092a\u092a\u0930\u0924\u0924\u093f\u0935\u0935\u0947\u0926\u094d\u092f \n\u092d\u092d\u093e\u0930\u0924\u093f\u0924\u0940\u092f \u0909\u091a\u094d\u091a\u0924\u093f\u092e \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \n\u0906\u092a\u0930\u092d\u093e\u0924\u0927\u093f\u0915 \u0905\u092a\u0924\u0940\u0932\u0924\u0940\u092f \u0905\u0924\u0927\u093f\u0915\u092d\u093e\u0924\u0930\u0924\u093f\u092d\u093e \n\u0906\u092a\u0930\u092d\u093e\u0924\u0927\u093f\u0915 \u0905\u092a\u0924\u0940\u0932 \u0938\u0938\u0902\u0916\u094d\u092f\u092d\u093e 1424 /2018\n(\u0924\u0935\u0936\u0935\u0947\u0937 \u0905\u0928\u0928\u092e\u0924\u0924\u093f \u092f\u092d\u093e\u0924\u091a\u0915\u092d\u093e (\u0906\u092a\u0930\u092d\u093e\u0924\u0927\u093f\u0915) \u0938\u0938\u0902\u0916\u094d\u092f\u092d\u093e 3331/ 2018 )\n\u0936\u092a\u0930\u0924\u0940 \u0930\u092d\u093e\u092e \u092e\u092e\u0924\u0924\u093f\u0930\u094d\u0924\u093f \u0924\u0938\u0938\u0902\u0939 \n \u0905\u092a\u0924\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940 \u0917\u0923 \n\u0924\u0935\u0930\u0941\u0926\u094d\u0927 \n\u092c\u092c\u091c\u0935\u0947\u0936 \u0924\u0938\u0938\u0902\u0939 \u090f\u0935\u0938\u0902 \u0905\u0928\u094d\u092f \n\u092a\u092a\u0930\u0924\u0924\u093f\u0935\u092d\u093e\u0926\u0924\u0940\u0917\u0923 \n\u0924\u0928\u0923\u0930\u094d\u0924\u093f\u092f \n \u0928\u094d\u092f\u092d\u093e\u092f\u092e\u092e\u0924\u0924\u093f\u0930\u094d\u0924\u093f \u0915\u0928\u0924\u0930\u092f\u0928 \u091c\u091c\u094b\u0938\u0935\u0947\u092b \n1.\u0905\u0928\u0928\u092e\u0924\u0924\u093f \u0926\u0924\u0940 \u0917\u0908 | \n2. \u0905\u092a\u0924\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940 \u0928\u0935\u0947 \u0907\u0932\u092d\u093e\u0939\u092d\u093e\u092c\u092d\u093e\u0926 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0926\u092d\u093e\u0930\u092d\u093e  \u0906\u092a\u0930\u092d\u093e\u0924\u0927\u093f\u0915 \u092a\u092a\u0930\u0915\u0924\u0940\u0923\u0930\u094d\u0924\u093f \u0924\u0926\u0924\u093f\u0924\u0940\u092f \u091c\u092e\u092d\u093e\u0928\u0924\u093f \u0906\u0935\u0935\u0947\u0926\u0928 \u092a\u0924\u093f\u092a\u0930 \u0938\u0938\u0902\u0916\u094d\u092f\u092d\u093e\n44781/2015 \u092e\u092e\u0947\u0902 \u092a\u092d\u093e\u0924\u0930\u0924\u093f \u0906\u0926\u0935\u0947\u0936 \u0924\u0926\u0928\u092d\u093e\u0938\u0902\u0915 30.03.2018 \u0938\u0935\u0947 \u0935\u094d\u092f\u0924\u0930\u0924\u093f \u0939\u091c\u094b\u0915\u0930 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0915\u092d\u093e \u0926\u0930\u0935\u092d\u093e\u091c\u092d\u093e \u0916\u091f\u0916\u091f\u092d\u093e\u092f\u092d\u093e\n\u0939\u0939\u0948 \u0924\u091c\u0938\u092e\u092e\u0947\u0902 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0928\u0935\u0947 \u092a\u092a\u0930\u0930\u092e \u092a\u092a\u0930\u0924\u0924\u093f\u0935\u092d\u093e\u0926\u0924\u0940 \u091c\u091c\u094b\u0924\u0915 \u0927\u093f\u092d\u093e\u0930\u092d\u093e 147 , 148 , 149 , 302 , 34 \u0914\u0930 120 \u092c\u0924\u0940\n\u0906\u0908 \u092a\u0924\u0940 \u0938\u0924\u0940 \u0924\u093f\u0930\u092d\u093e \u0906\u092a\u0930\u092d\u093e\u0924\u0927\u093f\u0915 \u0924\u0935\u0924\u0927\u093f \u0938\u0938\u0902\u0936\u091c\u094b\u0927\u093f\u0928 \u0905\u0924\u0927\u093f\u0924\u0928\u092f\u092e \u0915\u0924\u0940 \u0927\u093f\u092d\u093e\u0930\u092d\u093e 7 \u0915\u0935\u0947 \u0924\u093f\u0939\u0924\u093f \u092a\u0938\u0902\u091c\u0924\u0940\u0915\u092c\u0924\u093f \u092e\u092d\u093e\u092e\u0932\u092d\u093e \u0905\u092a\u0930\u092d\u093e\u0927\u093f \u0938\u0938\u0902\u0916\u094d\u092f\u092d\u093e\n284 /2013, \u092a\u0928\u0924\u0932\u0938 \u0938\u094d\u091f\u0935\u0947\u0936\u0928 \u092e\u0935\u0947\u091c\u092d\u093e, \u0907\u0932\u092d\u093e\u0939\u092d\u093e\u092c\u092d\u093e\u0926 \u092e\u092e\u0947\u0902 \u0905\u0924\u092d\u092f\u0928\u0915\u094d\u0924\u093f \u0938\u0938\u0902\u0916\u094d\u092f\u092d\u093e -02 \u0939\u0939\u0948, \u0915\u0924\u0940 \u091c\u092e\u092d\u093e\u0928\u0924\u093f \u092f\u092d\u093e\u0924\u091a\u0915\u092d\u093e \u092e\u0938\u0902\u091c\u092e\u0930 \u0915\u0930\n\u0932\u0924\u0940 \u0939\u0939\u0948  |\n\n03. \u0906\u0932\u091c\u094b\u091a\u094d\u092f \u0924\u0928\u0923\u0930\u094d\u0924\u093f\u092f \u0915\u0935\u0947 \u0905\u0935\u0932\u091c\u094b\u0915\u0928 \u0915\u0935\u0947 \u0909\u092a\u0930\u092d\u093e\u0928\u094d\u0924\u093f \u0939\u092e \u092f\u0939 \u0926\u0935\u0947\u0916\u0915\u0930 \u0935\u094d\u092f\u0924\u0930\u0924\u093f \u0939\u0939\u0948\u0902 \u0924\u0915 \u0924\u0935\u0926\u092d\u093e\u0928 \u0928\u094d\u092f\u092d\u093e\u092f\u0927\u093f\u0924\u0940\u0936 \u0928\u0935\u0947 \u0928\u094d\u092f\u092d\u093e\u0924\u092f\u0915\n\u0924\u0935\u0935\u0935\u0947\u0915 \u0915\u092d\u093e \u092f\u0930\u091c\u094b\u0924\u091a\u0924\u093f \u0909\u092a\u092f\u091c\u094b\u0917 \u0928\u0939\u0924\u0940\u0938\u0902 \u0924\u0915\u092f\u092d\u093e \u0939\u0939\u0948 | \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0928\u0935\u0947 \u0905\u092a\u0928\u0935\u0947 \u0906\u0932\u091c\u094b\u091a\u094d\u092f \u0924\u0928\u0923\u0930\u094d\u0924\u093f\u092f \u092e\u092e\u0947\u0902 \u0924\u0928\u092e\u094d\u0928 \u092a\u092a\u0930\u0915\u092d\u093e\u0930\n\u0905\u0935\u0927\u093f\u092d\u093e\u0924\u0930\u0924\u093f \u0924\u0915\u092f\u092d\u093e \u0939\u0939\u0948-\n\" \u092e\u092d\u093e\u092e\u0932\u0935\u0947 \u0915\u0935\u0947 \u0917\u0928\u0923\u092d\u093e\u0935\u0917\u0928\u0923 \u092a\u0930 \u0915\u091c\u094b\u0908 \u092d\u0924\u0940 \u0924\u0935\u091a\u092d\u093e\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0924\u0915\u092f\u0935\u0947 \u0924\u092c\u0928\u092d\u093e, \u0926\u091c\u094b\u0937\u0924\u0938\u0924\u0926\u094d\u0927 \u0915\u0924\u0940 \u0924\u0938\u094d\u0930\u0924\u0924\u093f \u092e\u092e\u0947\u0902 \u0926\u0938\u0902\u0921 \u0915\u0924\u0940 \u0917\u0938\u0902\u092d\u0924\u0940\u0930\u0924\u093f\u092d\u093e\n\u0914\u0930 \u0906\u0930\u091c\u094b\u092a\u091c\u094b\u0938\u0902 \u0915\u0924\u0940 \u092a\u092a\u0930\u0915\u092c\u0924\u0924\u093f \u0914\u0930 \u0938\u092e\u0930\u0930\u094d\u0924\u093f\u0915 \u0938\u092d\u093e\u0915\u094d\u0937\u094d\u092f \u0915\u0924\u0940 \u092a\u092a\u0930\u0915\u092c\u0924\u0924\u093f, \u0917\u0935\u092d\u093e\u0939\u091c\u094b\u0938\u0902 \u0915\u0935\u0947 \u0938\u092d\u093e\u0930 \u091b\u0935\u0947\u095c \u091b\u092d\u093e\u095c \u0915\u0935\u0947 \u0924\u093f\u092d\u093e\u0924\u0915\u0930\u094d\u0924\u093f\u0915 \u0938\u0938\u0902\u0926\u0935\u0947\u0939 \u0914\u0930\n\u0906\u0930\u091c\u094b\u092a\u091c\u094b\u0938\u0902 \u0915\u0935\u0947 \u0938\u092e\u0930\u0930\u094d\u0924\u093f\u0928 \u092e\u092e\u0947\u0902 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0915\u0935\u0947 \u092a\u092a\u0930\u0930\u092e \u0926\u092c\u0937\u094d\u091f\u092f\u092d\u093e \u0938\u0938\u0902\u0924\u093f\u0928\u0924\u0937\u094d\u091f \u092a\u0930 \u0924\u0935\u091a\u092d\u093e\u0930 \u0915\u0930\u0924\u093f\u0935\u0947 \u0939\u0928\u090f, \u0907\u0938 \u092e\u092d\u093e\u092e\u0932\u0935\u0947 \u092e\u092e\u0947\u0902 \u0905\u092a\u0924\u0940\u0932\u092d\u093e\u0930\u0930\u094d\u0925\u0940\n\u091c\u0935\u0947\u0932 \u0938\u0935\u0947 \u0924\u0930\u0939\u092d\u093e \u0939\u091c\u094b\u0928\u0935\u0947 \u092f\u091c\u094b\u0917\u094d\u092f \u0939\u0939\u0948 | \"\n4. \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0935\u0947, \u0924\u0935\u0926\u092d\u093e\u0928 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0927\u093f\u0924\u0940\u0936 \u0926\u092d\u093e\u0930\u092d\u093e \u092a\u092a\u0930\u0938\u094d\u0924\u093f\u0928\u0924\u093f \u0924\u0935\u091a\u092d\u093e\u0930 \u091c\u092e\u092d\u093e\u0928\u0924\u093f \u0915\u091c\u094b \u0905\u0938\u094d\u0935\u0924\u0940\u0915\u092d\u093e\u0930 \u0915\u0930\u0928\u0935\u0947 \u0939\u0935\u0947\u0924\u093f\u0928 \u092a\u092f\u092d\u093e\u0930\u094d\u0924\u093f\u092a\u094d\u0924\u093f \u0939\u0939\u0948\u0902 \u092a\u0930\u0928\u094d\u0924\u093f\u0928\n\u0907\u0938\u0915\u0935\u0947 \u092c\u092d\u093e\u0935\u091c\u092e\u0926 \u0924\u0935\u0926\u092d\u093e\u0928 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0927\u093f\u0924\u0940\u0936 \u0928\u0935\u0947 \u091c\u092e\u092d\u093e\u0928\u0924\u093f \u092e\u0938\u0902\u091c\u092e\u0930 \u0915\u0924\u0940 \u0939\u0939\u0948 |\n5 .  \u0907\u0938 \u0924\u0938\u094d\u0930\u0924\u0924\u093f \u092e\u092e\u0947\u0902,  \u092a\u092a\u0930\u0930\u092e \u092a\u092a\u0930\u0924\u0924\u093f\u0935\u092d\u093e\u0926\u0924\u0940 \u0915\u0935\u0947 \u0924\u0932\u090f \u0909\u092a\u0924\u0938\u094d\u0930\u0924\u093f \u0924\u0935\u0926\u092d\u093e\u0928 \u0935\u0924\u0930\u0937\u094d\u0920 \u0905\u0924\u0927\u093f\u0935\u0915\u094d\u0924\u093f\u092d\u093e \u0928\u0935\u0947 \u0915\u0939\u092d\u093e \u0924\u0915 \u0935\u0939\n08.08.2013 \u0938\u0935\u0947 \u0905\u0924\u092d\u0930\u0915\u092d\u093e \u092e\u092e\u0947\u0902 \u0939\u0939\u0948 \u0932\u0935\u0947\u0924\u0915\u0928 \u0939\u092e\u092e\u0947\u0902 \u0905\u0924\u092d\u092f\u091c\u094b\u091c\u0928 \u0926\u092d\u093e\u0930\u092d\u093e \u0938\u092e\u0924\u091a\u0924\u093f \u0924\u0915\u092f\u092d\u093e \u0917\u092f\u092d\u093e \u0924\u0915 \u0905\u092d\u0924\u0940 \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u092a\u092e\u0923\u0930\u094d\u0924\u093f \u0928\u0939\u0924\u0940\u0938\u0902\n\u0939\u0928\u0906 \u0939\u0939\u0948 | \u0930\u092d\u093e\u091c\u094d\u092f \u0939\u0935\u0947\u0924\u093f\u0928  \u0924\u0935\u0926\u092d\u093e\u0928 \u0935\u0924\u0930\u0937\u094d\u0920 \u0905\u0924\u0927\u093f\u0935\u0915\u094d\u0924\u093f\u092d\u093e \u0936\u092a\u0930\u0924\u0940 \u092a\u092a\u0930\u092e\u091c\u094b\u0926 \u0938\u094d\u0935\u0930\u0941\u092a \u0915\u092d\u093e \u0915\u0939\u0928\u092d\u093e \u0939\u0939\u0948 \u0924\u0915 13 \u092e\u092e\u0947\u0902 \u0938\u0935\u0947 \u0915\u0935\u0947\u0935\u0932 03 \u0917\u0935\u092d\u093e\u0939\u091c\u094b\u0938\u0902\n\u0915\u092d\u093e \u092a\u0930\u0924\u0940\u0915\u0923 \u0939\u0928\u0906 \u0939\u0939\u0948 | \u0907\u0938\u0924\u0940\u0924\u0932\u090f, \u0939\u092e 30. 03. 2018 \u0915\u0935\u0947 \u0906\u0926\u0935\u0947\u0936 \u0915\u091c\u094b \u0905\u092a\u092d\u093e\u0938\u094d\u0924\u093f \u0915\u0930\u0924\u093f\u0935\u0947 \u0939\u0928\u090f \u091c\u092e\u092d\u093e\u0928\u0924\u093f \u0906\u0935\u0935\u0947\u0926\u0928 \u0915\u091c\u094b \u0930\u0926\n\u0915\u0930\u0924\u093f\u0935\u0947 \u0939\u0939\u0948\u0902 | \u092f\u0926\u094d\u092f\u0924\u092a, \u0939\u092e \u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0930\u0928\u092d\u093e \u091a\u092d\u093e\u0939\u0924\u093f\u0935\u0947 \u0939\u0939\u0948\u0902 \u0924\u0915 \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u092a\u092e\u0923\u0930\u094d\u0924\u093f \u0939\u091c\u094b\u0928\u0935\u0947 \u0915\u0935\u0947 \u092c\u092d\u093e\u0926, \u092a\u092a\u0930\u0930\u092e \u092a\u092a\u0930\u0924\u0924\u093f\u0935\u092d\u093e\u0926\u0924\u0940 \u0915\u0935\u0947 \u0924\u0932\u090f\n\u0924\u092b\u0930 \u0938\u0935\u0947 \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0915\u0935\u0947 \u0938\u092e\u0915 \u091c\u092e\u092d\u093e\u0928\u0924\u093f \u0906\u0935\u0935\u0947\u0926\u0928 \u0926\u0935\u0947\u0928\u0935\u0947 \u0915\u092d\u093e \u0924\u0935\u0915\u0932\u094d\u092a \u0916\u0928\u0932\u092d\u093e \u0930\u0939\u0935\u0947\u0917\u092d\u093e | \u092f\u0924\u0926 \u091c\u092e\u092d\u093e\u0928\u0924\u093f \u0906\u0935\u0935\u0947\u0926\u0928\n\u0924\u0926\u092f\u092d\u093e \u091c\u092d\u093e\u0924\u093f\u092d\u093e \u0939\u0939\u0948 \u0924\u093f\u091c\u094b \u0909\u0938\u092a\u0930 \u0909\u0938\u0915\u0935\u0947 \u0905\u092a\u0928\u0935\u0947 \u0917\u0928\u0923\u092d\u093e\u0935\u0917\u0928\u0923 \u0915\u0935\u0947 \u0906\u0927\u093f\u092d\u093e\u0930 \u092a\u0930 \u0924\u0935\u091a\u092d\u093e\u0930 \u0924\u0915\u092f\u092d\u093e \u091c\u092d\u093e\u090f\u0917\u092d\u093e | \n6. \u0909\u092a\u0930\u091c\u094b\u0915\u094d\u0924\u093f \u0915\u0935\u0947 \u092a\u092a\u0930\u0915\u092d\u093e\u0936 \u092e\u092e\u0947\u0902, \u0905\u092a\u0924\u0940\u0932 \u0924\u0928\u0938\u094d\u0924\u093f\u092d\u093e\u0924\u0930\u0924\u093f \u0915\u0924\u0940 \u091c\u092d\u093e\u0924\u093f\u0924\u0940 \u0939\u0939\u0948 | \u0939\u092e \u0924\u0935\u091a\u092d\u093e\u0930\u0923 \u0928\u094d\u092f\u092d\u093e\u092f\u092d\u093e\u0932\u092f \u0915\u091c\u094b \u0924\u091c\u0924\u093f\u0928\u0924\u0940 \u091c\u0932\u094d\u0926\u0924\u0940 \u0939\u091c\u094b\n\u0938\u0915\u0935\u0947 \u0914\u0930 \u0905\u0924\u0927\u093f\u092e\u092d\u093e\u0928\u0924\u093f\u0924\u0903 \u091a\u092d\u093e\u0930 \u092e\u092d\u093e\u0939 \u0915\u0935\u0947 \u092d\u0924\u0940\u0924\u093f\u0930 \u0939\u0924\u0940 \u0907\u0938 \u092e\u092d\u093e\u092e\u0932\u0935\u0947 \u0915\u092d\u093e \u0924\u0928\u0938\u094d\u0924\u093f\u092d\u093e\u0930\u0923 \u0915\u0930\u0928\u0935\u0947 \u0915\u0935\u0947 \u0924\u0928\u0926\u0930\u094d\u0926\u0947\u0936 \u0926\u0935\u0947\u0924\u093f\u0935\u0947 \u0939\u0939\u0948\u0902 |\n7. \u0932\u0938\u0902\u0924\u092c\u0924\u093f \u0905\u0938\u0902\u0924\u093f\u0930\u0935\u092d\u093e\u0926\u0924\u0940\u092f \u0906\u0935\u0935\u0947\u0926\u0928 \u092a\u0924\u093f\u092a\u0930, \u092f\u0924\u0926 \u0915\u091c\u094b\u0908 \u0939\u091c\u094b\u0938\u0902 \u0924\u093f\u091c\u094b,  \u092d\u0924\u0940 \u0924\u093f\u0926\u0928\u0928\u0938\u092d\u093e\u0930 \u0924\u0928\u0938\u094d\u0924\u093f\u092d\u093e\u0924\u0930\u0924\u093f \u0924\u0915\u092f\u0935\u0947 \u091c\u092d\u093e\u0924\u093f\u0935\u0947 \u0939\u0939\u0948\u0902 |\n\n\u0928\u0908 \u0924\u0926\u0932\u094d\u0932\u0924\u0940 , 20 \u0928\u0935\u0938\u0902\u092c\u0930, 2018. \n\u0915\u0928\u0924\u0930\u092f\u0928 \u091c\u091c\u094b\u0938\u0935\u0947\u092b , \u0928\u094d\u092f\u092d\u093e\u092f\u092e\u092e\u0924\u0924\u093f\u0930\u094d\u0924\u093f \n\u0926\u0924\u0940\u092a\u0915 \u0917\u0928\u092a\u094d\u0924\u093f\u092d\u093e, \u0928\u094d\u092f\u092d\u093e\u092f\u092e\u092e\u0924\u0924\u093f\u0930\u094d\u0924\u093f \n\u0939\u0935\u0947\u092e\u0938\u0902\u0924\u093f \u0917\u0928\u092a\u094d\u0924\u093f\u092d\u093e, \u0928\u094d\u092f\u092d\u093e\u092f\u092e\u092e\u0924\u0924\u093f\u0930\u094d\u0924\u093f   \n\u0916\u0938\u0902\u0921\u0928 (\u0924\u0921\u0938\u094d\u0915\u094d\u0932\u0935\u0947\u092e\u0930):- \u0938\u094d\u0930\u092d\u093e\u0928\u0924\u0940\u092f \u092d\u092d\u093e\u0937\u092d\u093e \u092e\u092e\u0947\u0902 \u0924\u0928\u0923\u0930\u094d\u0924\u093f\u092f \u0905\u0928\u0928\u0935\u092d\u093e\u0926 \u0915\u092d\u093e \u0906\u0936\u092f, \u092a\u0915\u0915\u092d\u093e\u0930\u091c\u094b\u0938\u0902 \u0915\u091c\u094b \u0907\u0938\u0935\u0947 \u0905\u092a\u0928\u0924\u0940 \u092d\u092d\u093e\u0937\u092d\u093e \u092e\u092e\u0947\u0902 \u0938\u092e\u091d\u0928\u0935\u0947 \u0915\u0935\u0947 \u0909\u092a\u092f\u091c\u094b\u0917 \u0924\u093f\u0915\n\u0939\u0924\u0940 \u0938\u0924\u0940\u0924\u092e\u0924\u093f \u0939\u0939\u0948 \u0914\u0930 \u0905\u0928\u094d\u092f \u092a\u092a\u0930\u092f\u091c\u094b\u091c\u0928\u092d\u093e\u0930\u0930\u094d\u0924\u093f \u0907\u0938\u0915\u092d\u093e \u0909\u092a\u092f\u091c\u094b\u0917 \u0928\u0939\u0924\u0940\u0938\u0902 \u0924\u0915\u092f\u092d\u093e \u091c\u092d\u093e \u0938\u0915\u0924\u093f\u092d\u093e\u0964 \u0938\u092e\u0938\u094d\u0924\u093f \u0935\u094d\u092f\u0935\u0939\u092d\u093e\u0924\u0930\u0915 \u090f\u0935\u0938\u0902 \u0915\u092d\u093e\u092f\u092d\u093e\u0930\u094d\u0924\u093f\u0932\u092f\u0924\u0940\u0928 \u092a\u092a\u0930\u092f\u091c\u094b\u091c\u0928\u092d\u093e\u0930\u0930\u094d\u0924\u093f,\n\u0924\u0928\u0923\u0930\u094d\u0924\u093f\u092f \u0915\u092d\u093e \u0905\u0938\u0902\u0917\u092a\u0930\u0935\u0947\u091c\u0924\u0940 \u0938\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0939\u0924\u0940 \u092a\u092a\u0930\u092d\u093e\u092e\u092d\u093e\u0924\u0923\u0915 \u0939\u091c\u094b\u0917\u092d\u093e \u090f\u0935\u0938\u0902 \u0924\u0928\u0937\u094d\u092a\u092d\u093e\u0926\u0928 \u0924\u093f\u0930\u092d\u093e \u0915\u092d\u093e\u092f\u092d\u093e\u0930\u094d\u0924\u093f\u0928\u094d\u0935\u092f\u0928 \u0915\u0935\u0947 \u092a\u092a\u0930\u092f\u091c\u094b\u091c\u0928\u092d\u093e\u0930\u0930\u094d\u0924\u093f \u0915\u0935\u0947\u0924\u093f\u092a\u0930 \u0927\u093f\u092d\u093e\u0924\u0930\u0924\u093f \u0915\u0930\u0935\u0947\u0917\u092d\u093e |\n"
}