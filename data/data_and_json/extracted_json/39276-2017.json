\u0926\u094d\u0927\u0905\u092a\u0940\u0932\u093e\u0925/ \u0928\u0947\u0935\u093f\u0935\u0936\u0947\u0937\u092f\u093e\u0924\u093f\u091a\u0915\u093e\u0926\u093e\u092f\u0930\n\u0915\u0940\u0964\n8.\n\u0935\u093f\u0935\u0936\u0947\u0937\u092f\u093e\u0924\u093f\u091a\u0915\u093e\u0915\u0947\u0932\u0902\u092c\u0928\u0915\u0947\u0926\u094c\u0930\u093e\u0928\u0905\u0902\u0930\u093f\u0930\u092e\u0907\u0938\u0905\u0902\u0930\u093f\u0930\u092e\u0938\u0941\u0930\u0915\u094d\u0937\u093e\u0915\u0947\n\u0936n \u0915\u0940\n\u0930\u0939\u0905\u092a\u0940\u0932\u093e\u0925/ \u0915\u0947\u092a\u0915\u094d\u0937\u092e\u0947\u0902\u090f\u0915\u0905\u0902\u0930\u093f\u0930\u092e\u0906\u0926\u0947\u09363\u094b\u0935\u093f\u091516 \u0905\u092a\u094d\u0930\u0948\u0932\n1996 \u0915\u0947\u092a\u0942\u09359 \u092e\u093e\u0928\u0928\u0940\u092f\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u0915\u0947\u090f\u0915\u0932\u0928\u094d\u092f\u093e\u092f\u093e\u0927\u0940\u0936\u0926\u094d\u0935\u093e\u0930\u093e\u092a\u094d\u0930\u0926\u093e\u0928\u0915\u0940\n\u0917\u0908\u0964\u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\n\u0906\u0926\u0947\u0936\u0935\u093f\u0926\u0928\u093e\u0902\u091530 \u0905\u0915\u094d\u091f\u0942\u092c\u09302017 \u0926\u094d\u0935\u093e\u0930\u093e\u0935\u093f\u0935\u0936\u0947\u0937\u092f\u093e\u0924\u093f\u091a\u0915\u093e\n\u0924\u093f\u0921\u0935\u09403\u0928\u092c\u0947\u0902\u091a\u0926\u094d\u0935\u093e\u0930\u093e\u0935\u093f\u0928\u0930\u0938\u094d\n\u0915\u0930\u0926\u0940\u0917\u0908\u0925\u0940\u0964\u092e\u093e\u0928\u0928\u0940\u092f\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u0928\u0947\u092a\u093e\u092f\u093e\n\u0935\u093f\u0915\u0915\u0935\u093f\u0920\u0928\u093e\u0908\u0935\u093f\u0928\u0935\u093e\u0930\u0923\u0906\u0926\u0947\u0936\u0935\u093f\u0926\u094d\u0935\u0940\u092f1981 \u0915\u0940\u0936n \u092e\u0947\u0902\u0905\u092a\u0940\u0932\u093e\u0925/ \u0915\u0940\n\u0935\u093f\u0928\u092f\u094