............. \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \n \u0a9a\u0a95\u0ab5\u0abe\u0aa6\u0aab\u0acb  \n \u0aa8\u0acd\u0aaf\u0ab5\u0abe\u0aaf\u0aae\u0a95\u0aa4\u0ab0\u0acd\u0aa4\u0ac0\u0ab6\u0aac\u0ac0 \n \n - \n  \u0aaa\u0aae\u0abe\u0a82\u0a95\u0a9c \u0ab5\u0aae\u0aa4\u0acd\u0aa4\u0ab2\n \n ,  \n\u0ae7. \n\u0aa6\u0ab5\u0abe\u0ab5\u0aab\u0acb \u0aae\u0aae\u0abe\u0a82\u0a9c\u0a95\u0ab0. \n\u0ae8.  \n\u0aad\u0ab5\u0abe\u0ab0\u0aa4 \u0ab8\u0ab0\u0a95\u0ab5\u0abe\u0ab0 \u0aa4\u0ab0\u0aab\u0aa5\u0aac\u0ac0 \u0a8f\u0aa1\u0aa1\u0abf\u0ab6\u0aa8\u0ab2 \u0ab8\u0aab\u0acb\u0ab5\u0ab2\u0ab5\u0ab8\u0a9f\u0ab0 \u0a9c\u0aa8\u0ab0\u0ab2 \u0ab8\u0a95\u0ab6\u0aac\u0ac0 \u0a90\u0ab6\u0acd\u0ab5\u0aaf\u0ab5\u0abe\u0ab0\u0acd\u0aa4\u0abe\n\u0aad\u0ab5\u0abe\u0a9f\u0aac\u0ac0 \u0a85\u0aa8\u0ab9\u0ac7 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \u0aa4\u0ab0\u0aab\u0aa5\u0aac\u0ac0 \u0a8f\u0aa1\u0abf\u0ab5\u0aab\u0acb\u0a95\u0ab9\u0ac7\u0a9f-\u0a93\u0aa8-\u0ab0\u0ab9\u0ac7\u0a95\u0aab\u0acb\u0aa1\u0abf\u0ab0\u0acd\u0aa4\u0abe \u0ab6\u0aac\u0ac0 \u0aa1\u0aa6\u0ab5\u0acd\u0aaf\u0ab9\u0ac7\u0ab6 \u0aaa\u0acd\u0ab0\u0aa4\u0ab5\u0abe\u0aaa \u0ab5\u0ab8\u0aae\u0abe\u0a82\u0ab9 \u0aa8\u0ab9\u0ac7\n1\n\n\u0ab8\u0ab5\u0abe\u0aae\u0abe\u0a82\u0aad\u0ab3\u0ab5\u0abe .\n\u0ae9. \n\u0a85\u0aaa\u0aac\u0ac0\u0ab2\u0a95\u0aa4\u0ab5\u0abe\u0ab0\u0acd\u0aa4\u0abe-\u0aaf\u0a95\u0ab5\u0aa8\u0aaf\u0aa8 \u0a93\u0aab \u0a87\u0ab5\u0aa8\u0acd\u0aa1\u0abf\u0aaf\u0ab5\u0abe\u0a8f \u0a86 \u0a85\u0aaa\u0aac\u0ac0\u0ab2 \u0a85\u0ab2\u0acd\u0ab9\u0ab5\u0abe\u0aac\u0ab5\u0abe\u0aa6\n\u0a89\u0a9a\u0acd\u0a9a \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0ab9\u0ac7 \u0aab\u0aab\u0acb\u0a9c\u0aa6\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0aaa\u0ab0\u0a9a\u0a95\u0ab0\u0aa3 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa8\u0aae\u0abe\u0a82\u0aac\u0ab0 \u0ae8\u0ae7\u0ae9\u0ae9\u0ae6/\u0ae8\u0ae6\u0ae8\u0ae8 \u0aa8\u0ab9\u0ac7\n\u0aae\u0aae\u0abe\u0a82\u0a9c\u0a95\u0ab0\u0aac\u0ac0 \u0a86\u0aaa\u0aa4\u0ab5\u0abe \u0a85\u0aa8\u0ab9\u0ac7 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0a85\u0a9c\u0aaf \u0a95\u0a95\u0aae\u0ab5\u0abe\u0ab0 \u0ab5\u0ab8\u0aae\u0abe\u0a82\u0ab9 \u0a89\u0aab\u0ab0 \u0aaa\u0aaa\u0acd\u0aaa\u0a95\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8\n\u0aaa\u0ab0 \u0aae\u0a95\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aab\u0acb \u0ab5\u0aa8\u0aa6\u0ab0\u0ab6 \u0a86\u0aaa\u0aa4\u0ab5\u0abe \u0ae7\u0aed/\u0ae7\u0ae6/\u0ae8\u0ae6\u0ae8\u0ae8 \u0aa8\u0ab5\u0abe \u0ab0\u0aab\u0acb\u0a9c \u0a86\u0aaa\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0a85\u0aae\u0abe\u0a82\u0ab5\u0aa4\u0aae\n\u0a9a\u0a95\u0ab5\u0abe\u0aa6\u0ab5\u0abe \u0a85\u0aa8\u0ab9\u0ac7 \u0a86\u0aa6\u0ab9\u0ac7\u0ab6 \u0ab8\u0ab5\u0abe\u0aae\u0ab9\u0ac7 \u0aa6\u0ab5\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0aac\u0ac0 \u0a9b\u0ab9\u0ac7.\n\u0aea.\n\u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0aaa\u0ab0 \u0aa8\u0ab5\u0abe\u0a95\u0ab0\u0acd\u0ab5\u0acb\u0aa1\u0a9f\u0a95 \u0aa1\u0abf\u0aa1\u0a97\u0acd\u0ab8 \u0a8f\u0aa8\u0acd\u0aa1\u0abf \u0ab8\u0ab5\u0abe\u0a87\u0a95\u0aab\u0acb\u0a9f\u0aa1\u0aab\u0acb\u0ab5\u0aaa\u0a95\n\u0ab8\u0aac\u0ab8\u0acd\u0a9f\u0ab9\u0ac7\u0aa8\u0acd\u0ab8\u0aac\u0ac0\u0ab8 \u0a8f\u0a95\u0acd\u0a9f,  \u0ae7\u0aef\u0aee\u0aeb (\u0a9f\u0a95\u0aae\u0abe\u0a82\u0a95\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u2018\u0a8f\u0aa8.\u0aa1\u0abf\u0aac\u0ac0.\u0aaa\u0aac\u0ac0.\u0a8f\u0ab8.\u0a8f\u0a95\u0acd\u0a9f\u2019)  \u0aa8\u0aac\u0ac0 \u0a95\u0ab2\u0aae\n\u0aee/\u0ae8\u0ae6/\u0ae8\u0aed-\u0a8f/\u0ae8\u0aef/\u0ae9\u0ae8 \u0ab9\u0ab9\u0ac7\u0aa0\u0ab3,  \u0aa1\u0abf\u0aac\u0ac0.\u0a86\u0ab0.\u0a86\u0a88.,\u0aaa\u0aab\u0acb\u0ab2\u0aac\u0ac0\u0ab8 \u0ab8\u0acd\u0a9f\u0ab9\u0ac7\u0ab6\u0aa8,\u0ab5\u0ab5\u0abe\u0ab0\u0ab5\u0abe\u0aa3\u0ab8\u0aac\u0ac0\n\u0a95\u0ab9\u0ac7\u0ab8 \u0aa8\u0aae\u0abe\u0a82\u0aac\u0ab0 \u0ae7/\u0ae8\u0ae6\u0ae8\u0ae7 \u0aae\u0ab5\u0abe\u0aa5\u0aac\u0ac0 \u0a89\u0aa6\u0aad\u0ab5\u0ab9\u0ac7\u0ab2 \u0a95\u0ab9\u0ac7\u0ab8 \u0aa8\u0aae\u0abe\u0a82\u0aac\u0ab0 \u0aec\u0aee\u0aed/\u0ae8\u0ae6\u0ae8\u0ae7 \u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0ab5\u0abe\u0aae\u0ab9\u0ac7\u0ab2\n\u0ab9\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aa8\u0aab\u0acb \u0a86\u0ab0\u0aab\u0acb\u0aaa \u0a9b\u0ab9\u0ac7.\n\u0aeb.\n\u0ab8\u0aa4\u0ab9\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0a95\u0a95\u0aae\u0ab5\u0abe\u0ab0 \u0a85\u0aae\u0abe\u0a82\u0ab5\u0aa4\u0ab2 \u0ab5\u0ab5. \u0ab8\u0ab9\u0ac7\u0aa8\u0acd\u0a9f\u0aa1\u0ab2 \u0aac\u0acd\u0aaf\u0a95\u0ab0\u0aab\u0acb \u0a93\u0aab \u0a87\u0aa8\u0acd\u0ab5\u0ab9\u0ac7\u0ab5\u0ab8\u0acd\u0a9f\u0a97\u0ab9\u0ac7\u0ab6\u0aa8 \u0a85\u0aa8\u0ab9\u0ac7\n\u0aac\u0aac\u0ac0\u0a9c\u0abe \u0a8f\u0ab8.\u0a8f\u0ab2.\u0aaa\u0aac\u0ac0.  (\u0aab\u0aab\u0acb\u0a9c\u0aa6\u0ab5\u0abe\u0ab0\u0aac\u0ac0)  \u0aa8\u0aae\u0abe\u0a82\u0aac\u0ab0 \u0aeb\u0ae7\u0aef\u0ae7/\u0ae8\u0ae6\u0ae8\u0ae7 \u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 (\u0ae8\u0ae6\u0ae8\u0ae8)\n\u0a8f\u0ab8.\u0ab8\u0aac\u0ac0.\u0ab8\u0aac\u0ac0. \u0a93\u0aa8\u0ab2\u0ab5\u0abe\u0a88\u0aa8 \u0a8f\u0ab8.\u0ab8\u0aac\u0ac0. \u0aee\u0ae8\u0aeb, \u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0a95\u0a96\u0acd\u0aaf \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0a93\u0aae \u0aaa\u0acd\u0ab0\u0a95\u0ab5\u0abe\u0ab6 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5\n\u0a85\u0aa8\u0ab9\u0ac7 \u0a85\u0ab5\u0aae\u0aa4 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5\u0aa8\u0ab9\u0ac7 \u0a86\u0a97\u0aab\u0acb\u0aa4\u0ab0\u0ab5\u0abe \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0aae\u0a95\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0ab5\u0abe \u0a95\u0ab5\u0abe\u0ab0\u0aa3\u0aa8\u0ab9\u0ac7  \u0aae\u0a95\u0a96\u0acd\u0aaf\u0aa4\u0acd\u0ab5\u0ab9\u0ac7\n\u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab5\u0abe\u0a96\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0a86 \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0ab9\u0ac7 \u0ae7\u0ae7/\u0ae6\u0aed/\u0ae8\u0ae6\u0ae8\u0ae8 \u0aa8\u0ab5\u0abe \u0ab0\u0aab\u0acb\u0a9c \u0aaa\u0ab8\u0ab5\u0abe\u0ab0 \u0a95\u0ab0\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0ab5\u0aa8\u0aa3\u0ab0\u0acd\u0aa4\u0abe\u0aaf\u0aa8\u0ab9\u0ac7\n2\n\n\u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab5\u0abe\u0a96\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0aad\u0ab5\u0abe\u0ab0\u0aa4\u0aa8\u0ab5\u0abe \u0aac\u0aae\u0abe\u0a82\u0aa7\u0ab5\u0abe\u0ab0\u0aa3\u0aa8\u0aac\u0ac0 \u0a85\u0aa8\u0a95\u0a9a\u0acd\u0a9b\u0ab9\u0ac7\u0aa6-\u0ae8\u0ae7\u0aa8\u0ab5\u0abe \u0ab5\u0acd\u0aaf\u0ab5\u0abe\u0aaa\u0a95 \u0a9c\u0aa8\u0ab5\u0abe\u0aa6\u0ab9\u0ac7\u0ab6\u0aa8\u0ab9\u0ac7\n\u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab5\u0abe\u0a96\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0aae\u0a95\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aab\u0acb \u0ab5\u0aa8\u0aa6\u0ab0\u0ab6\n\u0a86\u0aaa\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0aab\u0acb \u0a9b\u0ab9\u0ac7.\n\u0aec.\n\u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0a95\u0ab8\u0acd\u0a9f\u0aa1\u0abf\u0aac\u0ac0\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab9\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aa5\u0aac\u0ac0 \u0a85\u0aa8\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0aae\u0a95\u0acd\u0aa4\n\u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aab\u0acb \u0a86\u0aa6\u0ab9\u0ac7\u0ab6 \u0a86\u0aaa\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0aab\u0acb \u0ab9\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aa5\u0aac\u0ac0 \u0a86 \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0ab9\u0ac7 \u0aa4\u0ab5\u0abe. \u0ae7\u0ae9/\u0ae6\u0ae8/\u0ae8\u0ae6\u0ae8\u0ae9\n\u0aa8\u0ab5\u0abe  \u0ab0\u0aab\u0acb\u0a9c \u0ab8\u0acd\u0aaa\u0ab9\u0ac7\u0ab6\u0acd\u0aaf\u0ab2 \u0ab2\u0aac\u0ac0\u0ab5 \u0ab5\u0aaa\u0a9f\u0aac\u0ac0\u0ab6\u0aa8 \u0aaa\u0ab0 \u0aa8\u0aab\u0acb\u0aa1\u0a9f\u0ab8 \u0a87\u0ab6\u0acd\u0aaf\u0a95 \u0a95\u0ab0\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0ab5\u0a9a\u0a97\u0ab5\u0abe\u0ab3\u0ab5\u0abe\u0aa8\u0aab\u0acb \u0a86\u0aa6\u0ab9\u0ac7\u0ab6\n\u0aac\u0ab9\u0ab5\u0abe\u0ab0 \u0aaa\u0ab5\u0abe\u0aa1\u0aab\u0acb \u0ab9\u0aa4\u0aab\u0acb.\n\u0aed.\n\u0a85\u0ab9\u0ab9\u0ac0\u0a82 \u0aa8\u0aa8\u0acb\u0a82\u0aa7\u0aa8\u0aac\u0ac0\u0aaf \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7, \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a8f \u0aa4\u0aaa\u0ab5\u0abe\u0ab8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aad\u0ab5\u0abe\u0a97 \u0ab2\u0aac\u0ac0\u0aa7\u0aab\u0acb \u0aa8 \u0ab9\u0aa4\u0aab\u0acb\n\u0a85\u0aa8\u0ab9\u0ac7 \u0a8f\u0a95 \u0ab5\u0ab0\u0ab0\u0acd\u0aa4\u0abe\u0aa5\u0aac\u0ac0 \u0ab5\u0aa7\u0a95 \u0ab8\u0aae\u0aaf\u0aa5\u0aac\u0ac0 \u0aa4\u0ab9\u0ac7\u0aa8\u0aac\u0ac0 \u0aa7\u0ab0\u0aaa\u0a95\u0aa1\u0abf \u0a9f\u0ab5\u0abe\u0ab3\u0aac\u0ac0 \u0ab9\u0aa4\u0aac\u0ac0, \u0a9c\u0ab9\u0ac7 \u0aaa\u0a9b\u0aac\u0ac0 \u0aa4\u0ab9\u0ac7\u0aa8\u0aac\u0ac0 \u0ab0\u0ab5\u0abe\u0aaf\u0aaa\u0a95\u0ab0\u0aa8\u0aac\u0ac0\n\u0a8f\u0a95 \u0ab0\u0ab9\u0ac7\u0ab8\u0acd\u0a9f\u0aab\u0acb\u0ab0\u0aa8\u0acd\u0a9f\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82\u0aa5\u0aac\u0ac0 \u0aa7\u0ab0\u0aaa\u0a95\u0aa1\u0abf \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aac\u0ac0 \u0ab9\u0aa4\u0aac\u0ac0.\n\u0aee.\n\u0a86 \u0a95\u0ab9\u0ac7\u0ab8\u0aa8\u0aac\u0ac0 \u0a9f\u0a95\u0aae\u0abe\u0a82\u0a95\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab9\u0a95\u0aac\u0ac0\u0a95\u0aa4 \u0a8f\u0ab5\u0aac\u0ac0 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7,  \u0aa1\u0aa1\u0abf\u0ab0\u0ab9\u0ac7\u0a95\u0acd\u0a9f\u0aab\u0acb\u0ab0\u0ab9\u0ac7\u0a9f \u0a93\u0aab \u0ab0\u0ab9\u0ac7\u0ab5\u0aa8\u0acd\u0aaf\u0a95\n\u0a87\u0aa8\u0acd\u0a9f\u0ab9\u0ac7\u0ab5\u0ab2\u0a9c\u0aa8\u0acd\u0ab8 (\u0aa1\u0abf\u0aac\u0ac0.\u0a86\u0ab0.\u0a86\u0a88.) \u0ab5\u0ab5\u0abe\u0ab0\u0ab5\u0abe\u0aa3\u0ab8\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0aa4\u0ab5\u0abe.\u0ae7\u0ae7/\u0ae6\u0ae7/\u0ae8\u0ae6\u0ae8\u0ae7 \u0aa8\u0ab5\u0abe \u0ab0\u0aab\u0acb\u0a9c \u0a8f\u0ab5\u0aac\u0ac0\n\u0aae\u0ab5\u0abe\u0aa1\u0ab9\u0aa4\u0aac\u0ac0 \u0aae\u0ab3\u0aac\u0ac0 \u0ab9\u0aa4\u0aac\u0ac0 \u0a95\u0ab9\u0ac7, \u0aa8\u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0aac\u0ac0 \u0aa8\u0aae\u0abe\u0a82\u0aac\u0ab0 \u0a8f\u0aaa\u0aac\u0ac0-\u0ae6\u0aeb-\u0aa1\u0abf\u0aac\u0ab2\u0acd\u0aaf\u0a95-\u0aee\u0aec\u0aef\u0aef \u0aa7\u0ab0\u0ab5\u0abe\u0ab5\u0aa4\u0ab5\u0abe \u0a8f\u0a95\n\u0a9f\u0aa1\u0a95\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0aab\u0acb\u0a9f\u0ab5\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0ab5\u0abe\u0aa3\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe\u0aa8\u0aab\u0acb \u0a9c\u0aa5\u0acd\u0aa5\u0aab\u0acb \u0aad\u0aa6\u0acd\u0ab0\u0ab5\u0abe\u0a9a\u0ab2\u0aae (\u0a86\u0aae\u0abe\u0a82\u0aa7\u0acd\u0ab0\u0aaa\u0acd\u0ab0\u0aa6\u0ab9\u0ac7\u0ab6)  \u0aa5\u0aac\u0ac0 \u0ab5\u0ab5\u0abe\u0ab0\u0ab5\u0abe\u0aa3\u0ab8\u0aac\u0ac0\n\u0aa5\u0a88\u0aa8\u0ab9\u0ac7 \u0a89\u0aa4\u0acd\u0aa4\u0ab0\u0aaa\u0acd\u0ab0\u0aa6\u0ab9\u0ac7\u0ab6\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a9c\u0acc\u0aa8\u0aaa\u0a95\u0ab0 \u0ab8\u0a95\u0aa7\u0aac\u0ac0 \u0aaa\u0ab9\u0aa8\u0acb\u0a82\u0a9a\u0ab5\u0abe\u0aa1\u0abf\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0ab5\u0aac\u0ac0 \u0ab6\u0a95\u0acd\u0aaf\u0aa4\u0ab5\u0abe \u0a9b\u0ab9\u0ac7.  \u0a86\n\u0aa4\u0ab5\u0abe\u0ab0\u0aac\u0ac0\u0a96\u0ab9\u0ac7 \u0ab8\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0ab9\u0ac7 \u0ab2\u0a97\u0aad\u0a97 \u0ae6\u0aec:\u0ae6\u0ae6 \u0ab5\u0ab5\u0abe\u0a97\u0ab9\u0ac7 \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0a9f\u0aa1\u0a95 \u0aaa\u0acd\u0ab0\u0aaf\u0ab5\u0abe\u0a97\u0ab0\u0ab5\u0abe\u0a9c \u0aa4\u0ab0\u0aab \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0aac\u0ac0\n3\n\n\u0ab0\u0ab9\u0aab\u0acb \u0ab9\u0aa4\u0aab\u0acb \u0a85\u0aa8\u0ab9\u0ac7 \u0ab0\u0ab5\u0abe\u0a9c\u0abe \u0aa4\u0ab5\u0abe\u0ab2\u0ab5\u0abe\u0aac \u0aa8\u0a9c\u0ac0\u0a95 \u0aaa\u0a95\u0aa1\u0abf\u0ab5\u0abe\u0aaf\u0aab\u0acb \u0ab9\u0aa4\u0aab\u0acb.\u0a9f\u0aa1\u0a95 \u0a9a\u0ab2\u0ab5\u0abe\u0ab5\u0aa8\u0ab5\u0abe\u0ab0 \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0a8f\n\u0aaa\u0aab\u0acb\u0aa4\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0a93\u0ab3\u0a96 \u0a93\u0aae \u0aaa\u0acd\u0ab0\u0a95\u0ab5\u0abe\u0ab6 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5 \u0aa4\u0ab0\u0aac\u0ac0\u0a95\u0ab9\u0ac7 \u0a86\u0aaa\u0aac\u0ac0 \u0ab9\u0aa4\u0aac\u0ac0, \u0a9c\u0ab9\u0ac7 \u0a89\u0aa4\u0acd\u0aa4\u0ab0\u0aaa\u0acd\u0ab0\u0aa6\u0ab9\u0ac7\u0ab6\u0aa8\u0ab5\u0abe \u0aac\u0ab5\u0ab2\u0aaf\u0ab5\u0abe\n\u0ab5\u0a9c\u0ab2\u0ab5\u0abe\u0aa8\u0aab\u0acb \u0ab0\u0ab9\u0ab9\u0ac7\u0ab5\u0ab5\u0abe\u0ab8\u0aac\u0ac0 \u0ab9\u0aa4\u0aab\u0acb.  \u0a9f\u0aa1\u0a95\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aac\u0ab9\u0ac7\u0aa0\u0ab9\u0ac7\u0ab2\u0aac\u0ac0 \u0a85\u0aa8\u0acd\u0aaf \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0a8f \u0aaa\u0aab\u0acb\u0aa4\u0ab5\u0abe\u0aa8\u0a95\u0aae\u0abe\u0a82 \u0aa8\u0ab5\u0abe\u0aae \u0a85\u0ab5\u0aae\u0aa4\n\u0aaf\u0ab5\u0abe\u0aa6\u0ab5, \u0ab9\u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0ab0 (\u0a96\u0ab2\u0ab5\u0abe\u0ab6\u0aac\u0ac0) \u0a9c\u0aa3\u0ab5\u0abe\u0ab5\u0acd\u0aaf\u0a95\u0aae\u0abe\u0a82 \u0ab9\u0aa4\u0a95\u0aae\u0abe\u0a82. \u0ab6\u0ab0\u0ac2\u0a86\u0aa4\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aac\u0aae\u0abe\u0a82\u0aa8\u0ab9\u0ac7\u0a8f \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe\u0aa8\u0ab5\u0abe \u0aaa\u0aa1\u0ab0\u0ab5\u0ab9\u0aa8\u0aa8\u0aab\u0acb\n\u0a85\u0ab5\u0ab8\u0acd\u0ab5\u0a95\u0ab5\u0abe\u0ab0 \u0a95\u0aaf\u0ab0\u0acd\u0ab5\u0acb \u0ab9\u0aa4\u0aab\u0acb \u0a85\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aa3\u0a95\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0a86\u0aaa\u0aac\u0ac0 \u0ab9\u0aa4\u0aac\u0ac0 \u0a95\u0ab9\u0ac7,  \u0a9f\u0aa1\u0a95 \u0aaa\u0ab6\u0a95\u0a93\u0aa8\u0ab5\u0abe \u0a96\u0aab\u0acb\u0ab0\u0ab5\u0abe\u0a95\u0aa5\u0aac\u0ac0\n\u0aad\u0ab0\u0ab9\u0ac7\u0ab2\u0aac\u0ac0 \u0a9b\u0ab9\u0ac7,  \u0aaa\u0ab0\u0aae\u0abe\u0a82\u0aa4\u0a95 \u0a85\u0ab5\u0aa7\u0a95\u0ab5\u0abe\u0ab0\u0aac\u0ac0\u0a93/\u0aaa\u0aae\u0abe\u0a82\u0a9a\u0aab\u0acb \u0a85\u0aa8\u0ab9\u0ac7 \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0aac\u0ab9\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0a93\u0aa8\u0aac\u0ac0 \u0ab9\u0ab5\u0abe\u0a9c\u0ab0\u0aac\u0ac0\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0aa4\u0aaa\u0ab5\u0abe\u0ab8 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aa4\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa4\u0ab9\u0ac7\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aec \u0aaa\u0ab9\u0ac7\u0a95\u0ab9\u0ac7\u0a9f \u0a85\u0aa8\u0ab9\u0ac7 \u0aaa\u0acd\u0ab2\u0ab5\u0abe\u0ab5\u0ab8\u0acd\u0a9f\u0a95\u0aa8\u0aac\u0ac0 \u0ab5\u0ab5\u0ab5\u0ab5\u0aa7 \u0a95\u0aab\u0acb\u0aa5\u0ab3\u0aac\u0ac0\u0a93\u0aa8\u0ab5\u0abe\n\u0ae7\u0ae9\u0aeb \u0aa2\u0a97\u0ab2\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0aa5\u0aac\u0ac0 \u0ae7\u0ae6\u0ae6\u0aeb \u0aaa\u0ab9\u0ac7\u0a95\u0ab9\u0ac7\u0a9f \u0aae\u0ab3\u0aac\u0ac0 \u0a86\u0ab5\u0acd\u0aaf\u0ab5\u0abe \u0ab9\u0aa4\u0ab5\u0abe.  \u0aa4\u0ab9\u0ac7\u0aa8\u0ab9\u0ac7 \u0a96\u0aab\u0acb\u0ab2\u0aa4\u0ab5\u0abe,  \u0aa4\u0ab9\u0ac7\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0a95\u0ab5\u0abe\n\u0ab2\u0aac\u0ac0\u0ab2\u0ab5\u0abe \u0ab0\u0aae\u0abe\u0a82\u0a97\u0aa8\u0aab\u0acb \u0a98\u0ab5\u0abe\u0ab8\u0ab5\u0ab5\u0abe\u0ab3\u0aab\u0acb \u0aaa\u0aa6\u0ab5\u0abe\u0aa5\u0ab0\u0acd\u0aa4\u0abe \u0ab9\u0aa4\u0aab\u0acb, \u0a9c\u0ab9\u0ac7 \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe \u0a9c\u0ab9\u0ac7\u0ab5\u0aab\u0acb \u0ab2\u0ab5\u0abe\u0a97\u0aa4\u0aab\u0acb \u0ab9\u0aa4\u0aab\u0acb. \u0a9c\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aaf\u0ab9\u0ac7\u0ab2\u0ab5\u0abe\n\u0aaa\u0ab9\u0ac7\u0a95\u0ab9\u0ac7\u0a9f\u0aab\u0acb\u0aa8\u0a95\u0aae\u0abe\u0a82 \u0ab5\u0a9c\u0aa8  \u0ae9\u0aef\u0aed\u0ae7.\u0aec\u0ae6\u0ae6 \u0aa1\u0a95\u0ab2\u0aab\u0acb\u0a97\u0ab5\u0abe\u0aae \u0ab9\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aa8\u0a95\u0aae\u0abe\u0a82 \u0a9c\u0abe\u0aa3\u0ab5\u0ab5\u0abe \u0aae\u0ab3\u0a95\u0aae\u0abe\u0a82 \u0ab9\u0aa4\u0a95\u0aae\u0abe\u0a82.\n\u0aef. \n\u0ab5\u0ab5\u0abe\u0ab9\u0aa8\u0aa8\u0ab5\u0abe \u0aa1\u0abf\u0aa1\u0ab5\u0abe\u0a88\u0ab5\u0ab0 \u0a93\u0aae \u0aaa\u0acd\u0ab0\u0a95\u0ab5\u0abe\u0ab6 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5\u0ab9\u0ac7 \u0a96\u0a95\u0ab2\u0ab5\u0abe\u0ab8\u0aab\u0acb \u0a95\u0aaf\u0ab0\u0acd\u0ab5\u0acb \u0a95\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\n\u0a9c\u0aae\u0ab6\u0ab9\u0ac7\u0aa6\u0aaa\u0a95\u0ab0\u0aa8\u0ab5\u0abe \u0a8f\u0a95 \u0ab5\u0aac\u0a9f\u0a95 \u0aa6\u0ab5\u0abe\u0aa6\u0ab5\u0abe\u0aa8\u0ab5\u0abe \u0ab9\u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0ab0 \u0aa4\u0ab0\u0aac\u0ac0\u0a95\u0ab9\u0ac7 \u0ab8\u0ab9-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0a85\u0ab5\u0aae\u0aa4 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5 \u0ab8\u0ab5\u0abe\u0aa5\u0ab9\u0ac7\n\u0a85\u0aa8\u0ab9\u0ac7 \u0aac\u0ab5\u0ab2\u0aaf\u0ab5\u0abe\u0aa8\u0ab5\u0abe \u0ab0\u0ab9\u0ab9\u0ac7\u0ab5\u0ab5\u0abe\u0ab8\u0aac\u0ac0 \u0ab6\u0aac\u0ac0 \u0ab0\u0ab5\u0abe\u0aae \u0aaa\u0acd\u0ab0\u0ab5\u0ab9\u0ac7\u0ab6 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5\u0aa8\u0ab5\u0abe \u0a95\u0ab9\u0ab9\u0ac7\u0ab5\u0ab5\u0abe\u0aa5\u0aac\u0ac0 \u0a9f\u0aa1\u0a95 \u0a9a\u0ab2\u0ab5\u0abe\u0ab5\u0aa4\u0aab\u0acb \u0ab9\u0aa4\u0aab\u0acb. \u0aa4\u0ab9\u0ac7\n\u0a9c\u0aae\u0ab6\u0ab9\u0ac7\u0aa6\u0aaa\u0a95\u0ab0 \u0a97\u0aaf\u0aab\u0acb \u0a9c\u0acd\u0aaf\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0ab5\u0abe \u0aaa\u0aa1\u0ab0\u0ab5\u0a9a\u0aa4\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aa8\u0ab9\u0ac7 \u0ab0\u0ac2.\u0aeb\u0ae6,\u0ae6\u0ae6\u0ae6/- \u0aa8\u0ab5\u0abe\n\u0aac\u0aa6\u0ab2\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0a95\u0ab0\u0ab5\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0aa1\u0aa1\u0abf\u0ab5\u0ab2\u0ab5\u0ab0\u0aac\u0ac0 \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe\u0aa5\u0aac\u0ac0 \u0aad\u0ab0\u0ab9\u0ac7\u0ab2\u0aac\u0ac0 \u0a9f\u0aa1\u0a95 \u0a86\u0aaa\u0aac\u0ac0.  \u0aa4\u0ab9\u0ac7\u0aae\u0aa3\u0ab9\u0ac7 \u0ab5\u0aa7\u0a95\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a9c\u0aa3\u0ab5\u0abe\u0ab5\u0acd\u0aaf\u0a95\u0aae\u0abe\u0a82 \u0a95\u0ab9\u0ac7 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a93 \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe\u0aa8\u0ab5\u0abe \u0a97\u0ab9\u0ac7\u0ab0\u0a95\u0ab5\u0abe\u0aaf\u0aa6\u0ab9\u0ac7 \u0ab5\u0ab9\u0ac7\u0aaa\u0ab5\u0abe\u0ab0\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0aae\u0abe\u0a82\u0aa1\u0abf\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aaf\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0a9b\u0ab9\u0ac7.\n4\n\n\u0ae7\u0ae6. \n\u0a86 \u0a9c \u0aae\u0ab5\u0abe\u0aa1\u0ab9\u0aa4\u0aac\u0ac0 \u0ab9\u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0ab0 \u0a85\u0ab5\u0aae\u0aa4 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5\u0ab9\u0ac7 \u0a86\u0aaa\u0aac\u0ac0 \u0ab9\u0aa4\u0aac\u0ac0.\n\u0ae7\u0ae7. \n\u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0aac\u0ab9\u0ac7 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a93\u0a8f \u0a86\u0aaa\u0ab9\u0ac7\u0ab2 \u0aae\u0ab5\u0abe\u0aa1\u0ab9\u0aa4\u0aac\u0ac0 \u0aa6\u0ab6\u0ab5\u0abe\u0ab0\u0acd\u0aa4\u0abe\u0ab5\u0ab9\u0ac7 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0a93 \u0aac\u0aae\u0abe\u0a82\u0aa8\u0ab9\u0ac7\n\u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aa3\u0aa4\u0ab5\u0abe \u0ab9\u0aa4\u0ab5\u0abe \u0a85\u0aa8\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0a93 \u0a97\u0ab9\u0ac7\u0ab0\u0a95\u0ab5\u0abe\u0aaf\u0aa6\u0ab9\u0ac7\u0ab8\u0ab0 \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe\u0aa8\u0ab9\u0ac7 \u0aaa\u0aa1\u0ab0\u0ab5\u0ab9\u0aa8\n\u0a95\u0ab0\u0ab5\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aae\u0aa8\u0aac\u0ac0 \u0ab8\u0ab5\u0abe\u0aa5\u0ab9\u0ac7 \u0a9c\u0acb\u0aa1\u0abf\u0ab5\u0abe\u0aaf\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0ab9\u0aa4\u0ab5\u0abe \u0a85\u0aa8\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0a93 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0ab5\u0abe\n\u0aae\u0aab\u0acb\u0aac\u0ab5\u0abe\u0a87\u0ab2 \u0aa8\u0aae\u0abe\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 \u0ab8\u0aac\u0ac0\u0aa7\u0ab5\u0abe \u0ab8\u0aae\u0abe\u0a82\u0aaa\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab9\u0aa4\u0ab5\u0abe.\u0aab\u0aa1\u0ab0\u0aaf\u0ab5\u0abe\u0aa6/\u0a8f\u0aab.\u0a86\u0a88.\u0a86\u0ab0.  \u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82\u0aa5\u0aac\u0ac0 \u0a9c\u0ab9\u0ac7\n\u0aa4\u0aa5\u0acd\u0aaf\u0aab\u0acb \u0aac\u0ab9\u0ab5\u0abe\u0ab0 \u0a86\u0ab5\u0acd\u0aaf\u0ab5\u0abe \u0a9b\u0ab9\u0ac7 \u0a85\u0aa8\u0ab9\u0ac7 \u0a8f\u0aa8.\u0aa1\u0abf\u0aac\u0ac0.\u0aaa\u0aac\u0ac0.\u0a8f\u0ab8.  \u0a8f\u0a95\u0acd\u0a9f\u0aa8\u0aac\u0ac0 \u0a95\u0ab2\u0aae \u0aec\u0aed \u0ab9\u0ab9\u0ac7\u0aa0\u0ab3\n\u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0aac\u0ab9\u0ac7 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a93\u0aa8\u0ab5\u0abe \u0ab5\u0aa8\u0ab5\u0ab9\u0ac7\u0aa6\u0aa8\u0aab\u0acb \u0aa8\u0aa8\u0acb\u0a82\u0aa7\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0ab5\u0abe \u0a9b\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7 \u0aa6\u0ab6\u0ab5\u0abe\u0ab0\u0acd\u0aa4\u0abe\u0ab5\u0ab9\u0ac7 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7\n\u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe\u0aa8\u0ab5\u0abe \u0a97\u0ab9\u0ac7\u0ab0\u0a95\u0ab5\u0abe\u0aaf\u0aa6\u0ab9\u0ac7\u0ab8\u0ab0 \u0ab5\u0ab9\u0ac7\u0aaa\u0ab5\u0abe\u0ab0\u0aa8\u0aab\u0acb \u0aae\u0a95\u0a96\u0acd\u0aaf \u0ab8\u0a95\u0aa4\u0acd\u0ab0\u0aa7\u0ab5\u0abe\u0ab0 \u0a85\u0aa8\u0ab9\u0ac7 \u0a86\u0aaf\u0aab\u0acb\u0a9c\u0a95\n\u0a9b\u0ab9\u0ac7.\n\u0ae7\u0ae8. \n\u0ab0\u0ab9\u0ac7\u0a95\u0aab\u0acb\u0aa1\u0abf\u0ab0\u0acd\u0aa4\u0abe \u0aaa\u0ab0\u0aa5\u0aac\u0ac0 \u0a9c\u0aa3\u0ab5\u0abe\u0ab5\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0a95\u0aae\u0abe\u0a82 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7,  \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\n\u0aad\u0a95\u0aa4\u0a95\u0ab5\u0abe\u0ab3\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab5\u0abe \u0a9c \u0a97\u0a95\u0aa8\u0ab5\u0abe\u0a93\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0ab5\u0abe\u0aae\u0ab9\u0ac7\u0ab2 \u0ab0\u0ab9\u0aab\u0acb \u0a9b\u0ab9\u0ac7 \u0a85\u0aa8\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aa8\u0aac\u0ac0 \u0ab8\u0ab5\u0abe\u0aae\u0ab9\u0ac7 \u0a85\u0aa8\u0ab9\u0ac7\u0a95 \u0a95\u0ab9\u0ac7\u0ab8\n\u0aaa\u0ab9\u0ac7\u0ab5\u0aa8\u0acd\u0aa1\u0abf\u0aae\u0abe\u0a82\u0a97 \u0a9b\u0ab9\u0ac7.\n\u0ae7\u0ae9. \n\u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0aac\u0ab5\u0abe\u0aac\u0aa4\u0aab\u0acb\u0aa8\u0ab9\u0ac7 \u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab5\u0abe\u0a96\u0aac\u0ac0\u0aa8\u0ab9\u0ac7,  \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0aac\u0ab9\u0ac7 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\n\u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0a93 - \u0ab5\u0ab5\u0abe\u0ab9\u0aa8\u0aa8\u0ab5\u0abe \u0aa1\u0abf\u0aa1\u0ab5\u0abe\u0a87\u0ab5\u0ab0 \u0a85\u0aa8\u0ab9\u0ac7 \u0ab9\u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0ab0\u0aa8\u0ab5\u0abe \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aae\u0aae\u0abe\u0a82\u0a9c\u0a95\u0ab0 \u0a95\u0ab0\u0ab5\u0ab5\u0abe, \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\n\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0aaf\u0aab\u0acb\u0a97\u0acd\u0aaf \u0a85\u0aa8\u0ab9\u0ac7 \u0aaa\u0aaf\u0ab5\u0abe\u0ab0\u0acd\u0aa4\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab5\u0abe\u0ab0\u0aa3 \u0a9c\u0aa3\u0ab5\u0abe\u0aa4\u0a95\u0aae\u0abe\u0a82 \u0aa8\u0aa5\u0aac\u0ac0. \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4\n\u0aac\u0aae\u0abe\u0a82\u0aa8\u0ab9\u0ac7 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a93 \u0aae\u0a95\u0a96\u0acd\u0aaf \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0aa8\u0aa5\u0aac\u0ac0, \u0aaa\u0ab0\u0aae\u0abe\u0a82\u0aa4\u0a95 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0 \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a93\u0aa8\u0ab5\u0abe \u0a97\u0a95\u0aaa\u0acd\u0aa4 \u0a8f\u0a9c\u0aa8\u0acd\u0a9f\u0aab\u0acb\n5\n\n\u0a9b\u0ab9\u0ac7, \u0a9c\u0ab9\u0ac7 \u0aa8\u0ab6\u0aac\u0ac0\u0ab2\u0ab5\u0abe \u0aa6\u0acd\u0ab0\u0ab5\u0acd\u0aaf\u0aab\u0acb\u0aa8\u0aac\u0ac0 \u0aa6\u0ab5\u0abe\u0aa3\u0a9a\u0aab\u0acb\u0ab0\u0aac\u0ac0\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aae\u0a95\u0a96\u0acd\u0aaf \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4 \u0a9b\u0ab9\u0ac7 \u0a85\u0aa8\u0ab9\u0ac7 \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0a97\u0ab9\u0ac7\u0ab0\u0a95\u0ab5\u0abe\u0aaf\u0aa6\u0ab9\u0ac7\u0ab8\u0ab0\n\u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0ab5\u0abe\u0ab0\u0aab\u0acb\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0ab5\u0abe\u0aae\u0ab9\u0ac7\u0ab2 \u0a9b\u0ab9\u0ac7. \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0aac\u0ac0 \u0aad\u0a95\u0ab5\u0aae\u0a95\u0ab5\u0abe \u0a85\u0aa8\u0acd\u0aaf \u0aac\u0ab9\u0ac7 \u0ab8\u0ab9-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a93\n- \u0aa1\u0abf\u0aa1\u0ab5\u0abe\u0a87\u0ab5\u0ab0 \u0a85\u0aa8\u0ab9\u0ac7 \u0ab9\u0ab9\u0ac7\u0ab2\u0acd\u0aaa\u0ab0\u0aa8\u0aac\u0ac0 \u0aad\u0a95\u0ab5\u0aae\u0a95\u0ab5\u0abe \u0a95\u0ab0\u0aa4\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0ab0\u0aac\u0ac0\u0aa4\u0ab9\u0ac7 \u0a85\u0ab2\u0a97 \u0a9b\u0ab9\u0ac7. \u0ab8\u0ab9-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0a93\u0aae\n\u0aaa\u0acd\u0ab0\u0a95\u0ab5\u0abe\u0ab6 \u0aaf\u0ab5\u0abe\u0aa6\u0ab5\u0ab9\u0ac7 \u0aaa\u0aab\u0acb\u0aa4\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0a85\u0ab0\u0a9c\u0ac0\u0aa8\u0ab5\u0abe \u0ab8\u0aae\u0aa5\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a89\u0a9a\u0acd\u0a9a \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa6\u0ab5\u0abe\u0a96\u0ab2\n\u0a95\u0ab0\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0ab8\u0aab\u0acb\u0a97\u0aae\u0abe\u0a82\u0aa6\u0aa8\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0aac\u0ac0 \u0ab8\u0aae\u0abe\u0a82\u0aa1\u0abf\u0aab\u0acb\u0ab5\u0aa3\u0aac\u0ac0 \u0a85\u0aa8\u0ab9\u0ac7 \u0a97\u0ab9\u0ac7\u0ab0\u0a95\u0ab5\u0abe\u0aaf\u0aa6\u0ab9\u0ac7\u0ab8\u0ab0 \u0ab5\u0ab9\u0ac7\u0aaa\u0ab5\u0abe\u0ab0\u0aa8\u0ab5\u0abe\n\u0aae\u0ab5\u0abe\u0ab8\u0acd\u0a9f\u0ab0\u0aae\u0ab5\u0abe\u0a88\u0aa8\u0acd\u0aa1\u0abf \u0aa4\u0ab0\u0aac\u0ac0\u0a95\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aae\u0aa8\u0aac\u0ac0 \u0aad\u0a95\u0ab5\u0aae\u0a95\u0ab5\u0abe\u0aa8\u0ab9\u0ac7 \u0ab8\u0acd\u0ab5\u0aac\u0ac0\u0a95\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0ab9\u0aa4\u0aac\u0ac0,  \u0a9c\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0a93\u0aa8\u0ab5\u0abe \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0\n\u0a9b\u0a95\u0a9f\u0ab5\u0ab5\u0abe\u0aa8\u0ab5\u0abe \u0a86\u0aa6\u0ab9\u0ac7\u0ab6\u0aa5\u0aac\u0ac0 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0aa5\u0ab5\u0abe\u0aaf \u0a9b\u0ab9\u0ac7.  \u0a86\u0aa5\u0aac\u0ac0,  \u0ab9\u0ab5\u0abe\u0a87\u0a95\u0aab\u0acb\u0a9f\u0ab0\u0acd\u0aa4\u0abe \u0aa6\u0ab5\u0abe\u0ab0\u0ab5\u0abe \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0aac\u0ab9\u0ac7\n\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0a93\u0aa8\u0aac\u0ac0 \u0a9c\u0ab9\u0ac7\u0aae \u0ab9\u0ab5\u0abe\u0ab2\u0aa8\u0ab5\u0abe \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0aae\u0a95\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe \u0a86\u0ab5\u0ab9\u0ac7\u0ab2 \u0a9b\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\n\u0aa8\u0acd\u0aaf\u0ab5\u0abe\u0aaf\u0aab\u0acb\u0ab5\u0a9a\u0aa4 \u0aa8\u0aa5\u0aac\u0ac0.\n\u0ae7\u0aea. \n\u0a86 \u0a89\u0aaa\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82\u0aa4,  \u0a8f \u0aac\u0ab5\u0abe\u0aac\u0aa4 \u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab9\u0ac7\u0ab2 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7,  \u0a89\u0a9a\u0acd\u0a9a \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0ab9\u0ac7\n\u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0a86\u0aaa\u0aa4\u0aac\u0ac0 \u0ab5\u0a96\u0aa4\u0ab9\u0ac7 \u0a8f\u0aa8.\u0aa1\u0abf\u0aac\u0ac0.\u0aaa\u0aac\u0ac0.\u0a8f\u0ab8. \u0a8f\u0a95\u0acd\u0a9f\u0aa8\u0aac\u0ac0 \u0a95\u0ab2\u0aae \u0ae9\u0aed\u0aa8\u0aac\u0ac0 \u0a85\u0ab5\u0a97\u0aa3\u0aa8\u0ab5\u0abe \u0a95\u0ab0\u0aac\u0ac0\n\u0ab9\u0aa4\u0aac\u0ac0, \u0a9c\u0ab9\u0ac7\u0aae\u0ab5\u0abe \u0a85\u0aa8\u0acd\u0aaf \u0aac\u0ab5\u0abe\u0aac\u0aa4\u0aab\u0acb\u0aa8\u0aac\u0ac0 \u0ab8\u0ab5\u0abe\u0aa5\u0ab9\u0ac7 \u0ab8\u0ab5\u0abe\u0aa5\u0ab9\u0ac7 \u0a8d\u0ab5\u0aac\u0ac0 \u0a9c\u0acb\u0a97\u0ab5\u0ab5\u0abe\u0a88 \u0a95\u0ab0\u0ab9\u0ac7\u0ab2 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7, \u0ab5\u0ab5\u0abe\u0ab5\u0aa3\u0ab5\u0a9c\u0acd\u0aaf\u0a95\n\u0a9c\u0aa5\u0acd\u0aa5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0aae\u0abe\u0a82\u0a95\u0ab3\u0ab5\u0abe\u0aaf\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0a95\u0aab\u0acb\u0a88 \u0a97\u0a95\u0aa8\u0ab5\u0abe\u0aa8\u0ab5\u0abe \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0aa8\u0ab9\u0ac7 \u0aa4\u0acd\u0aaf\u0ab5\u0abe \u0ab8\u0a95\u0aa7\u0aac\u0ac0 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0\n\u0a9b\u0aab\u0acb\u0aa1\u0abf\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0ab9\u0ab9\u0ac0\u0a82 \u0a86\u0ab5\u0ab9\u0ac7 \u0a9c\u0acd\u0aaf\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0a95\u0aa7\u0aac\u0ac0 \u0aa4\u0ab9\u0ac7\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a9c\u0aa3\u0ab5\u0abe\u0ab5\u0ab9\u0ac7\u0ab2\u0aac\u0ac0 \u0aac\u0aa8\u0ab9\u0ac7 \u0ab6\u0ab0\u0aa4\u0aab\u0acb\u0aa8\u0a95\u0aae\u0abe\u0a82 \u0aaa\u0ab5\u0abe\u0ab2\u0aa8 \u0aa8 \u0aa5\u0ab5\u0abe\u0aaf,\n\u0a8f\u0a9f\u0ab2\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7,\n(\u0ae7) \u0ab8\u0ab0\u0a95\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0ab5\u0a95\u0aac\u0ac0\u0ab2\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0a85\u0ab0\u0a9c\u0ac0\u0aa8\u0aab\u0acb \u0ab5\u0ab5\u0ab0\u0aab\u0acb\u0aa7 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0aa4\u0a95 \u0a86\u0aaa\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aac\u0ac0\n6\n\n\u0ab9\u0aab\u0acb\u0aaf.  \n(\u0ae8) \u0a95\u0aab\u0acb\u0a9f\u0ab0\u0acd\u0aa4\u0abe \u0ab8\u0aae\u0abe\u0a82\u0aa4\u0a95\u0ab7\u0acd\u0a9f \u0aa5\u0ab5\u0abe\u0aaf \u0a95\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7 \u0a86\u0ab5\u0ab5\u0abe \u0a97\u0a95\u0aa8\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7 \u0aa6\u0aab\u0acb\u0ab5\u0ab0\u0aa4 \u0aa8\u0aa5\u0aac\u0ac0 \u0a85\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0\n\u0ab9\u0aab\u0acb\u0aaf \u0aa4\u0acd\u0aaf\u0ab5\u0abe\u0ab0\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0ab5\u0aab\u0acb \u0a95\u0aab\u0acb\u0a88 \u0a97\u0a95\u0aa8\u0aab\u0acb \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0ab6\u0a95\u0acd\u0aaf\u0aa4\u0ab5\u0abe \u0aa8\u0aa5\u0aac\u0ac0 \u0a8f\u0aae \u0aae\u0ab5\u0abe\u0aa8\u0ab5\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7\n\u0ab5\u0ab5\u0abe\u0a9c\u0aac\u0aac\u0ac0 \u0a86\u0aa7\u0ab5\u0abe\u0ab0\u0aab\u0acb \u0ab9\u0aab\u0acb\u0aaf. \n\u0ae7\u0aeb. \n\u0ab8\u0a97\u0ab5\u0aa1\u0abf\u0aa4\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0a95\u0ab2\u0aae \u0ae9\u0aed(\u0ae7) \u0aa8\u0aac\u0ac0\u0a9a\u0ab9\u0ac7 \u0aa6\u0ab6\u0ab5\u0abe\u0ab0\u0acd\u0aa4\u0abe\u0ab5\u0ab9\u0ac7\u0ab2 \u0a9b\u0ab9\u0ac7\u0a9b- -\n\"\u0ae9\u0aed. \u0a97\u0a95\u0aa8\u0ab5\u0abe \u0ab8\u0aae\u0abe\u0a82\u0a9c\u0ab9\u0ac7\u0aaf \u0a85\u0aa8\u0ab9\u0ac7 \u0ab5\u0aac\u0aa8\u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8\u0aaa\u0ab5\u0abe\u0aa4\u0acd\u0ab0 \u0ab9\u0aab\u0acb\u0ab5\u0ab5\u0abe \u0a9c\u0acb\u0a88\u0a8f. - - - \n(\u0ae7)  \u0aab\u0aab\u0acb\u0a9c\u0aa6\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0a95\u0ab5\u0abe\u0aaf\u0ab0\u0acd\u0aa4\u0abe\u0ab0\u0aac\u0ac0\u0ab5\u0aa4 \u0ab8\u0aae\u0abe\u0a82\u0aa1\u0ab9\u0aa4\u0ab5\u0abe,  \u0ae7\u0aef\u0aed\u0ae9 (\u0ae7\u0aef\u0aed\u0aea\u0aa8\u0aab\u0acb \u0ae8\u0a9c\u0acb)  \u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a97\u0aae\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7 \u0aae\u0a9c\u0a95\u0a95\u0ab0 \u0ab9\u0aab\u0acb\u0aaf \u0aa4\u0ab9\u0ac7\u0aae \u0a9b\u0aa4\u0ab5\u0abe\u0aae\u0abe\u0a82 -\n(\u0a95) \u0a86 \u0a85\u0ab5\u0aa7\u0ab5\u0aa8\u0aaf\u0aae \u0ab9\u0ab9\u0ac7\u0aa0\u0ab3 \u0aa6\u0aae\u0abe\u0a82\u0aa1\u0abf\u0aa8\u0aac\u0ac0\u0aaf \u0aa6\u0ab0\u0ab9\u0ac7\u0a95 \u0a97\u0a95\u0aa8\u0aab\u0acb \u0ab8\u0aae\u0abe\u0a82\u0a9c\u0ab9\u0ac7\u0aaf \u0ab0\u0ab9\u0ab9\u0ac7\u0ab6\u0ab9\u0ac7. \n(\u0a96) \u0aa6\u0aae\u0abe\u0a82\u0aa1\u0abf\u0aa8\u0aac\u0ac0\u0aaf \u0a97\u0a95\u0aa8\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0aa6\u0aab\u0acb\u0ab5\u0ab0\u0aa4 \u0ae8 [\u0a95\u0ab2\u0aae \u0ae7\u0aef \u0a85\u0aa5\u0ab5\u0ab5\u0abe \u0a95\u0ab2\u0aae \u0ae8\u0aea\n\u0a85\u0aa5\u0ab5\u0ab5\u0abe \u0a95\u0ab2\u0aae \u0ae8\u0aed-\u0a8f \u0ab9\u0ab9\u0ac7\u0aa0\u0ab3\u0aa8\u0ab5\u0abe \u0a97\u0a95\u0aa8\u0ab5\u0abe\u0a93 \u0a85\u0aa8\u0ab9\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0abe\u0aaa\u0ab5\u0abe\u0ab0\u0aac\u0ac0\n\u0a9c\u0aa5\u0acd\u0aa5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0aae\u0abe\u0a82\u0a95\u0ab3\u0ab5\u0abe\u0aaf\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0a97\u0a95\u0aa8\u0ab5\u0abe\u0a93 \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7]  \u0a95\u0aab\u0acb\u0a88\u0aaa\u0aa3 \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0aa8\u0ab9\u0ac7\n\u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0a85\u0aa5\u0ab5\u0ab5\u0abe \u0aa4\u0ab9\u0ac7\u0aa8\u0ab5\u0abe \u0aaa\u0aab\u0acb\u0aa4\u0ab5\u0abe\u0aa8\u0ab5\u0abe \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0a97\u0aa4 \u0aac\u0aab\u0acb\u0aa8\u0acd\u0aa1\u0abf \u0aaa\u0ab0\n\u0aae\u0a95\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ab9\u0ac7 \u0aa8\u0ab9\u0ab9\u0ac0\u0a82 \u0ab5\u0ab8\u0ab5\u0ab5\u0abe\u0aaf \u0a95\u0ab9\u0ac7- \n(\u0ae7)  \u0ab8\u0ab0\u0a95\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0ab5\u0a95\u0aac\u0ac0\u0ab2\u0aa8\u0ab9\u0ac7 \u0a86\u0ab5\u0aac\u0ac0 \u0aae\u0a95\u0ab5\u0a95\u0acd\u0aa4 \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7\u0aa8\u0aac\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0\u0aa8\u0aab\u0acb \u0ab5\u0ab5\u0ab0\u0aab\u0acb\u0aa7\n\u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0aa4\u0a95 \u0a86\u0aaa\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aac\u0ac0 \u0ab9\u0aab\u0acb\u0aaf, \u0a85\u0aa8\u0ab9\u0ac7\n7\n\n(\u0ae8) \u0a9c\u0ab9\u0ac7\u0aae\u0ab5\u0abe \u0ab8\u0ab0\u0a95\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0ab5\u0a95\u0aac\u0ac0\u0ab2\u0ab9\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0\u0aa8\u0aab\u0acb \u0ab5\u0ab5\u0ab0\u0aab\u0acb\u0aa7 \u0a95\u0ab0\u0ab9\u0ac7\u0ab2  \u0ab9\u0aab\u0acb\u0aaf, \u0a85\u0aa8\u0ab9\u0ac7 \u0a85\u0aa8\u0ab9\u0ac7\n\u0aa4\u0ab9\u0ac7\u0ab5\u0aab\u0acb \u0ab5\u0ab5\u0ab6\u0acd\u0ab5\u0ab5\u0abe\u0ab8 \u0a95\u0ab0\u0ab5\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4 \u0ab8\u0aae\u0abe\u0a82\u0aa4\u0a95\u0ab7\u0acd\u0a9f \u0ab9\u0aab\u0acb\u0aaf \u0a95\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7 \u0a86\u0ab5\u0ab5\u0abe\n\u0a97\u0a95\u0aa8\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0aa6\u0aab\u0acb\u0ab5\u0ab0\u0aa4 \u0aa8\u0aa5\u0aac\u0ac0 \u0a85\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0ab9\u0aab\u0acb\u0aaf \u0aa4\u0acd\u0aaf\u0ab5\u0abe\u0ab0\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aa8\u0ab5\u0abe\n\u0aa6\u0ab5\u0abe\u0ab0\u0ab5\u0abe \u0a95\u0aab\u0acb\u0a88 \u0a97\u0a95\u0aa8\u0aab\u0acb \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0ab6\u0a95\u0acd\u0aaf\u0aa4\u0ab5\u0abe \u0aa8\u0aa5\u0aac\u0ac0 \u0aa4\u0ab9\u0ac7\u0ab5\u0a95\u0aae\u0abe\u0a82 \u0aae\u0ab5\u0abe\u0aa8\u0ab5\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0a95\u0aab\u0acb\u0a9f\u0ab0\u0acd\u0aa4\u0abe\n\u0aaa\u0ab5\u0abe\u0ab8\u0ab9\u0ac7 \u0ab5\u0ab5\u0abe\u0a9c\u0aac\u0aac\u0ac0 \u0a86\u0aa7\u0ab5\u0abe\u0ab0 \u0ab9\u0aab\u0acb\u0aaf.\"\n\u0ae7\u0aec.\n \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0a9c\u0acb\u0a97\u0ab5\u0ab5\u0abe\u0a88\u0a93\u0aa8\u0ab9\u0ac7 \u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab5\u0abe\u0a96\u0aac\u0ac0\u0aa8\u0ab9\u0ac7, \u0aa4\u0ab9\u0ac7\u0ab5\u0a95\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f \u0aa5\u0ab5\u0abe\u0aaf \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7,\n\u0aa8\u0ab6\u0aac\u0ac0\u0ab2\u0ab5\u0abe \u0aa6\u0acd\u0ab0\u0ab5\u0acd\u0aaf\u0aab\u0acb\u0aa8\u0ab5\u0abe \u0ab5\u0ab9\u0ac7\u0aaa\u0ab5\u0abe\u0ab0\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0aae\u0abe\u0a82\u0aa1\u0abf\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aaf\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0a95\u0aab\u0acb\u0a88 \u0aaa\u0aa3 \u0a97\u0a95\u0aa8\u0ab5\u0abe\u0aa8\u0ab5\u0abe \u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0ab5\u0acd\u0aaf\u0ab5\u0a95\u0acd\u0aa4\u0aa8\u0ab9\u0ac7 \u0aa4\u0acd\u0aaf\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0ab8\u0a95\u0aa7\u0aac\u0ac0 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0a9b\u0aab\u0acb\u0aa1\u0abf\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0ab9\u0ab9\u0ac0\u0a82 \u0a86\u0ab5\u0ab9\u0ac7 \u0a9c\u0acd\u0aaf\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0a95\u0aa7\u0aac\u0ac0 \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4 \u0ab8\u0aae\u0abe\u0a82\u0aa4\u0a95\u0ab7\u0acd\u0a9f \u0aa8 \u0aa5\u0ab5\u0abe\u0aaf \u0a95\u0ab9\u0ac7, \u0aa4\u0ab9\u0ac7\n\u0a86 \u0aaa\u0acd\u0ab0\u0a95\u0ab5\u0abe\u0ab0\u0aa8\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a97\u0a95\u0aa8\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa6\u0aab\u0acb\u0ab5\u0ab0\u0aa4 \u0aa8\u0aa5\u0aac\u0ac0 \u0a85\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0ab9\u0ab6\u0ab9\u0ac7 \u0aa4\u0acd\u0aaf\u0ab5\u0abe\u0ab0\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aa8\u0ab5\u0abe \u0aa6\u0ab5\u0abe\u0ab0\u0ab5\u0abe \u0a95\u0aab\u0acb\u0a88\n\u0a97\u0a95\u0aa8\u0aab\u0acb \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0ab6\u0a95\u0acd\u0aaf\u0aa4\u0ab5\u0abe \u0aa8\u0aa5\u0aac\u0ac0.\n\u0ae7\u0aed. \n \u0a9c\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aaf\u0ab9\u0ac7\u0ab2\u0ab5\u0abe \u0a97\u0ab5\u0abe\u0aae\u0abe\u0a82\u0a9c\u0abe\u0aa8\u0aab\u0acb \u0a9c\u0aa5\u0acd\u0aa5\u0aab\u0acb \u0ab5\u0acd\u0aaf\u0ab5\u0abe\u0aaa\u0ab5\u0abe\u0ab0\u0aac\u0ac0 \u0a9c\u0aa5\u0acd\u0aa5\u0aab\u0acb \u0ab9\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0ab5\u0ab5\u0abe\u0aa4\n\u0ab8\u0acd\u0ab5\u0aac\u0ac0\u0a95\u0ab5\u0abe\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab9\u0ac7\u0ab2 \u0a9b\u0ab9\u0ac7.  \u0a89\u0a9a\u0acd\u0a9a \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0ab9\u0ac7 \u0a8f\u0ab5\u0a95\u0aae\u0abe\u0a82 \u0a95\u0aab\u0acb\u0a88 \u0aa4\u0ab5\u0abe\u0ab0\u0aa3 \u0aa8\u0aa8\u0acb\u0a82\u0aa7\u0acd\u0aaf\u0a95\u0aae\u0abe\u0a82 \u0aa8\u0aa5\u0aac\u0ac0 \u0a95\u0ab9\u0ac7\n\u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0 \u0a95\u0ab5\u0aa5\u0aa4 \u0a97\u0a95\u0aa8\u0ab5\u0abe \u0aae\u0ab5\u0abe\u0a9f\u0ab9\u0ac7 \u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0aa6\u0acd\u0ab0\u0ab7\u0acd\u0a9f\u0aac\u0ac0\u0a8f \u0aa6\u0aab\u0acb\u0ab0\u0aac\u0ac0\u0aa4 \u0aa8\u0aa5\u0aac\u0ac0 \u0a85\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0\n\u0a9b\u0a95\u0a9f\u0ab5\u0abe \u0aaa\u0a9b\u0aac\u0ac0 \u0aa4\u0ab9\u0ac7\u0ab5\u0aab\u0acb \u0a9c \u0a97\u0a95\u0aa8\u0aab\u0acb \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aa8\u0aac\u0ac0 \u0ab6\u0a95\u0acd\u0aaf\u0aa4\u0ab5\u0abe \u0aa8\u0aa5\u0aac\u0ac0. \u0aaa\u0ab0\u0aae\u0abe\u0a82\u0aa4\u0a95 \u0aa4\u0ab9\u0ac7\u0aa8\u0aab\u0acb \u0aaa\u0a95\u0ab5\u0ab0\u0acd\u0aa4\u0abe-\u0a88\u0aa4\u0aac\u0ac0\u0ab9\u0ab5\u0abe\u0ab8 \u0a8f\u0ab5\u0a95\u0aae\u0abe\u0a82\n\u0ab8\u0a95\u0a9a\u0ab5\u0ab9\u0ac7 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7 \u0ab5\u0aa8\u0aaf\u0ab5\u0aae\u0aa4 \u0a85\u0aaa\u0ab0\u0ab5\u0abe\u0aa7\u0aac\u0ac0 \u0a9b\u0ab9\u0ac7. \u0a95\u0aab\u0acb\u0a9f\u0ab0\u0acd\u0aa4\u0abe \u0aa6\u0ab5\u0abe\u0ab0\u0ab5\u0abe \u0a86 \u0aaa\u0acd\u0ab0\u0a95\u0ab5\u0abe\u0ab0\u0aa8\u0aab\u0acb \u0ab8\u0aae\u0abe\u0a82\u0aa4\u0aab\u0acb\u0ab0 \u0aa8\u0aa8\u0acb\u0a82\u0aa7\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0acd\u0aaf\u0aab\u0acb \u0aa8 \u0ab9\u0aab\u0acb\u0ab5\u0ab5\u0abe\u0aa5\u0aac\u0ac0,  \u0a85\u0aae\u0ab5\u0abe\u0ab0\u0aab\u0acb \u0aae\u0aa4 \u0a9b\u0ab9\u0ac7 \u0a95\u0ab9\u0ac7 \u0a89\u0a9a\u0acd\u0a9a \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0ab9\u0ac7 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0ab9\u0ac7\n8\n\n\u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aaa\u0ab7\u0acd\u0a9f\u0aaa\u0aa3\u0ab9\u0ac7 \u0aad\u0a95\u0ab2 \u0a95\u0ab0\u0aac\u0ac0 \u0a9b\u0ab9\u0ac7 \n\u0ae7\u0aee.   \u0a89\u0aaa\u0ab0\u0aab\u0acb\u0a95\u0acd\u0aa4 \u0ab9\u0a95\u0aac\u0ac0\u0a95\u0aa4\u0aab\u0acb \u0a85\u0aa8\u0ab9\u0ac7 \u0ab8\u0aae\u0abe\u0a82\u0a9c\u0acb\u0a97\u0aab\u0acb\u0aa8\u0ab9\u0ac7 \u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab5\u0abe\u0a96\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0a85\u0aa8\u0ab9\u0ac7 \u0aaa\u0acd\u0ab0\u0ab5\u0aa4\u0ab5\u0ab5\u0abe\u0aa6\u0aac\u0ac0-\n\u0a86\u0ab0\u0aab\u0acb\u0aaa\u0aac\u0ac0\u0aa8\u0aac\u0ac0 \u0aad\u0a95\u0ab5\u0aae\u0a95\u0ab5\u0abe \u0a85\u0aa8\u0ab9\u0ac7 \u0aa4\u0ab9\u0ac7\u0aa8\u0ab9\u0ac7 \u0a9c\u0abe\u0aae\u0aac\u0ac0\u0aa8 \u0aaa\u0ab0 \u0a97\u0ab9\u0ac7\u0ab0\u0a95\u0ab5\u0abe\u0aaf\u0aa6\u0ab9\u0ac7\u0ab8\u0ab0 \u0ab0\u0aac\u0ac0\u0aa4\u0ab9\u0ac7 \u0a9b\u0aab\u0acb\u0aa1\u0abf\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab9\u0ac7\u0ab2\u0aac\u0ac0\n\u0aac\u0ab5\u0abe\u0aac\u0aa4\u0aa8\u0ab9\u0ac7 \u0aa7\u0acd\u0aaf\u0ab5\u0abe\u0aa8\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab0\u0ab5\u0abe\u0a96\u0aac\u0ac0\u0aa8\u0ab9\u0ac7 \u0a86 \u0ab8\u0ab5\u0abe\u0aa5\u0ab9\u0ac7 \u0a85\u0ab2\u0acd\u0ab9\u0ab5\u0abe\u0aac\u0ab5\u0abe\u0aa6 \u0a89\u0a9a\u0acd\u0a9a \u0a85\u0aa6\u0ab5\u0abe\u0ab2\u0aa4\u0aa8\u0ab5\u0abe \u0aa4\u0ab5\u0abe\u0ab0\u0aac\u0ac0\u0a96\n\u0ae7\u0aed/\u0ae7\u0ae6/\u0ae8\u0ae6\u0ae8\u0ae8 \u0aa8\u0ab5\u0abe \u0ab0\u0aab\u0acb\u0a9c\u0aa8\u0ab5\u0abe \u0a86\u0a95\u0acd\u0ab7\u0abf\u0ab9\u0ac7\u0ab5\u0aaa\u0aa4 \u0a85\u0aae\u0abe\u0a82\u0ab5\u0aa4\u0aae \u0a86\u0aa6\u0ab9\u0ac7\u0ab6\u0aa8\u0ab9\u0ac7 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab9\u0ac7 \u0a9b\u0ab9\u0ac7\n\u0a85\u0aa8\u0ab9\u0ac7 \u0a85\u0aaa\u0aac\u0ac0\u0ab2\u0aa8\u0ab9\u0ac7 \u0aae\u0aae\u0abe\u0a82\u0a9c\u0a95\u0ab0 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab9\u0ac7 \u0a9b\u0ab9\u0ac7.\n\u0ae7\u0aef. \u0a85\u0aaa\u0aac\u0ac0\u0ab2 \u0aae\u0aae\u0abe\u0a82\u0a9c\u0a95\u0ab0 \u0a95\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab9\u0ac7 \u0a9b\u0ab9\u0ac7.\n\u0aa8\u0acd\u0aaf\u0ab5\u0abe\u0aaf\u0aae\u0a95\u0aa4\u0ab0\u0acd\u0aa4\u0ac0\u0ab6\u0aac\u0ac0 [\u0ab5\u0aac\u0ac0. \u0ab0\u0ab5\u0abe\u0aae\u0ab8\u0a95\u0aac\u0acd\u0ab0\u0aae\u0aa3\u0acd\u0aaf\u0aae] ...................................\n \u0aa8\u0acd\u0aaf\u0ab5\u0abe\u0aaf\u0aae\u0a95\u0aa4\u0ab0\u0acd\u0aa4\u0ac0\u0ab6\u0aac\u0ac0  [\u0aaa\u0aae\u0abe\u0a82\u0a95\u0a9c \u0ab5\u0aae\u0aa4\u0acd\u0aa4\u0ab2] ...................................\n\u0aa8\u0ab5\u0aac\u0ac0 \u0aa1