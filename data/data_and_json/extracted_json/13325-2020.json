    "full_text": "\u0905\u092a\u094d\u0930\u0924\u093f\u0935\u0947\u0926\u094d\u092f  \n\u092d\u093e\u0930\u093f\u0940\u092f \u0938\u0935\u094b\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0931\u092f \n\u092b\u094c\u091c\u0926\u093e\u0930\u0940 \u0905\u092a\u0940\u0931\u0940\u092f \u0905\u0927\u093f\u0915\u093e\u0930\u0930\u093f\u093e  \n \n\u092b\u094c\u091c\u0926\u093e\u0930\u0940 \u0905\u092a\u0940\u0931 \u0938\u0902\u0916\u094d\u092f\u093e 562/2020  \n(\u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u093f \u092f\u093e\u091a\u093f\u0915\u093e (\u092b\u094c\u091c\u0926\u093e\u0930\u0940) \u0938\u094a 2942/2020 \u0938\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928) \n \n\u0930\u093e\u0918\u093f \u0917\u0941\u092a\u094d\u093f\u093e                                           ....\u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940(\u0917\u0923) \n \n\u092c\u0928\u093e\u092e  \n\u0930\u093e\u091c\u094d\u092f (\u0930\u093e.\u0930\u093e.\u093a\u0947.) \u0914\u0930 \u0905\u0928\u094d\u092f                                .....\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940(\u0917\u0923) \n \n\u0924\u093f\u0930\u094d\u0923\u092f  \n \n\u0928\u094d\u092f\u093e., \u093f\u0935\u0940\u093f \u0938\u0938\u0928\u094d\u0939\u093e  \n \n \u0905\u0928\u0941\u092e\u0924\u093f \u092a\u094d\u0930\u0926\u093e\u0924\u0928\u093f|\n \n2. \u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940 \u0928\u0947 \u0916\u093e\u0926\u094d\u092f \u0905\u092a\u092e\u092e\u0936\u094d\u0930\u0923 \u0924\u0928\u093f\u093e\u0930\u0923 \u0905\u091a\u093f\u0924\u0928\u092f\u092e, 1954 (\u0938\u094a\u0915\u094d\u0937\u093a\u092a\u094d\u093f \u092e\u0947\u0902 \n\u201c\u0905\u091a\u093f\u0924\u0928\u092f\u092e\u201d) \u0915\u0947 \u0905\u094a\u093f\u0917\u0917\u093f \u0917\u0920\u093f\u093f \u0916\u093e\u0926\u094d\u092f \u0905\u092a\u092e\u092e\u0936\u094d\u0930\u0923 \u0924\u0928\u093f\u093e\u0930\u0923 \u0924\u0928\u092f\u092e, 1955 (\u0907\u0938\u0915\u0947 \n\u092c\u093e\u0926 \u201c\u0924\u0928\u092f\u092e\u201d \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948) \u0915\u0947 \u0924\u0928\u092f\u092e 32(\u0908) \u0915\u0947 \u0905\u094a\u093f\u0917\u0917\u093f \u0905\u092a\u0928\u0947 \u0905\u092e\u092d\u092f\u094b\u091c\u0928 \u092a\u093a \u0938\u0947 \n\u092a\u094d\u0930\u0936\u094d\u0928 \u0915\u0915\u092f\u093e \u0939\u0948| \n3. \u0939\u092e\u0928\u0947 \u092a\u093a\u0917\u0923 \u0915\u0947 \u095e\u093e\u095b\u093f\u0931 \u0905\u091a\u093f\u093f\u0915\u094d\u093f\u093e \u0915\u094b \u0935\u093f\u0938\u094d\u093f\u093e\u0930 \u0938\u0947 \u0938\u0941\u0928\u093e \u0939\u0948| \u0939\u093e\u0931\u093e\u0949\u0915\u0915 \n\u0905\u092e\u092d\u092f\u094b\u091c\u0928 \u092a\u093a \u0915\u094b \u093f\u0941\u0928\u094c\u093f\u0940 \u0926\u0947\u0928\u0947 \u0915\u0947 \u092e\u0931\u090f \u0915\u0908 \u0906\u093f\u093e\u0930 \u0906\u0917\u094d\u0930\u0939 \u0915\u0915\u090f \u0917\u090f \u0939\u0948\u0902, \u0939\u092e \n\u0938\u094a\u093f\u0941\u0937\u094d\u091f \u0939\u0948\u0902 \u0915\u0915 \u0905\u092a\u0940\u0931 \u0915\u093e \u0924\u0928\u092a\u091f\u093e\u0928 \u090f\u0915\u0931 \u0924\u0928\u0935\u093f\u0917\u093f\u093e\u0926 \u0906\u093f\u093e\u0930 \u092a\u0930 \u0915\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u093f\u093e \u0939\u0948| \n\u0907\u0938\u092e\u0931\u090f \u093f\u0925\u094d\u092f\u094b\u0902 \u0915\u093e \u093f\u0923\u0917\u0928 \u093f\u093f\u0917\u092e\u093e\u0928 \u0906\u0926\u0947\u0936 \u0915\u0947 \u092a\u094d\u0930\u092f\u094b\u091c\u0928\u094b\u0902 \u0939\u0947\u093f\u0941 \u090f\u0915 \u0906\u093f\u0936\u094d\u092f\u0915 \u0938\u0940\u092e\u093e \u093f\u0915 \n\u0938\u094a\u0915\u094d\u0937\u093a\u092a\u094d\u093f\u093f\u093e \u0938\u0947 \u0915\u0915\u092f\u093e \u091c\u093e\u090f|  \n\n4. \u0916\u093e\u0926\u094d\u092f \u0924\u0928\u0930\u0940\u093a\u0915 \u0928\u0947 03.05.2011 \u0915\u094b \u0938\u094d\u0928\u0948\u092a\u094d\u0931 \u091c\u0942\u0938 \u0921\u094d\u0930\u094a\u0915 \u0915\u0947 \u0938\u0940\u0931 \u0928\u092e\u0942\u0928\u0947 \n\u0935\u093f\u0936\u094d\u0931\u0947\u0937\u0923 \u0939\u0947\u093f\u0941 \u0916\u0930\u0940\u0926\u0947 \u0930\u094d\u0925\u0947| \u0931\u094b\u0915 \u0935\u093f\u0936\u094d\u0931\u0947\u0937\u0915 \u0915\u0940 \u0920\u0926\u0928\u093e\u094a\u0915 30.05.2011 \u0915\u0940 \u0906\u0916\u094d\u092f\u093e \u0928\u0947 \n\u092f\u0939 \u092c\u093f\u093e\u092f\u093e \u0915\u0915 \u0928\u092e\u0942\u0928\u093e \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0930\u0942\u092a \u0930\u094d\u0925\u093e, \u0931\u0947\u0915\u0915\u0928 \u0924\u0928\u092f\u092e 32(\u0908) \u0915\u0947 \u0909\u0932\u094d\u0931\u094a\u0918\u0928 \u092e\u0947\u0902 \n\u0931\u0949\u091f/\u092c\u0948\u093f \u0938\u094a\u0916\u094d\u092f\u093e\u0913\u094a \u091c\u0948\u0938\u0947 \u0906\u093f\u0936\u094d\u092f\u0915 \u092c\u094d\u092f\u094c\u0930\u094b\u0902 \u0915\u0940 \u0915\u092e\u0940 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0909\u0938\u0947 \u0917\u0931\u093f \u092c\u094d\u093e\u094a\u0921 \u0920\u0926\u092f\u093e \n\u0917\u092f\u093e| \u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940 \u0915\u094b \u092e\u0948\u0938\u0938\u0917 \u093f\u0940 \u090f\u093f\u094a \u093f\u0940 \u092c\u0947\u093f\u0930\u0947\u095b\u091c\u093f \u092a\u094d\u0930\u093e\u0907\u093f\u0947\u091f \u092e\u0931\u092e\u092e\u091f\u0947\u0921 \u0915\u0947 \u0924\u0928\u0926\u0947\u0936\u0915\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \n\u090f\u0915 \u092c\u093f\u093e\u092f\u093e \u0917\u092f\u093e \u095b\u091c\u0928\u094d\u0939\u094b\u0902\u0928\u0947\u0902 \u0935\u093f\u0926\u0947\u0936\u0940 \u0924\u0928\u092e\u093e\u0917\u093f\u093e \u0936\u094d\u093f\u0947\u092a\u094d\u092a\u0947\u0938 \u0907\u094a\u091f\u0930\u0928\u0947\u0936\u0928\u0931 \u0930\u093e\u0908 \u092c\u094d\u0942\u0915 \u0938\u0947 \u0921\u094d\u0930\u094a\u0915 \n\u0906\u092f\u093e\u093f \u0915\u0915\u092f\u093e \u0930\u094d\u0925\u093e, \u095b\u091c\u0938\u0947 \u0915\u0938\u094d\u091f\u092e \u0935\u093f\u092d\u093e\u0917 \u0926\u094d\u093f\u093e\u0930\u093e \u092f\u0930\u094d\u0925\u093e\u093f\u093f \u092e\u094a\u093f\u0942\u0930\u0940 \u0926\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940| \n5. \u0920\u0926\u0928\u093e\u094a\u0915 30.05.2011 \u0915\u0940 \u0906\u0916\u094d\u092f\u093e \u0915\u0947 \u0906\u093f\u093e\u0930 \u092a\u0930 \u0916\u093e\u0926\u094d\u092f \u0924\u0928\u0930\u0940\u093a\u0915 \u0926\u094d\u093f\u093e\u0930\u093e \n\u092a\u0930\u0930\u093f\u093e\u0926 \u0905\u092e\u092d\u092f\u094b\u0917 \u0938\u094a. 4/2012 \u0926\u093f\u0917 \u0915\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e| \u0926\u094a\u0921 \u092a\u094d\u0930\u0915\u093f\u092f\u093e \u0938\u094a\u0920\u0939\u093f\u093e \u0915\u0940 \u093f\u093e\u0930\u093e \n251 \u0915\u0947 \u0905\u094a\u093f\u0917\u0917\u093f (\u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u2018\u0938\u094a\u0920\u0939\u093f\u093e\u2019 \u0915\u0939\u093e \u0917\u092f\u093e) \u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940 \u0915\u094b \u0928\u094b\u0920\u091f\u0938 \u091c\u093e\u0930\u0940 \u0915\u0915\u090f \n\u0917\u090f| \u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940 \u0928\u0947 \u0938\u094a\u0920\u0939\u093f\u093e \u0915\u0940 \u093f\u093e\u0930\u093e 294 \u0938\u0939\u092a\u0920\u093f\u093f \u0905\u091a\u093f\u0924\u0928\u092f\u092e \u0915\u0940 \u093f\u093e\u0930\u093e 192 \u0915\u0947 \n\u093f\u0939\u093f \u0905\u0928\u094d\u092f \u092c\u093e\u093f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0930\u094d\u0925 \u090f\u0915 \u0906\u093f\u0947\u0926\u0928 \u092c\u0916\u093e\u0917\u0938\u094d\u093f\u0917\u0940 \u0939\u0947\u093f\u0941 \u0907\u0938 \u0906\u093f\u093e\u0930 \u092a\u0930 \u092a\u094d\u0930\u0938\u094d\u093f\u0941\u093f \u0915\u0915\u092f\u093e \n\u0915\u0915 \u0909\u0924\u094d\u092a\u093e\u0926 \u092a\u0930 \u0906\u093f\u0936\u094d\u092f\u0915 \u092c\u093e\u0930\u0915\u094b\u0921 \u0930\u094d\u0925\u093e \u0914\u0930 \u095b\u091c\u0938\u092e\u0947\u0902 \u0924\u0928\u092f\u092e 32(\u0908) \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0938\u092d\u0940 \n\u0909\u091a\u093f\u093f \u0906\u093f\u0936\u094d\u092f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091c\u0948\u0938\u0947 \u0915\u0915 \u092c\u0948\u093f \u0938\u094a./\u0915\u094b\u0921 \u0938\u094a./\u0931\u0949\u091f \u0938\u094a. \u0924\u0928\u0920\u0939\u093f \u0930\u094d\u0925\u0947| \u0906\u093f\u0947\u0926\u0928 \n\u0916\u093e\u0930\u0930\u091c \u0939\u094b\u0928\u0947 \u092a\u0930 \u0905\u092a\u0940\u0931\u0915\u093f\u093e\u0917 \u0928\u0947 \u0909\u091a\u094d\u093f \u0928\u094d\u092f\u093e\u092f\u093e\u0931\u092f \u0915\u0947 \u0938\u092e\u093a \u092f\u0939\u0940 \u0906\u093f\u093e\u0930 \u0930\u0916\u093e \u0930\u094d\u0925\u093e \u0914\u0930 \n\u0909\u091a\u094d\u093f \u0928\u094d\u092f\u093e\u092f\u093e\u0931\u092f \u092d\u0940 \u0909\u0938 \u092a\u0930 \u0935\u093f\u093f\u093e\u0930 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0931 \u0930\u0939\u093e| \n6. \u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u092e\u0931\u090f \u0909\u092a\u095b\u0938\u094d\u0930\u094d\u0925\u093f \u095e\u093e\u095b\u093f\u0931 \u093f\u0930\u0930\u0937\u094d\u093f \u0905\u091a\u093f\u093f\u0915\u094d\u093f\u093e \u0938\u0941\u0936\u094d\u0930\u0940 \u0917\u0940\u093f\u093e \u0931\u0942\u0930\u094d\u0925\u0930\u093e \u0928\u0947 \n\u0939\u092e\u093e\u0930\u0947 \u0938\u092e\u093a \u092a\u094d\u0930\u0938\u094d\u093f\u0941\u093f \u0915\u0915\u092f\u093e \u0914\u0930 \u095b\u091c\u0938\u0915\u093e \u092a\u094d\u0930\u0924\u093f\u0935\u093f\u0930\u094b\u093f \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \u0915\u0947 \u092e\u0931\u090f \u0909\u092a\u095b\u0938\u094d\u0930\u094d\u0925\u093f \n\n\u095e\u093e\u095b\u093f\u0931 \u0905\u0924\u093f\u0930\u0930\u0915\u094d\u093f \u0938\u0949\u092e\u0931\u092e\u0938\u091f\u0930 \u091c\u0928\u0930\u0931, \u0936\u094d\u0930\u0940 \u091c\u092f\u094a\u093f \u0915\u0947. \u0938\u0942\u0926 \u0926\u094d\u093f\u093e\u0930\u093e \u0928\u0939\u0940\u094a \u0915\u0915\u092f\u093e \u091c\u093e \n\u0938\u0915\u093e \u0915\u0915 \u0924\u0928\u092f\u092e 32(\u0908) \u0915\u0947 \u093f\u0939\u093f \u0906\u093f\u0936\u094d\u092f\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092c\u093e\u0930\u0915\u094b\u0921 \u092e\u0947\u0902 \u0909\u092a\u0931\u092c\u094d\u093f \u0930\u094d\u0925\u0940 \u091c\u094b \n\u0915\u0915 \u090f\u0915 \u092c\u093e\u0930\u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928\u0930 \u0926\u094d\u093f\u093e\u0930\u093e \u092a\u093f\u093e \u0931\u0917\u093e\u0908 \u091c\u093e \u0938\u0915\u093f\u0940 \u0930\u094d\u0925\u0940| \n7. \u092f\u0939 \u0935\u093f\u093f\u093e\u0926 \u0928\u0939\u0940\u094a \u0939\u0948 \u0915\u0915 \u092c\u093e\u0930\u0915\u094b\u0921 \u0928\u092e\u0942\u0928\u0947 \u092a\u0930 \u0909\u092a\u0931\u092c\u094d\u093f \u0930\u094d\u0925\u093e| \u0907\u0938 \u093f\u0925\u094d\u092f \u0915\u0947 \n\u092e\u0926\u094d\u0926\u0947\u0928\u093f\u0930 \u0915\u0915 \u0924\u0928\u092f\u092e 32(\u0908) \u0915\u0947 \u0905\u094a\u093f\u0917\u0917\u093f \u0909\u091a\u093f\u093f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091c\u094b \u0931\u0949\u091f/\u0915\u094b\u0921/\u092c\u0948\u093f \u0915\u0940 \n\u092a\u0939\u093f\u093e\u0928 \u0915\u0947 \u0938\u094a\u0926\u092d\u0917 \u092e\u0947\u0902 \u0939\u0948\n, \u095b\u091c\u0938\u0938\u0947 \u0924\u0928\u092e\u093e\u0917\u093f\u093e \u093f\u0915 \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u092a\u0939\u0941\u0949\u093f\u093e \u091c\u093e \u0938\u0915\u0947\n, \u093f\u0939 \n\u092c\u093e\u0930\u0915\u094b\u0921 \u092e\u0947\u0902 \u0909\u092a\u0931\u092c\u094d\u093f \u0939\u0948 \u0914\u0930 \u095b\u091c\u0938\u0947 \u092c\u093e\u0930\u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928\u0930 \u0926\u094d\u093f\u093e\u0930\u093e \u0921\u094d\u0921\u0915\u094b\u0921 \u0915\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u093f\u093e \n\u0939\u0948, \u0939\u092e \u0907\u0938 \u0935\u093f\u093f\u093e\u0930 \u0938\u0947 \u0938\u0939\u092e\u093f \u0939\u0948\u0902 \u0915\u0915 \u093f\u093f\u0917\u092e\u093e\u0928 \u0905\u092e\u092d\u092f\u094b\u091c\u0928 \u0915\u094b \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0940 \n\u0938\u094d\u093f\u0940\u0915\u0943\u0924\u093f \u0926\u0947\u0915\u0930 \u0915\u094b\u0908 \u0909\u092a\u092f\u094b\u0917\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u094a \u0915\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u093f\u093e \u0914\u0930 \u092f\u0939 \u0915\u093e\u0928\u0942\u0928 \n\u0915\u0940 \u092a\u094d\u0930\u0915\u093f\u092f\u093e \u0915\u093e \u0926\u0941\u0930\u0942\u092a\u092f\u094b\u0917 \u0939\u094b\u0917\u093e \u095b\u091c\u0938\u0938\u0947 \u0938\u092e\u092f \u0915\u0940 \u092c\u092c\u093e\u0917\u0926\u0940 \u0939\u094b\u0917\u0940 \u0914\u0930 \u095b\u091c\u0938\u0938\u0947 \u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940 \n\u0915\u094b \u0905\u0928\u093e\u093f\u0936\u094d\u092f\u0915 \u092a\u0930\u0947\u0936\u093e\u0928\u0940 \u0939\u094b\u0917\u0940 \u092f\u0920\u0926 \u0905\u092e\u092d\u092f\u094b\u091c\u0928 \u0915\u094b \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0940 \u0938\u094d\u093f\u0940\u0915\u0943\u0924\u093f \u0926\u0940 \n\u091c\u093e\u093f\u0940 \u0939\u0948| \n8. \u0907\u0938\u092e\u0931\u090f \u0939\u092e \u0905\u092a\u0940\u0931 \u0915\u094b \u0938\u094d\u093f\u0940\u0915\u0943\u0924\u093f \u0926\u0947\u093f\u0947 \u0939\u0948\u0902 \u0914\u0930 \u090f\u0938\u0940\u090f\u092e\u090f\u092e-2, \u092a\u0920\u091f\u092f\u093e\u0931\u093e \u0939\u093e\u0909\u0938 \n\u0915\u094b\u091f\u0917, \u0928\u0908 \u0920\u0926\u0932\u094d\u0931\u0940 \u0915\u0947 \u0938\u092e\u093a \u0931\u094a\u092c\u092c\u093f \u0938\u0940\u0938\u0940 \u0938\u094a. 04/2012 \u092e\u0947\u0902 \u0905\u092a\u0940\u0931\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0905\u092e\u092d\u092f\u094b\u091c\u0928 \n\u0915\u094b \u0905\u092e\u092d\u0916\u094a\u0921\u094d\u0921\u093f \u0915\u0930\u093f\u0947 \u0939\u0948\u0902| \u0905\u092a\u0940\u0931 \u0915\u094b \u0938\u094d\u093f\u0940\u0915\u0943\u093f \u0915\u0915\u092f\u093e \u091c\u093e\u093f\u093e \u0939\u0948| \n\u0928\u094d\u092f\u093e.,...................... \n[\u0906\u0930.\u090f\u092b.\u093f\u0930\u0940\u092e\u093f] \n \n\u0928\u094d\u092f\u093e.,...................... \n[\u093f\u0935\u0940\u093f \u0938\u0938\u0928\u094d\u0939\u093e] \n \n\n\u0928\u094d\u092f\u093e.,...................... \n[\u0907\u0902\u0926\u0926\u0930\u093e \u092c\u0948\u093f\u091c\u0940] \n\u0928\u0908 \u0920\u0926\u0932\u094d\u0931\u0940  \n04 \u092e\u0938\u093f\u092e\u094d\u092c\u0930, 2020     \n  \n\n\u0905\u0938\u094d\u093f\u0940\u0915\u0930\u0923:  \u0926\u0947\u0936\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0924\u0928\u0923\u0917\u092f \u0915\u093e \u0905\u0928\u0941\u093f\u093e\u0926 \u092e\u0941\u0915\u0926\u094d\u0926\u094d\u092e\u0947\u092c\u093e\u093f \u0915\u0947 \u0938\u0940\u092e\u092e\u093f \n\u092a\u094d\u0930\u092f\u094b\u0917 \u0939\u0947\u093f\u0941 \u0915\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u093f\u093e\u0915\u0915 \u093f\u094b \u0905\u092a\u0928\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0907\u0938\u0947 \n\u0938\u092e\u091d \u0938\u0915\u0947\u0902 \u090f\u093f\u094a \u092f\u0939 \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092f \u092a\u094d\u0930\u092f\u094b\u091c\u0928 \u0939\u0947\u093f\u0941 \u092a\u094d\u0930\u092f\u094b\u0917 \u0928\u0939\u0940\u094a \n\u0915\u0915\u092f\u093e \u091c\u093e\u090f\u0917\u093e| \u0938\u092e\u0938\u094d\u093f \u0915\u093e\u092f\u093e\u0917\u0931\u092f\u0940 \u090f\u093f\u094a \u0935\u094d\u092f\u093e\u093f\u0939\u093e\u0930\u0930\u0915 \u092a\u094d\u0930\u092f\u094b\u091c\u0928\u094b\u0902 \n\u0939\u0947\u093f\u0941 \u0924\u0928\u0923\u0917\u092f \u0915\u093e \u0905\u094a\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u094d\u093f\u0930\u0942\u092a \u0939\u0940 \u0905\u092e\u092d\u092a\u094d\u0930\u092e\u093e\u0923\u0923\u093f \u092e\u093e\u0928\u093e \n\u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0915\u093e\u092f\u093e\u0917\u0928\u094d\u093f\u092f\u0928 \u093f\u0930\u094d\u0925\u093e \u0931\u093e\u0917\u0942 \u0915\u0915\u090f \u091c\u093e\u0928\u0947 \u0939\u0947\u093f\u0941 \u0909\u0938\u0947 \u0939\u0940 \n\u093f\u0930\u0940\u092f\u093f\u093e \u0926\u0940 \u091c\u093e\u090f\u0917\u0940| \n \n"
}