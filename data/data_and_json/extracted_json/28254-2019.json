    "full_text": "\u092a\u094d\u0930\u0924\u093f\u0003\u0935\u0947\u0926\u094d\u092f\n\u092d\u093e\u0930\u0003 \u0915\u0947 \u0938\u0935\r\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902\n\u0938\u093f\u0938\u0935\u093f\u0935\u0932 \u0905\u092a\u0940\u0932\u0940\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924\u093f\u001b\u0915\u093e\u0930\n\u0938\u093f\u0938\u0935\u093f\u0935\u0932 \u0905\u092a\u0940\u0932 \u0938\u0902\u0916\u094d\u092f\u093e \n \n 6919/2021\n \n \n\u0905\u0935\u093f$\u0932 \u0915\u0941\u092e\u093e\u0930 \u0938\u094b\u0003\u0940 \u0914\u0930 \u0905\u0928\u094d\u092f\n..... \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940*(\u0917\u0923)\n\u092c$\u093e\u092e\n\u0915\u0932\u0947\u0915\u094d\u091f\u0930 \u0935\u093f\u092c\u091c$\u094c\u0930 (\u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936) \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947\n\u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \n.....\u2026\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940*(\u0917\u0923)\n\u0935\u093f$ \u0923< \u092f\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0003 \u090f\u092e\n \n .   \u0906\u0930\n \n .   \u0936\u093e\u0939\n \n \n1. \u092a\u094d\u0930\u0930\u094d\u0925\u0940\u092e \u0905\u092a\u0940\u0932 \u0938\u0902\u0916\u094d\u092f\u093e 440/1989 \u092e\u0947\u0902 \u0907\u0932\u093e\u0939\u093e\u092c\u093e\u0926 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003\n\u0935\u093f\u0915\u090f \u0917\u090f \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003 \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 16.04.2019 \u0935\u093f\u0926$\u093e\u0902\u0935\u093f\u0915\u0003 \u0938\u0947 \u0935\u094d\u092f\u0925\u093f\u0930\u094d\u0925\u0940\u0003 \u0914\u0930\n\u0905\u0938\u0902\u0003\u0941\u0937\u094d\u091f \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902,  \u0938\u093f\u091c\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0940\u0932\u0915\u0003\u093e<\u0913\u0902-\u092e\u0942\u0932 \u0926\u093e\u0935\u0947\u0926\u093e\u0930\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e\n\u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0909\u0915\u094d\u0924 \u0905\u092a\u0940\u0932 \u0915\u094b \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 \u0906\u0902\u0925\u093f\u0936\u0915 \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0935\u093f\u0915\u092f\u093e \u0939\u0948 \u0914\u0930\n\u0905\u0924\u093f\u001b\u0917\u0943\u0939\u0940\u0003 \u092d\u0942\u0935\u093f\u092e \u0915\u093e \u092c\u093e\u091c\u093e\u0930 \u092e\u0942\u0932\u094d\u092f \u0915\u0947\u0935\u0932 7,100/- \u0930\u0942\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0935\u093f$\u001b\u093e<\u0930\u093f\u0930\u0003\n\u0935\u093f\u0915\u092f\u093e \u0939\u0948, \u092e\u0942\u0932 \u092d\u0942\u0935\u093f\u092e \u092e\u093e\u0932\u093f\u0932\u0915\u094b\u0902 $\u0947 \u0935\u0003<\u092e\u093e$ \u0905\u092a\u0940\u0932 \u0915\u094b \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0940\u0935\u093f\u092e\u0915\u0003\u093e \u0926\u0940 \u0939\u0948\u0964\n2. \u092f\u0939 \u0935\u093f\u0915 \u0917\u094d\u0930\u093e\u092e \u0930\u0935\u093e\u0932\u0940 \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0003 \u0905\u092a\u0940\u0932\u0915\u0003\u093e<\u0913\u0902 \u0915\u0940 \u092d\u0942\u0935\u093f\u092e \u0938\u093e\u0935<\u091c\u0935\u093f$\u0915 \u092a\u094d\u0930\u092f\u094b\u091c$ \u0915\u0947\n\u0932\u093f\u0932\u090f \u0905\u0924\u093f\u001b\u0917\u0943\u0939\u0940\u0003 \u0915\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940\u0940\u0964\u092d\u0942\u0935\u093f\u092e \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e, 1894 (\u090f\u0003\u0938\u094d\u0925\u093f\u0938\u094d\u092e$\u094d \u092a\u0936\u094d\u091a\u093e\u0003\n\u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0902\u0926\u0930\u094d\u092d\u093f\u092d\u0003)  \u0915\u0940 \u001b\u093e\u0930\u093e 4  \u0915\u0947 \u0003\u0939\u0003 \u090f\u0915 \u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e \u0935\u093f\u0926$\u093e\u0902\u0915\n\u0909\u0926\u094d \u0918\u094b\u0937\u0923\u093e\n\u201c\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0905$\u0941\u0935\u093e\u0935\u093f\u0926\u0003 \u0935\u093f$\u0923<\u092f \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u092a$\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u092e\u091d$\u0947 \u0939\u0947\u0003\u0941 \u0935\u093f$\u092cf\u0924\u093f\u001b\u0003 \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u0932\u090f \u0939\u0948 \u0914\u0930 \u0935\u093f\u0915\u0938\u0940 \u0905\u0928\u094d\u092f\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u092f\u094b\u0917 $\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0003\u093e \u0939\u0948\u0964 \u0938\u092d\u0940 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0930\u0915 \u0914\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f, \u0935\u093f$\u0923<\u092f \u0915\u093e \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092a\u094d\u0930\u093e\u092e\u093e\u0925\u093f\u0923\u0915 \u092e\u093e$\u093e \u091c\u093e\u090f\u0917\u093e \u0003\u0930\u094d\u0925\u0940\u093e \u0935\u093f$\u0937\u094d\u092a\u093e\u0926$ \u0914\u0930 \u0935\u093fk\u092f\u093e\u0928\u094d\u0935\u092f$ \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0917\u093e\u0964\"\n\n16.05.1981 \u0915\u094b \u091c\u093e\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940\u0940\u0964\u092d\u0942\u0935\u093f\u092e \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0905\u0924\u093f\u001b\u0915\u093e\u0930\u0940 $\u0947 \u0930\u0941. 5,218.39/\n\u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0935\u093f$\u001b\u093e<\u0930\u0923 \u0935\u093f\u0915\u092f\u093e\u0964\u0926\u093e\u0935\u0947\u0926\u093e\u0930\u094b\u0902 \u0915\u0947 \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902 \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940 \u001b\u093e\u0930\u093e\n18 \u0915\u0947 \u0003\u0939\u0003 \u0938\u093f\u091c\u0932\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 12,000 \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0926\u093e\u0935\u093e\n\u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964\u0907\u0938 \u0938\u0902\u0926\u092d< \u092e\u0947\u0902 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 \u0905\u0928\u094d\u092f \u0938\u092d\u0940 \u0935\u0948\u001b\u093e\u0935\u093f$\u0915 \u0932\u093e\u092d\u094b\u0902 \u0915\u0947 \u0938\u093e\u0930\u094d\u0925\u0940\n\u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u094b 5,218.39 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0938\u0947 \u092c\u0922\u093c\u093e\u0915\u0930 6,696.70 \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0930\n\u0935\u093f\u0926\u092f\u093e,  \u091c\u094b \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0947 \u0003\u0939\u0003 \u0909\u092a\u0932\u092c\u094d\u001b \u0939\u094b \u0938\u0915\u0003\u093e \u0939\u0948\u0964 \u0905\u092a\u0940\u0932\u0915\u0003\u093e<\u0913\u0902 $\u0947 \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u0905\u092a\u0940\u0932 \u0926\u093e\u092f\u0930 \u0935\u093f\u0915\u092f\u093e\u0964\u0926\u093e\u0935\u0947\u0926\u093e\u0930\u094b\u0902 $\u0947 \u0917\u093e\u0902\u0935 \u0915\u0940 \u092d\u0942\u0935\u093f\u092e \u0915\u0947 \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0915\u0947\n\u0938\u0902\u092c\u0902\u001b \u092e\u0947\u0902 \u090f\u0915 \u0905\u0928\u094d\u092f \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0935\u093f$\u0923<\u092f \u0915\u0947\n\u0906\u001b\u093e\u0930 \u092a\u0930 15,402  \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0940 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0940<$\u093e \u0915\u0940,  \u0932\u0947\u0935\u093f\u0915$\n\u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940 \u001b\u093e\u0930\u093e 4 \u0915\u0947 \u0003\u0939\u0003 \u0935\u093f\u0926$\u093e\u0902\u0915 19.12.1981 \u0915\u094b \u091c\u093e\u0930\u0940 \u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e \u0915\u0947\n\u0938\u0902\u092c\u0902\u001b \u092e\u0947\u0902\u0964\u092f\u0939 \u0935\u093f\u0915 \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003 \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e \u0914\u0930 \u0935\u093f\u092ck\u0940 \u0935\u093f\u0935\u0932\u0947\u0916 \u0915\u093e\u092a\u0940\n\u0935\u093f\u0926$\u093e\u0902\u0915 23.12.1980 \u092a\u0930 \u0905\u0935\u0932\u092e\u094d\u092c \u0932\u093f\u0932\u092f\u093e \u0914\u0930 \u0935\u093f\u0935\u091a\u093e\u0930 \u0915\u0930\u0003\u0947 \u0939\u0941\u090f \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947\n\u0906\u0902\u0925\u093f\u0936\u0915 \u0930\u0942\u092a \u0938\u0947 \u0909\u0915\u094d\u0924 \u0905\u092a\u0940\u0932 \u0915\u0940 \u0905$\u0941\u092e\u0924\u093f\u0003 \u0926\u0940 \u0939\u0948 \u0914\u0930 \u0930\u0941. 7,100/\u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0940\n\u0926\u0930 \u0938\u0947 \u092e\u0941\u0906\u0935\u091c\u093e \u0935\u093f$\u001b\u093e<\u0930\u093f\u0930\u0003 \u0935\u093f\u0915\u092f\u093e \u0939\u0948\u0964\n3.  \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0940 \u0930\u093e\u0925\u093f\u0936 \u0915\u094b \u092c\u0922\u093c\u093e\u0915\u0930 \u0930\u0941. 7,100/-  \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0930$\u0947 \u092a\u0930,  \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003 \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0938\u0947 \u0935\u094d\u092f\u0925\u093f\u0930\u094d\u0925\u0940\u0003 \u0914\u0930 \u0905\u0938\u0902\u0003\u0941\u0937\u094d\u091f\n\u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0003\u0947 \u0939\u0941\u090f, \u0915\u0947\u0935\u0932 \u092e\u0942\u0932 \u0926\u093e\u0935\u0947\u0926\u093e\u0930\u094b\u0902 $\u0947 \u0935\u0003<\u092e\u093e$ \u0905\u092a\u0940\u0932 \u0915\u094b \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0940\u0935\u093f\u092e\u0915\u0003\u093e \u0926\u0940 \u0939\u0948\u0964\n4.  \u0905\u092a\u0940\u0932\u0915\u0003\u093e<\u0913\u0902 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u092a\u0947\u0936 \u0935\u093f\u0935\u0926\u094d\u0935\u093e$ \u0905\u0924\u093f\u001b\u0935\u0915\u094d\u0924\u093e-\u092e\u0942\u0932 \u0926\u093e\u0935\u0947\u0926\u093e\u0930\u094b\u0902 $\u0947 \u092a\u0941\u0930\u091c\u094b\u0930\n\u0003\u0930\u0940\u0915\u0947 \u0938\u0947 \u0915\u0939\u093e \u0935\u093f\u0915 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 \u0915\u0947\u0935\u0932 7,100 \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u093e \u092e\u0941\u0906\u0935\u091c\u093e\n\u0935\u093f$\u001b\u093e<\u0930\u093f\u0930\u0003 \u0915\u0930$\u0947 \u0914\u0930 \u0926\u0947$\u0947 \u092e\u0947\u0902 \u092d\u094c\u0924\u093f\u0003\u0915 \u0930\u0942\u092a \u0938\u0947 \u0917\u0932\u0003\u0940 \u0915\u0940 \u0939\u0948\u0964\n4.1 \u092f\u0939 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915 \u0917\u093e\u0901\u0935 \u0915\u0940 \u092d\u0942\u0935\u093f\u092e \u0915\u0947 \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0915\u0947 \u0932\u093f\u0932\u090f \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947\n15,402/- \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u0935\u093f\u0939\u0938\u093e\u092c \u0938\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0935\u093f$\u001b\u093e<\u0930\u0923 \u0914\u0930 \u0906\u0926\u0947\u0936\n\u0909\u0926\u094d \u0918\u094b\u0937\u0923\u093e\n\u201c\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0905$\u0941\u0935\u093e\u0935\u093f\u0926\u0003 \u0935\u093f$\u0923<\u092f \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u092a$\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u092e\u091d$\u0947 \u0939\u0947\u0003\u0941 \u0935\u093f$\u092cf\u0924\u093f\u001b\u0003 \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u0932\u090f \u0939\u0948 \u0914\u0930 \u0935\u093f\u0915\u0938\u0940 \u0905\u0928\u094d\u092f\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u092f\u094b\u0917 $\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0003\u093e \u0939\u0948\u0964 \u0938\u092d\u0940 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0930\u0915 \u0914\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f, \u0935\u093f$\u0923<\u092f \u0915\u093e \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092a\u094d\u0930\u093e\u092e\u093e\u0925\u093f\u0923\u0915 \u092e\u093e$\u093e \u091c\u093e\u090f\u0917\u093e \u0003\u0930\u094d\u0925\u0940\u093e \u0935\u093f$\u0937\u094d\u092a\u093e\u0926$ \u0914\u0930 \u0935\u093fk\u092f\u093e\u0928\u094d\u0935\u092f$ \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0917\u093e\u0964\"\n\n\u0935\u093f\u0926\u092f\u093e \u0932\u0947\u0935\u093f\u0915$ \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940 \u001b\u093e\u0930\u093e 4 \u0915\u0947 \u0003\u0939\u0003 \u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e \u0935\u093f\u0926$\u093e\u0902\u0915 19.12.1981\n\u0915\u094b \u091c\u093e\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940\u0940\u0964\u092f\u0939 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915 \u0909\u0938 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 \u0935\u0937<\n1978 \u0915\u0947 \u0935\u093f\u092ck\u0940 \u0935\u093f\u0935\u0932\u0947\u0916 \u092a\u0930 \u0905\u0935\u0932\u092e\u094d\u092c \u0932\u093f\u0932\u092f\u093e \u0914\u0930 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u092c\u093e\u091c\u093e\u0930\n\u092e\u0942\u0932\u094d\u092f 15,402/- \u0930\u0942\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u092a\u0930 \u0935\u093f$\u001b\u093e<\u0930\u093f\u0930\u0003 \u0935\u093f\u0915\u092f\u093e\u0964\u092f\u0939 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915 \u0909\u0938\n\u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0909\u0938 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\n\u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0905\u0924\u093f\u001b\u0935\u093f$\u0923<\u092f \u0915\u094b 15,402  \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u0935\u093f\u0939\u0938\u093e\u092c \u0938\u0947 \u0935\u093f$\u001b\u093e<\u0930\u093f\u0930\u0003\n\u0915\u0930$\u0947 \u0914\u0930 \u092e\u0941\u0906\u0935\u091c\u093e \u0926\u0947$\u0947 \u0915\u094b \u092c\u093e\u0926 \u092e\u0947\u0902 \u0935\u093e\u092a\u0938 \u0932\u0947 \u0932\u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u092f\u0939 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915\n\u0907\u0938\u0932\u093f\u0932\u090f \u0938\u0930\u0915\u093e\u0930 $\u0947 \u0909\u0938\u0940 \u0917\u093e\u0901\u0935 \u0915\u0947 \u0905\u0924\u093f\u001b\u0917\u0943\u0939\u0940\u0003 \u092d\u0942\u0935\u093f\u092e \u0915\u0947 \u0938\u0902\u092c\u0902\u001b \u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e\n\u092a\u093e\u0930\u093f\u0930\u0003 \u0935\u093f$\u0923<\u092f \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0932\u093f\u0932\u092f\u093e \u0939\u0948, \u0932\u0947\u0935\u093f\u0915$ \u0938\u093f\u091c\u0938\u0915\u0947 \u0932\u093f\u0932\u090f \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940 \u001b\u093e\u0930\u093e\n4 \u0915\u0947 \u0003\u0939\u0003 \u0935\u093f\u0926$\u093e\u0902\u0915 19.12.1981 \u0915\u094b \u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e \u091c\u093e\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940\u0940\u0964\u0907\u0938\u0932\u093f\u0932\u090f \u092f\u0939\n\u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u0915\u0003\u093e< 15,402/- \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0947 \u092d\u0940 \u0939\u0915\u0926\u093e\u0930\n\u0939\u0948\u0902\u0964\n5. \u092a\u094d\u0930\u0924\u093f\u0003\u0935\u093e\u0926\u0940 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u092a\u0947\u0936 \u0935\u093f\u0935\u0926\u094d\u0935\u093e$ \u0905\u0924\u093f\u001b\u0935\u0915\u094d\u0924\u093e-\u0930\u093e\u091c\u094d\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u0939 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915\n\u0935\u0003<\u092e\u093e$ \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 \u0935\u093f\u0926$\u093e\u0902\u0915 23.12.1980 \u0915\u0947 \u0935\u093f\u092ck\u0940 \u0935\u093f\u0935\u0932\u0947\u0916 \u092a\u0930\n\u0935\u093f\u0935\u091a\u093e\u0930 \u0915\u0930\u0003\u0947 \u0939\u0941\u090f 7,100/-  \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u0935\u093f\u0939\u0938\u093e\u092c \u0938\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0938\u0939\u0940\n\u0935\u093f$\u001b\u093e<\u0930\u0923 \u0935\u093f\u0915\u092f\u093e \u0939\u0948, \u0938\u093f\u091c\u0938\u0947 \u092d\u0942\u0935\u093f\u092e \u0915\u0947 \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0915\u0940 \u0924\u093f\u0003\u0925\u093f\u0930\u094d\u0925\u0940 \u0915\u0947 \u0905$\u0941\u092e\u093e\u0935\u093f$\u0003 /\u0935\u093f$\u0915\u091f\u0938\u094d\u0930\u094d\u0925\u0940\n\u0915\u0939\u093e \u091c\u093e \u0938\u0915\u0003\u093e \u0939\u0948\u0964\u0907\u0938\u0932\u093f\u0932\u090f \u092f\u0939 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915 \u092d\u093e\u0930\u0003 \u0915\u0947 \u0938\u0902\u0935\u093f\u0935\u001b\u093e$ \u0915\u0947 \u0905$\u0941\u091a\u094d\u091b\u0947\u0926\n136 \u0915\u0947 \u0003\u0939\u0003 \u0936\u0935\u093f\u0915\u094d\u0924 \u0915\u0947 \u092a\u094d\u0930\u092f\u094b\u0917 \u092e\u0947\u0902 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0939\u0938\u094d\u0003\u0915\u094d\u0937\u0947\u092a \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0003\u093e $\u0939\u0940\u0902\n\u0939\u0948\u0964\n6. \u0939\u092e$\u0947 \u0938\u0902\u092c\u0902\u0924\u093f\u001b\u0003 \u092a\u0915\u094d\u0937\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f \u0909\u092a\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0003 \u0935\u093f\u0935\u0926\u094d\u0935\u093e$ \u0905\u0924\u093f\u001b\u0935\u0915\u094d\u0924\u093e \u0915\u094b \u0935\u093f\u0935\u0938\u094d\u0003\u093e\u0930 \u0938\u0947 \u0938\u0941$\u093e\u0964\n7. \u092a\u094d\u0930\u093e\u0930\u092e\u094d\u092d \u092e\u0947\u0902, \u092f\u0939 \u0927\u094d\u092f\u093e$ \u0935\u093f\u0926\u092f\u093e \u091c\u093e$\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948 \u0914\u0930 \u092f\u0939 \u0935\u093f$\u0930\u094d\u0935\u093f\u0935\u0935\u093e\u0926 \u0939\u0948 \u0935\u093f\u0915 \u0935\u0003<\u092e\u093e$\n\u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940 \u001b\u093e\u0930\u093e 4 \u0915\u0947 \u0003\u0939\u0003 \u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e \u0935\u093f\u0926$\u093e\u0902\u0915 16.05.1981 \u0915\u094b\n\u0909\u0926\u094d \u0918\u094b\u0937\u0923\u093e\n\u201c\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0905$\u0941\u0935\u093e\u0935\u093f\u0926\u0003 \u0935\u093f$\u0923<\u092f \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u092a$\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u092e\u091d$\u0947 \u0939\u0947\u0003\u0941 \u0935\u093f$\u092cf\u0924\u093f\u001b\u0003 \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u0932\u090f \u0939\u0948 \u0914\u0930 \u0935\u093f\u0915\u0938\u0940 \u0905\u0928\u094d\u092f\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u092f\u094b\u0917 $\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0003\u093e \u0939\u0948\u0964 \u0938\u092d\u0940 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0930\u0915 \u0914\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f, \u0935\u093f$\u0923<\u092f \u0915\u093e \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092a\u094d\u0930\u093e\u092e\u093e\u0925\u093f\u0923\u0915 \u092e\u093e$\u093e \u091c\u093e\u090f\u0917\u093e \u0003\u0930\u094d\u0925\u0940\u093e \u0935\u093f$\u0937\u094d\u092a\u093e\u0926$ \u0914\u0930 \u0935\u093fk\u092f\u093e\u0928\u094d\u0935\u092f$ \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0917\u093e\u0964\"\n\n\u091c\u093e\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0939\u0948 \u0938\u093f\u091c\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0935\u093f$\u001b\u093e<\u0930\u0923 7,100\n\u0930\u0942\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0935\u093f\u0915\u092f\u093e \u0939\u0948\u0964\u0939\u093e\u0932\u093e\u0902\u0935\u093f\u0915, \u092f\u0939 \u0927\u094d\u092f\u093e$ \u0935\u093f\u0926\u092f\u093e \u091c\u093e$\u093e \u091a\u093e\u0935\u093f\u0939\u090f \u0935\u093f\u0915 \u0909\u0938\u0940 \u0917\u093e\u0902\u0935 \u0915\u0940\n\u0905\u0924\u093f\u001b\u0917\u0943\u0939\u0940\u0003 \u092d\u0942\u0935\u093f\u092e \u0915\u0947 \u0938\u0902\u092c\u0902\u001b \u092e\u0947\u0902 \u0938\u093f\u091c\u0938\u0915\u0947 \u0932\u093f\u0932\u090f \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940 \u001b\u093e\u0930\u093e 4  \u0915\u0947 \u0003\u0939\u0003\n\u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e \u0935\u093f\u0926$\u093e\u0902\u0915 19.12.1981 \u0915\u094b \u091c\u093e\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940\u0940 \u0938\u093f\u091c\u0938\u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947\n\u090f\u0915 \u0905\u0928\u094d\u092f \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 15,402 \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u0935\u093f\u0939\u0938\u093e\u092c \u0938\u0947 \u092e\u0941\u0906\u0935\u091c\u093e \u0935\u093f$\u001b\u093e<\u0930\u093f\u0930\u0003\n\u0935\u093f\u0915\u092f\u093e\u096415,402 \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u0935\u093f\u0939\u0938\u093e\u092c \u0938\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0935\u093f$\u001b\u093e<\u0930\u0923 \u0915\u0930$\u0947 \u0935\u093e\u0932\u0947\n\u090f\u0915 \u0905\u0928\u094d\u092f \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0935\u093f$\u0923<\u092f \u0915\u0947 \u092c\u093e\u0926 (\u091c\u094b \u0935\u0003<\u092e\u093e$\n\u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0926\u093e\u0935\u0947\u0926\u093e\u0930\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092c\u0939\u0941\u0003 \u0905\u0924\u093f\u001b\u0915 \u0935\u093f$\u092d<\u0930 \u0939\u0948) \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 \u0935\u0937< 1978 \u0915\u0947\n\u0935\u093f\u092ck\u0940 \u0935\u093f\u0935\u0932\u0947\u0916 \u0915\u093e \u0909\u0926\u093e\u0939\u0930\u0923 \u092e\u093e$\u093e \u0930\u094d\u0925\u0940\u093e\u0964\u0907\u0938\u0932\u093f\u0932\u090f, \u0910\u0938\u093e $\u0939\u0940\u0902 \u0939\u0948 \u0935\u093f\u0915 \u090f\u0915 \u0905\u0928\u094d\u092f \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902\n\u0938\u093f\u091c\u0938 \u0935\u093f\u092ck\u0940 \u0935\u093f\u0935\u0932\u0947\u0916 \u092a\u0930 \u0905\u0935\u0932\u092e\u094d\u092c \u0932\u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0935\u0939 \u0935\u093f\u0926$\u093e\u0902\u0915 16.05.1981 (\u0935\u0003<\u092e\u093e$\n\u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u092d\u0942\u0935\u093f\u092e \u0915\u093e \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923)  \u0914\u0930 19.12.1981  (\u0935\u093f\u0915\u0938\u0940 \u0905\u0928\u094d\u092f \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902\n\u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0915\u0940 \u0003\u093e\u0930\u0940\u0916) \u0915\u0947 \u092c\u0940\u091a \u0915\u0940 \u0905\u0935\u0924\u093f\u001b \u0915\u0947 \u0932\u093f\u0932\u090f \u0930\u094d\u0925\u0940\u093e\u0964\u092c\u093e\u091c\u093e\u0930 \u092e\u0942\u0932\u094d\u092f/\u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e\n\u0935\u093f$\u001b\u093e<\u0930\u0923 \u0915\u0930\u0003\u0947 \u0938\u092e\u092f \u0915\u093e$\u0942$ \u0915\u0947 \u0938\u094d\u0930\u094d\u0925\u0940\u093e\u0935\u093f\u092a\u0003 \u092a\u0942\u0935<\u0938\u0917< \u0915\u0947 \u0905$\u0941\u0938\u093e\u0930,  \u0938\u094d\u0930\u094d\u0925\u0940\u093e$ \u0915\u0947 \u0932\u093f\u0932\u090f\n\u0935\u093f$\u0915\u091f\u0003\u093e \u092e\u0947\u0902 \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0915\u0947 \u0935\u093f\u092a\u091b\u0932\u0947 \u0909\u0926\u093e\u0939\u0930\u0923 \u0914\u0930 \u0938\u0902\u091a\u092f\u0940 \u0935\u0943\u0924\u093fy \u0915\u0947 \u0938\u093e\u0930\u094d\u0925\u0940 \u092d\u0942\u0935\u093f\u092e\n\u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0939\u0923 \u0915\u0940 \u0938\u0902\u092d\u093e\u0935$\u093e \u092a\u094d\u0930\u093e\u0938\u0902\u0935\u093f\u0917\u0915 \u0935\u093f\u0935\u091a\u093e\u0930 \u0939\u0948\u0964 \u0935\u0003<\u092e\u093e$ \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902,  \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940\n\u001b\u093e\u0930\u093e 4 \u0915\u0947 \u0003\u0939\u0003 \u0926\u094b \u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a \u0915\u093e \u0938\u092e\u092f \u0905\u0902\u0003\u0930\u093e\u0932 \u0915\u0947\u0935\u0932 \u0938\u093e\u0003 \u092e\u093e\u0939 \u0939\u0948\u0964\n\u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0940 \u001b\u093e\u0930\u093e 4 \u0915\u0947 \u0003\u0939\u0003 \u0926\u094b \u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e\u0913\u0902 \u0915\u0947 \u092c\u0940\u091a 16.05.1981 \u0914\u0930\n16.12.1981 \u0915\u0947 \u092c\u0940\u091a \u0915\u0940 \u0905\u0935\u0924\u093f\u001b \u0915\u0947 \u0932\u093f\u0932\u090f \u0935\u093f\u0915\u0938\u0940 \u092d\u0940 \u092d\u094c\u0924\u093f\u0003\u0915 \u092a\u0930\u093f\u0930\u0935\u0003<$ \u0915\u0947 \u0938\u0902\u092c\u0902\u001b \u092e\u0947\u0902\n\u0915\u0941\u091b \u092d\u0940 $\u0939\u0940\u0902 \u092c\u0003\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0935\u093f\u0935\u092a\u0930\u0940\u0003, \u0909\u0938\u0940 \u0917\u093e\u0902\u0935 \u0915\u0940 \u0905\u0924\u093f\u001b\u0917\u094d\u0930\u0935\u093f\u0939\u0003 \u092d\u0942\u0935\u093f\u092e \u0915\u0947\n\u0938\u0902\u092c\u0902\u001b \u092e\u0947\u0902 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0935\u093f$\u0923<\u092f \u0938\u093f\u091c\u0938\u0915\u0947 \u0932\u093f\u0932\u090f \u001b\u093e\u0930\u093e 4  \u0915\u0947 \u0003\u0939\u0003\n\u0905\u0924\u093f\u001b\u0938\u0942\u091a$\u093e 19.12.1981  \u0915\u094b \u091c\u093e\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940\u0940,  \u0915\u0947 \u092c\u093e\u0926 \u0938\u0902\u0926\u092d< \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947\n\u092e\u0941\u0906\u0935\u091c\u093e 15,402/-  \u0930\u0942\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0935\u093f$\u001b\u093e<\u0930\u093f\u0930\u0003 \u0935\u093f\u0915\u092f\u093e\u0964\u0909\u0938 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u092d<\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f $\u0947 1978 \u0915\u0947 \u0935\u093f\u092ck\u0940 \u0935\u093f\u0935\u0932\u0947\u0916 \u0909y\u0930\u0923 \u092a\u0930 \u0905\u0935\u0932\u092e\u094d\u092c \u0932\u093f\u0932\u092f\u093e\u096415,402 \u0930\u0941\u092a\u092f\u0947\n\u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c \u0915\u0947 \u092c\u093e\u091c\u093e\u0930 \u092e\u0942\u0932\u094d\u092f/\u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0935\u093f$\u001b\u093e<\u0930\u0923 \u0915\u0930$\u0947 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0938\u0902\u0926\u092d<\n\u0909\u0926\u094d \u0918\u094b\u0937\u0923\u093e\n\u201c\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0905$\u0941\u0935\u093e\u0935\u093f\u0926\u0003 \u0935\u093f$\u0923<\u092f \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u092a$\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u092e\u091d$\u0947 \u0939\u0947\u0003\u0941 \u0935\u093f$\u092cf\u0924\u093f\u001b\u0003 \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u0932\u090f \u0939\u0948 \u0914\u0930 \u0935\u093f\u0915\u0938\u0940 \u0905\u0928\u094d\u092f\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u092f\u094b\u0917 $\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0003\u093e \u0939\u0948\u0964 \u0938\u092d\u0940 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0930\u0915 \u0914\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f, \u0935\u093f$\u0923<\u092f \u0915\u093e \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092a\u094d\u0930\u093e\u092e\u093e\u0925\u093f\u0923\u0915 \u092e\u093e$\u093e \u091c\u093e\u090f\u0917\u093e \u0003\u0930\u094d\u0925\u0940\u093e \u0935\u093f$\u0937\u094d\u092a\u093e\u0926$ \u0914\u0930 \u0935\u093fk\u092f\u093e\u0928\u094d\u0935\u092f$ \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0917\u093e\u0964\"\n\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0915\u094b \u0905\u0902\u0924\u093f\u0003\u092e \u0930\u0942\u092a \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b \u0917\u092f\u093e \u0939\u0948 \u0930\u093e\u091c\u094d\u092f $\u0947\n\u0909\u0915\u094d\u0924 \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0905\u0924\u093f\u001b\u0935\u093f$\u0923<\u092f \u0915\u0947 \u0935\u093f\u0935\u0930\u0942y \u0905\u092a\u0940\u0932 \u0935\u093e\u092a\u0938 \u0932\u0947\u0003\u0947 \u0939\u0941\u090f \u0907\u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\n\u0932\u093f\u0932\u092f\u093e \u0939\u0948\u0964\u0907\u0938\u0932\u093f\u0932\u090f, \u0935\u0003<\u092e\u093e$ \u092a\u0930\u093f\u0930\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0924\u093f\u0003\u092f\u094b\u0902 \u092e\u0947\u0902, \u0905\u092a\u0940\u0932\u0915\u0003\u093e< 15,402 \u0930\u0941\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c\n\u0915\u0947 \u0935\u093f\u0939\u0938\u093e\u092c \u0938\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0947 \u0939\u0915\u0926\u093e\u0930 \u0939\u094b\u0902\u0917\u0947\u0964\n8. \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0915\u0947 \u092e\u0926\u094d\u0926\u0947$\u091c\u0930 \u0914\u0930 \u090a\u092a\u0930 \u092c\u0003\u093e\u090f \u0917\u090f \u0915\u093e\u0930\u0923\u094b\u0902 \u0915\u0947 \u092e\u0926\u094d\u0926\u0947$\u091c\u0930, \u0935\u0003<\u092e\u093e$ \u0905\u092a\u0940\u0932\n\u0938\u092b\u0932 \u0939\u094b\u0003\u0940 \u0939\u0948\u0964\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u093f\u0930\u0003 \u0932\u093e\u0917\u0942 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0935\u093f$\u0923<\u092f \u0914\u0930 \u0906\u0926\u0947\u0936\n\u0907\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u0936\u094b\u0924\u093f\u001b\u0003 \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u0003\u093e \u0939\u0948 \u0914\u0930 \u092f\u0939 \u0905\u0935\u001b\u093e\u0930\u093f\u0930\u0003 \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u0003\u093e \u0939\u0948 \u0935\u093f\u0915\n\u0905\u092a\u0940\u0932\u0915\u0003\u093e< \u0905\u0928\u094d\u092f \u0938\u092d\u0940 \u0935\u0948\u001b\u093e\u0935\u093f$\u0915 \u0932\u093e\u092d\u094b\u0902 \u0915\u0947 \u0938\u093e\u0930\u094d\u0925\u0940 15,402/- \u0930\u0942\u092a\u092f\u0947 \u092a\u094d\u0930\u0924\u093f\u0003 \u090f\u0915\u0921\u093c\n\u092d\u0942\u0935\u093f\u092e \u0915\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0947 \u0939\u0915\u0926\u093e\u0930 \u0939\u094b\u0902\u0917\u0947 \u091c\u094b \u0915\u092e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0936\u0941\u0932\u094d\u0915,  \u092f\u0935\u093f\u0926 \u0915\u094b\u0908 \u0939\u094b,  \u0915\u0947\n\u092d\u0941\u0917\u0003\u093e$ \u0915\u0947 \u0905\u001b\u0940$ \u0905\u0924\u093f\u001b\u0935\u093f$\u092f\u092e \u0915\u0947 \u0003\u0939\u0003 \u0909\u092a\u0932\u092c\u094d\u001b \u0939\u094b \u0938\u0915\u0003\u093e \u0939\u0948\u0964\u0003\u0926$\u0941\u0938\u093e\u0930 \u0935\u0003<\u092e\u093e$\n\u0905\u092a\u0940\u0932 \u0915\u094b \u0905$\u0941\u092e\u0924\u093f\u0003 \u0926\u0940 \u091c\u093e\u0003\u0940 \u0939\u0948\u0964\u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0003\u0925\u094d\u092f\u094b\u0902 \u0914\u0930 \u092a\u0930\u093f\u0930\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0924\u093f\u0003\u092f\u094b\u0902 \u092e\u0947\u0902 \u0932\u093e\u0917\u0003 \u0915\u0947\n\u0930\u0942\u092a \u092e\u0947\u0902 \u0915\u094b\u0908 \u0906\u0926\u0947\u0936 $\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964\n............................................\u2026\n(\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0003 \u090f\u092e. \u0906\u0930. \u0936\u093e\u0939)\n.............................................\u2026\n(\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0003 \u0938\u0902\u091c\u0940\u0935 \u0916\u0928\u094d\u0928\u093e)\n$\u0908 \u0935\u093f\u0926\u0932\u094d\u0932\u0940,\n23 $\u0935\u092e\u094d\u092c\u0930 2021\n\u0909\u0926\u094d \u0918\u094b\u0937\u0923\u093e\n\u201c\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0905$\u0941\u0935\u093e\u0935\u093f\u0926\u0003 \u0935\u093f$\u0923<\u092f \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u092a$\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0938\u092e\u091d$\u0947 \u0939\u0947\u0003\u0941 \u0935\u093f$\u092cf\u0924\u093f\u001b\u0003 \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0947 \u0932\u093f\u0932\u090f \u0939\u0948 \u0914\u0930 \u0935\u093f\u0915\u0938\u0940 \u0905\u0928\u094d\u092f\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u092f\u094b\u0917 $\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0003\u093e \u0939\u0948\u0964 \u0938\u092d\u0940 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0930\u0915 \u0914\u0930 \u0938\u0930\u0915\u093e\u0930\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f, \u0935\u093f$\u0923<\u092f \u0915\u093e \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092a\u094d\u0930\u093e\u092e\u093e\u0925\u093f\u0923\u0915 \u092e\u093e$\u093e \u091c\u093e\u090f\u0917\u093e \u0003\u0930\u094d\u0925\u0940\u093e \u0935\u093f$\u0937\u094d\u092a\u093e\u0926$ \u0914\u0930 \u0935\u093fk\u092f\u093e\u0928\u094d\u0935\u092f$ \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u0932\u090f \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0917\u093e\u0964\"\n"
}