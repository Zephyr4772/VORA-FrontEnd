    "full_text": "(1) \n \n \n\ue82d\ue838\ue83d\ue827\ue837\ue81d\ue8eb\ue83d\ue82c\ue837\ue815\ue8f6 \n \n\ue82b\ue837\ue826\ue8f6\ue829\ue82d \ue80b\ue87f\ue822\ue82b \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846 \n\ue833\ue838\ue82a\ue838\ue82e\ue841 \ue807\ue827\ue838\ue82e\ue841 \ue807\ue825\ue8ef\ue813\ue837\ue82d\ue838\ue822\ue837 \n\ue833\ue838\ue82a\ue838\ue82e\ue841 \ue807\ue827\ue838\ue82e\ue841 \ue826\ue805 \u2013 \ue850\ue84e\ue850\ue850/\ue84b\ue849\ue84a\ue852 \n\ue80f\ue833\ue841.\ue80f\ue82e\ue841.\ue827\ue838. (\ue833\ue838\ue82a\ue838\ue82e\ue841) \ue826\ue805 \u2013 \ue84b\ue84c\ue84b\ue850\ue852/\ue84b\ue849\ue84a\ue852\ue82d\ue83a \ue80b\ue824\ue841\ue82a\ue83b\ue822 \n\ue81f\ue837\ue809\ue82d\ue839 \ue826\ue805 \u2013 \ue84a\ue84c\ue84b\ue84e\ue84a/\ue84b\ue849\ue84a\ue850 \n \n\ue826\ue838\ue83d\ue8a3\ue8eb\ue831\ue813,  \n\ue90b\ue837\ue823\ue82b\ue838\ue813 \ue831\ue838\ue86f\ue837 \ue811\ue81f\ue838\ue831\ue837 \ue80f\ue829\ue805 \ue811\ue83d\ue815\ue82d\u2026\u2026\u2026\u2026\u2026.\u2026\u2026 \ue807\ue827\ue838\ue82e\ue841\ue813\ue837\ue82d\ue839 \n     \ue829\ue826\ue837\ue82b \n\ue90b\ue83d\ue82b\ue837\ue824 \ue813\ue83a\ue82b\ue837\ue82d \ue833\ue837\ue834\ue83a\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026.\u2026\u2026..... \ue90b\ue822\ue838\ue829\ue837\ue824\ue839 \n \n\ue82d\ue837\ue846  \n\ue82b\ue837\ue826\ue8f6\ue829\ue82d \ue826\ue8f6\ue837\ue846\ue82b\ue83b\ue895\ue8f1 \ue83d\ue834\ue82b\ue8ab \ue815\ue83a\ue8ba\ue837 \n \n \n\ue84a\ue858  \ue811\ue844\ue838\ue831\ue837 \ue90b\ue831\ue837\ue833\ue826\ue838\ue813 \ue826\ue8f6\ue837\ue846\ue837\ue825\ue8ef\ue813\ue82d\ue821\ue879 \ue83d\ue828\ue829\ue83c\ue846\ue837\ue82d\ue839 \ue84a\ue852, \ue84b\ue849\ue84a\ue849\ue82d \ue807\ue837\ue83d\ue824\ue831 \n\ue829\ue838\ue83d\ue82d\ue837\ue825\ue83d\ue82d \ue807\ue827\ue838\ue82e\ue841\ue813\ue837\ue82d\ue839\ue879  \ue8a6\ue837\ue82d\ue837 \ue824\ue837\ue846\ue82d \ue83d\ue834\ue837\ue809\ue823\ue8ef\ue829\ue837 \ue82d\ue838\ue81d\ue841 \ue827\ue838\ue81d\ue838\ue833\ue826\ue841 \ue82c\ue837\ue834\ue837 \ue82b\ue837\ue826\ue8f6\ue829\ue82d \n\ue811\ue844\ue838\ue831\ue837 \ue80b\ue87f \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846\ue879 \ue82b\ue837\ue87f\ue8eb \ue84c, \ue84b\ue849\ue84a\ue84f\ue82d \ue807\ue837\ue83d\ue824\ue831 \ue829\ue82f\ue83d\ue82d \ue807\ue833\ue828\ue82f \ue83d\ue834\ue82e\ue837, \n\ue822\ue837\ue834\ue837\ue813\ue83a \ue807\ue837\ue827\ue895\ue838 \ue813\ue82d\ue838 \ue829\ue895\ue8eb\ue82b\ue837\ue826 \ue807\ue827\ue838\ue82e\ue841 \ue822\ue837\ue82e\ue838\ue82b\ue841\ue90b\ue837\ue8ba  \ue809\ue88e\ue82d\ue83d\ue82b\ue81f\ue838\ue80f\ue81d\ue841 \ue807\ue837\ue81d\ue8eb\ue833 \ue831\ue838\ue86f\ue813\ue879\ue83a \n\ue81d.\ue84a\ue849\ue851\ue849:\ue849\ue849 \u2013\ue81d.\ue84a\ue851\ue849\ue849:\ue849\ue849 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \ue90b\ue824\ue837\ue826 \ue813\ue82d\ue838\ue829\ue837\ue813\ue83a \ue901\ue838\ue829\ue83a\ue826\ue837\ue82e\ue841 \ue826\ue838\ue83d\ue8a3\ue8eb\ue831 \n\ue83d\ue824\ue809\ue819\ue8ab\ue838 \ue858  \n\n(2) \n \n \n \n\ue84b\ue858  \ue827\ue838\ue822\ue837 \ue829\ue833\ue8ab \ue813\ue83a\ue82b\ue837\ue82d \ue833\ue837\ue834\ue83a\ue879 \ue82b\ue83c\ue822\ue83a\ue8f6\ue827\ue83d\ue82d \ue90b\ue822\ue838\ue829\ue837\ue824\ue839\ue879\ue83a \ue807\ue815\ue8d6 \ue84f, \ue84a\ue852\ue851\ue851\ue82d \ue827\ue83a\ue826\ue829\ue8eb\ue837\ue833 \n\ue833\ue834\ue837\ue846\ue822\ue837 \ue83d\ue82c\ue837\ue81a\ue826\ue837 \ue807\ue826\ue83a\ue82c\ue837\ue846\ue839 \ue826\ue838\ue82c\ue83a\ue86b\ue838 \ue824\ue838\ue807\ue837\ue82c\ue837\ue809 \ue823\ue8ef\ue82e\ue837 \ue858 \ue80b\ue86b \ue807\ue837\ue83d\ue824\ue831 \ue807\ue826\ue83a\ue82c\ue837\ue846\ue839 \n\ue81d.\ue850\ue851\ue849:\ue849\ue849-\ue81d.\ue84a\ue84a\ue84d\ue849:\ue849\ue849/- \ue83d\ue829\ue822\ue826 \ue834\ue837\ue82d \ue833\ue834\ue838\ue822 \ue8f9\ue834\ue821\ue839\ue846 \ue82b\ue834\ue87d\ue837 \ue82a\ue895\ue837\ue83d\ue82d \n\ue83d\ue833 \ue84a\ue849 \ue807\ue815\ue8d6, \ue84a\ue852\ue851\ue851\ue83d\ue82d \ue90b\ue837\ue823\ue82b\ue838\ue813 \ue829\ue838\ue824\ue8f6\ue837\ue82f\ue846 \ue831\ue838\ue86f\ue813 \ue82a\ue837\ue83d\ue829 \ue83d\ue82c\ue837\ue815\ue83d\ue824\ue83d\ue82e \ue858 \n\ue83d\ue833\ue834\ue838 \ue833\ue82b\ue846\ue83d\ue82d \ue90b\ue822\ue838\ue829\ue837\ue824\ue839 \ue809\ue88e\ue82d\ue82b\ue838\ue81f\ue838\ue80f\ue81d\ue841 \ue83d\ue82c\ue837\ue815\ue8f6\ue822\ue837 \ue90b\ue837\ue8ba \ue823\ue8ef\ue83d\ue82e \ue80f\ue829\ue805 \ue82b\ue837\ue901\ue838\ue813\ue841 \n\ue831\ue838\ue86f\ue813 \ue90b\ue82b\ue837\ue821\ue827\ue906 \ue827\ue824 \ue826\ue838\ue82b\ue83d\ue8ab \ue90b\ue837\ue823\ue82b\ue838\ue813 \ue829\ue838\ue824\ue8f6\ue837\ue82f\ue846 \ue831\ue838\ue86f\ue813 \ue82a\ue837\ue83d\ue829 \ue826\ue838\ue82c\ue83a\ue86b \ue83d\ue834\ue829\ue837 \n\ue833\ue82b\ue846\ue83d\ue82d \ue83d\ue833 \ue829\ue838.\ue80f. \ue827\ue82d\ue839\ue86f\ue837\ue83d\ue82d \ue80b\ue827\ue8e1\ue838\ue822 \ue83d\ue834\ue837\ue809\ue823\ue8ef\ue83d\ue82e \ue858 \ue80b\ue86b \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \ue82b\ue837\ue901\ue838\ue813 \n\ue83d\ue82c\ue837\ue815\ue8f6\ue822\ue837 \ue82d\ue814\ue8ef\ue823\ue8ef\ue829\ue837 \ue807\ue821\ue90b\ue831\ue838\ue86f\ue838\ue822 \ue831\ue838\ue86f\ue813 \ue82b\ue837\ue826\ue879 \ue83d\ue824\ue846 \ue83d\ue834\ue837\ue809\ue823\ue8ef\ue829\ue837 \ue8e1\ue83d\ue82f \ue90b\ue831\ue838\ue86f\ue838\ue822 \n\ue831\ue838\ue86f\ue813 \ue82b\ue837\ue826\ue879\ue82d \ue82b\ue889\ue83a\ue82d \ue83d\ue829\ue822\ue826 \ue834\ue837\ue82d \ue81d.\ue851\ue84d\ue849:\ue849\ue849 \u2013 \ue81d.\ue84a\ue84b\ue849\ue849:\ue849\ue849 \ue807\ue83d\ue81d \ue858    \n \n\ue84c\ue858 \ue811\ue844\ue838\ue831\ue837 \ue833\ue805\ue83d\ue831\ue837\ue825\ue8ef\ue822 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \ue826\ue838\ue846\ue82b \ue84a\ue852\ue851\ue852\ue83d\ue82d \ue833\ue805\ue83d\ue831\ue837\ue825\ue826 \ue807\ue837\ue821\ue838 \ue811\ue844\ue838\ue831\ue837 \n\ue833\ue82d\ue813\ue837\ue82d\ue879  \ue8a6\ue837\ue82d\ue837 \ue811\ue81f\ue838\ue831\ue837 \ue833\ue805\ue83d\ue831\ue837\ue825\ue8ef\ue822 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d (\ue833\ue805\ue83d\ue831\ue837\ue825\ue826) \ue826\ue838\ue846\ue82b, \ue84a\ue852\ue852\ue849 \n\ue83d\ue833\ue827\ue841\ue83d\ue81d\ue8c4\ue82d \ue84a\ue84b, \ue84a\ue852\ue852\ue849\ue83d\ue82d \ue90b\ue813\ue837\ue831\ue838\ue822 \ue83d\ue834\ue837\ue809\ue823\ue8ef\ue82e\ue837 \ue858 \ue827\ue83b\ue83d\ue829\ue837\ue8eb\ue86b \ue833\ue805\ue83d\ue831\ue837\ue825\ue826 \n\ue826\ue838\ue846\ue82b, \ue84a\ue852\ue852\ue849 \ue90b\ue831\ue838\ue86f\ue838\ue822 \ue82b\ue837\ue901\ue838\ue813\ue841 \ue831\ue838\ue86f\ue813 \ue80f\ue829\ue805 \ue807\ue821\ue90b\ue831\ue838\ue86f\ue838\ue822 \ue82b\ue837\ue901\ue838\ue813\ue841 \ue831\ue838\ue86f\ue813\ue879 \ue833\ue82b\ue8df \n\ue827\ue824\ue829\ue839 \ue826\ue838\ue82b\ue83d\ue8ab \ue80f\ue813 \ue827\ue83c\ue823\ue813\ue841 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \ue826\ue838\ue8a4\ue837\ue8eb\ue82d\ue838\ue822 \ue813\ue82e\ue837 \ue858 \ue90b\ue837\ue833\ue87d\ue838\ue813 \ue829\ue837\ue813\ue8f6\ue837\ue805\ue831 \ue826\ue838\ue82b\ue931 \n\ue82b\ue83d\ue822 \ue90b\ue824\ue895 :- \n \n \n\u2018\u2018\ue84f- \ue80b\ue86b \ue826\ue838\ue846\ue82b\ue82d \ue90b\ue823\ue82b \ue807\ue826\ue83a\ue833\ue83b\ue818\ue839, \n\n(3) \n \n \n(\ue84a)  \u2018\u2018\ue833\ue805\ue83d\ue831\ue837\ue825\ue8ef\ue822 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d\u2019\u2019 \ue831\ue839\ue832\ue8eb\ue813\ue83d\ue82d \ue823\ue8ef\ue829\ue837 \ue8df\ue8c5-\ue84d\ue82d \ue8f7\ue82b \ue833\ue805\ue814\ue8f6\ue837-\ue84b \n\ue807\ue8ab\ue815\ue8eb\ue822 \ue90b\ue824\ue831\ue8f1\ue822 \ue83d\ue829\ue822\ue826 \ue834\ue837\ue82d \ue826\ue838\ue82b\ue83d\ue8ab \ue826\ue838\ue82b\ue931\ue82e\ue838\ue814\ue8ef\ue822 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \ue82c\ue823\ue837-\n\u2018\u2018\ue81d.\ue850\ue850\ue84e-\ue84a\ue84b-\ue851\ue850\ue84e- \ue809. \ue829\ue838. - \ue84a\ue84d-\ue84a\ue849\ue84b\ue84e\u2019\u2019 \ue90b\ue822\ue838\ue8e1\ue837\ue827\ue826 \ue83d\ue834\ue829 \ue858  \n(\ue84b) \u2018\u2018\ue833\ue805\ue83d\ue831\ue837\ue825\ue8ef\ue822 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d\u2019\u2019 \ue831\ue839\ue832\ue8eb\ue813\ue83d\ue82d \ue823\ue8ef\ue829\ue837 \ue8df\ue8c5-\ue84d \ue82d \ue8f7\ue82b \ue833\ue805\ue814\ue8f6\ue837-\ue84f \n\ue807\ue8ab\ue815\ue8eb\ue822 \ue80b\ue827\ue8e1\ue837\ue827\ue838\ue822 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \ue826\ue838\ue82b\ue83d\ue8ab \ue826\ue838\ue82b\ue931\ue82e\ue838\ue814\ue8ef\ue822 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \ue90b\ue822\ue838\ue8e1\ue837\ue827\ue826 \n\ue83d\ue834\ue829- \n(\ue813) \ue81d.\ue852\ue850\ue84e-\ue84b\ue84e-\ue84a\ue84a\ue84e\ue849 \ue809.\ue829\ue838. \ue84c\ue849-\ue84a\ue84f\ue84f\ue849 (\ue90b\ue831\ue838\ue86f\ue838\ue822 \ue82b\ue837\ue901\ue838\ue813\ue841 \n\ue831\ue838\ue86f\ue813 \ue829\ue8f6\ue822\ue839\ue822 \ue833\ue82b\ue8df \ue827\ue824\ue829\ue839 \ue826\ue838\ue82b\ue83d\ue8ab) \n\ue84d\ue858 \u2018\u2018\ue822\ue89a\ue83d\ue82d, \ue807\ue815\ue8d6 \ue84b\ue850, \ue84a\ue852\ue852\ue84b\ue83d\ue82d \ue807\ue821\ue90b\ue831\ue838\ue86f\ue838\ue822 \ue809\ue88e\ue82d\ue82b\ue838\ue81f\ue838\ue80f\ue81d\ue841 \ue831\ue838\ue86f\ue813 \ue80f\ue829\ue805 \n\ue90b\ue831\ue838\ue86f\ue838\ue822 \ue82b\ue837\ue901\ue838\ue813 \ue831\ue838\ue86f\ue813\ue879 \ue83d\ue829\ue822\ue826\ue834\ue837\ue82d\ue813\ue83a \ue824\ue831\ue8eb\ue837\ue809 \ue80f\ue813 \ue831\ue83a\ue8a4\ue838\ue827\ue906 \ue81a\ue837\ue82d\ue839 \n\ue813\ue82d\ue837\ue82c\ue837\ue809\ue823\ue8ef\ue82e\ue837 \ue858 \ue80b\ue86b \ue831\ue83a\ue8a4\ue838\ue827\ue906 \ue826\ue838\ue82b\ue931\ue82b\ue83d\ue822 \ue80b\ue8cf\ue838\ue814\ue8ef\ue822 \u2013  \n \n\ue8f7\ue82b\ue838\ue813 \n\ue833\ue805\ue814\ue8f6\ue837 \n\ue827\ue824\ue829\ue839\ue82d \ue826\ue837\ue82b \n\ue90b\ue818\ue82f\ue838\ue822 \n\ue83d\ue829\ue822\ue826\ue834\ue837\ue82d \n\ue833\ue