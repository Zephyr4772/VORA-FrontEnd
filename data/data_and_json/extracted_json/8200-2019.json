    "full_text": "(1) \n \n \n\ue82d\ue838\ue83d\ue827\ue837\ue81d\ue8eb\ue83d\ue82c\ue837\ue815\ue8f6 \n \n\ue82b\ue837\ue826\ue8f6\ue829\ue82d \ue833\ue83d\ue829\ue837\ue8eb\ue87f \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846\ue83d\ue82d \n\ue833\ue838\ue82a\ue838\ue82e\ue841 \ue807\ue837\ue83d\ue829\ue824\ue826 \ue807\ue825\ue8ef\ue813\ue837\ue82d\ue838\ue822\ue837 \n\ue833\ue838\ue82a\ue838\ue82e\ue841 \ue807\ue827\ue838\ue82e\ue841 \ue826\ue805 \u2013 \ue851\ue852\ue84c/\ue84b\ue849\ue84b\ue849 \n\ue80f\ue833\ue841.\ue80f\ue82e\ue841.\ue827\ue838. (\ue833\ue838\ue82a\ue838\ue82e\ue841) \ue826\ue805 \u2013 \ue84c\ue84a\ue84d\ue851/\ue84b\ue849\ue84b\ue849\ue82d\ue83a \ue80b\ue824\ue841\ue82a\ue83b\ue822 \n\ue81f\ue837\ue809\ue82d\ue839 \ue826\ue805 \u2013 \ue851\ue84b\ue849\ue849/\ue84b\ue849\ue84a\ue852 \ue82d\ue83a \n \n\ue811\ue81f\ue838\ue831\ue837 \ue82d\ue837\ue81a\ue8f6 \ue833\ue82d\ue813\ue837\ue82d \ue80f\ue829\ue805 \ue811\ue83d\ue815\ue82d\u2026\u2026\u2026\u2026\u2026.\u2026\u2026 \ue807\ue827\ue838\ue82e\ue841\ue813\ue837\ue82d\ue839 \n\ue829\ue826\ue837\ue82b \n\ue83d\ue815\ue837\ue829\ue838\ue8b1 \ue83d\ue829\ue83d\ue834\ue82d\ue837\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026.\u2026\u2026..... \ue90b\ue822\ue838\ue829\ue837\ue824\ue839 \n \n\ue82d\ue837\ue846  \n\ue844\ue806 \ue825\ue826\ue889\ue846 I\u00df\u00fb\ue809 \ue818\ue8b2\ue818\ue83b\ue844, \ue826\ue8f6\ue837\ue846\ue837\ue825\ue839\ue831 \n \n \n\ue84a\ue858  \ue829\ue838\ue82f\ue8c4 \ue86f\ue82b\ue837 \ue824\ue838\ue807\ue837\ue815\ue82e\ue837\ue858 \n\ue84b\ue858  \ue82e\ue838\ue82a\ue841\ue81d\ue838 \ue82b\ue889\ue83a\ue82d \ue813\ue82d\ue837\ue815\ue82e\ue837\ue858 \n\ue84c\ue858 \ue82b\ue837\ue826\ue8f6\ue829\ue82d \ue811\ue844\ue838\ue831\ue837 \ue80b\ue87f \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846\ue82d \ue80f\ue813 \ue90b\ue82a\ue837\ue815 \ue829\ue838\ue818\ue837\ue82d\ue827\ue839\ue81e (\ue844\ue838\ue82a\ue838\ue81a\ue826\ue841 \ue83d\ue829\ue887\ue841) \ue82d \n\ue822\ue837 \ue84b\ue852.\ue849\ue84c.\ue84b\ue849\ue84a\ue851 \ue82d\ue838\ue814\ue82d \ue82d\ue837\ue846 \ue822\ue823\ue837 \ue807\ue837\ue83d\ue824\ue831\ue826\ue837\ue82b\ue837\ue82d\ue83a \ue80f\ue834\ue838 \ue807\ue827\ue838\ue82e\ue841\ue82d \ue80b\ue827\ue8ef\ue895\ue838\ue858 \n\ue84d\ue858 \ue90b\ue822\ue838\ue829\ue837\ue824\ue839 \ue822\ue837 \ue84b\ue852.\ue84a\ue849.\ue84b\ue849\ue84a\ue84a \ue82d\ue838\ue814\ue83d\ue82d \ue811\ue844\ue838\ue831\ue837 \ue82d\ue837\ue81a\ue8f6 \ue83d\ue827\ue837\ue82e\ue838\ue833\ue841\ue82d \ue832\ue8d8 \ue807\ue837\ue809.\ue807\ue837\ue82d\ue841. \n\ue829\ue837\ue81d\ue837\ue82e\ue838\ue846\ue826\ue841 \ue83d\ue814\ue837\ue8a4\ue837\ue8eb\ue83d\ue82d \ue813\ue83d\ue826\ue8d6\ue829\ue82f \ue827\ue824 \ue826\ue838\ue82c\ue83a\ue86b\ue838 \ue827\ue837\ue809\ue804 \ue807\ue837\ue83d\ue829\ue824\ue826 \ue813\ue82d\ue838\ue823\ue8ef\ue82e\ue837\ue858 \ue80f\ue813 \n\ue90b\ue831\ue931\ue82d \ue80b\ue895\ue82d\ue83d\ue82d \ue90b\ue822\ue838\ue829\ue837\ue824\ue839 \ue822\ue837 \ue807\ue837\ue83d\ue829\ue824\ue826 \ue827\ue906\ue83d\ue82d \ue826\ue838\ue8a3\ue8f1\ue8d6 \ue82a\ue837\ue829\ue83d\ue82d \ue829\ue8f6\ue86b \ue813\ue82d\ue838\ue823\ue8ef\ue82e\ue837 \n\n(2) \n \n \n\ue83d\ue82c \ue83d\ue833 \ue83d\ue813\ue843\ue821\ue833\ue838 \ue807\ue827\ue82d\ue837\ue825\ue8ef\ue813 \ue82b\ue837\ue82b\ue82e\ue837\ue83d\ue82d \ue833\ue805\ue827\ue83c\ue86b \ue826\ue83a\ue83d\ue834\ue804\ue858 \ue822\ue837\ue84a\ue84d.\ue84a\ue84b.\ue84b\ue849\ue84a\ue84a \n\ue82d\ue838\ue814\ue83d\ue82d \ue83d\ue833 \ue826\ue838\ue82c\ue83a\ue86b\ue838 \ue827\ue837\ue809\ue823\ue8ef\ue82e\ue837\ue858 \ue822\ue837\ue813\ue83a \ue811\ue844\ue838\ue831\ue837 \ue83d\ue827\ue837\ue82e\ue838\ue833\ue841 \ue826\ue838\ue846\ue82b\ue837\ue829\ue82f\ue839\ue82d \ue826\ue838\ue846\ue82b \ue84f\ue850\ue84c \n\ue833\ue895\ue837\ue826\ue83a\ue833\ue837\ue83d\ue82d \ue80f\ue813 \ue82c\ue837\ue887 \ue813\ue837\ue815\ue81a (\ue83d\ue82a\ue82d\ue838\ue828\ue838\ue83d\ue813\ue833\ue826\ue841 \ue83d\ue82d\ue837\ue82e\ue841) \ue827\ue83b\ue82d\ue821 \ue813\ue82d\ue838\ue829\ue837\ue813\ue83a \n\ue824\ue838\ue807\ue837\ue82c\ue837\ue809\ue823\ue8ef\ue82e\ue837\ue858 \ue822\ue837\ue84b\ue84b \ue83d\ue82b \ue84b\ue849\ue84a\ue84b \ue82d\ue838\ue814\ue83d\ue82d \ue827\ue83a\ue82d\ue839 \ue83d\ue827\ue837\ue82e\ue838\ue833\ue841 \ue807\ue825\ue839\ue86f\ue813 \n(\ue833\ue83a\ue827\ue82d\ue838\ue826\ue841\ue83d\ue81d\ue83d\ue890\ue88e\ue841) \ue83d\ue833\ue826\ue837\ue826\ue837\ue846\ue813 (\ue813\ue82b\ue837\ue890\ue837\ue88e\ue841) \ue879\ue83a \ue81a\ue821\ue837\ue809\ue83d\ue82e \ue83d\ue82c, \ue90b\ue822\ue838\ue829\ue837\ue824\ue839\ue82d \n\ue818\ue82d\ue838\ue906 \ue811 \ue827\ue83b\ue829\ue8eb \ue813\ue837\ue82c\ue8f6\ue8eb\ue813\ue82f\ue837\ue827 \ue82c\ue837\ue887 \ue90b\ue8f7\ue838\ue846\ue837 \ue833\ue82b\ue846\ue83d\ue82d \ue822\ue837 \ue826\ue837\ue82b\ue83d\ue82d \ue82a\ue837\ue82d\ue822\ue839\ue846 \ue824\ue890 \n\ue833\ue805\ue834\ue838\ue822\ue837, \ue84a\ue851\ue84f\ue849 (\ue807\ue837\ue809.\ue827\ue838.\ue833\ue838. \ue84a\ue851\ue84f\ue849)\ue84a \ue807\ue8ab\ue815\ue8eb\ue822 \ue825\ue837\ue82d\ue837 \ue84b\ue852\ue84d\ue858 \ue84c\ue84b\ue84c\ue858 \ue84c\ue84b\ue84d\ue858 \n\ue84c\ue84b\ue84f\ue858 \ue84c\ue84c\ue84f\ue858 \ue84c\ue84c\ue850\ue858 \ue84d\ue84b\ue850\ue858 \ue84c\ue850\ue852\ue858 \ue84e\ue849\ue84f\ue858 \ue84c\ue84d \ue807\ue825\ue8ef\ue826\ue83d\ue82d \ue829\ue82f\ue87d\ue837 \ue823\ue837\ue826\ue837 \n\ue82b\ue837\ue82b\ue82e\ue837 (\ue829\ue82f\ue87d\ue837 \ue827\ue838.\ue80f\ue833\ue841. \ue83d\ue813\ue831\ue841) \ue826\ue805 \ue84d\ue84f/\ue84b\ue849\ue849\ue852 \ue824\ue837\ue814\ue82e \ue823\ue8ef\ue829\ue837\ue82d \ue81a\ue821\ue837\ue815\ue82e\ue837\ue858 \n\ue813\ue83d\ue826\ue8d6\ue829\ue82f \ue827\ue824 \ue826\ue838\ue82c\ue83a\ue86b\ue838 \ue807\ue837\ue83d\ue829\ue824\ue826\ue827\ue906\ue83d\ue82d \ue811 \ue82c\ue837\ue887 \ue813\ue837\ue815\ue81a (\ue83d\ue82a\ue82d\ue838\ue828\ue838\ue83d\ue813\ue833\ue826\ue841 \n\ue83d\ue82d\ue837\ue82e\ue841) \ue83d\ue82d \ue82b\ue838\ue823\ue8f6\ue837 \ue829\ue838\ue829\ue83c\ue822\ue838 \ue824\ue837\ue814\ue82e \ue813\ue82d\ue838\ue823\ue8ef\ue829\ue837 \ue83d\ue82c\ue837\ue815\ue83a\ue804 \ue822\ue837 \ue84f \ue81a\ue83a\ue82e\ue837\ue809 \ue84b\ue849\ue84a\ue84b \ue82d\ue838\ue814\ue83d\ue82d \n\ue90b\ue822\ue838\ue829\ue837\ue824\ue839\ue879\ue83a \ue83d\ue813\ue842\ue828\ue838\ue846\ue822\ue841/\ue8e4\ue8d6\ue839\ue813\ue82d\ue821 \ue82b\ue815\ue837\ue815\ue82e\ue837\ue858 \ue822\ue837 \ue84b\ue84f \ue81a\ue83a\ue82e\ue837\ue809 \ue82d\ue838\ue814 \ue824\ue838\ue826 \n\ue90b\ue822\ue838\ue829\ue837\ue824\ue839\ue879\ue83a \ue813\ue837\ue82c\ue8f6\ue837\ue8eb\ue8ab\ue82d/\ue829\ue834\ue838\ue8d4\ue837\ue82d \ue813\ue82d\ue837\ue82c\ue838\ue829\ue837\ue82d\ue83a \ue83d\ue833 \ue811\ue844\ue838\ue831 \ue807\ue837\ue844\ue991\ue82b\ue838\ue826\ue838\ue83d\ue8d7\ue81d\ue838\ue82a\ue841 \n\ue901\ue837\ue829\ue8f6\ue83a\ue826\ue837\ue82e\ue841\ue84b (\ue811\ue844\ue838\ue831\ue837 \ue90b\ue831\ue837\ue833\ue826\ue838 \ue826\ue8f6\ue837\ue846\ue837\ue825\ue8ef\ue813\ue82d\ue821) \ue879 \ue827\ue837\ue814\ue83d\ue82d \ue80f\ue813 \ue83d\ue82b\ue837\ue813\ue8a3\ue82b\ue837 \n(\ue83d\ue90b\ue837\ue833\ue838\ue844\ue838\ue87d\ue841) \ue824\ue837\ue814\ue82e \ue813\ue83d\ue82e\ue858 \ue82b\ue837\ue826\ue8f6\ue829\ue82d \ue901\ue837\ue829\ue8f6\ue83a\ue826\ue837\ue82e \ue80f\ue834\ue838 \ue813\ue837\ue82d\ue821 \ue824\ue831\ue837\ue8eb\ue809 \ue811\ue82d\ue838\ue81a\ue838\ue826\ue837\ue82e\ue841 \n\ue807\ue837\ue827\ue939\ue838\ue83d\ue813\ue833\ue826\ue841\ue84c (\ue811.\ue80f.) \ue813\ue83a \ue829\ue82d\ue814\ue837\ue8df \ue813\ue82d\ue838\ue83d\ue824\ue83d\ue82e \ue83d\ue82c \ue90b\ue822\ue838\ue829\ue837\ue824\ue839 \ue80f\ue813 \ue82b\ue838\ue823\ue8f6\ue837 \n\ue833\ue822\ue8f6\ue827\ue837\ue81e \ue83d\ue824\ue809\ue823\ue8ef\ue82e\ue837\ue858 \ue82b\ue837\ue826\ue8f6\ue829\ue82d \ue80b\ue87f \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846 \ue826\ue838\ue81a \ue807\ue837\ue83d\ue824\ue831/\ue82d\ue837\ue846 (\ue809\ue8c1\ue8f6\ue83a\ue826\ue841\ue844\ue991 \n\ue81a\ue81a\ue83d\ue82b\ue88e\ue841) \ue829\ue82f\ue83d\ue82d \ue901\ue837\ue829\ue8f6\ue83a\ue826\ue837\ue82e\ue82d \ue826\ue838\ue8da\ue895\ue838\ue813\ue83a \ue829\ue824\ue82f\ue837\ue809 \ue83d\ue824\ue809\ue823\ue8ef\ue83d\ue82e\ue858 \ue80b\ue87f \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846, \n\ue80f\ue834\ue838 \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846 \ue8a6\ue837\ue82d\ue837 \ue829\ue838\ue818\ue837\ue82d \ue813\ue82d\ue838 \ue807\ue829\ue822\ue837\ue82d \ue833\ue838\ue805 \ue829\ue826\ue837\ue82b \ue846\ue83a\ue826\ue838\ue846\ue826\ue841  \ue807\ue828\ue841 \ue809\ue841\ue890\ue838\ue807\ue837\ue84d \n\n(3) \n \n \n(\ue83d\ue813\ue8b2 \ue833\ue82d\ue813\ue837\ue82d) (\ue807\ue829\ue822\ue837\ue82d \ue833\ue838\ue805) \ue82b\ue837\ue82b\ue82e\ue837\ue83d\ue82d \ue824\ue838\ue807\ue837\ue82c\ue837\ue809\ue823\ue8ef\ue829\ue837 \ue82d\ue837\ue846 \ue807\ue837\ue825\ue837\ue82d\ue83d\ue82d \n\ue80f\ue827\ue82d\ue838 \ue813\ue83d\ue82e\ue858 \ue80b\ue87f \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846\ue879 \ue82b\ue822\ue83d\ue82d \ue901\ue837\ue829\ue8f6\ue83a\ue826\ue837\ue82e\ue841 \ue807\ue827\ue82d\ue837\ue825\ue8ef\ue813 \ue90b\ue8f7\ue838\ue846\ue837 (\ue8f7\ue838\ue82b\ue838\ue826\ue837\ue82e\ue841 \n\ue83d\ue90b\ue837\ue833\ue838\ue844\ue838\ue87d\ue841) \ue82d \ue829\ue8b1 \ue83d\ue834\ue837\ue809\ue82c\ue838\ue829\ue837 \ue829\ue838\ue832\ue846\ue813\ue83a \ue807\ue821\ue83d\ue824\ue814\ue837 \ue813\ue82d\ue838\ue819\ue838 \ue811 \ue827\ue82d\ue838\ue8e1\ue822\ue838\ue82d \ue824\ue82b\ue826 \n\ue80f\ue813 \ue83d\ue813\ue843\ue831\ue82f \ue811 \ue822\ue83a\ue880 \ue90b\ue813\ue83c\ue822\ue838\ue82d \ue823\ue8ef\ue82e\ue837\ue858 \ue90b\ue822\ue838\ue829\ue837\ue824\ue839\ue879\ue83a \ue822\ue837\ue879 \ue827\ue83b\ue829\ue8eb \ue827\ue824\ue83d\ue82d \ue827\ue83a\ue826\ue806\ue826\ue838\ue82c\ue83a\ue86b\ue838 \n\ue83d\ue824\ue809 \ue822\ue837\ue879\ue83a \ue822\ue837\ue879 \ue83d\ue833\ue829\ue837\ue82d \ue828\ue82f\ue837\ue828\ue82f \ue822\ue823\ue837 \ue807\ue837\ue8f4\ue8eb\ue813 \ue82e\ue837\ue82a \ue82b\ue889\ue83a\ue82d \ue813\ue82d\ue838 \ue829\ue838\ue818\ue837\ue82d \n\ue813\ue82d\ue838\ue829\ue837\ue813\ue83a \ue813\ue895\ue8eb\ue83c\ue827\ue86f\ue879\ue83a \ue826\ue838\ue83d\ue8a3\ue8eb\ue831\ue83d\ue824\ue83d\ue82e\ue858 \n\ue84e. \n\ue80b\ue82a\ue846 \ue807\ue827\ue838\ue807\ue813\ue837\ue82d\ue839 \ue811 \ue90b\ue822\ue838\ue829\ue837\ue824\ue839\ue879 \ue811\ue813\ue838\ue82e\ue82b\ue837\ue826\ue879\ue83a \ue831\ue83a\ue821\ue838\ue82e\ue837 \ue827\ue83d\ue82d \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846\ue82d \ue824\ue83c\ue8d6\ue838\ue813\ue83a \n\ue816\ue81d\ue821\ue837\ue82d \ue829\ue837\ue8df\ue829\ue838\ue813\ue822\ue837/\ue90b\ue813\ue83c\ue822\ue8e1\ue838\ue822\ue838 \ue807\ue837\ue833\ue838\ue819\ue838 \ue83d\ue82c \ue807\ue827\ue82d\ue837\ue825\ue8ef\ue813 \ue82b\ue837\ue82b\ue82e\ue837\ue82d \ue80f\ue822\ue82e\ue837 \n(\ue80f\ue828\ue841.\ue807\ue837\ue809.\ue807\ue837\ue82d\ue841) \ue822\ue837 \ue84a\ue84f.\ue849\ue84f.\ue84b\ue849\ue849\ue852 \ue83d\ue82d \ue824\ue838\ue807\ue837\ue82c\ue837\ue809\ue823\ue8ef\ue82e\ue837\ue858 \ue90b\ue822\ue838\ue829\ue837\ue824\ue839 \n\ue83d\ue81a.\ue80f\ue82b\ue841.\ue80f\ue828\ue841.\ue833\ue838. \ue879 \ue833\ue82b\ue841\ue83a\ue814\ue83d\ue82d \ue807\ue837\ue82b\ue8ef \ue833\ue82b\ue827\ue8eb\ue821 \ue813\ue82d\ue838\ue823\ue8ef\ue82e\ue837 \ue80f\ue829\ue805 \ue81a\ue837\ue82b\ue838\ue826\ue841 \ue807\ue837\ue83d\ue829\ue824\ue826 \n\ue826\ue805 \ue84a\ue849\ue84b\ue84d\ue84f/\ue84b\ue849\ue849\ue852 \ue83d\ue82d \ue824\ue838\ue807\ue837\ue82c\ue837\ue809\ue823\ue8ef\ue829\ue837 \ue80b\ue87f \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846\ue879 \ue822\ue837\ue84b\ue851 \ue81a\ue83a\ue82e\ue837\ue809 \n\ue84b\ue849\ue849\ue852 \ue82d\ue838\ue814 \ue807\ue837\ue83d\ue824\ue831\ue826\ue837\ue82b\ue837 \ue829\ue82