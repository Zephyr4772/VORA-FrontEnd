    "full_text": "1 \n \n\u0905\u0124\u093f\u0924\u0935\u0947\u01ad \n\u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0935\u023e\u00cd\u091a \u00db\u092f\u093e\u092f\u093e\u0932\u092f \n\u093f\u0938\u01d2\u0935\u0932 \u0905\u092a\u0940\u0932\u0940\u092f \u00a2\u0947\u011f\u093e\u093f\u0927\u0915\u093e\u0930 \n\u093f\u0938\u01d2\u0935\u0932 \u0905\u092a\u0940\u0932 \u0938\u0902. 4208/2023 \n(\u01d2\u0935.\u0905\u0928\u0941.\u092f\u093e(\u093f\u0938.) \u0938\u0902. 7137/2016 \u0938\u0947 \u0909\u00d7\u092a\u00db\u0928) \n \n\u0930\u092e\u0947\u0936 \u091a\u0902\u0926                                       ...\u0905\u092a\u0940\u0932\u093e\u0925\u0238   \n\u092c\u0928\u093e\u092e \n \u01d1\u0926\u00e3\u0932\u0940 \u092a\u01d0\u0930\u0935\u0939\u0928 \u093f\u0928\u0917\u092e \u0124\u092c\u0902\u0927\u0928                        ...\u0124\u00d7\u092f\u0925\u0238  \n \n\u093f\u0928\u0923[\u092f \n\u00db\u092f\u093e., \u0905\u092d\u092f \u090f\u0938. \u0913\u0915\u093e \n\u0924\u00d8\u092f\u093e\u00d7\u092e\u0915 \u092a\u0939\u0932\u0942 \n\u0905\u0928\u0941\u092e\u093f\u0924 \u0124\u0926\u093e\u093f\u0928\u0924\u0964 \n1. \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u01d1\u0926\u0928\u093e\u0902\u0915 22 \u091c\u0942\u0928 1985 \u0915\u094b \u0915\u0902\u0921\u00c8\u091f\u0930 \u0915\u0947 \u01fe\u092a \u092e\u0245 \n\u0124\u00d7\u092f\u0925\u0238- \u01d1\u0926\u00e3\u0932\u0940 \u092a\u01d0\u0930\u0935\u0939\u0928 \u093f\u0928\u0917\u092e \u01ae\u093e\u0930\u093e \u093f\u0928\u092f\u0941\u01a0 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e| \u0124\u00d7\u092f\u0925\u0238 \n\u01ae\u093e\u0930\u093e \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b 8 \u093f\u0938\u0924\u0902\u092c\u0930 1992 \u0915\u094b \u0906\u0930\u094b\u092a-\u092a\u011f \u01d1\u0926\u092f\u093e \u0917\u092f\u093e \u0925\u093e \n\u01d4\u091c\u0938\u092e\u0245 \u0906\u0930\u094b\u092a \u0932\u0917\u093e\u092f\u093e \u0917\u092f\u093e \u01d1\u0915 \u090f\u0915 \u01d2\u0935\u093f\u0936\u01b4 \u01fe\u091f \u092a\u0930 \u0915\u0902\u0921\u00c8\u091f\u0930 \u0915\u0947 \u01fe\u092a \u092e\u0245 \n\n2 \n \n\u0915\u0924[\u00e5\u092f\u0249 \u0915\u093e \u093f\u0928\u0935[\u0939\u0928 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0909\u00db\u0939\u0249\u0928\u0947 \u0926\u094b \u092f\u093e\u01d2\u011f\u092f\u0249 \u0938\u0947 4 \u01fd\u092a\u090f \u0915\u0227 \u0930\u093e\u093f\u0936 \n\u0124\u093e\u01af \u0915\u0227 \u0932\u0947\u01d1\u0915\u0928 \u0909\u00db\u0939\u0245 \u01d1\u091f\u0915\u091f \u091c\u093e\u0930\u0223 \u0915\u0930\u0928\u0947 \u092e\u0245 \u01d2\u0935\u092b\u0932 \u0930\u0939\u0947\u0964 \u091c\u093e\u0902\u091a \u0915\u0947 \u092c\u093e\u0926 \n\u0124\u00d7\u092f\u0925\u0238 \u0928\u0947 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u01d1\u0926\u0928\u093e\u0902\u0915 14 \u091c\u0942\u0928 1996 \u0938\u0947 \u0938\u0947\u0935\u093e \u0938\u0947 \u0939\u091f\u093e\u0928\u0947 \u0915\u093e \n\u0906\u0926\u0947\u0936 \u092a\u093e\u01d0\u0930\u0924 \u01d1\u0915\u092f\u093e\u0964   \n2. \u0124\u00d7\u092f\u0925\u0238 \u0928\u0947 \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u00a2 \u090f\u0915 \u0914\u01ad\u094b\u093f\u0917\u0915 \u01d2\u0935\u0935\u093e\u0926 \u0909\u0920\u093e\u092f\u093e \n\u0914\u0930 \u091c\u093e\u0902\u091a \u0935 \u0909\u0938\u0915\u0947 \u092a\u01d0\u0930\u0923\u093e\u092e\u00e8\u0935\u01fe\u092a \u0938\u0947\u0935\u093e \u0938\u0947 \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u094b \u091a\u0941\u0928\u094c\u0924\u0940 \n\u0926\u0223 \u0939\u0948\u0964 \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u092a\u00a2\u0915\u093e\u0930\u0249 \u0915\u094b \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u092a\u01b1\u093e\u0924 \u0907\u0938 \u093f\u0928\u00e7\u0915\u0937[ \u092a\u0930 \n\u092a\u0939\u0941\u0902\u091a\u093e \u01d1\u0915 \u091c\u093e\u0902\u091a \u0905\u0935\u0948\u0927 \u0925\u0940\u0964 \u0907\u0938\u093f\u0932\u090f \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0124\u00d7\u092f\u0925\u0238 \u0915\u094b \n\u0938\u093e\u00ea\u092f \u090f\u0915\u01d2\u011f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0227 \u0905\u0928\u0941\u092e\u093f\u0924 \u0926\u0223\u0964 \u0905\u093f\u0927\u093f\u0928\u0923[\u092f \u01d1\u0926\u0928\u093e\u0902\u01d1\u0915\u0924 17 \u092e\u093e\u091a[ \n2009 \u01ae\u093e\u0930\u093e \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0907\u0938 \u093f\u0928\u00e7\u0915\u0937[ \u092a\u0930 \u092a\u0939\u0941\u0902\u091a\u093e \u01d1\u0915 \u0124\u00d7\u092f\u0925\u0238 \u01ae\u093e\u0930\u093e \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0947 \u01d4\u0916\u0932\u093e\u092b \u0906\u0930\u094b\u092a \u00e8\u0925\u093e\u01d2\u092a\u0924 \u0928\u0939\u0223\u0902 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0924\u0926\u0928\u0941\u0938\u093e\u0930, \n\u0909\u01a0 \u0905\u093f\u0927\u093f\u0928\u0923[\u092f \u01ae\u093e\u0930\u093e \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u0938\u0947\u0935\u093e \u092e\u0245 \u092c\u0939\u093e\u0932 \n\u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u0926\u0947\u0936 \u092a\u093e\u01d0\u0930\u0924 \u01d1\u0915\u092f\u093e\u0964 \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \u092f\u0939 \u01d2\u0935\u091a\u093e\u0930 \u0925\u093e \u01d1\u0915 \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u092f\u0939 \u0938\u093e\u01d2\u092c\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0926\u093e\u093f\u092f\u00d7\u0935 \u0915\u093e \u093f\u0928\u0935[\u0939\u0928 \u0928\u0939\u0223\u0902 \u01d1\u0915\u092f\u093e \u0939\u0948 \n\u01d1\u0915 \u0935\u0939 \u0938\u0947\u0935\u093e \u0938\u0947 \u0939\u091f\u093e\u090f \u091c\u093e\u0928\u0947 \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u0932\u093e\u092d\u0124\u0926 \u01fe\u092a \u0938\u0947 \u093f\u0928\u092f\u0941\u01a0 \u0928\u0939\u0223\u0902 \n\u0925\u093e\u0964 \u0907\u0938\u093f\u0932\u090f, \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \u0926\u0947\u0928\u0947 \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u0930 \n\u01d1\u0926\u092f\u093e\u0964   \n\n3 \n \n3. \u0124\u00d7\u092f\u0925\u0238 \u0928\u0947 \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0905\u093f\u0927\u093f\u0928\u0923[\u092f \u0915\u094b \u00e8\u0935\u0940\u0915\u093e\u0930 \u01d1\u0915\u092f\u093e \u0925\u093e\u0964 \n\u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \u0926\u0947\u0928\u0947 \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0938\u0947 \u00e5\u092f\u093f\u0925\u0924 \u0939\u094b\u0915\u0930 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \n\u092e\u093e\u0928\u0928\u0940\u092f \u01d1\u0926\u00e3\u0932\u0940 \u0909\u00cd\u091a \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u01d2\u0935\u01ae\u093e\u0928 \u090f\u0915\u0932 \u00db\u092f\u093e\u092f\u093e\u0927\u0940\u0936 \u0915\u0947 \u0938\u092e\u00a2 \n\u090f\u0915 \u01d0\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e \u0926\u093e\u092f\u0930 \u0915\u0227 \u0925\u0940\u0964 \u01d0\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e \u0916\u093e\u01d0\u0930\u091c \u0915\u0930 \u0926\u0223 \u0917\u0908 \u0925\u0940\u0964 \n\u01d0\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e \u0915\u0947 \u0916\u093e\u01d0\u0930\u091c \u0939\u094b\u0928\u0947 \u0938\u0947 \u00e5\u092f\u093f\u0925\u0924 \u0939\u094b\u0915\u0930 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u092e\u093e\u0928\u0928\u0940\u092f \n\u01d1\u0926\u00e3\u0932\u0940 \u0909\u00cd\u091a \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0227 \u0916\u0902\u0921\u092a\u0940\u0920 \u0915\u0947 \u0938\u092e\u00a2 \u0905\u092a\u0940\u0932 \u0926\u093e\u092f\u0930 \u0915\u0227 \u0925\u0940\u0964 \n\u01d1\u0926\u0928\u093e\u0902\u0915 11 \u01d1\u0926\u0938\u0902\u092c\u0930 2015 \u0915\u0947 \u0906\u00a2\u0947\u01d2\u092a\u0924 \u093f\u0928\u0923[\u092f \u092e\u0245 \u0916\u0902\u0921\u092a\u0940\u0920 \u01ae\u093e\u0930\u093e \u092c\u0915\u093e\u092f\u093e \n\u0935\u0947\u0924\u0928 \u0926\u0947\u0928\u0947 \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u094b \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \n4. \u0907\u0938 \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u01ae\u093e\u0930\u093e \u01d1\u0926\u0928\u093e\u0902\u0915 18 \u092e\u093e\u091a[ 2016 \u0915\u094b \u0928\u094b\u01d1\u091f\u0938 \u091c\u093e\u0930\u0223 \u01d1\u0915\u092f\u093e \n\u0917\u092f\u093e \u0925\u093e\u0964 \u0939\u092e \u092f\u0939\u093e\u0902 \u0928\u094b\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0247 \u01d1\u0915 \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \n\u0905\u093f\u0927\u093f\u0928\u0923[\u092f \u0915\u0947 \u0938\u0902\u0926\u092d[ \u092e\u0245 \u01d4\u091c\u0938\u0947 \u0124\u00d7\u092f\u0925\u0238 \u01ae\u093e\u0930\u093e \u091a\u0941\u0928\u094c\u0924\u0940 \u0928\u0939\u0223\u0902 \u0926\u0223 \u0917\u0908 \u0925\u0940, \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u01d1\u0926\u0928\u093e\u0902\u0915 23 \u091c\u0941\u0932\u093e\u0908 2009 \u0938\u0947 \u0938\u0947\u0935\u093e \u092e\u0245 \u092c\u0939\u093e\u0932 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \n\u0925\u093e\u0964 \u0935\u0939 \u01d1\u0926\u0928\u093e\u0902\u0915 31 \u092e\u093e\u091a[ 2020 \u0915\u094b \u0938\u0947\u0935\u093e\u093f\u0928\u0935\u0943\u01a3 \u0939\u0941\u090f \u0925\u0947\u0964  \n\u0124\u00e8\u0924\u0941\u093f\u0924\u092f\u093e\u0901 \n5. \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0227 \u0913\u0930 \u0938\u0947 \u092a\u0947\u0936 \u0939\u0941\u090f \u01d2\u0935\u01ae\u093e\u0928 \u0935\u01d0\u0930\u01b5 \u0905\u093f\u0927\u0935\u01a0\u093e \u0928\u0947 \u0906\u0112\u0939 \n\u01d1\u0915\u092f\u093e \u01d1\u0915 \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u00a2 \u0926\u093e\u092f\u0930 \u0926\u093e\u0935\u0947 \u0915\u0947 \u01d2\u0935\u0935\u0930\u0923 \u092e\u0245 \u092d\u0940 \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u01d2\u0935\u0936\u0947\u0937 \u01fe\u092a \u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u01d1\u0915\u092f\u093e \u0925\u093e \u01d1\u0915 \u0935\u0939 \u0909\u0928\u0915\u0947 \u0938\u0947\u0935\u093e \u0938\u0947 \n\n4 \n \n\u0939\u091f\u093e\u090f \u091c\u093e\u0928\u0947 \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0925\u0947\u0964 \u0909\u00db\u0939\u0249\u0928\u0947 \u0124\u00e8\u0924\u0941\u0924 \u01d1\u0915\u092f\u093e \u01d1\u0915 \u012e\u092e \n\u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u00a2 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u0124\u00d7\u092f\u0925\u0238 \u0915\u0947 \u0905\u093f\u0927\u0935\u01a0\u093e \u01ae\u093e\u0930\u093e \u0907\u0938 \u092a\u0939\u0932\u0942 \n\u092a\u0930 \u0124\u093f\u0924\u092a\u0930\u0223\u00a2\u093e \u0915\u0947 \u0905\u0927\u0940\u0928 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0907\u0938\u093f\u0932\u090f \u0935\u0939 \u0124\u00e8\u0924\u0941\u0924 \u0915\u0930\u0924\u0947 \u0939\u0247 \n\u01d1\u0915 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0924\u00d8\u092f\u0249 \u092e\u0245 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u092f\u0939 \u0938\u093e\u01d2\u092c\u0924 \u0915\u0930\u0915\u0947 \u0909\u0938 \u092a\u0930 \n\u0926\u093e\u093f\u092f\u00d7\u0935 \u0915\u093e \u093f\u0928\u0935[\u0939\u0928 \u01d1\u0915\u092f\u093e \u01d1\u0915 \u0124\u00d7\u092f\u0925\u0238 \u01ae\u093e\u0930\u093e \u0938\u0947\u0935\u093e \u0938\u0947 \u0939\u091f\u093e\u090f \u091c\u093e\u0928\u0947 \u0915\u0947 \n\u092c\u093e\u0926 \u0909\u0938\u0915\u0947 \u092a\u093e\u0938 \u0915\u094b\u0908 \u0930\u094b\u091c\u0917\u093e\u0930 \u0928\u0939\u0223\u0902 \u0925\u093e\u0964 \u0909\u00db\u0939\u0249\u0928\u0947 \u0124\u00e8\u0924\u0941\u0924 \u01d1\u0915\u092f\u093e \u01d1\u0915 \u0907\u0938\u0915\u0947 \n\u01d2\u0935\u092a\u0930\u0223\u0924 \u0915\u094b\u0908 \u0938\u092c\u0942\u0924 \u0928\u0939\u0223\u0902 \u0939\u0948 \u0914\u0930 \u0907\u0938\u093f\u0932\u090f \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u092a\u0942\u0923[ \u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \n\u0915\u093e \u0939\u0915\u0926\u093e\u0930 \u0939\u0948\u0964   \n6. \u0124\u00d7\u092f\u0925\u0238 \u0915\u0227 \u0913\u0930 \u0938\u0947 \u0909\u092a\u01d4\u00e8\u0925\u0924 \u01d2\u0935\u01ae\u093e\u0928 \u0905\u093f\u0927\u0935\u01a0\u093e \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u01d1\u0915 \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u01ae\u093e\u0930\u093e \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u00a2 \u01d1\u0926\u0928\u093e\u0902\u0915 18 \u091c\u0941\u0932\u093e\u0908 2008 \u0915\u094b \n\u090f\u0915 \u0936\u092a\u0925-\u092a\u011f \u0926\u093e\u092f\u0930 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u01d4\u091c\u0938\u092e\u0245 \u090f\u0915 \u0926\u093e\u0935\u093e \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e \n\u01d1\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0905\u092a\u0928\u0940 \u0938\u0947\u0935\u093e \u0915\u0227 \u0938\u092e\u093e\u093f\u01af \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0925\u093e \u0914\u0930 \n\u01d1\u0915\u0938\u0940 \u092d\u0940 \u0930\u094b\u091c\u0917\u093e\u0930 \u0915\u094b \u0938\u0941\u0930\u01d4\u00a2\u0924 \u0915\u0930\u0928\u0947 \u092e\u0245 \u0938\u00a2\u092e \u0928\u0939\u0223\u0902 \u0939\u094b \u092a\u093e\u092f\u093e \u0925\u093e\u0964 \n\u0939\u093e\u0932\u093e\u0902\u01d1\u0915, \u0909\u01a0 \u0936\u092a\u0925-\u092a\u011f \u0915\u094b \u0935\u093e\u092a\u0938 \u0932\u0947 \u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u090f\u0915 \u0928\u092f\u093e \u0936\u092a\u0925-\n\u092a\u011f \u0926\u093e\u092f\u0930 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u01d4\u091c\u0938\u092e\u0245 \u0910\u0938\u093e \u0915\u094b\u0908 \u01d2\u0935\u093f\u0936\u01b4 \u0926\u093e\u0935\u093e \u0936\u093e\u093f\u092e\u0932 \u0928\u0939\u0223\u0902 \n\u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0907\u0938\u093f\u0932\u090f, \u01d2\u0935\u01ae\u093e\u0928 \u0905\u093f\u0927\u0935\u01a0\u093e \u092f\u0939 \u0124\u00e8\u0924\u0941\u0924 \u0915\u0930\u0245\u0917\u0947 \u01d1\u0915 \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u0938\u0947\u0935\u093e \u0915\u0227 \u0938\u092e\u093e\u093f\u01af \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \n\n5 \n \n\u0915\u094b \u00e8\u0925\u093e\u01d2\u092a\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0909\u0938\u0915\u0947 \u0926\u093e\u093f\u092f\u00d7\u0935 \u0915\u093e \u093f\u0928\u0935[\u0939\u0928 \u0928\u0939\u0223\u0902 \u01d1\u0915\u092f\u093e \u0939\u0948\u0964  \u091c\u0948\u0938\u093e \n\u01d1\u0915 \u0907\u0938 \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u01ae\u093e\u0930\u093e \u093f\u0928\u0926\u0236\u093f\u0936\u0924 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u0909\u00db\u0939\u0249\u0928\u0947 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \n\u092d\u0941\u0917\u0924\u093e\u0928 \u01d1\u0915\u090f \u0917\u090f \u0938\u0947\u0935\u093e\u093f\u0928\u0935\u0943\u01d2\u01a3 \u092c\u0915\u093e\u090f \u0915\u094b \u0926\u0936\u093e[\u0928\u0947 \u0935\u093e\u0932\u0947 \u0926\u00e8\u0924\u093e\u0935\u0947\u091c\u0249 \u0915\u094b \n\u0905\u093f\u092d\u0932\u0947\u0916 \u092a\u0930 \u0930\u0916\u093e \u0939\u0948 \u0914\u0930 \u090f\u0915 \u01d2\u0935\u0935\u0930\u0923 \u01d4\u091c\u0938\u092e\u0947 \u0909\u0938 \u0935\u0947\u0924\u0928 \u0915\u094b \u0936\u093e\u093f\u092e\u0932 \n\u01d1\u0915\u092f\u093e \u0939\u0948 \u091c\u094b \u0935\u0939 \u0905\u092a\u0928\u0940 \u0938\u0947\u0935\u093e \u0915\u0227 \u0938\u092e\u093e\u093f\u01af \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u0905\u092a\u0928\u0940 \u092c\u0939\u093e\u0932\u0940 \n\u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0924\u0915 \u0932\u0947 \u0938\u0915\u0924\u093e \u0925\u093e\u0964  \n\u0939\u092e\u093e\u0930\u093e \u01d2\u0935\u091a\u093e\u0930 \n7. \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u092e\u0928\u0947 \u090f\u0915\u092e\u093e\u011f \u0124\u01b0 \u092f\u0939 \u0939\u0948 \u01d1\u0915 \u00c8\u092f\u093e \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \n\u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \u0926\u0947\u0928\u0947 \u0938\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u0930\u0928\u093e \u0909\u093f\u091a\u0924 \u0925\u093e\u0964 \u0930\u093e\u01b6\u0940\u092f \u0917\u093e\u0902\u0927\u0940 \u0938\u0902\u0112\u0939\u093e\u0932\u092f \n\u092c\u0928\u093e\u092e \u0938\u0941\u0927\u0940\u0930 \u0936\u092e\u093e[ \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0245 \u0907\u0938 \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0915\u0939\u093e \u01d1\u0915 \u092f\u0939 \u0924\u00d8\u092f \n\u01d1\u0915 \u0938\u0947\u0935\u093e \u0938\u0947 \u092c\u0916\u093e[\u00e8\u0924\u0917\u0940 \u0915\u0947 \u092c\u093e\u0926 \u0915\u094b\u0908 \u0915\u092e[\u091a\u093e\u0930\u0223 \u0932\u093e\u092d\u0124\u0926 \u01fe\u092a \u0938\u0947 \u093f\u0928\u092f\u0941\u01a0 \n\u0925\u093e \u092f\u093e \u0928\u0939\u0223\u0902 \u092f\u0939 \u0909\u0938\u0915\u0947 \u01d2\u0935\u0936\u0947\u0937 \u00a3\u093e\u0928 \u092e\u0245 \u0939\u0948\u0964 \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u093e\u00ea\u092f \u0905\u093f\u0927\u093f\u0928\u092f\u092e, \n1872 \u0915\u0227 \u0927\u093e\u0930\u093e 106 \u092e\u0245 \u0936\u093e\u093f\u092e\u0932 \u093f\u0938\u01a8\u093e\u0902\u0924 \u0915\u094b \u00da\u092f\u093e\u0928 \u092e\u0245 \u0930\u0916\u0924\u0947 \u0939\u0941\u090f \n\u0124\u093e\u0930\u0902\u093f\u092d\u0915 \u0926\u093e\u093f\u092f\u00d7\u0935 \u0915\u092e[\u091a\u093e\u0930\u0223 \u092a\u0930 \u0939\u0948 \u01d1\u0915 \u0935\u0939 \u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u092e\u0928\u0947 \n\u0906\u090f \u01d1\u0915 \u0935\u0939 \u0938\u0947\u0935\u093e \u0915\u0227 \u0938\u092e\u093e\u093f\u01af \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u0947 \u092c\u093e\u0926 \u0932\u093e\u092d\u0124\u0926 \u01fe\u092a \u0938\u0947 \n\u093f\u0928\u092f\u0941\u01a0 \u0928\u0939\u0223\u0902 \u0925\u093e\u0964 \u092f\u0939 \u090f\u0915 \u0928\u0915\u093e\u0930\u093e\u00d7\u092e\u0915 \u0926\u093e\u093f\u092f\u00d7\u0935 \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u01d1\u0915, \u0915\u092e[\u091a\u093e\u0930\u0223 \n\u01d1\u0915\u0938 \u0924\u0930\u0939 \u0938\u0947 \u0909\u01a0 \u0926\u093e\u093f\u092f\u00d7\u0935 \u0915\u093e \u093f\u0928\u0935[\u0939\u0928 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u092f\u0939 \u0124\u00d7\u092f\u0947\u0915 \n\u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u01d2\u0935\u093f\u0936\u01b4 \u0924\u00d8\u092f\u0249 \u0914\u0930 \u092a\u01d0\u0930\u01d4\u00e8\u0925\u093f\u0924\u092f\u0249 \u092a\u0930 \u093f\u0928\u092d[\u0930 \u0915\u0930\u0947\u0917\u093e\u0964 \u092f\u0939 \u0938\u092c \n\n6 \n \n\u0905\u093f\u092d\u0932\u0947\u0916 \u092a\u0930 \u092e\u094c\u091c\u0942\u0926 \u0905\u093f\u092d\u0935\u091a\u0928 \u0914\u0930 \u0938\u092c\u0942\u0924\u0249 \u092a\u0930 \u093f\u0928\u092d[\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u091a\u0942\u0902\u01d1\u0915 \n\u01d1\u0926\u090f \u0917\u090f \u092e\u093e\u092e\u0932\u0947 \u092e\u0245 \u092f\u0939 \u090f\u0915 \u0928\u0915\u093e\u0930\u093e\u00d7\u092e\u0915 \u0926\u093e\u093f\u092f\u00d7\u0935 \u0939\u0948, \u0915\u092e[\u091a\u093e\u0930\u0223 \u01ae\u093e\u0930\u093e \n\u0936\u092a\u0925 \u092a\u0930 \u0926\u093e\u0935\u093e \u0915\u0930\u0928\u093e \u01d1\u0915 \u0935\u0939 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0925\u093e, \u093f\u0928\u092f\u094b\u01a0\u093e \u01ae\u093e\u0930\u093e \u0905\u093f\u092d\u0932\u0947\u0916 \n\u092a\u0930 \u0932\u093e\u0908 \u0917\u0908 \u01d1\u0915\u0938\u0940 \u092d\u0940 \u0938\u0915\u093e\u0930\u093e\u00d7\u092e\u0915 \u0938\u093e\u092e\u0112\u0940 \u0915\u0947 \u0905\u092d\u093e\u0935 \u0915\u0947 \u0905\u0928\u0941\u01fe\u092a \u0939\u094b \n\u0938\u0915\u0924\u093e \u0939\u0948\u0964  \n8. \u0905\u092c, \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0924\u00d8\u092f\u0249 \u092a\u0930 \u0917\u094c\u0930 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0939\u092e \u092a\u093e\u0924\u0947 \u0939\u0247 \u01d1\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \n\u01ae\u093e\u0930\u093e \u01d1\u0926\u0928\u093e\u0902\u0915 8 \u0905\u0917\u00e8\u0924 1997 \u0915\u094b \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u00a2 \u0926\u093e\u092f\u0930 \u0926\u093e\u0935\u093e \n\u01d2\u0935\u0935\u0930\u0923 \u091c\u094b \u0909\u0928\u0915\u0947 \u01ae\u093e\u0930\u093e \u01d2\u0935\u093f\u0927\u0935\u0924 \u0939\u00e8\u0924\u093e\u00a2\u01d0\u0930\u0924 \u0914\u0930 \u0938\u00d7\u092f\u093e\u01d2\u092a\u0924 \u01d1\u0915\u092f\u093e \n\u0917\u092f\u093e \u0925\u093e \u01d4\u091c\u0938\u092e\u0947 \u090f\u0915 \u01d2\u0935\u093f\u0936\u01b4 \u01d2\u0935\u0935\u093e\u0926 \u0909\u0920\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u01d1\u0915 \u0935\u0939 \u0905\u092d\u0940 \u092d\u0940 \n\u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0939\u0247 \u0914\u0930 \u0915\u094b\u0908 \u0928\u094c\u0915\u0930\u0223 \u0928\u0939\u0223\u0902 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0247\u0964 \u0907\u0938\u093f\u0932\u090f, \u01d2\u0935\u0935\u0930\u0923 \u0915\u0947 \n\u0905\u0928\u0941\u00cd\u091b\u0947\u0926 9 \u092e\u0245 \u090f\u0915 \u01d2\u0935\u0935\u093e\u0926 \u0909\u0920\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u01d1\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \n\u0915\u093e \u0939\u0915\u0926\u093e\u0930 \u0925\u093e\u0964 \u0907\u0938\u093f\u0932\u090f, 8 \u0905\u0917\u00e8\u0924 1997 \u0915\u094b \u0915\u092e \u0938\u0947 \u0915\u092e \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \n\u01ae\u093e\u0930\u093e \u090f\u0915 \u01d2\u0935\u093f\u0936\u01b4 \u092e\u093e\u092e\u0932\u093e \u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u01d1\u0915 \u0935\u0939 \u0932\u093e\u092d\u0124\u0926 \u01fe\u092a \u0938\u0947 \n\u093f\u0928\u092f\u0941\u01a0 \u0928\u0939\u0223\u0902 \u0925\u093e\u0964 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u01d1\u0926\u0928\u093e\u0902\u0915 18 \u091c\u0941\u0932\u093e\u0908 2008 \u0915\u094b \u090f\u0915 \u0936\u092a\u0925-\n\u092a\u011f \u0926\u093e\u092f\u0930 \u01d1\u0915\u092f\u093e \u0925\u093e \u01d4\u091c\u0938\u092e\u0947 \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u00a2 \u0909\u00db\u0939\u0249\u0928\u0947 \u0924\u0915[  \n\u01d1\u0926\u092f\u093e \u01d1\u0915 \u0935\u0939 \u092c\u0916\u093e[\u00e8\u0924\u0917\u0940 \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0925\u0947 \u0914\u0930 \u0917\u0902\u092d\u0940\u0930 \n\u0906\u093f\u0925[\u0915 \u0915\u01d1\u0920\u0928\u093e\u0908 \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964 \u0939\u093e\u0932\u093e\u0902\u01d1\u0915, \u0909\u01a0 \u0936\u092a\u0925-\u092a\u011f \n\u0935\u093e\u092a\u0938 \u0932\u0947 \u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u0914\u0930 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u01ae\u093e\u0930\u093e 4 \u093f\u0938\u0924\u0902\u092c\u0930 2008 \u0915\u094b \n\n7 \n \n\u0938\u093e\u00ea\u092f \u0915\u093e \u090f\u0915 \u0928\u092f\u093e \u0936\u092a\u0925-\u092a\u011f \u0926\u093e\u092f\u0930 \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u01d4\u091c\u0938\u092e\u0245 \u0930\u094b\u091c\u0917\u093e\u0930 \n\u0124\u093e\u01af \u0915\u0930\u0928\u0947 \u092e\u0245 \u01d2\u0935\u092b\u0932\u0924\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0245 \u090f\u0915 \u01d2\u0935\u093f\u0936\u01b4 \u0926\u093e\u0935\u0947 \u0915\u094b \u0936\u093e\u093f\u092e\u0932 \u0928\u0939\u0223\u0902 \n\u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0939\u093e\u0932\u093e\u0902\u01d1\u0915, \u0124\u092c\u0902\u0927\u0928 \u0915\u0947 \u0905\u093f\u0927\u0935\u01a0\u093e \u01ae\u093e\u0930\u093e \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \n\u0938\u092e\u00a2 \u0907\u0938 \u092a\u0939\u0932\u0942 \u092a\u0930 \u0909\u0928\u0915\u0227 \u0124\u093f\u0924\u092a\u0930\u0223\u00a2\u093e \u092f\u0939 \u0938\u0941\u091d\u093e\u0935 \u0926\u0947\u0924\u0947 \u0939\u0941\u090f \u0915\u0227 \u0917\u0908 \u0925\u0940 \n\u01d1\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0905\u092a\u0928\u0947 \u092a\u01d0\u0930\u0935\u093e\u0930 \u0915\u093e \u092d\u0930\u0923-\u092a\u094b\u0937\u0923 \u0915\u0930\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f \u092a\u092f\u093e[\u01af \n\u0930\u093e\u093f\u0936 \u0915\u092e\u093e \u0930\u0939\u0947 \u0925\u0947\u0964 \u0939\u093e\u0932\u093e\u0902\u01d1\u0915, \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u0909\u01a0 \u0938\u0941\u091d\u093e\u0935 \u0915\u0227 \u0938\u00d7\u092f\u0924\u093e \u0938\u0947 \n\u0907\u0928\u0915\u093e\u0930 \u0915\u0930 \u01d1\u0926\u092f\u093e\u0964  \u0907\u0938\u093f\u0932\u090f, \u0938\u0947\u0935\u093e \u0938\u0947 \u0938\u092e\u093e\u093f\u01af \u0915\u0947 \u0924\u0947\u0930\u0939 \u092e\u0939\u0223\u0928\u0947 \u092c\u093e\u0926 \n\u0926\u093e\u092f\u0930 \u0926\u093e\u0935\u093e \u01d2\u0935\u0935\u0930\u0923 \u092e\u0245 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u01ae\u093e\u0930\u093e \u090f\u0915 \u01d2\u0935\u093f\u0936\u01b4 \u0926\u093e\u0935\u093e \u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e \n\u01d1\u0915 \u0935\u0939 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0925\u093e\u0964 \u0124\u00d7\u092f\u0925\u0238 \u01ae\u093e\u0930\u093e \u0905\u093f\u092d\u0932\u0947\u0916 \u092a\u0930 \u0928 \u0924\u094b \u0915\u094b\u0908 \u0938\u093e\u092e\u0112\u0940 \n\u0930\u0916\u0940 \u0917\u0908 \u0939\u0948 \u091c\u094b \u092f\u0939 \u0926\u0936\u093e[\u0924\u0940 \u0939\u0948 \u01d1\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0947 \u092a\u093e\u0938 \u0906\u092f \u0915\u093e \u01b8\u094b\u0924 \u0925\u093e \n\u0914\u0930 \u0928 \u0939\u0223 \u0124\u00d7\u092f\u0925\u0238 \u01ae\u093e\u0930\u093e \u0124\u093f\u0924\u092a\u0930\u0223\u00a2\u093e \u0915\u0947 \u0938\u092e\u092f \u0915\u0941\u091b \u092d\u0940 \u0938\u093e\u092e\u0112\u0940 \u0124\u093e\u01af \u0915\u0227 \n\u0917\u0908 \u0939\u0948\u0964   \n9. \u0915\u093e\u0928\u0942\u0928 \u0938\u0941\u00e8\u0925\u093e\u01d2\u092a\u0924 \u0939\u0948\u0964 \u092f\u0939\u093e\u0902 \u0924\u0915 \u01d1\u0915 \u0905\u0917\u0930 \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0938\u0947\u0935\u093e \u092e\u0245 \u092c\u0939\u093e\u0932\u0940 \n\u0915\u093e \u0906\u0926\u0947\u0936 \u092a\u093e\u01d0\u0930\u0924 \u0915\u0930\u0924\u093e \u0939\u0948 \u0924\u094b \u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093e \u0906\u0926\u0947\u0936 \n\u00e8\u0935\u0924\u0903 \u0928\u0939\u0223\u0902 \u0939\u094b\u0917\u093e\u0964 \u092f\u0939 \u0938\u092c \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0924\u00d8\u092f\u0249 \u0914\u0930 \u092a\u01d0\u0930\u01d4\u00e8\u0925\u093f\u0924\u092f\u0249 \u092a\u0930 \n\u093f\u0928\u092d[\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0938\u091a \u0939\u0948 \u01d1\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u01ae\u093e\u0930\u093e 18 \u091c\u0941\u0932\u093e\u0908, 2008 \u0915\u094b \n\u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u00a2 \u0926\u093e\u092f\u0930 \u0936\u092a\u0925-\u092a\u011f \u092e\u0245 \u0936\u092a\u0925 \u0932\u0947\u0915\u0930 \u00e8\u092a\u01b4 \u092c\u092f\u093e\u0928 \n\u01d1\u0926\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u01d1\u0915 \u0909\u00db\u0939\u0245 \u092c\u0916\u093e[\u00e8\u0924\u0917\u0940 \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0915\u0947 \u092a\u01b1\u093e\u0924  \u0928\u094c\u0915\u0930\u0223 \u0928\u0939\u0223\u0902 \n\n8 \n \n\u093f\u092e\u0932\u0940 \u0925\u0940 \u0915\u094b \u0935\u093e\u092a\u0938 \u0932\u0947 \u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u0938\u093e\u00ea\u092f \u0915\u0947 \u01fe\u092a \u092e\u0245 \u0926\u093e\u092f\u0930 \u0928\u090f \n\u0936\u092a\u0925-\u092a\u011f \u092e\u0245 \u0907\u0938 \u0924\u0930\u0939 \u0915\u093e \u0915\u094b\u0908 \u01d2\u0935\u093f\u0936\u01b4 \u01d2\u0935\u0935\u093e\u0926 \u0928\u0939\u0223\u0902 \u0909\u0920\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \n\u0932\u0947\u01d1\u0915\u0928 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0947 \u092a\u00a2 \u092e\u0245 \u0926\u094b \u0915\u093e\u0930\u0915 \u0939\u0247\u0964 \u0926\u093e\u0935\u093e \u01d2\u0935\u0935\u0930\u0923 \u092e\u0245 \u092f\u0939 \u01d2\u0935\u0936\u0947\u0937 \n\u01fe\u092a \u0938\u0947 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948 \u01d1\u0915 \u0905\u0917\u00e8\u0924 1997 \u0924\u0915 \u091c\u092c \u0926\u093e\u0935\u093e \u01d2\u0935\u0935\u0930\u0923 \u0926\u093e\u092f\u0930 \n\u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u0905\u092a\u0940\u0932\u0915\u0924\u093e[ \u0915\u094b \u0930\u094b\u091c\u0917\u093e\u0930 \u093f\u092e\u0932\u0928\u093e \u092e\u0941\u01d4\u00e6\u0915\u0932 \u0925\u093e \u0914\u0930 \n\u0935\u093e\u00e8\u0924\u0935 \u092e\u0245 \u0935\u0939 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0925\u093e\u0964 \u0926\u0942\u0938\u0930\u093e \u092a\u0939\u0932\u0942 \u092f\u0939 \u0939\u0948 \u01d1\u0915 \u0124\u00d7\u092f\u0925\u0238 \u0915\u0947 \n\u0905\u093f\u0927\u0935\u01a0\u093e \u01ae\u093e\u0930\u093e \u0907\u0938 \u092e\u0941\u01a7\u0947 \u092a\u0930 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0227 \u0124\u093f\u0924\u092a\u0930\u0223\u00a2\u093e \u0915\u0227 \u0917\u0908 \u0939\u0948 \u0914\u0930 \n\u0124\u093f\u0924\u092a\u0930\u0223\u00a2\u093e \u092e\u0245 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u0907\u0928\u0915\u093e\u0930 \u0915\u0930 \u01d1\u0926\u092f\u093e \u01d1\u0915 \u0909\u0938\u0915\u0947 \u092a\u093e\u0938 \u0905\u092a\u0928\u0947 \n\u092a\u01d0\u0930\u0935\u093e\u0930 \u0915\u0227 \u0926\u0947\u0916\u092d\u093e\u0932 \u0915\u0947 \u093f\u0932\u090f \u0906\u092f \u0915\u093e \u092a\u092f\u093e[\u01af \u01b8\u094b\u0924 \u0939\u0948\u0964  \u0939\u093e\u0932\u093e\u0902\u01d1\u0915, \u092a\u0939\u0932\u0947 \n\u0938\u0947 \u0926\u093e\u092f\u0930 \u0936\u092a\u0925-\u092a\u011f \u0915\u094b \u0935\u093e\u092a\u0938 \u0932\u0947\u0928\u0947 \u0914\u0930 \u0928\u090f \u0936\u092a\u0925-\u092a\u011f \u092e\u0245 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930\u0223 \u0915\u0947 \n\u0924\u0915[  \u0915\u094b \u0928\u0939\u0223\u0902 \u0909\u01d4\u00e3\u0932\u01d4\u0916\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0947 \u0906\u091a\u0930\u0923 \u0915\u094b \u00da\u092f\u093e\u0928 \u092e\u0245 \n\u0930\u0916\u0924\u0947 \u0939\u0941\u090f \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u0938\u0947\u0935\u093e \u0938\u092e\u093e\u093f\u01af \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u092c\u0939\u093e\u0932\u0940 \u0924\u0915 \u0915\u0227 \n\u092a\u0942\u0930\u0223 \u0905\u0935\u093f\u0927 \u0915\u0947 \u093f\u0932\u090f \u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \u0915\u093e \u0932\u093e\u092d \u0928\u0939\u0223\u0902 \u01d1\u0926\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \n\u092f\u0939 \u00e8\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u093e \u0938\u0902\u092d\u0935 \u0928\u0939\u0223\u0902 \u0939\u0948 \u01d1\u0915 \u0924\u0947\u0930\u0939 \u0935\u0937\u025f \u0915\u0227 \u092a\u0942\u0930\u0223 \u0905\u0935\u093f\u0927 \u0915\u0947 \n\u093f\u0932\u090f \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0947 \u092a\u093e\u0938 \u0906\u092f \u0915\u093e \u0915\u094b\u0908 \u01b8\u094b\u0924 \u0928\u0939\u0223\u0902 \u0925\u093e\u0964 \u0939\u093e\u0932\u093e\u0902\u01d1\u0915, \u0124\u00d7\u092f\u0925\u0238 \n\u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u092e\u0928\u0947 \u0928\u0939\u0223\u0902 \u0906\u092f\u093e \u0939\u0948 \u01d1\u0915 \u0938\u0947\u0935\u093e \u0938\u0947 \u0939\u091f\u093e\u090f \u091c\u093e\u0928\u0947 \u0915\u0227 \n\u0924\u093e\u0930\u0223\u0916 \u0938\u0947 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u0947 \u092a\u093e\u0938 \u0906\u092f \u0915\u093e \u0926\u0942\u0938\u0930\u093e \u01b8\u094b\u0924 \u0925\u093e\u0964 \u0907\u0938 \u0124\u0915\u093e\u0930 \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0928\u0947 \u092f\u0939 \u00e8\u0925\u093e\u01d2\u092a\u0924 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0926\u093e\u093f\u092f\u00d7\u0935 \u0915\u093e \u093f\u0928\u0935[\u0939\u0928 \u01d1\u0915\u092f\u093e \u01d1\u0915 \n\n9 \n \n\u0935\u0939 \u0915\u092e \u0938\u0947 \u0915\u092e \u0905\u0917\u00e8\u0924 1997 \u0924\u0915 \u092c\u0947\u0930\u094b\u091c\u0917\u093e\u0930 \u0925\u093e\u0964  \u0124\u00d7\u092f\u0925\u0238 \u0915\u0227 \u0913\u0930 \n\u0938\u0947 \u092a\u0947\u0936 \u0905\u093f\u0927\u0935\u01a0\u093e \u01ae\u093e\u0930\u093e \u0905\u093f\u092d\u0932\u0947\u0916 \u092a\u0930 \u0124\u00e8\u0924\u0941\u0924 \u091a\u093e\u091f[ \u0938\u0947 \u0939\u092e \u092a\u093e\u0924\u0947 \u0939\u0247 \u01d1\u0915 \n\u092c\u0939\u093e\u0932\u0940 \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u092a\u0930 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u093e \u0938\u0915\u0932 \u0935\u0947\u0924\u0928 18,830/- \u01fd\u092a\u090f \u0925\u093e\u0964 \n\u0939\u091f\u093e\u090f \u091c\u093e\u0928\u0947 \u0915\u0227 \u0924\u093e\u0930\u0223\u0916 \u0915\u094b, \u0909\u0928\u0915\u093e \u0935\u0947\u0924\u0928 \u0932\u0917\u092d\u0917 4,000/- \u01fd\u092a\u092f\u0947 \u0124\u093f\u0924 \n\u092e\u093e\u0939 \u0925\u093e\u0964 \n10. \u0939\u092e\u093e\u0930\u093e \u01d2\u0935\u091a\u093e\u0930 \u0939\u0948 \u01d1\u0915 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0924\u00d8\u092f\u0249 \u092a\u0930 \u01d2\u0935\u091a\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f, \u092f\u0939 \n\u0909\u093f\u091a\u0924 \u0939\u094b\u0917\u093e \u01d1\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u092c\u0915\u093e\u092f\u093e \u0935\u0947\u0924\u0928 \u0915\u0947 \u092c\u0926\u0932\u0947 3 \u0932\u093e\u0916 \u01fd\u092a\u090f \u0915\u0227 \n\u0930\u093e\u093f\u0936 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u0926\u0947\u0936 \u01d1\u0926\u092f\u093e \u091c\u093e\u090f\u0964 \u0909\u0938 \u0939\u0926 \u0924\u0915, \u0905\u092a\u0940\u0932 \n\u0938\u092b\u0932 \u0939\u094b\u0928\u0940 \u091a\u093e\u01d1\u0939\u090f\u0964   \n11. \u0924\u0926\u0928\u0941\u0938\u093e\u0930, \u012e\u092e \u00db\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \u01d1\u0926\u0928\u093e\u0902\u0915 17 \u092e\u093e\u091a[, 2009 \u0915\u093e \n\u0905\u093f\u0927\u093f\u0928\u0923[\u092f \u0914\u0930 \u0909\u00cd\u091a \u00db\u092f\u093e\u092f\u093e\u0932\u092f\u0249 \u0915\u0947 \u0906\u00a2\u0947\u01d2\u092a\u0924 \u093f\u0928\u0923[\u092f\u0249 \u0915\u094b \u0938\u0902\u0936\u094b\u093f\u0927\u0924 \n\u01d1\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u092e \u0124\u00d7\u092f\u0925\u0238 \u0915\u094b \u0906\u091c \u0938\u0947 \u0926\u094b \u092e\u0939\u0223\u0928\u0947 \u0915\u0227 \u0905\u0935\u093f\u0927 \u0915\u0947 \u092d\u0940\u0924\u0930 \n\u0905\u092a\u0940\u0932\u093e\u0925\u0238 \u0915\u094b \u092c\u0915\u093e\u090f 