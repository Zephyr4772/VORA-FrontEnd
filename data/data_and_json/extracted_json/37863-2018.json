    "full_text": "1 \n \n\u0938\u0902\u092a\u094d\u0930\u0915\u093e\u0936\u0928\u0940\u092f \n\u0909\u091a\u094d\u091a\u0924\u092e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f, \u092d\u093e\u0930\u0924  \n\u0926\u093e\u0923\u094d\u0921\u093f\u0915 \u0905\u092a\u0940\u0932\u0940\u092f \u0905\u0927\u093f\u0915\u093e\u0930\u0930\u0924\u093e \n\u0915\u094d\u0930\u093f\u092e\u092e\u0928\u0932 \u0905\u092a\u0940\u0932 \u0938\u0902. 1244/2019 \n(SLP (Crl.) No. 8801/2018 \u0938\u0947 \u0909\u0926\u094d\u092d\u0942\u0924)  \n\u0938\u0932\u0940\u092e \u0905\u0939\u092e\u0926                      \n \n \n........ \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940  \n\u092c\u0928\u093e\u092e  \n\u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f                                          ........\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \n\u0928\u093f\u0930\u094d\u0923\u092f \n\u0905\u092d\u092f \u092e\u093f\u094b\u0939\u0930, \u0928\u094d\u092f\u093e\u092f\u093e\u0927\u0940\u0936  \n1. \u0905\u0928\u0941\u092e\u0924\u0924 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u092f\u0940 | \n2. \u092f\u0939 \u0905\u092a\u0940\u0932 \u0926\u0926\u0932\u094d\u0932\u0940 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e Criminal M.C. No. 4476/2018 \u092e\u0947\u0902 \n\u092a\u093e\u0930\u0930\u0924 \u0905\u0902\u0924\u0924\u092e \u0924\u0928\u0930\u094d\u0923\u092f \u0926\u0926\u0928\u093e\u0902\u0915 05.09.2018  \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u093f \u0926\u093e\u092f\u0930 \u0915\u0940 \u0917\u092f\u0940 \u0939\u0948 \u0923\u094d\u093f\u0938\u092e\u0947 \u0909\u091a\u094d\u091a \n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u093e\u092f\u0930 \u092f\u093e\u0927\u091a\u0915\u093e \u0915\u094b \u0916\u093e\u0930\u0930\u095b \u0915\u0930 \u0926\u0926\u092f\u093e \u0930\u094d\u0925\u093e |  \n3. \u0905\u092a\u0940\u0932 \u092e\u0947\u0902 \u090f\u0915 \u0932\u0918\u0941 \u092c\u092c\u0902\u0926\u0941 \u0938\u0923\u094d\u092e\u092e\u092e\u0932\u0924 \u0939\u0948 \u093f\u094b \u0924\u0928\u092e\u0928\u092e\u0932\u0916\u0916\u0924 \u092c\u0924\u093e\u092f\u0947 \u0917\u090f \u0924\u0925\u094d\u092f\u094b\u0902 \u0938\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \n\u0939\u094b\u0917\u093e | \n4. \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u092e\u0915\u093e\u0928 \u0928\u0902\u092c\u0930 F-11/75, (\u090f\u0938\u090f\u092b), \u0916\u0938\u0930\u093e \u0928\u0902\u092c\u0930 2271/4, \u092e\u093e\u0932\u0935\u0940\u092f \u0928\u0917\u0930, \n\u0916\u0916\u0930\u0915\u0940 \u090f\u0915\u094d\u0938\u091f\u0947\u0902\u0936\u0928, \u0928\u0908 \u0926\u0926\u0932\u094d\u0932\u0940 \u0915\u093e \u092e\u093e\u092e\u0932\u0915 \u0939\u0948 | \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0928\u0947 \u0907\u0938 \u092e\u0915\u093e\u0928 \u0915\u094b \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \n\u0928\u0902\u092c\u0930-3 (\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \u0928\u0902\u092c\u0930-3 \u0915\u093e \u0928\u093e\u092e \u092a\u093e\u0926\u091f\u0923\u092f\u094b\u0902 \u0915\u0947 \u0928\u093e\u092e \u0938\u0947 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u0926\u0928\u093e\u0902\u0915 \n25.04.2019 \u0915\u0947 \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u091f\u093e \u0926\u0926\u092f\u093e \u0930\u094d\u0925\u093e) \u0915\u094b \u092e\u093e\u092e\u0938\u0915 \u0915\u094d\u0930\u0915\u0930\u093e\u092f\u0947 \u092a\u0930 \u0926\u0926\u092f\u093e \u0930\u094d\u0925\u093e |  \n\n2 \n \n5. 15.12.2014 \u0915\u094b BSES \u0930\u093e\u093f\u093f\u093e\u0928\u0940 \u092a\u0949\u0935\u0930 \u092e\u0932\u092e\u092e\u091f\u0947\u093f \u0915\u0947 \u092a\u094d\u0930\u0935\u0924\u0923\u0928 \u0935\u0935\u092d\u093e\u0917 \u0915\u0947 \u0915\u092e\u0923\u091a\u093e\u0930\u0930\u092f\u094b\u0902 -\n\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \u0928\u0902\u092c\u0930-2, \u0928\u0947 \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u092e\u0915\u093e\u0928 \u092e\u0947\u0902 \u0932\u0917\u0947 \u0939\u0941\u090f \u092c\u092c\u093f\u0932\u0940 \u0915\u0947 \u092e\u0940\u091f\u0930 \u0915\u0940 \u093f\u093e\u093e\u0901\u091a \u0915\u0940 \u0930\u094d\u0925\u093e \u0914\u0930 \n\u092a\u093e\u092f\u093e \u0915\u094d\u0930\u0915 \u092e\u0940\u091f\u0930 \u0938\u0939\u0940 \u0930\u0940\u0921\u093f\u0902\u0917 \u0930\u0930\u0915\u0949\u093f\u0923 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u093e \u0930\u094d\u0925\u093e | \n6. \u092e\u0938\u0926\u094d\u0915\u0930\u0930\u094d \u0915\u0930\u0928\u0947 \u0915\u0947 \u092a\u0936\u094d\u091a\u093e\u0924, BSES \u0928\u0947 \u092c\u092c\u093f\u0932\u0940 \u0915\u0940 \u0916\u092a\u0924 \u0915\u0947 \u0938\u092e\u092c\u0928\u094d\u093f \u092e\u0947\u0902 \u0906\u0902\u0915\u0932\u0928 \n\u0915\u094d\u0930\u0915\u092f\u093e \u0914\u0930 \u0907\u0938\u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \u0928\u0902\u092c\u0930-3 \u0915\u094b \u092d\u0940 \u091a\u094b\u0930\u0940 \u0915\u0947 \u092e\u0932\u090f \u0930\u0941\u092a\u090f \n97,786/- \u0915\u093e \u092c\u092c\u0932 \u092d\u0947\u093f\u093e, \u0915\u094d\u092f\u094b\u0902\u0915\u094d\u0930\u0915 \u0935\u0939 BSES \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u0940 \u093f\u093e \u0930\u0939\u0940 \u092c\u092c\u093f\u0932\u0940 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \n\u0930\u0939\u0947 \u0918\u0930 \u0915\u0947 \u0905\u0927\u093f\u0935\u093e\u0938 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u093e\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e | \u0924\u0926\u0928\u0941\u0938\u093e\u0930 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940 \u0928\u0902\u092c\u0930-3 \n\u0915\u0947 \u0916\u0916\u0932\u093e\u095e \u092e\u093e\u092e\u0932\u093e \u0926\u093f\u0923 \u0915\u094d\u0930\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e \u0923\u094d\u093f\u0938\u0915\u093e \u0915\u0947\u0938 \u0928\u0902\u092c\u0930 ID-RJ 151214SC102 \n(CRN No. 25201 72444/SAKET) - PLA No.1/37/2015 \u0939\u0948 |  \n7. 27.02.2015 \u0915\u094b BSES \u0928\u0947, \u0905\u092a\u0928\u0947 \u0935\u0935\u092e\u092d\u0928\u094d\u0928 \u0935\u0938\u0942\u0932\u0940 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u0947 \u0924\u0928\u092a\u091f\u093e\u0928 \u0939\u0947\u0924\u0941 \u0935\u0935\u0927\u093f\u0915 \n\u0938\u0947\u0935\u093e \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0930\u094d \u0905\u0927\u093f\u0924\u0928\u092f\u092e 1987 \u0915\u0947 \u092a\u094d\u0930\u093e\u0935\u093f\u093e\u0928\u094b\u0902 \u0915\u0947 \u0924\u0939\u0924 \u0926\u0926\u0932\u094d\u0932\u0940 \u0915\u0947 \u0905\u093f\u0940\u0928\u0938\u094d\u0930\u094d\u0925 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u094b\u0902 \n\u092e\u0947\u0902 \u0938\u094d\u0930\u094d\u0925\u093e\u092f\u0940 \u0932\u094b\u0915 \u0905\u0926\u093e\u0932\u0924-I \u0915\u093e \u0906\u092f\u094b\u093f\u0928 \u0915\u094d\u0930\u0915\u092f\u093e \u0930\u094d\u0925\u093e | \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u093e \u092e\u093e\u092e\u0932\u093e \u092d\u0940 \u0924\u0928\u092a\u091f\u093e\u0928 \n\u0939\u0947\u0924\u0941 \u0932\u0917\u093e \u0939\u0941\u0906 \u0930\u094d\u0925\u093e | \n8. 27.02.2015  \u0915\u0947 \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e (\u0938\u0932\u0902\u0917\u094d\u0928\u0915 P-2), \u0930\u0941\u092a\u090f 97,786/- \u0915\u0947 \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u092c\u092c\u0932 \u0915\u0947 \n\u092e\u093e\u092e\u0932\u0947 \u0915\u094b \u0930\u0942\u092a\u090f 83,120/- \u0915\u0940 \u092a\u0942\u0930\u094d\u0923 \u090f\u0935\u0902 \u0905\u0902\u0924\u0924\u092e \u0930\u0915\u092e \u0939\u0947\u0924\u0942 \u0924\u0928\u092a\u091f\u093e\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e | \u0924\u0926\u0928\u0941\u0938\u093e\u0930 \n\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0928\u0947 BSES \u0915\u094b \u0926\u0926\u0928\u093e\u0902\u0915 27.02.2015 \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u0947 \u0924\u0939\u0924 3 \u092c\u0930\u093e\u092c\u0930 \u0915\u094d\u0930\u0915\u0936\u094d\u0924\u094b\u0902 \u092e\u0947\u0902  \n\u0930\u0942\u092a\u090f 83,120/- \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u094d\u0930\u0915\u092f\u093e | \u0906\u0926\u0947\u0936 \u0924\u0928\u092e\u0928 \u092a\u094d\u0930\u0915\u093e\u0930 \u0938\u0947 \u092a\u095d\u093e \u093f\u093e\u090f:-  \n\u201c\u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902, \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0926\u093f\u093f\u093e\u093e\u0902\u0915 15.12.2004 \u0915\u0940 \u091c\u093e\u093e\u0901\u093f \u0915\u0947 \n\u0906\u0927\u093e\u0930 \u092a\u0930 \u0930\u0941\u092a\u090f 97,786/- \u0915\u0947 DT \u092c\u093f\u0932 \u0915\u0947 \u0938\u092e\u094d\u093f\u0928\u094d\u0927 \u092e\u0947\u0902 \u0928\u093f\u092a\u091f\u093e\u093f \u0939\u0947\u0924\u0941 \u0906\u090f \u0925\u0947 | \n\n3 \n \n\u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923 \u0915\u0940 \u0924\u0930\u092b \u0938\u0947 \u0928\u093f\u092a\u091f\u093e\u093f \u0939\u0947\u0924\u0941 \u090f\u0915 \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u091c\u094b \u0926\u093f\u093f\u093e\u093e\u0902\u0915 \n13.02.2015  \u0915\u0947 \u0906\u093f\u0947\u0936 \u092e\u0947\u0902 \u093f\u091c\u0923 \u0939\u0948 |  \n \n \n\u0936\u094d\u0930\u0940 \u0930\u093e\u091c\u0947\u0936 \u0905\u0930\u094b\u095c\u093e \u093f\u0947 \u0915\u0939\u093e \u0915\u0915 \u0907\u0938 \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0915\u094b \u093f\u0947\u0916\u093f\u0947 \u0915\u0947 \u093f\u093e\u093f \u0938\u0915\u094d\u0937\u092e \n\u092a\u094d\u0930\u093e\u091a\u0927\u0915\u093e\u0930\u0940 \u0907\u0938 \u092c\u093f\u0932 \u0915\u094b \u0930\u0942\u092a\u090f 83,120/- \u092e\u0947\u0902 \u0928\u093f\u092a\u091f\u093e\u093f \u0939\u0947\u0924\u0941 \u0938\u0939\u092e\u0924 \u0939\u0941\u090f \u0939\u0948\u0902 | \u092f\u0939 \n\u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923 \u0915\u0947 \u0935\u0935\u0926\u094d\u0935\u093e\u093f \u0905\u091a\u0927\u0935\u0915\u094d\u0924\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u092d\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0915\u092f\u093e \u0917\u092f\u093e | \n\u0924\u093f\u093f\u0941\u0938\u093e\u0930, \u092a\u093e\u0926\u091f\u0923\u092f\u094b\u0902 \u0915\u0947 \u093f\u0940\u093f \u092f\u0939 \u0938\u0939\u092e\u0924\u0940 \u0939\u0941\u0908 \u0915\u0915 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923, \u0930\u0941\u092a\u090f 97,786/- \u0915\u0947 \n\u0906\u0915\u094d\u0937\u0947\u0935\u092a\u0924 \u092c\u093f\u0932 \u0939\u0947\u0924\u0941 \u0930\u0942\u092a\u090f 83,120/- \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u093f \u092a\u0942\u0930\u094d\u0923 \u090f\u0935\u093e\u0902 \u0905\u093e\u0902\u0928\u0924\u092e \u0928\u093f\u092a\u091f\u093e\u093f \u0915\u0947 \u0924\u094c\u0930  \n\u0915\u0930\u0947\u0902\u0917\u0947 | \u092f\u0939 \u092d\u0940 \u092a\u093e\u0926\u091f\u0923\u092f\u094b\u0902 \u0915\u0947 \u093f\u0940\u093f \u0938\u0939\u092e\u0924\u0940 \u093f\u093f\u0940 \u0915\u0915 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923 \u0930\u0942\u092a\u090f 83,120/- \u0915\u0947 \n\u0915\u091a\u0925\u0924 \u0930\u0915\u092e \u0915\u094b \u0924\u0940\u093f \u093f\u0930\u093e\u093f\u0930 \u0915\u0915\u0936\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u091c\u092e\u093e \u0915\u0930\u0947\u0902\u0917\u0947 | \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0939\u0932\u0940 \n\u0915\u0915\u0936\u094d\u0924 \u0915\u0940 \u0930\u0915\u092e 09.03.2015 \u0924\u0915 \u092f\u093e \u092a\u0939\u0932\u0947, \u093f\u0942\u0938\u0930\u0940 \u0915\u0915\u0936\u094d\u0924 \u0915\u0940 \u0930\u0915\u092e 30.03.2015 \n\u0924\u0915 \u092f\u093e \u092a\u0939\u0932\u0947 \u0914\u0930 \u0924\u0940\u0938\u0930\u0940 \u0915\u0915\u0936\u094d\u0924 \u0915\u0940 \u0930\u0915\u092e 30.04.2015 \u0924\u0915 \u092f\u093e \u092a\u0939\u0932\u0947 \u091c\u092e\u093e \u0915\u0940 \n\u091c\u093e\u090f\u0917\u0940 | \u0915\u091a\u0925\u0924 \u0930\u0915\u092e \u090f\u093e\u0902\u0921\u094d\u0930\u0942\u0938 \u0917\u093e\u0902\u091c \u0915\u093e\u092f\u093e\u0923\u0932\u092f \u092e\u0947\u0902 \u091c\u092e\u093e \u0915\u0930\u093e\u0908 \u091c\u093e\u090f\u0917\u0940 | \u092f\u0939 \u092d\u0940 \n\u0938\u0939\u092e\u0924 \u0915\u0915\u092f\u093e \u0917\u092f\u093e \u0915\u0915 \u092f\u0926\u093f \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923 \u0915\u0915\u0938\u0940 \u092d\u0940 \u0915\u0915\u0936\u094d\u0924 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u093f \u093f\u0939\u0940\u093e\u0902 \u0915\u0930\u0924\u0947 \n\u0939\u0948\u0902 \u0924\u094b \u0935\u0939 \u0906\u0915\u094d\u0937\u0947\u0935\u092a\u0924 \u092c\u093f\u0932 \u0915\u0947 \u092a\u0942\u0930\u094d\u0923 \u0930\u0915\u092e \u0915\u094b \u0924\u0924\u094d\u0915\u093e\u0932 \u092d\u0941\u0917\u0924\u093e\u093f \u0915\u0930\u093f\u0947 \u0939\u0947\u0924\u0941 \u0909\u0930\u094d\u0924\u094d\u0930\u093f\u093e\u0928\u092f\u0924\u094d\u0935 \n\u0939\u094b\u0902\u0917\u0947 |  \n \n \n\u092f\u0939 \u092d\u0940 \u092e\u093e\u093f\u093e \u0917\u092f\u093e \u0915\u0915 \u092a\u0939\u0932\u0940 \u093f\u094b \u0915\u0915\u0936\u094d\u0924\u0947\u0902 \u091c\u092e\u093e \u0915\u0930\u093f\u0947 \u0915\u0947 \u093f\u093e\u093f \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u093e\u0923 \u0915\u0947 \n\u0926\u094d\u0935\u093e\u0930\u093e \u093f\u090f \u0915\u093f\u0947\u0915\u094d\u0936\u093f \u0915\u0947 \u0928\u093f\u092e\u094b\u093f\u093f \u0939\u0947\u0924\u0941 \u0905\u093f\u0941\u0930\u094b\u0927 \u091c\u0932\u094d\u093f\u0940 \u090f\u0935\u093e\u0902 \u0924\u0924\u094d\u0915\u093e\u0932 \u092a\u0942\u0930\u093e \u0915\u0915\u092f\u093e \n\u091c\u093e\u092f\u0947\u0917\u093e \u0914\u0930 \u093f\u092f\u093e \u0915\u093f\u0947\u0915\u094d\u0936\u093f \u093f\u0942\u0938\u0930\u0940 \u0915\u0915\u0936\u094d\u0924 \u0915\u0947 \u091c\u092e\u093e \u0915\u0930\u093f\u0947 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 \u0938\u0947 \u090f\u0915 \u0938\u092a\u094d\u0924\u093e\u0939 \n\u0915\u0947 \u092d\u0940\u0924\u0930 \u0907\u0938 \u0936\u0924\u0923 \u092a\u0930 \u0928\u093f\u092e\u094b\u091a\u093f\u0924 \u0915\u0915\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u091c\u091c\u0938\u092e\u0947\u0902 \u0938\u093e\u0902\u093f\u093e\u0902\u091a\u0927\u0924 \u0914\u092a\u093f\u093e\u0930\u0930\u0915\u0924\u093e\u0913\u093e\u0902 \u0915\u0947 \n\n4 \n \n\u092a\u0942\u0930\u093e \u0939\u094b\u093f\u0947 \u092a\u0930 \u091c\u091c\u0938\u092e\u0947\u0902 \u092a\u094d\u0930\u0936\u094d\u093f\u0917\u0924 \u092e\u0915\u093e\u093f \u0939\u0947\u0924\u0941 \u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u093f\u0947\u092f \u0930\u0915\u092e \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u093f \u092d\u0940 \n\u0938\u092e\u094d\u092e\u0932\u0932\u0924 \u0939\u0948\u0902 |  \n \n \n\u0907\u0938 \u0906\u093f\u0947\u0936 \u0915\u0947 \u0938\u093e\u0925 \u092a\u093e\u0926\u091f\u0923\u092f\u094b\u0902 \u0915\u0947 \u093f\u0940\u093f \u0935\u0935\u0935\u093e\u093f \u0932\u092e\u0924\u094d\u0930\u0924\u093e\u092a\u0942\u0930\u094d\u0923 \u0928\u093f\u092a\u091f\u093e\u092f\u093e \u0917\u092f\u093e | \n\u0915\u091a\u0925\u0924 \u0928\u093f\u092a\u091f\u093e\u093f \u092c\u093f\u093f\u093e \u0915\u0915\u0938\u0940 \u093f\u093f\u093e\u0935, \u091c\u093f\u0930\u093f\u0938\u094d\u0924\u0940 \u092f\u093e \u0905\u093f\u0941\u091a\u093f\u0924 \u092a\u094d\u0930\u092d\u093e\u0935 \u0915\u0947 \u093f\u091c\u0923 \u0915\u0915\u092f\u093e \n\u0917\u092f\u093e | \u092a\u093e\u0926\u091f\u0923\u092f\u094b\u0902 \u0915\u094b \u0907\u0938 \u0928\u093f\u092a\u091f\u093e\u093f \u0915\u0947 \u0906\u093f\u0947\u0936 \u092a\u0930 \u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930 \u0915\u0930\u093f\u0947 \u0939\u0947\u0924\u0941 \u0928\u093f\u093f\u0947\u0936 \u0926\u093f\u092f\u093e \n\u091c\u093e\u0924\u093e \u0939\u0948\u0902 | \u0907\u0938 \u0906\u093f\u0947\u0936 \u0915\u0940 \u090f\u0915 \u092a\u094d\u0930\u0928\u0924\u0932\u0932\u0935\u092a \u092a\u093e\u0926\u091f\u0923\u092f\u094b\u0902 \u0915\u094b \u0905\u093f\u0941\u092a\u093e\u0932\u093f \u0939\u0947\u0924\u0941 \u093f\u0940 \u091c\u093e\u092f\u0947 |\u201d \n9. \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0924\u0928\u092a\u091f\u093e\u0928 \u090f\u0935\u0902 \u0930\u0915\u092e \u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0940, BSES \u0928\u0947 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926 \n\u092c\u092c\u093f\u0932\u0940 \u0905\u0927\u093f\u0924\u0928\u092f\u092e \u0915\u0940 \u093f\u093e\u0930\u093e 135 \u0915\u0947 \u0924\u0939\u0924 \u0926\u0926\u0928\u093e\u0902\u0915 21.03.2015 \u0915\u094b, \u0907\u0938\u0940 \u092e\u093e\u0902\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u093f \n\u092e\u0947\u0902, \u092e\u093e\u0932\u0935\u0940\u092f \u0928\u0917\u0930 \u092a\u0941\u092e\u0932\u0938 \u0930\u094d\u0925\u093e\u0928\u093e, \u0926\u0915\u094d\u0937\u093f\u0930\u094d \u0926\u0926\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 FIR No. 548/15 \u0926\u093f\u0923 \u0915\u0930\u093e\u0908 |  \n10. \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0928\u0947 \u0905\u092a\u0928\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926 FIR \u0915\u0947 \u0926\u093f\u0923 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0935\u094d\u092f\u0927\u0930\u094d\u0925\u0924 \u0939\u094b\u0915\u0930 CrPC, 1973 \u0915\u0940 \n\u093f\u093e\u0930\u093e 482 \u0915\u0947 \u0924\u0939\u0924 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902, \u0907\u0938 FIR \u0915\u0947 \u0926\u093f\u0923 \u0939\u094b\u0928\u0947 \u093f\u094b \u0935\u0935\u0927\u093f \u0905\u0928\u0941\u0938\u093e\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \n\u0915\u094b \u091a\u0941\u0928\u094c\u0924\u0940 \u0926\u0947\u0928\u0947 \u0939\u0947\u0924\u0941 \u092f\u093e\u0927\u091a\u0915\u093e \u0926\u093e\u092f\u0930 \u0915\u0930\u0940 |  \n11. \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0906\u093f\u0947\u0935\u092a\u0924 \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e \u092f\u093e\u0927\u091a\u0915\u093e \u0959\u093e\u0930\u0930\u093f \u0915\u0930 \u0926\u0940 \u0923\u094d\u093f\u0938\u0938\u0947 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \n\u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0905\u092a\u0940\u0932 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0935\u0935\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0924 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0909\u0926\u094d\u092d\u0942\u0924 \u0939\u0941\u0908 | \n12. \u092a\u093f\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u0935\u0935\u0926\u094d\u0935\u093e\u0928 \u0905\u0927\u093f\u0935\u0915\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u0941\u0928\u093e \u0917\u092f\u093e |  \n13. \u092a\u093f\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u0935\u0935\u0926\u094d\u0935\u093e\u0928 \u0905\u0927\u093f\u0935\u0915\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0938\u0941\u0928\u0928\u0947 \u0914\u0930 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0930\u0930\u0915\u0949\u093f\u0923 \u0915\u094b \u093f\u093e\u0902\u091a\u0928\u0947 \u0915\u0947 \n\u092c\u093e\u0926, \u0939\u092e, \u0905\u092a\u0940\u0932 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0924\u0947 \u0939\u0948\u0902, \u0906\u093f\u0947\u0935\u092a\u0924 \u0906\u0926\u0947\u0936 \u0915\u094b \u0924\u0928\u0930\u0938\u094d\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \nCrPC, 1973 \u0915\u0940 \u093f\u093e\u0930\u093e 482 \u0915\u0947 \u0924\u0939\u0924 \u0926\u093e\u092f\u0930 \u092f\u093e\u0927\u091a\u0915\u093e \u0915\u094b \u0905\u0928\u0941\u092e\u0924\u0924 \u0926\u0947\u0924\u0947 \u0939\u0948 \u0914\u0930 FIR No. \n548/15 \u0915\u094b \u0930\u0926\u094d\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 |  \n14. \u0939\u092e\u093e\u0930\u0947 \u092e\u0924 \u0905\u0928\u0941\u0938\u093e\u0930, \u093f\u092c \u0926\u0947\u092f \u0930\u0915\u092e \u0915\u0940 \u0935\u0938\u0942\u0932\u0940 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u0935\u0935\u093e\u0926 \u090f\u0915 \u092c\u093e\u0930 \u092a\u0942\u0930\u094d\u0923 \u0930\u0942\u092a \n\u0938\u0947 \u092a\u093e\u0926\u091f\u0923\u092f\u094b\u0902 (\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0914\u0930 BSES) \u0915\u0947 \u092c\u0940\u091a \u0932\u094b\u0915 \u0905\u0926\u093e\u0932\u0924 \u092e\u0947\u0902 \u0926\u0926\u0928\u093e\u0902\u0915 27.02.2015 \u0915\u0947 \n\u0924\u0928\u0930\u094d\u0923\u092f \u092e\u0947\u0902 \u0938\u092e\u0938\u094d\u0924 \u0926\u093e\u0935\u0947 \u0915\u0947 \u092a\u0942\u0930\u094d\u0923 \u090f\u0935\u0902 \u0905\u0902\u0924\u0924\u092e \u092a\u094d\u0930\u0924\u0924\u092b\u0932 \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u0948\u0924\u094d\u0930\u0940\u092a\u0942\u0930\u094d\u0923 \u0924\u0928\u092a\u091f\u093e\u092f\u093e \u093f\u093e \u091a\u0941\u0915\u093e \u0930\u094d\u0925\u093e, \n\n5 \n \n\u0924\u094b BSES \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926 \u0907\u0938\u0940 \u0915\u093e\u0930\u0930\u094d \u0939\u0947\u0924\u0941 \u093f\u094b \u0924\u0928\u0930\u094d\u0923\u092f \u0915\u0940 \u0935\u0935\u0937\u092f \u0935\u0938\u094d\u0924\u0941 \u0930\u094d\u0925\u093e, \nFIR \u0926\u093f\u0923 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u092e\u094c\u0915\u093e \u092f\u093e \u0906\u093f\u093e\u0930 \u0928\u0939\u0940\u0902 \u092c\u0928\u0924\u093e \u0939\u0948 | \n15. \u0910\u0938\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u093f\u0939\u093e\u093e\u0901 \u092a\u093f\u0915\u093e\u0930 \u0924\u0928\u0930\u094d\u0923\u092f \u0938\u0947 \u0935\u094d\u092f\u0927\u0930\u094d\u0925\u0924 \u0930\u094d\u0925\u0947, \u0909\u0928\u0915\u0947 \u092a\u093e\u0938 \u0909\u092a\u093e\u092f \u0930\u094d\u0925\u093e \u0915\u094d\u0930\u0915 \u0935\u0939 \n\u0924\u0928\u0930\u094d\u0923\u092f \u0915\u094b \u0909\u0927\u091a\u0924 \u092b\u094b\u0930\u092e \u092e\u0947\u0902 \u091a\u0941\u0928\u094c\u0924\u0940 \u0926\u0947 | \u0939\u093e\u093e\u0901\u0932\u093e\u0915\u094d\u0930\u0915, \u092f\u0939\u093e\u093e\u0901 \u0910\u0938\u093e \u092e\u093e\u092e\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0948 | (\u093f\u0947\u0916\u0947\u0902- \nState of Punjab & Ans. v/s Jalour Singh & Ors., (2008) 2 SSC 660 \u0914\u0930 \nBhargavi Constructions & Anr. v/s Kothakapu Muthyam Reddy & Ors. \n(2018) 13 SCC 480)  \n16. \u0939\u092e\u093e\u0930\u0947 \u092e\u0924\u093e\u0928\u0941\u0938\u093e\u0930, \u0924\u0928\u0930\u094d\u0923\u092f \u0915\u0947 \u092a\u093e\u0930\u0930\u0924 \u0939\u094b\u0928\u0947 \u0915\u093e \u0905\u0938\u0930 \u092f\u0939 \u0930\u094d\u0925\u093e \u0915\u094d\u0930\u0915 \u0907\u0938\u0938\u0947 BSES \u0926\u094d\u0935\u093e\u0930\u093e \n\u092e\u093e\u093e\u0901\u0917\u0940 \u0917\u0908 \u092e\u093e\u0902\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u093f \u092e\u0947\u0902 \u0935\u0935\u0935\u093e\u0926 \u0915\u094b \u092a\u093f\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092e\u0948\u0924\u094d\u0930\u0940\u092a\u0942\u0930\u094d\u0923 \u0924\u0928\u092a\u091f\u093e\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e \n\u0923\u094d\u093f\u0938\u0938\u0947 \u0915\u094b\u0908 \u0935\u0935\u0935\u093e\u0926 \u092c\u091a\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u0930\u094d\u0925\u093e | \u092e\u0942\u0932 \u092e\u093e\u0902\u0917 \u0930\u0941\u092a\u090f 97,786/- \u0915\u0940 \u0930\u094d\u0925\u0940 \u093f\u092c\u0915\u094d\u0930\u0915 \u0935\u0935\u0935\u093e\u0926 \n\u0915\u094b \u0930\u0942\u092a\u090f 83,120/- \u0915\u0947 \u092a\u0942\u0930\u094d\u0923 \u090f\u0935\u0902 \u0905\u0902\u0924\u0924\u092e \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u0930 \u0924\u0928\u092a\u091f\u093e\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e, \u093f\u094b\u0915\u094d\u0930\u0915 BSES \n\u0926\u094d\u0935\u093e\u0930\u093e \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926 \u0926\u093e\u0935\u0947 \u0915\u0940 \u0938\u0902\u0924\u0941\u0923\u094d\u0937\u094d\u091f \u0905\u0928\u0941\u0938\u093e\u0930 \u0930\u094d\u0925\u093e | \n17. \u0907\u0938\u092e\u0932\u090f \u092a\u093f\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092a\u0902\u091a\u093e\u091f \u092e\u092e\u0932 \u093f\u093e\u0928\u0947 \u092a\u0930 \u0935\u0935\u0935\u093e\u0926 \u0930\u0942\u092a\u090f 83,120/- \u0915\u0947 \u092a\u0902\u091a\u093e\u091f \n\u0930\u093e\u092e\u0936 \u0915\u0940 \u0935\u0938\u0942\u0932\u0940 \u0915\u094b \u091b\u094b\u095c \u0915\u0930 \u0938\u092e\u0938\u094d\u0924 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0939\u0947\u0924\u0941 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u0917\u092f\u093e \u0930\u094d\u0925\u093e | \u0907\u0938\u092e\u0947\u0902 \u0915\u094b\u0908 \n\u0935\u0935\u0935\u093e\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0915\u094d\u0930\u0915 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0928\u0947 \u0926\u0926\u0928\u093e\u0902\u0915 27.02.2015 \u0915\u0947 \u0924\u0928\u0930\u094d\u0923\u092f \u0915\u0947 \u0924\u0939\u0924 BSES \u0915\u094b \n\u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u094d\u0930\u0915\u092f\u093e \u0914\u0930 \u0909\u0938  \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u094b BSES \u0926\u094d\u0935\u093e\u0930\u093e \u092c\u092c\u0928\u093e \u0915\u094d\u0930\u0915\u0938\u0940 \u0935\u0935\u0930\u094b\u093f \u0915\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u094d\u0930\u0915\u092f\u093e \n\u0917\u092f\u093e | \u0907\u0938\u092e\u0932\u090f \u0924\u0928\u0930\u094d\u0923\u092f \u0915\u093e \u0938\u0902\u0924\u094b\u0937\u093f\u0928\u0915 \u092a\u093e\u0932\u0928 \u0939\u0941\u0906 | \n18. \u0939\u092e \u092f\u0939 \u092d\u0940 \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u094d\u0930\u0915 \u0924\u0928\u0930\u094d\u0923\u092f \u092e\u0947\u0902 \u0910\u0938\u0940 \u0915\u094b\u0908 \u0936\u0924\u0923 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0923\u094d\u093f\u0938\u0938\u0947\u0902 BSES \u0915\u094b \n\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926, \u0935\u0935\u0935\u093e\u0926 \u0915\u0947 \u0924\u0928\u092a\u091f\u093e\u0928 \u0914\u0930 \u092a\u094d\u0930\u0936\u094d\u0928\u0917\u0924 \u092e\u093e\u0902\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u093f \u092e\u0947\u0902 \u0924\u0928\u0930\u094d\u0923\u092f \u092a\u093e\u0930\u0930\u0924 \n\u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0935\u093f\u0942\u0926, \u092c\u092c\u093f\u0932\u0940 \u0905\u0927\u093f\u0924\u0928\u092f\u092e \u0915\u0947 \u0924\u0939\u0924 FIR \u0926\u093f\u0923 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0927\u093f\u0915\u093e\u0930 \u092e\u092e\u0932\u0947 | \u0935\u0939\u0940\u0940\u0901 \n\u0926\u0942\u0938\u0930\u0940 \u0924\u0930\u092b \u0924\u0928\u0930\u094d\u0923\u092f \u092e\u0947\u0902 \u0926\u0940 \u0917\u092f\u0940 \u0936\u0924\u0947\u0902 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0926\u0936\u093e\u0923\u0924\u0940 \u0939\u0948\u0902 \u0915\u094d\u0930\u0915 \u092a\u094d\u0930\u0936\u094d\u0928\u0917\u0924 \u092e\u093e\u0902\u0917 \u0915\u093e \u0935\u0935\u0935\u093e\u0926 \n\u092a\u0942\u0930\u094d\u0923 \u090f\u0935\u0902 \u0905\u0923\u094d\u0928\u094d\u0924\u092e \u0938\u0902\u0924\u0941\u0923\u094d\u0937\u094d\u091f \u0938\u0947 \u0924\u0928\u092a\u091f\u093e\u092f\u093e \u093f\u093e \u091a\u0941\u0915\u093e \u0939\u0948 | \u0907\u0938\u092e\u0947\u0902 \u0915\u094b\u0908 \u0935\u0935\u0935\u093e\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0915\u094d\u0930\u0915 \u092c\u092c\u093f\u0932\u0940 \n\u0905\u0927\u093f\u0924\u0928\u092f\u092e \u0915\u0940 \u093f\u093e\u0930\u093e 152 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u094b \u092c\u092c\u093f\u0932\u0940 \u0905\u0927\u093f\u0924\u0928\u092f\u092e \u0915\u0947 \u0924\u0939\u0924 \u0926\u0921\u093f\u094b\u0902 \u0915\u0947 \u0936\u092e\u0928 \u0939\u0947\u0924\u0941 \n\u0938\u0936\u0915\u094d\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948 |  \n\n6 \n \n19. \u0939\u092e\u093e\u0930\u0947 \u092e\u0924 \u0905\u0928\u0941\u0938\u093e\u0930, \u092f\u0926\u0926 BSES \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926 \u092c\u092c\u093f\u0932\u0940 \u0905\u0927\u093f\u0924\u0928\u092f\u092e \u0915\u0947 \u0924\u0939\u0924 \nFIR \u0926\u093f\u0923 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u0907\u0924\u0928\u0940 \u0909\u0924\u094d\u0938\u0941\u0915 \u0930\u094d\u0925\u0940 \u0924\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u092f\u093e \u0924\u094b \u092e\u093e\u092e\u0932\u0947 \u0915\u094b \u0932\u094b\u0915 \u0905\u0926\u093e\u0932\u0924 \u0915\u0947 \n\u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0941\u0932\u091d\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u091a\u093e\u0926\u0939\u090f \u0930\u094d\u0925\u093e \u092f\u093e \u0910\u0938\u093e \u0924\u0928\u092a\u091f\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u0924\u0928\u0930\u094d\u0923\u092f \u092e\u0947\u0902 \u0910\u0938\u0940 \u0936\u0924\u0923 \n\u0930\u0916\u0928\u0940 \u091a\u093e\u0926\u0939\u090f \u0930\u094d\u0925\u0940 \u0923\u094d\u093f\u0938\u0938\u0947 \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u094d\u0930\u0936\u094d\u0928\u0917\u0924 \u0935\u0935\u0935\u093e\u0926 \u0915\u0947 \u0924\u0928\u092a\u091f\u093e\u0928 \u0915\u0947 \u092c\u093e\u0935\u093f\u0942\u0926 FIR \u0926\u093f\u0923 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \n\u0905\u0927\u093f\u0915\u093e\u0930 \u092e\u092e\u0932 \u093f\u093e\u0924\u093e | \u0939\u093e\u0932\u093e\u093e\u0901\u0915\u094d\u0930\u0915, \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 | \n20. \u0907\u0938\u092e\u0932\u090f \u0939\u092e \u0907\u0938 \u092e\u0924 \u0915\u094b \u092e\u093e\u0928\u0924\u0947 \u0939\u0941\u090f \u0915\u094d\u0930\u0915 \u0932\u094b\u0915 \u0905\u0926\u093e\u0932\u0924 \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0924\u0928\u0930\u094d\u0923\u092f \u092a\u093e\u0930\u0930\u0924 \u0915\u0930\u0928\u0947 \n\u0915\u0947 \u092c\u093e\u0935\u093f\u0942\u0926 FIR \u0926\u093f\u0923 \u0915\u0930\u0928\u093e \u092a\u0942\u0930\u094d\u0923\u0924\u0903 \u0905\u0928\u094d\u092f\u093e\u092f\u092a\u0942\u0930\u094d\u0923 \u090f\u0935\u0902 \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u0939\u0948\u0902 \u0914\u0930 \u0907\u0938\u092e\u0932\u090f \u092f\u0939 \u0924\u0928\u0930\u094d\u0923\u092f \n\u0915\u0940 \u0936\u0924\u094b\u0902 \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0905\u0928\u0941\u091c\u094d\u091e\u0947\u092f \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 \u092e\u093e\u0902\u0917 \u0938\u0947 \u0909\u0926\u094d\u092d\u0942\u0924 \u0915\u094b\u0908 \u0935\u0924\u0923\u092e\u093e\u0928 \u0935\u093e\u0926 \n\u0939\u0947\u0924\u0941\u0915 \u0915\u0947 \u0928 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0930\u094d \u092d\u0940 \u0905\u0928\u0941\u091c\u094d\u091e\u0947\u092f \u0928\u0939\u0940\u0902 \u0939\u0948 | \u0907\u0938\u092e\u0932\u090f \u092f\u0939 \u0928\u094d\u092f\u093e\u092f\u094b\u0927\u091a\u0924 \u0930\u0942\u092a \u0938\u0947 \n\u0938\u0902\u093f\u093e\u0930\u0930\u094d\u0940\u092f \u0928\u0939\u0940\u0902 \u0939\u0948 |  \n21. \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0935\u0935\u091a\u093e\u0930 \u0935\u0935\u092e\u0936\u0923 \u0915\u0947 \u091a\u0932\u0924\u0947, \u0905\u092a\u0940\u0932 \u092e\u0938\u0926\u094d\u093f \u0939\u094b\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0924\u0926\u0928\u0941\u0938\u093e\u0930 \u0905\u0928\u0941\u092e\u0924\u0924 \u0926\u0940 \n\u093f\u093e\u0924\u0940 \u0939\u0948 | \u0906\u093f\u0947\u0935\u092a\u0924 \u0906\u0926\u0947\u0936 \u0930\u0926\u094d\u0926 \u0915\u094d\u0930\u0915\u092f\u093e \u093f\u093e\u0924\u093e \u0939\u0948 | \u092a\u0930\u0930\u0930\u094d\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0926\u094d\u0935\u093e\u0930\u093e CrPC, \n1973 \u0915\u0940 \u093f\u093e\u0930\u093e 482 \u0915\u0947 \u0924\u0939\u0924 \u0926\u093e\u092f\u0930 \u092f\u093e\u0927\u091a\u0915\u093e \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u093f\u093e\u0924\u0940 \u0939\u0948 \u0914\u0930 \u092e\u093e\u0932\u0935\u0940\u092f \u0928\u0917\u0930 \n\u092a\u0941\u092e\u0932\u0938 \u0930\u094d\u0925\u093e\u0928\u093e, \u0926\u0915\u094d\u0937\u093f\u0930\u094d \u0926\u0926\u0932\u094d\u0932\u0940 \u092e\u0947\u0902 \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u0935\u0935\u0930\u0941\u0926\u094d\u0926 FIR No. 548/15 \u0915\u094b \u0924\u0928\u0930\u0938\u094d\u0924 \u0915\u094d\u0930\u0915\u092f\u093e \n\u093f\u093e\u0924\u093e \u0939\u0948 |  \n\u0905\u092d\u092f \u092e\u0928\u094b\u0939\u0930 \u0938\u092a\u094d\u0930\u0947, \u0928\u094d\u092f\u093e\u092f\u093e\u093f\u0940\u0936 \n \n\u0906\u0930. \u0938\u0941\u092d\u093e\u0937 \u0930\u0947\u0921\u094d\u093f\u0940, \u0928\u094d\u092f\u093e\u092f\u093e\u093f\u0940\u0936 \n\u0928\u0908 \u0926\u0926\u0932\u094d\u0932\u0940: 19 \u0905\u0917\u0938\u094d\u0924, 2019 \n \n\u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0930\u094d: \u0926\u0947\u0936\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0924\u0928\u0930\u094d\u0923\u092f \u0915\u093e \u0905\u0928\u0941\u0935\u093e\u0926 \u092e\u0941\u0915\u0926\u094d\u0926\u094d\u092e\u0947\u092c\u093e\u095b \u0915\u0947 \u092e\u0938\u092e\u092e\u0924 \u092a\u094d\u0930\u092f\u094b\u0917 \u0939\u0947\u0924\u0941 \u0915\u094d\u0930\u0915\u092f\u093e \n\u0917\u092f\u093e \u0939\u0948\u0902 \u0924\u093e\u0915\u094d\u0930\u0915, \u0935\u094b \u0905\u092a\u0928\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0907\u0938\u0947 \u0938\u092e\u091d \u0938\u0915\u0947 \u090f\u0935\u0902 \u092f\u0939 \u0915\u094d\u0930\u0915\u0938\u0940 \u0905\u0928\u094d\u092f \n\u092a\u094d\u0930\u092f\u094b\u093f\u0928 \u0939\u0947\u0924\u0941 \u092a\u094d\u0930\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u094d\u0930\u0915\u092f\u093e \u093f\u093e\u092f\u0917\u093e | \u0938\u092e\u0938\u094d\u0924 \u0915\u093e\u092f\u093e\u0923\u0932\u092f\u0940 \u090f\u0935\u0902 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u0930\u0915 \n\u092a\u094d\u0930\u092f\u094b\u093f\u0928\u094b\u0902 \u0939\u0947\u0924\u0941 \u0924\u0928\u0930\u094d\u0923\u092f \u0915\u093e \u0905\u0902\u0917\u094d\u0930\u0947\u095b\u0940 \u0938\u094d\u0935\u0930\u0942\u092a \u0939\u0940 \u0905\u092e\u092d\u092a\u094d\u0930\u092e\u093e\u0916\u0930\u094d\u0924 \u092e\u093e\u0928\u093e \u093f\u093e\u090f\u0917\u093e \u0914\u0930 \n\u0915\u093e\u092f\u093e\u0923\u0928\u094d\u0935\u092f\u0928 \u0924\u0930\u094d\u0925\u093e \u0932\u093e\u0917\u0942 \u0915\u094d\u0930\u0915\u090f \u093f\u093e\u0928\u0947 \u0939\u0947\u0924\u0941 \u0909\u0938\u0947 \u0939\u0940 \u0935\u0930\u0940\u092f\u0924\u093e \u0926\u0940 \u093f\u093e\u090f\u0917\u0940 |  \n"
}