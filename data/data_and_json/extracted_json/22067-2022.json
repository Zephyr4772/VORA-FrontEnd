    "full_text": "\u0909\u0926\u094d\u0918\u094b\u0937\u0923\u093e- \n\u201c\u093a\u0947\u0924\u094d\u0930\u0940\u092e \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0905\u0928\u0941\u0935\u093e\u0926\u0926\u0924 \u0928\u0928\u0923\u0923\u092e \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u0929\u0928\u0940 \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0938\u092d\u091d\u0928\u0947 \u0939\u0947\u0924\u0941 \u0928\u0928\u092b\u093e\u0923\u0927\u0927\u0924 \u092a\u094d\u0930\u092e\u094b\u0917 \n\u0915\u0947 \u0932\u0930\u092e\u0947 \u0939\u0948 \u0914\u092f \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e \u0915\u0947 \u0932\u0930\u092e\u0947 \u092a\u094d\u0930\u092e\u094b\u0917 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0940 \n\u0935\u094d\u092e\u093e\u0935\u0939\u093e\u0930\u092f\u0915 \u0914\u092f \u0938\u092f\u0915\u093e\u092f\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947, \u0928\u0928\u0923\u0923\u092e \u0915\u093e \u0905\u0940\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0940\u0902\u0938\u094d\u0915\u092f\u0923 \u092a\u094d\u0930\u093e\u092d\u093e\u0923\u0923\u0915 \u092d\u093e\u0928\u093e \n\u091c\u093e\u092e\u0947\u0917\u093e \u0924\u0925\u093e \u0928\u0928\u0937\u094d\u0929\u093e\u0926\u0928 \u0914\u092f \u0915\u093f\u092e\u093e\u0928\u094d\u0935\u092e\u0928 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947 \u092d\u093e\u0928\u094d\u092e \u0939\u094b\u0917\u093e\u201d\u0964 \n\u092a\u094d\u0930\u0924\u093f\u0935\u0947\u0926\u094d\u092f \n\u092c\u093e\u092f\u0924 \u0915\u0947 \u0938\u0935\u094b\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u092d\u0947\u0902 \n\u0932\u0938\u0935\u0935\u0930 \u0905\u0929\u0940\u0930\u0940\u092e \u093a\u0947\u0924\u094d\u0930\u093e\u0927\u0927\u0915\u093e\u0930\u092f\u0924\u093e \n\u0932\u0938\u0935\u0935\u0930 \u0905\u0929\u0940\u0930 \u0938\u0940\u0902\u0916\u094d\u092e\u093e 9040/2022 \n(\u090f\u0938\u090f\u0930\u0929\u0940 (\u0938\u0940) \u0938\u0940\u0902\u0916\u094d\u092e\u093e 14252/2022) \n\u0915\u0941\u092d\u093e\u092f\u0940 \u0930\u0915\u094d\u0937\u094d\u092d\u0940 \u0938\u092f\u094b\u091c \u0914\u092f \u0905\u0928\u094d\u092e   \n....\u0905\u0929\u0940\u0930\u093e\u0925\u0940 (\u0917\u0923) \n\u092b\u0928\u093e\u092d \n\u0909\u0924\u094d\u0924\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \u092f\u093e\u091c\u094d\u092e \u0914\u092f \u0905\u0928\u094d\u092e   \n.....\u092a\u094d\u0930\u0924\u094d\u092e\u0925\u0940 (\u0917\u0923) \n\u0928\u093f\u0930\u094d\u0923\u092f \n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0928\u0924\u0923 \u090f\u092e. \u0906\u0930. \u0936\u093e\u0939 \n1. \u0930\u092f\u091f \u090f. \u0938\u0940\u0902\u0916\u094d\u092e\u093e 3993/2022 \u092d\u0947\u0902 \u0907\u0930\u093e\u0939\u093e\u092b\u093e\u0926 \u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e, \n\u0930\u0916\u0928\u090a \u0929\u0940\u0920 \u0926\u094d\u0935\u093e\u092f\u093e \u0929\u093e\u0930\u092f\u0924 13.07.2022 \u0926\u0926\u0928\u093e\u0940\u0902\u0915\u0915\u0924 \u0906\u093a\u0947\u0935\u0929\u0924 \n\u0928\u0928\u0923\u0923\u092e \u0914\u092f \u0906\u0926\u0947\u0936 \u0938\u0947 \u0935\u094d\u092e\u0927\u0925\u0924 \u0914\u092f \u0905\u0938\u0940\u0902\u0924\u0941\u0937\u094d\u091f, \u091c\u091c\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u092f\u093e, \n\u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0928\u0947 \u0909\u0915\u094d\u0924 \u0930\u092f\u091f \u092e\u093e\u0927\u091a\u0915\u093e \u0915\u094b \u0916\u093e\u0930\u092f\u091c \u0915\u092f \u0926\u0926\u092e\u093e \u0939\u0948 \n\u0914\u092f \u092a\u094d\u0930\u0924\u094d\u092e\u0925\u0940 (\u0917\u0923\u094b\u0902) \u0915\u094b \u0938\u094d\u0935\u093e\u0938\u094d\u094d\u092e \u0915\u093e\u092e\u0923\u0915\u0924\u093e\u0923 (\u092d\u0926\u0939\u0930\u093e) \u0915\u0947 \u0929\u0926 \u0929\u092f \n\u0928\u0928\u092e\u0941\u0915\u094d\u0924 \u0915\u092f\u0928\u0947 \u0915\u093e \u0928\u0928\u0926\u0947\u0936 \u0926\u0947\u0928\u0947 \u0935\u093e\u0930\u0940 \u0930\u092f\u091f \u091c\u093e\u092f\u0940 \u0915\u092f\u0928\u0947 \u0938\u0947 \u0907\u0928\u0915\u093e\u092f \n\u0915\u092f \u0926\u0926\u092e\u093e \u0939\u0948 \u0914\u092f \u092d\u0942\u0930 \u0930\u092f\u091f \u092e\u093e\u0927\u091a\u0915\u093e\u0915\u0924\u093e\u0923\u0913\u0940\u0902 \u0928\u0947 \u0935\u0924\u0923\u092d\u093e\u0928 \u0905\u0929\u0940\u0930 \n\u0915\u094b \u092a\u094d\u0930\u093e\u0925\u0932\u092d\u0915\u0924\u093e \u0926\u0940 \u0939\u0948\u0964 \n2. \u0938\u0940\u0902\u093a\u0947\u0929 \u092d\u0947\u0902 \u0935\u0924\u0923\u092d\u093e\u0928 \u0905\u0929\u0940\u0930 \u0915\u0947 \u0924\u094d\u092e \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u092f \u0939\u0948\u0902- \n2.1. \u092e\u0939 \u0915\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u094d\u092e \u0915\u093e\u092e\u0923\u0915\u0924\u093e\u0923 (\u092d\u0926\u0939\u0930\u093e) \u0915\u0947 \u0929\u0926 \u0929\u092f \u0928\u0928\u092e\u0941\u091c\u0915\u094d\u0924 \n\u0939\u0947\u0924\u0941 \u0935\u0935\u093b\u093e\u0929\u0928 \u0926\u0926\u0928\u093e\u0940\u0902\u0915 15.12.2021 \u0926\u094d\u0935\u093e\u092f\u093e \u0906\u0935\u0947\u0926\u0928 \u0929\u0924\u094d\u0930 \u0906\u092d\u0940\u0902\u0924\u094d\u0930\u0924\u094d\u0930\u0924 \n\n\u0909\u0926\u094d\u0918\u094b\u0937\u0923\u093e- \n\u201c\u093a\u0947\u0924\u094d\u0930\u0940\u092e \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0905\u0928\u0941\u0935\u093e\u0926\u0926\u0924 \u0928\u0928\u0923\u0923\u092e \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u0929\u0928\u0940 \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0938\u092d\u091d\u0928\u0947 \u0939\u0947\u0924\u0941 \u0928\u0928\u092b\u093e\u0923\u0927\u0927\u0924 \u092a\u094d\u0930\u092e\u094b\u0917 \n\u0915\u0947 \u0932\u0930\u092e\u0947 \u0939\u0948 \u0914\u092f \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e \u0915\u0947 \u0932\u0930\u092e\u0947 \u092a\u094d\u0930\u092e\u094b\u0917 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0940 \n\u0935\u094d\u092e\u093e\u0935\u0939\u093e\u0930\u092f\u0915 \u0914\u092f \u0938\u092f\u0915\u093e\u092f\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947, \u0928\u0928\u0923\u0923\u092e \u0915\u093e \u0905\u0940\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0940\u0902\u0938\u094d\u0915\u092f\u0923 \u092a\u094d\u0930\u093e\u092d\u093e\u0923\u0923\u0915 \u092d\u093e\u0928\u093e \n\u091c\u093e\u092e\u0947\u0917\u093e \u0924\u0925\u093e \u0928\u0928\u0937\u094d\u0929\u093e\u0926\u0928 \u0914\u092f \u0915\u093f\u092e\u093e\u0928\u094d\u0935\u092e\u0928 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947 \u092d\u093e\u0928\u094d\u092e \u0939\u094b\u0917\u093e\u201d\u0964 \n\u0915\u0915\u092e\u0947 \u0917\u092e\u0947 \u0925\u0947\u0964 \u0906\u0935\u0947\u0926\u0928 \u091c\u092d\u093e \u0915\u092f\u0928\u0947 \u0915\u0940 \u0905\u0940\u0902\u0928\u0924\u092d \u0928\u0924\u0927\u0925 \n05.01.2022 \u0925\u0940\u0964 \u0935\u0935\u093b\u093e\u0929\u0928 \u0915\u0947 \u0916\u0923\u094d\u0921 6 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u092f, \u0906\u0935\u0947\u0926\u0928 \u0915\u0940 \n\u0905\u0940\u0902\u0928\u0924\u092d \u0928\u0924\u0927\u0925 \u0924\u0915 \u0905\u092d\u094d\u092e\u0925\u0940 \u0915\u0947 \u0929\u093e\u0938 \u0906\u0935\u0936\u094d\u092e\u0915 \u092e\u094b\u0917\u094d\u092e\u0924\u093e (\u0936\u0948\u0915\u094d\u0937\u093a\u0915 \n\u0914\u092f \u0905\u0928\u094d\u092e) \u0907\u0938 \u0936\u0924\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0929\u0942\u092f\u093e\n \u0939\u094b\u0928\u093e \u0905\u0928\u0928\u0935\u093e\u092e\u0923 \u0925\u093e \u0915\u0915 \n\u0905\u092d\u094d\u092e\u0925\u0940 \u0915\u094b \u0928\u0932\u0938\u093f\u0902\u0917 \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0911\u092a \u0907\u0940\u0902\u0921\u0921\u092e\u093e \u0915\u0947 \u092d\u093e\u0928\u0926\u0940\u0902\u0921\u094b\u0902 \u0915\u0947 \n\u0905\u0928\u0941\u0938\u093e\u092f \u090f\u0915 \u0935\u0937\u0923 \u091b\u0939 \u092d\u0939\u0940\u0928\u0947 \n/ \u0926\u094b \u0935\u0937\u0923 \u0915\u0947 \u0938\u0939\u093e\u092e\u0915 \u0928\u0938\u0923 \u0914\u092f \n\u0932\u092d\u0921\u0935\u093e\u0907\u0935\u094d\u0938 (\u090f\u090f\u0928\u090f\u092d) \u092a\u094d\u0930\u0932\u0936\u093a\u0923 \u0929\u093e\u0920\u094d\u092e\u093f\u092d (\u092a\u094d\u0930\u0938\u0942\u0928\u0924 \u0938\u0947 \u0938\u0940\u0902\u092b\u0940\u0902\u0927\u0927\u0924 \n\u091b\u0939 \u092d\u0939\u0940\u0928\u0947 \u0915\u0947 \u092a\u094d\u0930\u0932\u0936\u093a\u0923 \u0938\u0926\u0939\u0924) \u0915\u094b \u0938\u092a\u0930\u0924\u093e\u0929\u0942\u0935\u0923\u0915 \u0935\u0935\u0927\u0927\u0935\u0924 \u0930\u0942\u0929 \n\u0938\u0947 \u0909\u0924\u094d\u0924\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \u0928\u0938\u0923 \u0914\u092f \u0932\u092d\u0921\u0935\u093e\u0907\u092a \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930, \u0930\u0916\u0928\u090a \u0915\u0947 \u0938\u093e\u0925 \n\u0929\u0940\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u092f\u0928\u093e \u0905\u0928\u0928\u0935\u093e\u092e\u0923 \u0939\u094b\u0917\u093e\u0964 \u0938\u092c\u0940 \u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \u0928\u0947 \u0911\u0928\u0930\u093e\u0907\u0928 \n\u092d\u094b\u0921 \u0915\u0947 \u092d\u093e\u0927\u094d\u092e\u092d \u0938\u0947 \u0905\u0929\u0928\u0947 \u0906\u0935\u0947\u0926\u0928 \u0929\u0924\u094d\u0930 \u092c\u092f\u0947 \u0914\u092f \u0909\u0915\u094d\u0924 \u0929\u092f\u0940\u093a\u093e \u092d\u0947\u0902 \n\u0936\u093e\u0932\u092d\u0930 \u0939\u0941\u090f\u0964 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \u0938\u0924\u094d\u092e\u093e\u0929\u0928 \u0915\u0947 \u0926\u094c\u092f\u093e\u0928 \u0939\u0940 \u0905\u092d\u094d\u092e\u0925\u0940 \u0915\u0940 \n\u0929\u093e\u0924\u094d\u0930\u0924\u093e \u0929\u092f \u0935\u0935\u091a\u093e\u092f \u0915\u0915\u092e\u093e \u091c\u093e\u0928\u093e \u0906\u0935\u0936\u094d\u092e\u0915 \u0925\u093e\u0964 \u0938\u092c\u0940 \u0905\u0929\u0940\u0930\u093e\u0925\u0940 \n\u090f\u092d.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u092d\u0947\u0902 \u0929\u0940\u0902\u091c\u0940\u0915\u0943\u0924 \u0925\u0947\u0964 \u090f\u0915 \u0915\u094b \u091b\u094b\u0921\u093c\u0915\u092f \u0938\u092c\u0940 \n\u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \u0928\u0947 \u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u0915\u0947 \u0932\u0930\u090f \u0906\u0935\u0947\u0926\u0928 \u091c\u092d\u093e \n\u0915\u0915\u092e\u093e\u0964 \u090f\u092d.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0928\u0947 \u090f\u0928\u0913\u0938\u0940 \u0926\u0947 \u0926\u0940\u0964 \u0939\u093e\u0930\u093e\u0940\u0902\u0915\u0915, \u092e\u0942.\u0929\u0940. \n\u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0928\u0947 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u091c\u093e\u092f\u0940 \u0915\u092f\u0928\u0947 \u092d\u0947\u0902 \u0938\u092d\u092e \u0932\u0930\u092e\u093e \u0914\u092f \u0907\u0938\u0932\u0930\u090f, \n\u0938\u0940\u0902\u092b\u0940\u0902\u0927\u0927\u0924 \u0905\u0929\u0940\u0930\u093e\u0925\u0940 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \u0938\u0924\u094d\u092e\u093e\u0929\u0928 \u0915\u0947 \u0926\u094c\u092f\u093e\u0928 \u092e\u0942.\u0929\u0940. \n\u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0928\u0939\u0940\u0940\u0902 \u0915\u092f \u0938\u0915\u0947\u0964 \u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \u0915\u0940 \u0905\u092d\u094d\u092e\u0927\u0925\u0923\u0924\u093e \u0929\u092f \n\u0907\u0938 \u0906\u0927\u093e\u092f \u0929\u092f \u0928\u0928\u092e\u0941\u091c\u0915\u094d\u0924 \u0915\u0947 \u0932\u0930\u090f \u0906\u0917\u0947 \u0935\u0935\u091a\u093e\u092f \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u0917\u092e\u093e \n\u0915\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \u0938\u0924\u094d\u092e\u093e\u0929\u0928 \u0915\u0947 \u0938\u092d\u092e \u0935\u0947 \u0909\u0924\u094d\u0924\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \u0928\u0938\u0947\u091c \u090f\u0940\u0902\u0921 \n\n\u0909\u0926\u094d\u0918\u094b\u0937\u0923\u093e- \n\u201c\u093a\u0947\u0924\u094d\u0930\u0940\u092e \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0905\u0928\u0941\u0935\u093e\u0926\u0926\u0924 \u0928\u0928\u0923\u0923\u092e \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u0929\u0928\u0940 \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0938\u092d\u091d\u0928\u0947 \u0939\u0947\u0924\u0941 \u0928\u0928\u092b\u093e\u0923\u0927\u0927\u0924 \u092a\u094d\u0930\u092e\u094b\u0917 \n\u0915\u0947 \u0932\u0930\u092e\u0947 \u0939\u0948 \u0914\u092f \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e \u0915\u0947 \u0932\u0930\u092e\u0947 \u092a\u094d\u0930\u092e\u094b\u0917 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0940 \n\u0935\u094d\u092e\u093e\u0935\u0939\u093e\u0930\u092f\u0915 \u0914\u092f \u0938\u092f\u0915\u093e\u092f\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947, \u0928\u0928\u0923\u0923\u092e \u0915\u093e \u0905\u0940\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0940\u0902\u0938\u094d\u0915\u092f\u0923 \u092a\u094d\u0930\u093e\u092d\u093e\u0923\u0923\u0915 \u092d\u093e\u0928\u093e \n\u091c\u093e\u092e\u0947\u0917\u093e \u0924\u0925\u093e \u0928\u0928\u0937\u094d\u0929\u093e\u0926\u0928 \u0914\u092f \u0915\u093f\u092e\u093e\u0928\u094d\u0935\u092e\u0928 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947 \u092d\u093e\u0928\u094d\u092e \u0939\u094b\u0917\u093e\u201d\u0964 \n\u0932\u092d\u0921\u0935\u093e\u0907\u092a \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930, \u0930\u0916\u0928\u090a \u092d\u0947\u0902 \u0935\u0935\u0927\u0927\u0935\u0924 \u0929\u0940\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0940\u0902 \u0925\u0947, \u0914\u092f \n\u0907\u0938\u0932\u0930\u090f, \u0935\u0947 \u0905\u0929\u093e\u0924\u094d\u0930 \u0925\u0947 \u0915\u094d\u092e\u094b\u0902\u0915\u0915 \u0909\u0928\u0915\u0947 \u0929\u093e\u0938 \u0935\u0935\u093b\u093e\u0929\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u092f \n\u0906\u0935\u0936\u094d\u092e\u0915 \u092e\u094b\u0917\u094d\u092e\u0924\u093e \u0928\u0939\u0940\u0940\u0902 \u0925\u0940\u0964 \u0907\u0938\u0932\u0930\u090f \u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \u0928\u0947 \u0909\u091a\u094d\u091a \n\u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0915\u0947 \u0938\u092d\u093a \u0930\u092f\u091f \u092e\u093e\u0927\u091a\u0915\u093e \u0926\u093e\u092e\u092f \u0915\u0940\u0964 \u0906\u093a\u0947\u0935\u0929\u0924 \u0928\u0928\u0923\u0923\u092e \n\u0914\u092f \u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u092f\u093e, \u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0928\u0947 \u092f\u093e\u091c\u094d\u092e \u0915\u0940 \u0913\u092f \u0938\u0947 \u0932\u0930\u090f \n\u0917\u090f \u0907\u0938 \u0930\u0941\u0916 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u092f \u0915\u092f\u0924\u0947 \u0939\u0941\u090f \u0909\u0915\u094d\u0924 \u0930\u092f\u091f \u092e\u093e\u0927\u091a\u0915\u093e \u0915\u094b \n\u0916\u093e\u0930\u092f\u091c \u0915\u092f \u0926\u0926\u092e\u093e \u0915\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \u0938\u0924\u094d\u092e\u093e\u0929\u0928 \u0915\u0947 \u0938\u092d\u092e \u0914\u092f/\u092e\u093e \n\u092e\u0939\u093e\u0940\u0902 \u0924\u0915 \u0915\u0915 \u0906\u0935\u0947\u0926\u0928 \u0929\u0924\u094d\u0930 \u091c\u092d\u093e \u0915\u092f\u0924\u0947 \u0938\u092d\u092e \u092c\u0940 \u0935\u0947 \u0909\u0924\u094d\u0924\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \n\u0929\u0930\u092f\u0937\u0926 \u0915\u0947 \u0938\u093e\u0925 \u0929\u0940\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0940\u0902 \u0925\u0947 \u0914\u092f \u0907\u0938\u0932\u0930\u090f \u0935\u0947 \u0905\u092e\u094b\u0917\u094d\u092e \u0939\u0948\u0902\u0964 \n2.2. \u0930\u092f\u091f \u092e\u093e\u0927\u091a\u0915\u093e \u0915\u094b \u0916\u093e\u0930\u092f\u091c \u0915\u092f\u0924\u0947 \u0939\u0941\u090f \u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0926\u094d\u0935\u093e\u092f\u093e \n\u0929\u093e\u0930\u092f\u0924 \u0906\u093a\u0947\u0935\u0929\u0924 \u0928\u0928\u0923\u0923\u092e \u0914\u092f \u0906\u0926\u0947\u0936 \u0938\u0947 \u0935\u094d\u092e\u0927\u0925\u0924 \u0914\u092f \u0905\u0938\u0940\u0902\u0924\u0941\u0937\u094d\u091f \n\u092d\u0939\u0938\u0942\u0938 \u0915\u092f\u0924\u0947 \u0939\u0941\u090f, \u092d\u0942\u0930 \u0930\u092f\u091f \u092e\u093e\u0927\u091a\u0915\u093e\u0915\u0924\u093e\u0923\u0913\u0940\u0902 \u0928\u0947 \u0935\u0935\u0936\u0947\u0937 \u0905\u0928\u0941\u092d\u0928\u0924 \n\u0915\u0947 \u092d\u093e\u0927\u094d\u092e\u092d \u0938\u0947 \u0935\u0924\u0923\u092d\u093e\u0928 \u0905\u0929\u0940\u0930 \u0926\u093e\u0923\u0916\u0930 \u0915\u0915\u092e\u093e \u0939\u0948\u0964 \n3. \u0939\u092d\u0928\u0947 \u0938\u0940\u0902\u092b\u0940\u0902\u0927\u0927\u0924 \u0929\u093a\u094b\u0902 \u0915\u0940 \u0913\u092f \u0938\u0947 \u0929\u0947\u0936 \u0939\u094b\u0928\u0947 \u0935\u093e\u0930\u0947 \u0935\u0935\u0926\u094d\u0935\u093e\u0928 \n\u0905\u0927\u0927\u0935\u0915\u094d\u0924\u093e \u0915\u094b \u0938\u0941\u0928\u093e\u0964 \n4. \u092a\u094d\u0930\u093e\u092f\u092e\u094d\u092c \u092d\u0947\u0902, \u092e\u0939 \u0928\u094b\u091f \u0915\u0915\u092e\u093e \u091c\u093e\u0928\u093e \u0906\u0935\u0936\u094d\u092e\u0915 \u0939\u0948 \u0915\u0915 \u0906\u0935\u0947\u0926\u0928 \n\u0906\u092d\u0940\u0902\u0924\u094d\u0930\u0924\u094d\u0930\u0924 \u0915\u092f\u0928\u0947 \u0915\u0947 \u0932\u0930\u090f \u0935\u0935\u093b\u093e\u0929\u0928 \u0915\u0940 \n\u0928\u0924\u0927\u0925 \n\u0926\u0926\u0928\u093e\u0940\u0902\u0915 \n15.12.2021 \u0925\u0940\u0964 \u0906\u0935\u0947\u0926\u0928 \u091c\u092d\u093e \u0915\u092f\u0928\u0947 \u0915\u0940 \u0905\u0940\u0902\u0928\u0924\u092d \u0928\u0924\u0927\u0925 \u0926\u0926\u0928\u093e\u0940\u0902\u0915 \n05.01.2022 \u0925\u0940\u0964 \u092e\u0939 \u0938\u0939\u0940 \u0939\u0948 \u0915\u0915 \u0935\u0935\u093b\u093e\u0929\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u092f \u0905\u092d\u094d\u092e\u0925\u0940 \n\u0915\u094b \u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u092d\u0947\u0902 \u0929\u0940\u0902\u091c\u0940\u0915\u0943\u0924 \u0939\u094b\u0928\u093e \u0906\u0935\u0936\u094d\u092e\u0915 \u0925\u093e\u0964 \u0938\u092c\u0940 \n\n\u0909\u0926\u094d\u0918\u094b\u0937\u0923\u093e- \n\u201c\u093a\u0947\u0924\u094d\u0930\u0940\u092e \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0905\u0928\u0941\u0935\u093e\u0926\u0926\u0924 \u0928\u0928\u0923\u0923\u092e \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u0929\u0928\u0940 \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0938\u092d\u091d\u0928\u0947 \u0939\u0947\u0924\u0941 \u0928\u0928\u092b\u093e\u0923\u0927\u0927\u0924 \u092a\u094d\u0930\u092e\u094b\u0917 \n\u0915\u0947 \u0932\u0930\u092e\u0947 \u0939\u0948 \u0914\u092f \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e \u0915\u0947 \u0932\u0930\u092e\u0947 \u092a\u094d\u0930\u092e\u094b\u0917 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0940 \n\u0935\u094d\u092e\u093e\u0935\u0939\u093e\u0930\u092f\u0915 \u0914\u092f \u0938\u092f\u0915\u093e\u092f\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947, \u0928\u0928\u0923\u0923\u092e \u0915\u093e \u0905\u0940\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0940\u0902\u0938\u094d\u0915\u092f\u0923 \u092a\u094d\u0930\u093e\u092d\u093e\u0923\u0923\u0915 \u092d\u093e\u0928\u093e \n\u091c\u093e\u092e\u0947\u0917\u093e \u0924\u0925\u093e \u0928\u0928\u0937\u094d\u0929\u093e\u0926\u0928 \u0914\u092f \u0915\u093f\u092e\u093e\u0928\u094d\u0935\u092e\u0928 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947 \u092d\u093e\u0928\u094d\u092e \u0939\u094b\u0917\u093e\u201d\u0964 \n\u0905\u0929\u0940\u0930\u093e\u0925\u0940-\u0930\u092f\u091f \u092e\u093e\u0927\u091a\u0915\u093e\u0915\u0924\u093e\u0923 \u091c\u094b \u090f\u092d.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u0915\u092f\u093e \n\u092f\u0939\u0947 \u0925\u0947, \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u090f\u0915 \u0905\u092d\u094d\u092e\u0925\u0940 (\u0915\u0941\u092d\u093e\u092f\u0940 \u0929\u0942\u091c\u093e \u092f\u093e\u0928\u0940) \u0915\u094b \u091b\u094b\u0921\u093c\u0915\u092f, \n\u0926\u0926\u0928\u093e\u0940\u0902\u0915 15.12.2021 \u0915\u094b \u092a\u094d\u0930\u0915\u093e\u0932\u0936\u0924 \u0935\u0935\u093b\u093e\u0929\u0928 \u0915\u0940 \u0928\u0924\u0927\u0925 \u0938\u0947 \u0929\u0939\u0930\u0947 \n\u0939\u0940 \u0909\u0924\u094d\u0924\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u0915\u0947 \u0932\u0930\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u092f \u0926\u0926\u092e\u093e \n\u0925\u093e\u0964 \u090f\u092d.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0915\u094b \u090f\u0928\u0913\u0938\u0940 \u091c\u093e\u092f\u0940 \u0915\u092f\u0928\u0947 \u092d\u0947\u0902 \u0915\u0941\u091b \u0938\u092d\u092e \n\u0930\u0917\u093e \u0914\u092f \u0907\u0938\u0915\u0947 \u092b\u093e\u0926, \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u091c\u093e\u092f\u0940 \u0915\u092f\u0928\u0947 \u092d\u0947\u0902 \u0909\u0924\u094d\u0924\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \n\u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0915\u094b \u0914\u092f \u0938\u092d\u092e \u0930\u0917\u093e\u0964 \u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u0915\u0947 \n\u0932\u0930\u090f \u0906\u0935\u0947\u0926\u0928 \u0915\u0940 \u0928\u0924\u0927\u0925, \u090f\u092d.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0926\u094d\u0935\u093e\u092f\u093e \u090f\u0928\u0913\u0938\u0940 \n\u092a\u094d\u0930\u092d\u093e\u0923 \u0929\u0924\u094d\u0930 \u091c\u093e\u092f\u0940 \u0915\u092f\u0928\u0947, \u0909\u0924\u094d\u0924\u092f \u092a\u094d\u0930\u0926\u0947\u0936 \u0905\u0927\u0940\u0928\u0938\u094d\u0925 \u0938\u0947\u0935\u093e \u091a\u092e\u0928 \n\u0906\u092e\u094b\u0917 \u0915\u094b \u0906\u0935\u0947\u0926\u0928 \u0915\u092f\u0928\u0947 \u0915\u0940 \u0928\u0924\u0927\u0925 \u0914\u092f \u092a\u094d\u0930\u0924\u094d\u092e\u0947\u0915 \u0905\u0929\u0940\u0930\u093e\u0925\u0940 \u0915\u0947 \n\u0938\u0940\u0902\u092b\u0940\u0902\u0927 \u092d\u0947\u0902 \u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u091c\u093e\u092f\u0940 \u0915\u092f\u0928\u0947 \u0915\u0940 \u0928\u0924\u0927\u0925 \u0926\u0936\u093e\u0923\u0928\u0947 \n\u0935\u093e\u0930\u093e \u0935\u0915\u094d\u0924\u0935\u094d\u092e \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u092f \u0939\u0948\u094d \n\u092e\u093e\u0927\u091a\u0915\u093e\u0915\u0924\u093e\u0923\n/ \u0905\u0929\u0940\u0930\u093e\u0925\u0940 \n\u093f\u092d \n\u090f\u092d. \n\u0929\u0940. \n\u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \n\u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \n\u0915\u0940 \u0928\u0924\u0927\u0925 \n\u092e\u0942.\u0929\u0940. \n\u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \n\u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \n\u0915\u0947 \u0932\u0930\u090f \n\u0906\u0935\u0947\u0926\u0928 \n\u090f\u092d.\u0929\u0940. \n\u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \n\u090f\u0928\u0913\u0938\u0940 \n\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \n\u092e\u0942\u0929\u0940\u090f\u0938\u090f\u0938\u090f\u0938\n\u0938\u0940 \u092d\u0947\u0902 \u0906\u0935\u0947\u0926\u0928 \n\u0915\u0940 \u0928\u0924\u0927\u0925 \n\u092e\u0942.\u0929\u0940. \n\u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \n\u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \n\u0915\u0940 \u0928\u0924\u0927\u0925 \n1. \n\u0915\u0941\u092d\u093e\u092f\u0940 \n\u0930\u0915\u094d\u0937\u094d\u092d\u0940 \n\u0938\u092f\u094b\u091c \n17.09.202\n1 \n18.09.202\n1 \n02.12.202\n1 \n21.12.2021 \n14.02.202\n2 \n2. \n\u0915\u0941\u092d\u093e\u092f\u0940 \n\u0929\u0942\u091c\u093e \u092f\u093e\u0928\u0940 \n23.11.202\n1 \n23.12.202\n1 \n28.12.202\n1 \n26.12.2021 \n03.06.202\n2 \n3. \n\u0939\u0947\u092d\u093e \n\u0930\u0924\u093e \u0932\u092d\u0936\u094d\u0930\u093e \n12.09.201\n7 \n22.11.202\n1 \n29.11.202\n1 \n31.12.2021 \n24.03.202\n2 \n4. \n\u0926\u0941\u0917\u093e\u0923 \n\u0936\u092d\u093e\u0923 \n12.09.201\n7 \n22.11.202\n1 \n29.11.202\n1 \n31.12.2021 \n16.03.202\n2 \n\n\u0909\u0926\u094d\u0918\u094b\u0937\u0923\u093e- \n\u201c\u093a\u0947\u0924\u094d\u0930\u0940\u092e \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0905\u0928\u0941\u0935\u093e\u0926\u0926\u0924 \u0928\u0928\u0923\u0923\u092e \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u0929\u0928\u0940 \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0938\u092d\u091d\u0928\u0947 \u0939\u0947\u0924\u0941 \u0928\u0928\u092b\u093e\u0923\u0927\u0927\u0924 \u092a\u094d\u0930\u092e\u094b\u0917 \n\u0915\u0947 \u0932\u0930\u092e\u0947 \u0939\u0948 \u0914\u092f \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e \u0915\u0947 \u0932\u0930\u092e\u0947 \u092a\u094d\u0930\u092e\u094b\u0917 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0940 \n\u0935\u094d\u092e\u093e\u0935\u0939\u093e\u0930\u092f\u0915 \u0914\u092f \u0938\u092f\u0915\u093e\u092f\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947, \u0928\u0928\u0923\u0923\u092e \u0915\u093e \u0905\u0940\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0940\u0902\u0938\u094d\u0915\u092f\u0923 \u092a\u094d\u0930\u093e\u092d\u093e\u0923\u0923\u0915 \u092d\u093e\u0928\u093e \n\u091c\u093e\u092e\u0947\u0917\u093e \u0924\u0925\u093e \u0928\u0928\u0937\u094d\u0929\u093e\u0926\u0928 \u0914\u092f \u0915\u093f\u092e\u093e\u0928\u094d\u0935\u092e\u0928 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947 \u092d\u093e\u0928\u094d\u092e \u0939\u094b\u0917\u093e\u201d\u0964 \n4.1. \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u092f, \u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0926\u094d\u0935\u093e\u092f\u093e \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u0926\u0947\u092f \u0938\u0947 \u091c\u093e\u092f\u0940 \n\u0915\u0915\u090f \u091c\u093e\u0928\u0947 \u0915\u0947 \u0915\u093e\u092f\u0923, \u0905\u0929\u0940\u0930\u093e\u0925\u0940 \u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u0915\u094b \n\u0928 \u0924\u094b \u0906\u0935\u0947\u0926\u0928 \u0915\u0940 \u0905\u0940\u0902\u0928\u0924\u092d \u0928\u0924\u0927\u0925 \u0915\u094b \u0914\u092f/\u092e\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \n\u0938\u0924\u094d\u092e\u093e\u0929\u0928 \u0915\u0947 \u0938\u092d\u092e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u092f \u0938\u0915\u0947 \u0914\u092f \u0907\u0938\u0932\u0930\u090f, \u0909\u0928\u094d\u0939\u0947\u0902 \u0905\u092e\u094b\u0917\u094d\u092e \n\u0920\u0939\u092f\u093e\u092e\u093e \u0917\u092e\u093e\u0964 \n4.2. \u0909\u0929\u092e\u0941\u0923\u0915\u094d\u0924 \u0938\u0947, \u092e\u0939 \u0926\u0947\u0916\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u0915 \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u092f \u0906\u0935\u0947\u0926\u0928 \n\u0929\u0924\u094d\u0930 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u092f\u0924\u0947 \u0938\u092d\u092e \u092e\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u094b\u0902 \u0915\u0947 \u0938\u0924\u094d\u092e\u093e\u0929\u0928 \u0915\u0947 \u0938\u092d\u092e \u092c\u0940 \n\u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0928\u0939\u0940\u0940\u0902 \u0915\u092f \u0929\u093e\u0928\u0947 \u092d\u0947\u0902 \u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \n\u0915\u0940 \u0913\u092f \u0938\u0947 \u0915\u094b\u0908 \u0924\u094d\u0930\u0941\u0926\u091f \u0928\u0939\u0940\u0940\u0902 \u0915\u0940 \u0917\u0908 \u0925\u0940\u0964 \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u092f, \u090f\u0915 \u0915\u094b \n\u091b\u094b\u0921\u093c\u0915\u092f \u0938\u092c\u0940 \u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \u0928\u0947 \u0935\u0935\u093b\u093e\u0929\u0928 \u0915\u0940 \u0928\u0924\u0927\u0925 \u092e\u093e\u0928\u0940 \n15.12.2021 \u0938\u0947 \u0929\u0939\u0930\u0947 \u092e\u0942.\u0929\u0940. \u0915\u093e\u0909\u0940\u0902\u0932\u0938\u0930 \u0929\u0940\u0902\u091c\u0940\u0915\u092f\u0923 \u0915\u0947 \u0932\u0930\u090f \n\u0906\u0935\u0947\u0926\u0928 \u0915\u0915\u092e\u093e \u0925\u093e\u0964 \u0907\u0938\u0932\u0930\u090f, \u0924\u094d\u0930\u092b\u0928\u093e \u0909\u0928\u0915\u0940 \u0924\u094d\u0930\u0941\u0926\u091f\u092e\u094b\u0902 \u0915\u0947 \u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \n\u0915\u094b \u0929\u0940\u0921\u0921\u093c\u0924 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0925\u093e\u0964 \u0907\u0938\u092d\u0947\u0902 \u0936\u093e\u0932\u092d\u0930 \u092d\u093e\u092d\u0930\u093e \n\u093f\u0930\u0947\u0902\u0926\u094d\u0930 \u0938 \u093f\u0902\u0939 \u092c\u093f\u093e\u092e \u0939\u0930\u0930\u092f\u093e\u0930\u094d\u093e \u0930\u093e\u091c\u094d\u092f \u0914\u0930 \u0905\u0928\u094d\u092f\n (2022) 3 \n\u090f  \u0940 \u0940 286 \u092d\u093e\u092d\u0930\u0947 \u092d\u0947\u0902 \u0907\u0938 \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0915\u0947 \u0928\u0928\u0923\u0923\u092e \u0938\u0947 \u0905\u0935\u0930\u0940\u0902\u0924\u094d\u0930\u092b\u0924 \n\u0939\u0948\u0964 \n5. \u0909\u0915\u094d\u0924 \u0928\u0928\u0923\u0923\u092e \u092d\u0947\u0902, \u0907\u0938 \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0926\u094d\u0935\u093e\u092f\u093e \u092e\u0939 \u0926\u0947\u0916\u093e \u0914\u092f \n\u0905\u0932\u092c\u0928\u0928\u0927\u093e\u0923\u0930\u092f\u0924 \u0915\u0915\u092e\u093e \u0917\u092e\u093e \u0939\u0948 \u0915\u0915 \u090f\u0915 \u092b\u093e\u092f \u091c\u092b \u092e\u0939 \u0929\u093e\u092e\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \n\u0915\u0915 \u0906\u0935\u0947\u0926\u0915 \u0915\u0940 \u0913\u092f \u0938\u0947 \u0915\u094b\u0908 \u091a\u0942\u0915/\u0926\u0947\u092f\u0940 \u0928\u0939\u0940\u0940\u0902 \u0939\u0941\u0908 \u0925\u0940 \u0914\u092f/\u092e\u093e \n\u092a\u094d\u0930\u093e\u0938\u0940\u0902\u0927\u0917\u0915 \n\u0938\u092d\u092e \n\u0929\u092f \n\u090f\u0928\u0913\u0938\u0940 \n\u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \n\u0928 \n\u0915\u092f\u0928\u0947 \n\u092d\u0947\u0902 \n\u0905\u0929\u0940\u0930\u093e\u0925\u0940/\u0906\u0935\u0947\u0926\u0915 \u0926\u094d\u0935\u093e\u092f\u093e \u0915\u094b\u0908 \u0924\u094d\u0930\u0941\u0926\u091f \u0928\u0939\u0940\u0940\u0902 \u0925\u0940, \u0924\u094b \u0909\u0938\u0947 \u0907\u0938\u0915\u0947 \u0932\u0930\u090f \n\u0926\u0940\u0902\u0921\u0921\u0924 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u091c\u092b \u0909\u0929\u092e\u0941\u0923\u0915\u094d\u0924 \u0928\u0928\u0923\u0923\u092e \u0915\u094b \n\u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \u0915\u0940 \u0913\u092f \u0938\u0947 \u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0915\u0947 \u0938\u092d\u093a \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0915\u092e\u093e \n\n\u0909\u0926\u094d\u0918\u094b\u0937\u0923\u093e- \n\u201c\u093a\u0947\u0924\u094d\u0930\u0940\u092e \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0905\u0928\u0941\u0935\u093e\u0926\u0926\u0924 \u0928\u0928\u0923\u0923\u092e \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u0929\u0928\u0940 \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0938\u092d\u091d\u0928\u0947 \u0939\u0947\u0924\u0941 \u0928\u0928\u092b\u093e\u0923\u0927\u0927\u0924 \u092a\u094d\u0930\u092e\u094b\u0917 \n\u0915\u0947 \u0932\u0930\u092e\u0947 \u0939\u0948 \u0914\u092f \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e \u0915\u0947 \u0932\u0930\u092e\u0947 \u092a\u094d\u0930\u092e\u094b\u0917 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0940 \n\u0935\u094d\u092e\u093e\u0935\u0939\u093e\u0930\u092f\u0915 \u0914\u092f \u0938\u092f\u0915\u093e\u092f\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947, \u0928\u0928\u0923\u0923\u092e \u0915\u093e \u0905\u0940\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0940\u0902\u0938\u094d\u0915\u092f\u0923 \u092a\u094d\u0930\u093e\u092d\u093e\u0923\u0923\u0915 \u092d\u093e\u0928\u093e \n\u091c\u093e\u092e\u0947\u0917\u093e \u0924\u0925\u093e \u0928\u0928\u0937\u094d\u0929\u093e\u0926\u0928 \u0914\u092f \u0915\u093f\u092e\u093e\u0928\u094d\u0935\u092e\u0928 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947 \u092d\u093e\u0928\u094d\u092e \u0939\u094b\u0917\u093e\u201d\u0964 \n\u0917\u092e\u093e, \u0924\u094b \u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0928\u0947 \u092e\u0939 \u0926\u0947\u0916\u0924\u0947 \u0939\u0941\u090f \u0907\u0938\u0915\u093e \u0929\u093e\u0930\u0928 \u0928\u0939\u0940\u0940\u0902 \n\u0915\u0915\u092e\u093e \u0939\u0948 \u0915\u0915 \u0907\u0938 \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0926\u094d\u0935\u093e\u092f\u093e \n\u093f\u0930\u0947\u0902\u0926\u094d\u0930 \u0938 \u093f\u0902\u0939 (\u0909\u092a\u0930\u094b\u0915\u094d\u0924) \u0915\u0947 \n\u092d\u093e\u092d\u0930\u0947 \u092d\u0947\u0902 \u091c\u093e\u092f\u0940 \u0915\u0915\u090f \u0917\u090f \u0928\u0928\u0926\u0947\u0936 \u092c\u093e\u092f\u0924 \u0915\u0947 \u0938\u0940\u0902\u0935\u0935\u0927\u093e\u0928 \u0915\u0947 \u0905\u0928\u0941\u091a\u094d\u091b\u0947\u0926 \n142 \u0915\u0947 \u0924\u0939\u0924 \u0936\u091c\u0915\u094d\u0924\u092e\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092e\u094b\u0917 \u0915\u092f \u092f\u0939\u0947 \u0925\u0947\u0964 \u0909\u0929\u092e\u0941\u0923\u0915\u094d\u0924 \u0928\u0928\u0923\u0923\u092e \n\u0907\u0938 \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0915\u0947 \u0928\u0928\u0923\u0923\u092e \u0915\u0940 \u0917\u0930\u0924 \u0935\u094d\u092e\u093e\u0916\u094d\u092e\u093e \u0914\u092f/\u092e\u093e \u0917\u0930\u0924 \n\u0935\u094d\u092e\u093e\u0916\u094d\u092e\u093e \u0939\u0948\u0964 \u0907\u0938 \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0928\u0947 \u0935\u0935\u0936\u0947\u0937 \u0930\u0942\u0929 \u0938\u0947 \u0915\u093e\u0928\u0942\u0928 \u0928\u0928\u0927\u093e\u0923\u0930\u092f\u0924 \n\u0915\u0915\u092e\u093e \u0939\u0948 \u0915\u0915 \u092e\u0926\u0926 \u092e\u0939 \u0929\u093e\u092e\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u0915 \u0906\u0935\u0947\u0926\u0915 \u0915\u0940 \u0913\u092f \u0938\u0947 \n\u0915\u094b\u0908 \u091a\u0942\u0915/\u0926\u0947\u092f\u0940 \u0928\u0939\u0940\u0940\u0902 \u0939\u0941\u0908 \u0939\u0948, \u0924\u094b \u0909\u0938\u0947 \u0924\u094d\u0930\u092b\u0928\u093e \u0915\u0915\u0938\u0940 \u0917\u0930\u0924\u0940 \u0915\u0947 \u0926\u0940\u0902\u0921\u0921\u0924 \n\u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0930\u093e\u0940\u0902\u0915\u0915, \u0909\u0938 \u092d\u093e\u092d\u0930\u0947 \u092d\u0947\u0902, \u090f\u0915 \u0905\u0928\u094d\u092e \n\u0905\u092d\u094d\u092e\u0925\u0940/\u0915\u092d\u0923\u091a\u093e\u092f\u0940 \u0929\u0939\u0930\u0947 \u0938\u0947 \u0939\u0940 \u0928\u0928\u092e\u0941\u0915\u094d\u0924 \u0915\u0915\u092e\u093e \u0917\u092e\u093e \u0925\u093e, \u0907\u0938 \n\u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0928\u0947 \u092c\u093e\u092f\u0924 \u0915\u0947 \u0938\u0940\u0902\u0935\u0935\u0927\u093e\u0928 \u0915\u0947 \u0905\u0928\u0941\u091a\u094d\u091b\u0947\u0926 142 \u0915\u0947 \u0924\u0939\u0924 \n\u0936\u091c\u0915\u094d\u0924\u092e\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092e\u094b\u0917 \u0915\u092f\u0924\u0947 \u0939\u0941\u090f \u092c\u0940 \u0909\u0938\u0915\u0947 \u0938\u0947\u0935\u093e \u0915\u094b \u0938\u0941\u092f\u0915\u094d\u0937\u093a\u0924 \u0915\u0915\u092e\u093e \n\u0925\u093e\u0964 \u0907\u0938\u0932\u0930\u090f, \u0909\u0938 \u092d\u093e\u092d\u0930\u0947 \u092d\u0947\u0902 \u092c\u093e\u092f\u0924 \u0915\u0947 \u0938\u0940\u0902\u0935\u0935\u0927\u093e\u0928 \u0915\u0947 \u0905\u0928\u0941\u091a\u094d\u091b\u0947\u0926 \n142 \u0915\u0947 \u0924\u0939\u0924 \u0936\u091c\u0915\u094d\u0924\u092e\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092e\u094b\u0917 \u0926\u0942\u0938\u092f\u0947 \u0915\u092d\u0923\u091a\u093e\u092f\u0940-\u092a\u094d\u0930\u0924\u094d\u092e\u0925\u0940 \u0938\u0940\u0902\u0916\u094d\u092e\u093e \n4 \u0915\u0940 \u0938\u0947\u0935\u093e \u0938\u0941\u092f\u0915\u094d\u0937\u093a\u0924 \u0915\u092f\u0928\u0947 \u0915\u0947 \u0932\u0930\u090f \u0925\u093e\u0964 \u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0928\u0947 \u0907\u0938 \n\u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0915\u0947 \u0928\u0928\u0923\u0923\u092e \u0915\u094b \u0917\u0930\u0924 \u0938\u092d\u091d\u093e \u0939\u0948\u0964 \n5. \u0909\u0929\u092e\u0941\u0923\u0915\u094d\u0924 \u0915\u094b \u0927\u094d\u092e\u093e\u0928 \u092d\u0947\u0902 \u092f\u0916\u0924\u0947 \u0939\u0941\u090f \u0914\u092f \u090a\u0929\u092f \u092b\u0924\u093e\u090f \u0917\u090f \n\u0915\u093e\u092f\u0923\u094b\u0902 \u0938\u0947 \u0914\u092f \u0907\u0938 \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \u0926\u094d\u0935\u093e\u092f\u093e \u093f\u0930\u0947\u0902\u0926\u094d\u0930 \u0938 \u093f\u0902\u0939 (\u0909\u092a\u0930\u094b\u0915\u094d\u0924) \u0915\u0947 \n\u092d\u093e\u092d\u0930\u0947 \u092d\u0947\u0902 \u0905\u0927\u0927\u0915\u0927\u0925\u0924 \u0935\u0935\u0927\u0927 \u0915\u094b \u0930\u093e\u0917\u0942 \u0915\u092f\u0924\u0947 \u0939\u0941\u090f, \u0909\u091a\u094d\u091a \u0928\u094d\u092e\u093e\u092e\u093e\u0930\u092e \n\u0926\u094d\u0935\u093e\u092f\u093e \u0929\u093e\u0930\u092f\u0924 \u0906\u093a\u0947\u0935\u0929\u0924 \u0928\u0928\u0923\u0923\u092e \u0914\u092f \u0906\u0926\u0947\u0936 \u0905\u0929\u094b\u0937\u0923\u0940\u092e \u0939\u0948 \u0914\u092f \n\n\u0909\u0926\u094d\u0918\u094b\u0937\u0923\u093e- \n\u201c\u093a\u0947\u0924\u094d\u0930\u0940\u092e \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0905\u0928\u0941\u0935\u093e\u0926\u0926\u0924 \u0928\u0928\u0923\u0923\u092e \u0935\u093e\u0926\u0940 \u0915\u0947 \u0905\u0929\u0928\u0940 \u092c\u093e\u0937\u093e \u092d\u0947\u0902 \u0938\u092d\u091d\u0928\u0947 \u0939\u0947\u0924\u0941 \u0928\u0928\u092b\u093e\u0923\u0927\u0927\u0924 \u092a\u094d\u0930\u092e\u094b\u0917 \n\u0915\u0947 \u0932\u0930\u092e\u0947 \u0939\u0948 \u0914\u092f \u0915\u0915\u0938\u0940 \u0905\u0928\u094d\u092e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e \u0915\u0947 \u0932\u0930\u092e\u0947 \u092a\u094d\u0930\u092e\u094b\u0917 \u0928\u0939\u0940\u0940\u0902 \u0915\u0915\u092e\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0940 \n\u0935\u094d\u092e\u093e\u0935\u0939\u093e\u0930\u092f\u0915 \u0914\u092f \u0938\u092f\u0915\u093e\u092f\u0940 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947, \u0928\u0928\u0923\u0923\u092e \u0915\u093e \u0905\u0940\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0938\u0940\u0902\u0938\u094d\u0915\u092f\u0923 \u092a\u094d\u0930\u093e\u092d\u093e\u0923\u0923\u0915 \u092d\u093e\u0928\u093e \n\u091c\u093e\u092e\u0947\u0917\u093e \u0924\u0925\u093e \u0928\u0928\u0937\u094d\u0929\u093e\u0926\u0928 \u0914\u092f \u0915\u093f\u092e\u093e\u0928\u094d\u0935\u092e\u0928 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092e\u094b\u0902 \u0915\u0947 \u0932\u0930\u092e\u0947 \u092d\u093e\u0928\u094d\u092e \u0939\u094b\u0917\u093e\u201d\u0964 \n\u0907\u0938\u0947 \u0916\u093e\u0930\u092f\u091c \u0914\u092f \u0905\u0929\u093e\u0938\u094d\u0924 \u0915\u0915\u092e\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0926\u0939\u090f \u0914\u092f \u0924\u0926\u0928\u0941\u0938\u093e\u092f, \u092f\u0926\u094d\u0926 \n\u0914\u092f \u0905\u0929\u093e\u0938\u094d\u0924 \u0915\u0915\u092e\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \n6. \u092e\u0926\u0926 \u0905\u0929\u0940\u0930\u093e\u0927\u0925\u0923\u092e\u094b\u0902 \u0915\u094b \u092d\u0947\u0930\u092f\u091f \u092d\u0947\u0902 \u0939\u094b\u0928\u093e \u0929\u093e\u092e\u093e \u091c\u093e\u0924\u093e \u0939\u0948\n \u0914\u092f \n\u0905\u0928\u094d\u092e \u0929\u093e\u0924\u094d\u0930\u0924\u093e \u092d\u093e\u0928\u0926\u0940\u0902\u0921\u094b\u0902 \u0915\u094b \u0929\u0942\u092f\u093e \u0915\u092f\u0924\u0947 \u0939\u094b\u0902 \u0924\u094b \u092a\u094d\u0930\u0924\u094d\u092e\u0925\u0940 (\u0917\u0923\u094b\u0902) \u0915\u094b \n\u0906\u091c \u0938\u0947 \u091b\u0939 \u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u0940 \u0905\u0935\u0927\u0927 \u0915\u0947 \u092c\u0940\u0924\u092f \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u094d\u0935\u093e\u0938\u094d\u094d\u092e \n\u0915\u093e\u092e\u0923\u0915\u0924\u093e\u0923 (\u092d\u0926\u0939\u0930\u093e) \u0915\u0947 \u0929\u0926 \u0929\u092f \u0928\u0928\u092e\u0941\u0915\u094d\u0924 \u0915\u092f\u0928\u0947 \u0915\u093e \u0928\u0928\u0926\u0947\u0936 \u0926\u0926\u092e\u093e \n\u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u093e\u0930\u093e\u0940\u0902\u0915\u0915, \u092e\u0939 \u0938\u094d\u0929\u0937\u094d\u091f \u0915\u0915\u092e\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u0915 \u0905\u0929\u0940\u0930\u093e\u0925\u0940 \n\u0905\u0929\u0928\u0940 \u0935\u093e\u0938\u094d\u0924\u0935\u0935\u0915 \u0928\u0928\u092e\u0941\u091c\u0915\u094d\u0924\u092e\u094b\u0902 \u0915\u0940 \u0928\u0924\u0927\u0925 \u0938\u0947 \u0938\u092c\u0940 \u0930\u093e\u092c\u094b\u0902 \u0915\u0947 \u0939\u0915\u0926\u093e\u092f \n\u0939\u094b\u0902\u0917\u0947\u0964 \u0924\u0926\u0928\u0941\u0938\u093e\u092f \u0935\u0924\u0923\u092d\u093e\u0928 \u0905\u0929\u0940\u0930 \u0905\u0928\u0941\u093b\u093e\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092d\u093e\u092d\u0930\u0947 \u0915\u0947 \n\u0924\u094d\u092e\u094b\u0902 \u0914\u092f \u0929\u0930\u092f\u091c\u0938\u094d\u0925\u0928\u0924\u092e\u094b\u0902 \u092d\u0947\u0902, \u0930\u093e\u0917\u0924 \u0915\u0947 \u092b\u093e\u092f\u0947 \u092d\u0947\u0902 \u0915\u094b\u0908 \u0906\u0926\u0947\u0936 \u0928\u0939\u0940\u0940\u0902 \n\u0939\u094b\u0917\u093e\u0964 \n..................................... \n(\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0928\u0924\u0923 \u090f\u092e. \u0906\u0930. \u0936\u093e\u0939) \n..................................... \n(\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0928\u0924\u0923 \u0939\u0939\u092e\u093e \u0915\u094b\u0939\u0931\u0940) \n \n\u0928\u0908 \u0926\u0926\u0932\u094d\u0930\u0940 \n15 \u0926\u0926\u0938\u0940\u0902\u092b\u092f, 2022 \n"
}