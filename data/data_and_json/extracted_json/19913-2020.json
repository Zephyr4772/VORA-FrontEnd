32\u092a\u0940  \n\u090f\u0938\u090f\u0932\u092a\u0940  \n\u090f\u0938\u090f\u0932\u092a\u0940  \n \n ( \u0938\u0940\n\u0938\u0940\n\u0938\u0940\n\u0938\u0940\n  )   \u0938\u0902\u1b4e\u092f\u093e \n\u0938\u0902\u1b4e\u092f\u093e \n\u0938\u0902\u1b4e\u092f\u093e \n\u0938\u0902\u1b4e\u092f\u093e \n \n 21305/2022)\n\u093f\u0928\u0923\u1b45\u092f\n\u093f\u0928\u0923\u1b45\u092f\n\u093f\u0928\u0923\u1b45\u092f\n\u093f\u0928\u0923\u1b45\u092f\n\u090f\u092e\n  .   \u0906\u0930\n \n .   \u0936\u093e\u0939\n \n ,   \u091c\u0947  .\n1. \u0938\u0940\u0921\u1b63\u1b68\u092f\u0942\u092a\u0940 \u0938\u0902\u1b4e\u092f\u093e 26213/2014 \u0914\u0930 \u0905\u1b60\u092f \u0938\u0902\u092c\u1ccd \u1cef\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e\u1c90 \u092e\u1c76 \u091a\u0902\u0921\u0940\u0917\u095d \u092e\u1c76 \u092a\u0902\u091c\u093e\u092c \u0914\u0930 \u0939\u1cef\u0930\u092f\u093e\u0923\u093e \u0909\u1cac\n\u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u092a\u093e\u1cef\u0930\u0924 \u0906\u092e/\u0915\u0949\u092e\u0928 \u093f\u0928\u0923\u1b45\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u1cf0\u0926\u0928\u093e\u0902\u0915 27.10.2016 \u0938\u0947 \u1cde\u093f\u0925\u0924 \u0914\u0930 \u0905\u0938\u0902\u0924\u0941\u1ce5 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0924\u0947\n\u1c5f\u090f, \u093f\u091c\u0938\u0915\u0947 \u1cc7\u093e\u0930\u093e, \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u1cf1 \u0916\u0902\u0921\u092a\u0940\u0920 \u0928\u0947 \u0909\u1ca6 \u1cef\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e\u1c90 \u0915\u094b \u1b6d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u093f\u0932\u092f\u093e \u0939\u0948 \u0914\u0930 \u0918\u094b\u093f\u0937\u0924\n\u1cf0\u0915\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u092d\u0942\u093f\u092e \u0905\u093f\u0927\u1b95\u0939\u0923, \u092a\u0941\u0928\u0935\u093e\u1b45\u0938 \u0914\u0930 \u092a\u0941\u0928\u1b6d\u0925\u093e\u1b45\u092a\u0928 \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 2013 \u092e\u1c76 \u0909\u093f\u091a\u0924 \u092e\u0941\u0906\u0935\u091c\u093e \u0914\u0930 \u092a\u093e\u0930\u0926\u1cf6\u0936\u1b45\u0924\u093e \u0915\u0947\n\u0905\u093f\u0927\u0915\u093e\u0930 \u0915\u1cf1 \u0927\u093e\u0930\u093e 24 (2) \u0915\u0947 \u0924\u0939\u0924 \u093f\u0935\u091a\u093e\u0930\u093e\u0927\u0940\u0928 \u092d\u0942\u093f\u092e \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u1c76 \u0905\u093f\u0927\u1b95\u0939\u0923 \u0938\u092e\u093e\u1cd9/\u1cde\u092a\u0917\u0924 \u0939\u094b \u0917\u092f\u093e \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e\n\u0939\u0948, \u0939\u1cef\u0930\u092f\u093e\u0923\u093e \u0930\u093e\u1b54\u092f \u0914\u0930 \u0905\u1b60\u092f \u0928\u0947 \u0935\u0924\u1b45\u092e\u093e\u0928 \u0905\u092a\u0940\u0932\u1c82 \u0915\u094b \u1ba7\u093e\u0925\u093f\u092e\u0915\u0924\u093e/\u0935\u0930\u0940\u092f\u0924\u093e \u0926\u0940 \u0939\u0948\u0964\n2. \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u092a\u093e\u1cef\u0930\u0924 \u0906\u1b43\u0947\u093f\u092a\u0924 \u0938\u093e\u092e\u093e\u1b60\u092f (\u0915\u0949\u092e\u0928) \u093f\u0928\u0923\u1b45\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0938\u0947, \u0910\u0938\u093e \u1ba7\u0924\u0940\u0924 \u0939\u094b\u0924\u093e \u0939\u0948 \u1cf0\u0915 \u0909\u1cac\n\u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u1cf1 \u0916\u0902\u0921\u092a\u0940\u0920 \u0928\u0947 \u092a\u0948\u0930\u093e\u1b95\u093e\u092b 21 \u092e\u1c76 \u093f\u0928\u1cdc\u093e\u0928\u0941\u0938\u093e\u0930 \u0905\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u0915\u0947 \u092f\u0939 \u0918\u094b\u093f\u0937\u0924 \u1cf0\u0915\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u0909\u1c6b\u0930\u0926\u093e\u0924\u093e\u1c90 -\n\u092e\u0942\u0932 \u1cef\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e\u0915\u0924\u093e\u1b45\u1c90 \u0915\u1cf1 \u092d\u0942\u093f\u092e \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u1c76 \u0905\u093f\u0927\u1b95\u0939\u0923 \u0915\u094b \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 2013 \u0915\u1cf1 \u0927\u093e\u0930\u093e 24(2) \u0915\u0947 \u0924\u0939\u0924 \u1cde\u092a\u0917\u0924\n\u092e\u093e\u0928\u093e \u091c\u093e\u090f\u0917\u093e (\u0936\u0948\u0932 \u092c\u0940 \u0921\u0940\u1b65\u0921 \u091f\u0942 \u0939\u0948\u0935 \u0932\u0948\u1b61\u0938\u0921):-\n\"(21) \u092f\u0939 \u093f\u0928\u1cf6\u0935\u1b45\u0935\u093e\u0926 \u0939\u0948 \u1cf0\u0915 1894 \u0915\u0947 \u0905\u093f\u0927\u093f\u0928\u092f\u092e \u0915\u1cf1 \u0927\u093e\u0930\u093e 31 (2) \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u1cf1 \u0930\u093e\u093f\u0936\n\u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u092f\u093e \u0909\u0938\u0947 \u093f\u0938\u093f\u0935\u0932 \u092f\u093e \u0938\u0902\u0926\u092d\u1b45 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u1c76 \u091c\u092e\u093e \u0928\u0939\u1c6d \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\u0906\u0917\u0947 \u1ba7\u1b5c\u092f\u0947\u0915 \u092e\u093e\u092e\u0932\u0947\n\u092e\u1c76 \u0905\u093f\u0927\u093f\u0928\u0923\u1b45\u092f/\u092a\u0902\u091a\u093e\u091f \u0915\u1cf1 \u093f\u0924\u093f\u0925 \u0938\u0947 \u092f\u0939 \u0926\u0947\u0916\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u1cf0\u0915 \u0907\u1b60\u0939\u0947 01.01.2014  \u0915\u094b \u0928\u090f\n\u0905\u093f\u0927\u093f\u0928\u092f\u092e \u0915\u0947 \u0932\u093e\u0917\u0942 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u093e\u0902\u091a \u0935\u0937\u1b45 \u092f\u093e \u0909\u0938\u0938\u0947 \u0905\u093f\u0927\u0915 \u092a\u0939\u0932\u0947 \u092a\u093e\u1cef\u0930\u0924 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964\u0907\u0938 \u1ba7\u0915\u093e\u0930\n\u092f\u0939 \u1b6d\u0925\u093e\u093f\u092a\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948 \u1cf0\u0915 \u0910\u0938\u0947 \u092e\u093e\u092e\u0932\u1c82 \u092e\u1c76 \u0927\u093e\u0930\u093e 24(2) \u092e\u1c76 \u093f\u0928\u093f\u0939\u0924 \u0935\u0948\u0927\u093e\u093f\u0928\u0915 \u0936\u0924\u1c84 \u092e\u1c76 \u0938\u0947 \u090f\u0915\n\u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u0917\u0948\u0930-\u092d\u0941\u0917\u0924\u093e\u0928 \u092f\u093e \u0907\u0938\u0915\u0947 \u091c\u092e\u093e \u0939\u094b\u0928\u0947 \u0915\u1cf1 \u0924\u093e\u0930\u0940\u0916 \u0938\u0947 \u092a\u093e\u0902\u091a \u0938\u093e\u0932 \u092f\u093e \u0909\u0938\u0938\u0947\n\u0905\u093f\u0927\u0915 \u0915\u1cf1 \u0905\u0935\u093f\u0927 \u0915\u0947 \u093f\u0932\u090f \u0928\u090f \u0905\u093f\u0927\u093f\u0928\u092f\u092e \u0915\u0947 \u0932\u093e\u0917\u0942 \u0939\u094b\u0928\u0947 \u0924\u0915 \u093f\u0928\u1cf6\u0935\u1b45\u0935\u093e\u0926 \u1c68\u092a \u0938\u0947 \u1b6d\u0925\u093e\u093f\u092a\u0924 \u0939\u0948\u0964 \n\n \n\u0938\u092e\u093e\u0928 \u1c68\u092a \u0938\u0947 \u092f\u0939 \u092e\u093e\u0928\u0928\u093e \u0938\u0939\u0940 \u0939\u094b\u0917\u093e \u1cf0\u0915 \u092f\u093e\u093f\u091a\u0915\u093e\u0915\u0924\u093e\u1b45\u1c90 \u0928\u0947 \u1ba7\u1b5c\u092f\u0947\u0915 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u092f\u0939 \u1b6d\u0925\u093e\u093f\u092a\u0924\n\u1cf0\u0915\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u0905\u093f\u0927\u1b95\u0939\u0940\u0924 \u092d\u0942\u093f\u092e/\u0938\u1b65\u092a\u093f\u1c6b\u092f\u1c82 \u0915\u093e \u092d\u094c\u093f\u0924\u0915 \u0915\u1b63\u091c\u093e \u0909\u0928\u0915\u0947 \u092a\u093e\u0938 \u092c\u0928\u093e \u1c5f\u0906 \u0939\u0948\u0964\n\u201d\n2.1  \u0930\u093e\u1b54\u092f \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u092f\u0939 \u092e\u093e\u092e\u0932\u093e \u0939\u0948 \u1cf0\u0915 \u0907\u0928 \u0938\u092d\u0940 \u092e\u093e\u092e\u0932\u1c82 \u092e\u1c76 \u092d\u0942\u093f\u092e \u0905\u093f\u0927\u1b95\u0939\u0923 \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 1894  \u0915\u0947 \u0924\u0939\u0924\n\u0905\u093f\u0927\u1b95\u0939\u0923 \u0915\u1cf1 \u0915\u093e\u092f\u1b45\u0935\u093e\u0939\u0940 \u092d\u0942\u093f\u092e \u0905\u093f\u0927\u1b95\u0939\u0923 \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 1894 \u0915\u1cf1 \u0927\u093e\u0930\u093e 4/6 \u0915\u0947 \u0924\u0939\u0924 \u091c\u093e\u0930\u0940 \u0905\u093f\u0927\u0938\u0942\u091a\u0928\u093e \u0915\u094b \u091a\u0941\u0928\u094c\u0924\u0940\n\u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u092d\u0942\u093f\u092e \u092e\u093e\u093f\u0932\u0915\u1c82 \u1cc7\u093e\u0930\u093e \u091a\u0941\u0928\u094c\u0924\u0940 \u0926\u0940 \u0917\u0908 \u0925\u0940 \u0914\u0930 \u0938\u0902\u092c\u0902\u093f\u0927\u0924 \u092e\u0942\u0932 \u092d\u0942-\u1b6d\u0935\u093e\u093f\u092e\u092f\u1c82 \u0915\u094b \u0915\u094b\u0908 \u0930\u093e\u0939\u0924 \u0928\u0939\u1c6d \u093f\u092e\u0932\u0940 \u0925\u0940\u0964\n\u0939\u1cef\u0930\u092f\u093e\u0923\u093e \u0930\u093e\u1b54\u092f \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u092f\u0939 \u092d\u0940 \u092e\u093e\u092e\u0932\u093e \u0939\u0948 \u1cf0\u0915 \u0935\u093e\u1b6d\u0924\u0935 \u092e\u1c76 \u0905\u093f\u0927\u1b95\u0939\u0940\u0924 \u0915\u1cf1 \u0917\u0908 \u092d\u0942\u093f\u092e \u0915\u093e \u0915\u1b63\u091c\u093e \u0905\u093f\u0927\u0915\u093e\u0902\u0936 \u092e\u093e\u092e\u0932\u1c82\n\u092e\u1c76 \u0930\u092a\u091f/\u0930\u094b\u095b\u0928\u093e\u092e\u091a\u093e \u092c\u0928\u093e\u0915\u0930 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0932\u0947 \u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u0914\u0930 \u0907\u0938\u093f\u0932\u090f, \u0915\u1b63\u091c\u093e \u0932\u0947\u0928\u0947 \u092a\u0930, \u092d\u0942\u093f\u092e \u0930\u093e\u1b54\u092f \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u092a\u093e\u0938\n\u093f\u0928\u093f\u0939\u0924 \u0939\u0948\u0964 \u092f\u0939 \u1ba7\u1b6d\u0924\u0941\u0924 \u1cf0\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u1cf0\u0915 \u0907\u0938\u093f\u0932\u090f,  \u0907\u0902\u0926\u094c\u0930 \u093f\u0935\u0915\u093e\u0938 \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923 \u092c\u0928\u093e\u092e \u092e\u0928\u094b\u0939\u0930\u0932\u093e\u0932 \u0914\u0930 \u0905\u1b60\u092f\n\u0907\u0902\u0926\u094c\u0930 \u093f\u0935\u0915\u093e\u0938 \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923 \u092c\u0928\u093e\u092e \u092e\u0928\u094b\u0939\u0930\u0932\u093e\u0932 \u0914\u0930 \u0905\u1b60\u092f\n\u0907\u0902\u0926\u094c\u0930 \u093f\u0935\u0915\u093e\u0938 \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923 \u092c\u0928\u093e\u092e \u092e\u0928\u094b\u0939\u0930\u0932\u093e\u0932 \u0914\u0930 \u0905\u1b60\u092f\n\u0907\u0902\u0926\u094c\u0930 \u093f\u0935\u0915\u093e\u0938 \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923 \u092c\u0928\u093e\u092e \u092e\u0928\u094b\u0939\u0930\u0932\u093e\u0932 \u0914\u0930 \u0905\u1b60\u092f,\n(2020) 8  \u090f\u0938\u0938\u0940\u0938\u0940 \n\u090f\u0938\u0938\u0940\u0938\u0940 \n\u090f\u0938\u0938\u0940\u0938\u0940 \n\u090f\u0938\u0938\u0940\u0938\u0940 129 \u092e\u1c76 \u1cef\u0930\u092a\u094b\u091f\u1b45 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e,  \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u0907\u0938 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u1cf1 \u0938\u0902\u093f\u0935\u0927\u093e\u0928 \u092a\u0940\u0920 \u0915\u0947 \u093f\u0928\u0923\u1b45\u092f \u0915\u0947\n\u092e\u1cce\u0947\u0928\u091c\u0930 \u0905\u093f\u0927\u1b95\u093f\u0939\u0924 \u092d\u0942\u093f\u092e \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u1c76 \u0905\u093f\u0927\u1b95\u0939\u0923 \u0915\u1cf1 \u092e\u093e\u093f\u0928\u0924 \u1cde\u1b61\u0917\u0924\u0924\u093e \u0928\u0939\u1c6d \u092e\u093e\u0928\u0940 \u091c\u093e\u090f\u0917\u0940, (\u0926\u0947\u092f\u0930 \u0936\u0948\u0932 \u0928\u0949\u091f \u092c\u0940\n\u090f\u0928\u0940 \u0921\u0940\u1b65\u0921 \u0932\u0948\u1b61\u0938 \u0911\u095e \u090f\u1ca4\u1cf1\u091c\u0940\u0936\u0928 \u093f\u0935\u0925 \u1cef\u0930\u1b6d\u092a\u0947\u1b4d\u091f \u091f\u0942 \u0926\u0940 \u0932\u1c79\u0921\u0938 \u0905\u1ca4\u093e\u092f\u0921\u1b45) \u091c\u0948\u0938\u093e \u1cf0\u0915 \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u0926\u0947\u0916\u093e \u0914\u0930\n\u0906\u092f\u094b\u093f\u091c\u0924 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n3. \u1bb0\u0940 \u0915\u0947.\u091f\u0940.\u090f\u0938. \u0924\u0941\u0932\u0938\u0940 \u0914\u0930 \u1bb0\u0940 \u0917\u094b\u092a\u093e\u0932 \u0936\u0902\u0915\u0930\u0928\u093e\u0930\u093e\u092f\u0923\u0928, \u090f\u0938\u090f\u0932\u092a\u0940 \u0938\u0902\u1b4e\u092f\u093e 20857/2022 \u0914\u0930 28803/2018 \u092e\u1c76\n\u092e\u0942\u0932 \u1cef\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e\u0915\u0924\u093e\u1b45\u1c90 \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u092a\u0947\u0936 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u093f\u0935\u1cc7\u093e\u0928 \u0935\u1cef\u0930\u1ce7 \u0905\u093f\u0927\u0935\u1ca6\u093e \u1b93\u092e\u0936\u0903 \u0939\u0940\u0930\u093e \u1cf2\u0938\u0902\u0939 \u0914\u0930 \u1ba7\u0940\u0924\u092e \u0915\u0941\u092e\u093e\u0930\n\u0917\u094b\u092f\u0932 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76,  \u0928\u0947 \u093f\u0928\u0935\u0947\u0926\u0928 \u1cf0\u0915\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u0935\u093e\u1b6d\u0924\u0935 \u092e\u1c76 \u0938\u0902\u092c\u0902\u093f\u0927\u0924 \u092d\u0942-\u1b6d\u0935\u093e\u093f\u092e\u092f\u1c82 \u0915\u0947 \u092a\u093e\u0938 \u093f\u0935\u091a\u093e\u0930\u093e\u0927\u0940\u0928 \u092d\u0942\u093f\u092e \u0915\u093e\n\u0935\u093e\u1b6d\u0924\u093f\u0935\u0915 \u0914\u0930 \u092d\u094c\u093f\u0924\u0915 \u0915\u1b63\u091c\u093e \u0939\u0948\u0964 \u092f\u0939 \u1ba7\u1b6d\u0924\u0941\u0924 \u1cf0\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u1cf0\u0915 \u0907\u0938\u093f\u0932\u090f \u0914\u0930 \u091c\u092c \u092d\u0942\u093f\u092e \u0905\u093f\u0927\u1b95\u0939\u0923 \u0905\u093f\u0927\u093f\u0928\u092f\u092e,\n1894 \u0915\u1cf1 \u0927\u093e\u0930\u093e 31 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0905\u0926\u093e \u0928\u0939\u1c6d \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u091c\u0948\u0938\u093e \u1cf0\u0915 \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u0938\u0939\u0940\n\u0922\u0902\u0917 \u0938\u0947 \u0926\u0947\u0916\u093e \u0914\u0930 \u0905\u093f\u092d\u093f\u0928\u0927\u093e\u1b45\u1cef\u0930\u0924 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u0924\u094b \u0905\u093f\u0927\u1b95\u0939\u0923 \u0915\u1cf1 \u1cde\u092a\u0917\u0924\u0924\u093e \u092e\u093e\u0928\u0940 \u091c\u093e\u090f\u0917\u0940 (\u0926\u0947\u092f\u0930 \u0936\u0948\u0932 \u092c\u0940 \u0921\u0940\u1b65\u0921\n\u0932\u0948\u1b61\u0938 \u0911\u095e \u090f\u1ca4\u1cf1\u091c\u0940\u0936\u0928) \u1b4d\u092f\u1c82\u1cf0\u0915 \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 2013 \u0915\u1cf1 \u0927\u093e\u0930\u093e 24 (2) \u092e\u1c76 \u0909\u093f\u1b68\u0932\u093f\u0916\u0924 \u0936\u0924\u1c78 \u092a\u0942\u0930\u0940 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u1c79\u0964\n3.1 \u1bb0\u0940 \u0915\u0947.\u091f\u0940.\u090f\u0938.\u0924\u0941\u0932\u0938\u0940 \u090f\u0938\u090f\u0932\u092a\u0940 \u0938\u0902\u1b4e\u092f\u093e 20857/2022 \u092e\u1c76 \u092e\u0942\u0932 \u092d\u0942\u093f\u092e \u092e\u093e\u093f\u0932\u0915 - \u0939\u0940\u0930\u093e \u1cf2\u0938\u0902\u0939 \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u0909\u092a\u093f\u1b6d\u0925\u0924\n\u093f\u0935\u1cc7\u093e\u0928 \u0935\u1cef\u0930\u1ce7 \u0905\u093f\u0927\u0935\u1ca6\u093e \u0928\u0947 \u0906\u0935\u0947\u0926\u0928 \u0915\u0947 \u0938\u093e\u0925 \u1ba7\u1b6d\u0924\u0941\u0924 \u1cf0\u0915\u090f \u0917\u090f \u0915\u0941\u091b \u0926\u1b6d\u0924\u093e\u0935\u0947\u091c\u1c82 \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u1cf0\u0915\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u0935\u093e\u1b6d\u0924\u0935 \u092e\u1c76\n\u0938\u095c\u0915 \u0915\u0947 \u0938\u0902\u0930\u0947\u0916\u0923 (\u0930\u0940\u0905\u0932\u093e\u0907\u0928\u092e\u0947\u1b60\u091f) \u0915\u093e \u1ba7\u1b6d\u0924\u093e\u0935 \u091a\u0932 \u0930\u0939\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u093f\u0932\u090f \u093f\u091c\u0938 \u1ba7\u092f\u094b\u091c\u0928 \u0915\u0947 \u093f\u0932\u090f \u092d\u0942\u093f\u092e \u0915\u093e \u0905\u093f\u0927\u1b95\u0939\u0923\n\u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u092d\u0942\u093f\u092e \u0915\u1cf1 \u0906\u0935\u1b6b\u092f\u0915\u0924\u093e \u0928\u0939\u1c6d \u0939\u0948\u0964\n\n3.2 \u090f\u0938\u090f\u0932\u092a\u0940 \u0938\u0902\u1b4e\u092f\u093e 28803/2018 \u092e\u1c76 \u092e\u0942\u0932 \u092d\u0942\u093f\u092e \u092e\u093e\u093f\u0932\u0915 - \u1ba7\u0940\u0924\u092e \u0915\u0941\u092e\u093e\u0930 \u0917\u094b\u092f\u0932 \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u0909\u092a\u093f\u1b6d\u0925\u0924 \u0935\u1cef\u0930\u1ce7\n\u0905\u093f\u0927\u0935\u1ca6\u093e \u1bb0\u0940 \u0917\u094b\u092a\u093e\u0932 \u0936\u0902\u0915\u0930\u0928\u093e\u0930\u093e\u092f\u0923\u0928 \u0928\u0947 \u092f\u0939 \u092d\u0940 \u093f\u0928\u0935\u0947\u0926\u0928 \u1cf0\u0915\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u0935\u0924\u1b45\u092e\u093e\u0928 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u093f\u0935\u091a\u093e\u0930\u093e\u0927\u0940\u0928 \u092d\u0942\u093f\u092e \u0915\u0947 \u0921\u0940-\n\u090f\u1ca4\u1cf1\u095b\u0940\u0936\u0928 \u0915\u093e \u1ba7\u1b6d\u0924\u093e\u0935 \u0932\u0902\u093f\u092c\u0924 \u0939\u0948 \u0914\u0930 \u0938\u1cf0\u1b93\u092f \u1c68\u092a \u0938\u0947 \u093f\u0935\u091a\u093e\u0930\u093e\u0927\u0940\u0928 \u0939\u0948, \u093f\u091c\u0938\u0915\u0947 \u093f\u0932\u090f \u0909\u1b60\u0939\u1c82\u0928\u0947 \u0906\u0930\u091f\u0940\u0906\u0908 \u0905\u093f\u0927\u093f\u0928\u092f\u092e\n\u0915\u0947 \u0924\u0939\u0924 \u0909\u1c6b\u0930 \u092a\u0930 \u092c\u1c5f\u0924 \u092d\u0930\u094b\u0938\u093e \u1cf0\u0915\u092f\u093e \u0939\u0948\u0964\n3.3 \u0905\u1b60\u092f \u093f\u0935\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u093f\u0924 \u092f\u093e\u093f\u091a\u0915\u093e\u1c90 \u092e\u1c76 \u1ba7\u093f\u0924\u0935\u093e\u1cf0\u0926\u092f\u1c82 \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u0909\u092a\u093f\u1b6d\u0925\u0924 \u093f\u0935\u1cc7\u093e\u0928 \u0905\u093f\u0927\u0935\u1ca6\u093e \u0928\u0947 \u0905\u0928\u0941\u0930\u094b\u0927/\u1ba7\u093e\u0925\u1b45\u0928\u093e\n\u0915\u1cf1 \u0939\u0948 \u1cf0\u0915 \u092f\u1cf0\u0926 \u092f\u0939 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u093e\u092e\u0932\u0947 \u0915\u094b \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u0935\u093e\u092a\u0938 \u092d\u0947\u091c\u0928\u0947 (\u1cef\u0930\u092e\u093e\u0902\u0921) \u0915\u093e \u1ba7\u1b6d\u0924\u093e\u0935 \u0915\u0930\u0924\u093e/\u0930\u0916\u0924\u093e \u0939\u0948 \u0909\u0938\n\u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u092d\u0942\u093f\u092e \u092e\u093e\u093f\u0932\u0915\u1c82 \u0915\u0947 \u092a\u1b43 \u092e\u1c76 \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 2013 \u0915\u1cf1 \u0927\u093e\u0930\u093e 101 \u090f \u0915\u0947 \u0924\u0939\u0924 \u0930\u093e\u1b54\u092f \u0938\u0930\u0915\u093e\u0930 \u0938\u0947 \u0938\u0902\u092a\u0915\u1b45 \u0915\u0930\u0928\u0947 \u0915\u1cf1\n\u1b6d\u0935\u0924\u0902\u1ba2\u0924\u093e \u0906\u0930\u093f\u1b43\u0924 \u0915\u1cf1 \u091c\u093e\u0928\u0940 \u091a\u093e\u093f\u0939\u090f, \u091c\u0948\u0938\u093e \u1cf0\u0915 \u0939\u1cef\u0930\u092f\u093e\u0923\u093e \u0930\u093e\u1b54\u092f \u0915\u0947 \u093f\u0932\u090f \u0905\u093f\u0927\u1b95\u0939\u0940\u0924 \u092d\u0942\u093f\u092e \u0915\u0947 \u0905\u093f\u0927\u1b95\u0939\u0923 \u0915\u0947 \u093f\u0932\u090f\n\u0932\u093e\u0917\u0942 \u0939\u0948\u0964\n4. \u0938\u0902\u092c\u0902\u093f\u0927\u0924 \u092a\u1b43\u1c82 \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u0909\u092a\u093f\u1b6d\u0925\u0924 \u093f\u0935\u1cc7\u093e\u0928 \u0905\u093f\u0927\u0935\u1ca6\u093e \u0915\u094b \u0938\u0941\u0928\u0915\u0930 \u0914\u0930 \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u092a\u093e\u1cef\u0930\u0924 \u0906\u1b43\u0947\u093f\u092a\u0924\n\u0938\u093e\u092e\u093e\u1b60\u092f / \u0915\u0949\u092e\u0928 \u093f\u0928\u0923\u1b45\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0915\u094b \u092a\u095d\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0905\u093f\u0927\u0915 \u093f\u0935\u0936\u0947\u0937 \u1c68\u092a \u0938\u0947, \u093f\u0935\u0935\u093e\u1cf0\u0926\u0924 \u0906\u0926\u0947\u0936 \u0915\u093e \u092a\u0948\u0930\u093e 21 \u0914\u0930\n\u091c\u0948\u0938\u093e \u1cf0\u0915 \u0939\u1cef\u0930\u092f\u093e\u0923\u093e \u0930\u093e\u1b54\u092f \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u092e\u093e\u092e\u0932\u093e \u092f\u0939 \u0939\u0948 \u1cf0\u0915 \u0930\u092a\u091f/\u0930\u094b\u091c\u0928\u093e\u092e\u091a\u093e \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0915\u0947 \u093f\u0935\u091a\u093e\u0930\u093e\u0927\u0940\u0928 \u092d\u0942\u093f\u092e \u0915\u093e\n\u0915\u1b63\u091c\u093e \u0932\u0947 \u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u0914\u0930 \u090f\u0915 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u1b6d\u0925\u0917\u0928 \u0906\u0926\u0947\u0936/\u0932\u0902\u093f\u092c\u0924 \u092e\u0941\u0915\u0926\u092e\u0947\u092c\u093e\u091c\u0940 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0915\u1b63\u091c\u093e \u0928\u0939\u1c6d \u093f\u0932\u092f\u093e \u091c\u093e\n\u0938\u0915\u093e, \u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  \n\u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  \n\u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  \n\u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  (\u0909\u092a\u0930\u094b\u1ca6 \n\u0909\u092a\u0930\u094b\u1ca6 \n\u0909\u092a\u0930\u094b\u1ca6 \n\u0909\u092a\u0930\u094b\u1ca6 ) \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u0907\u0938 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u093f\u0928\u0927\u093e\u1b45\u1cef\u0930\u0924 \u0915\u093e\u0928\u0942\u0928 \u0915\u094b \u1b5f\u092f\u093e\u0928 \u092e\u1c76\n\u0930\u0916\u0924\u0947 \u1c5f\u090f \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0917\u0941\u0923\u1c82 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0928\u090f \u093f\u0938\u0930\u0947 \u0938\u0947 \u1cef\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e\u1c90 \u092a\u0930 \u093f\u0928\u0923\u1b45\u092f \u0932\u0947\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f\n\u092e\u093e\u092e\u0932\u1c82 \u0915\u094b \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u1c76 \u0935\u093e\u092a\u0938 \u092d\u0947\u091c\u0928\u0947 \u0915\u1cf1 \u0906\u0935\u1b6b\u092f\u0915\u0924\u093e \u0939\u0948 (\u0926\u0940 \u092e\u0948\u091f\u0938\u1b45 \u0906\u0930 \u1cef\u0930\u1ca4\u093e\u092f\u0921\u1b45 \u091f\u0942 \u092c\u0940 \u1cef\u0930\u092e\u093e\u1b5b\u0921\u0947\u0921 \u091f\u0942 \u0926\u0940 \u0939\u093e\u0908\n\u0915\u094b\u091f\u1b45)\u0964\n5. \u0909\u092a\u0930\u094b\u1ca6 \u0915\u0947 \u092e\u1cce\u0947\u0928\u091c\u0930 \u0914\u0930 \u090a\u092a\u0930 \u092c\u0924\u093e\u090f \u0917\u090f \u0915\u093e\u0930\u0923\u1c82 \u0915\u0947 \u0915\u093e\u0930\u0923, \u092e\u093e\u092e\u0932\u1c82 \u0915\u0947 \u0917\u0941\u0923-\u0926\u094b\u0937 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u1c76 \u0914\u0930 \u0917\u0939\u0928 \u093f\u0935\u091a\u093e\u0930\n\u1cf0\u0915\u090f \u093f\u092c\u0928\u093e \u0914\u0930 \u1cf0\u0915\u0938\u0940 \u092d\u0940 \u092a\u1b43\u0915\u093e\u0930 \u0915\u0947 \u092a\u1b43 \u092e\u1c76 \u0917\u0941\u0923-\u0926\u094b\u0937 \u092a\u0930 \u0915\u0941\u091b \u092d\u0940 \u1cde\u1ca6 \u1cf0\u0915\u090f \u093f\u092c\u0928\u093e, \u0939\u092e \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e\n\u092a\u093e\u1cef\u0930\u0924 \u0906\u1b43\u0947\u093f\u092a\u0924 \u0938\u093e\u092e\u093e\u1b60\u092f \u093f\u0928\u0923\u1b45\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0915\u094b \u0905\u092a\u093e\u1b6d\u0924 \u0915\u0930\u0924\u0947 \u0939\u1c79 \u0914\u0930 \u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  \n\u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  \n\u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  \n\u0907\u0902\u0926\u094c\u0930  \u093f\u0935\u0915\u093e\u0938  \u1ba7\u093e\u093f\u0927\u0915\u0930\u0923  (\u0909\u092a\u0930\u094b\u1ca6 \n\u0909\u092a\u0930\u094b\u1ca6 \n\u0909\u092a\u0930\u094b\u1ca6 \n\u0909\u092a\u0930\u094b\u1ca6 ) \u0915\u0947\n\u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u0907\u0938 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u093f\u0928\u0927\u093e\u1b45\u1cef\u0930\u0924 \u0915\u093e\u0928\u0942\u0928 \u0915\u094b \u1b5f\u092f\u093e\u0928 \u092e\u1c76 \u0930\u0916\u0924\u0947 \u1c5f\u090f \u0914\u0930 \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0914\u0930 \u092e\u093e\u092e\u0932\u1c82 \u0915\u1cf1\n\u0905\u092a\u0928\u0940 \u092f\u094b\u1b4f\u092f\u0924\u093e \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0928\u090f \u093f\u0938\u0930\u0947 \u0938\u0947 \u093f\u0928\u0923\u1b45\u092f \u0932\u0947\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f \u092e\u093e\u092e\u0932\u1c82 \u0915\u094b \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u1c76 \u0935\u093e\u092a\u0938 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\n(\u0930\u0947\u093f\u092e\u091f \u0926\u0940 \u092e\u0948\u091f\u0938\u1b45 \u092c\u0948\u0915 \u091f\u0942 \u0926\u0940 \u0939\u093e\u0908 \u0915\u094b\u091f\u1b45)\u0964\u0938\u092d\u0940 \u0926\u0932\u0940\u0932\u1c76 \u091c\u094b \u0938\u0902\u092c\u0902\u093f\u0927\u0924 \u092a\u1b43\u1c82 \u0915\u0947 \u093f\u0932\u090f \u0909\u092a\u0932\u1b63\u0927 \u0939\u094b \u0938\u0915\u0924\u0947 \u0939\u1c79, \u0909\u1b60\u0939\u1c76 \u0915\u093e\u0928\u0942\u0928 \u0915\u0947\n\u0905\u0928\u0941\u0938\u093e\u0930 \u0914\u0930 \u0905\u092a\u0928\u0947 \u1b6d\u0935\u092f\u0902 \u0915\u0947 \u0917\u0941\u0923\u1c82 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u093f\u0935\u091a\u093e\u0930 \u1cf0\u0915\u090f \u091c\u093e\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f \u0916\u0941\u0932\u093e \u0930\u0916\u093e \u0917\u092f\u093e \u0939\u0948\n\u0914\u0930 \u091c\u0948\u0938\u093e \u1cf0\u0915 \u0907\u0938\u092e\u1c76 \u090a\u092a\u0930 \u0926\u0947\u0916\u093e/\u0915\u0939\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n\n6. \u0939\u092e \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0938\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0924\u0947 \u0939\u1c79 \u1cf0\u0915 \u0935\u0939 \u091c\u1b68\u0926 \u0938\u0947 \u091c\u1b68\u0926 \u0914\u0930 \u0905\u093f\u0927\u092e\u093e\u0928\u0924\u0903 \u0935\u0924\u1b45\u092e\u093e\u0928 \u0906\u0926\u0947\u0936 \u0915\u1cf1 \u1ba7\u093e\u093f\u1cd9 \u0915\u1cf1\n\u0924\u093e\u0930\u0940\u0916 \u0938\u0947 \u0928\u094c \u092e\u0939\u0940\u0928\u0947 \u0915\u1cf1 \u0905\u0935\u093f\u0927 \u0915\u0947 \u092d\u0940\u0924\u0930 \u1cef\u0930\u092e\u093e\u0902\u0921 \u092a\u0930 \u1cef\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e\u1c90 \u0915\u093e \u093f\u0928\u0923\u1b45\u092f \u0914\u0930 \u093f\u0928\u092a\u091f\u093e\u0928 \u0915\u0930\u0947\u0964\u0939\u093e\u0932\u093e\u0902\u1cf0\u0915, \u092f\u0939\n\u0926\u0947\u0916\u093e \u0917\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u1cef\u0930\u092e\u093e\u0902\u0921 \u0915\u093e \u0906\u0926\u0947\u0936 \u0930\u093e\u1b54\u092f \u0938\u0930\u0915\u093e\u0930 \u0915\u094b \u092d\u0942\u093f\u092e \u0915\u0947 \u0921\u0940-\u090f\u1ca4\u1cf1\u095b\u0940\u0936\u0928 \u092a\u0930 \u0915\u094b\u0908 \u0909\u093f\u091a\u0924 \u093f\u0928\u0923\u1b45\u092f \u0932\u0947\u0928\u0947 \u0938\u0947 \u0928\u0939\u1c6d\n\u0930\u094b\u0915\u0924\u093e \u0939\u0948, \u091c\u0948\u0938\u093e \u1cf0\u0915 \u092e\u0942\u0932 \u092d\u0942\u093f\u092e \u092e\u093e\u093f\u0932\u0915 - \u1ba7\u0940\u0924\u092e \u0915\u0941\u092e\u093e\u0930 \u0917\u094b\u092f\u0932 \u0915\u1cf1 \u0913\u0930 \u0938\u0947 \u0926\u093e\u0935\u093e \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948 (\u090f\u0938\u090f\u0932\u092a\u0940 \u0938\u0902\u1b4e\u092f\u093e\n28803/2018 \u092e\u1c76) \u0914\u0930 \u0909\u0938 \u092a\u0930 \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092f\u094b\u1b4f\u092f\u0924\u093e \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0914\u0930 \u092f\u1cf0\u0926 \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u0924\u0939\u0924\n\u0905\u0928\u0941\u092e\u093f\u0924 \u0939\u094b \u0924\u094b \u093f\u0935\u091a\u093e\u0930 \u1cf0\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n7. \u0907\u0938\u0940 \u1ba7\u0915\u093e\u0930, \u090f\u0938\u090f\u0932\u092a\u0940 (\u0938\u0940) \u0938\u0902\u1b4e\u092f\u093e 2966-2967/2021 \u0914\u0930 \u0905\u1b60\u092f \u0938\u0902\u092c\u1ccd \u093f\u0935\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u093f\u0924 \u092f\u093e\u093f\u091a\u0915\u093e\u1c90 \u092e\u1c76 \u092a\u093e\u1cef\u0930\u0924\n\u0906\u0926\u0947\u0936 \u1cf0\u0926\u0928\u093e\u0902\u0915 29.09.2021 \u0915\u094b \u1b5f\u092f\u093e\u0928 \u092e\u1c76 \u0930\u0916\u0924\u0947 \u1c5f\u090f, \u092e\u0942\u0932 \u1cef\u0930\u091f \u092f\u093e\u093f\u091a\u0915\u093e\u0915\u0924\u093e\u1b45\u1c90 \u0915\u0947 \u092a\u1b43 \u092e\u1c76 \u092f\u0939 \u1b6d\u0935\u0924\u0902\u1ba2\u0924\u093e \u0906\u0930\u093f\u1b43\u0924 \u0939\u0948\n\u1cf0\u0915 \u0935\u0947 \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 2013 \u0915\u1cf1 \u0927\u093e\u0930\u093e 101 \u090f \u0915\u0947 \u0938\u0902\u0926\u092d\u1b45 \u092e\u1c76 \u0930\u093e\u1b54\u092f \u0938\u0930\u0915\u093e\u0930 \u0915\u094b \u090f\u0915 \u0905\u1b64\u092f\u093e\u0935\u0947\u0926\u0928 \u0926\u0947 \u0938\u0915\u0924\u0947 \u0939\u1c79, \u091c\u0948\u0938\u093e \u1cf0\u0915\n\u0939\u1cef\u0930\u092f\u093e\u0923\u093e \u0930\u093e\u1b54\u092f \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u0948, \u092f\u1cf0\u0926 \u0935\u0947 \u091a\u093e\u0939\u1c76 \u0924\u094b \u0906\u091c \u0938\u0947 \u090f\u0915 \u092e\u0939\u0940\u0928\u0947 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0910\u0938\u093e \u1cf0\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u093f\u091c\u0938\u092a\u0930 \u0909\u0938\u0915\u0947\n\u092c\u093e\u0926 \u091a\u093e\u0930 \u092e\u0939\u0940\u0928\u0947 \u0915\u1cf1 \u0905\u0935\u093f\u0927 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0915\u093e\u0928\u0942\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0914\u0930 \u0909\u0938\u0915\u0947 \u0917\u0941\u0923\u1c82 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u093f\u0928\u0923\u1b45\u092f \u093f\u0932\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948,\n\u093f\u091c\u0938\u0915\u0947 \u093f\u0932\u090f \u0939\u092e\u0928\u0947 \u1cf0\u0915\u0938\u0940 \u092d\u0940 \u092a\u1b43\u0915\u093e\u0930 \u0915\u0947 \u092a\u1b43 \u092e\u1c76 \u0915\u0941\u091b \u092d\u0940 \u1cde\u1ca6 \u0928\u0939\u1c6d \u1cf0\u0915\u092f\u093e \u0939\u0948\u0964\n\u0909\u092a\u0930\u094b\u1ca6 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0935\u0924\u1b45\u092e\u093e\u0928 \u0905\u092a\u0940\u0932\u1c82 \u0915\u093e \u093f\u0928\u1b6d\u0924\u093e\u0930\u0923 \u1cf0\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\u0915\u094b\u0908 \u0932\u093e\u0917\u0924/\u0916\u091a\u1b45 \u0928\u0939\u1c6d\u0964 \n[\u090f\u092e.\u0906\u0930. \u0936\u093e\u0939, \u1b60\u092f\u093e\u092f\u093e\u0927\u0940\u0936]\n[\u0938\u0940. \u091f\u0940. \u0930\u093f\u0935\u0915\u0941\u092e\