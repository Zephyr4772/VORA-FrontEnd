    "full_text": ":\nDISCLAIMER  \n \n \n \n \nThe\ntranslated\njudgement\nin\nvernacular\n \n \n \n \n \n \n \n \n \n \nlanguage is meant for the restricted use of the litigant to\n \n \n \n/ \n \n \n \n \n \n \n \nunderstand it in his\nher language and may not be used for\n \n \n. \n \n \n \n \n \n, \nany other purpose For all practical and official purposes the\n \n \n \n \n \n \n \n \n \nEnglish version of the judgement shall be authentic and shall\n \n \n \n \n \n \n \n \nhold\nthe\nfield\nfor\nthe\npurpose\nof\nexecution\nand\n.\nimplementation\n \u0a85\u0ab9\u0ac7\u0ab5\u0abe\u0ab2\u0aaf\u0acb\u0a97\u0acd\u0aaf \n  \u0aad\u0abe\u0ab0\u0aa4\u0aa8\u0ac0 \u0ab8\u0ab0\u0acd\u0ab5\u0acb\u0a9a\u0acd\u0a9a \u0a85\u0aa6\u0abe\u0ab2\u0aa4 \u0ab8\u0aae\u0a95\u0acd\u0ab7  \n\u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0 \u0a85\u0aaa\u0ac0\u0ab2\u0ac0\u0aaf \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0a95\u0acd\u0ab7\u0ac7\u0aa4\u0acd\u0ab0    \n \u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0 \u0a85\u0aaa\u0ac0\u0ab2 \u0aa8\u0a82\n \n .   \u0ae7\u0ae7\u0aec\u0ae8\n \n -  \u0ae7\u0ae7\u0aec\u0ae9 \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef  \n \n \n(\u0a8f\u0ab8\u0a8f\u0ab2\u0aaa\u0ac0 (\u0ab8\u0ac0.  \u0a86\u0ab0.  \u0a8f\u0ab2.)  \u0aa8\u0a82.  \u0ae9\u0ae8\u0ae6\u0aea-\u0ae9\u0ae8\u0ae6\u0aeb \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0aae\u0abe\u0aa5\u0ac0\n\u0a89\u0aa6\u0aad\u0ab5\u0ac7\u0ab2)\n\u0aad\u0ab0\u0aa4\u0aad\u0abe\u0a88 \u0aad\u0ac0\u0aae\u0abe\u0aad\u0abe\u0a88 \u0aad\u0ab0\u0ab5\u0abe\u0aa1                                       ....... \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\n\u0ab5\u0abf\u0ab0\u0ac1\u0aa6\u0acd\u0aa7  \n\u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4 \u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf                                             .......\u0ab8\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93\n \u0a9a\u0ac1\u0a95\u0abe\u0aa6\u0acb  \n\u0a86\u0ab0\n \n .   \u0aad\u0abe\u0aa8\u0ac1\u0aae\u0aa4\u0ac0\n \n ,   \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0aae\u0ac2\u0ab0\u0acd\u0aa4\u0abf \n \n .   \n\u0aaa\u0ab0\u0ab5\u0abe\u0aa8\u0a97\u0ac0 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 . \n\u0ae8.   \u0a86 \u0a85\u0aaa\u0ac0\u0ab2\u0acb \u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0 \u0aaa\u0ab0\u0a9a\u0ac1\u0ab0\u0aa3 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa8\u0a82.\u0ae9\u0aeb\u0ae8\u0aee \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0a85\u0aa8\u0ac7 \u0ae9\u0aeb\u0ae8\u0aef\n\u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0aae\u0abe\u0a82 \u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4 \u0ab9\u0abe\u0a87\u0a95\u0acb\u0ab0\u0acd\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe  \u0aa4\u0abe.\u0ae8\u0aec.\u0ae6\u0ae8.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe \u0ab0\u0acb\u0a9c \u0aa4\u0aa5\u0abe\n\u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0 \u0aaa\u0ab0\u0a9a\u0ac1\u0ab0\u0aa3 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa8\u0a82.\u0ae9\u0aeb\u0ae8\u0aef \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aaa\u0ac0\u0a95\u0abf\u0a82\u0a97 \u0a9f\u0a9f\u0ac2 \u0aae\u0abf\u0aa8\u0abf\u0a9f\u0acd\u0ab8 \u0aa8\u0ac0\n\u0aa8\u0acb\u0a82\u0aa7 \u0aaa\u0ab0\u0aa8\u0abe \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0ae8\u0aec.\u0ae6\u0ae8.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe \u0a86\u0aa6\u0ac7\u0ab6 \u0ab8\u0abe\u0aae\u0ac7 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7\n\u0a85\u0aa8\u0ac7 \u0a9c\u0ac7\u0aa8\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f\u0ac7 \u0ab8\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe  \u0aa8\u0a82. \u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 -\u0a86\u0ab0\u0acb\u0aaa\u0ac0 \u0aa8\u0a82.\u0ae7 \u0a85\u0aa8\u0ac7 \u0ae8  \u0aa8\u0ac7\n\u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0aa4\u0abe \u0a9f\u0a9f\u0acd\u0ab0\u0abe\u0aaf\u0ab2 \u0a95\u0acb\u0ab0\u0acd\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0ab8\u0abe\u0ab0 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2\u0abe \u0a86\u0aa6\u0ac7\u0ab6\u0aae\u0abe\u0a82 \u0aa6\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0acb\n\n\u0a87\u0aa8\u0a95\u0abe\u0ab0 \u0a95\u0ab0\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe-\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0\u0aa8\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0aa8\u0abe \u0a95\u0aa5\u0abf\u0aa4\n\u0a89\u0ab2\u0acd\u0ab2\u0a82\u0a98\u0aa8 \u0a85\u0aa8\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab6\u0ab0\u0aa4\u0acb \u0ab2\u0abe\u0aa6\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab8\u0ac7\u0ab6\u0aa8\u0acd\u0ab8 \u0a95\u0acb\u0ab0\u0acd\u0a9f\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0acd\u0aaf\u0acb\n\u0ab9\u0aa4\u0acb.\n\u0ae9.\n\u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93 \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 -\u0a86\u0ab0\u0acb\u0aaa\u0ac0 \u0aa8\u0a82.\u0ae7 \u0a85\u0aa8\u0ac7 \u0ae8 \u0aa8\u0abe \u0aaa\u0abf\u0aa4\u0abe \u0aa8\u0ac7\n\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0\u0aa8\u0abe \u0aaa\u0abf\u0aa4\u0abe-\u0aad\u0ab0\u0aa4\u0aad\u0abe\u0a88 \u0aad\u0ac0\u0aae\u0abe\u0aad\u0abe\u0a88 \u0aad\u0ab0\u0ab5\u0abe\u0aa1 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a89\u0a9b\u0ac0\u0aa8\u0abe \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0acd\u0aaf\u0abe \u0ab9\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0acb \u0ab5\u0abf\u0ab6\u0ac7 \u0a85\u0aa3\u0a97\u0aae\u0acb \u0ab9\u0acb\u0ab5\u0abe\u0aa8\u0ac7 \u0a95\u0abe\u0ab0\u0aa3\u0ac7, \u0ae7\u0ae6.\u0ae6\u0ae7.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe\n\u0ab0\u0acb\u0a9c \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0-\u0aad\u0ab0\u0aa4\u0aad\u0abe\u0a88 \u0a85\u0aa8\u0ac7 \u0ab8\u0abe\u0a95\u0acd\u0ab7\u0ac0\u0a93 \u0ab8\u0abe\u0aa5\u0ac7 \u0aa6\u0ac1\u0ab0\u0acd\u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb.\n\u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0ae7\u0ae6.\u0ae6\u0ae7.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe \u0ab0\u0acb\u0a9c \u0ae7\u0aeb.\u0ae9\u0ae6 \u0ab5\u0abe\u0a97\u0acd\u0aaf\u0ac7 \u0a95\u0abf\u0ab6\u0aa8\u0aad\u0abe\u0a88-\u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe \u0aa8\u0a82. \u0ae8\n- \u0a86\u0ab0\u0acb\u0aaa\u0ac0  \u0aa8\u0a82. \u0ae7 \u0a8f \u0a85\u0a9c\u0ac0\u0aa4\u0aad\u0abe\u0a88 (\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0\u0aa8\u0abe \u0aad\u0abe\u0a88) \u0aa8\u0abe \u0aae\u0abe\u0aa5\u0abe \u0aaa\u0ab0 \u0aa4\u0ab2\u0ab5\u0abe\u0ab0\u0aa5\u0ac0\n\u0ab9\u0ac1\u0aae\u0ab2\u0acb \u0a95\u0ab0\u0acd\u0aaf\u0acb \u0a85\u0aa8\u0ac7 \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a85\u0a9c\u0ac0\u0aa4\u0aad\u0abe\u0a88\u0a8f \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0acb \u0ab9\u0abe\u0aa5 \u0a8a\u0a82\u0a9a\u0a95\u0ac0\u0aa8\u0ac7 \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0ac7\n\u0aac\u0a9a\u0abe\u0ab5\u0ab5\u0abe\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acd\u0aaf\u0acb, \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe\u0a82 \u0aa1\u0abe\u0aac\u0abe \u0ab9\u0abe\u0aa5\u0aa8\u0ac0 \u0ab9\u0aa5\u0ac7\u0ab3\u0ac0 \u0aaa\u0ab0 \u0a95\u0abe\u0aaa\u0acb \u0aaa\u0aa1\u0ac0 \u0a97\u0aaf\u0acb\n\u0ab9\u0aa4\u0acb.  \u0a85\u0ab2\u0acd\u0aaa\u0ac7\u0ab6\u0aad\u0abe\u0a88- \u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe \u0aa8\u0a82 \u0ae9 - \u0a86\u0ab0\u0acb\u0aaa\u0ac0\u0aa8\u0a82 \u0ae8 \u0a8f \u0aaa\u0aa3 \u0a85\u0a9c\u0ac0\u0aa4\u0aad\u0abe\u0a88\u0aa8\u0ac0\n\u0a9b\u0abe\u0aa4\u0ac0 \u0aaa\u0ab0 \u0aa4\u0ab2\u0ab5\u0abe\u0ab0\u0aa5\u0ac0 \u0aaa\u0acd\u0ab0\u0ab9\u0abe\u0ab0 \u0a95\u0ab0\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a85\u0a9f\u0a9f\u0a95\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7\n\u0aaa\u0acd\u0ab0\u0ab9\u0abe\u0ab0\u0aa5\u0ac0 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0a9c\u0aae\u0aa3\u0abe \u0ab9\u0abe\u0aa5\u0aa8\u0ac0 \u0a95\u0acb\u0aa3\u0ac0 \u0aaa\u0ab0 \u0a88\u0a9c\u0abe\u0a93 \u0aa5\u0a88 \u0ab9\u0aa4\u0ac0. \u0ab0\u0ab5\u0abf\u0aad\u0abe\u0a88-\u0a86\u0ab0\u0acb\u0aaa\u0ac0\n\u0aa8.\u0ae9 \u0a8f \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0 \u0aaa\u0ab0 \u0ab2\u0abe\u0a95\u0aa1\u0ac0\u0aa8\u0abe \u0a86\u0aa1\u0ac7\u0aa7\u0aa1 \u0aaa\u0acd\u0ab0\u0ab9\u0abe\u0ab0\u0acb \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0a87\u0a9c\u0abe \u0aaa\u0ab9\u0acb\u0a82\u0a9a\u0abe\u0aa1\u0ac0\n\u0ab9\u0aa4\u0ac0.  \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0\u0aa8\u0abe \u0aae\u0abf\u0aa4\u0acd\u0ab0 \u0ab6\u0ac8\u0ab2\u0ac7\u0ab7\u0aad\u0abe\u0a88\u0aa8\u0ac7 \u0aaa\u0aa3 \u0aac\u0a82\u0aa8\u0ac7 \u0ab9\u0abe\u0aa5\u0aae\u0abe\u0a82 \u0a88\u0a9c\u0abe\u0a93 \u0aa5\u0a88 \u0ab9\u0aa4\u0ac0.\n\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6 \u0aaa\u0ab0,  \u0ab5\u0abf\u0ab0\u0aae\u0a97\u0abe\u0aae \u0a97\u0acd\u0ab0\u0abe\u0aae\u0ac0\u0aa3 \u0aaa\u0acb\u0ab2\u0ac0\u0ab8\n\u0ab8\u0acd\u0a9f\u0a9f\u0ac7\u0ab6\u0aa8\u0aae\u0abe\u0a82 \u0a86\u0a88.\u0aaa\u0ac0.\u0ab8\u0ac0\u0aa8\u0ac0 \u0a95\u0ab2\u0aae \u0ae9\u0ae8\u0ae9,\u0ae9\u0ae8\u0aea,\u0ae9\u0ae8\u0aec,\u0ae9\u0ae6\u0aed,\u0aeb\u0ae6\u0aea,\u0aeb\u0ae6\u0aec (\u0ae8)\n\u0a85\u0aa8\u0ac7 \u0ae7\u0ae7\u0aea \u0ab9\u0ac7\u0aa0\u0ab3 \u0a95\u0acd\u0ab0\u0abe\u0a88\u0aae \u0aa8\u0a82.\u0ae6\u0ae8/\u0ae8\u0ae6\u0ae7\u0aef \u0aae\u0abe\u0a82 \u0a8f\u0aab.\u0a86\u0a87.\u0a86\u0ab0 \u0aa8\u0acb\u0a82\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0\n\u0ab9\u0aa4\u0ac0.\n\u0aea.\n\u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93  \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0a86\u0ab0\u0acb\u0aaa\u0ac0\u0a93\u0aa8\u0ac0 \u0ae7\u0aec.\u0ae6\u0ae7.\u0ae8\u0ae6\u0ae7\u0aef\n\u0aa8\u0abe \u0ab0\u0acb\u0a9c  \u0aa7\u0ab0\u0aaa\u0a95\u0aa1 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac7 \u0ae7\u0aed.\u0ae6\u0ae7.\u0ae8\u0ae6\u0ae7\u0aef\u0aa8\u0abe \u0ab0\u0acb\u0a9c\n\u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0abf\u0a95 \u0a95\u0ab8\u0acd\u0a9f\u0a9f\u0aa1\u0ac0\u0aae\u0abe\u0a82 \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0aa6\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0abe \u0ab9\u0aa4\u0abe.  \u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93 \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9\n\u0a86\u0ab0\u0acb\u0aaa\u0ac0  \u0aa8\u0a82.\u0ae7 \u0a85\u0aa8\u0ac7 \u0ae8 \u0a8f \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a9c\u0ac7\u0aa8\u0ac7 \u0ab5\u0abf\u0ab0\u0aae\u0a97\u0abe\u0aae\u0aa8\u0abe\n\u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0a85\u0aa7\u0abf\u0a95 \u0ab8\u0aa4\u0acd\u0ab0 \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0abe\u0aa7\u0ac0\u0ab6 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ae6\u0aec.\u0ae6\u0ae8.\u0ae8\u0ae6\u0ae7\u0aef\u0aa8\u0abe \u0a86\u0aa6\u0ac7\u0ab6 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aae\u0a82\u0a9c\u0ac2\u0ab0\n\u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab9\u0aa4\u0ac0. \u0aa6\u0ab2\u0ac0\u0ab2\u0acb \u0a85\u0aa8\u0ac7 \u0a85\u0aa6\u0abe\u0ab2\u0aa4 \u0ab8\u0aae\u0a95\u0acd\u0ab7 \u0ab0\u0a9c\u0ac2 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0 \u0aaa\u0ab0 \u0aaa\u0aa3\n\n\u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0a85\u0aa7\u0abf\u0a95 \u0ab8\u0aa4\u0acd\u0ab0 \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0abe\u0aa7\u0ac0\u0ab6\u0ac7 \u0a85\u0ab5\u0ab2\u0acb\u0a95\u0aa8 \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a95\u0ac7 \u0a86\u0ab0\u0acb\u0aaa\u0ac0\n\u0ab8\u0abe\u0aae\u0ac7 \u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0aa6\u0ac3\u0ab7\u0acd\u0a9f\u0abf\n\u0a8f \u0a95\u0ac7\u0ab8 \u0aac\u0aa8\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a97\u0ac1\u0aa8\u0abe\u0aa8\u0ac0 \u0a97\u0a82\u0aad\u0ac0\u0ab0\u0aa4\u0abe\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0ac0 \u0aaa\u0aa1\u0ab6\u0ac7.\u0a9c\u0acb\n\u0a95\u0ac7,  \u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0a85\u0aa7\u0abf\u0a95 \u0ab8\u0aa4\u0acd\u0ab0 \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0abe\u0aa7\u0ac0\u0ab6\u0ac7 \u0a86 \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ab0 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0aae\u0a82\u0a9c\u0ac2\u0ab0 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0a95\u0ac7\n\u0a87\u0a9c\u0abe\u0a97\u0acd\u0ab0\u0ab8\u0acd\u0aa4 \u0a85\u0a9c\u0ac0\u0aa4\u0aad\u0abe\u0a88\u0aa8\u0ac7 \u0ae8\u0aea.\u0ae6\u0ae7.\u0ae8\u0ae6\u0ae7\u0aef \u0aaa\u0ab0 \u0ab9\u0acb\u0ab8\u0acd\u0aaa\u0abf\u0a9f\u0a9f\n\u0ab2\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab0\u0a9c\u0abe \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0a87\u0a9c\u0abe\u0a97\u0acd\u0ab0\u0ab8\u0acd\u0aa4 \u0ae9 \u0ab8\u0abe\u0a95\u0acd\u0ab7\u0ac0-\u0ab6\u0ac8\u0ab2\u0ac7\u0ab7\u0aad\u0abe\u0a88\u0aa8\u0ac7 \u0aaa\u0aa3 \u0ab9\u0acb\u0ab8\u0acd\u0aaa\u0abf\u0a9f\u0a9f\n\u0ab2\u0aae\u0abe\u0a82\u0aa5\u0ac0\n\u0ab0\u0a9c\u0abe \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a85\u0aa8\u0ac7 \u0a97\u0ac1\u0aa8\u0abe\u0aae\u0abe\u0a82 \u0a95\u0aa5\u0abf\u0aa4 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aae\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0abe\u0aaf\u0ac7\u0ab2\u0abe\n\u0ab9\u0aa5\u0abf\u0aaf\u0abe\u0ab0\u0acb \u0aae\u0ab3\u0ac0 \u0a86\u0ab5\u0acd\u0aaf\u0abe \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aae\u0ab9\u0aa4\u0acd\u0ab5\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab8\u0abe\u0a95\u0acd\u0ab7\u0ac0\u0a93\u0aa8\u0abe \u0aa8\u0abf\u0ab5\u0ac7\u0aa6\u0aa8\u0acb \u0aaa\u0aa3 \u0aa8\u0acb\u0a82\u0aa7\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0acd\u0aaf\u0abe \u0a9b\u0ac7. \u0a9f\u0a9f\u0acd\u0ab0\u0abe\u0aaf\u0ab2 \u0a95\u0acb\u0ab0\u0acd\u0a9f\u0ac7 \u0a8f\u0ab5\u0ac1\u0a82 \u0aaa\u0aa3 \u0aa8\u0abf\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0aa3 \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0ab9\u0aa4\u0ac1\u0a82 \u0a95\u0ac7 \u0a86\u0ab0\u0acb\u0aaa\u0ac0 \u0aaf\u0ac1\u0ab5\u0abe\u0aa8 \u0a9b\u0ac7, \u0aa4\u0ac7\u0aae\u0aa8\u0ac0\n\u0a95\u0acb\u0a88 \u0a97\u0ac1\u0aa8\u0abe\u0ab9\u0abf\u0aa4 \u0aaa\u0ac3\u0ab7\u0acd\u0aa0\u0aad\u0ac2\u0aae\u0abf \u0aa8\u0aa5\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0a93 \u0ab8\u0acb\u0a95\u0ab2\u0ac0 \u0a97\u0abe\u0aae\u0aa8\u0abe \u0a95\u0abe\u0aaf\u0aae\u0ac0 \u0ab0\u0ab9\u0ac7\u0ab5\u0abe\u0ab8\u0ac0\u0a93 \u0a9b\u0ac7\n\u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab9\u0abe\u0a9c\u0ab0\u0ac0 \u0ab8\u0ab0\u0ab3\u0aa4\u0abe\u0aa5\u0ac0 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7 \u0aa4\u0abe\u0ab0\u0aa3\u0acb \u0aaa\u0ab0,\n\u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0ab6\u0ab0\u0aa4\u0acb \u0ab2\u0abe\u0aa6\u0ac0\u0aa8\u0ac7 \u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93 \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 \u0aa8\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2.\n\u0aeb.\n\u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93 \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 \u0aa8\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0abe\u0aa8\u0abe \u0a86\u0aa6\u0ac7\u0ab6\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0aa4\u0abe,\n\u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0-\u0aad\u0ab0\u0aa4\u0aad\u0abe\u0a88\u0a8f  \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f \u0ab8\u0aae\u0a95\u0acd\u0ab7 \u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0 \u0aaa\u0ab0\u0a9a\u0ac1\u0ab0\u0aa3 \u0a85\u0ab0\u0a9c\u0ac0 \u0ae9\u0aeb\u0ae8\u0aee \u0a93\u0aab\n\u0ae8\u0ae6\u0ae7\u0aef \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ac0.  \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f\u0ac7 \u0a85\u0ab5\u0ab2\u0acb\u0a95\u0aa8 \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a95\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f \u0a95\u0abe\u0aaf\u0aae\u0ac0 \u0a9c\u0abe\u0aae\u0ac0\u0aa8\n\u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0aac\u0ac0\u0a9c\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0acb \u0ab0\u0a9c\u0ac1 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0ab9\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0ac7 \u0a8f\u0ab5\u0ac0 \u0aa6\u0ab2\u0ac0\u0ab2\u0acb\n\u0ab8\u0ac1\u0a82\u0aa7\u0ac0 \u0ab8\u0abf\u0aae\u0abf\u0aa4 \u0ab0\u0abe\u0a96\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb \u0a95\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab2\u0abe\u0aa6\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb\u0aa8\u0ac1\u0a82 \u0a89\u0ab2\u0acd\u0ab2\u0a82\u0a98\u0aa8 \u0aa5\u0aaf\u0ac1\u0a82\n\u0a9b\u0ac7, \u0aa4\u0ac7 \u0aa4\u0ab0\u0aab \u0aa7\u0acd\u0aaf\u0abe\u0aa8 \u0aa6\u0acb\u0ab0\u0aa4\u0abe \u0a95\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0ac7 \u0a8f\u0ab5\u0ac0 \u0aa6\u0ab2\u0ac0\u0ab2\u0acb \u0ab8\u0ac1\u0a82\u0aa7\u0ac0 \u0ab8\u0abf\u0aae\u0abf\u0aa4\n\u0ab0\u0abe\u0a96\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb \u0a95\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab2\u0abe\u0aa6\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb\u0aa8\u0ac1\u0a82 \u0a89\u0ab2\u0a82\u0a98\u0aa8 \u0aa5\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7,  \u0a9c\u0acb\u0a95\u0ac7\n\u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0aae\u0a82\u0a9c\u0ac2\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0acb\u0aa8\u0abe \u0a89\u0ab2\u0acd\u0ab2\u0a82\u0a98\u0aa8 \u0a85\u0a82\u0a97\u0ac7 \u0aa4\u0aa5\u0abe \u0aaf\u0acb\u0a97\u0acd\u0aaf\n\u0ab6\u0ab0\u0aa4\u0acb \u0ab2\u0abe\u0aa6\u0ab5\u0abe \u0a85\u0a82\u0a97\u0ac7 \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0acb \u0ab5\u0abe\u0a82\u0aa7\u0acb \u0a89\u0aa0\u0abe\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab8\u0ac7\u0ab6\u0aa8\u0acd\u0ab8 \u0a95\u0acb\u0ab0\u0acd\u0a9f \u0ab8\u0aae\u0a95\u0acd\u0ab7 \u0aae\u0acb\u0a95\u0ab2\u0acd\u0aaf\u0acb. \u0aa4\u0ac7\n\u0aaa\u0a9b\u0ac0 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0abe \u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0ab5\u0a95\u0ac0\u0ab2\u0ac7 \u0ab8\u0acd\u0aaa\u0ac0\u0a95\u0abf\u0a82\u0a97 \u0a9f\u0a9f\u0ac1 \u0aae\u0abf\u0aa8\u0abf\u0a9f\u0acd\u0ab8 \u0aa8\u0abe \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0aae\u0abe\u0a82 \u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0\n\u0aaa\u0ab0\u0a9a\u0ac1\u0ab0\u0aa3 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa8\u0a82.\u0ae9\u0aeb\u0ae8\u0aee \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0a85\u0aa8\u0ac7 \u0aa8\u0a82.\u0ae9\u0aeb\u0ae8\u0aee \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0aae\u0abe\u0a82\n\u0aa4\u0abe.\u0ae8\u0aec.\u0ae6\u0ae8.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe \u0ab0\u0acb\u0a9c\u0aa8\u0abe \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab9\u0ac1\u0a95\u0aae \u0aac\u0abe\u0aac\u0aa4\u0ac7 \u0ab0\u0a9c\u0abf\u0ab8\u0acd\u0a9f\u0a9f\u0acd\u0ab0\u0abe\u0ab0 \u0ab8\u0aae\u0a95\u0acd\u0ab7 \u0aa4\u0ac7 \u0aac\u0abe\u0aac\u0aa4\u0ac7\n\u0a85\u0ab0\u0a9c\u0ac0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ac0 \u0a8f\u0ab5\u0ac0 \u0aa6\u0ab2\u0ac0\u0ab2 \u0a95\u0ab0\u0ac0 \u0a95\u0ac7 \u0a97\u0ac1\u0aa8\u0acb \u0a96\u0ac2\u0aac \u0a9c \u0a97\u0a82\u0aad\u0ac0\u0ab0 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f\n\u0a86\u0ab0\u0acb\u0aaa\u0ac0\u0aa8\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0aa8\u0ac7\u0a9c \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0ac0 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa5\u0ac0,\n\u201c\u0ab8\u0acd\u0aaa\u0ac0\u0a95\u0abf\u0a82\u0a97 \u0a9f\u0a9f\u0ac1 \u0aae\u0abf\u0aa8\u0abf\u0a9f\u0acd\u0ab8\u201d  \u0aa4\u0abe.  \u0ae8\u0aec.\u0ae6\u0ae8.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0acb  \u0a86\u0aa6\u0ac7\u0ab6 \u0a95\u0ac7 \u0a9c\u0ac7 \u0aa4\u0abe\u0ab0\u0ac0\u0a96\n\n\u0ae6\u0aed.\u0ae6\u0ae9.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe \u0a86\u0aa6\u0ac7\u0ab6 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb \u0aa4\u0ac7\u0aa8\u0abe \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0aae\u0abe\u0a82\n\u0aae\u0abe\u0aa8\u0aa8\u0ac0\u0aaf \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0abe\u0aa7\u0ac0\u0ab6\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0ab8\u0abe\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0abe\u0ab0\u0acd\u0aa5\u0aa8\u0abe \u0a95\u0ab0\u0ac0 \u0a9b\u0ac7.\n\u0aec.\n\u0a85\u0aae\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0abe \u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0ab5\u0a95\u0ac0\u0ab2 \u0ab6\u0acd\u0ab0\u0ac0 \u0a85\u0aad\u0abf\n\u0ab7\u0ac7\u0a95 \u0ab8\u0abf\u0a82\u0ab9 \u0a85\u0aa8\u0ac7 \u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93\n\u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0ab5\u0ab0\u0abf\u0ab7\u0acd\u0aa0 \u0ab5\u0a95\u0ac0\u0ab2 \u0ab6\u0acd\u0ab0\u0ac0 \u0ab8\u0ac1\u0ab6\u0ac0\u0ab2 \u0a95\u0ac1\u0aae\u0abe\u0ab0 \u0a9c\u0ac8\u0aa8\u0aa8\u0ac7 \u0ab8\u0abe\u0a82\u0aad\u0ab3\u0acd\u0aaf\u0abe \u0a85\u0aa8\u0ac7\n\u0ab5\u0abe\u0aa6\u0a97\u0acd\u0ab0\u0acd\u0ab8\u0acd\u0aa4 \u0a86\u0aa6\u0ac7\u0ab6\u0acb \u0a85\u0aa8\u0ac7 \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1 \u0aaa\u0ab0\u0aa8\u0ac0 \u0a85\u0aa8\u0acd\u0aaf \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0acb \u0a85\u0aad\u0acd\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acd\u0aaf\u0acb \u0a9b\u0ac7.\n\u0aed.\n\u0a85\u0aa8\u0abf\u0ab2 \u0a95\u0ac1\u0aae\u0abe\u0ab0 \u0aaf\u0abe\u0aa6\u0ab5 \u0ab5\u0abf\u0ab0\u0ac1\u0aa6\u0acd\u0aa7 \u0ab0\u0abe\u0a9c\u0acd\u0aaf (\u0a8f\u0aa8.  \u0ab8\u0ac0.  \u0a9f\u0a9f\u0ac0 \u0a93\u0aab \u0aa6\u0abf\u0ab2\u0acd\u0ab9\u0ac0)  \u0a85\u0aa8\u0ac7\n\u0a85\u0aa8\u0acd\u0aaf (\u0ae8\u0ae6\u0ae7\u0aee) \u0ae7\u0ae8 \u0a8f\u0ab8. \u0ab8\u0ac0. \u0ab8\u0ac0. \u0ae7\u0ae8\u0aef \u0aaa\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0ab0\u0abe\u0a96\u0ac0\u0aa8\u0ac7, \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0abe\n\u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0ab5\u0a95\u0ac0\u0ab2\u0ac7 \u0ab0\u0a9c\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0ac0 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7, \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe\u0a93\n\u0a9c\u0ac7\u0ab5\u0ac0 \u0a95\u0ac7;  \u0a97\u0ac1\u0aa8\u0abe\u0aa8\u0ac0 \u0a97\u0a82\u0aad\u0ac0\u0ab0\u0aa4\u0abe\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0ac3\u0aa4\u0abf;  \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0abe\u0aa8\u0ac0 \u0a85\u0ab8\u0ab0 \u0a9c\u0ac7 \u0aab\u0ab0\u0abf\u0aaf\u0abe\u0aa6\u0ac0\n\u0aaa\u0a95\u0acd\u0ab7\u0aa8\u0abe \u0ab8\u0abe\u0a95\u0acd\u0ab7\u0ac0\u0a93 \u0aaa\u0ab0 \u0aaa\u0aa1\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7;  \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0a9a\u0ac7\u0aa1\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0a82\u0aad\u0abe\u0ab5\u0aa8\u0abe \u0a85\u0aa8\u0ac7\n\u0a85\u0aa8\u0acd\u0aaf \u0aaa\u0abe\u0ab8\u0abe\u0a93\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0abe \u0a9c\u0acb\u0a88\u0a8f. \u0a8f\u0ab5\u0ac0 \u0ab0\u0a9c\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a95\u0ac7\n\u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93 \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0abe \u0ab9\u0ac1\u0aae\u0ab2\u0abe\u0aa8\u0ac7 \u0a95\u0abe\u0ab0\u0aa3\u0ac7 \u0a87\u0a9c\u0abe\u0a97\u0acd\u0ab0\u0ab8\u0acd\u0aa4\n\u0a85\u0a9c\u0ac0\u0aa4\u0aad\u0abe\u0a88\u0a8f \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0a9c\u0aae\u0aa3\u0abe \u0a85\u0a82\u0a97\u0ac2\u0aa0\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a97\u0ac1\u0aae\u0abe\u0ab5\u0ac0 \u0aa6\u0ac0\u0aa7\u0acb \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe\n\u0aa1\u0abe\u0aac\u0abe \u0ab9\u0abe\u0aa5\u0aa8\u0ac0 \u0a9a\u0abe\u0ab0 \u0a86\u0a82\u0a97\u0ab3\u0ac0\u0a93 \u0aa8\u0abf\u0ab7\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0a9b\u0ac7 \u0a9c\u0ac7 \u0a97\u0ac1\u0aa8\u0abe\u0aa8\u0ac0 \u0a97\u0a82\u0aad\u0ac0\u0ab0\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0a86\u0a95\u0acd\u0ab7\u0ac7\u0aaa\u0acb\u0aa8\u0ac0\n\u0a97\u0a82\u0aad\u0ac0\u0ab0\u0aa4\u0abe \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7.  \u0ab5\u0aa7\u0ac1\u0aae\u0abe\u0a82 \u0a8f\u0ab5\u0ac0 \u0ab0\u0a9c\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a95\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0ab0\u0aa6\n\u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0acb\u0a97\u0ab5\u0abe\u0a88  \u0ab8\u0ac0.\u0a86\u0ab0.\u0aaa\u0ac0.\u0ab8\u0ac0 \u0aa8\u0ac0 \u0a95\u0ab2\u0aae \u0aea\u0ae9\u0aef (\u0ae8) \u0ab9\u0ac7\u0aa0\u0ab3 \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f \u0ab8\u0aae\u0a95\u0acd\u0ab7\n\u0a85\u0ab0\u0a9c\u0ac0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab9\u0acb\u0ab5\u0abe \u0a9b\u0aa4\u0abe\u0a82,  \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f \u0ab9\u0a95\u0ac0\u0a95\u0aa4\u0aae\u0abe\u0a82 \u0a97\u0ac1\u0aa8\u0abe\u0aa8\u0ac0\n\u0a97\u0a82\u0aad\u0ac0\u0ab0\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0a85\u0a9c\u0ac0\u0aa4\u0aad\u0abe\u0a88\u0aa8\u0ac7 \u0aa5\u0aaf\u0ac7\u0ab2\u0ac0 \u0a87\u0a9c\u0abe\u0a93\u0aa8\u0ac0 \u0aaa\u0acd\u0ab0\u0a95\u0ac3\u0aa4\u0abf\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab0\u0abe\u0a96\u0ac0\u0aa8\u0ac7\n\u0a86\u0ab0\u0acb\u0aaa\u0ac0\u0aa8\u0ac0 \u0aa4\u0ab0\u0aab\u0ac7\u0aa3\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0a9b\u0ac7.  \u0a8f\u0ab5\u0ac0 \u0ab0\u0a9c\u0ac2\u0a86\u0aa4\n\u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a95\u0ac7 \u0ab5\u0abf\u0aa6\u0ab5\u0abe\u0aa8 \u0a85\u0aa7\u0abf\u0a95 \u0ab8\u0aa4\u0acd\u0ab0 \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0abe\u0aa7\u0ac0\u0ab6\u0ac7 \u0aaa\u0acd\u0ab0\u0aa5\u0aae \u0aa6\u0ac3\u0ab7\u0acd\u0a9f\u0abf\n\u0a8f\n\u0a86\u0ab0\u0acb\u0aaa\u0ac0\u0aa8\u0ac0 \u0ab8\u0a82\u0aa1\u0acb\u0ab5\u0aa3\u0ac0 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0aa4\u0ac0 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0acb \u0a89\u0ab2\u0acd\u0ab2\u0ac7\u0a96 \u0a95\u0ab0\u0acd\u0aaf\u0acb \u0ab9\u0acb\u0ab5\u0abe \u0a9b\u0aa4\u0abe\u0a82,  \u0a86\u0ab0\u0acb\u0aaa\u0ac0\u0aa8\u0ac7\n\u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aad\u0ac2\u0ab2\u0aa5\u0ac0 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0acd\u0aaf\u0acb \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f\n\u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0abe \u0aae\u0aa8\u0ab8\u0acd\u0ab5\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0a86 \u0aac\u0abe\u0aac\u0aa4\u0aa8\u0ac0 \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe\n\u0aa8\u0acb\u0a82\u0aa7 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0aa8 \u0ab9\u0aa4\u0ac0. \"\u0ab8\u0acd\u0aaa\u0ac0\u0a95\u0abf\u0a82\u0a97 \u0a9f\u0a9f\u0ac1 \u0aae\u0abf\u0aa8\u0abf\u0a9f\u0acd\u0ab8\" \u0aa4\u0ab0\u0aab \u0a85\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0aa7\u0acd\u0aaf\u0abe\u0aa8 \u0aa6\u0acb\u0ab0\u0aa4\u0abe,\n\u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0ab5\u0a95\u0ac0\u0ab2\u0ac7 \u0ab0\u0a9c\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a95\u0ac7 \"\u0ab8\u0acd\u0aaa\u0ac0\u0a95\u0abf\u0a82\u0a97 \u0a9f\u0a9f\u0ac1 \u0aae\u0abf\u0aa8\u0abf\u0a9f\u0acd\u0ab8\"  \u0aae\u0abe\u0a82 \u0a89\u0aa0\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82\n\n\u0a86\u0ab5\u0ac7\u0ab2\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0acb\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab0\u0abe\u0a96\u0ac0\u0aa8\u0ac7, \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f\u0ac7 \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0aa8\u0ac7 \u0ae8\u0aec.\u0ae6\u0ae8.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe\n\u0a86\u0aa6\u0ac7\u0ab6\u0aa8\u0abe \u0ab8\u0a82\u0aa6\u0ab0\u0acd\u0aad\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aaa\u0ac0\u0a95 \u0a9f\u0a9f\u0ac1 \u0aae\u0abf\u0aa8\u0abf\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0aa4\u0a95 \u0a86\u0aaa\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f.\n\u0aee.\n\u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93 \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab5\u0abf\u0aa6\u0acd\u0ab5\u0abe\u0aa8 \u0ab5\u0ab0\u0abf\u0ab7\u0acd\u0aa0 \u0ab5\u0a95\u0ac0\u0ab2\u0ac7 \u0ab0\u0a9c\u0ac2\u0a86\u0aa4 \u0a95\u0ab0\u0ac0 \u0a95\u0ac7\n\u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f \u0aa4\u0ac7\u0aa8\u0ac0 \u0aa6\u0ab2\u0ac0\u0ab2\u0acb \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a9c\u0abe\u0aae\u0ac0\u0aa8\u0aa8\u0ac0 \u0ab6\u0ab0\u0aa4\u0aa8\u0acb \u0aad\u0a82\u0a97 \u0aa5\u0aaf\u0acb \u0ab9\u0aa4\u0acb \u0aa4\u0ac7\u0aa8\u0abe \u0aaa\u0ac1\u0ab0\u0aa4\u0ac0\n\u0aae\u0ab0\u0acd\u0aaf\u0abe\u0aa6\u0abf\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab9\u0aa4\u0ac0 \u0a85\u0aa8\u0ac7 \u0a9c\u0ac7\u0aa5\u0ac0,  \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0ae6\u0aec.\u0ae6\u0ae8.\u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0abe \u0a86\u0aa6\u0ac7\u0ab6\u0aa8\u0ac7\n\u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0ab5\u0acb \u0aa8\u0acd\u0aaf\u0abe\u0aaf\u0ac0 \u0aa8\u0aa5\u0ac0.\n\u0aef.\n\u0a9c\u0acb\u0a95\u0ac7 \u0ab8\u0ac0.\u0a86\u0ab0.\u0aaa\u0ac0.\u0ab8\u0ac0 \u0aa8\u0ac0 \u0a95\u0ab2\u0aae \u0aea\u0ae9\u0aef (\u0ae8) \u0ab9\u0ac7\u0aa0\u0ab3 \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f \u0ab8\u0aae\u0a95\u0acd\u0ab7 \u0a85\u0ab0\u0a9c\u0ac0\n\u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7,  \u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0;  \u0a85\u0ab0\u0a9c\u0ac0\u0aae\u0abe\u0a82\n\u0a89\u0aa0\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0acb\u0aa8\u0abe \u0a85\u0ab5\u0ab2\u0acb\u0a95\u0aa8 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a8f\u0ab5\u0ac1\u0a82 \u0a9c\u0acb\u0ab5\u0abe \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7 \u0a95\u0ac7\n\u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f \u0a95\u0ab2\u0aae \u0aea\u0ae9\u0aef \u0ab9\u0ac7\u0aa0\u0ab3 \u0ab8\u0abe\u0aae\u0abe\u0ab5\u0abe\u0ab3\u0abe\u0a93 \u0aa8\u0a82.\u0ae8 \u0a85\u0aa8\u0ac7 \u0ae9 \u0aa8\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8\n\u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0abe \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0aa4\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0acb \u0a89\u0aa0\u0abe\u0ab5\u0acd\u0aaf\u0abe \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8\n\u0a86\u0aaa\u0ab5\u0abe\u0aa8\u0acb \u0a86\u0aa6\u0ac7\u0ab6 \u0a95\u0abe\u0aaf\u0aa6\u0abe\u0aae\u0abe\u0a82 \u0a9f\u0a9f\u0a95\u0ac0 \u0ab6\u0a95\u0ac7 \u0aa4\u0ac7\u0aae \u0aa8\u0aa5\u0ac0. \u0a85\u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0a95 \u0ab0\u0ac0\u0aa4\u0ac7, \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a8f \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ab0 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0abe\u0aa8\u0abe \u0a86\u0aa6\u0ac7\u0ab6\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0aa4\u0ac0 \u0ab9\u0aa4\u0ac0\n\u0a95\u0ac7 \u0aa4\u0ac7 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0acb \u0aae\u0aa8\u0ab8\u0acd\u0ab5\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0ab9\u0aa4\u0acb.  \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7 \u0a85\u0aa6\u0abe\u0ab2\u0aa4\u0ac7\n\u0ab8\u0ac0.\u0aac\u0ac0.\u0a86\u0a88 \u0aae\u0abe\u0ab0\u0aab\u0aa4 \u0aaf\u0ac1.\u0aaa\u0ac0.  \u0ab0\u0abe\u0a9c\u0acd\u0aaf \u0ab5\u0abf\u0ab0\u0ac1\u0aa6\u0acd\u0aa7 \u0a85\u0aae\u0ab0\u0aae\u0aa3\u0ac0 \u0aa4\u0acd\u0ab0\u0abf\u0aaa\u0abe\u0aa0\u0ac0 (\u0ae8\u0ae6\u0ae6\u0aeb)  \u0aee\n\u0a8f\u0ab8.  \u0ab8\u0ac0.  \u0ab8\u0ac0.  \u0ae8\u0ae7\u0aae\u0abe\u0a82 \u0aa0\u0ab0\u0abe\u0ab5\u0acd\u0aaf\u0abe \u0aae\u0ac1\u0a9c\u0aac \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0aa4\u0aa5\u0acd\u0aaf\u0acb\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab2\u0a88\u0aa8\u0ac7\n\u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac0 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0acb \u0a9c\u0acb\u0a88\u0a8f.  \n\u0ae7\u0ae6.\n\u0aa4\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0aaa\u0acd\u0ab0\u0ab8\u0acd\u0aa5\u0abe\u0aaa\u0abf\u0aa4 \u0aa5\u0aaf\u0ac7\u0ab2 \u0a9b\u0ac7 \u0a95\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab2\u0abe\u0a97\u0ac1\n\u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0a85\u0aa8\u0ac7 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0abe \u0aae\u0aa8\u0ab8\u0acd\u0ab5\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0ac7 \u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0aae\u0a82\u0a9c\u0ac2\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0abe\n\u0a86\u0aa6\u0ac7\u0ab6\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0a85\u0ab2\u0a97 \u0a9b\u0ac7.  \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0 \u0aaa\u0ab0\n\u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0a95\u0ab0\u0aa4\u0ac0 \u0ab5\u0a96\u0aa4\u0ac7, \u0a95\u0acb\u0ab0\u0acd\u0a9f \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0ac7\u0a9f\u0a9f\u0ab2\u0abe\u0a95 \u0aa8\u0abf\u0ab0\u0ac0\u0a95\u0acd\u0ab7\u0aa3\u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab8\u0a82\u0a9c\u0acb\u0a97\u0acb \u0a9c\u0ac1\u0a8f\n\u0a9b\u0ac7 \u0a9c\u0ac7\u0aae \u0a95\u0ac7,  \u0aa4\u0aaa\u0abe\u0ab8 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0ac1\u0aa8\u0abe\u0ab5\u0aa3\u0ac0 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8 \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0a9a\u0ac7\u0aa1\u0abe,\n\u0ab8\u0abe\u0a95\u0acd\u0ab7\u0ac0\u0aa8\u0ac7 \u0aa7\u0aae\u0a95\u0ac0 \u0a86\u0aaa\u0ab5\u0ac0, \u0a86\u0ab0\u0acb\u0aaa\u0ac0 \u0aab\u0ab0\u0abe\u0ab0 \u0aa5\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0a82\u0aad\u0abe\u0ab5\u0aa8\u0abe \u0a85\u0aa8\u0ac7 \u0aa4\u0ac7 \u0a97\u0aa3\u0aa4\u0ab0\u0ac0 \u0aaa\u0ab0\n\u0a95\u0ac7\u0ab8\u0aa8\u0ac0 \u0ab8\u0ac1\u0aa8\u0abe\u0ab5\u0aa3\u0ac0\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab2\u0a82\u0aac \u0aa5\u0abe\u0aaf \u0a9b\u0ac7 \u0ab5\u0a97\u0ac7\u0ab0\u0ac7. \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7, \u0a9c\u0abe\u0aae\u0ac0\u0aa8\u0aa8\u0ac0 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a97\u0ac7\u0ab0\u0a95\u0abe\u0aaf\u0aa6\u0ac7\u0ab8\u0ab0\n\n\u0ab0\u0ac0\u0aa4\u0ac7 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7 \u0aa4\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ab0 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0aa4\u0abe \u0a86\u0aa6\u0ac7\u0ab6\u0aae\u0abe\u0a82, \u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0a8f \u0a9b\u0ac7 \u0a95\u0ac7\n\u0ab6\u0ac1\u0a82 \u0a9c\u0abe\u0aae\u0ac0\u0aa8\u0aa8\u0ac0 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0acb \u0a85\u0aaf\u0acb\u0a97\u0acd\u0aaf \u0a85\u0aa5\u0ab5\u0abe \u0aae\u0aa8\u0ab8\u0acd\u0ab5\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0acd\u0aaf\u0acb \u0ab9\u0aa4\u0acb.  \u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0aae\u0abe\u0a9f\u0a9f\u0ac7\u0aa8\u0ac0 \u0a85\u0ab0\u0a9c\u0ac0\u0aae\u0abe\u0a82 \u0aa7\u0acd\u0aaf\u0abe\u0aa8\u0aae\u0abe\u0a82 \u0ab2\u0ac7\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7\n\u0ab8\u0a82\u0aac\u0a82\u0aa7\u0abf\u0aa4 \u0ab8\u0abe\u0aae\u0a97\u0acd\u0ab0\u0ac0\u0aa8\u0ac0 \u0a85\u0ab5\u0a97\u0aa3\u0aa8\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab5\u0abf\u0ab5\u0ac7\u0a95\u0aac\u0ac1\u0aa6\u0acd\u0aa7\u0abf\u0aa8\u0aa8\u0abe \u0aae\u0aa8\u0ab8\u0acd\u0ab5\u0ac0 \u0a89\u0aaa\u0aaf\u0acb\u0a97\u0aa8\u0abe\n\u0a86\u0aa7\u0abe\u0ab0\u0ac7 \u0a9c\u0abe\u0aae\u0ac0\u0aa8\u0aa8\u0ac0 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0a9b\u0ac7. \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f\u0ac7 \u0a8f\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0ab5\u0abe\u0ab9\u0ac0 \u0a95\u0ab0\u0ac0 \u0a9c\u0abe\u0aa3\u0ac7 \u0a95\u0ac7\n\u0a85\u0aaa\u0ac0\u0ab2\u0a95\u0ab0\u0acd\u0aa4\u0abe\u0a8f \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ac0 \u0ab9\u0acb\u0aaf,  \u0a9c\u0ac7\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7\n\u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0a85\u0ab2\u0a97 \u0a9b\u0ac7. \u0ab5\u0abe\u0aa6\u0a97\u0acd\u0ab0\u0ab8\u0acd\u0aa4  \u0a86\u0aa6\u0ac7\u0ab6 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a86 \u0aac\u0abe\u0aac\u0aa4\u0aa8\u0ac7\n\u0aa8\u0ab5\u0ac7\u0ab8\u0ab0\u0aa5\u0ac0 \u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f \u0aae\u0abe\u0a82 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.\n\u0ae7\u0ae7.\n\u0aaa\u0ab0\u0abf\u0aa3\u0abe\u0aae\u0ac7,  \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f\u0aa8\u0abe \u0aa4\u0abe\u0ab0\u0ac0\u0a96 26.02.2019  \u0a85\u0aa8\u0ac7 07.03.2019  \u0aa8\u0abe\n\u0ab5\u0abe\u0aa6\u0a97\u0acd\u0ab0\u0acd\u0ab8\u0acd\u0aa4 \u0a86\u0aa6\u0ac7\u0ab6\u0acb\u0aa8\u0ac7 \u0ab0\u0aa6 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0a86 \u0a85\u0aaa\u0ac0\u0ab2\u0aa8\u0ac7 \u0aae\u0a82\u0a9c\u0ac2\u0ab0\u0ac0 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aae\u0ac7\u0a9f\u0a9f\u0ab0 \u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0 \u0aaa\u0ab0\u0a9a\u0ac1\u0ab0\u0aa3 \u0a85\u0ab0\u0a9c\u0ac0 \u0aa8\u0a82.\u0ae9\u0aeb\u0ae8\u0aee \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0a85\u0aa8\u0ac7\n\u0aa8\u0a82.\u0ae9\u0aeb\u0ae8\u0aef \u0a93\u0aab \u0ae8\u0ae6\u0ae7\u0aef \u0aa8\u0ac0 \u0aa8\u0ab5\u0ac7\u0ab8\u0ab0\u0aa5\u0ac0 \u0ab5\u0abf\u0a9a\u0abe\u0ab0\u0aa3\u0abe \u0aae\u0abe\u0a9f\u0a9f\u0ac7 \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f\u0aa8\u0ac7 \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82\n\u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.  \u0ab9\u0abe\u0a88\u0a95\u0acb\u0ab0\u0acd\u0a9f \u0a86 \u0aac\u0abe\u0aac\u0aa4 \u0ab8\u0abe\u0aa5\u0ac7 \u0a8f\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0ab6\u0ac7 \u0a95\u0ac7 \u0a9c\u0abe\u0aa3\u0ac7 \u0a85\u0ab0\u0a9c\u0ac0\n\u0a9c\u0abe\u0aae\u0ac0\u0aa8 \u0a86\u0aaa\u0ab5\u0abe\u0aa8\u0abe \u0a86\u0aa6\u0ac7\u0ab6\u0aa8\u0ac7 \u0aaa\u0aa1\u0a95\u0abe\u0