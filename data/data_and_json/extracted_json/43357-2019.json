94d\u0915\u0930\u0923\u200c\u092a\u094d\u0930\u093e\u092e\u093e\u0923\u093f\u0923\u0915\u200c\u092e\u093e\u0928\u093e\u200c\u091c\u093e\u090f\u0917\u093e\u200c\u0924\u0925\u093e\u200c\u0926\u093f\u0928\u0937\u094d\u092a\u093e\u0017\u0928\u200c\u0914\u0930\u200c\u0926\u093f;\u092f\u093e\u0928\u094d\u0935\u092f\u0928\u200c\u0915\u0947\u200c\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u092e\u093e\u0928\u094d\u092f\u200c\u0939\u094b\u0917\u093e\u0964\"\n\n\u0926\u093f\u0930\u094d\u092c\u0902\u0928\u093e\u200c\u0926\u093f\u0915\u0938\u0940\u200c\u0905\u0926\u093f\u0928\u0927\u093fT\u0924\u200c\u0936\u092c\u094d\u0017\u094b\u0902\u200c\u0915\u0947\u200c\u0905\u0923\u093f\u092d&\u0947\u0916\u200c\u0915\u093e\u200c\u0905\u0935&\u094b\u0915\u0928\u200c\u0926\u093f\u0935\u0935\u093e\u0017\u200c\u0915\u094b\u200c\u091c\u093f\u0938\u0926\u093f\u0935&\u200c\u092a\u094d\u0930\u0935\u0943\u0932\u093f\u0924\u094d\u0924\u200c\u0915\u0947\n\u0930\u0942\u092a\u200c\u092e\u0947\u0902\u200c\u0017\u0936\u093e\u0019\u0924\u093e\u200c\u0939\u0948\u200c\u0964\u200c\u0907\u0938\u200c\u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c\u0928\u0947\u200c\u0939\u093e&\u200c\u092e\u0947\u0902\u200c\u0939\u0940\u200c\u0938\u0930\u0930\u094d\u092c\u0902\u091c\u0940\u0924\u200c\u0915\u094c\u0930\u200c\u0930\u094d\u092c\u0902\u0928\u093e\u092e\u200c\u092a\u0902\u091c\u093e\u0930\u094d\u092c\u0902\u200c\u0930\u093e\u091c\u094d\u092f\u200c\u0935\n\u0905\u0928\u094d\u092f\u200c\u092e\u0947\u0902\u200c\u0017\u0947\u0916\u093e\u200c\u0917\u092f\u093e\u200c\u0926\u093f\u0915\u200c\u0905\u0928\u0941\u0930\u094d\u092c\u0902\u0902\"\u200c\u0915\u093e\u200c\u0909\u0932\u094d\u0932\u0918\u0928\u200c\"\u094b\u0916\u093e\"\u0921\u093c\u0940\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\u200c\u0905\u0923\u093f\u092d\u092f\u094b\u091c\u0928\n\u0915\u094b\u200c\u091c\u0928\u094d\u092e\u200c\u0928\u0939\u0940\u0902\u200c\u0017\u0947\u0924\u093e\u200c\u0939\u0948,\u200c\u091c\u0930\u094d\u092c\u0902\u200c\u0924\u0915\u200c\u0926\u093f\u0915\u200c\"\u094b\u0916\u093e\"\u0921\u093c\u0940\u200c\u0905\u0925\u0935\u093e\u200c\u0930\u094d\u092c\u0902\u0947\u0908\u092e\u093e\u0928\u200c\u0915\u0947\u200c\u0907\u0930\u093e\u0017\u0947\u200c\u0938\u0947\u200c\u092a\u094d\u0930\u093e\u0930\u092e\u094d\u092d\u200c\u092e\u0947\u0902\n\u0938\u0939\u0940\u200c\u0928\u0939\u0940\u0902\u200c\u092a\u093e\u092f\u093e\u200c\u091c\u093e\u0924\u093e\u200c\u0939\u0948\u200c\u0964\u200c\u092e\u093e\u0924\u094d\u0930\u200c\u0935\u093e\u0017\u200c\u0926\u093f\u0928\u092d\u093e\u0928\u0947\u200c\u092e\u0947\u0902\u200c\u0926\u093f\u0935\u092b&\u0924\u093e\u200c\u0915\u0947\u200c\u0906\u0930\u094b\u092a\u200c\u092a\u0930\u200c\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\n\u0915\u093e\u092f\u0019\u0935\u093e\u0939\u0940\u200c\u0936\u0941\u0930\u0941\u200c\u0915\u0930\u0928\u0947\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u092a\u092f\u093e\u0019\u092a\u094d\u0924\u200c\u0928\u0939\u0940\u0902\u200c\u0939\u0948\u200c\u0964\n10- \u090f\u0906\u0930\u0938\u0940\u0906\u0908\u200c\u0930\u094d\u092c\u0902\u0928\u093e\u092e\u200c\u0926\u093f\u0928\u092e\u0930\u093e\u200c\u0938\u0947\u0930\u0917\u094d&\u093e\u0938\u200c\u091f\u0947\u0915\u0926\u093f\u0928\u0915\u094d\u0936\u200c\u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f\u200c\u0932\u093f&\u0926\u093f\u092e\u091f\u0947\u0921\u200c\u092e\u0947\u0902\u200c\u0907\u0938\u200c\u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c\u0915\u0940\n\u0017\u094b\u200c\u0928\u094d\u092f\u093e\u092f\u093e\"\u0940\u0936\u094b\u0902\u200c\u0914\u0930\u200c\"\u094b\u0916\u093e\"\u0921\u093c\u0940\u200c\u0915\u0947\u200c\u0905\u092a\u0930\u093e\"\u200c\u0915\u0947\u200c\u0930\u094d\u092c\u0902\u0940\u091a\u200c\u0905\u0902\u0924\u0930\u200c\u092a\u0930\u200c\u0926\u093f\u0935\u091a\u093e\u0930\u200c\u0915\u0930\u0924\u0947\u200c\u0939\u0941\u090f\u200c\u0017\u0947\u0916\u093e\u200c\u0926\u093f\u0915\n\u0926\u093f\u0935\u0923\u093f\u0936\u0937\u094d\u091f\u0924\u093e\u200c\u0905\u0923\u093f\u092d\u0915\u0923\u093f\u0925\u0924\u200c\u0918\u091f\u0928\u093e\u200c\u0915\u0947\u200c\u0938\u092e\u092f\u200c\u0905\u0923\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u200c\u0915\u0947\u200c\u0906\u0936\u094d\u092f\u200c\u092a\u0930\u200c\u0926\u093f\u0928\u092d\u0019\u0930\u200c\u0915\u0930\u0924\u093e\u200c\u0939\u0948\u200c\u0964\u200c\u092f\u0926\u093f\u0017\n\u0930\u094d\u092c\u0902\u0947\u0908\u092e\u093e\u0928\u0940\u200c\u0905\u0923\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u200c\u0915\u0947\u200c\u0924\u094c\u0930\u200c\u092a\u0930\u200c\u0938\u093e\u0925\u200c&\u0947\u0928\u200c\u0017\u0947\u0928\u200c\u0915\u0947\u200c\u0938\u092e\u092f\u200c\u092a\u0930\u200c\u0939\u0940\u200c\u0938\u094d\u0925\u093e\u0926\u093f\u092a\u0924\u200c\u0939\u094b\u200c\u091c\u093e\u090f\u200c\u0924\u094b\n\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\u200c\u0017\u093e\u0927\u093f\u092f\u0924\u094d\u0935\u200c\u200c\u091c\u0941\u0921\u093c\u200c\u091c\u093e\u090f\u0917\u093e\u0964\u200c\n11-\u0926\u093f\u0935\u091c\u092f\u0915\u0941\u092e\u093e\u0930\u200c\"\u0908\u200c\u0930\u094d\u092c\u0902\u0928\u093e\u092e\u200c\u092a\u0927\u093fT\u092e\u200c\u0930\u094d\u092c\u0902\u0902\u0917\u093e&\u200c\u0930\u093e\u091c\u094d\u092f\u200c(2022)7\u200c\u090f\u0938\u0938\u0940\u0938\u0940\u200c124\u200c\u092e\u0947\u0902,\u200c\u0939\u092e\u200c\u092e\u0947\u0902\u200c\u0938\u0947\u200c\u090f\u0915\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0924\u200c\u0915\u0943\u0937\u094d\u0923\u093e\u200c\u092e\u0941\u0930\u093e\u0930\u0940\u200c\u0928\u0947\u200c\u092a\u0939&\u0947\u200c\u0915\u0947\u200c\u092b\u0948\u0938&\u094b\u0902\u200c\u0915\u0947\u200c\u0938\u0902\u0017\u092d\u0019\u200c\u092e\u0947\u0902\u200c\u0926\u093f\u0928\u092e\u094d\u0928\u093e\u0928\u0941\u0938\u093e\u0930\u200c\u0905\u0935&\u094b\u0915\u0928\u200c\u0926\u093f\u0915\u092f\u093e-\n\u201c24\u200c\u091c\u0940.\u0938\u093e\u0917\u0930\u200c\u0938\u0941\u0930\u0940\u200c\u0930\u094d\u092c\u0902\u0928\u093e\u092e\u200c\u0909\u0924\u094d\u0924\u0930\u200c\u092a\u094d\u0930\u0017\u0947\u0936\u200c\u0930\u093e\u091c\u094d\u092f\u200c(\u091c\u0940\u200c\u0938\u093e\u0917\u0930\u200c\u0938\u0941\u0930\u0940\u200c\u0930\u094d\u092c\u0902\u0928\u093e\u092e\u200c\u0909\u0924\u094d\u0924\u0930\u200c\u092a\u094d\u0930\u0017\u0947\u0936\n\u0930\u093e\u091c\u094d\u092f\u200c(2000)\u200c2\u200c\u090f\u0938\u0938\u0940\u0938\u0940\u200c636:2000\u200c(\u0938\u0940\u0906\u0930\u0906\u0908)\u200c513\u200c\u092e\u0947\u0902\u200c\u0907\u0938\u200c\u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c\u092e\u0947\u0902\n\u0905\u0935&\u094b\u0915\u0928\u200c\u0926\u093f\u0915\u092f\u093e\u200c\u0926\u093f\u0915\u200c\u0906\u0017\u0947\u0923\u093f\u0936\u0915\u093e\u200c\u091c\u093e\u0930\u0940\u200c\u0915\u0930\u0924\u0947\u200c\u0938\u092e\u092f\u200c\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\u200c\u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c\u0915\u093e\u200c\u092f\u0939\n\u0915\u0924\u0019\u0935\u094d\u092f\u200c\u0935\u200c\u0017\u093e\u0927\u093f\u092f\u0924\u094d\u0935\u200c\u0939\u0948\u200c\u0926\u093f\u0915\u200c\u0935\u0939\u200c\u0938\u093e\u0935\"\u093e\u0928\u0940\u200c\u0930\u094d\u092c\u0902\u0930\u0924\u0947,\u200c\u0926\u093f\u0935\u0936\u0947\u0937\u0924\u0903\u200c\u091c\u0930\u094d\u092c\u0902\u0926\u093f\u0915\u200c\u092e\u093e\u092e&\u093e\u200c\u0905\u0926\u093f\u0928\u0935\u093e\u092f\u0019\n\u0930\u0942\u092a\u200c\u0938\u0947\u200c\u091c\u093f\u0938\u0926\u093f\u0935&\u200c\u092a\u094d\u0930\u0935\u0943\u0932\u093f\u0924\u094d\u0924\u200c\u0915\u093e\u200c\u0939\u094b\u0964\u200c\n25.\u200c\u0907\u0938\u200c\u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c\u092e\u0947\u0902\u200c\u092a\u0942\u0923\u0019\u0924\u0903\u200c\u0017\u0940\u0935\u093e\u0928\u0940\u200c\u0926\u093f\u0935\u0935\u093e\u0017\u094b\u200c\u0915\u094b\u200c\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\u200c\u092e\u093e\u092e&\u094b\u0902\u200c\u092e\u0947\u0902\u200c\u092a\u0930\u093f\u0930\u0935\u0930\u094d\u0924\u093f\u0924\u0924\n\u0915\u0930\u0928\u0947\u200c \u0915\u0947\u200c \u0932\u093f&\u090f\u200c \u0930\u094d\u092c\u0902\u093e\u0930-\u0930\u094d\u092c\u0902\u093e\u0930\u200c \u091a\u0947\u0924\u0935\u093e\u0928\u0940\u200c \u0017\u0940\u200c \u0939\u0948\u200c \u0964\u200c \u0907\u0938\u200c \u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c \u0907\u0902\u0927\u093f\u0921\u092f\u0928\u200c \u0911\u092f&\n\u0915\u093e\u092am\u0930\u0947\u0936\u0928\n\u200c(\u0907\u0902\u0927\u093f\u0921\u092f\u0928\u200c \u0911\u092f& \u200c \u0915\u093e\u092am\u0930\u0947\u0936\u0928\u200c \u0935\u0940\u200c \u090f\u0928.\u0908.\u092a\u0940.\u0938\u0940.\n\u200c\u0907\u0902\u0927\u093f\u0921\u092f\u093e\n\u0932\u093f&\u0926\u093f\u092e\u091f\u0947\u0921(2006)\u200c6\u200c\u090f\u0938\u0938\u0940\u0938\u0940736:(2006)3 \u090f\u0938\u0938\u0940\u0938\u0940\u200c(\u0938\u0940\u0906\u0930\u0906\u0908188)\u200c\u0928\u0947\n\u092a\u094d\u0930\u091a\u0932\u093f&\u0924\u200c\"\u093e\u0930\u0923\u093e\u200c\u092a\u0930\u200c\u0927\u094d\u092f\u093e\u0928\u200c\u0926\u093f\u0017\u092f\u093e\u200c\u0926\u093f\u0915\u200c\u0017\u0940\u0935\u093e\u0928\u0940\u200c\u0915\u093e\u0928\u0942\u0928\u200c\u0909\u092a\u091a\u093e\u0930\u200c\u091c\u094d\u092f\u093e\u0017\u093e\u200c\u0938\u092e\u092f\u200c&\u0947\u0924\u0947\u200c\u0939\u0948\u0964\n\u0909\"\u093e\u0930\u0017\u093e\u0924\u093e\u0913\u0902\u200c&\u0947\u0928\u0017\u093e\u0930\u094b\u0902\u200c\u0915\u0947\u200c\u0926\u093f\u0939\u0924\u094b\u200c\u0915\u0940\u200c\u092a\u093e\u092f\u093e\u0019\u092a\u094d\u0924\u200c\u0930\u0942\u092a\u200c\u0938\u0947\u200c\u0938\u0941\u0930\u0915\u094d\u0937\u093e\u200c\u0928\u0939\u0940\u0902\u200c\u0915\u0930\u0924\u0947\u200c\u0939\u0948\u200c\u0964\n\u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c\u0928\u0947\u200c\u0906\u0917\u0947\u200c\u0915\u0939\u093e\u200c\u0926\u093f\u0915\u200c(\u0907\u0902\u0927\u093f\u0921\u092f\u0928\u200c\u0911\u092f&\u200c\u0915\u0949\u092am\u0930\u0947\u0936\u0928\u200c\u0915\u0947\u0938)\u200c(\u0907\u0902\u0927\u093f\u0921\u092f\u0928\u200c\u0911\u092f&\n\u0915\u0949\u092am\u0930\u0947\u0936\u0928\u200c \u0930\u094d\u092c\u0902\u0928\u093e\u092e\u200c \u090f\u0928.\u0908.\u092a\u0940.\u0938\u0940. \u200c\u0907\u0902\u0927\u093f\u0921\u092f\u093e\u200c \u0932\u093f&\u0926\u093f\u092e\u091f\u0947\u0921\u200c(2006)6 \u200c\u090f\u0938\u0940\u0938\u0940\u200c736:\n(2006)3\u200c\u090f\u0938\u0938\u0940\u0938\u0940\u200c(\u0938\u0940\u0906\u0930\u0906\u0908)188\u200c)\u200c\u090f\u0938\u0938\u0940\u0938\u0940\u092a\u0940\u200c749\u200c\u092a\u0948\u0930\u093e\u200c13)\u200c\n\u0909\u0926\u094d\u200c\u0918\u094b\u0937\u0923\u093e\n\u201c\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f\u200c\u092d\u093e\u0937\u093e\u200c\u092e\u0947\u0902\u200c\u0905\u0928\u0941\u0935\u093e\u0926\u093f\u0017\u0924\u200c\u0926\u093f\u0928\u0923\u0019\u092f\u200c\u0935\u093e\u0017\u0940\u200c\u0915\u0947\u200c\u0905\u092a\u0928\u0940\u200c\u092d\u093e\u0937\u093e\u200c\u092e\u0947\u0902\u200c\u0938\u092e\u091d\u0928\u0947\u200c\u0939\u0947\u0924\u0941\u200c\u0926\u093f\u0928\u0930\u094d\u092c\u0902 \u0927\u093f\"\u0924\u200c\u092a\u094d\u0930\u092f\u094b\u0917\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u0939\u0948\u200c\u0914\u0930\u200c\u0926\u093f\u0915\u0938\u0940\u200c\u0905\u0928\u094d\u092f\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u092a\u094d\u0930\u092f\u094b\u0917\u200c\u0928\u0939\u0940\u0902\u200c\u0926\u093f\u0915\u092f\u093e\u200c\u091c\u093e\u200c\u0938\u0915\u0924\u093e\u200c\u0939\u0948\u0964\u200c\u0938\u092d\u0940\u200c\u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0930\u0915\u200c\u0914\u0930\u200c\u0938\u0930\u0915\u093e\u0930\u0940\u200c\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902\u200c\u0915\u0947\u200c\u0932\u093f&\u090f,\u200c\u0926\u093f\u0928\u0923\u0019\u092f\u200c\u0915\u093e\u200c\u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0938\u0902\u0938\u094d\u0915\u0930\u0923\u200c\u092a\u094d\u0930\u093e\u092e\u093e\u0923\u093f\u0923\u0915\u200c\u092e\u093e\u0928\u093e\u200c\u091c\u093e\u090f\u0917\u093e\u200c\u0924\u0925\u093e\u200c\u0926\u093f\u0928\u0937\u094d\u092a\u093e\u0017\u0928\u200c\u0914\u0930\u200c\u0926\u093f;\u092f\u093e\u0928\u094d\u0935\u092f\u0928\u200c\u0915\u0947\u200c\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u092e\u093e\u0928\u094d\u092f\u200c\u0939\u094b\u0917\u093e\u0964\"\n\n13...... \u200c\u0017\u0940\u0935\u093e\u0928\u0940\u200c\u0926\u093f\u0935\u0935\u093e\u0017\u094b\u0902\u200c\u0914\u0930\u200c\u0017\u093e\u0935\u094b\u0902\u200c\u091c\u093f\u091c\u0938\u092e\u0947\u200c\u0915\u094b\u0908\u200c\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\u200c\u0905\u092a\u0930\u093e\"\u200c\u0936\u093e\u0926\u093f\u092e&\u200c\u0928\u0939\u0940\u0902\u200c\u0939\u0948, \u200c\u0915\u094b\n\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\u200c\u092e\u0941\u0915\u0017\u092e\u0947\u200c\u0938\u0947\u200c\u0017\u0930\u094d\u092c\u0902\u093e\u0935\u200c\u0921\u093e&\u0915\u0930\u200c\u0926\u093f\u0928\u092a\u091f\u093e\u0928\u0947\u200c\u0915\u093e\u200c\u0915\u094b\u0908\u200c\u092d\u0940\u200c\u092a\u094d\u0930\u092f\u093e\u0938\u200c\u0930\u094d\u092c\u0902\u0926\u093f\u0939\u0937\u094d\u0915\u0943\u0924\u200c\u0914\u0930\u200c\u0939\u0924\u094b\u200c\u0924\u094d\u0938\u093e\u0926\u093f\u0939\u0924\n\u0926\u093f\u0915\u092f\u093e\u200c\u091c\u093e\u0928\u093e\u200c\u091a\u093e\u0926\u093f\u0939\u090f\u200c\u0964\n12-\u200c\u0909\u092a\u0930\u094b\u0915\u094d\u0924\u200c\u200c\u091c\u093f\u0938\u0926\u094d\u0927\u093e\u0924\u094b\u0902\u200c\u0915\u094b\u200c\u0927\u094d\u092f\u093e\u0928\u200c\u092e\u0947\u0902\u200c\u0930\u0916\u0924\u0947\u200c\u0939\u0941\u090f\u200c\u0914\u0930\u200c\u092f\u0939\u200c\u092d\u0940\u200c\u0017\u0947\u0916\u0924\u0947\u200c\u0939\u0941\u090f\u200c\u0926\u093f\u0915\u200c\u0935\u0924\u0019\u092e\u093e\u0928\u200c\u0926\u093f\u0935\u0935\u093e\u0017\n\u092a\u0942\u0930\u0940\u200c\u0924\u0930\u0939\u200c\u0938\u0947\u200c\u0938\u0902\u092a\u0932\u093f\u0924\u094d\u0924\u200c\u0915\u0947\u200c\u0938\u092e\u094d\u0930\u094d\u092c\u0902\u0928\u094d\"\u200c\u092e\u0947\u0902\u200c\u0939\u0948\u200c\u0914\u0930\u200c\u0926\u093f\u0935\u0936\u0947\u0937\u200c\u0930\u0942\u092a\u200c\u0938\u0947\u200c\u0909\u0938\u0915\u0940\u200c\u0916\u0930\u0940\u0017\u200c\u0914\u0930\u200c\u0926\u093f\u0935;\u0940\u200c\u0915\u0947\n\u0938\u0902\u0930\u094d\u092c\u0902\u0902\"\u200c\u092e\u0947\u0902\u200c\u0939\u0948\u200c\u0907\u0938\u200c\u092a\u0930\u200c\u0938\u0902\u0017\u0947\u0939\u200c\u0928\u0939\u0940\u0902\u200c\u0926\u093f\u0915\u092f\u093e\u200c\u091c\u093e\u200c\u0938\u0915\u0924\u093e\u200c\u0926\u093f\u0915\u200c\u0926\u093f\u0017\u0935\u093e\u0928\u0940\u200c\u092a\u094d\u0930\u0915\u0943\u0927\u093f\u0924\u200c\u0915\u0947\u200c\u092e\u0941\u0926\u094d\u0926\u0947\u200c\u0915\u094b\u200c\u0905\u0928\u0941\u0927\u093f\u091a\u0924\n\u0930\u0942\u092a\u200c\u0938\u0947\u200c\u0906\u092a\u0930\u093e\u0927\u093f\"\u0915\u200c\u0930\u0902\u0917\u200c\u0926\u093f\u0017\u092f\u093e\u200c\u0917\u092f\u093e\u200c\u0939\u0948\u200c\u0964\n13-\u200c\u0909\u092a\u0930\u094b\u0915\u094d\u0924\u200c\u0915\u0947\u200c\u0926\u0943\u0926\u093f\u0937\u094d\u091f\u0917\u0924\u200c\u0939\u0941\u090f,\u200c\u0907&\u093e\u0939\u093e\u0930\u094d\u092c\u0902\u093e\u0017\u200c\u0909\u091a\u094d\u091a\u200c\u0928\u094d\u092f\u093e\u092f\u093e&\u092f\u200c\u0926\u094d\u0935\u093e\u0930\u093e\u200c\u0926\u093f\u0017\u0928\u093e\u0902\u0915\u200c18.10.2019\u200c\u0915\u094b\n\u092a\u093e\u0930\u093f\u0930\u0924\u200c\u0906\u0915\u094d\u0937\u0947\u0926\u093f\u092a\u0924\u200c\u0926\u093f\u0928\u0923\u0019\u092f\u200c\u0914\u0930\u200c\u0906\u0017\u0947\u0936,\u200c\u092a\u094d\u0930\u0936\u094d\u0928\u0917\u0924\u200c\u092a\u094d\u0930\u093e\u0925\u0926\u093f\u092e\u0915\u0940\u200c\u0915\u094b\u200c\u0930\u0926\u094d\u0926\u200c\u0915\u0930\u0928\u0947\u200c\u0938\u0947\u200c\u0907\u0928\u0915\u093e\u0930\u200c\u0915\u0930\u0924\u0947\n\u0939\u0941\u090f\u200c\u092e\u0941\u0915\u0017\u092e\u093e\u200c\u0905\u092a\u0930\u093e\"\u200c\u0938\u0902\u0916\u094d\u092f\u093e\u200c421/2012 \u200c\u092d\u093e\u0930\u0924\u0940\u092f\u200c\u0017\u0923\u094d\u0921\u200c\u0938\u0902\u0926\u093f\u0939\u0924\u093e\u200c1860 \u200c\u0915\u0940\u200c\"\u093e\u0930\u093e\n406/420/467/468/417/418\u200c\u0938\u0947\u200c\u0909\u0924\u094d\u092a\u0928\u094d\u0928\u200c6695/2012\u200c\u0915\u0947\u200c\u0924\u0939\u0924\u200c2013\u200c\u0915\u0940\n\u0938\u0902\u0916\u094d\u092f\u093e\u200c32337\u200c\u0915\u094b\u200c\u0905\u092a\u093e\u0938\u094d\u0924\u200c\u0926\u093f\u0915\u092f\u093e\u200c\u0917\u092f\u093e\u200c\u0964\u200c\u0905\u092a\u0940&\u200c\u0938\u094d\u0935\u0940\u0915\u093e\u0930\u200c\u0915\u0940\u200c\u091c\u093e\u0924\u0940\u200c\u0939\u0948\u200c\u0964\u200c\n14-\u200c \u0939\u093e&\u093e\u0902\u0926\u093f\u0915\u200c\u092f\u0939\u200c\u0938\u094d\u092a\u0937\u094d\u091f\u200c\u0926\u093f\u0915\u092f\u093e\u200c\u091c\u093e\u0924\u093e\u200c\u0939\u0948\u200c\u0926\u093f\u0915\u200c\u0905\u0935&\u094b\u0915\u0928\u200c\u0915\u093e\u200c\u0017\u0940\u0935\u093e\u0928\u0940\u200c\u092a\u094d\u0930\u0935\u0943\u0932\u093f\u0924\u094d\u0924\u200c\u0915\u0947\u200c\u0926\u093f\u0915\u0938\u0940\u200c\u092d\u0940\n\u0909\u092a\u091a\u093e\u0930\u200c\u092a\u0930\u200c\u0915\u094b\u0908\u200c\u0905\u0938\u0930\u200c\u0928\u0939\u0940\u0902\u200c\u0939\u094b\u0917\u093e,\u200c\u091c\u094b\u200c\u0915\u093e\u0928\u0942\u0928\u200c\u0915\u0947\u200c\u0905\u0928\u094d\u0924\u0917\u0019\u0924\u200c\u092a\u094d\u0930\u0927\u093f\u0924\u0935\u093e\u0017\u0940\u200c\u0938\u0902\u0916\u094d\u092f\u093e\u200c2\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\n\u0909\u092a&\u092c\u094d\"\u200c\u0939\u094b\u200c\u0938\u0915\u0924\u093e\u200c\u0939\u0948\u200c\u0964\n15-\u200c\u0935\u093e\u0017\u200c\u0915\u0947\u200c\u0905\"\u0940\u0928,\u200c\u092f\u0926\u093f\u0017\u200c\u0915\u094b\u0908\u200c\u0906\u0935\u0947\u0017\u0928\u200c\u0939\u094b,\u200c\u0915\u094b\u200c\u0926\u093f\u0928\u0938\u094d\u0924\u093e\u0930\u0923\u200c\u0926\u093f\u0915\u092f\u093e\u200c\u091c\u093e\u0924\u093e\u200c\u0939\u0948\u0964\n\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\u200c\n\u200c.......................\u2026\n\u200c\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0924\u200c\u0915\u0943\u0937\u094d\u0923\u200c\u092e\u0941\u0930\u093e\u0930\u0940\n.......................\u2026\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0924\u200c\u0938\u0902\u091c\u092f\u200c\u0915\u0930\u094b&\n\u0928\u0908\u200c\u0926\u093f\u0017\u0932\u094d\u0932\u0940\n\u200c03\u200c\u092e\u0908,\u200c2023\n\u0909\u0926\u094d\u200c\u0918\u094b\u0937\u0923\u093e\n\u201c\u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f\u200c\u092d\u093e\u0937\u093e\u200c\u092e\u0947\u0902\u200c\u0905\u0928\u0941\u0935\u093e\u0926\u093f\u0017\u0924\u200c\u0926\u093f\u0928\u0923\u0019\u092f\u200c\u0935\u093e\u0017\u0940\u200c\u0915\u0947\u200c\u0905\u092a\u0928\u0940\u200c\u092d\u093e\u0937\u093e\u200c\u092e\u0947\u0902\u200c\u0938\u092e\u091d\u0928\u0947\u200c\u0939\u0947\u0924\u0941\u200c\u0926\u093f\u0928\u0930\u094d\u092c\u0902 \u0927\u093f\"\u0924\u200c\u092a\u094d\u0930\u092f\u094b\u0917\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u0939\u0948\u200c\u0914\u0930\u200c\u0926\u093f\u0915\u0938\u0940\u200c\u0905\u0928\u094d\u092f\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u092a\u094d\u0930\u092f\u094b\u0917\u200c\u0928\u0939\u0940\u0902\u200c\u0926\u093f\u0915\u092f\u093e\u200c\u091c\u093e\u200c\u0938\u0915\u0924\u093e\u200c\u0939\u0948\u0964\u200c\u0938\u092d\u0940\u200c\u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0930\u0915\u200c\u0914\u0930\u200c\u0938\u0930\u0915\u093e\u0930\u0940\u200c\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902\u200c\u0915\u0947\u200c\u0932\u093f&\u090f,\u200c\u0926\u093f\u0928\u0923\u0019\u092f\u200c\u0915\u093e\u200c\u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940\n\u0938\u0902\u0938\u094d\u0915\u0930\u0923\u200c\u092a\u094d\u0930\u093e\u092e\u093e\u0923\u093f\u0923\u0915\u200c\u092e\u093e\u0928\u093e\u200c\u091c\u093e\u090f\u0917\u093e\u200c\u0924\u0925\u093e\u200c\u0926\u093f\u0928\u0937\u094d\u092a\u093e\u0017\u0928\u200c\u0914\u0930\u200c\u0926\u093f;\u092f\u093e\u0928\u094d\u0935\u092f\u0928\u200c\u0915\u0947\u200c\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902\u200c\u0915\u0947\u200c\u0932\u093f&\u090f\u200c\u092e\u093e\u0928\u094d\u092f\u200c\u0939\u094b\u0917\u093e\u0964\"\n"
}