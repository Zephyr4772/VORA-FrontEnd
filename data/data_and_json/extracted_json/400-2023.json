\u0c30\u0455\u023a \u0c2a\u0c30\u0c1a\u00f0\u011b\u0108 \u0c17\u0c32 \n \n\u00e4\u0c30\u00f2\u0460 \u0c38\u045c\u010d\u0c24\u0416\u0c28\u0126 \u0c2e\u0122\u045d \u00f7\u0242\u0c2f\u0416\u0c28\u0126 \u0c2e\u0122\u045d \u0c0e\u013f\u0233\u0140\u014d \u0c07\u0458\u023d\u0450  \u00f8\u0c30\u0c26\u0c30\u0248\u0c15 \n\u02aa\u02de\u0c2f\u0457 \u0c05\u0c35\u0c32\u0c02\u011f\u0465\u0238\u0c28\u023c\u0c02\u0455\u0c28,  \u01e2\u0c30\u0c35\u013f\u0c2f \u0129\u0c02\u010a\u0220 \u0c1c\u0114\u0230  \n\u016e\u0460\u0c35\u0122\u0c02\u010d\u0c28 \u0126\u0102\u00f5\u0c38\u023d\u0c26 \u0c09\u0c24\u0238\u045e\u0247 \n\u0198\u0112\u0233\u0192\u0c2f\u0c2c\u0114\u0c02\u0119. \u0126\u0c37\u0c2f \u011b\u00fd\u0c2e\u0c15  \u02aa\u02de\u0c2f\u0457 \u0c08 \u01d6\u044b \u0457\u0c02\u0114 \u016a\u0c02\u0450 \u0163\u0c32\u01d8\u0245, \u049e\u0122\u0238 \u0179\u0129 \n\u0c38\u0c02\u0c2d\u0c35\u013f\u0c2f \u011b\u00fd\u0c2e\u0c15  \n\u0c2a\u02c9\u0c32\u0457 \u0c05\u0c02\u0c26\u017b\u00fd\u0c32\u011b \u0c0e\u013f\u0233\u0140\u014d\u011b \u0c06\u0185\u0127\u0c02\u0c1a\u0c21\u0416\u0c28\u0119. \n \n \u0412\u0c28 \u0188\u01b2\u0229\u0c28\u023c \u02aa\u00e4\u0c30\u0c02, \u0122\u020e \u0c05\u0140\u023d\u0461\u0245 \u0c05\u0457\u0c2e\u0117\u04ab\u0238 \u013b\u045e\u023d \u0179\u0c2f\u0c21\u0416\u0c28\u0119. \u0126\u0126\u0c27 \n\u0c26\u0c30\u00e5\u0465\u0238\u0460 \u0c0f\u0416\u00f7 \u0164\u0c02\u0114\u0c02\u0206 \u01d8  \u0c09\u0c02\u017e \u0102\u0112\u011b \u045c\u010a\u0c02\u0c1a\u0c21\u0416\u0c28\u0119. \u0c16\u045e\u022e\u0c32  \u0c09\u0c24\u0238\u045e\u0247\u0460 \u0190\u0462.\u201d  \n \n \n \u049e\u0122\u0238 \u011b\u00fd\u0c2e\u0c15 \u02aa\u02de\u0c2f\u0457 \u0c06 \u01d6\u044b \u0457\u0c02\u0114  \u016a\u0c02\u0450 \u0163\u0c32\u01d8\u0245 \u049e\u0122\u0238 \n\u0179\u00fd\u0c32\u011b \u0c2e\u0122\u045d \u0c05\u0112\u0233 \u0c2a\u0122\u00f2\u00fc\u0c32 \u0c2b\u0124\u0c24\u0c02\u00e6 \u011b\u00fd\u0c2e\u0c15 \u0c09\u0c24\u0238\u045e\u0247\u0c32\u0457 \n\u0c05\u0c02\u0c26\u017b\u00fd\u0c32\u011b \n\u0420\u01bc\u045e\u0233 \n\u0c06\u0185\u0127\u0c02\u010d\u0c28\u0c02\u0455\u0c28, \n\u011b\u00fd\u0c2e\u0c15 \n\u02aa\u02de\u0c2f\u0457 \n\u0198\u0c28\u0105\u010a\u0c02\u010d\u0c2c\u0114\u0c28\u0119, \u0c0e\u0c02\u011c\u0c15 \u00eb\u011e\u00f3 \u048a\u00f0 \u0129\u0c26\u023b\u0c02 \u0179\u0c2f\u0c2c\u0114\u0c28\u0119. \u0c05\u0121\u0183, \n\u02aa\u0117\u0102\u0455\u0460 \u01bc\u045e\u0233 \u011a\u0c15\u0229\u0c30\u0c23 \u0174\u0465 \u02aa\u0192\u0c36\u0164\u0112\u0233\u0c28\u0c02\u0455 \u0c35\u0c32\u0245 \u011b\u00fd\u0c2e\u0c15 \u0c09\u0c24\u0238\u045e\u0247\u0460 \n\u00f3\u00f3\u0229\u0124\u0c15\u0c02\u00e6 \u00eb\u0146 \u0179\u0c2f \u0c2c\u00f0\u0235\u0c2f\u011b \u0126\u00f5\u0242\u0c02\u0453\u041a\u0c28 \u01b9\u0124\u0129\u0c1f\u021e \u0c1c\u0c28\u0c30\u0220 \u011b\u0192\u0119\u0c02\u00e9\u045e.  \n \n  \u0c08 \u0126\u0c37\u0c2f\u0c02\u01d8 \u01bc\u045e\u0233 \u01c3\u0c15\u0242\u0c02 \u0179\u0465\u0444\u011b \u0c24\u010a\u0c28 \u0126\u0c27\u0c02\u00e6 \u0c09\u0c24\u0238\u045e\u0247\u0460 \u00eb\u0146 \n\u0179\u0c2f\u0c35\u0c1a\u022e\u011b \u0c06\u0c2f\u0c28 \u0102\u0119\u0c02\u00e9\u045e. \n12. \u0126\u00f5\u0242\u0c35\u0c02\u0453\u041a\u0c28 \u00f7\u0242\u0c2f\u0102\u0119 \u0321 \u0c05\u045e\u0212 \u0150. \u0129\u00f7\u024b \u0102\u0c26\u0c28\u0460 \u0126\u011b\u011c\u04ab\u0238, \n\u02aa\u0117\u0102\u0455\u0460 \u04a1 \u011b\u00fe\u0247\u0129\u0453\u0c32\u011b, \u0102\u0461\u0245 \u011b\u00fd\u0c2e\u00e4\u011b\u0108 \u0c05\u045e\u024b\u0c32\u011b, \u011b\u00eb\u011b\u0108 \u0102\u0c33\u0245 \u0188\u045e\u0245 \n\u045c\u0457\u0c2a\u0112 2015 \u0c0e\u0c02\u011c\u0c15 \u00eb\u011e\u00f3\u01d8 \u0188\u01b2\u0229\u0c28\u0c2c\u00f0\u0235\u0c2f\u0c28\u023c \u00e4\u0c30\u0c23\u0c02\u00e6  \u02aa\u0117\u0102\u0455\u0460  \n\n \n \n9 \n \n\u01bc\u045e\u0233 \u011a\u0c15\u0229\u0c30\u0c23 \u011c\u0112\u0c37\u0217 \u0457  \u00f5\u0c16\u0460 \u0179\u0c2f\u00f0\u011b\u0108 \u0129\u0c26\u023a\u0c2e\u00fd\u0242\u0c30\u011b, \u0c05\u0c02\u0455\u0c35\u0c32\u0c28, \n\u0c0e\u044e\u0c35\u0c02\u0112 \u011b\u00fd\u0c2e\u00e4\u0460 \u0c1c\u0c30\u0c17\u0c15\u01d0\u0c35\u0c21\u0c02\u01cb \u0102\u045e \u01bc\u045e\u0233 \u011a\u0c15\u0229\u0c30\u0c23 \u011c\u0112\u0c37\u0217 \u0457 \u00f5\u0c16\u0460 \n\u0179\u00fd\u0124\u024a \u0c35\u010d\u022e\u0c02\u0c26\u011b \u016e\u0c32\u0245\u0114\u0c02\u00e9\u045e. \u0c05\u0121\u0c28\u0c2a\u023d\u0112\u0108, \u0c06\u0c2f\u0c28 \u0102\u0c26\u0c28\u0460 \u0126\u011b\u011c\u04ab\u0238, \n\u02aa\u0465\u0238\u0c24 \n\u0c05\u0140\u023d\u0460\u00f5\u045e\u0460 \n\u011b\u0192\u0119\u0c02\u010d\u0c28 \n\u018a\u0c37\u0c30\u0453 \n\u024f\u00fc\u0c2a\u0c23\u0c32\u0457 \n\u0420\u01bc\u045e\u0233 \n\u0c06\u01d4\u0119\u0c02\u0c1a\u0c15\u01d0\u0c35\u00ee\u011b\u0108 \u0c17\u0c32 \u00e4\u0c30\u00f2\u0c32\u0457 \u0c2a\u0122\u014b\u0124\u0c02\u010d \u01bc\u045e\u0233 \u011a\u0c15\u0229\u0c30\u0c23 \u011c\u0112\u0c37\u0217 \u01d8 \n\u0c38\u045c\u010d\u0c24 \u0c09\u0c24\u0238\u045e\u0247\u0460 \u00eb\u0146 \u0179\u0c2f\u0c35\u0c32\u0129\u0c02\u0c26\u011b \u0c05\u0c2d\u0242\u0122\u023b\u0c02\u00e9\u045e. \u0c06\u0c2f\u0c28 \u0c07\u0c02\u00e4 \u0102\u0119\u04ab\u0238 \n\u02aa\u0465\u0238\u0c24 \u02aa\u0117\u0102\u0455\u0c32\u0457 \u0c38\u0c02\u0c38\u0239\u01d8 \u011b\u0c2f\u0120\u0c02\u0179 \u0c05\u0c02\u0103\u011b\u023c \u0c2a\u0122\u014b\u0124\u0c02\u00e9\u0124\u024a\u0c02\u0119\u00e6 \n\u0c05\u0140\u023d\u0460\u00f5\u045e\u0c32\u0457 \u0c06\u0185\u0127\u0c02\u00e9\u0c32\u011b \u01bc\u00fe\u045e.  \n13.   17-12-2021 \u0183\u013d \u013b\u045e\u023d\u0457 \u0c2a\u0122\u014b\u0124\u0c02\u010d\u0c28\u0458\u023d\u0450 \u011b\u00fd\u0c2e\u0c15 \u02aa\u02de\u0c2f\u0457 \n\u049e\u0122\u0238 \u0179\u0c2f\u00f0\u011b\u0108 \u0c05\u0140\u023d\u0460\u00f5\u045e\u0c32\u0457 \u00f3\u00eb \u0c09\u01cd\u0242\u0c17 \u04ab\u0c1a\u0c28 \u02aa\u0c15\u0c1f\u0c28 \u00eb\u0146 \u0179\u0c2f\u0444\u0c02\u00f0 \n\u011b\u01d6\u011a\u0c02\u0179 \u0c09\u0185\u023a\u0c36\u0c02 \u0c2c\u0c2f\u0c1f\u0c2a\u0c21\u0190\u0455. \u011b\u00fd\u0c2e\u0c15 \u02aa\u02de\u0c2f\u0457 \u016a\u0c02\u0450 \u0163\u0c32\u01d8\u0245 \u049e\u0122\u0238 \u0179\u0129 \n\u0c09\u013b\u0238\u045e\u0237\u041a\u0c28 \u0c05\u0c2d\u0242\u045e\u023b\u0c32\u0444 \u011b\u00fd\u0c2e\u0c15 \u0c09\u0c24\u0238\u045e\u0247\u0460 \u00eb\u0146 \u0179\u00fd\u0c32\u011b \u00fc\u02a5\u018c \u013b\u045e\u023d\u01d8 \n\u0c06\u0185\u0127\u0c02\u0c1a\u0c2c\u0114\u0c02\u0119. 2017 \u0c09\u01cd\u0242\u0c17 \u04ab\u0c1a\u0c28 \u02aa\u0c15\u0c1f\u0c28\u0444 \u0c05\u0457\u0446\u0c23\u0c02\u00e6 \u011b\u00fd\u0c2e\u00e4\u0460 \n\u049e\u0122\u0238 \u0179\u00fd\u0100 \u0190\u0c15 \u00f3\u00eb\u00e6 \u0c09\u01cd\u0242\u0c17 \u04ab\u0c1a\u0c28 \u02aa\u0c15\u0c1f\u0c28  \u016e\u0460\u0c35\u0122\u0c02\u00e9\u0100 \u0c05\u0c28\u023c\u0119 \n\u013b\u045e\u023d\u01d8 \u0188\u01b2\u0229\u0c28\u0c2c\u0c21\u0190\u0455, \u0c05\u0c02\u0455\u0c35\u0c32\u0245, \u00fc \u0c26\u0c43\u0128\u0233\u01d8 \u0c08 \u0c05\u0c02\u0103\u011b\u023c \u0c05\u0140\u023d\u0460\u00f5\u045e\u0c32 \n\u0126\u0c1a\u024f\u0c23\u0444 \u0c35\u0119\u0124 \u0192\u0c2f\u0c2c\u0114\u0c02\u0119. 2017 \u0c09\u01cd\u0242\u0c17 \u04ab\u0c1a\u0c28 \u02aa\u0c15\u0c1f\u0c28\u0444 \u0c05\u0457\u0446\u0c23\u0c02\u00e6 \n\u00fc\u02a5\u018c \u011b\u00fd\u0c2e\u00e4\u0460 \u049e\u0122\u0238 \u0179\u00fd\u0c32\u011b \u011b\u0122\u023b\u0c37\u0233\u0416\u0c28 \u0c06\u0185\u0c36\u0c02 \u0190\u0c15\u01d0\u0c35\u0c21\u0c02\u01cb \u00f3\u00eb \n\u0c09\u01cd\u0242\u0c17 \u04ab\u0c1a\u0c28 \u02aa\u0c15\u0c1f\u0c28 \u00eb\u0146 \u0179\u0c2f\u0c21\u0c2e\u0c28\u023c\u0119 \u01bc\u045e\u0233 \u011a\u0c15\u0229\u0c30\u0c23 \u0108\u0c02\u0c26\u0444 \u0c35\u0465\u0238\u0c02\u0c26\u011b \u018c\u045c \n\u011b\u00fe\u023b\u0122\u0c02\u0c1a\u0190\u0444\u00f7\u023c\u045c. \u011b\u00fd\u0c2e\u00e4\u0c32\u0457 \u049e\u0122\u0238 \u0179\u0c2f\u00f0\u011b\u0108 \u0c12\u0c15 \u011b\u018e\u023a\u0127\u0c24 \u0c38\u0c2e\u00fd\u011b\u023c \n\u01bc\u045e\u0233 \u0c38\u023d\u0c37\u0233\u0c02\u00e6 \u011b\u018e\u023b\u0127\u0c02\u010d\u0c02\u0119, \u0c05\u0121\u0183 \u011b\u0c2f\u0c2e\u00e4\u0c32\u0457 \u049e\u0122\u0238 \u0179\u00fd\u0124\u024a\u0c28 \u0126\u00f6\u0c28\u0c02 \n\u00fc\u02a5\u0c02 \u0c05\u0140\u023d\u0460\u00f5\u045e\u0c32 \u0c05\u011a\u00e4\u0c30 \u0c2a\u0122\u011a\u01d8\u011b\u0119. \n\n \n \n10 \n \n \n \n \u02aa\u0117\u0102\u0455\u0460 \u02aa\u0192\u0c36 \u0164\u0112\u0233\u0c28 \u01bc\u045e\u0233 \u011a\u0c15\u0229\u0c30\u0c23 \u0174\u0465 \u0164\u0c02\u0114\u0c02\u0446\u01d8 \u0c09\u0c28\u023c\u0c02\u0455\u0c28 \n\u00f3\u00f3\u0229\u0124\u0c15 \u011b\u00fd\u0c2e\u0c15 \u0c09\u0c24\u0238\u045e\u0247\u0c32\u0457 \u00fc\u02a5\u018c \u00eb\u0146 \u0179\u0c2f\u0c35\u0c1a\u022e\u0c28\u023c \u0126\u00f5\u0242\u0c35\u0c02\u0453\u041a\u0c28 \n\u01b9\u0124\u0129\u0c1f\u021e \u0c1c\u0c28\u0c30\u0220 \u0102\u0c26\u0c28\u0457 \u018c\u045c \u0c2a\u0122\u0c17\u0c23\u0c28\u01d8\u0108 \u013b\u0465\u0444\u00f7\u023c\u045c. \n14.  \u0c05\u0140\u023d\u0460\u00f5\u045e\u0c32 \u0c24\u0c30\u0458\u0c28 \u0126\u00f5\u0242\u0c35\u0c02\u0453\u041a\u0c28 \u01b9\u0124\u0129\u0c1f\u021e \u0c1c\u0c28\u0c30\u0220 \u0102\u0c26\u0c28\u0c32\u0457 \n\u0c2e\u0122\u045d \u02aa\u0117\u0102\u0455\u0c32 \u0c24\u0c30\u0458\u0c28 \u0126\u00f5\u0242\u0c35\u0c02\u0453\u041a\u0c28 \u00f7\u0242\u0c2f\u0102\u0119 \u0102\u0c26\u0c28\u0c32\u0457 \u0126\u0c28\u023c \u0c24\u00fe\u0247\u0c24 \n\u0c2e\u0122\u045d \u0c08 \u013b\u045e\u023d\u01d8 \u0412\u0c28 \u015f\u0124\u011c\u0c28 \u0102\u0c38\u0238\u0102\u0c32 \u0c26\u0c43\u0104\u0233\u0273 \u0c2e\u0122\u045d \u0420\u01bc\u045e\u0233 17-12-\n2021 \u0183\u013d\u0c28 \u016e\u0460\u0c35\u0122\u0c02\u010d\u0c28 \u0c09\u0c24\u0238\u045e\u0247\u0c32 \u0187\u0c2a\u0c25\u0242\u0c02\u01d8, \u0420\u01bc\u045e\u0233 \u0c09\u0c24\u0238\u045e\u0247\u0c32\u0457 \n\u00f8\u0112\u0c02\u0c1a\u0c21\u0c02\u01d8\u201c\u0c09\u0185\u023a\u0c36 \u049e\u0c30\u0247\u0c15\u0416\u0c28 \u0c2e\u0122\u045d \u045a\u0119\u023b \u049e\u0c30\u0247\u0c15\u0416\u0c28\u201d \u0c05\u0126\u0186\u0c2f\u0c24 \u0190\u0c26\u011b \n\u018c\u045c \u0c05\u011f\u02ce\u0c2f \u0c2a\u0450\u0453\u00f7\u023c\u045c. \u0102\u0c38\u0238\u0102\u011b\u0108, \u02aa\u0465\u0238\u0c24 \u0c05\u0140\u023d\u0460\u00f5\u045e\u0460 17-12-\n2021 \u0183\u013d\u00f7\u0112 \u0420\u01bc\u045e\u0233 \u0c09\u0c24\u0238\u045e\u0247\u0c32\u0457 \u0c09\u0c32\u0245\u0c02\u010b\u0c02\u00e9\u0c30\u0c28\u023c \u0c06\u01d6\u0c2a\u0c23\u0412 \u018a\u0c37\u0c30\u0453 \n\u024f\u00fc\u0c2a\u0c23\u0460 \n\u048a\u00f0 \n\u011b\u0192\u0119\u0c02\u00e9\u045e. \n\u0c12\u0c15\u0192\u0c33 \n\u0c09\u0185\u023a\u0c36\u049e\u0c30\u0247\u0c15\u0416\u0c28 \n\u0c2e\u0122\u045d \n\u045a\u0119\u023b\u049e\u0c30\u0247\u0c15\u0416\u0c28 \u0c05\u0126\u0186\u0c2f\u0c24 \u0c09\u0c28\u023c\u044e\u0245\u00e6 \u0420\u01bc\u045e\u0233 \u011b\u00fe\u023b\u0c30\u0c23\u0444 \u0c35\u010d\u022e\u0c28\u0c2a\u023d\u0112\u012c, \n\u0c05\u0140\u023d\u0460\u00f5\u045e\u0460 \u011b\u0192\u0119\u0c02\u010d\u0c28 \u018a\u0c37\u0c30\u0453 \u024f\u00fc\u0c2a\u0c23\u0c32\u0457 \u0c2a\u0122\u0c17\u0c23\u01d8\u0108 \u013b\u0465\u0444\u011b \u0126\u0c37\u00fd\u011b\u023c \n\u045c\u010a\u0c02\u010d \u0c09\u0c02\u0c21\u0c35\u0449\u022e. \u0c05\u0121\u0183, \u0c05\u0140\u023d\u0460\u00f5\u045e\u0460 \u011b\u0192\u0119\u0c02\u010d\u0c28 \u018a\u0c37\u0c30\u0453 \u024f\u00fc\u0c2a\u0c23\u0c32\u0457 \n\u0c2a\u0122\u014b\u0124\u0c02\u0c1a\u00f0\u011b\u0108 \u0c2c\u0455\u0460\u00e6 \u0102\u0122\u0108 \u0105\u00f6\u0c30\u0c23 \u0405\u0460 \u0127\u024f \u0c2e\u0122\u045d \u0c1c\u0122\u00fc\u00f7 \n\u0126\u011a\u0c02\u010d\u0c28\u044e\u0233\u00e6 \u018c\u045c \u0c17\u0c2e\u011b\u0c02\u00e9\u045c. \u0174\u0465\u01d8\u011b  \u0102\u0c38\u0238\u0102\u0460 \u0c2e\u0122\u045d 17-12-\n2021 \u0183\u013d\u0c28 \u0420\u01bc\u045e\u0233 \u0119\u0247\u0c38\u0c2d\u0242 \u0c27\u00fe\u0241\u0c38\u0c28\u0c02 \u016e\u0460\u0c35\u0122\u0c02\u010d\u0c28 \u0c09\u0c24\u0238\u045e\u0247\u0c32 \u0187\u0c2a\u0c25\u0242\u0c02\u01d8 \n\u0126\u011a\u0c02\u010d\u0c28 \u0405\u0460\u0127\u024f, \u0c1c\u0122\u00fc\u00f7 \u0c38\u0418\u0c28\u0c26\u011b \u018c\u045c \u00fb\u0126\u0c02\u0c1a\u0c21\u0c02 \u0190\u0455. \n \n\n \n \n11 \n \n15.    \u0c08 \u013b\u045e\u023d\u01d8\u011b \u0102\u0c38\u0238\u0102\u0460 \u0c2e\u0122\u045d \u0c2a\u0122\u0129\u0239\u0453\u0c32 \u0c26\u0c43\u0104\u0233\u0273, \u02aa\u0465\u0238\u0c24 \u0c05\u0140\u023d\u0460\u00f5\u045e\u0c32 \n\u018a\u0c37\u0c30\u0453 \u024f\u00fc\u0c2a\u0c23\u0c32\u0457  \u0c05\u0c02\u012e\u0c15\u0122\u0c02\u0c1a\u0c21\u0c02 \u0c38\u045c\u010d\u0c24\u0c2e\u011b \u018c\u045c \u00fb\u0126\u0465\u0238\u00f7\u023c\u045c \n\u0c2e\u0122\u045d \u0c24\u0c24\u023d\u0124\u0c24\u0c02\u00e6 \u0102\u0122\u0108 \u0126\u011a\u0c02\u010d\u0c28 \u0127\u024f\u0457 \u0198\u0112\u0233 \u0192\u0c2f\u0c21\u0416\u0c28\u0119. \u0412\u0c28 \u0155\u011c\u023d\u0c28 \n\u011b\u0c2c\u0c02\u0c27\u0c28\u0c32\u0c28\u0457\u0c38\u0122\u0c02\u010d \u0129\u0126\u0220 \u0c05\u0140\u023d\u0461\u0245 \u0c05\u0457\u0c2e\u0117\u04ab\u0238 \u013b\u045e\u023d \u0179\u0c2f\u0c21\u0416\u0c28\u0119. \n \n \u0126\u0126\u0c27 \u011c\u0112\u0c37\u0217 (\u0460) \u0c0f\u0416\u00f7  \u0164\u0c02\u0114\u0c02\u0206 \u01d8 \u0c09\u0c02\u017e, \u0102\u0112\u011b \u045c\u010a\u0c02\u0c1a\u0c21\u0416\u0c28\u0119. \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n_______________ \n \n \n \n \n \n \n \n \n  \u00f7\u0242\u0c2f\u04a2\u0122\u0238. \n \n \n \n \n \n \n \n         (\u011e.\u0126.\u00f7\u0c17\u0c30\u0c24\u023c) \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n_______________ \n \n \n \n \n \n \n \n          \u00f7\u0242\u0c2f\u04a2\u0122\u0238. \n \n \n \n \n \n \n \n   (\u02aa\u0103\u0c02\u0213 \u0444\u00fc\u021e \u0120\u02d9)  \n \n\u049d\u0242\u0115\u0148\u0245: \n\u0491\u041a 04, 2023.     \n \n \n"
