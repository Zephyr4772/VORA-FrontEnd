    "full_text": "\u092a\u094d\u0930\u0924\u093f\u0003\u0935\u0947\u0926\u094d\u092f\n\u0938\u092e\u0915\u094d\u0937 \u092d\u093e\u0930\u0003\u0940\u092f \u0938\u0935\u0010\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\n\u0938\u093f\u0938\u0935\u093f\u0935\u0932 \u0905\u092a\u0940\u0932 \u0928\u094d\u092f\u093e\u092f\u0915\u094d\u0937\u0947\u0924\u094d\u0930\n\u0906\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1234/2019\n(\u092f\u0925\u093e \u090f\u0938.\u090f\u0932.\u092a\u0940. (\u0935\u093f(.) \u0938\u0902. 1480/2019 \u0938\u0947 \u0909\u0926\u094d\u092d\u0942\u0003 )\n\u0935\u093f\u0935\u0928\u094b\u0926 \u0938\u093f\u0902\u0938\u0939 \u0928\u0947\u0917\u0940\n...........\u0905\u092a\u0940\u0932\u093e\u09254 (\u0917\u0923)\n\u092c\u0928\u093e\u092e\n\u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u0935 \u0905\u0928\u094d\u092f\n..............\u092a\u094d\u0930\u0924\u094d\u092f\u09254 (\u0917\u0923)\n\u0915\u0947 \u0938\u093e\u0925\n\u0906\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1235/2019\n(\u092f\u0925\u093e \u090f\u0938.\u090f\u0932.\u092a\u0940. (\u0935\u093f(.) \u0938\u0902. 1481/2019 \u0938\u0947 \u0909\u0926\u094d\u092d\u0942\u0003 )\n\u0935\u093f\u0928\u0923<\u092f\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0003 \u0905\u092d\u092f \u092e\u0928\u094b\u0939\u0930 \u0938\u092a\u094d\u0930\u0947\n1.\n\u0905\u0928\u0941\u092e\u0924\u093f\u0003 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0917\u0908\u0964\n2.\n\u092f\u0947 \u0905\u092a\u0940\u0932 \u092e\u093e.  \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0907\u0932\u093e\u0939\u093e\u092c\u093e\u0926 \u0915\u0947 \u0906\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902.\n4310 \u0938\u0928\u094d 2014 \u0914\u0930 \u0906\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 4213 \u0938\u0928\u094d 2014 \u092e\u0947\u0902 \u092a\u093e\u0930\u093f\u0930\u0003\n\u0905\u0902\u0924\u093f\u0003\u092e \u0935\u093f\u0928\u0923<\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0935\u093f\u0926\u0928\u093e\u0902\u0915  19.09.18 \u0915\u0947 \u0935\u093f\u0935\u0930\u0942\u0926\u094d\u0927 \u0926\u093e\u0916\u093fJ\u0932 \u0915\u0940 \u0917\u0908 \u0939\u0948,\n\u0938\u093fM\u0938\u092e\u0947\u0902 \u092e\u093e.  \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0926\u094b\u0928\u094b\u0902 \u0905\u092a\u0940\u0932\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0935\u091a\u093e\u0930\u0923 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e\n\u090f\u0938.\u091f\u0940.  \u0938\u0902.  465/2006  \u0914\u0930 \u090f\u0938.\u091f\u0940.  \u0938\u0902.  466/2006  \u092e\u0947\u0902 \u0926\u0940 \u0917\u092f\u0940\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj \nfdlh vU; m\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds \nfy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds \nfy;s ekU; gksxk\u00dfA\n\n2\n\u0906M\u0940\u0935\u0928 \u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0915\u0940 \u0938M\u093e \u0915\u094b \u0935\u093f\u0928\u0930\u0938\u094d\u0003 \u0915\u0930\u0003\u0947 \u0939\u0941\u090f \u092a\u094d\u0930\u0924\u094d\u092f\u09254\u0917\u0923\u094b\u0902 (\u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902)  \u0915\u094b\nM\u092e\u093e\u0928\u0003 \u092a\u0930 \u091b\u094b\u0921\u093c \u0935\u093f\u0926\u092f\u093e\u0964\n3.\n\u0907\u0928 \u0905\u092a\u0940\u0932\u094b\u0902 \u092e\u0947\u0902 \u0936\u093e\u0935\u093f\u092e\u0932 \u0932\u0918\u0941 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0947 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0947 \u0916\u093f\u0932\u090f \u0915\u0941\u091b \u0003\u0925\u094d\u092f\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u0947J\n\u0935\u093f\u0915\u092f\u093e M\u093e\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964\n4.\n\u0926\u094b\u0928\u094b\u0902 \u0939\u0940 \u0905\u092a\u0940\u0932\u094b\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0935\u093e\u0926\u0940 \u0939\u0948 M\u092c\u0935\u093f\u0915 \u0909\u092e\u0947\u0936 \u0936\u092e\u093e< \u0905\u093e\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u092a\u0941\u0928\u092f\u093e<\u091a\u0928\u093e\n\u092f\u0925\u093e \u090f\u0938.\u090f\u0932.\u092a\u0940. (\u0935\u093f(.)  \u0938\u0902\u0916\u094d\u092f\u093e 1480  \u0938\u0928\u094d  2019, 1480/2019  \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u09254\n\u0938\u0902.-2,  \u0905\u0936\u094b\u0915 \u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0938\u0902.-2  \u0914\u0930 \u092a\u0930\u0935\u093f\u0902\u0935\u0926\u0930 \u0938\u093f\u0902\u0938\u0939-\u0906\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u092a\u0941\u0928\u092f\u093e<\u091a\u0928\u093e \u092f\u0925\u093e\n\u090f\u0938.\u090f\u0932.\u092a\u0940. (\u0935\u093f(.) \u0938\u0902. 1481/2019 \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0938\u0902.-3 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u0917\u0923 \u0939\u0948\u0902\u0964\n5.\n\u0003\u0940\u0928\u094b\u0902 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902 \u0928\u093e\u092e\u0003\u0903 \u0909\u092e\u0947\u0936 \u0936\u092e\u093e< ,  \u0905\u0936\u094b\u0915 \u0914\u0930 \u092a\u0930\u0935\u093f\u0902\u0935\u0926\u0930 \u0938\u093f\u0902\u0938\u0939 \u0915\u093e\n\u0905\u092d\u093f\u092d\u092f\u094bM\u0928 \u092d\u093e\u0930\u0003\u0940\u092f \u0926\u0923\u094d\u0921 \u0938\u0902\u0935\u093f\u0939\u0003\u093e \u0915\u0940 \u001a\u093e\u0930\u093e 302/34  \u0915\u0947 \u0905\u0928\u094d\u0003\u0917<\u0003  1860\n(\u090f\u0003\u0938\u094d\u092e\u093f\u0938\u094d\u092e\u0928\u092a\u0936\u094d\u091a\u093e\u0003\u094d \u0906\u0908\u092a\u0940\u0938\u0940 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0928\u094d\u0926\u0930\u094d\u092d\u093f\u092d\u0003) \u092e\u0928\u094bM, M\u094b \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u093e\u09254-\u0935\u093e\u0926\u0940\n\u0915\u093e \u092d\u093e\u0908 \u0925\u093e, \u0915\u0940 \u0939\u0924\u094d\u092f\u093e \u0915\u093e\u0930\u093f\u0930\u0003 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0916\u093f\u0932\u090f \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e\u0964\n6.\n\u0905\u092a\u0930 \u0938\u0924\u094d\u0930 \u0928\u094d\u092f\u093e\u092f\u093e\u001a\u0940\u0936/\u0935\u093f\u0935\u0936\u0947\u0937 \u0928\u094d\u092f\u093e\u092f\u093e\u001a\u0940\u0936,  \u0908.  \u0938\u0940.  \u0905\u0924\u093f\u001a\u0935\u093f\u0928\u092f\u092e \u0917\u093e\u0938\u093fM\u092f\u093e\u092c\u093e\u0926\n\u0926\u094d\u0935\u093e\u0930\u093e \u0003\u0940\u0928\u094b\u0902 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902 \u0915\u093e \u0926\u094b\u0937\u0938\u093f\u0938\u0926\u094d\u0927 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0935\u093f\u0928\u0923<\u092f \u0935\u093f\u0926\u0928\u093e\u0902\u0935\u093f\u0915\u0003\n28.10.2014/30.10.2014  \u0915\u094b \u092d\u093e\u0930\u0003\u0940\u092f \u0926\u0923\u094d\u0921 \u0938\u0902\u0935\u093f\u0939\u0003\u093e \u0915\u0940 \u001a\u093e\u0930\u093e 302/34  \u0915\u0947\n\u0905\u0928\u094d\u0003\u0917<\u0003 \u090f\u0938.\u091f\u0940. \u0938\u0902. 465 \u0914\u0930 466/2006 \u092e\u0947\u0902 \u0906M\u0940\u0935\u0928 \u0938\u0936\u094d\u0930\u092e \u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0915\u0947 \u0938\u093e\u0925\n\u0939\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0915\u094b \u20b950,000 \u0915\u0947 M\u0941\u092e\u093e<\u0928\u0947 \u0915\u0947 \u0926\u0923\u094d\u0921  \u0938\u0947 \u0926\u0938\u094d\u092e\u093f\u0923\u094d\u0921\u0003 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e\u0964\n7.\n\u0926\u094b\u0937\u0938\u093f\u0938\u0924\u093f\u0926\u094d\u0927 \u090f\u0935\u0902 \u0938M\u093e \u0915\u0947 \u0906\u0926\u0947\u0936 \u0938\u0947 \u092a\u0940\u0935\u093f\u0921\u093c\u0003  \u0003\u0940\u0928\u094b\u0902 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902 \u0928\u0947 \u092e\u093e.  \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u0905\u092a\u0940\u0932 \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0915\u0940\u0964 \u0905\u092a\u0940\u0932 \u0915\u0947 \u0932\u0902\u092c\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0003\u0940\u0928\u094b\u0902 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902 \u0928\u0947\n\u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0915\u0947 \u0935\u093f\u0928\u0932\u092e\u094d\u092c\u0928 \u0915\u0940 \u092f\u093e\u0924\u093f\u091a\u0915\u093e \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0915\u0940\u0964\n8.\n\u092e\u093e. \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947, \u0003\u0940\u0928\u094b\u0902 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0905M4 \u0915\u094b \u0905\u092a\u0928\u0947 \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003\n\u0906\u0926\u0947\u0936 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f\u0003 \u0926\u0947 \u0926\u0940 \u0914\u0930 \u0003\u0940\u0928\u094b\u0902 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902 \u0915\u094b M\u092e\u093e\u0928\u0003 \u092a\u0930 \u091b\u094b\u0921\u093c\u0947 M\u093e\u0928\u0947 \u0915\u093e\n\u0935\u093f\u0928\u0926o\u0936 \u0926\u0947\u0003\u0947 \u0939\u0941\u090f \u0909\u0928\u0915\u0947 \u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0926\u0923\u094d\u0921 \u0915\u094b (\u092e\u0936\u0903 \u0935\u093f\u0928\u0932\u0938\u094d\u092e\u093f\u092e\u094d\u092c\u0003 \u0915\u0930 \u0935\u093f\u0926\u092f\u093e\u0964\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; \nm\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth\nlaLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n\n3\n9.\n\u092f\u0939 \u0907\u0938 \u0906\u0926\u0947\u0936 \u0915\u0947 \u0935\u093f\u0935\u0930\u0942\u0926\u094d\u0927 \u0939\u0948, \u0935\u093e\u0926\u0940 \u0928\u0947 \u092a\u0940\u0921\u093c\u093e \u092e\u0939\u0938\u0942\u0938 \u0915\u0940 \u0914\u0930 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\n\u092e\u0947\u0902 \u0935\u093f\u0935\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u093f\u0003 \u092f\u093e\u0924\u093f\u091a\u0915\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0926\u094b \u092a\u0941\u0928\u092f\u093e<\u091a\u0928\u093e\u090f\u0901 \u0926\u093e\u0916\u093fJ\u0932 \u0915\u0940 \u0939\u0948\u0964 M\u0939\u093e\u0901 \u0003\u0915\n\u0930\u093e\u091c\u094d\u092f (\u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0938\u0902.1) \u0915\u093e \u0938\u092e\u094d\u092c\u0928\u094d\u001a \u0939\u0948, \u0907\u0938\u0928\u0947 \u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0915\u094b \u092a\u094d\u0930\u0924\u094d\u092f\u0941\u0924\u094d\u0924\u0930 \u0936\u092a\u0925\u092a\u0924\u094d\u0930 \u0915\u0947 \u0938\u093e\u0925\n\u0938\u0902\u0932\u0917\u094d\u0928\u0915\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0915\u0930\u0915\u0947 \u0938\u092e\u0925<\u0928 \u0935\u093f\u0915\u092f\u093e \u0939\u0948\u0964 M\u0939\u093e\u0901 \u0003\u0915 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u0917\u0923\u094b\u0902 (\u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0938\u0902. 2\n\u0935\u093f(\n  .   \u090f  .   \u092f\u0925\u093e \u090f\u0938\u090f\u0932\u092a\u0940 \n \n (  \u0935\u093f(\n  .) 1480/2019\n \n  \u092e\u0947\u0902 \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0938\u0902.-2 \u0914\u0930 3 \u0935\u093f(\n  .   \u090f  . \n\u092f\u0925\u093e \u090f\u0938\u090f\u0932\u092a\u0940 \n \n (  \u0935\u093f(\n  .) 1481/2019 \n \n \u092e\u0947\u0902  )   \u0915\u093e \u0938\u092e\u094d\u092c\u0928\u094d\u001a \u0939\u0948, \u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0938\u0902.-3 \u0935\u093f(. \u090f.\n\u092f\u0925\u093e \u090f\u0938\u090f\u0932\u092a\u0940 (\u0935\u093f(.) \u0938\u0902. 1481/2019 \u0915\u094b \u091b\u094b\u0921\u093c\u0915\u0930 \u0909\u0928\u0915\u094b \u0926\u0940 \u0917\u092f\u0940 \u090f\u0935\u0902 \u0938\u092e\u094d\u092f\u0915\n\u0930\u0942\u092a \u0938\u0947 \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0915\u0940 \u0917\u092f\u0940\u0964 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0906\u0926\u0947\u0936 \u0935\u093f\u0926\u0928\u093e\u0902\u0935\u093f\u0915\u0003 08.05.2019 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0924\u094d\u092f\u09254\n\u0938\u0902.-3 \u092f\u093e\u0928\u0940 \u092a\u0930\u0935\u093f\u0902\u0935\u0926\u0930 \u0938\u093f\u0902\u0938\u0939 \u0915\u094b \u0935\u093f(\n  . \u090f  .   \u092f\u0925\u093e \u090f\u0938\u090f\u0932\u092a\u0940 \n \n (  \u0935\u093f(\n  .)   \u0938\u0902.1481/2019 \u092e\u0947\u0902\n\u0936\u093e\u0935\u093f\u092e\u0932 \u092a\u0915\u094d\u0937\u0915\u093e\u0930\u094b\u0902 \u0915\u0947 \u0938\u092e\u0942\u0939 \u0938\u0947 \u0939\u091f\u093e \u0935\u093f\u0926\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n10.\n\u0907\u0938\u0916\u093f\u0932\u090f, \u092f\u0939 \u0932\u0918\u0941 \u092a\u094d\u0930\u0936\u094d\u0928 \u0907\u0928 \u0905\u092a\u0940\u0932\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u0935\u091a\u093e\u0930\u093e\u0925< \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u094b\u0003\u0947 \u0939\u0948\u0902, \u0935\u093f\u0915 \u0915\u094d\u092f\u093e \u092e\u093e.\n\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902 \u0915\u094b \u092a\u0941\u0928\u092f\u093e<\u091a\u0928\u093e\u0913\u0902 \u0915\u0947 \u0932\u0902\u092c\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u091b\u094b\u0921\u093c\u0947 M\u093e\u0928\u0947\n\u0915\u093e \u0935\u093f\u0928\u0926o\u0936 \u0926\u0947\u0928\u0947 \u092e\u0947\u0902 \u0928\u094d\u092f\u093e\u092f\u0938\u0902\u0917\u0003 \u0925\u093e\u0964\n11.\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947\u0902 \u0926\u094b\u0928\u094b\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u092d\u093f\u0925\u092f\u094b\u0902 \u0915\u0940 \u0003\u0930\u092b \u0938\u0947 \u0935\u0930\u093f\u0930\u0937\u094d\u0920 \u0935\u093f\u0935\u0926\u094d\u0935\u093e\u0928 \u0905\u0924\u093f\u001a\u0935\u0915\u094d\u0924\u093e \u0936\u094d\u0930\u0940 \u0938\u093f\u0938\u0926\u094d\u0927\u093e\u0925<\n\u0926\u0935\u0947 \u090f\u0935\u0902 \u0930\u093e\u091c\u094d\u092f \u0915\u0940 \u0003\u0930\u092b \u0938\u0947 \u0935\u093f\u0935\u0926\u094d\u0935\u093e\u0928 \u0905\u0924\u093f\u001a\u0935\u0915\u094d\u0924\u093e \u0936\u094d\u0930\u0940 \u092d\u093f\u0936\u0930\u0940\u0937 \u0915\u0941\u092e\u093e\u0930 \u0935\u093f\u092e\u0936\u094d\u0930\u093e, \u0935\u093f(. \u090f. \u092f\u0925\u093e\n\u090f\u0938\u090f\u0932\u092a\u0940 (\u0935\u093f(.) \u0938\u0902. 1480/2019 \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u09254 \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0935\u0930\u093f\u0930\u0937\u094d\u0920 \u0935\u093f\u0935\u0926\u094d\u0935\u093e\u0928 \u0905\u0924\u093f\u001a\u0935\u0915\u094d\u0924\u093e\n\u0936\u094d\u0930\u0940 \u0938\u093f\u0938\u0926\u094d\u0927\u093e\u0925< \u0932\u0942\u0925\u0930\u093e \u0935\u093f(.  \u090f.  \u092f\u0925\u093e \u090f\u0938\u090f\u0932\u092a\u0940 (\u0935\u093f(.)  \u0938\u0902. 1481/2019  \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u09254\n\u0938\u0902.-2 \u0915\u0940 \u0003\u0930\u092b \u0938\u0947 \u0935\u0930\u093f\u0930\u0937\u094d\u0920 \u0935\u093f\u0935\u0926\u094d\u0935\u093e\u0928 \u0905\u0924\u093f\u001a\u0935\u0915\u094d\u0924\u093e \u0936\u094d\u0930\u0940 \u0905M\u0940\u0003 \u0915\u0941\u092e\u093e\u0930 \u0938\u093f\u0938\u0928\u094d\u0939\u093e \u0915\u094b \u091a\u0941\u0928\u093e\u0964\n12.\n\u0926\u094b\u0928\u094b\u0902 \u092a\u0915\u094d\u0937\u0915\u093e\u0930\u094b\u0902 \u0915\u0940 \u0003\u0930\u092b \u0938\u0947 \u0909\u092a\u0938\u094d\u092e\u093f\u0938\u094d\u0925\u0003  \u0905\u0924\u093f\u001a\u0935\u0915\u094d\u0924\u093e\u0917\u0923\u094b\u0902 \u0914\u0930 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947\n\u0905\u092d\u093f\u092d\u0932\u0947J\u094b\u0902 \u0915\u093e \u0905\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0909\u092a\u0930\u093e\u0928\u094d\u0003 \u0939\u092e \u0907\u0928 \u092f\u093e\u0924\u093f\u091a\u0915\u093e\u0913\u0902 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f\u0003 \u092a\u094d\u0930\u0926\u093e\u0928\n\u0915\u0930\u0928\u0947 \u0915\u0947 \u0916\u093f\u0932\u090f \u092c\u093e\u0927\u094d\u092f \u0939\u0948\u0902 \u0914\u0930 \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003 \u0906\u0926\u0947\u0936 \u0915\u094b \u0905\u092a\u093e\u0938\u094d\u0003 \u0915\u0930\u0003\u0947 \u0939\u0941\u090f \u092e\u093e\u092e\u0932\u093e \u092e\u093e. \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u0917\u0941\u0923\u094b\u0902-\u0905\u0935\u0917\u0941\u0923\u094b\u0902 \u0915\u094b \u0936\u0941\u0926\u094d\u0927 \u0930\u0942\u092a \u0938\u0947 \u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0915\u0947 \u0935\u093f\u0928\u0932\u0902\u092c\u0928 \u090f\u0935\u0902 M\u092e\u093e\u0928\u0003 \u0926\u0947\u0928\u0947\n\u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u0947 \u0916\u093f\u0932\u090f \u092a\u094d\u0930\u0924\u094d\u092f\u09254 (\u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u0917\u0923) \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u093e\u0916\u093fJ\u0932 \u0907\u0928 \u092a\u094d\u0930\u093e\u0925<\u0928\u093e \u092a\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0935\u093f\u0928\u0923<\u092f\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; \nm\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth\nlaLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n\n4\n\u0915\u0947 \u0916\u093f\u0932\u090f \u092e\u093e.  \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u0003\u092a\u094d\u0930\u0947\u0935\u093f\u0937\u0003 \u0915\u0930\u0003\u0947 \u0939\u0948\u0902,  \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u092a\u094d\u0930\u0924\u093f\u0003\u092a\u094d\u0930\u0947\u0937\u0923 \u0926\u094b\n\u0915\u093e\u0930\u0923\u094b\u0902 \u0938\u0947 \u0935\u093f\u0915\u092f\u093e \u0939\u0948 M\u094b \u0928\u0940\u091a\u0947 \u0926\u0930\u094d\u092d\u093f\u0936\u0003 \u0939\u0948\u0902\u0964\n13.\n\u092a\u094d\u0930\u0925\u092e\u0003\u0903, \u0939\u092e\u0928\u0947 \u092f\u0939 \u092a\u093e\u092f\u093e \u0935\u093f\u0915 \u092e\u093e. \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 M\u092e\u093e\u0928\u0003 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0939\u0947\u0003\u0941 \u0915\u094b\u0908\n\u0003\u0915<  \u0935\u093f\u0928\u001a\u093e<\u0930\u093f\u0930\u0003 \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e\u0964 \u092e\u093e. \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0915\u0947 \u0935\u093f\u0928\u0932\u0902\u092c\u0928 \u0914\u0930 M\u092e\u093e\u0928\u0003\n\u0915\u0940 \u092a\u094d\u0930\u093e\u0925<\u0928\u093e \u0915\u094b \u0915\u0948\u0938\u0947 \u0003\u092f \u0935\u093f\u0915\u092f\u093e M\u093e\u0928\u093e \u091a\u093e\u0935\u093f\u0939\u090f \u0914\u0930 \u0910\u0938\u0947 \u092a\u094d\u0930\u093e\u0925<\u0928\u093e\u092a\u0924\u094d\u0930 \u092a\u0930 \u0935\u093f\u0928\u0923<\u092f \u0932\u0947\u0003\u0947\n\u0938\u092e\u092f \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \u0926\u0943\u0935\u093f{\u0915\u094b\u0923 \u0915\u094d\u092f\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0935\u093f\u0939\u092f\u0947 \u0938\u093fM\u0938 \u092a\u0930 \u0905\u092c \u0915\u0941\u091b \u0905\u0935\u093f\u0928\u09234\u0003 \u0935\u093f\u0935\u0937\u092f\n\u0915\u094b \u091b\u0941\u0906 M\u093e\u0928\u093e \u0936\u0947\u0937 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 M\u0948\u0938\u093e \u0935\u093f\u0915 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u093f\u0928\u092e\u094d\u0928\u0916\u093f\u0932\u0916\u093fJ\u0003 \u092e\u093e\u092e\u0932\u094b\u0902\nM\u0948\u0938\u0947 \u0935\u093f\u0915- (\u0926\u0947J\u0947\u0902 \u0905M\u092f \u0915\u0941\u092e\u093e\u0930 \u0936\u092e\u093e< \u092c\u0928\u093e\u092e \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f,(2005) 7\n\u090f\u0938\u0938\u0940\u0938\u0940 509,  \u0932\u094b\u0915\u0947\u0936 \u0938\u093f\u0902\u0938\u0939 \u092c\u0928\u093e\u092e \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f (2008) 16\n\u090f\u0938\u0938\u0940\u0938\u0940 753, \u0926\u093e\u0003\u093e\u0930\u093e\u092e \u0938\u093f\u0902\u0938\u0939 \u092c\u0928\u093e\u092e \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f, (2018), 3\n\u090f\u0938\u0938\u0940\u0938\u0940 22  \u090f\u0935\u0902 \u0935\u093f\u0928\u0923<\u092f \u0935\u093f\u0926\u0928\u093e\u0902\u0935\u093f\u0915\u0003  29.07.2019  \u092e\u0947\u0902 \u0935\u093f(\u0935\u093f\u092e\u0928\u0932 \u0905\u092a\u0940\u0932 \u0938\u0902.\n1150/2019 \u0907\u0924\u094d\u092f\u093e\u0935\u093f\u0926 \u092e\u094cM\u0940\u0930\u093e\u092e \u092c\u0928\u093e\u092e \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f) \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902\n\u092a\u094d\u0930\u0924\u093f\u0003\u092a\u093e\u0935\u093f\u0926\u0003 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n14.\n\u092e\u0947\u0930\u0940 \u0930\u093e\u092f \u092e\u0947\u0902, \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0924\u093f\u0003\u092a\u093e\u0935\u093f\u0926\u0003 \u0935\u093f\u0915\u092f\u0947 \u0917\u092f\u0947 \u0915\u093e\u0928\u0942\u0928 \u0915\u094b\n\u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0936\u094d\u0928\u0917\u0003 \u0906\u0926\u0947\u0936 \u0915\u094b \u092a\u093e\u0930\u093f\u0930\u0003 \u0915\u0930\u0003\u0947 \u0938\u092e\u092f \u0905\u0928\u0941\u0938\u0930\u0923 \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e\n\u0917\u092f\u093e\u0964 \u0905\u0003\u0903 \u0906\u092a\u0938\u0947 \u0939\u0938\u094d\u0003\u0915\u094d\u0937\u0947\u092a \u0915\u0930\u0928\u0947 \u0915\u0940 \u092e\u093e\u0901\u0917 \u0915\u0930\u0003\u0947 \u0939\u0948\u0902\u0964\n15.\n\u0935\u093f\u0926\u094d\u0935\u0003\u0940\u092f\u0003\u0903 \u0939\u092e \u092a\u093e\u0003\u0947 \u0939\u0948\u0902 \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u093e\u09254 (\u0935\u093e\u0926\u0940) \u0914\u0930 \u0930\u093e\u091c\u094d\u092f \u0928\u0947 \u0907\u0928 \u092a\u0941\u0928\u092f\u093e<\u0924\u093f\u091a\u0915\u093e\u0913\u0902\n\u092e\u0947\u0902 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u0917\u0923\u094b\u0902 \u0915\u0947 \u0935\u093f\u0935\u0930\u0942\u0926\u094d\u0927 \u0909\u0928\u0915\u0947 \u0906\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u0907\u0924\u093f\u0003\u0939\u093e\u0938 \u0915\u094b \u0926\u0936\u093e<\u0003\u0947 \u0939\u0941\u090f\n\u0905\u0924\u093f\u0003\u0930\u093f\u0930\u0915\u094d\u0924 \u0938\u093e\u0915\u094d\u0937\u094d\u092f \u092a\u094d\u0930\u0938\u094d\u0003\u0941\u0003 \u0935\u093f\u0915\u092f\u093e \u0939\u0948 \u0914\u0930 \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924 \u0917\u0923\u094b\u0902 \u0915\u0947 \u0935\u093f\u0935\u0930\u0942\u0926\u094d\u0927 \u0915\u0908 \u0905\u092a\u0930\u093e\u001a\u094b\u0902 \u0915\u0947\n\u0935\u093f\u0915\u092f\u0947 M\u093e\u0928\u0947 \u0915\u0940 \u0906\u092a\u0930\u093e\u0924\u093f\u001a\u0915 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u0940 \u0938\u0942\u091a\u0940  \u0932\u0902\u0935\u093f\u092c\u0003 \u0939\u0948\u0964 \u092f\u0939 \u0938\u0942\u091a\u0940 \u0926\u0936\u093e<\u0003\u0940 \u0939\u0948 \u0935\u093f\u0915 \u0915\u0941\u091b\n\u092e\u093e\u092e\u0932\u0947 M\u092e\u093e\u0928\u0003 \u0935\u093f\u0926\u092f\u0947 M\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u092e\u094d\u092c\u0938\u094d\u092e\u093f\u0928\u094d\u001a\u0003 \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u092d\u093f\u0925\u092f\u094b\u0902 \u0915\u0947 \u0935\u093f\u0935\u0930\u0942\u0926\u094d\u0927 \u0926M< \u0935\u093f\u0915\u090f M\u093e\u0928\u0947\n\u0915\u0947 \u092c\u093e\u0926 \u0926M< \u0935\u093f\u0915\u090f \u0917\u092f\u0947 \u0925\u0947\u0964 \u092e\u093e. \u0909\u091a\u094d\u091a\u094d \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0907\u0928 \u0003\u0925\u094d\u092f\u094b\u0902 \u0915\u094b \u0905\u092a\u0928\u0947 \u0938\u0902\u091c\u094d\u091e\u093e\u0928 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902\n\u0916\u093f\u0932\u092f\u093e\u0964\nmn~?kks\"k.kk\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; \nm\u00eds'; ds fy;s iz;ksx ugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth\nlaLdj.k izkekf.kd ekuk tk;sxk rFkk fu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n\n5\n16.\n\u0909\u0915\u094d\u0924 \u0935\u0930\u094d\u092d\u093f\u0923\u0003 \u0926\u094b\u0928\u094b\u0902 \u0906\u001a\u093e\u0930\u094b\u0902 \u0915\u0947 \u0906\u0932\u094b\u0915 \u092e\u0947\u0902, \u0939\u092e\u093e\u0930\u0940 \u0938\u0941\u0935\u093f\u0935\u091a\u093e\u0930\u093f\u0930\u0003 \u0930\u093e\u092f \u092f\u0939 \u0939\u0948 \u0935\u093f\u0915\n\u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003 \u0906\u0926\u0947\u0936 \u0905\u092a\u093e\u0938\u094d\u0003 \u0935\u093f\u0915\u092f\u0947 M\u093e\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u0939\u0948, \u0914\u0930 \u092e\u093e\u092e\u0932\u093e \u092e\u093e. \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0938\u0915\u094d\u0937\u092e\n\u092c\u0928\u093e\u0003\u0947 \u0939\u0941\u090f \u092a\u094d\u0930\u0924\u093f\u0003\u092a\u094d\u0930\u0947\u0935\u093f\u0937\u0003 \u0935\u093f\u0915\u092f\u093e M\u093e\u0003\u093e \u0939\u0948, \u0909\u092a\u092f\u0941<\u0915\u094d\u0924 \u0935\u0930\u094d\u092d\u093f\u0923\u0003 \u0906\u001a\u093e\u0930\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u092e\u0947\u0902 \u0930J\u0003\u0947 \u0939\u0941\u090f\n\u0909\u0928\u0915\u0947 \u0905\u092a\u0928\u0947 \u0917\u0941\u0923-\u0926\u094b\u0937\u094b\u0902 \u092a\u0930 \u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0926\u0923\u094d\u0921 \u090f\u0935\u0902 M\u092e\u093e\u0928\u0003 \u0935\u093f\u0926\u092f\u0947 M\u093e\u0928\u0947 \u0915\u0947 \u092a\u094d\u0930\u093e\u0925<\u0928\u093e-\u092a\u0924\u094d\u0930\u094b\u0902\n\u092a\u0930 \u092a\u0941\u0928\u0930\u094d\u0935\u093f\u0935\u091a\u093e\u0930 \u0915\u0930\u0947\u0902\u0964 \u0905\u0003\u0903 \u092a\u0941\u0928\u092f\u093e<\u091a\u0928\u093e \u0938\u092b\u0932 \u0939\u0941\u0908 \u0914\u0930 \u0003\u0926\u0928\u0941\u0930\u0942\u092a \u0938\u094d\u0935\u0940\u0915\u0943\u0003 \u0915\u0940 M\u093e\u0003\u0940 \u0939\u0948\u0964\n\u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003 \u0906\u0926\u0947\u0936 \u0905\u092a\u093e\u0938\u094d\u0003 \u0935\u093f\u0915\u092f\u093e M\u093e\u0003\u093e \u0939\u0948\u0964\n17.\n\u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u0915\u094b \u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u092d\u093f\u0925\u092f\u094b\u0902 (\u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u094b\u0902) \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u093e\u092f\u0930 M\u092e\u093e\u0928\u0003/\u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0926\u0923\u094d\u0921\n\u0915\u0947 \u0935\u093f\u0928\u0932\u0902\u092c\u0928 \u0915\u0947 \u0916\u093f\u0932\u090f \u0926\u093e\u092f\u0930 \u0935\u093f\u0915\u090f \u0917\u090f \u0906\u0935\u0947\u0926\u0928\u094b\u0902 \u0915\u094b \u0003\u092f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0916\u093f\u0932\u090f \u092e\u093e.  \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u092a\u094d\u0930\u0924\u093f\u0003\u092a\u094d\u0930\u0947\u0935\u093f\u0937\u0003 \u0935\u093f\u0915\u092f\u093e \u0939\u0948, M\u094b \u0935\u093f\u0915 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0942\u0935< \u092e\u0947\u0902 \u0918\u094b\u0935\u093f\u0937\u0003 \u0935\u093f\u0915\u090f \u0917\u090f\n\u0935\u093f\u0935\u0924\u093f\u001a \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u092e\u0947\u0902 \u0930J\u0003\u0947 \u0939\u0941\u090f \u0905\u092a\u0928\u0947 \u0938\u0902\u092c\u0902\u0924\u093f\u001a\u0003 \u0917\u0941\u0923-\u0926\u094b\u0937\u094b\u0902 \u0915\u0947 \u0906\u001a\u093e\u0930 \u092a\u0930 \u0930\u093e\u091c\u094d\u092f \u0914\u0930\n\u092d\u093f\u0936\u0915\u093e\u092f\u0003\u0915\u0003\u093e< \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u0928\u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u0915\u0947 \u0938\u092e\u0925<\u0928 \u092e\u0947\u0902 \u0926\u093e\u092f\u0930 \u0915\u0940 \u0917\u0908 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947 \u0938\u093e\u0925 M\u0941\u0921\u093c\u093e\n\u0939\u0948\u0964 \u0938\u092d\u0940 \u092a\u0915\u094d\u0937\u094b\u0902 \u0915\u094b \u0938\u0941\u0928\u0928\u0947 \u0915\u0947 \u0909\u092a\u0930\u093e\u0928\u094d\u0003 \u092e\u093e. \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0935\u093f\u0935\u0924\u093f\u001a\u0938\u092e\u094d\u092e\u0003 \u0926\u093e\u0916\u093fJ\u0932 \u092a\u094d\u0930\u093e\u0925<\u0928\u093e\n\u092a\u0924\u094d\u0930\u094b\u0902 \u092a\u0930 \u0909\u0924\u093f\u091a\u0003 \u0906\u0926\u0947\u0936 \u092a\u093e\u0930\u093f\u0930\u0003 \u0915\u0930\u0947\u0917\u093e\u0964\n18.\n\u091a\u0942\u0901\u0935\u093f\u0915 \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0003 \u0906\u0926\u0947\u0936 \u0905\u092a\u093e\u0938\u094d\u0003 \u0935\u093f\u0915\u092f\u093e M\u093e\u0003\u093e \u0939\u0948 \u0907\u0938\u0916\u093f\u0932\u090f \u0905\u092d\u093f\u092d\u092f\u0941\u0915\u094d\u0924\u0917\u0923\u094b\u0902 \u0915\u094b\n\u0905\u092d\u093f\u092d\u0930\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u0916\u093f\u0932\u090f M\u093e\u0928\u0947 \u0915\u0947 \u0916\u093f\u0932\u090f \u0938\u092e\u092a<\u0923 \u0915\u0930\u0928\u0947 \u0915\u093e \u0935\u093f\u0928\u0926o\u0936 \u0935\u093f\u0926\u092f\u093e M\u093e\u0003\u093e \u0939\u0948\u0964 \u0909\u0928\u0915\u0947\nM\u092e\u093e\u0928\u0003\u0928\u093e\u092e\u093e \u0935\u093f\u0928\u0930\u0938\u094d\u0003 \u0935\u093f\u0915\u092f\u0947 M\u093e\u0003\u0947 \u0939\u0948\u0902\u0964\n--------------\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0003, \u0905\u092d\u092f \u092e\u0928\u094b\u0939\u0930 \u0938\u092a\u094d\u0930\u0947\n--------------\n\u0928\u094d\u092f\u093e\u092f\u092e