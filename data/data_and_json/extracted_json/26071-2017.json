a30\u0a3e\u0a5b\u0a2f\u0a4b\u0a17 \u0a06\u0a26\u0a47\u00a9 \u0a30\u0a3e\u0a39\u0080 \u0a39\u0a47\u0a20\u0a32\u0a40 \u0a05\u0a26\u0a3e\u0a32\u0a24 \u0a26\u0a47 \u0a2b\u0a48\u0a38\u0a32\u0a47 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30 \u0a3f\u0a26\u0a71\u0a24\u0a3e \u0a05\u0a24\u0a47 \n\u0a3f\u0a28\u0a30\u0a26\u0a47\u00a9 \u0a3f\u0a26\u0a71\u0a24\u0a3e \u0a3f\u0a15 \u0a26\u0a4b\u0a35\u007f \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a3f\u0a2e\u0a06\u0a02 \u0a26\u0a47 \u0a3f\u0a35\u0a35\u0a3e\u0a26\u007f \u0a28\u0a42\u0a70 1996 \u0a10\u0a15\u0a1f \u0a26\u0a40 \u0a27\u0a3e\u0a30\u0a3e 8 \n\u0a24\u0a3f\u0a39\u0a24 \u0a38\u0a3e\u0a32\u0a38\u0a40 \u0a32\u0a08 \u0a2d\u0a47\u0a3f\u0a1c\u0a06 \u0a1c\u0a3e\u0a35\u0a47\u0964 \u0a07\u0a39 \u0a3f\u0a35\u0a35\u0a3e\u0a26 \u0a07\u0a38 \u0a05\u0a26\u0a3e\u0a32\u0a24 \u0a24\u0a71\u0a15 \u0a1c\u0a3e \u0a1a\u0a41\u0a71\u0a15\u0a3e \u0a39\u0a48\u0964 \n8  \n\u0a05\u0a38\u0080 \u0a05\u0a2a\u0a40\u0a32\u0a15\u0a30\u0a24\u0a3e \u0a26\u0a47 \u0a35\u0a15\u0a40\u0a32 \u0a36\u0087\u0a40 \u0a30\u0a3e\u0a1c\u0a40\u0a35 \u0a24\u0a32\u0a35\u0a3e\u0a5c, \u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a05\u0a24\u0a47 \u0a26\u0a42\u0a1c\u0a47 \u0a2a\u0087\u0a24\u0a40\u0a35\u0a3e\u0a26\u0a40\u0a06\u0a02 \n\u0a26\u0a47 \u0a35\u0a15\u0a40\u0a32 \u0a36\u0087\u0a40 \u0a3f\u0a35\u00a9\u0a3e\u0a32 \u0a2e\u0a39\u0a3e\u0a1c\u0a28 \u0a05\u0a24\u0a47 \u0a24\u0a40\u0a1c\u0a47 \u0a24\u0083 \u0a2a\u0a70\u0a1c\u0a35\u0081 \u0a2a\u0087\u0a24\u0a40\u0a35\u0a3e\u0a26\u0a40\u0a06\u0a02 \u0a26\u0a47 \u0a35\u0a15\u0a40\u0a32 \u0a36\u0087\u0a40 \n\u0a17\u0a41\u0a70\u0a1c\u0a28 \u0a15\u0a41\u0a2e\u0a3e\u0a30 \u0a28\u0a42\u0a70 \u0a38\u0a41\u0a3f\u0a23\u0a06 \u0a39\u0a48\u0964 \n9  \n\u0a24\u0a71\u0a25\u007f \u0a26\u0a3e \u0a35\u0a30\u0a23\u0a28 \u0a26\u0a30\u0a38\u0a3e\u008b\u0a26\u0a3e \u0a39\u0a48 \u0a3f\u0a15 14 \u0a38\u0a24\u0a70\u0a2c\u0a30 2010 \u0a26\u0a3e \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a3e  (MoU) \n\u0a05\u0a2a\u0a40\u0a32\u0a15\u0a30\u0a24\u0a3e \u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a39\u0a32\u0a47  \n\u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a3f\u0a35\u0a1a\u0a15\u0a3e\u0a30 \u0a39\u0a48\u0964\u0a05\u0a2a\u0a40\u0a32\u0a15\u0a30\u0a24\u0a3e \u0a28\u0102  \u0a26\u0a4b \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \n\u0a26\u0a3e\u0a07\u0a30 \u0a15\u0a40\u0a24\u0a47\u0964\u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a3f\u0a35\u0a71\u0a1a, \u0a2a\u0a3f\u0a39\u0a32\u0a47  \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a28\u0a42\u0a70 \u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a2c\u0a1a\u0a3e\u0a13 \u0a2a\u0a71\u0a16 \n\u0a35\u0a1c\u0083 \u00a9\u0a3e\u0a2e\u0a32 \u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a39\u0a48 \u0a1c\u0a26\u0083 \u0a3f\u0a15 \u0a38\u0a1a\u0a26\u0a47\u0a35\u0a3e \u0a10\u0a02\u0a21 \u0a38\u0a70\u0a28\u0a5b \u0a07\u0a70\u0a21\u0a38\u0a1f\u0a30\u0a40\u0a5b \u0a2a\u0087\u0a3e\u0a08\u0a35\u0a47\u0a1f \n\u0a3f\u0a32\u0a2e\u0a3f\u0a1f\u0a21 \u0a28\u0a42\u0a70 \u0a26\u0a42\u0a1c\u0a47 \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a35\u0a1c\u0083 \u00a9\u0a3e\u0a2e\u0a32 \u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a39\u0a48\u0964\u0a07\u0a39 \u0a38\u0a71\u0a1a \u0a39\u0a48 \u0a3f\u0a15 \u0a38\u0a1a\u0a26\u0a47\u0a35\u0a3e \n\u0a10\u0a02\u0a21 \u0a38\u0a70\u0a28\u0a5b \u0a07\u0a70\u0a21\u0a38\u0a1f\u0a30\u0a40\u0a5b \u0a2a\u0087\u0a3e\u0a08\u0a35\u0a47\u0a1f \u0a3f\u0a32\u0a2e\u0a3f\u0a1f\u0a21 \u0a07\u0a38 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a47 (MoU)\u0a26\u0a40 \u0a3f\u0a27\u0a30 \u0a28\u0a39\u0080 \n\u0a39\u0a48 \u0a1c\u0a4b \u0a3f\u0a38\u0a30\u0a5e \u0a05\u0a2a\u0a40\u0a32\u0a15\u0a30\u0a24\u0a3e \u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a3f\u0a35\u0a1a\u0a15\u0a3e\u0a30 \u0a32\u0a3e\u0a17\u0a42 \u0a15\u0a40\u0a24\u0a3e \u0a1c\u007f\u0a26\u0a3e \n\u0a39\u0a48\u0964\u0a26\u0a42\u0a1c\u0a47 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a3f\u0a35\u0a71\u0a1a, \u0a26\u0a4b \u0a2c\u0a1a\u0a3e\u0a13 \u0a2a\u0a71\u0a16\u007f \u0a24\u0083 \u0a07\u0a32\u0a3e\u0a35\u0a3e, \u0a1c\u0a4b \u0a3f\u0a15 \u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a3f\u0a35\u0a71\u0a1a \n\u0a3f\u0a27\u0a30 \u0a39\u0a28, \u0a15\u0a47\u0a28\u0a30\u0a3e \u0a2c\u0082\u0a15 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a30\u0a3e\u0a39\u0a24 \u0a26\u0a40 \u0a2e\u0a70\u0a17 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48\u0964\u0a1c\u0a26\u0083 \u0a3f\u0a15 \u0a2a\u0a3f\u0a39\u0a32\u0a47 \n\u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a3f\u0a35\u0a71\u0a1a \u0a1c\u0a4b \u0a30\u0a3e\u0a39\u0a24 \u0a2e\u0a70\u0a17\u0a40 \u0a17\u0a08 \u0a39\u0a48, \u0a09\u0a39 \u0a15\u0a41\u0a1d \u0a5b\u0a2e\u0a40\u0a28 \u0a26\u0a40 \u0a2c\u0a47\u0a17\u0a3e\u0a28\u0a17\u0a40 \u0a24\u0083 \u0a07\u0a71\u0a15 \n\u0a38\u0a30\u0a32 \u0a39\u0a41\u0a15\u0a2e \u0a26\u0a47 \u0a30\u0a42\u0a2a \u0a3f\u0a35\u0a71\u0a1a \u0a39\u0a48, \u0a26\u0a42\u0a1c\u0a47 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a3f\u0a35\u0a71\u0a1a \u0a1c\u0a4b \u0a30\u0a3e\u0a39\u0a24 \u0a2e\u0a70\u0a17\u0a40 \u0a17\u0a08 \u0a39\u0a48, \u0a09\u0a39 \n\n6 \n \n\u0a38\u0a25\u0a3e\u0a08 \u0a39\u0a41\u0a15\u0a2e \u0a32\u0a08 \u0a39\u0a48 \u0a3f\u0a1c\u0a38 \u0a3f\u0a35\u0a71\u0a1a  \u0a15\u0a47\u0a28\u0a30\u0a3e \u0a2c\u0082\u0a15 \u0a28\u0a42\u0a70 \u0a5b\u0a2e\u0a40\u0a28\u0a40  \u0a38\u0a70\u0a2a\u0a24\u0a40 \u0a26\u0a47 \u0a38\u0a2c\u0a70\u0a27 \u0a3f\u0a35\u0a71\u0a1a \n\u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a05\u0a24\u0a47 \u0a26\u0a42\u0a1c\u0a47 \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a26\u0a47 \u0a28\u0a3e\u0a2e '\u0a24\u0a47 \u0a15\u0a4b\u0a08 \u0a15\u0a30\u0a5b\u0a3e \u0a1c\u007f \u0a3f\u0a35\u0a71\u0a24 \u0a35\u0a70\u0a21\u0a23 \n\u0a1c\u007f \u0a1c\u0a3e\u0a30\u0a40 \u0a15\u0a30\u0a28 \u0a24\u0083 \u0a30\u0a4b\u0a3f\u0a15\u0a06 \u0a3f\u0a17\u0a06 \u0a39\u0a48\u0a15\u0a47\u0a28\u0a30\u0a3e \u0a2c\u0082\u0a15 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a15\u0a41\u0a71\u0a1d \u0a28\u0a24\u0a40\u0a1c\u0a47 \u0a35\u0a1c\u0083 \u0a30\u0a3e\u0a39\u0a24 \n\u0a26\u0a40 \u0a2e\u0a70\u0a17 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a39\u0a48\u0964\u0a07\u0a38 \u0a32\u0a08, \u0a07\u0a39 \u0a38\u0a2a\u0a71\u00a9\u0a1f \u0a39\u0a48 \u0a3f\u0a15 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a26\u0a40\u0a06\u0a02 \u0a15\u0a08 \u0a3f\u0a27\u0a30\u007f \n\u0a39\u0a28 \u0a1c\u0a4b \u0a38\u0a3e\u0a32\u0a38\u0a40 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a47 \u0a26\u0a40\u0a06\u0a02 \u0a3f\u0a27\u0a30\u007f \u0a28\u0a39\u0080 \u0a39\u0a28\u0a26\u0a4b\u0a35\u007f \u0a3f\u0a27\u0a30\u007f \u0a26\u0a30\u0a3f\u0a2e\u0a06\u0a28 \u0a39\u0a4b\u0a0f \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a47 \n(MoU)\u0a24\u0083 \u0a07\u0a39 \u0a38\u0a70\u0a15\u0a47\u0a24 \u0a3f\u0a2e\u0a32\u0a26\u0a3e \u0a39\u0a48 \u0a3f\u0a15 \u0a38\u0a1a\u0a26\u0a47\u0a35\u0a3e \u0a2a\u0a3f\u0a30\u0a35\u0a3e\u0a30 \u0a3f\u0a1c\u0a38 \u0a3f\u0a35\u0a71\u0a1a \u0a05\u0a2a\u0a40\u0a32\u0a15\u0a30\u0a24\u0a3e \n\u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a39\u0a32\u0a3e \u008e\u0a24\u0a30\u0a26\u0a3e\u0a24\u0a3e \u00a9\u0a3e\u0a2e\u0a32 \u0a39\u0a48, \u0a38\u0a1a\u0a26\u0a47\u0a35\u0a3e \u0a2a\u0a3f\u0a30\u0a35\u0a3e\u0a30 \u0a26\u0a40 \u0a38\u007f\u0a1d\u0a40 \u0a2e\u0a3e\u0a32\u0a15\u0a40 \u0a39\u0a47\u0a20 \n\u0a15\u0a08 \u0a15\u0a70\u0a2a\u0a28\u0a40\u0a06\u0a02, \u0a2d\u0a3e\u0a08\u0a35\u0a3e\u0a32\u0a40 \u0a2b\u0a30\u0a2e\u007f \u0a05\u0a24\u0a47 \u0a2e\u0a32\u0a15\u0a40\u0a05\u0a24 \u0a3f\u0a35\u0a71\u0a1a \u0a15\u0a3e\u0a30\u0a4b\u0a2c\u0a3e\u0a30 \u0a15\u0a30 \u0a30\u0a39\u0a47 \n\u0a38\u0a28\u0964\u0a10\u0a2e\u0a13\u0a2f\u0a42 \u0a3f\u0a35\u0a71\u0a1a \u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a2a\u0a3f\u0a30\u0a35\u0a3e\u0a30\u0a15 \u0a07\u0a15\u0a3e\u0a08\u0a06\u0a02 \u0a05\u0a24\u0a47 \u0a09\u0a28\u0089 \u007f \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2c\u0a70\u0a27\u0a24 \n\u0a3f\u0a35\u0a05\u0a15\u0a24\u0a40\u0a06\u0a02 \u0a26\u0a3e \u0a35\u0a47\u0a30\u0a35\u0a3e \u00a9\u0a3e\u0a2e\u0a32 \u0a39\u0a48\u0964\u0a07\u0a39 \u0a10\u0a2e\u0a13\u0a2f\u0a42\u0a38\u0a70\u0a15\u0a47\u0a24 \u0a15\u0a30\u0a26\u0a3e \u0a39\u0a48 \u0a3f\u0a15 \u0a15\u0a41\u0a71\u0a1d \u0a5a\u0a48\u0a30-\n\u0a2a\u0a3f\u0a30\u0a35\u0a3e\u0a30\u0a15 \u0a3f\u0a39\u0a71\u0a38\u0a47\u0a26\u0a3e\u0a30\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964 \n10    \n\u0a07\u0a38 \u0a3f\u0a2a\u0a1b\u0a4b\u0a15\u0a5c \u0a3f\u0a35\u0a71\u0a1a \u0a05\u0a24\u0a47 \u0a3f\u0a15\u008b\u0a3f\u0a15 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a3e (MoU)\u0a3f\u0a35\u00a9\u0a47\u00a9 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a05\u0a2a\u0a40\u0a32\u0a15\u0a30\u0a24\u0a3e \n\u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a39\u0a32\u0a47 \u008e\u0a24\u0a30\u0a26\u0a3e\u0a24\u0a3e \u0a26\u0a47 \u0a3f\u0a35\u0a1a\u0a15\u0a3e\u0a30 \u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a38\u0a40, \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a26\u0a47 \u0a1c\u0a71\u0a1c \u0a26\u0a40 \u0a27\u0a3e\u0a30\u0a3e \n8 \u0a26\u0a47 \u0a05\u0a27\u0a40\u0a28 \u0a38\u0a3e\u0a32\u0a38\u0a40 \u0a26\u0a3e \u0a39\u0a35\u0a3e\u0a32\u0a3e \u0a38\u0a2a\u0a71\u00a9\u0a1f \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a17\u0a32\u0a24\u0a40 \u0a38\u0a40\u0964\u0a28\u0a3e \u0a24\u007f \u0a15\u0a47\u0a28\u0a30\u0a3e \u0a2c\u0082\u0a15 \n\u0a05\u0a24\u0a47 \u0a28\u0a3e \u0a39\u0a40 \u0a15\u0a70\u0a2a\u0a28\u0a40 \u0a38\u0a3e\u0a32\u0a38\u0a40 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a3e \u0a26\u0a40\u0a06\u0a02 \u0a3f\u0a27\u0a30\u007f \u0a39\u0a28\u0964\u0a07\u0a38 \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a47 (MoU) \u0a28\u0a42\u0a70 \n\u0a05\u0a2a\u0a40\u0a32\u0a15\u0a30\u0a24\u0a3e \u0a05\u0a24\u0a47 \u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a26\u0a30\u0a3f\u0a2e\u0a06\u0a28 \u0a32\u0a3e\u0a17\u0a42 \u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a39\u0a48\u0964\u0a5a\u0a48\u0a30-\n\u0a2a\u0a3f\u0a30\u0a35\u0a3e\u0a30\u0a15 \u0a3f\u0a39\u0a71\u0a38\u0a47\u0a26\u0a3e\u0a30\u0a40\u0a06\u0a02, \u0a3f\u0a15\u0a38\u0a47 \u0a35\u0a40 \u0a2e\u0a3e\u0a2e\u0a3f\u0a32\u0a06\u0a02 \u0a3f\u0a35\u0a71\u0a1a, \u0a38\u0a2e\u0a1d\u0a4c\u0a24\u0a47 \u0a26\u0a40\u0a06\u0a02 \u00a9\u0a30\u0a24\u007f \u0a28\u0a3e\u0a32 \n\u0a2c\u0a70\u0a28\u0089 \u0a40\u0a06\u0a02 \u0a28\u0a39\u0080 \u0a1c\u0a3e \u0a38\u0a15\u0a26\u0a40\u0a06\u0a02 \u0a3f\u0a15\u008b\u0a3f\u0a15 \u0a09\u0a39 \u0a26\u0a38\u0a24\u0a3e\u0a35\u0a47\u0a5b \u0a26\u0a40\u0a06\u0a02 \u0a3f\u0a27\u0a30\u007f \u0a28\u0a39\u0080 \u0a39\u0a28\u0964 \n11  \n\u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a15\u0a3e\u0a30\u0a28\u007f \u0a15\u0a30\u0a15\u0a47, \u0a05\u0a38\u0080 1 \u0a05\u0a17\u0a38\u0a24 2017 \u0a28\u0a42\u0a70 \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a26\u0a47 \u0a3f\u0a38\u0a70\u0a17\u0a32 \u0a1c\u0a71\u0a1c \n\u0a26\u0a47 \u0a3f\u0a35\u0a35\u0a3e\u0a26\u0a2a\u0a42\u0a30\u0a28 \u0a2b\u0a48\u0a38\u0a32\u0a47 \u0a05\u0a24\u0a47 \u0a06\u0a26\u0a47\u00a9 \u0a28\u0a42\u0a70 \u0a16\u0a3e\u0a30\u0a5b \u0a15\u0a30\u0a26\u0a47 \u0a39\u007f\u0964 \u0a28\u0a24\u0a40\u0a1c\u0a47 \u0a35\u0a1c\u0083, 1996 \u0a26\u0a47 \n\u0a10\u0a15\u0a1f \u0a26\u0a40 \u0a27\u0a3e\u0a30\u0a3e 8 \u0a24\u0a3f\u0a39\u0a24 \u0a2a\u0a3f\u0a39\u0a32\u0a47 \u0a1c\u0a35\u0a3e\u0a2c\u0a26\u0a47\u0a39 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a26\u0a3e\u0a07\u0a30 \u0a15\u0a40\u0a24\u0a40\u0a06\u0a02 \u0a17\u0a08\u0a06\u0a02 \n\u0a05\u0a30\u0a5b\u0a40\u0a06\u0a02 \u0a16\u0a3e\u0a30\u0a1c \u0a15\u0a30 \u0a3f\u0a26\u0a71\u0a24\u0a40\u0a06\u0a02 \u0a1c\u0a3e\u0a23\u0a17\u0a40\u0a06\u0a02\u0964\u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a28\u0102  1996 \u0a26\u0a47 \u0a10\u0a15\u0a1f \u0a26\u0a40 \n\n7 \n \n\u0a27\u0a3e\u0a30\u0a3e 8 \u0a24\u0a3f\u0a39\u0a24 \u0a05\u0a30\u0a5b\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a2e\u0a28\u0a5b\u0a42\u0a30 \u0a15\u0a30\u0a3f\u0a26\u0a06\u0a02 \u0a3f\u0a38\u0a35\u0a32 \u0a1c\u0a71\u0a1c (\u0a1c\u0a42\u0a28\u0a40\u0a05\u0a30 \u0a21\u0a35\u0a40\u0a5b\u0a28) \n\u0a28\u0a42\u0a70 \u0a2a\u0a3f\u0a30\u0a23\u0a3e\u0a2e\u0a40 \u0a39\u0a41\u0a15\u0a2e \u0a2a\u0a3e\u0a38 \u0a15\u0a30\u0a28 \u0a26\u0a3e \u0a3f\u0a28\u0a30\u0a26\u0a47\u00a9 \u0a3f\u0a26\u0a71\u0a24\u0a3e \u0a38\u0a40\u0964\u0a2e\u0a4c\u0a1c\u0