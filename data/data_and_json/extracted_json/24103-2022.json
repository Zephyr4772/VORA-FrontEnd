    "full_text": "\u092a\u0924\u094d\u0930\u093f\u0915\u093e\u0913\u0902 \u092e\u0947\u0902 \u091b\u092a\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \n\u092d\u093e\u0930\u0924 \u0915\u0947 \u0938\u0930\u094d\u0935\u094b\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \n\u0906\u092a\u0930\u093e\u0924\u094d\u0930\u093f\u0915 \u0905\u092a\u0940\u0932\u0940\u092f \u0915\u094d\u0937\u0947\u093f\u093e\u0924\u094d\u0930\u093f\u0915\u093e\u0930 \n\u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902\u0916\u094d\u092f\u093e 205/2023 \n[@ \u090f\u0938\u090f\u0932\u092a\u0940 [\u0938\u0940\u0906\u0930\u090f\u0932] \u0938\u0902.8501/2022] \n\u0924\u0932\u0924 \u0938\u093e\u0928\u0935\u0940   \n \n \n \n \n \n \n \n \n...\u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940 \n\u092c\u0928\u093e\u092e \n\u091d\u093e\u0930\u0916\u0902\u0921 \u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f \n \n \n \n \n \n \n     ....\u092a\u094d\u0930\u0927\u0924\u0935\u093e\u0926\u0940\u0917\u0923 \n\u0924\u094d\u0930\u0928\u0930\u094d\u0923\u092f \n\u0938\u0902\u091c\u092f \u0924\u094d\u0930\u0915\u0936\u0928 \u0915\u094c\u0932, \u0928\u094d\u092f\u093e\u092f\u093e. \n \n\u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0925\u0928\u093e \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \n1. \u0907\u0938 \u0905\u092a\u0940\u0932 \u092e\u0947\u0902 \u0909\u0920\u093e\u092f\u093e \u0917\u092f\u093e \u092e\u0941\u0926\u094d\u0926\u093e \u092f\u0939 \u0939\u0948 \u0927\u0915 \u0915\u094d\u092f\u093e \u2018\u092a\u0940\u0927\u093c\u093f\u0924 \u0915\u094b \u0927\u0926\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u0902\u0924\u0930\u0930\u092e \u092e\u0941\u0906\u0935\u091c\u0947\u2019 \n\u0915\u094b \u0905\u0927\u093f\u092e \u091c\u092e\u093e\u0928\u0924 \u0915\u0940 \u0915\u093e\u092f\u0925\u0935\u093e\u0939\u0940 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u090f\u0915 \u0936\u0924\u0925 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0932\u0917\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \n2. \u0939\u092e\u093e\u0930\u093e \u0927\u0928\u0927\u093f\u0924 \u092e\u0924 \u0939\u0948 \u0927\u0915 \u0906\u0915\u094d\u0937\u0947\u0927\u092a\u0924 \u0906\u0926\u0947\u0936 \u092a\u093e\u0930\u0930\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u093e\u0928\u0942\u0928 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0927\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \n\u0915\u094d\u092f\u094b\u0902\u0927\u0915 \u092a\u0940\u0927\u093c\u093f\u0924 \u0915\u094b \u0927\u0926\u092f\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u0905\u0902\u0924\u0930\u0930\u092e \u092e\u0941\u0906\u0935\u091c\u093e \u091c\u092e\u093e\u0928\u0924 \u0928\u094d\u092f\u093e\u092f\u0936\u093e\u0938\u094d\u0924\u094d\u0930 \u0915\u093e \u092d\u093e\u0917 \u0928\u0939\u0940\u0902 \u0939\u094b \n\u0938\u0915\u0924\u093e\u0964 \n3. \u092f\u0939 \u092e\u0941\u0926\u094d\u0926\u093e \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0938\u093e\u0939\u092c \u0906\u0932\u092e @ \u0917\u0941\u0921\u094d\u0921\u0942 \u092c\u0928\u093e\u092e \u091d\u093e\u0930\u0916\u0902\u0921 \u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f -\u0906\u092a\u0930\u093e\u0927\u093f\u0915 \n\u0905\u092a\u0940\u0932 \u0938\u0902\u0916\u094d\u092f\u093e 1318/2022, \u0927\u0926\u0928\u093e\u0902\u0915 24.08.2022 \u0924\u0930\u094d\u0925\u093e \u0909\u093f\u094b \u0920\u093e\u0915\u0941\u0930 \u090f\u0935\u0902 \u0905\u0928\u094d\u092f \u092c\u0928\u093e\u092e \u091d\u093e\u0930\u0916\u0902\u0921 \n\u0930\u093e\u091c\u094d\u092f \u090f\u0935\u0902 \u0905\u0928\u094d\u092f -\u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902\u0916\u094d\u092f\u093e 1703-1704/2022 \u0927\u0926\u0928\u093e\u0902\u0915 29.09.2022 \u0915\u0947 \u092e\u093e\u092e\u0932\u094b\u0902 \n\u092e\u0947\u0902 \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u092b\u0948\u0938\u0932\u094b\u0902 \u0938\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0939\u0948\u0964 \n\n4. \u0938\u093e\u0939\u092c \u0906\u0932\u092e \u092e\u093e\u092e\u0932\u0947 (\u090a\u092a\u0930) \u092e\u0947\u0902 \u0927\u0935\u091a\u093e\u0930 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0939\u092e\u0928\u0947 \u0915\u0908 \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902 \u0927\u0935\u0926\u094d\u0935\u093e\u0928 \u0928\u094d\u092f\u093e\u092f\u093e\u093f\u0940\u0936\u094b\u0902 \n\u0926\u094d\u0935\u093e\u0930\u093e \u092a\u093e\u0930\u0930\u0924 \u0906\u0926\u0947\u0936\u094b\u0902 \u092a\u0930 \u0927\u0935\u091a\u093e\u0930 \u0927\u0915\u092f\u093e \u0930\u094d\u0925\u093e, \u0927\u091c\u0938\u092e\u0947\u0902 \u0905\u092a\u0930\u093e\u093f\u094b\u0902 \u0915\u0940 \u092a\u094d\u0930\u0915\u0943\u0927\u0924 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u091c\u092e\u093e\u0928\u0924 \u0915\u0940 \n\u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u092a\u0930 \u0927\u0935\u091a\u093e\u0930 \u0927\u0915\u090f \u0927\u092c\u0928\u093e \u0939\u0940 \u0915\u0947\u0935\u0932 \u092a\u092f\u093e\u0925\u092a\u094d\u0924 \u093f\u0928\u0930\u093e\u0927\u0936 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0940 \u0936\u0924\u0925 \u092a\u0930 \u091c\u092e\u093e\u0928\u0924 \u0926\u0947 \n\u0926\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940 \u0914\u0930 \u0924\u092c, \u092f\u0939 \u0927\u0928\u0923\u0925\u092f \u0927\u0926\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e \u0927\u0915 \u0915\u0947\u0935\u0932 \u0907\u0938 \u0915\u093e\u0930\u0923 \u0927\u0915\u0938\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u091c\u092e\u093e\u0928\u0924 \n\u0928\u0939\u0940\u0902 \u0926\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0927\u0915 \u0935\u0939 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092a\u0948\u0938\u0947 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u0948 \u092f\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0930\u0916\u0924\u093e \n\u0939\u0948\u0964 \n5. \u0910\u0938\u0947 \u0938\u092d\u0940 \u0906\u0915\u094d\u0937\u0947\u0927\u092a\u0924 \u0906\u0926\u0947\u0936\u094b\u0902 \u0915\u094b \u0905\u092a\u093e\u0938\u094d\u0924 \u0915\u0930 \u0927\u0926\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u092e\u093e\u092e\u0932\u0947 \u0935\u093e\u092a\u0938 \u092d\u0947\u091c \u0927\u0926\u090f \u0917\u090f\u0964 \n6. \u0909\u093f\u094b \u0920\u093e\u0915\u0941\u0930 (\u090a\u092a\u0930) \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u092d\u0940 \"\u092a\u0940\u0927\u093c\u093f\u0924 \u092e\u0941\u0906\u0935\u091c\u093e\" \u0936\u0924\u0925/\u0935\u093e\u0915\u094d\u092f\u093e\u0902\u0936 \u0915\u0947 \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0947 \u092a\u0939\u0932\u0942 \u0915\u094b  \n\u0905\u0928\u0941\u0927\u091a\u0924 \u092a\u093e\u092f\u093e \u0917\u092f\u093e, \u0915\u094d\u092f\u094b\u0902\u0927\u0915 \u0927\u0917\u0930\u092b\u094d\u0924\u093e\u0930\u0940 \u092a\u0942\u0935\u0925 \u091c\u092e\u093e\u0928\u0924 \u0915\u0940 \u0915\u093e\u092f\u0925\u0935\u093e\u0939\u0940 \u0915\u094b\u0908 \u093f\u0928 \u0935\u0938\u0942\u0932\u0940 \u0915\u0940 \u0915\u093e\u092f\u0925\u0935\u093e\u0939\u0940 \n\u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \n7. \u092f\u0939 \u092e\u093e\u092e\u0932\u093e \u0909\u0928\u0938\u0947 \u092d\u0940 \u090f\u0915 \u0915\u0926\u092e \u0906\u0917\u0947 \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0927\u0915 \u092f\u0939\u093e\u0902, \u092a\u0948\u0938\u0947 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928/\u092a\u0948\u0938\u093e \u091c\u092e\u093e \u0915\u0930\u0928\u093e \n\u0915\u0947\u0935\u0932 \u0905\u0927\u093f\u092e \u091c\u092e\u093e\u0928\u0924 \u0915\u0947 \u0927\u0932\u090f \u0915\u0947\u0935\u0932 \u090f\u0915 \u0936\u0924\u0925 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u0915\u094d\u0924\u093f \u0905\u0927\u093f\u092e \u091c\u092e\u093e\u0928\u0924 \u0915\u0940 \u0915\u093e\u092f\u0925\u0935\u093e\u0939\u0940 \n\u092e\u0947\u0902 \u0939\u0940 \u092a\u0940\u0927\u093c\u093f\u0924 \u0915\u094b \u0905\u0902\u0924\u0930\u0930\u092e \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u093e \u0927\u0928\u0926\u0947\u0936 \u0939\u0948\u0964 \n8. \u092a\u0940\u0927\u093c\u093f\u0924 \u0915\u094b \u0927\u0926\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0938\u0902\u092c\u0902\u093f\u0940 \u092e\u093e\u092e\u0932\u0947 \u0915\u093e \u0907\u0927\u0924\u0939\u093e\u0938 \u0926\u0947\u0916\u0928\u0947 \u092a\u0930 \u0939\u092e \u092a\u093e\u0924\u0947 \u0939\u0948\u0902 \u0927\u0915 1960 \n\u0915\u0947 \u0926\u0936\u0915 \u092e\u0947\u0902 '\u092a\u0940\u0927\u093c\u093f\u0924\u0935\u093e\u0926' (\u0927\u0935\u0915\u094d\u0924\u093f\u092e\u094b\u0932\u0949\u091c\u0940) \u0906\u0902\u0926\u094b\u0932\u0928 \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u094c\u0927\u093f\u0915 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u0930\u093e\u0938\u094d\u0924\u093e \u0924\u0948\u092f\u093e\u0930 \n\u0927\u0915\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u0907\u0938 \u0924\u0930\u0939 \u0915\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u094b \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0905\u0927\u092d\u092f\u094b\u0917\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0936\u0940\u0932\u0928 \u092e\u0947\u0902 \u092a\u0940\u0927\u093c\u093f\u0924\u094b\u0902 \u0915\u0947 \n\u0938\u0939\u092f\u094b\u0917 \u0938\u0947 \u091c\u094b\u093c\u093f\u0915\u0930 \u0938\u0930\u0915\u093e\u0930\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u0928 \u0927\u0926\u092f\u093e\u0964 \u0915\u0928\u093e\u0921\u093e \u0914\u0930 \u0938\u0902\u092f\u0941\u093f \u0930\u093e\u091c\u094d\u092f \u0905\u092e\u0947\u0930\u0930\u0915\u093e \u0915\u0947 \u0915\u0908 \n\u0930\u093e\u091c\u094d\u092f\u094b\u0902 \u0928\u0947 \u092a\u0940\u0927\u093c\u093f\u0924\u094b\u0902 \u0915\u094b \u092e\u0941\u0906\u0935\u091c\u093e \u0926\u0947\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930 \u0927\u0926\u092f\u093e \u0914\u0930 \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u0930, \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0905\u0927\u092d\u092f\u094b\u091c\u0928 \u092e\u0947\u0902 \n\u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0940 \u0938\u0939\u092d\u093e\u0927\u0917\u0924\u093e \u0915\u093e \u092e\u093e\u0917\u0925 \u092a\u094d\u0930\u0936\u0938\u094d\u0924 \u0939\u0941\u0906\u0964 80 \u0915\u0947 \u0926\u0936\u0915 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u092e\u0947\u0902 \u092a\u0940\u0927\u093c\u093f\u0924\u094b\u0902 \u0915\u0947 \u0927\u0939\u0924 \u0915\u0947 \n\u0927\u0932\u090f \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0928\u094d\u092f\u093e\u092f \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u092e\u0947\u0902 \u0938\u0941\u093f\u093e\u0930 \u0915\u0947 \u0927\u0932\u090f \u0915\u0908 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0923\u0925 \u092a\u0939\u0932 \u0914\u0930 \u092a\u0940\u0927\u093c\u093f\u0924\u0935\u093e\u0926 \u0915\u0947 \u0905\u0917\u0941\u0906 \n\u092d\u0940 \u0939\u0941\u090f\u0964 \u2018\u092a\u0940\u0927\u093c\u093f\u0924\u094b\u0902 \u0915\u0947 \u0927\u0932\u090f \u0928\u094d\u092f\u093e\u092f\u2019 \u0914\u0930 \u2018\u0936\u0915\u094d\u0924\u093f \u0915\u0947 \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917\u2019 \u0915\u0947 \u092e\u0942\u0932\u092d\u0942\u0924 \u0927\u0938\u0926\u094d\u093e\u0902\u0924\u094b\u0902 \u092a\u0930 \u0938\u0902\u092f\u0941\u093f \u0930\u093e\u0937\u094d\u091f\u0930 \n\u0926\u094d\u0935\u093e\u0930\u093e \u0915\u0940 \u0917\u0908 \u0918\u094b\u0937\u0923\u093e \u092e\u0939\u093e\u0938\u092d\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0935\u0925\u0938\u092e\u094d\u092e\u0927\u0924 \u0938\u0947 1985 \u092e\u0947\u0902 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u0917\u0908 (\u093f\u094b\u090f\u0928\u0939\u0941\u0907\u091c\u0938\u0947\u0928, \n2014)\u0964 \u0907\u0938 \u0918\u094b\u0937\u0923\u093e \u0938\u0947 \u0905\u092a\u0930\u093e\u093f-\u092a\u0940\u0927\u093c\u093f\u0924\u094b\u0902 \u0915\u0947 \u0927\u0935\u0936\u0947\u0937 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 \u0924\u0930\u094d\u0925\u093e \u0939\u0915\u0926\u093e\u0930\u0940 \u0915\u0947 \u0938\u093e\u0930\u094d\u0925-\u0938\u093e\u0930\u094d\u0925 \u092e\u0941\u0906\u0935\u091c\u0947 \n\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094b \u092d\u0940 \u092c\u0932 \u0927\u092e\u0932\u093e\u0964 \n\n9. \u0926\u0902\u0921 \u092a\u094d\u0930\u0927\u093f\u092f\u093e \u0938\u0902\u0927\u0939\u0924\u093e \u0915\u0940 \u093f\u093e\u0930\u093e 357 \u092e\u0947\u0902 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u0926\u0947\u0936 \u0926\u0947\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u093e\u0935\u093f\u093e\u0928 \n\u0924\u092c \u0939\u0948, \u091c\u092c \u0915\u094b\u0908 \u0905\u0926\u093e\u0932\u0924 \u091c\u0941\u092e\u093e\u0925\u0928\u093e \u0932\u0917\u093e\u0924\u0940 \u0939\u0948 \u092f\u093e \u0915\u094b\u0908 \u0910\u0938\u0940 \u0938\u091c\u093e (\u092e\u094c\u0924 \u0915\u0940 \u0938\u091c\u093e \u0938\u0927\u0939\u0924) \u0926\u0947\u0924\u0940 \u0939\u0948, \n\u0927\u091c\u0938\u092e\u0947\u0902 \u091c\u0941\u092e\u093e\u0925\u0928\u093e \u0909\u0938 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0935\u0927\u0923\u0925\u0924 \u092a\u0930\u0930\u0915\u094d\u0924\u0925\u0930\u094d\u0925\u0927\u0924\u092f\u094b\u0902 \u0915\u093e \u0939\u0940 \u090f\u0915 \u092d\u093e\u0917 \u0939\u094b\u0964 \u0907\u0938\u092e\u0947\u0902 \u0909\u092a-\u093f\u093e\u0930\u093e (2) \u0915\u0947 \n\u0926\u094d\u0935\u093e\u0930\u093e \u090f\u0915 \u0938\u0940\u092e\u093e \u092d\u0940 \u0927\u0928\u093f\u093e\u0925\u0930\u0930\u0924 \u0915\u0940 \u0917\u0908 \u0939\u0948 \u0927\u0915 \u091c\u092c \u0927\u0915\u0938\u0940 \u0910\u0938\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u091c\u0941\u092e\u093e\u0925\u0928\u093e \u0932\u0917\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \n\u0905\u092a\u0940\u0932 \u0915\u0947 \u092f\u094b\u0917\u094d\u092f \u0939\u0948, \u0924\u094b \u0905\u092a\u0940\u0932 \u0926\u093e\u0915\u094d\u0924\u0916\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0927\u0932\u090f \u0927\u0928\u093f\u093e\u0925\u0930\u0930\u0924 \u0905\u0935\u0927\u093f \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0909\u093f \n\u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0928\u0939\u0940\u0902 \u0927\u0915\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u092f\u0927\u0926 \u0905\u092a\u0940\u0932 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0924\u094b \u0905\u092a\u0940\u0932 \u0915\u093e \u0927\u0928\u0923\u0925\u092f \u0927\u0915\u090f \n\u091c\u093e\u0928\u0947 \u0924\u0915 \u0909\u093f \u092d\u0941\u0917\u0924\u093e\u0928 \u0928\u0939\u0940\u0902 \u0927\u0915\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0909\u092a-\u093f\u093e\u0930\u093e (3) \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092f\u0939 \u092e\u0941\u0906\u0935\u091c\u093e \u0909\u0938 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \n(\u092a\u0940\u0927\u093c\u093f\u0924) \u0915\u0947 \u0927\u0932\u090f \u0939\u0948, \u0927\u091c\u0938\u0947 \u0909\u0938 \u0905\u092a\u0930\u093e\u093f \u0915\u0947 \u0915\u093e\u0930\u0923 \u0928\u0941\u0915\u0938\u093e\u0928 \u0939\u0941\u0906 \u0939\u0948 \u092f\u093e \u091a\u094b\u091f \u0932\u0917\u0940 \u0939\u0948, \u0927\u091c\u0938\u0915\u0947 \u0927\u0932\u090f \n\u0905\u0927\u092d\u092f\u0941\u093f \u0915\u094b \u0938\u091c\u093e \u0938\u0941\u0928\u093e\u0908 \u0917\u0908 \u0939\u0948\u0964 \u0909\u092a-\u093f\u093e\u0930\u093e (4) \u092e\u0947\u0902 \u0905\u092a\u0940\u0932\u0940\u092f \u0905\u0926\u093e\u0932\u0924, \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092f\u093e \u0938\u0924\u094d\u0930 \n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0941\u0928\u0930\u0940\u0915\u094d\u0937\u0923 \u0915\u0940 \u0936\u0915\u094d\u0924\u093f \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u0927\u0932\u090f \u0906\u0926\u0947\u0936 \n\u0927\u0926\u090f \u091c\u093e\u0928\u0947 \u0915\u093e \u092d\u0940 \u092a\u094d\u0930\u093e\u0935\u093f\u093e\u0928 \u0927\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \n10. \u0939\u092e\u0928\u0947 \u091c\u094b \u0910\u0938\u093e \u0927\u0928\u093f\u093e\u0925\u0930\u0930\u0924 \u0927\u0915\u092f\u093e \u0939\u0948, \u0907\u0938\u0915\u093e \u0905\u0930\u094d\u0925\u0925 \u092f\u0939 \u0939\u0948 \u0927\u0915 \u0906\u0930\u094b\u0927\u092a\u0924 \u0905\u092a\u0930\u093e\u093f \u092a\u0930 \u0927\u0926\u090f \u0917\u090f \u0905\u0902\u0927\u0924\u092e \n\u0927\u0928\u0923\u0925\u092f \u0905\u0930\u094d\u0925\u093e\u0925\u0924 \u0935\u0939 \u0905\u092a\u0930\u093e\u093f \u0909\u0938\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0915\u093e\u0930\u0930\u0924 \u0927\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902, \u0907\u0938\u0915\u0947 \u0927\u0928\u0923\u0925\u092f \u0915\u0947 \u0938\u092e\u092f \u0939\u0940 \n\u092a\u0940\u0927\u093c\u093f\u0924 \u0915\u094b \u0927\u0926\u092f\u093e \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u093e \u092e\u0941\u0906\u0935\u091c\u093e \u0927\u0928\u093f\u093e\u0925\u0930\u0930\u0924 \u0927\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u0930, \u0905\u0902\u0927\u0924\u092e \u0927\u0928\u0923\u0925\u092f \u0924\u0915 \n\u092a\u0939\u0941\u0902\u091a\u0928\u0947 \u0938\u0947 \u092a\u0942\u0935\u0925 \u0905\u0930\u094d\u0925\u0935\u093e \u092e\u093e\u092e\u0932\u0947 \u092a\u0930 \u0927\u0935\u091a\u093e\u0930\u0923 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0927\u0915\u0938\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u092e\u0941\u0906\u0935\u091c\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u093e \u0915\u094b\u0908 \n\u092a\u094d\u0930\u0936\u094d\u0928 \u0939\u0940 \u0928\u0939\u0940\u0902 \u0909\u0920\u0924\u093e\u0964 \n11. \u093f\u092e\u0947\u0936 \u092c\u0928\u093e\u092e \u0917\u0941\u091c\u0930\u093e\u0924 \u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u0947\u0902 \u0907\u0938\u0940 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u090f\u0915 \u0939\u093e\u0927\u0932\u092f\u093e \u092b\u0948\u0938\u0932\u0947 \u092e\u0947\u0902 \u092d\u0940 \u092f\u0939\u0940 \n\u0915\u0939\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u093e \u0927\u0915 \u093f\u093e\u0930\u093e 357 \u0915\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u092a\u0922\u093c\u0928\u0947 \u0938\u0947 \u0939\u0940 \u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0939\u094b\u0924\u093e \u0939\u0948 \u0927\u0915 \u0907\u0938 \u0924\u0930\u0939 \u0915\u093e \n\u092e\u0941\u0906\u0935\u091c\u093e \u0915\u0947\u0935\u0932 \u0927\u0935\u091a\u093e\u0930\u0923 \u092a\u0942\u0923\u0925 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0939\u0940 \u0932\u0917\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948, \u0924\u0930\u094d\u0925\u093e\u0927\u092a \u092f\u0939 \u0927\u0928\u0927\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \n\u0928\u094d\u092f\u093e\u092f\u093e\u093f\u0940\u0936 \u0915\u0947 \u0927\u0935\u0935\u0947\u0915 \u092a\u0930 \u0927\u0928\u092d\u0925\u0930 \u0939\u0948\u0964 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u093e \u092f\u0939 \u0927\u0928\u0926\u0947\u0936 \u0927\u0915 \u0906\u0930\u094b\u092a\u0940, \u092e\u0943\u0924\u0915 (\u092a\u0940\u0927\u093c\u093f\u0924) \u0915\u0947 \n\u0915\u093e\u0928\u0942\u0928\u0940 \u0909\u0924\u094d\u0924\u0930\u093e\u0927\u093f\u0915\u093e\u0930\u0930\u092f\u094b\u0902 \u0915\u094b \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u0940 \u0930\u093e\u0927\u0936 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947, \u0914\u0930 \u0935\u0939 \u092d\u0940 \u091c\u092e\u093e\u0928\u0924 \u0915\u0940 \u090f\u0915 \n\u0936\u0924\u0925 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902, \u0927\u092c\u0932\u0915\u0941\u0932 \u0938\u094d\u0935\u0940\u0915\u093e\u092f\u0925 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 \u0907\u0938\u0927\u0932\u090f, \u0907\u0938\u0947 \u0924\u0915\u0925 \u0915\u0947 \u0906\u093f\u093e\u0930 \u092a\u0930 \u0916\u093e\u0930\u0930\u091c \u0927\u0915\u092f\u093e \n\u091c\u093e\u0924\u093e \u0939\u0948\u0964 \n12. \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0915\u0939\u093e \u0939\u0948 \u0927\u0915 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0938\u094d\u092a\u0937\u094d\u091f \u0939\u0948 \u0927\u0915 \u0936\u093e\u0930\u0940\u0930\u0930\u0915 \u0905\u092a\u0930\u093e\u093f\u094b\u0902 \u0915\u0947 \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902, \u092a\u0940\u0927\u093c\u093f\u0924 \u0915\u094b \n\u092e\u0941\u0906\u0935\u091c\u093e \u0927\u092e\u0932\u0928\u093e \u0939\u0940 \u091a\u093e\u0927\u0939\u090f\u0964 \u0907\u0938\u0940 \u0924\u0930\u0939, \u0905\u0928\u093e\u0935\u0936\u094d\u092f\u0915 \u0909\u0924\u094d\u092a\u0940\u093c\u093f\u0928 \u0915\u094b \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0927\u0932\u090f \u092d\u0940 \u092e\u0941\u0906\u0935\u091c\u0947 \n\n\u0915\u093e \u092a\u094d\u0930\u093e\u0935\u093f\u093e\u0928 \u0927\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948, \u091c\u0939\u093e\u0902 \u0905\u0928\u093e\u0935\u0936\u094d\u092f\u0915 \u0906\u092a\u0930\u093e\u0927\u093f\u0915 \u0915\u093e\u092f\u0925\u0935\u093e\u0939\u0940 \u0936\u0941\u0930\u0942 \u0915\u0940 \u0917\u0908 \u0939\u094b\u0964 \u0907\u0938 \u0924\u0930\u0939 \n\u0915\u0947 \u092e\u0941\u0906\u0935\u091c\u0947 \u0915\u094b \u092d\u0940 \u091c\u092e\u093e\u0928\u0924 \u0926\u0947\u0924\u0947 \u0938\u092e\u092f \u0927\u0928\u093f\u093e\u0925\u0930\u0930\u0924 \u0928\u0939\u0940\u0902 \u0927\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964 \n13. \u0907\u0938 \u0924\u0930\u0939 \u0915\u0947 \u0928\u094d\u092f\u093e\u0927\u092f\u0915 \u0926\u0941\u0938\u094d\u0938\u093e\u0939\u0938 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928 \u0915\u0930\u0924\u0947 \u0939\u0941\u090f, \u0939\u092e\u0947\u0902 \u0905\u0927\u093f\u092e \u091c\u092e\u093e\u0928\u0924 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0906\u0915\u094d\u0937\u0947\u0927\u092a\u0924 \n\u0906\u0926\u0947\u0936 \u092e\u0947\u0902 \u0932\u0917\u093e\u0908 \u0917\u0908 \u0907\u0938 \u0936\u0924\u0925 \u0915\u094b \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u0902\u0915\u094b\u091a \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092f\u0926\u094d\u092f\u0927\u092a \u0905\u0928\u094d\u092f \u092c\u093e\u0924\u094b\u0902 \u0915\u094b \u092c\u0930\u0915\u0930\u093e\u0930 \n\u0930\u0916\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964  \n14. \u0924\u0926\u0928\u0941\u0938\u093e\u0930, \u0907\u0938 \u0905\u092a\u0940\u0932 \u092e\u0947\u0902 \u0915\u0940 \u0917\u0908 \u092a\u094d\u0930\u093e\u0930\u094d\u0925\u0925\u0928\u093e \u0925 \u0935\u0940\u0915\u093e\u0930 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092a\u0915\u094d\u0937\u0915\u093e\u0930 \u0905\u092a\u0928\u093e-\u0905\u092a\u0928\u093e \u0916\u091a\u0925 \n\u0938\u094d\u0935\u092f\u0902 \u0935\u0939\u0928 \u0915\u0930\u0947\u0902\u0917\u0947\u0964  \n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026....\u0928\u094d\u092f\u093e\u092f\u093e.\u0964 \n[\u0938\u0902\u091c\u092f \u0927\u0915\u0936\u0928 \u0915\u094c\u0932] \n\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026\u2026.... \u0928\u094d\u092f\u093e\u092f\u093e.\u0964 \n[\u0905\u092d\u092f \u090f\u0938. \u0913\u0915\u093e] \n\u0928\u0908 \u0927\u0926\u0932\u094d\u0932\u0940 \n\u091c\u0928\u0935\u0930\u0940 24, 2023 \n \n\u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0930\u094d : \u0927\u0939\u0928\u094d\u0926\u0940 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0905\u0928\u0942\u0927\u0926\u0924 \u0927\u0928\u0923\u0925\u092f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0907\u0924\u0928\u093e \u0939\u0940 \u0939\u0948 \u0927\u0915 \u0935\u093e\u0926\u0940 \u0907\u0938\u0947 \u0905\u092a\u0928\u0940 \u092d\u093e\u0937\u093e \n\u092e\u0947\u0902 \u0938\u092e\u091d \u0938\u0915\u0947\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0927\u0915\u0938\u0940 \u0905\u0928\u094d\u092f \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0927\u0932\u090f \u0928\u0939\u0940\u0902 \u0927\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964 \u0938\u092d\u0940 \n\u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u0930\u0915 \u0914\u0930 \u0906\u0927\u093f\u0915\u093e\u0930\u0930\u0915 \u0915\u093e\u092f\u094b\u0902 \u092e\u0947\u0902 \u0924\u0930\u094d\u0925\u093e \u0927\u0928\u0937\u094d\u092a\u093e\u0926\u0928 \u0914\u0930 \u0915\u093e\u092f\u093e\u0925\u0928\u094d\u0935\u092f\u0928 \u0915\u0947 \u0927\u0932\u090f \u0909\u093f \u0927\u0928\u0923\u0925\u092f \u0915\u093e \n\u0905\u0902\u093f\u0947\u091c\u0940 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0939\u0940 \u092e\u093e\u0928\u094d\u092f \u0939\u094b\u0917\u093e\u0964 \n"
}