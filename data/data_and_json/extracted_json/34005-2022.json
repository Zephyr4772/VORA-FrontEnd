\n \n \n3.  \n\u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e \u0a05\u0a2a\u0a40\u0a32* \u0a26\u0a3e \u0a26\u0a4b.\u0a40 \u0a06\u0a3f\u0a30\u0a05\u0a28 \u0a3f\u0a38\u0a70\u0a18 \u0a05\u0a24\u0a47 .7\u0a40 \u0a2e\u0a39\u0a47. \u0a1c\u0a47\u0a20\u0a2e\u0a32\u0a3e\u0a28\u0a40 \u0a26\u0a40 \u0a24\u0a30\u0a2b/ \u0a2a\u0a47. \n\u0a39\u0a4b\u0a0f \u0a38\u0a40\u0a28\u0a40\u0a05\u0a30 \u0a35\u0a15\u0a40\u0a32 .7\u0a40 \u0a06\u0a30 \u0a2a\u0a40 \u0a2d\u0a71\u0a1f \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a38\u0a59\u0a24 \u0a3f\u0a35\u0a30\u0a4b\u0a27 \u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a39\u0a48, \u0a1c\u0a4b \u0a3f\u0a15 \u0a26\u0a4b.\u0a40 \n\u0a17\u0a4c\u0a24\u0a2e \u0a1a\u0a40\u0a2e\u0a3e \u0a26\u0a40 \u0a24\u0a30\u0a2b/ \u0a2a\u0a47. \u0a39\u0a4b\u0a0f \u0a38\u0a40\u0a28\u0a40\u0a05\u0a30 \u0a35\u0a15\u0a40\u0a32 \u0a39\u0a28\u0964 \n3.1  \n\u0a38\u0a2c\u0a70\u0a27\u0a24 \u0a26\u0a4b\u0a36\u0a40\u0a06\u0a02 \u0a26\u0a40 \u0a24\u0a30\u0a2b/ \u0a2a\u0a47. \u0a39\u0a4b\u0a0f \u0a26\u0a4b\u0a35> \u0a2e\u0a3e\u0a23\u0a2f\u0a4b\u0a17 \u0a35\u0a15\u0a40\u0a32* \u0a284  \u0a39\u0a30\u0a47\u0a15 \u0a2e\u0a41\u0a32\u0a5b\u0a2e \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \n\u0a32\u0a3e\u0a0f \u0a17\u0a0f \u0a26\u0a4b.* \u0a26\u0a47 \u0a17\u0a41\u0a23* \u0a26\u0a47 \u0a06\u0a27\u0a3e\u0a30 '\u0a24\u0a47 \u0a2a\u0a47. \u0a15\u0a40\u0a24\u0a3e\u0964\u0a39\u0a3e\u0a32*\u0a3f\u0a15, \u0a09\u0a39 \u0a38\u0a3e\u0a30\u0a40\u0a06\u0a02 \u0a2a\u0a47\u0a36\u0a15\u0a36* \u0a2c\u0a1a\u0a3e\u0a05 \n\u0a39\u0a28, \u0a3f\u0a1c\u0a28\u001b * \u0a28\u0a42\u0a70 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a26\u0a4c\u0a30\u0a3e\u0a28 \u0a3f\u0a35\u0a1a\u0a3e\u0a30\u0a47 \u0a1c\u0a3e\u0a23 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964\u0a07\u0a38 \u0a32\u0a08, \u0a05\u0a38J \u0a38\u0a40.\u0a2c\u0a40.\u0a06\u0a08. \n\u0a26\u0a40 \u0a24\u0a30\u0a2b/ \u0a05\u0a24\u0a47/\u0a1c* \u0a2e\u0a41\u0a32\u0a5b\u0a2e* \u0a26\u0a47 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a26\u0a4b.* '\u0a24\u0