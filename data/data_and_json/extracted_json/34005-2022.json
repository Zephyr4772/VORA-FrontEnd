a26\u0a47 \u0a05\u0a28\u0a41\u0a1b\u0a47\u0a26 226 \u0a26\u0a47 \u0a05\u0a27\u0a40\u0a28 .\u0a15\u0a24\u0a40\u0a06\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a24/ \n\u0a15\u0a30\u0a3f\u0a26\u0a06\u0a02 \u0a38\u0a2e\u0a41\u0a71\u0a1a\u0a40 \u0a2b\u0a4c\u0a1c\u0a26\u0a3e\u0a30\u0a40 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a3f\u0a35\u0a71\u0a1a \u0a06\u0a2a\u0a23\u0a47 \u0a05\u0a3f\u0a27\u0a15\u0a3e\u0a30 \u0a16\u0a47\u0a24\u0a30 \u0a26\u0a40 \n\u0a09\u0a32\u0a70\u0a18\u0a23\u0a3e \u0a15\u0a40\u0a24\u0a40 \u0a39\u0a48\u0964 \n \n4.1  \n\u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a2a\u0a3e\u0a38 \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a07\u0a24\u0a30\u0a3e\u0a5b\u0a2f\u0a4b\u0a17 \u0a38*\u0a1d\u0a47 \u0a2b\u0a48\u0a38\u0a32\u0a47 \u0a05\u0a24\u0a47 \u0a06\u0a26\u0a47. \n(Impugned Common Judgment and Order) \u0a24/ \u0a07\u0a39 \u0a1c\u0a3e\u0a2a\u0a26\u0a3e \u0a39\u0a48 \u0a3f\u0a15 \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a284  \n\u0a06\u0a2a\u0a23\u0a47 \u0a38\u0a3e\u0a39\u0a2e\u0a23\u0a47 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08\u0a06\u0a02 \u0a26\u0a3e \u0a3f\u0a28\u0a2a\u0a1f\u0a3e\u0a30\u0a3e \u0a15\u0a40\u0a24\u0a3e \u0a39\u0a48, \u0a3f\u0a1c\u0a35> \u0a3f\u0a15, \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a07\u0a71\u0a15 \u0a3f\u0a2e\u0a70\u0a28\u0a40 \n\u0a1f7\u0a3e\u0a07\u0a32 \u0a15\u0a30 \u0a30\u0a39\u0a40 \u0a38\u0a40 \u0a05\u0a24\u0a47/\u0a1c* \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a1f7\u0a3e\u0a07\u0a32 \u0a26\u0a40 \u0a38\u0a2e\u0a3e\u0a2a\u0a24\u0a40 '\u0a24\u0a47 \u0a2e\u0a3e\u0a23\u0a2f\u0a4b\u0a17 \u0a1f7\u0a3e\u0a07\u0a32 \u0a15\u0a4b\u0a30\u0a1f \n\n5 \n \n \n2023 \u0a26\u0a3e \u0a05\u0a2a\u0a30\u0a3e\u0a3f\u0a27\u0a15 \u0a05\u0a2a\u0a40\u0a32 \u0a28\u0a70. 1025-1026  \n \n \n\u0a26\u0a41\u0a06\u0a30\u0a3e \u0a3f\u0a26\u0a71\u0a24\u0a47 \u0a17\u0a0f \u0a2b\u0a48\u0a38\u0a32\u0a47 \u0a05\u0a24\u0a47 \u0a06\u0a26\u0a47. \u0a26\u0a47 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a05\u0a30\u0a5b\u0a40\u0a06\u0a02' \u0a24\u0a47 \u0a3f\u0a35\u0a1a\u0a3e\u0a30 \u0a15\u0a30 \u0a30\u0a39\u0a40 \u0a38\u0a40\u0964\u0a27\u0a3e\u0a30\u0a3e \n482 \u0a38\u0a40 \u0a06\u0a30 \u0a2a\u0a40 \u0a38\u0a40 \u0a26\u0a47 \u0a05\u0a27\u0a40\u0a28 .\u0a15\u0a24\u0a40\u0a06\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a24/ \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a4b\u0a0f, \u0a05\u0a2a\u0a30\u0a3e\u0a3f\u0a27\u0a15 \u0a3f\u0a21\u0a38\u0a1a\u0a3e\u0a30\u0a1c \n\u0a05\u0a24\u0a47/\u0a1c* \u0a05\u0a2a\u0a30\u0a3e\u0a3f\u0a27\u0a15 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47, \u0a15\u0a3e\u0a28\u0a42\u0a70\u0a28 \u0a26\u0a47 \u0a2e\u0a41\u0a71\u0a16 \u0a3f\u0a38\u0a27*\u0a24 \u0a26\u0a47 \n\u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30, \u0a05\u0a26\u0a3e\u0a32\u0a24 \u0a28\u0a42\u0a70 \u0a3f\u0a2e\u0a70\u0a28\u0a40 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a3e \u0a1a\u0a32\u0a3e\u0a09\u0a23 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a28\u0a39J \u0a39\u0a48\u0964 \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a284  \u0a06\u0a2a\u0a23\u0a47 \n\u0a07\u0a24\u0a30\u0a3e\u0a5b\u0a2f\u0a4b\u0a17 \u0a38*\u0a1d\u0a47 \u0a2b\u0a48\u0a38\u0a32\u0a47 \u0a05\u0a24\u0a47 \u0a06\u0a26\u0a47. (Impugned Common Judgment and Order) \n\u0a3f\u0a35\u0a71\u0a1a \u0a3f\u0a15\u0a39\u0a3e \u0a39\u0a48 \u0a3f\u0a15 \u0a26\u0a4b\u0a36\u0a40\u0a06\u0a02 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a26\u0a4b. \u0a38\u0a3e\u0a2c\u0a24 \u0a28\u0a39J \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a39\u0a28\u0964 \u0a07\u0a39 \u0a09\u0a39 \u0a2a\u0a5c\u0a3e\u0a05 \u0a28\u0a39J \n\u0a39\u0a48 \u0a3f\u0a1c\u0a71\u0a25\u0a47 \u0a07\u0a38\u0a24\u0a17\u0a3e\u0a38\u0a3e/\u0a1c*\u0a1a \u0a0f\u0a1c\u0a70\u0a38\u0a40 \u0a28\u0a42\u0a70 \u0a26\u0a4b.* \u0a28\u0a42\u0a70 \u0a38\u0a3e\u0a2c\u0a24 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48\u0964 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a26\u0a4c\u0a30\u0a3e\u0a28, \n\u0a07\u0a38\u0a24\u0a17\u0a3e\u0a38\u0a3e \u0a2a\u0a71\u0a16 /\u0a1c*\u0a1a \u0a0f\u0a1c\u0a70\u0a38\u0a40 \u0a35\u0a71\u0a32/ \u0a2a\u0a47. \u0a38\u0a2c\u0a42\u0a24 \u0a26\u0a47 \u0a05\u0a27\u0a3e\u0a30 \u2019\u0a24\u0a47 \u0a26\u0a4b. \u0a38\u0a3e\u0a2c\u0a24 \u0a15\u0a40\u0a24\u0a47 \u0a1c\u0a3e\u0a23\u0a47 \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a47 \n\u0a39\u0a28\u0964 \u0a07\u0a38 \u0a32\u0a08, \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a284  \u0a07\u0a38 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47 \u0a26\u0a4b\u0a36\u0a40 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a24\u0a2b\u0a24\u0a40\u0a36 \u0a26\u0a47 \u0a26\u0a4c\u0a30\u0a3e\u0a28 \u0a07\u0a15\u0a71\u0a204  \n\u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \u0a26\u0a4b.* \u0a05\u0a24\u0a47 \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40 \u0a26\u0a47 \u0a35\u0a47\u0a30\u0a35\u0a47 \u0a3f\u0a35\u0a71\u0a1a \u0a1c\u0a3e\u0a23 \u0a3f\u0a35\u0a71\u0a1a \u0a35\u0a3e\u0a38\u0a24\u0a3f\u0a35\u0a15 \u0a24\u0a4c\u0a30' \u0a24\u0a47 \u0a17\u0a32\u0a24\u0a40 \u0a15\u0a40\u0a24\u0a40 \n\u0a39\u0a48\u0964 \u0a3f\u0a30\u0a39\u0a3e\u0a05 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2a\u0a5c\u0a3e\u0a05 (discharge) \u0a05\u0a24\u0a47/\u0a1c* \u0a38\u0a40\u0a06\u0a30\u0a2a\u0a40\u0a38\u0a40 \u0a26\u0a40 \u0a27\u0a3e\u0a30\u0a3e 482 \u0a24\u0a3f\u0a39\u0a24 \n.\u0a15\u0a24\u0a40\u0a06\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a24/ \u0a15\u0a30\u0a26\u0a47 \u0a38\u0a2e> \u0a05\u0a26\u0a3e\u0a32\u0a24 \u0a15\u0a4b\u0a32 \u0a2c\u0a39\u0a41\u0a24 \u0a38\u0a40\u0a2e\u0a24 \u0a05\u0a3f\u0a27\u0a15\u0a3e\u0a30 \u0a16\u0a47\u0a24\u0a30 \u0a39\u0a41\u0a70\u0a26\u0a3e \u0a39\u0a48 \u0a05\u0a24\u0a47 \n\u0a09\u0a38 \u0a28\u0a42\u0a70 \u0a07\u0a39 \u0a3f\u0a35\u0a1a\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a5b\u0a30\u0a42\u0a30\u0a24 \u0a39\u0a41\u0a70\u0a26\u0a40 \u0a39\u0a48 \u0a3f\u0a15 \u0a15\u0a40 \u0a26\u0a4b\u0a36\u0a40 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a05\u0a71\u0a17\u0a47 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a15\u0a30\u0a28 \n\u0a32\u0a08 \u0a15\u0a4b\u0a08 \u0a32\u0a4b\u0a5cJ\u0a26\u0a40 \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40 \u0a09\u0a2a\u0a32\u0a2c\u0a27 \u0a39\u0a48 \u0a1c* \u0a28\u0a39J, \u0a3f\u0a1c\u0a38 \u0a32\u0a08 \u0a26\u0a4b\u0a36\u0a40 '\u0a24\u0a47 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a3e \u0a1a\u0a32\u0a3e\u0a07\u0a06 \n\u0a1c\u0a3e\u0a23\u0a3e \u0a1a\u0a3e\u0a39\u0a40\u0a26\u0a3e \u0a39\u0a48 \u0a1c* \u0a28\u0a39J\u0964 \n4.2  \n\u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a35\u0a71\u0a32/ \u0a07\u0a71\u0a15 \u0a39\u0a4b\u0a30 \u0a15\u0a3e\u0a30\u0a28 \u0a07\u0a39 \u0a26\u0a71\u0a3f\u0a38\u0a06 \u0a3f\u0a17\u0a06 \u0a39\u0a48 \u0a3f\u0a15 \u0a2b\u0a4c\u0a1c\u0a26\u0a3e\u0a30\u0a40 \n\u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08\u0a06\u0a02/\u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08\u0a06\u0a02 \u0a26\u0a40 .\u0a41\u0a30\u0a42\u0a06\u0a24 \u0a15\u0a30\u0a28\u0a3e \u0a2e\u0a70\u0a26\u0a2d\u0a3e\u0a17\u0a3e \u0a39\u0a48\u0964\u0a07\u0a38 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47, \u0a07\u0a39 \u0a28T \u0a1f \n\u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a5b\u0a30\u0a42\u0a30\u0a24 \u0a39\u0a48 \u0a3f\u0a15 \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a1c\u0a3e\u0a30\u0a40 \u0a3f\u0a28\u0a30\u0a26\u0a47.* \u0a05\u0a28\u0a41\u0a38\u0a3e\u0a30 \u0a24\u0a2b\u0a24\u0a40\u0a36 \u0a38\u0a40\u0a2c\u0a40\u0a06\u0a08 \n\u0a28\u0a42\u0a70 \u0a38H\u0a2a \u0a3f\u0a26\u0a71\u0a24\u0a40 \u0a17\u0a08 \u0a38\u0a40\u0964 \u0a07\u0a38 \u0a24/ \u0a2c\u0a3e\u0a05\u0a26,\u0a1c*\u0a1a \u0a2a\u0a42\u0a30\u0a40 \u0a39\u0a4b\u0a23 '\u0a24\u0a47 \u0a26\u0a4b\u0a36\u0a40 \u0a3f\u0a35\u0a05\u0a15\u0a24\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a1a\u0a3e\u0a30\u0a1c.\u0a40\u0a1f \n\u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a32\u0a08, \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a284  \u0a07\u0a38 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47 \u0a07\u0a39 \u0a3f\u0a1f\u0a71\u0a2a\u0a23\u0a40 \u0a15\u0a30\u0a3f\u0a26\u0a06\u0a02 \u0a17\u0a32\u0a24\u0a40 \n\u0a15\u0a40\u0a24\u0a40 \u0a39\u0a48 \u0a3f\u0a15 \u0a2b\u0a4c\u0a1c\u0a26\u0a3e\u0a30\u0a40 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08/\u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a26\u0a40 .\u0a41\u0a30\u0a42\u0a06\u0a24 \u0a26\u0a41\u0a30\u0a2d\u0a3e\u0a35\u0a28\u0a3e\u0a2a\u0a42\u0a30\u0a28 \u0a39\u0a48\u0964 \u0a15\u0a40 \u0a2b\u0a4c\u0a1c\u0a26\u0a3e\u0a30\u0a40 \n\n6 \n \n \n2023 \u0a26\u0a3e \u0a05\u0a2a\u0a30\u0a3e\u0a3f\u0a27\u0a15 \u0a05\u0a2a\u0a40\u0a32 \u0a28\u0a70. 1025-1026  \n \n \n\u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a26\u0a41\u0a30\u0a2d\u0a3e\u0a35\u0a28\u0a3e\u0a2a\u0a42\u0a30\u0a28 \u0a38\u0a40 \u0a1c* \u0a28\u0a39J, \u0a07\u0a38 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47 \u0a3f\u0a35\u0a1a\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a5b\u0a30\u0a42\u0a30\u0a24 \u0a28\u0a39J \n\u0a39\u0a48\u0964 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a26\u0a40 \u0a38\u0a2e\u0a3e\u0a2a\u0a24\u0a40 '\u0a24\u0a47 \u0a07\u0a38' \u0a24\u0a47 \u0a3f\u0a35\u0a1a\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a5b\u0a30\u0a42\u0a30\u0a24 \u0a39\u0a48\u0964 \u0a3f\u0a15\u0a38\u0a47 \u0a35\u0a40 \u0a38\u0a3f\u0a25\u0a24\u0a40 \n\u0a3f\u0a35\u0a71\u0a1a, \u0a07\u0a38 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47, \u0a3f\u0a1c\u0a38 \u0a1a\u0a40\u0a5b '\u0a24\u0a47 \u0a3f\u0a35\u0a1a\u0a3e\u0a30 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a32\u0a4b\u0a5c \u0a39\u0a48, \u0a09\u0a39 \u0a39\u0a48 \u0a07\u0a71\u0a15 \u0a2a\u0a3f\u0a39\u0a32\u0a40 \u0a28\u0a5b\u0a30\u0a47 \n\u0a15\u0a47\u0a38 \u0a05\u0a24\u0a47 \u0a1c*\u0a1a \u0a26\u0a4c\u0a30\u0a3e\u0a28 \u0a07\u0a15\u0a71\u0a20\u0a40 \u0a15\u0a40\u0a24\u0a40 \u0a38\u0a2e\u0a71\u0a17\u0a30\u0a40, \u0a1c\u0a4b \u0a3f\u0a15 \u0a26\u0a4b.\u0a40 '\u0a24\u0a47 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a3e \u0a1a\u0a32\u0a3e\u0a09\u0a23 \u0a26\u0a40 \u0a35\u0a3e\u0a30\u0a70\u0a1f\u0a40 \n\u0a3f\u0a26\u0a70\u0a26\u0a40 \u0a39\u0a48\u0964 \n5.  \n\u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a26\u0a71\u0a38\u0a47 \u0a17\u0a0f \u0a15\u0a3e\u0a30\u0a28* \u0a26\u0a47 \u0a2e\u0a71\u0a26\u0a47\u0a28\u0a5b\u0a30, \u0a1c\u0a26/ \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a284  \n\u0a38\u0a2e\u0a41\u0a71\u0a1a\u0a40 \u0a2b\u0a4c\u0a1c\u0a26\u0a3e\u0a30\u0a40 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a2a\u0a5c\u0a3e\u0a05 '\u0a24\u0a47 .\u0a15\u0a24\u0a40\u0a06\u0a02 \u0a26\u0a40 \u0a35\u0a30\u0a24/ \u0a2c\u0a3e\u0a30\u0a47 \n\u0a2b\u0a48\u0a38\u0a3f\u0a32\u0a06\u0a02 \u0a26\u0a47 \u0a157\u0a2e \u0a3f\u0a35\u0a71\u0a1a \u0a3f\u0a21\u0a38\u0a1a\u0a3e\u0a30\u0a1c \u0a05\u0a24\u0a47/\u0a1c* \u0a05\u0a2a\u0a30\u0a3e\u0a3f\u0a27\u0a15 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a32\u0a08, \n\u0a07\u0a38 \u0a05\u0a26\u0a3e\u0a32\u0a24 \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a3f\u0a28\u0a30\u0a27\u0a3e\u0a30\u0a24 \u0a15\u0a3e\u0a28\u0a42\u0a70\u0a28 \u0a28\u0a42\u0a70 \u0a32\u0a3e\u0a17\u0a42 \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a06\u0a2a\u0a23\u0a47 \u0a05\u0a3f\u0a27\u0a15\u0a3e\u0a30 \u0a16\u0a47\u0a24\u0a30 \u0a3f\u0a35\u0a71\u0a1a \n\u0a35\u0a3e\u0a27\u0a3e \u0a15\u0a40\u0a24\u0a3e \u0a39\u0a48, \u0a39\u0a3e\u0a08 \u0a15\u0a4b\u0a30\u0a1f \u0a26\u0a41\u0a06\u0a30\u0a3e \u0a26\u0a4b.\u0a40 \u0a26\u0a47 \u0a3f\u0a35\u0a30\u0a41\u0a71\u0a27 \u0a05\u0a2a\u0a30\u0a3e\u0a3f\u0a27\u0a15 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \n\u0a32\u0a08 \u0a2a\u0a3e\u0a38 \u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a07\u0a24\u0a30\u0a3e\u0a5b\u0a2f\u0a4b\u0a17 \u0a2b\u0a48\u0a38\u0a32\u0a3e \u0a05\u0a24\u0a47 \u0a06\u0a26\u0a47. (Impugned Common \nJudgment and Order) \u0a17\u0a48\u0a30-\u0a3f\u0a1f\u0a15\u0a3e\u0a0a \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a07\u0a39 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a16\u0a3e\u0a30\u0a5b \u0a15\u0a30\u0a28 \u0a26\u0a47 \u0a2f\u0a4b\u0a17 \n\u0a39\u0a48\u0964 \n5.1  \n\u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a26\u0a47 \u0a2e\u0a71\u0a26\u0a47\u0a28\u0a5b\u0a30 \u0a05\u0a24\u0a47 \u0a09\u0a2a\u0a30\u0a4b\u0a15\u0a24 \u0a26\u0a71\u0a38\u0a47 \u0a17\u0a0f \u0a15\u0a3e\u0a30\u0a28* \u0a15\u0a30\u0a15\u0a47, \u0a2e\u0a4c\u0a1c\u0a42\u0a26\u0a3e \u0a05\u0a2a\u0a40\u0a32* \n\u0a38\u0a2b\u0a32 \u0a39\u0a41\u0a70\u0a26\u0a40\u0a06\u0a02 \u0a39\u0a28\u0964 \u0a39\u0a3e\u0a08\u0a15\u0a4b\u0a30\u0a1f \u0a35\u0a71\u0a32/ \u0a26\u0a4b.\u0a40 \u0a06\u0a30\u0a40\u0a05\u0a28 \u0a3f\u0a38\u0a70\u0a18 \u0a05\u0a24\u0a47 \u0a17\u0a4c\u0a24\u0a2e \u0a1a\u0a40\u0a2e\u0a3e \u0a26\u0a47 \u0a3f\u0a16\u0a32\u0a3e\u0a2b \n\u0a1a\u0a71\u0a32 \u0a30\u0a39\u0a40 \u0a2b\u0a4c\u0a1c\u0a26\u0a3e\u0a30\u0a40 \u0a15\u0a3e\u0a30\u0a35\u0a3e\u0a08 \u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a05\u0a24\u0a47 \u0a30\u0a71\u0a26 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a2a\u0a3e\u0a38 \u0a15\u0a40\u0a24\u0a47 \u0a17\u0a0f \n\u0a07\u0a24\u0a30\u0a3e\u0a5b\u0a2f\u0a4b\u0a17  \u0a38*\u0a1d\u0a47 \u0a2b\u0a48\u0a38\u0a32\u0a47 \u0a05\u0a24\u0a47 \u0a39\u0a41\u0a15\u0a2e (Impugned Common Judgment and Order)  \n\u0a28\u0a42\u0a70 \u0a30\u0a71\u0a26 \u0a15\u0a30 \u0a3f\u0a26\u0a71\u0a24\u0a3e \u0a1c*\u0a26\u0a3e \u0a39\u0a48 \u0a05\u0a24\u0a47 \u0a16\u0a3e\u0a30\u0a5b \u0a15\u0a40\u0a24\u0a3e \u0a1c*\u0a26\u0a3e \u0a39\u0a48\u0964 \u0a26\u0a4b\u0a36\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a26\u0a3e \u0a38\u0a3e\u0a39\u0a2e\u0a23\u0a3e \n\u0a15\u0a30\u0a28\u0a3e \u0a2a\u0a35\u0a47\u0a17\u0a3e \u0a3f\u0a1c\u0a38 \u0a32\u0a08 \u0a09\u0a28\u001b * \u0a28\u0a42\u0a70 \u0a1a\u0a3e\u0a30\u0a1c.\u0a40\u0a1f \u0a15\u0a40\u0a24\u0a3e \u0a3f\u0a17\u0a06 \u0a39\u0a48\u0964 \u0a39\u0a3e\u0a32*\u0a3f\u0a15, \u0a07\u0a39 \u0a26\u0a47\u0a3f\u0a16\u0a06 \n\u0a3f\u0a17\u0a06 \u0a39\u0a48 \u0a3f\u0a15 \u0a2e\u0a41\u0a15\u0a71\u0a26\u0a2e\u0a47 \u0a26\u0a40 \u0a38\u0a41\u0a23\u0a35\u0a3e\u0a08 \u0a26\u0a4c\u0a30\u0a3e\u0a28 \u0a2e\u0a3e\u0a23\u0a2f\u0a4b\u0a