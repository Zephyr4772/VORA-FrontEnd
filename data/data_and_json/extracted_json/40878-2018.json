    "full_text": "\u0905  - \u092a\u094d\u0930\u0924\u093f\u0005\u0935\u0947\u0926\u094d\u092f\n \n \n\u092d\u093e\u0930\u0005\u0940\u092f \u0938\u0935\u000f\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \n\u0938\u093f\u0938\u0935\u093f\u0935\u0932 \u0905\u092a\u0940\u0932\u0940\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924\u093f\u001a\u0915\u093e\u0930\n\u0938\u093f\u0938\u0935\u093f\u0935\u0932 \u0905\u092a\u0940\u0932 \u0938\u0902\u0916\u094d\u092f\u093e \n \n - 325/2021\n \n \n\u0930\u093e\u091c\u0947\u0936 \u0915\u0941\u092e\u093e\u0930 \u0938\u093f\u0902\u0938\u0939 \u0914\u0930 \u0905\u0928\u094d\u092f\n ...... \u0905\u092a\u0940\u0932\u093e\u0930\u094d\u0925\u0940$ (\u0917\u0923)\n\u092c\u0928\u093e\u092e\n\u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u0914\u0930 \u0905\u0928\u094d\u092f\n ........\u092a\u094d\u0930\u0924\u094d\u092f\u0930\u094d\u0925\u0940$(\u0917\u0923)\n\u0935\u093f\u0928\u0923.\u092f\n\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0005 \u090f\u0932\n \n .   \u0928\u093e\u0917\u0947\u0936\u094d\u0935\u0930 \u0930\u093e\u0935\n \n , \n1. \u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0915\u094b \u092a\u094d\u0930\u093e\u0930\u092e\u094d\u092d \u092e\u0947\u0902 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 \u0906\u0930\u0915\u094d\u0937\u0940 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u092f\u093e\n\u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e\u0964 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u092a\u0926\u094b\u0902 \u0915\u094b \u092d\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f \u091c\u093e\u0930\u0940 \u090f\u0915 \u0935\u093f\u0935\u091c\u094d\u091e\u093e\u092a\u0928 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930,\n\u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0928\u0947 \u091a\u092f\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u092d\u093e\u0917 \u0932\u093f\u0932\u092f\u093e\u0964 \u0935\u0947 \u091a\u092f\u0935\u093f\u0928\u0005 \u0935\u093f\u0915\u092f\u0947 \u0917\u092f\u0947 \u0914\u0930 \u092a\u094d\u0930\u0936\u093f\u0936\u0915\u094d\u0937\u0923 \u092a\u0942\u0930\u093e\n\u0939\u094b\u0928\u0947 \u092a\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e\u0964 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\u094b \u0915\u0940\nvLohdj.k\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; m\u00eds'; ds fy;s iz;ksx\nugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk\nfu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n\n\u0935\u0930\u093f\u0930\u0937\u094d\u0920\u0005\u093e \u0938\u0942\u091a\u0940 14.05.2015 \u0915\u094b \u0005\u0948\u092f\u093e\u0930 \u0915\u0940 \u0917\u0908 \u0930\u094d\u0925\u0940\u0940\u0964 \u0936\u093e\u0938\u0928\u093e\u0926\u0947\u0936\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u001a\u0902\u0928 \u0915\u0930\u0005\u0947\n\u0939\u0941\u090f, \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u0928\u0947 \u092a\u0941\u0932\u093f\u0932\u0938 \u0905\u0924\u093f\u001a\u0935\u093f\u0928\u092f\u092e, 1861 \u0915\u0940 \u001a\u093e\u0930\u093e 46 (11) \u0915\u0947 \u0938\u093e\u0930\u094d\u0925\u0940 \u092a\u0935\u093fF\u0005\n\u001a\u093e\u0930\u093e 2 \u0915\u0947 \u0005\u0939\u0005 \u0936\u0935\u093f\u0915\u094d\u0924 \u0915\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0005\u0947 \u0939\u0941\u090f \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u092a\u0941\u0932\u093f\u0932\u0938 \u092e\u094b\u091f\u0930 \u092a\u0930\u093f\u0930\u0935\u0939\u0928 \u0907\u0915\u093e\u0908\n\u0905\u001a\u0940\u0928\u0938\u094d\u0930\u094d\u0925\u0940 \u0905\u0924\u093f\u001a\u0915\u093e\u0930\u0940 \u0938\u0947\u0935\u093e \u0935\u093f\u0928\u092f\u092e, 2015 (\u0907\u0938\u0915\u0947 \u092c\u093e\u0926, '2015 \u0935\u093f\u0928\u092f\u092e\u093e\u0935\u0932\u0940') \u0915\u093e \u0935\u093f\u0928\u092e\u093e.\u0923\n\u0935\u093f\u0915\u092f\u093e,  \u0938\u093f\u091c\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0941\u0932\u093f\u0932\u0938 \u0935\u093f\u0935\u092d\u093e\u0917 \u0915\u0940 \u092e\u094b\u091f\u0930 \u092a\u0930\u093f\u0930\u0935\u0939\u0928 \u0907\u0915\u093e\u0908 \u0915\u0947 \u091a\u092f\u0928,  \u092a\u0926\u094b\u0928\u094d\u0928\u0924\u093f\u0005,\n\u092a\u094d\u0930\u0936\u093f\u0936\u0915\u094d\u0937\u0923,  \u0935\u093f\u0928\u092f\u0941\u0935\u093f\u0915\u094d\u0924,  \u092f\u094b\u0917\u094d\u092f\u0005\u093e \u0906\u0935\u093f\u0926 \u0914\u0930 \u0938\u0947\u0935\u093e \u0915\u0940 \u0905\u0928\u094d\u092f \u0936\u0005M \u0915\u094b \u0935\u093f\u0928\u092f\u0902\u0935\u093f\u0924\u094d\u0930\u0005 \u0935\u093f\u0915\u092f\u093e\n\u091c\u093e\u092f\u0947\u0917\u093e\u0964 \u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915,  \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f.,  \u0909\u092a-\u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915,  \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f.,  \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940,\n\u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f., \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0914\u0930 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u092a\u0926 \u092a\u0930 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f.\n\u0905\u001a\u0940\u0928\u0938\u094d\u0930\u094d\u0925\u0940 \u0938\u0947\u0935\u093e \u0915\u0947 \u0915\u0948\u0921\u0930 \u0915\u0947 \u0005\u0939\u0005 \u0917F\u0928 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e  \u0939\u0948\u0902\u0964 2015 \u0915\u0947 \u0935\u093f\u0928\u092f\u092e\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930\n\u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u093e \u092a\u0926 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\u094b\u0902 \u0914\u0930 \u0906\u0930\u0915\u094d\u0937\u0940\n\u091a\u093e\u0932\u0915\u094b\u0902 \u0938\u0947 \u091a\u092f\u0928 \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092d\u0930\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u092a\u0926 \u092a\u0930\n\u0935\u093f\u0928\u092f\u0941\u0935\u093f\u0915\u094d\u0924 \u0915\u0947 \u0932\u093f\u0932\u090f \u091a\u092f\u0928 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u093f\u0928\u092f\u092e\u094b\u0902 \u0938\u0947 \u0935\u094d\u092f\u0936\u093f\u0930\u094d\u0925\u0940\u0005 \u0939\u094b\u0915\u0930, \u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0928\u0947\n\u0907\u0932\u093e\u0939\u093e\u092c\u093e\u0926 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u0947\u0902 \u090f\u0915 \u0930\u093f\u0930\u091f \u092f\u093e\u0924\u093f\u091a\u0915\u093e \u0926\u093e\u092f\u0930 \u0915\u0940\u0964 24.10.2017 \u0935\u093f\u0926\u0928\u093e\u0902\u0935\u093f\u0915\u0005 \u0915\u0947\n\u090f\u0915 \u0935\u093f\u0928\u0923.\u092f \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e,  \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0930\u093f\u0930\u091f \u092f\u093e\u0924\u093f\u091a\u0915\u093e \u0915\u094b \u0916\u093e\u0930\u093f\u0930\u091c \u0915\u0930 \u0935\u093f\u0926\u092f\u093e\u0964 \u0909\u091a\u094d\u091a\n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u092b\u0948\u0938\u0932\u0947 \u0938\u0947 \u0905\u0938\u0902\u0005\u0941\u0937\u094d\u091f, \u0905\u092a\u0940\u0932\u0915\u0005\u093e. \u0907\u0938 \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u0915\u094d\u0937 \u0909\u092a\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0005 \u0939\u0941\u090f\n\u0939\u0948\u0902\u0964\n2. \u0905\u092a\u0940\u0932\u0915\u0005\u093e. \u0915\u0947 \u0932\u093f\u0932\u090f \u0909\u092a\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0005 \u0935\u0930\u093f\u0930\u0937\u094d\u0920 \u0935\u093f\u0935\u0926\u094d\u0935\u0005 \u0905\u0924\u093f\u001a\u0935\u0915\u094d\u0924\u093e \u0936\u094d\u0930\u0940 \u0935\u0940. \u0936\u0947\u0916\u0930 \u0928\u0947 \u0926\u0932\u0940\u0932\n\u0935\u093f\u0926\u092f\u093e \u0935\u093f\u0915 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\u094b\u0902 \u0915\u094b \u092a\u0926\u094b\u0928\u094d\u0928\u0924\u093f\u0005 \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u090a\u0930\u094d\u0927\u094d\u0935\u093e\u0935\u093e.\u001a\u0930 \u092a\u0930\u093f\u0930\u0935\u0005.\u0928\u0940\u092f\u0005\u093e \u092e\u0941\u0916\u094d\u092f\n\u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u0930\u0942\u092a \u092d\u0930\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0909\u0938\u0915\u0947 \u092c\u093e\u0926, \u0935\u0930\u093f\u0930\u0937\u094d\u0920\u0005\u093e \u0915\u0947 \u0906\u001a\u093e\u0930 \u092a\u0930\n\u0909\u092a-\u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915 \u0914\u0930 \u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915 \u092e\u094b\u091f\u0930 \u092a\u0930\u093f\u0930\u0935\u0939\u0928 \u0915\u0947 \u092a\u0926\u094b \u0915\u094b \u092d\u0930\u093e \u091c\u093e\u092f\u0947\u0917\u093e\u0964 \u0938\u093f\u091c\u0928\n\u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0915\u094b \u0936\u0941\u0930\u0942 \u092e\u0947\u0902 \u092a\u0941\u0932\u093f\u0932\u0938 \u0906\u0930\u0915\u094d\u0937\u0940 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092d\u0005$ \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0930\u094d\u0925\u0940\u093e,  \u0935\u0947\n\u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u091a\u093e\u0932\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f \u090f\u0915 \u091a\u092f\u0928 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0938\u0947 \u0917\u0941\u091c\u0930\u0947\u0964 \u0906\u0930\u0915\u094d\u0937\u0940\n\u091a\u093e\u0932\u0915\u094b \u0914\u0930 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u093e\u0915\u094b\u0902 \u0915\u094b \u0935\u093f\u0935\u091a\u093e\u0930\u0923 \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u093e\u0924\u094d\u0930 \u092c\u0928\u093e\u0915\u0930 \u0906\u0930\u0915\u094d\u0937\u0940\n\u091a\u093e\u0932\u0915 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0915\u090f \u091c\u093e\u0928\u0947 \u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0938\u0947 \u090f\u0915 \u0914\u0930 \u091a\u092f\u0928\nvLohdj.k\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; m\u00eds'; ds fy;s iz;ksx\nugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk\nfu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n\n\u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0915\u093e \u092a\u0930\u093f\u0930\u091a\u092f \u092e\u0928\u092e\u093e\u0928\u093e \u0914\u0930 \u092d\u093e\u0930\u0005 \u0915\u0947 \u0938\u0902\u0935\u093f\u0935\u001a\u093e\u0928 \u0915\u0947 \u0905\u0928\u0941\u091a\u094d\u091b\u0947\u0926 14 \u0914\u0930 16 \u0915\u093e\n\u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0939\u0948\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0939\u093e \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u0915\u0005\u093e. \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0938\u0947 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u092a\u0926 \u092a\u0930\n\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964\n3. \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0930\u093e\u091c\u094d\u092f \u0915\u0940 \u0913\u0930 \u0938\u0947 \u0909\u092a\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0005 \u0935\u093f\u0935\u0926\u094d\u0935\u0005 \u0905\u0924\u093f\u001a\u0935\u0915\u094d\u0924\u093e \u0938\u0941\u0936\u094d\u0930\u0940 \u0917\u0930\u093f\u0930\u092e\u093e \u092a\u094d\u0930\u0938\u093e\u0926 \u0928\u0947\n\u0005\u0915.  \u0935\u093f\u0926\u092f\u093e \u0935\u093f\u0915 \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u091a\u093e\u0932\u0915 \u0915\u093e \u092a\u0926 \u090f\u0915 \u0005\u0915\u0928\u0940\u0915\u0940 \u092a\u0926 \u0939\u0948 \u0914\u0930 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940\n\u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f., \u0938\u092c-\u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0914\u0930 \u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u092a\u0926\n\u0905\u0924\u094d\u092f\u0924\u093f\u001a\u0915 \u0005\u0915\u0928\u0940\u0915\u0940 \u0939\u0948\u0902\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0939\u093e \u0935\u093f\u0915 \u090f\u0915 \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u0915\u094b \u090f\u0915 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\n\u092c\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f \u091a\u092f\u0928 \u0915\u0940 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0938\u0947 \u0917\u0941\u091c\u0930\u0928\u093e \u092a\u0921\u093c\u0005\u093e \u0939\u0948\u0964 \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u091a\u093e\u0932\u0915\u094b \u0915\u0940 \u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0930\u0005\u093e\n\u0915\u094b \u0926\u0942\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f, \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u0915\u0908 \u092a\u0926 \u0938\u0943\u0938\u093f\u091c\u0005 \u0935\u093f\u0915\u090f \u0917\u090f \u0939\u0948\u0902\u0964 \u0939\u093e\u0932\u093e\u0902\u0935\u093f\u0915,\n\u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f., \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0914\u0930 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u092a\u0926 \u092a\u0930\n\u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f, \u091c\u094b \u0935\u093f\u0935\u091a\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092f\u094b\u0917\u094d\u092f \u0939\u0948\u0902, \u0909\u0928\u094d\u0939\u0947\u0902 \u091a\u092f\u0928 \u0915\u0940 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0938\u0947 \u0917\u0941\u091c\u0930\u0928\u093e\n\u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0926, \u0935\u0947 \u0935\u0930\u093f\u0930\u0937\u094d\u0920\u0005\u093e \u0915\u0947 \u0906\u001a\u093e\u0930 \u092a\u0930 \u0909\u092a-\u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915 \u092e\u094b\u091f\u0930 \u092a\u0930\u093f\u0930\u0935\u0939\u0928\n\u0914\u0930 \u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u092e\u094b\u091f\u0930 \u092a\u0930\u093f\u0930\u0935\u0939\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0926\u094b\u0928\u094d\u0928\u0924\u093f\u0005 \u0915\u0947 \u0932\u093f\u0932\u090f \u0935\u093f\u0935\u091a\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0939\u0915\u0926\u093e\u0930\n\u0939\u094b\u0902\u0917\u0947\u0964 \u0909\u0938\u0928\u0947 \u0005\u0915.  \u0935\u093f\u0926\u092f\u093e \u0935\u093f\u0915 \u0935\u0005.\u092e\u093e\u0928 \u092e\u0947\u0902 \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 12,000 \u092a\u0926 \u0939\u0948\u0902\u0964 2498\n\u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 \u092a\u0926 \u0938\u0943\u0938\u093f\u091c\u0005 \u0935\u093f\u0915\u090f \u0917\u090f \u0939\u0948\u0902, \u0938\u093f\u091c\u0928\u0915\u0947 \u0932\u093f\u0932\u090f \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u091a\u093e\u0932\u0915\n\u0935\u0930\u093f\u0930\u0937\u094d\u0920\u0005\u093e \u0915\u0947 \u0906\u001a\u093e\u0930 \u092a\u0930 \u092a\u0926\u094b\u0928\u094d\u0928\u0924\u093f\u0005 \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u093e\u0924\u094d\u0930 \u0939\u0948\u0902\u0964 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947\n\u0915\u0947\u0935\u0932 283 \u092a\u0926 \u0939\u0948\u0902 \u091c\u094b \u090f\u0915 \u0909\u091a\u094d\u091a \u0005\u0915\u0928\u0940\u0915\u0940 \u092a\u0926 \u0939\u0948 \u0938\u093f\u091c\u0938\u0947 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\u094b \u0905\u0948\u0930 \u092e\u0941\u0916\u094d\u092f\n\u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\u094b\u0902 \u0938\u0947 \u091a\u092f\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u092d\u0930\u093e \u091c\u093e \u0938\u0915\u0005\u093e \u0939\u0948\u0964 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\u094b \u0905\u0948\u0930 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940\n\u091a\u093e\u0932\u0915\u094b\u0902 \u0915\u0940 \u091a\u093f\u0902\u091a\u0005\u093e \u0915\u094b \u0938\u092e\u094d\u092c\u094b\u0924\u093f\u001a\u0005 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f, \u0938\u093f\u091c\u0928\u094d\u0939\u0947\u0902 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f.\n\u0915\u0947 \u092a\u0926 \u092a\u0930 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0935\u093f\u0915 \u092a\u0926\u094b\u0928\u094d\u0928\u0924\u093f\u0005 \u0915\u0947 \u0932\u093f\u0932\u090f \u0915\u094b\u0908 \u0930\u093e\u0938\u094d\u0005\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0909\u092a-\n\u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 1000 \u092a\u0926 \u0938\u0943\u0938\u093f\u091c\u0005 \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u0938\u094d\u0005\u093e\u0935 \u0939\u0948\u0964 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915\n\u0938\u092c-\u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 \u092a\u0926 \u092a\u0930 \u092a\u0926\u094b\u0928\u094d\u0928\u0005 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0939\u0915\u0926\u093e\u0930 \u0939\u094b\u0902\u0917\u0947\u0964\nvLohdj.k\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; m\u00eds'; ds fy;s iz;ksx\nugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk\nfu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n\n4. 2015 \u0915\u0947 \u0935\u093f\u0928\u092f\u092e\u094b\u0902 \u092e\u0947\u0902 \u090f\u0915 \u0915\u0948\u0921\u0930 \u0939\u0948 \u0938\u093f\u091c\u0938\u092e\u0947\u0902 9126 \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u0921\u094d\u0930\u093e\u0907\u0935\u0930, 1098 \u092e\u0941\u0916\u094d\u092f\n\u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915, 283 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f., 99 \u0938\u092c-\u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f.\n\u0914\u0930 9 \u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0936\u093e\u0935\u093f\u092e\u0932 \u0939\u0948\u0902\u0964 \u0935\u093f\u0928\u092f\u092e 5 (\u0938\u0940) \u0938\u093f\u091c\u0938\u0947 \u0930\u093f\u0930\u091f \u092f\u093e\u0924\u093f\u091a\u0915\u093e \u092e\u0947\u0902\n\u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u091a\u0941\u0928\u094c\u0005\u0940 \u0926\u0940 \u0917\u0908 \u0939\u0948, \u092a\u094d\u0930\u093e\u0935\u001a\u093e\u0935\u093f\u0928\u0005 \u0915\u0930\u0005\u093e \u0939\u0948 \u0935\u093f\u0915 \u0935\u093f\u0928\u092f\u092e\u094b\u0902 \u0915\u0947 \u092a\u0930\u093f\u0930\u0936\u093f\u0936\u0937\u094d\u091f \u092e\u0947\u0902\n\u0935\u093f\u0928\u001a\u093e.\u0930\u093f\u0930\u0005 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0906\u0948\u0930 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u092c\u0940\u091a\n\u091a\u092f\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u092a\u0926 \u092a\u0930 \u0935\u093f\u0928\u092f\u0941\u0935\u093f\u0915\u094d\u0924 \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u0935\u093f\u0915\u092f\u093e \u0915\u0947 \u092c\u093e\u0930\u0947\n\u092e\u0947\u0902 \u092c\u0005\u093e\u0005\u093e \u0939\u0948\u0964 \u0935\u093f\u0928\u092f\u092e 10 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u0915\u0947 \u092a\u0926 \u092a\u0930 \u091a\u092f\u0928 \u0914\u0930 \u0935\u093f\u0928\u092f\u0941\u0935\u093f\u0915\u094d\u0924 \u0915\u0947 \u0932\u093f\u0932\u090f \u092a\u094d\u0930\u0935\u093fY\u092f\u093e\n\u0935\u093f\u0928\u001a\u093e.\u0930\u093f\u0930\u0005 \u0915\u0930\u0005\u093e \u0939\u0948 \u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0915\u0940 \u092e\u0941\u0916\u094d\u092f \u0936\u093f\u0936\u0915\u093e\u092f\u0005 \u092f\u0939 \u0939\u0948 \u0935\u093f\u0915 \u0935\u0947 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940\n\u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u092a\u0942\u0935. \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0005(Lateral Movement) \u091a\u092f\u0928 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e\n\u0938\u0947 \u0917\u0941\u091c\u0930 \u091a\u0941\u0915\u0947 \u0939\u0948\u0902\u0964 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u092a\u0926 \u092a\u0930 \u0935\u093f\u0928\u092f\u0941\u0935\u093f\u0915\u094d\u0924 \u0915\u0947 \u0932\u093f\u0932\u090f \u0909\u0928\u094d\u0939\u0947\u0902 \u090f\u0915\n\u0914\u0930 \u091a\u092f\u0928 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0938\u0947 \u0917\u0941\u091c\u093e\u0930\u0928\u093e \u0905\u0928\u0941\u0924\u093f\u091a\u0005 \u0939\u0948\u0964 \u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930,  \u0938\u092d\u0940\n\u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u0921\u094d\u0930\u093e\u0907\u0935\u0930 \u0935\u093f\u0915\u0938\u0940 \u092d\u0940 \u091a\u092f\u0928 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0938\u0947 \u0917\u0941\u091c\u0930\u0928\u0947 \u0915\u0947 \u0935\u093f\u092c\u0928\u093e \u0935\u0930\u093f\u0930\u0937\u094d\u0920\u0005\u093e \u0915\u0947 \u0906\u001a\u093e\u0930 \u092a\u0930\n\u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u092f\u093e \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0926\u094b\u0928\u094d\u0928\u0005 \u0939\u094b\u0928\u0947 \u0915\u0947\n\u092f\u094b\u0917\u094d\u092f \u0939\u094b\u0928\u0947 \u091a\u093e\u0935\u093f\u0939\u090f\u0964 \u0935\u093f\u0928\u092f\u092e\u094b\u0902 \u0915\u0947 \u092a\u0930\u093f\u0930\u0936\u093f\u0936\u0937\u094d\u091f \u0915\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0915\u0930\u0005\u0947 \u0939\u0941\u090f, \u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0928\u0947 \u092a\u094d\u0930\u0938\u094d\u0005\u0941\u0005\n\u0935\u093f\u0915\u092f\u093e \u0935\u093f\u0915 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u092a\u0930\u093f\u0930\u0935\u0939\u0928 \u0915\u093e \u092a\u0926 \u092c\u0939\u0941\u0005 \u0905\u0924\u093f\u001a\u0915 \u0005\u0915\u0928\u0940\u0915\u0940 \u092a\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964\n5. \u0915\u0948\u0921\u0930 \u0915\u0940 \u0938\u0902\u0930\u091a\u0928\u093e \u0938\u0947 \u092f\u0939 \u0938\u094d\u092a\u0937\u094d\u091f \u0939\u0948 \u0935\u093f\u0915 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u0915\u0947\u0935\u0932 283\n\u092a\u0926 \u0939\u0948\u0902 \u091c\u094b \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u090f\u0915 \u0909\u091a\u094d\u091a \u0005\u0915\u0928\u0940\u0915\u0940 \u092a\u0926 \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0902\u0935\u093f\u0915 \u0909\u0915\u094d\u0924 \u092a\u0926 \u092e\u0947\u0902 \u092e\u0941\u0916\u094d\u092f\n\u0906\u0930\u0915\u094d\u0937\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 \u0938\u092e\u093e\u0928 \u0935\u0947\u0005\u0928\u092e\u093e\u0928 \u0939\u0948, \u0932\u0947\u0935\u093f\u0915\u0928 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u0930\u0942\u092a\n\u092e\u0947\u0902 \u092a\u0942\u0935. \u0906\u0915\u094d\u0937\u0947\u0935\u093f\u092a\u0005 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u092a-\u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915 \u092e\u094b\u091f\u0930 \u092a\u0930\u093f\u0930\u0935\u0939\u0928 \u0914\u0930 \u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915 \u092e\u094b\u091f\u0930\n\u092a\u0930\u093f\u0930\u0935\u0939\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u090a\u0930\u094d\u0927\u094d\u0935\u093e\u0935\u093e.\u001a\u0930 \u0905\u0938\u094d\u0925\u093f\u0938\u094d\u0930\u094d\u0925\u0940\u0930\u0005\u093e \u0915\u093e \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0917\u093e\u0964 \u091a\u093e\u0932\u0915\u094b\u0902 \u0915\u0940\n\u091a\u093f\u0902\u091a\u0005\u093e\u0913\u0902 \u0915\u094b \u0938\u0902\u092c\u094b\u0924\u093f\u001a\u0005 \u0915\u0930\u0005\u0947 \u0939\u0941\u090f, \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 1098 \u092a\u0926 \u0938\u0943\u0938\u093f\u091c\u0005 \u0935\u093f\u0915\u090f \u0917\u090f\n\u0939\u0948\u0902 \u0914\u0930 \u0909\u092a-\u0935\u093f\u0928\u0930\u0940\u0915\u094d\u0937\u0915 \u0921\u094d\u0930\u093e\u0907\u0935\u0930\u094b\u0902 \u0915\u0947 1000  \u092a\u0926 \u0938\u0943\u0938\u093f\u091c\u0005 \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u0938\u094d\u0005\u093e\u0935 \u0939\u0948\u0964 \u092e\u0941\u0916\u094d\u092f\n\u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0914\u0930 \u0938\u092c-\u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u091a\u093e\u0932\u0915 \u0915\u0947 \u092a\u0926 \u0935\u0930\u093f\u0930\u0937\u094d\u0920\u0005\u093e \u0915\u0947 \u0906\u001a\u093e\u0930 \u092a\u0930 \u092a\u0926\u094b\u0928\u094d\u0928\u0924\u093f\u0005\n\u0926\u094d\u0935\u093e\u0930\u093e \u092d\u0930\u0947 \u091c\u093e\u0005\u0947 \u0939\u0948\u0902\u0964\nvLohdj.k\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; m\u00eds'; ds fy;s iz;ksx\nugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk\nfu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n\n6. 2015 \u0915\u0947 \u0935\u093f\u0928\u092f\u092e\u094b\u0902 \u0915\u0947 \u0935\u093f\u0928\u092f\u092e 5 \u0914\u0930 10 \u0915\u094b \u092e\u0941\u0916\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0907\u0938 \u0906\u001a\u093e\u0930 \u092a\u0930 \u091a\u0941\u0928\u094c\u0005\u0940 \u0926\u0940\n\u0917\u0908 \u0939\u0948 \u0935\u093f\u0915 \u0905\u092a\u0940\u0932\u0915\u0005\u093e.\u0913\u0902 \u0915\u094b \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u092a\u0926 \u092a\u0930 \u0935\u093f\u0928\u092f\u0941\u0935\u093f\u0915\u094d\u0924 \u0915\u0947\n\u0932\u093f\u0932\u090f \u090f\u0915 \u091a\u092f\u0928 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0938\u0947 \u0917\u0941\u091c\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u0932\u090f \u092e\u091c\u092c\u0942\u0930 \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u0005\u093e \u0939\u0948\u0964 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940\n\u092e\u094b\u091f\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u0909\u091a\u094d\u091a \u0005\u0915\u0928\u0940\u0915\u0940 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u091a\u092f\u0928 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0905\u0935\u093f\u0928\u0935\u093e\u092f. \u0939\u0948\u0964 \u0935\u093f\u0928\u092f\u092e \u0928\n\u0005\u094b \u092d\u0947\u0926\u092d\u093e\u0935\u092a\u0942\u0923. \u0939\u0948\u0902 \u0914\u0930 \u0928 \u0939\u0940 \u092e\u0928\u092e\u093e\u0928\u0947 \u0939\u0948\u0902\u0964 \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u094b \u0935\u0930\u093f\u0930\u0937\u094d\u0920\u0005\u093e \u0915\u0947 \u0906\u001a\u093e\u0930 \u092a\u0930\n\u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u091a\u093e\u0932\u0915 \u0915\u094b \u092a\u0926\u094b\u0928\u094d\u0928\u0005 \u0935\u093f\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0005\u093e \u0939\u0948\u0964 \u092f\u0935\u093f\u0926 \u0935\u0947 \u092e\u0941\u0916\u094d\u092f \u0906\u0930\u0915\u094d\u0937\u0940 \u092e\u094b\u091f\u0930\n\u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u091f. \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u093f\u0928\u092f\u0941\u0915\u094d\u0924 \u0939\u094b\u0928\u0947 \u0915\u0940 \u0907\u091a\u094d\u091b\u093e \u0930\u0916\u0005\u0947 \u0939\u0948\u0902, \u0005\u094b \u0909\u0928\u094d\u0939\u0947\u0902 \u091a\u092f\u0928 \u092a\u094d\u0930\u0935\u093fY\u092f\u093e \u0938\u0947 \u0917\u0941\u091c\u0930\u0928\u093e\n\u0939\u094b\u0917\u093e\u0964 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0935\u093f\u0928\u0923.\u092f \u092e\u0947\u0902 \u0915\u094b\u0908 \u0939\u0938\u094d\u0005\u0915\u094d\u0937\u0947\u092a \u0928\u0939\u0940\u0902 \u0935\u093f\u0915\u092f\u093e \u091c\u093e\u0005\u093e \u0939\u0948\u0964\n7. \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0935\u093f\u0928\u0923.\u092f \u0915\u094b \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0905\u092a\u0940\u0932 \u0915\u094b \u0005\u0926\u0928\u0941\u0938\u093e\u0930\n\u0916\u093e\u0930\u093f\u0930\u091c \u0915\u0930 \u0935\u093f\u0926\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964\n[\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0005 \u090f\u0932. \u0928\u093e\u0917\u0947\u0936\u094d\u0935\u0930 \u0930\u093e\u0935]\n[\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u093f\u0005 \u0907\u0902\u0935\u093f\u0926\u0930\u093e \u092c\u0928\u091c$] \n  \u0928\u0908 \u0935\u093f\u0926\u0932\u094d\u0932\u0940,\n18 \u092b\u0930\u0935\u0930\u0940, 2021\nvLohdj.k\n\u00de{ks=h; Hkk\"kk esa vuqokfnr fu.kZ; oknh ds viuh Hkk\"kk esa le>us gsrq fufcZa/kr iz;ksx ds fy;s gS vkSj fdlh vU; m\u00eds'; ds fy;s iz;ksx\nugh fd;k tk ldrk gSA lHkh O;kogkfjd vkSj ljdkjh m\u00eds';ksa ds fy;s] fu.kZ; dk vaxzsth  laLdj.k izkekf.kd ekuk tk;sxk rFkk\nfu\"iknu vkSj fdz;kUo;u ds m\u00eds';ksa ds fy;s ekU; gksxk\u00dfA\n"
