\u0d33 \u0d2e\u0d31\u0d4d\u0d31\u0d46\u0d23\u0d4d \u0d06\u0d28\u0d41\u0d15\u0d42\u0d32\u0d28\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d41\u0d2a\u0d4d\u0d30\u0d40\u0d02\n\u0d05\u0d2a\u0d24\u0d40\u0d7d\u0d35\u0d2d\u0d3e\u0d26\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d23\u0d4d \u0d05\u0d35\u0d15\u0d2d\u0d3e\u0d36\u0d2e\u0d41\u0d23\u0d23\u0d4d.  L.A.R  \u0d28\u0d2e\u0d4d\u0d2a\u0d7c 22/97,  L.A.R.  \u0d28\u0d2e\u0d4d\u0d2a\u0d7c 25/97  \u0d1c\u0d32\n\u0d05\u0d35\u0d15\u0d2d\u0d3e\u0d36\u0d35\u0d2d\u0d3e\u0d26\u0d24\u0d3f\u0d15\u0d33\u0d2d\u0d3e\u0d2f \u0d05\u0d2a\u0d24\u0d40\u0d7d\u0d35\u0d2d\u0d3e\u0d26\u0d24\u0d3f\u0d2f\u0d1c\u0d1f \u0d2a\u0d24\u0d3f\u0d24\u0d2d\u0d3e\u0d35\u0d24\u0d3f\u0d28\u0d41\u0d2a\u0d4d\u0d30\u0d40\u0d02 \u0d38\u0d15\u0d39\u0d2d\u0d3e\u0d26\u0d30\u0d28\u0d41\u0d2a\u0d4d\u0d30\u0d40\u0d02 \u0d28\u0d7d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d05\u0d15\u0d24\n\u0d28\u0d24\u0d3f\u0d30\u0d15\u0d4d\u0d15\u0d24\u0d3f\u0d7d \u0d05\u0d2a\u0d24\u0d40\u0d7d\u0d35\u0d2d\u0d3e\u0d26\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d2a\u0d4d\u0d30\u0d40\u0d02 \u0d2a\u0d32\u0d24\u0d3f\u0d36\u0d2f\u0d23\u0d4d \u0d05\u0d7c\u0d39\u0d24\u0d2f\u0d23\u0d23\u0d4d. \n17.\u0d15\u0d2e\u0d7d\u0d2a\u0d31\u0d1e \u0d28\u0d24\u0d3f\u0d2c\u0d28\u0d28\u0d15\u0d33\u0d24\u0d3f\u0d7d,\n \u0d1c\u0d1a\u0d47\u0d32\u0d35\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d23\u0d4d \u0d09\u0d24\u0d30\u0d35\u0d15\u0d33\u0d24\u0d3f\u0d32\u0d4d\u0d32\u0d47\u0d2d\u0d3e\u0d1c\u0d24 \u0d05\u0d2a\u0d24\u0d40\u0d7d\n\u0d05\u0d28\u0d41\u0d35\u0d26\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.  \u0d31\u0d2b\u0d31\u0d7b\u0d38\u0d23\u0d4d \u0d15\u0d15\u0d2d\u0d3e\u0d1f\u0d24\u0d24\u0d3f\u0d2f\u0d1c\u0d1f \u0d35\u0d24\u0d3f\u0d27\u0d24\u0d3f\u0d2f\u0d2a\u0d4d\u0d30\u0d40\u0d02 \u0d39\u0d39\u0d15\u0d15\u0d4d\u0d15\u0d2d\u0d3e\u0d1f\u0d24\u0d24\u0d3f\u0d2f\u0d1c\u0d1f \u0d35\u0d24\u0d3f\u0d27\u0d24\u0d3f\u0d2f\u0d2a\u0d4d\u0d30\u0d40\u0d02\n\u0d31\u0d26\u0d2d\u0d3e\u0d15\u0d4d\u0d15\u0d24\u0d3f\u0d2f\u0d24\u0d3f\u0d30\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.\n\u0d24\u0d24\u0d40\u0d7c\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7d\u0d2a\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d2d\u0d3e\u0d24 \u0d05\u0d15\u0d2a\u0d15\u0d15\u0d7e \u0d09\u0d1c\u0d23\u0d19\u0d24\u0d3f\u0d7d \u0d06\u0d2f\u0d35 \u0d24\u0d24\u0d40\u0d7c\u0d2a\u0d2d\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41.\n.............................. J.\n    (\u0d07\u0d28\u0d4d\u0d26\u0d41 \u0d2e\u0d7d\u0d15\u0d39\u0d2d\u0d3e\u0d24)\n............................... J.\n    (\u0d05\u0d1c\u0d2f\u0d23\u0d4d \u0d31\u0d15\u0d38\u0d2d\u0d3e\u0d17\u0d24\u0d3f)\n\u0d2e\u0d2d\u0d3e\u0d7c\u0d1a\u0d23\u0d4d 2, 2021\n\u0d28\u0d28\u0d4d\u0d2f\u0d42 \u0d1c\u0d21\u0d7d\u0d39\u0d24\u0d3f\n\u0d2c\u0d2c\u0d3e\u0d26\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d24\u0d2c\u0d3e \u0d28\u0d28\u0d3f\u0d30\u0d2c\u0d3e\u0d15\u0d30\u0d23\u0d23:   \u0d2a\u0d2c\u0d3e\u0d26\u0d26\u0d47\u0d36\u0d28\u0d3f\u0d15 \u0d2d\u0d2c\u0d3e\u0d37\u0d2f\u0d28\u0d3f\u0d32\u0d4d\u200d  \u0d35\u0d28\u0d3f\u0d35\u0d30\u0d4d\u200d\u0d24\u0d4d\u0d24\u0d28\u0d23 \u0d1a\u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d35\u0d28\u0d3f\u0d27\u0d28\u0d3f\u0d28\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d2c\u0d3e\u0d2f\u0d23\n\u0d35\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d35\u0d39\u0d2c\u0d3e\u0d30\u0d28\u0d3f\u0d2f\u0d41\u0d1a\u0d1f\u0d46 \u0d2d\u0d2c\u0d3e\u0d37\u0d2f\u0d28\u0d3f\u0d32\u0d4d\u200d  \u0d2e\u0d28\u0d38\u0d28\u0d3f\u0d32\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d28\u0d3f\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d28\u0d3f\u0d2f\u0d28\u0d28\u0d3f\u0d24 \u0d09\u0d2a\u0d26\u0d2f\u0d2c\u0d3e\u0d17\u0d1a\u0d24\u0d4d\u0d24\n\u0d09\u0d26\u0d26\u0d4d\u0d26\u0d47\u0d36\u0d28\u0d3f\u0d1a\u0d28\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d2c\u0d3e\u0d23\u0d23;  \u0d2e\u0d26\u0d31\u0d4d\u0d31\u0d47\u0d1a\u0d24\u0d19\u0d28\u0d3f\u0d32\u0d23 \u0d06\u0d35\u0d36\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d4d\u200d\u0d15\u0d2c\u0d3e\u0d2f\u0d28\u0d3f \u0d05\u0d24\u0d23 \u0d09\u0d2a\u0d26\u0d2f\u0d2c\u0d3e\u0d17\u0d28\u0d3f\u0d15\u0d2c\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d32.\n\n                                                                                  2\n\u0d0e\u0d32\u0d2c\u0d3e\u0d35\u0d28\u0d3f\u0d27 \u0d2a\u0d2c\u0d3e\u0d26\u0d2f\u0d2c\u0d3e\u0d17\u0d28\u0d3f\u0d15\u0d35\u0d41\u0d23 \u0d14\u0d26\u0d26\u0d47\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d2c\u0d3e\u0d17\u0d28\u0d3f\u0d15\u0d35\u0d41\u0d2e\u0d2c\u0d3e\u0d2f \u0d06\u0d35\u0d36\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d4d\u200d\u0d15\u0d23 \u0d35\u0d28\u0d3f\u0d27\u0d28\u0d3f\u0d28\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d2c\u0d3e\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1a\u0d1f\u0d46\n\u0d07\u0d23\u0d17\u0d17\u0d4d\u0d32\u0d40\u0d37\u0d23 \u0d2a\u0d24\u0d28\u0d3f\u0d2a\u0d2c\u0d3e\u0d23\u0d23 \u0d06\u0d27\u0d28\u0d3f\u0d15\u0d2c\u0d3e\u0d30\u0d28\u0d3f\u0d15\u0d23,  \u0d05\u0d24\u0d23 \u0d0e\u0d32\u0d2c\u0d3e \u0d06\u0d35\u0d36\u0d26\u0d4d\u0d27\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d23 \u0d28\u0d1f\u0d46\u0d2a\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d28\u0d3f\u0d28\u0d41\u0d23\n\u0d28\u0d1f\u0d46\u0d2a\u0d28\u0d3f\u0d32\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d28\u0d3f\u0d28\u0d41\u0d23 \u0d06\u0d27\u0d28\u0d3f\u0d15\u0d2c\u0d3e\u0d30\u0d28\u0d3f\u0d15\u0d2e\u0d2c\u0d3e\u0d2f\u0d28\u0d3f \u0d24\u0d41\u0d1f\u0d46\u0d30\u0d41\u0d15\u0d2f\u0d41\u0d23 \u0d1a\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d2c\u0d3e\u0d23\u0d23. \n  \nTranslated by: Vidhya P V (Translator)\nVerified by: Assainar A (Head Translator)\n"
