    "full_text": "(1) \n \n \n\ue82d\ue838\ue83d\ue827\ue837\ue81d\ue8eb\ue83d\ue82c\ue837\ue815\ue8f6 \n \n\ue82a\ue837\ue82d\ue822\ue839\ue846 \ue80b\ue87f\ue822\ue82b \ue826\ue8f6\ue837\ue846\ue837\ue82f\ue846, \ue82a\ue837\ue82d\ue822 \n\ue833\ue838\ue82a\ue838\ue82e\ue841 \ue807\ue827\ue838\ue82e\ue841 \ue807\ue825\ue8ef\ue813\ue837\ue82d\ue838\ue822\ue837 \n\ue833\ue838\ue82a\ue838\ue82e\ue841 \ue807\ue827\ue838\ue82e\ue841 \ue826\ue805 \u2013 \ue851\ue84b\ue84a/\ue84b\ue849\ue84b\ue84a \n(\ue83d\ue8e4\ue831\ue838\ue807\ue837\ue82e \ue82e\ue838\ue82a\ue841 \ue827\ue838\ue81d\ue838\ue833\ue826\ue841 (\ue833\ue838\ue82a\ue838\ue82e\ue841) \ue826\ue805 \ue84d\ue849\ue84f\ue84f/\ue84b\ue849\ue84b\ue84a\ue82d\ue83a \ue80b\ue824\ue841\ue82a\ue83a\ue822) \n(\ue83d\ue8e4\ue831\ue838\ue807\ue837\ue82e \ue82e\ue838\ue82a\ue841 \ue827\ue838\ue81d\ue838\ue833\ue826\ue841 (\ue833\ue838\ue82a\ue838\ue82e\ue841) \ue844\ue837\ue809\ue82d\ue839 \ue826\ue805 \ue852\ue84f\ue84f\ue849/\ue84b\ue849\ue84b\ue849\ue82d\ue83a \ue80b\ue824\ue841\ue82a\ue83a\ue822) \n \n \n\ue846\ue83a\ue826\ue838\ue846\ue826 \ue827\ue829\ue939\ue838\ue813 \ue833\ue82a\ue8f1\ue833\ue841 \ue813\ue82b\ue838\ue831\ue826\u2026..\u2026\u2026\u2026\u2026\u2026.\u2026 \ue807\ue837\ue83d\ue829\ue824\ue826\ue813\ue837\ue82d\ue839 \n\ue829\ue826\ue837\ue82b \n\ue829\ue838\ue82a\ue83a \ue90b\ue833\ue837\ue824 \ue832\ue844\ue87d\ue839 \ue80f\ue829\ue805 \ue811\ue83d\ue815\ue82d\ue841\u2026\u2026\u2026\u2026 \ue80b\ue895\ue82d\ue824\ue837\ue822\ue837 (\ue82b\ue837\ue83d\ue826) \n \n\ue82d\ue837\ue846  \n \n\ue82b\ue837\ue826\ue8f6\ue829\ue82d \ue826\ue8f6\ue837\ue846\ue82b\ue83b\ue895\ue8f1 \ue844. \ue825\ue826\ue889\ue846 I\u00df\ue837\ue809. \ue818\ue8b2\ue818\ue83b\ue844 \n \n\ue84a- \n\ue829\ue838\ue82f\ue8c4 \ue82b\ue837\ue828\ue841 \ue813\ue82d\ue837\ue815\ue82e\ue837 \ue837 \n\ue84b- \n\ue82e\ue838\ue82a\ue841 \ue827\ue838\ue81d\ue838\ue833\ue826\ue841 \ue82b\ue889\ue83a\ue82d \ue83d\ue834\ue82e\ue837 \ue837 \n\ue84c- \n\ue80f\ue834\ue838 \ue807\ue827\ue838\ue82e\ue841 \ue84b\ue84a \ue826\ue83d\ue82a\ue8c4\ue82d \ue84b\ue849\ue84a\ue852\ue83d\ue82d \ue811\ue844\ue838\ue831\ue837 \ue834\ue837\ue809\ue83d\ue813\ue837\ue81d\ue8eb\ue879 \ue80f\ue813 \ue824\ue83a\ue809 \ue81a\ue821\ue838\ue807\ue837 \ue814\ue890\ue827\ue839\ue81e \n\ue879 \ue80f\ue813 \ue82d\ue837\ue846 \ue80f\ue829\ue805 \ue807\ue837\ue83d\ue824\ue831\ue82d\ue83a \ue80b\ue89a\ue8b8 \ue83d\ue834\ue837\ue809\ue819\ue838 \ue837 \n\ue84d- \n\ue83d\ue813\ue8b2\ue839\ue846 \ue90b\ue831\ue837\ue833\ue826\ue838\ue813 \ue901\ue838\ue829\ue8f6\ue83a\ue826\ue837\ue82e, \ue813\ue81d\ue813 \ue83d\ue829\ue887\ue841 \ue82d \ue84a\ue84c \ue82b\ue837\ue87f\ue8eb \ue84b\ue849\ue84a\ue852\ue82d \ue807\ue837\ue83d\ue824\ue831\ue813\ue83a \n\ue818\ue8f6\ue837\ue83d\ue82e\ue889 \ue813\ue82d\ue838 \ue833\ue8c4\ue838\ue825\ue837\ue826\ue83d\ue82d \ue825\ue837\ue82d\ue837 \ue84b\ue84b\ue84f \ue807\ue826\ue83a\ue82c\ue837\ue846\ue839 \ue807\ue837\ue83d\ue829\ue824\ue826\ue813\ue837\ue82d\ue839 \ue834\ue837\ue809\ue83d\ue813\ue837\ue81d\ue8eb\ue83d\ue82d \n\ue834\ue837\ue81a\ue82d \ue83d\ue834\ue837\ue809\ue8f4\ue83d\ue82e \ue837 \ue84b\ue849\ue84a\ue84e \ue83d\ue82d \ue814\ue837\ue82e\ue838\ue8f4\ue829\ue837 \ue827\ue824\ue829\ue839 \ue807\ue826\ue83a\ue82c\ue837\ue846\ue839 \ue807\ue837\ue809.\ue80f.\ue80f\ue833\ue841 \ue813\ue83a \n\ue827\ue83d\ue824\ue837\ue8b8\ue822\ue838 \ue827\ue837\ue809\ue804 \ue818\ue846\ue826 \ue813\ue82b\ue838\ue81d\ue838\ue82d \ue80f\ue813 \ue83d\ue829\ue842\ue81e\ue813 \ue827\ue83a\ue826\ue806 \ue807\ue837\ue83d\ue846\ue837\ue81a\ue826 \ue813\ue82d\ue838 \ue90b\ue823\ue82b \n\ue80b\ue895\ue82d\ue824\ue837\ue822\ue837\ue879 \ue82b\ue837\ue82b\ue82e\ue837\ue82d \ue827\ue83a\ue826\ue829\ue8f1\ue818\ue837\ue82d \ue813\ue82d\ue838\ue829\ue837\ue813\ue83a \ue901\ue838\ue829\ue8f6\ue83a\ue826\ue837\ue82e \ue807\ue837\ue83d\ue829\ue824\ue826\ue813\ue837\ue82d\ue839\ue879\ue83a \ue826\ue838\ue83d\ue8a3\ue8eb\ue831 \n\ue83d\ue824\ue809\ue8f4\ue83d\ue82e \ue80f\ue829\ue805 \ue822\ue837\u2019 \ue827\ue83d\ue82d \ue82c\ue824\ue838 \ue90b\ue823\ue82b \ue80b\ue895\ue82d\ue824\ue837\ue822\ue837 \ue84b\ue849\ue84a\ue84e \ue83d\ue82d \ue827\ue83d\ue824\ue837\ue8b8\ue822\ue838 \ue827\ue837\ue809\ue804 \n\n(2) \n \n \n\ue807\ue826\ue83a\ue827\ue82c\ue83a\ue86b \ue83d\ue829\ue837\ue82e\ue838 \ue827\ue837\ue846\ue837 \ue82c\ue837\ue807\ue837\ue8ab\ue838, \ue83d\ue822\ue83d\ue829 \ue90b\ue823\ue82b \ue80b\ue895\ue82d\ue824\ue837\ue822\ue837\ue879\ue83a \ue84b\ue849\ue84a\ue84f \ue80f\ue829\ue805 \ue84b\ue849\ue84a\ue850 \n\ue827\ue837\ue809\ue804 \ue833\ue82b\ue837\ue826 \ue82a\ue837\ue829\ue83d\ue82d \ue827\ue83a\ue826\ue829\ue8f1\ue818\ue837\ue82d \ue813\ue82d\ue838\ue829\ue837\ue813\ue83a \ue826\ue838\ue83d\ue8a3\ue8eb\ue831 \ue83d\ue824\ue809\ue8f4\ue83d\ue82e \ue837 \ue833\ue82b\ue839\ue86f\ue837 \ue818\ue846\ue826 \ue813\ue82b\ue838\ue81d\ue838 \n\ue90b\ue823\ue82b \ue80b\ue895\ue82d\ue824\ue837\ue822\ue837\ue879\ue83a \ue80b\ue827\ue82c\ue83a\ue86b \ue82b\ue83d\ue826 \ue813\ue82d\ue83a\ue8f4\ue83d\ue82e \ue827\ue82d\ue838\ue82b\ue837\ue821\ue82b\ue83b\ue82f\ue813 \ue833\ue837\ue834\ue837\ue82c\ue8f6 \ue815\ue83a\ue844\ue838\ue813\ue83a \ue82b\ue83a\ue86b \n\ue813\ue82d\ue838\ue829\ue837\ue813\ue83a \ue826\ue838\ue83d\ue8a3\ue8eb\ue831 \ue824\ue838\ue807\ue837\ue82c\ue837\ue809\ue8f4\ue82e\ue837 \ue837 \n\ue84e- \n \n\ue829\ue895\ue8eb\ue82b\ue837\ue826 \ue807\ue827\ue838\ue82e\ue841\ue82d \ue80b\ue83d\ue8a3\ue831\ue8f6 \ue827\ue837\ue809\ue804 \ue827\ue82d\ue829\ue895\ue8eb\ue839 \ue833\ue82b\ue846\ue83d\ue82d \ue807\ue837\ue83d\ue82b \ue82c\ue837\ue834\ue837 \ue833\ue83b\ue818\ue839\ue822 \n\ue813\ue82d\ue83a\ue819\ue83a \ue822\ue837\ue834\ue837\ue813\ue83a \ue824\ue83c\ue8d6\ue838\ue83d\ue82d \ue82d\ue8f3 \ue82b\ue837\ue82b\ue82e\ue837\ue82d \ue822\ue823\ue8f6\ue813\ue83a \ue829\ue838\ue8df\ue990\ue822 \ue82a\ue837\ue829\ue83d\ue82d \ue829\ue838\ue818\ue837\ue82d \ue813\ue82d\ue838\ue829\ue837 \ue83d\ue813\ue837\ue81d\ue8eb \n\ue827\ue837\ue809\ue804 \ue807\ue837\ue829\ue831\ue8f6\ue813 \ue826\ue83a\ue83d\ue834\ue804 \ue837 \ue84b\ue84a \ue826\ue83d\ue82a\ue8c4\ue82d \ue84b\ue849\ue84a\ue852\ue82d \ue82d\ue837\ue846 \ue82d \ue807\ue826\ue83a\ue83d\ue880\ue824 \ue84d \ue83d\ue82d \ue834\ue837\ue809\ue83d\ue813\ue837\ue81d\ue8eb \n\ue901\ue838\ue829\ue8f6\ue83a\ue826\ue837\ue82e\ue82d \ue82d\ue837\ue846\ue82d \ue813\ue838\ue819\ue838 \ue807\ue805\ue831 \ue80b\ue8a4\ue83c\ue822 \ue813\ue82d\ue838\ue8f4\ue83d\ue82e \ue837 \ue80f\ue834\ue837\ue827\ue83d\ue82d \ue834\ue837\ue809\ue83d\ue813\ue837\ue81d\ue8eb \ue80b\ue83d\ue8cf\ue814 \n\ue813\ue82d\ue838\ue819\ue8ab\ue838 \ue83d\ue82c \ue901\ue838\ue829\ue8f6\ue83a\ue826\ue837\ue82e \ue826\ue838\ue83d\ue8a3\ue8eb\ue831 \ue83d\ue824\ue829\ue837\ue83d\ue829\ue83d\ue82f \ue807\ue837\ue809\ue826\ue841 \ue80b\ue827\ue83d\ue82d \ue829\ue838\ue8df\ue990\ue822 \ue82a\ue837\ue83d\ue829 \ue807\ue837\ue83d\ue82e\ue837\ue818\ue826\ue837 \n\ue813\ue82d\ue838\ue819\ue8ab\ue838 \ue837 \ue80f\ue834\ue837 \ue813\ue834\ue838 \ue834\ue837\ue809\ue83d\ue813\ue837\ue81d\ue8eb \ue80f\ue834\ue837\ue879 \ue82d\ue837\ue846\ue82d \ue807\ue826\ue83a\ue83d\ue880\ue824 \ue84f \ue83d\ue82d \ue826\ue838\ue82b\ue931\ue82e\ue838\ue8f3\ue822 \ue807\ue829\ue83d\ue82e\ue837\ue813\ue826 \n\ue813\ue82d\ue838\ue819\ue8ab\ue838 : \n \n \n \n\u201c\ue84f-\ue807\ue837\ue83d\ue8c5 \ue827\ue86f\ue82b\ue837\ue826\ue879\ue82d \ue811\ue813\ue838\ue82e\ue82b\ue837\ue826\ue879\ue83a \ue831\ue83a\ue821\ue838\ue819\ue83a \ue80f\ue829\ue805 \ue807\ue837\ue83d\ue86f\ue827\ue838\ue822  \n\ue807\ue837\ue83d\ue824\ue831 \ue833\ue834\ue838\ue822 \ue833\ue837\ue82b\ue8f9\ue839 \ue815\ue83a\ue844\ue838\ue813\ue83a \ue807\ue826\ue83a\ue8aa\ue837\ue826 \ue813\ue82d\ue838\ue819\ue83a \ue837 \ue83d\ue82d\ue813\ue844\ue8eb\ue83d\ue82d  \n\ue80b\ue827\ue82e\ue829\ue841\ue825 \ue833\ue837\ue82b\ue8f9\ue839 \ue833\ue8c4\ue8b4\ue83d\ue82d \ue827\ue86f \ue82b\ue8