    "full_text": "                                          \u092a\u094d\u0930\u0915\u093e\u0936\u0928\u092f\u094b\u0917\u094d\u092f\n              \n\u092d\u093e\u0930\u0924\u093e\u091a\u0947 \u0938\u0930\u094d\u0935\u094b\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0924 \n              \n\u0926\u093f\u0935\u093e\u0923\u0940 \u0905\u092a\u093f\u0932\u0940\u092f \u0905\u0927\u093f\u0915\u093e\u0930\u0940\u0924\u093e\n\u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e \n \n ( \n  \u0926\u093f\u0935\u093e\u0923\u0940\n \n ) \n  \u0915\u094d\u0930  .   \u096a\u096a\u0968\u096e\n \n / \u0968\u0966\u0967\u096c\n \n  \n\u090f\u0938.\u090f\u092e. \u092a\u093e\u0936\u093e \u0906\u0923\u093f \u0907\u0924\u0930\u2026. \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u0947 \n                         \n               \n\u0935\u093f\u0930\u0941\u0926\u094d\u0927 \n\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u0930\u093e\u091c\u094d\u092f \u0906\u0923\u093f \u0907\u0924\u0930.    \u2026\u2026\u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940\n                                 \n\u0938\u0939\n\u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e \n \n (  \u0926\u093f  ) \n  \u0915\u094d\u0930\u2026\u0938\u0940\u0938\u0940 \u0915\u094d\u0930\n \n .  \n  \u096a\u096f\u0968\u0968\n \n / \u0968\u0966\u0967\u096c \n \n \n\u0906\u0926\u0947\u0936\n \u090f\u092e\n  . \u0906\u0930 \n \n . \u0936\u0939\u093e \n \n -   \u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u0940\n \n \n\u0967. \u092e\u0941\u0902\u092c\u0908 \u092f\u0947\u0925\u0940\u0932 \u0909\u091a\u094d\u091a \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u091a\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u093e\u0930\u0924\u0947\u092e\u0927\u0940\u0932 \u0930\u093f\u091f \u092f\u093e\u091a\u093f\u0915\u093e \u0915\u094d\u0930. \u096c\u0967\u096a\u0968/\u0968\u0966\u0967\u096a \u0906\u0923\u093f \u0930\u093f\u091f \u092f\u093e\u091a\u093f\u0915\u093e \n\u0915\u094d\u0930.\u096b\u096a\u096f\u0966/\u0968\u0966\u0967\u096a, \u092e\u0927\u094d\u092f\u0947 \u0926\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u0906\u0915\u094d\u0937\u0947\u092a\u093f\u0924 \u0928\u094d\u092f\u093e\u092f\u0928\u093f\u0930\u094d\u0923\u092f \n\u0906\u0923\u093f\n \u0906\u0926\u0947\u0936\u093e\u0928\u0947 \u0928\u093e\u0930\u093e\u091c \u0906\u0923\u093f\n \u0905\u0938\u092e\u093e\u0927\u093e\u0928\u0940 \u091d\u093e\u0932\u094d\u092f\u093e\u092e\u0941\u0933\u0947,  \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0927\u0940\u0928 \u091c\u093e\u0917\u0947\u0924 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u093e\u0939\u0940 \u092d\u093e\u0921\u0947\u0915\u0930\u0942\u0902\u0928\u0940, \n\u0938\u0926\u0930\u091a\u094d\u092f\u093e \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u090f\u0938\u090f\u0932\u092a\u0940) \u0926\u093e\u0916\u0932 \u0915\u0947\u0932\u094d\u092f\u093e \u0906\u0939\u0947\u0924.\n\u0968. \u0921\u0949. \u090f.\u090f\u092e. \u0938\u093f\u0902\u0918\u0935\u0940, \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932,  \u0939\u0947 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\n\u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 (\u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u0947 \u096a \u0935\u0917\u0933\u0924\u093e) \u0935\u093f\u0936\u0947\u0937 \n\u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f)  \u0915\u094d\u0930.  \u096a\u096a\u0968\u096e/\u0968\u0966\u0967\u096c \u092e\u0927\u094d\u092f\u0947 \u0939\u091c\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947\u0924.  \u0936\u094d\u0930\u0940.  \u0930\u093e\u0923\u093e \u092e\u0941\u0916\u0930\u094d\u091c\u0940,  \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \n\u0935\u0915\u0940\u0932,  \u0939\u0947 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\n\u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e(\u0926\u093f) \u0915\u094d\u0930\u2026. \u0938\u0940\u0938\u0940 \u0915\u094d\u0930. \u096a\u096f\u0968\u0968/ \u0968\u0966\u0967\u096c \u092e\u0927\u094d\u092f\u0947 \n\n\u0939\u091c\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947\u0924.   \u0936\u094d\u0930\u0940. \u0927\u094d\u0930\u0941\u0935 \u092e\u0947\u0939\u0924\u093e, \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932,  \u0939\u0947 \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u092a\u0926\u093e\u0927\u093f\u0915\u093e\u0931\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0939\u091c\u0930 \u091d\u093e\u0932\u0947 \n\u0906\u0939\u0947\u0924. \u0936\u094d\u0930\u0940. \u0928\u0940\u0930\u091c \u0915\u093f\u0936\u0928 \u0915\u094c\u0932, \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932, \u0939\u0947 \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f) \u0915\u094d\u0930. \u096a\u096a\u0968\u096e/\u0968\u0966\u0967\u096c \n\u092e\u0927\u094d\u092f\u0947 \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b  \u092e\u0941\u0916\u094d\u092f \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u092a\u0930\u094d\u0927\u0940 \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940\u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0939\u091c\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947\u0924.  \u0936\u094d\u0930\u0940. \u0935\u0947\u0923\u0941\u0917\u094b\u092a\u093e\u0932, \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \n\u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932,  \u0939\u0947 \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930.  \u0967\u096d \u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0939\u091c\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947\u0924.  \u0936\u094d\u0930\u0940.  \u0917\u0941\u0930\u0941\u0915\u0943\u0937\u094d\u0923 \u0915\u0941\u092e\u093e\u0930,  \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \n\u0935\u0915\u0940\u0932,  \u0939\u0947 \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930.  \u0967\u096c \u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0939\u091c\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0936\u094d\u0930\u0940 \u0938\u0902\u091c\u092f \u091c\u0948\u0928,  \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \n\u092e\u0939\u093e\u0927\u093f\u0935\u0915\u094d\u0924\u093e,  \u0939\u0947 \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u0930\u093e\u091c\u094d\u092f /\u092e\u094d\u0939\u093e\u0921\u093e \u091a\u094d\u092f\u093e\u0935\u0924\u0940\u0928\u0947 \u0939\u091c\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947\u0924.\n\u0969.  \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930.\u096b \u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0916\u094b\u091f\u094d\u092f\u093e \u0938\u093e\u0915\u094d\u0937\u0940\u0938\u093e\u0920\u0940 \u0926\u094b\u0928 \u0906\u092f\u090f (\u0935\u093e\u0926\u0915\u093e\u0932\u0940\u0928 \u0905\u0930\u094d\u091c)  \u0926\u093e\u0916\u0932 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947\u0924. \n\u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u090f\u0915 \u0906\u092f\u090f \u0926\u093e\u0916\u0932 \u0915\u0947\u0932\u093e \u0906\u0939\u0947, \u091c\u094d\u092f\u093e\u0924 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u091c\u094b \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0939\u094b\u0924\u093e \u0924\u094b \n\u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0923\u094d\u092f\u093e\u0932\u093e  \u0906\u0935\u094d\u0939\u093e\u0928 \u0926\u093f\u0932\u0947 \u0906\u0939\u0947.\n\u0969.\u0967 \u0921\u0949. \u090f.\u090f\u092e. \u0938\u093f\u0902\u0918\u0935\u0940, \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932, \u092f\u093e\u0902\u0928\u0940 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\n\u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f) \n\u0915\u094d\u0930. \u096a\u096a\u0968\u096e/\u0968\u0966\u0967\u096c \u092e\u0927\u094d\u092f\u0947 \u0909\u092a\u0938\u094d\u0925\u093f\n\u0924 \u0930\u093e\u0939\u0942\u0928, \u0905\u0936\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0947\u0932\u0940 \u0915\u0940, \u092f\u093e\u0928\u0902\u0924\u0930\u091a\u094d\u092f\u093e \u0918\u0921\u093e\u092e\u094b\u0921\u0940 \u0932\u0915\u094d\u0937\u093e\u0924 \u0918\u0947\u090a\u0928 \n\u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\n\u0928\u093e (\u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u0947 \u0915\u094d\u0930.  \u096a \u0935\u0917\u0933\u0924\u093e),  \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e \u092e\u093e\u0917\u0947 \u0918\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \n\u092f\u093e\u0935\u0940.  \u092e\u094d\u0939\u0923\u0923\u0947 \u092e\u093e\u0902\u0921\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940, \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930\u091a\u094d\u092f\u093e \u0918\u0921\u093e\u092e\u094b\u0921\u0940 \u0906\u092f\u090f \u0915\u094d\u0930. \u0967\u0968\u096e\u096e\u096e\u0967/\u0968\u0966\u0967\u096f \u092e\u0927\u094d\u092f\u0947 \u0928\u092e\u0942\u0926 \n\u0915\u0947\u0932\u094d\u092f\u093e \u0906\u0939\u0947\u0924. \u0905\u0938\u0947 \u0928\u093f\u0926\u0930\u094d\u0936\u0928\u093e\u0938 \u0906\u0923\u0942\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940, \u0938\u0927\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0915\u093e\u0930\u094d\u092f\u0935\u093e\u0939\u0940\u091a\u094d\u092f\u093e \u0926\u0930\u092e\u094d\u092f\u093e\u0928, \n\u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0905\u0938\u0932\u0947\u0932\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u0966\u096e.\u0967\u0966.\u0968\u0966\u0967\u096e \u0930\u094b\u091c\u0940 \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u093e \u0906\u0939\u0947 \n\u0906\u0923\u093f \u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938\u0915\u093e\u091a\u0940 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u0940 \u091d\u093e\u0932\u094d\u092f\u093e\u0928\u0947 \u0926\u0941\u0938\u0931\u094d\u092f\u093e \u0935\u093f\u0915\u093e\u0938\u0915\u093e\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0928\u0935\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930\u0939\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \n\u0906\u0932\u093e \u0906\u0939\u0947.  \u092a\u0941\u0922\u0947 \u0905\u0938\u0947\u0939\u0940 \u0928\u093f\u0926\u0930\u094d\u0936\u0928\u093e\u0938 \u0906\u0923\u0942\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940,\u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0938\u0941\u0926\u094d\u0927\u093e \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u0917\u0943\u0939\u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0906\u0923\u093f \n\u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0935\u093f\u0915\u093e\u0938 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 ( \u092e\u094d\u0939\u093e\u0921\u093e) \u092f\u093e\u0902\u0928\u0940 \u0938\u0941\u0926\u094d\u0927\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0932\u0947\u0932\u093e \u0906\u0939\u0947,  \u091c\u094b \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \n\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0939\u094b\u0924\u093e.  \u0905\u0938\u0947 \u092e\u094d\u0939\u0923\u0923\u0947 \u092e\u093e\u0902\u0921\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940, \u092c\u0926\u0932\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u0930\u093f\u0938\u094d\u0925\u093f\n\u0924\u0940\u0924 \u0935\u093e\u0926\u092e\u0941\u0926\u094d\u0926\u093e \u091c\u094b \u0905\u0936\u093e\u092a\u094d\u0930\u0915\u093e\u0930\u0947 \n\u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b  \u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0935\u093f\u0930\u0941\u0926\u094d\u0927 \u0939\u094b\u0924\u093e, \u0924\u094b \u091f\u093f\u0915\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u092e\u094d\u0939\u0923\u0942\u0928 \u0905\u0936\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947 \u0915\u0940 \n\u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0938\u0940) \u0915\u094d\u0930. \u096a\u096a\u0968\u096e/\u0968\u0966\u0967\u096c  \u092e\u093e\u0917\u0947 \u0918\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \u092f\u093e\u0935\u0940. \n\u0969.\u0968 \u0936\u094d\u0930\u0940 \u0930\u093e\u0923\u093e \u092e\u0941\u0916\u0930\u094d\u091c\u0940,  \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\n\u091a\u094d\u092f\u093e  \u0935\u0924\u0940\u0928\u0947 \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f)  \u0915\u094d\u0930\u2026\u0938\u0940\u0938\u0940 \u0915\u094d\u0930. \n\u096a\u096f\u0968\u0968/\u0968\u0966\u0967\u096c \u092e\u0927\u094d\u092f\u0947 \u0939\u091c\u0930 \u0905\u0938\u0932\u0947\u0932\u0947 \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932, \u0935\u0930\u0940\u0932 \u092e\u094d\u0939\u0923\u0923\u0947 \u0928\u093e\u0915\u093e\u0930\u0940\u0924 \u0928\u093e\u0939\u0940\u0924  \u0924\u0925\u093e\u092a\u093f, \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \n\u0905\u0938\u0947 \u092e\u094d\u0939\u0923\u0923\u0947 \u092e\u093e\u0902\u0921\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940,  \u092f\u093e \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u0947\u092e\u0927\u0940\u0932 \u092d\u093e\u0921\u0947\u0915\u0930\u0942 \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\n\u091a\u093e \n\n\u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0924\u093e,  \u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930\u093e\u0924\u0940\u0932 \u0906\u0936\u092f \u0906\u0923\u093f/\u0915\u093f\u0902\u0935\u093e \u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940\u0902\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \n\u092e\u094d\u0939\u0923\u0942\u0928 \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928\u093e\u0932\u093e, \u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938\u0915\u093e\u0902\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0928\u0935\u094d\u092f\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930\u093e\u091a\u0940 \u092a\u094d\u0930\u0924 \u0938\u093e\u0926\u0930 \n\u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0906\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092f\u093e\u0935\u0947 \u092f\u093e\u0935\u0947\u0924, \u091c\u0947\u0923\u0947\u0915\u0930\u0941\u0928 \u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0915\u0933\u0942 \u0936\u0915\u0947\u0932 \u0915\u0940 \u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \n\u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940\u0902\u0935\u0930 \u0915\u0947\u0932\u093e \u0917\u0947\u0932\u093e \u0906\u0939\u0947 \u0906\u0923\u093f \u092d\u093e\u0921\u0947\u0915\u0930\u0942 \u0924\u094d\u092f\u093e\u0935\u0930 \u0938\u0939\u092e\u0924 \u0906\u0939\u0947\u0924 \u0915\u0940 \u0928\u093e\u0939\u0940\u0924.  \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u0905\u0936\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0947\u0932\u0940 \n\u0915\u0940, \u091c\u0930 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u0947 \u0928\u0935\u0940\u0928 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930\u093e\u0924\u0940\u0932 \u0905\u091f\u0940 \u0906\u0923\u093f \u0936\u0930\u094d\u0924\u0940\u0902\u0936\u0940 \u0938\u0939\u092e\u0924 \u0928\u0938\u0924\u0940\u0932  \u0924\u0930, \u0924\u094d\u092f\u093e\u0902\u0928\u093e \n\u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930\u093e\u0938 \u092f\u094b\u0917\u094d\u092f \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f/ \u092e\u0902\u091a \u0938\u092e\u094b\u0930 \u0906\u0935\u094d\u0939\u093e\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u092e\u0941\u092d\u093e \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \u092f\u093e\u0935\u0940. \n\u0969.\u0969 \u0936\u094d\u0930\u0940. \u0928\u0940\u0930\u091c \u0915\u093f\u0936\u0928 \u0915\u094c\u0932, \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932 \u092a\u094d\u0930\u0924\u093f\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0939\u091c\u0930 \u0905\u0938\u0932\u0947\u0932\u0947, \u092f\u093e\u0902\u091a\u093e \u0938\u0926\u0930\u091a\u0940 \n\u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e \u092e\u093e\u0917\u0947 \u0918\u0947\u0923\u094d\u092f\u093e\u0938 \u0935\u093f\u0930\u094b\u0927 \u0905\u0938\u0932\u093e \u0924\u0930\u0940\u0939\u0940 \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u0905\u0938\u0947 \u092e\u094d\u0939\u0923\u0923\u0947 \u092e\u093e\u0902\u0921\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940, \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \n\u0915\u094d\u0930. \u096b \u092f\u093e\u0902\u0928\u0940 \u0906\u092f\u090f \u091a\u094d\u092f\u093e \u092e\u093e\u0930\u094d\u0917\u093e\u0928\u0947 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u091c\u094b \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0939\u094b\u0924\u093e \u0924\u094b \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0923\u094d\u092f\u093e\u0938, \u0906\u0935\u094d\u0939\u093e\u0928 \u0926\u093f\u0932\u0947 \n\u0906\u0939\u0947 \u0906\u0923\u093f \u0916\u094b\u091f\u0940 \u0938\u093e\u0915\u094d\u0937\u0940\u091a\u0940 \u0915\u093e\u0930\u094d\u092f\u0935\u093e\u0939\u0940 \u0926\u0947\u0916\u0940\u0932 \u0938\u0941\u0930\u0942 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947. \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u0905\u0936\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947 \u0915\u0940, \u091c\u0930 \u0939\u0947 \n\u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \u0932\u093e \u0938\u0927\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092f\u0935\u093e\u0939\u0940\u092e\u0927\u094d\u092f\u0947,  \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u096b \u091a\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \n\u0906\u0923\u0923\u094d\u092f\u093e\u0932\u093e \u0906\u0935\u094d\u0939\u093e\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u0947\u0923\u094d\u092f\u093e\u0938 \u0907\u091a\u094d\u091b\u0941\u0915 \u0928\u0938\u0947\u0932 \u0906\u0923\u093f \u0916\u094b\u091f\u094d\u092f\u093e \u0938\u093e\u0915\u094d\u0937\u0940 \u0905\u0930\u094d\u091c\u093e\u0935\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0924 \n\u0928\u0938\u0947\u0932, \u0924\u0930  \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \u092f\u093e\u0938 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930  \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0923\u094d\u092f\u093e\u0938 \u0906\u0923\u093f  \u0926\u0941\u0938\u0931\u094d\u092f\u093e \u0935\u093f\u0915\u093e\u0938\u0915\u093e\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \n\u0905\u0938\u0932\u0947\u0932\u093e \u0928\u0902\u0924\u0930\u091a\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u092f\u093e\u0938 \u092f\u094b\u0917\u094d\u092f \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f/\u092e\u0902\u091a\u093e \u0938\u092e\u094b\u0930 \u0906\u0935\u094d\u0939\u093e\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u0938, \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \u092f\u093e\u0902\u091a\u094d\u092f\u093e \n\u092c\u093e\u091c\u0942\u0928\u0947 \u092e\u0941\u092d\u093e \u0926\u0947\u0923\u094d\u092f\u093e\u0924 \u092f\u093e\u0935\u0940 \u0906\u0923\u093f \u0916\u094b\u091f\u094d\u092f\u093e \u0938\u093e\u0915\u094d\u0937\u0940 \u0905\u0930\u094d\u091c\u093e\u092e\u0927\u094d\u092f\u0947 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u0940 \u0915\u093e\u0930\u0923\u0947 \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \n\u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u0947\u0928\u0941\u0938\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u093e\u0924 \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0926\u0947\u0936\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092f\u093e\u0935\u0947.\n\u096a.  \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u0915\u094d\u0937\u093e\u0902\u091a\u094d\u092f\u093e \u0935\u0924\u0940\u0928\u0947 \u0909\u092a\u0938\u094d\u0925\u093f\n\u0924 \u0905\u0938\u0932\u0947\u0932\u0947 \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932/\u0938\u0932\u094d\u0932\u093e\u0917\u093e\u0930  \u092f\u093e\u0902\u091a\u0947 \u092e\u094d\u0939\u0923\u0923\u0947 \u0910\u0915\u0942\u0928 \u0906\u0923\u093f \n\u0906\u092f\u090f \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0967\u0968\u096e\u096e\u096e\u0967/\u0968\u0966\u0967\u096f \u092e\u0927\u094d\u092f\u0947 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0906\u0923\u093f \u0928\u093f\u0926\u0930\u094d\u0936\u0928\u093e\u0938 \u0906\u0923\u0942\u0928 \u0926\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u0928\u0902\u0924\u0930\u091a\u094d\u092f\u093e \u0918\u0921\u093e\u092e\u094b\u0921\u0940 \n\u0935\u093f\u091a\u093e\u0930\u093e\u0924 \u0918\u0947\u090a\u0928, \u0916\u093e\u0932\u0940 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0938\u0941\u0930\u0942 \u0915\u0930\u093e\u0935\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092f\u0935\u093e\u0939\u0940\u0924\u0940\u0932 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092a\u0915\u094d\u0937\u093e\u0902\u091a\u0947 \u0939\u0915\u094d\u0915 \u0906\u0923\u093f \n\u092e\u094d\u0939\u0923\u0923\u0947 \u092f\u093e\u0902\u0928\u093e \u092c\u0917\u0932 \u0928 \u0926\u0947\u0924\u093e   \u0906\u0923\u093f \u0921\u0949. \u090f.\u090f\u092e. \u0938\u093f\u0902\u0918\u0935\u0940, \u0935\u093f\u0926\u094d\u0935\u093e\u0928 \u0935\u0930\u093f\u0937\u094d\u0920 \u0935\u0915\u0940\u0932 \u092f\u093e\u0902\u0928\u0940 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940\u091a\u093e \u0935\u093f\u091a\u093e\u0930 \n\u0915\u0930\u0942\u0928, \u0906\u092e\u094d\u0939\u0940 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\n\u0928\u093e \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f) \u0915\u094d\u0930. \u096a\u096a\u0968\u096e/\u0968\u0966\u0967\u096c \u092e\u0927\u0940\u0932  \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \n\u092f\u093e\u091a\u093f\u0915\u093e  \u092c\u093f\u0928\u0936\u0930\u094d\u0924 \u092e\u093e\u0917\u0947 \u0918\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u0947\u0924 \u0906\u0939\u094b\u0924. \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u093e \u0915\u094d\u0930.\u096a \u091a\u093e \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0924\u093e, \u0915\u094b\u0923\u0940\u0939\u0940 \u0939\u091c\u0930 \n\u091d\u093e\u0932\u0947\u0932\u0947 \u0928\u093e\u0939\u0940. \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930\u091a\u094d\u092f\u093e \u0918\u0921\u093e\u092e\u094b\u0921\u0940  \u0906\u0923\u093f \u0905\u0928\u094d\u092f\u0925\u093e \u0938\u0941\u0926\u094d\u0927\u093e  \u0915\u094b\u0923\u0940\u0939\u0940 \u0909\u092a\u0938\u094d\u0925\u093f\n\u0924 \u0930\u093e\u0939\u093f\u0932\u0947\u0932\u0947 \u0928\u093e\u0939\u0940  \u0939\u0947 \u0935\u093f\u091a\u093e\u0930\u093e\u0924 \n\u0918\u0947\u0924\u093e, \u0938\u0927\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e \u092b\u0947\u091f\u093e\u0933\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947, \u091c\u0947\u0925\u0947 \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940  \u092f\u093e\u091a\u093f\u0915\u093e (\u0938\u0940)  \u0915\u094d\u0930. \n\u096a\u096a\u0968\u096e/\u0968\u0966\u0967\u096c \u092e\u0927\u094d\u092f\u0947 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u0947 \u0915\u094d\u0930. \u096a \u0906\u0939\u0947\u0924.\n\n\u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e \n \n (  \u0926\u093f  )....\n \n \u0938\u0940\u0938\u0940 \u0915\u094d\u0930\n \n .   \u096a\u096f\u0968\u0968\n \n / \u0968\u0966\u0967\u096c\n \n \n \u0935\u093f\u0932\u0902\u092c \u092e\u093e\u092b. \u092c\u0926\u0932\u0940 \u0905\u0930\u094d\u091c \u092e\u0902\u091c\u0942\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092f\u093e\u091a\u093f\u0915\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\n\u091a\u094d\u092f\u093e \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0935\u093e\u0930\u0938\u093e\u0902\u091a\u0940 \n\u0928\u093e\u0935\u0947 \u0930\u0947\u0915\u0949\u0930\u094d\u0921\u0935\u0930 \u0918\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u092a\u0915\u094d\u0937\u0915\u093e\u0930\u093e\u0902\u091a\u094d\u092f\u093e \u092e\u0947\u092e\u094b\u092e\u0927\u094d\u092f\u0947 \u0924\u094d\u092f\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0938\u0941\u0927\u093e\u0930\u0923\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092f\u093e\u0935\u0940. \u096b. \n\u0935\u093f\u0936\u0947\u0937  \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f) \u0915\u094d\u0930\u2026. \u0938\u0940\u0938\u0940 \u0915\u094d\u0930. \u096a\u096f\u0968\u0968/\u0968\u0966\u0967\u096c \u0916\u093e\u0932\u0940\u0932\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0928\u093f\u0915\u093e\u0932\u0940 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \n\u0906\u0939\u0947 :-\n(i) \u092f\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f\u093e\u0928\u0947 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0923\u094d\u092f\u093e\u091a\u093e ,\u091c\u094b \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b \u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0939\u094b\u0924\u093e \u0906\u0923\u093f \u0928\u0935\u0940\u0928 \n\u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u0905\u0902\u092e\u0932\u093e\u0924 \u0906\u0923\u0932\u093e \u091c\u093e\u0924 \u0906\u0939\u0947/\u0915\u0947\u0932\u093e \u091c\u093e\u0924 \u0906\u0939\u0947 \u092f\u093e\u091a\u0940 \u0928\u094b\u0902\u0926 \u0918\u0947\u0924\u0932\u0940 \u0906\u0939\u0947.  \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928\u093e\u0928\u0947 \n\u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930\u093e\u091a\u0940 \u092a\u094d\u0930\u0924 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u092d\u093e\u0921\u0947\u0915\u0930\u0942\u0902\u0928\u093e \u0926\u0947\u0923\u0947 \u0917\u0930\u091c\u0947\u091a\u0947 \u0906\u0939\u0947.   \u091c\u0930 \u092d\u093e\u0921\u0947\u0915\u0930\u0942\u0902\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092d\u093e\u0921\u0947\u0915\u0930\u0942 \n\u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930\u093e\u091a\u094d\u092f\u093e \u0905\u091f\u0940 \u0935 \u0936\u0930\u094d\u0924\u0940\u0902 \u092c\u093e\u092c\u0924 \u0905\u0938\u092e\u093e\u0927\u093e\u0928\u0940 \u0905\u0938\u0947\u0932,  \u0924\u0930 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u0906\u0923\u093f \n\u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u0947\u0928\u0941\u0938\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u093e\u0924  \u0918\u0947\u0924\u0932\u0947\u0932\u094d\u092f\u093e  \u092f\u094b\u0917\u094d\u092f \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f /\u092e\u0902\u091a \u0938\u092e\u094b\u0930  \u0906\u0935\u094d\u0939\u093e\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u092e\u0941\u092d\u093e \u0905\u0938\u0947\u0932;\n(ii) \u0909\u0924\u094d\u0924\u0930\u0935\u093e\u0926\u0940 \u0915\u094d\u0930. \u096b, \u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0928\u0947 \u0905\u0938\u0932\u0947\u0932\u093e \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930  \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928/ \u092e\u094d\u0939\u093e\u0921\u093e \u092f\u093e\u0902\u0928\u0940 \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \n\u0906\u0923\u0932\u093e,  \u0924\u094d\u092f\u093e  \u0938\u0902\u0926\u0930\u094d\u092d\u093e\u0924 \u0924\u094d\u092f\u093e\u0902\u0928\u093e \u0938\u0926\u0930 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u0938\u0902\u092a\u0941\u0937\u094d\u091f\u093e\u0924 \u0906\u0923\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0906\u0923\u093f \u0905\u092e\u0932\u093e\u0924 \u092f\u0947\u0924 \u0905\u0938\u0932\u0947\u0932\u093e \n\u0928\u0935\u0940\u0928 \u0935\u093f\u0915\u093e\u0938 \u0915\u0930\u093e\u0930 \u092f\u093e\u0938 \u092f\u094b\u0917\u094d\u092f \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f /\u092e\u0902\u091a \u0938\u092e\u094b\u0930 \u0906\u0935\u094d\u0939\u093e\u0928 \u0926\u0947\u0923\u094d\u092f\u093e\u091a\u0940\u0939\u0940 \u092e\u0941\u092d\u093e \u0905\u0938\u0947\u0932 \u0906\u0923\u093f \u0916\u094b\u091f\u0940 \u0938\u093e\u0915\u094d\u0937\u0940 \n\u0905\u0930\u094d\u091c\u093e\u092e\u0927\u094d\u092f\u0947 \u0928\u092e\u0942\u0926 \u0915\u0947\u0932\u0947\u0932\u0940 \u0915\u093e\u0930\u0923\u0947 \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u0906\u0923\u093f \u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u0947\u0928\u0941\u0938\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u093e\u0924 \u0918\u0947\u0923\u094d\u092f\u093e\u0924 \u092f\u093e\u0935\u0940\u0924.\n\u096c. \u0938\u0927\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f) \u0915\u094d\u0930. \u096a\u096a\u0968\u096e/\u0968\u0966\u0967\u096c \u0935\u0930\u0940\u0932 \u092c\u093e\u092c\u0940\u0902\u0928\u0941\u0938\u093e\u0930 \u0906\u0923\u093f \u0935\u0930\u0940\u0932 \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923\u093e\u0902\u0938\u0939 \n\u092e\u093e\u0917\u0947 \u0918\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u092e\u094d\u0939\u0923\u0942\u0928 \u092b\u0947\u091f\u093e\u0933\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947 \u0906\u0923\u093f \u0935\u093f\u0936\u0947\u0937 \u0905\u0928\u0941\u092e\u0924\u0940 \u092f\u093e\u091a\u093f\u0915\u093e (\u0926\u093f) \u0915\u094d\u0930\u2026 \u0938\u0940\u0938\u0940 \u0915\u094d\u0930. \n\u096a\u096f\u0968\u0968/\u0968\u0966\u0967\u096c \u0926\u0947\u0916\u0940\u0932 \u0935\u0930\u0940\u0932 \u092c\u093e\u092c\u0940\u0902\u0928\u0941\u0938\u093e\u0930 \u0906\u0923\u093f \u0928\u093f\u0930\u0940\u0915\u094d\u0937\u0923\u093e\u0938\u0939 \u0928\u093f\u0915\u093e\u0932\u0940 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940  \u0906\u0939\u0947. \n\u096d.  \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0905\u0930\u094d\u091c, \u091c\u0930 \u0915\u093e\u0939\u0940 \u0905\u0938\u0924\u0940\u0932, \u0924\u0930 \u0924\u0947 \u0928\u093f\u0915\u093e\u0932\u0940 \u0915\u093e\u0922\u0932\u0947 \u091c\u093e\u0924\u0940\u0932.\n\n                    \n (\u090f\u092e. \u0906\u0930. \u0936\u093e\u0939) \u2026\u2026\u2026 ..\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u0940\n                      \n (\u0938\u0940.\u091f\u0940.  \u0930\u0935\u093f\u0915\u0941\u092e\u093e\u0930)\u2026. \u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u0940\n                      \n(\u0938\u0902\u091c\u092f \u0915\u0930\u094b\u0932).............\u0928\u094d\u092f\u093e\u092f\u092e\u0942\u0930\u094d\u0924\u0940\n \u0928\u0935\u0940 \u0926\u093f\u0932\u094d\u0932\u0940, \n\u0967\u096d \u092b\u0947\u092c\u094d\u0930\u0941\u0935\u093e\u0930\u0940, \u0968\u0966\u0968\u0969..\n      XXXXXX\n     \u0905\u0938\u094d\u0935\u0940\u0915\u0930\u0923\n   \u092f\u093e \u0928\u094d\u092f\u093e\u092f\u0928\u093f\u0930\u094d\u0923\u092f\u093e\u091a\u094d\u092f\u093e \u092e\u0930\u093e\u0920\u0940 \u092d\u093e\u0937\u0947\u0924\u0940\u0932 \u092f\u093e \u0905\u0928\u0941\u0935\u093e\u0926\u093e\u091a\u093e \u0935\u093e\u092a\u0930 \u0939\u093e \u092a\u0915\u094d\u0937\u0915\u093e\u0930\u093e\u0938 \u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e/ \u0924\u093f\u091a\u094d\u092f\u093e \u092e\u093e\u0924\u0943\u092d\u093e\u0937\u0947\u092e\u0927\u094d\u092f\u0947 \n\u0924\u094d\u092f\u093e\u091a\u093e \u0905\u0930\u094d\u0925 \u0938\u092e\u091c\u0942\u0928 \u0918\u0947\u0923\u094d\u092f\u093e\u092a\u0941\u0930\u0924\u093e\u091a \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0930\u093e\u0939\u0940\u0932 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u091a\u093e \u0907\u0924\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0915\u093e\u0930\u0923\u093e\u0915\u0930\u0924\u093e \u0935\u093e\u092a\u0930  \u0915\u0930\u0924\u093e \n\u092f\u0947\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.  \u0924\u0938\u0947\u091a \u0907\u0902\u0917\u094d\u0930\u091c\u0940 \u092d\u093e\u0937\u0947\u0924\u0940\u0932 \u0928\u094d\u092f\u093e\u092f\u0928\u093f\u0930\u094d\u0923\u092f \u0939\u093e\u091a \u0938\u0930\u094d\u0935 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0915 \u0906\u0923\u093f \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f\u0940\u0928 \u0935\u093e\u092a\u0930\u093e\u0915\u0930\u093f\u0924\u093e \n\u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0905\u0938\u0947\u0932 \u0906\u0923\u093f \u0924\u094b\u091a \u0924\u094d\u092f\u093e\u0924\u0940\u0932 \u0906\u0926\u0947\u0936\u093e\u091a\u094d\u092f\u093e \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u0928 \u0906\u0923\u093f \u0905\u0902\u092e\u0932\u092c\u091c\u093e\u0935\u0923\u0940\u0915\u0930\u0940\u0924\u093e \u0935\u0948\u0926\u094d\u092f \u092e\u093e\u0928\u0932\u093e \u091c\u093e\u0908\u0932.\n         XXXXXX \n"
