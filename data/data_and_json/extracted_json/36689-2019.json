    "full_text": "1 \n \n \u0905\u092a\u094d\u0930\u093f\u0924\u0935 \n\u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0935\u0156\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932\u0940\u092f \u0905\u093f\u0927\u0915\u093e\u012f\u0930\u0924\u093e  \n \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1051/2022  \n[ \u093f\u0935.\u0905.\u092f\u093e. (\u0906\u092a.) \u0938\u0902. 9567/2019 \u0938\u0947 \u0909\u020b\u0244 ] \n \n\u090f\u0938 \u0915\u0947 \u091f\u094b\u0902\u093f\u0917\u092f\u093e      \n     \u0905\u092a\u0940\u0932\u093e\u0925\u014e(\u0917\u0923) \n\u092c\u0928\u093e\u092e \n \n\u0915\u0150 \u0926\u094d\u0930 \u0905\u024b\u0947\u0937\u0923 \u026f\u0942\u0930\u094b     \n\u092a\u094d\u0930\u014e(\u0917\u0923) \n \n \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1053/2022  \n[ \u093f\u0935.\u0905.\u092f\u093e. (\u0906\u092a.) \u0938\u0902. 10342/2019 \u0938\u0947 \u0909\u020b\u0244 ] \n \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1054/2022  \n[ \u093f\u0935.\u0905.\u092f\u093e. (\u0906\u092a.) \u0938\u0902. 1798/2022 \u0938\u0947 \u0909\u020b\u0244 ] \n \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1055/2022  \n[ \u093f\u0935.\u0905.\u092f\u093e. (\u0906\u092a.) \u0938\u0902. 729/2022 \u0938\u0947 \u0909\u020b\u0244 ] \n \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1056/2022  \n[ \u093f\u0935.\u0905.\u092f\u093e. (\u0906\u092a.) \u0938\u0902. 9829/2019 \u0938\u0947 \u0909\u020b\u0244 ] \n \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1057/2022  \n[ \u093f\u0935.\u0905.\u092f\u093e. (\u0906\u092a.) \u0938\u0902. 10015/2019 \u0938\u0947 \u0909\u020b\u0244 ] \n \n\u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902. 1058/2022  \n[ \u093f\u0935.\u0905.\u092f\u093e. (\u0906\u092a.) \u0938\u0902. 10629/2019 \u0938\u0947 \u0909\u020b\u0244 ] \n\n2 \n \n\u093f\u0928\u0923\u014a\u092f \n \n\u024a\u093e. \u092c\u0940. \u0906\u0930. \u0917\u0935\u0908 \n1. \u0905\u0928\u0941\u092e\u093f\u0924 \u092a\u094d\u0930\u0926\u093e\u093f\u0964 \n2. \u0905\u092a\u0940\u0932\u093e\u0925\u014e\u0917\u0923 \u0928\u0947 \u093f\u0926\u029f\u0940 \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u022a\u093e\u0930\u093e \u093f\u0926\u0928\u093e\u0902\u0915 29 \u091c\u0941\u0932\u093e\u0908, \n2019 \u0915\u094b \u092a\u093e\u012f\u0930\u0924 \u093f\u0928\u0923\u014a\u092f \u0938\u0947 \u02a9\u093f\u0925\u0924 \u0939\u094b\u0915\u0930 \u0907\u0938 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u093e \n\u0926\u0930\u0935\u093e\u091c\u093e \u0916\u091f\u0916\u091f\u093e\u092f\u093e \u0939\u0948, \u093f\u091c\u0938\u0915\u0947 \u022a\u093e\u0930\u093e \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u093f\u0935\u022a\u093e\u0928 \n\u090f\u0915\u0932 \u024a\u093e\u092f\u093e\u0927\u0940\u0936 \u0928\u0947 \u093f\u0935\u0936\u0947\u0937 \u024a\u093e\u092f\u093e\u0927\u0940\u0936 (\u092a\u0940\u0938\u0940 \u0905\u093f\u0927\u093f\u0928\u092f\u092e)/ \n\u0938\u0940\u092c\u0940\u0906\u0908-01, \u093f\u091c\u0932\u093e \u0928\u0908 \u093f\u0926\u029f\u0940, \u092a\u093f\u091f\u092f\u093e\u0932\u093e \u0939\u093e\u0909\u0938 \u0915\u094b\u091f\u014a, \u0928\u0908 \n\u093f\u0926\u029f\u0940 \u022a\u093e\u0930\u093e \u093f\u0926\u0928\u093e\u0902\u0915 7 \u0905\u0183\u0942\u092c\u0930, 2015 \u0915\u094b \u092a\u093e\u012f\u0930\u0924 \u0906\u0926\u0947\u0936 \u0915\u094b \n\u0905\u092a\u093e\u02d1 \u0915\u0930 \u093f\u0926\u092f\u093e \u0925\u093e\u0964 \n3. \u093f\u0935\u022a\u093e\u0928 \u093f\u0935\u0936\u0947\u0937 \u024a\u093e\u092f\u093e\u0927\u0940\u0936 \u0928\u0947 \u093f\u0926\u0928\u093e\u0902\u0915 7 \u0905\u0183\u0942\u092c\u0930 2015 \u0915\u094b \u092a\u093e\u012f\u0930\u0924 \n\u0905\u092a\u0928\u0947 \u0906\u0926\u0947\u0936 \u022a\u093e\u0930\u093e \u092a\u093e\u0901\u091a\u094b\u0902 \u0905\u093f\u092d\u092f\u0941\u0185\u094b\u0902 \u0915\u094b \u092d\u093e\u0930\u0924\u0940\u092f \u0926\u0902\u0921 \u0938\u0902\u093f\u0939\u0924\u093e \n1860 (\u0938\u0902\u0197\u0947\u092a \u092e\u0150 \u2018\u092d\u093e.\u0926\u0902.\u0938\u0902.') \u0915\u0940 \u0927\u093e\u0930\u093e 120\u0916 \u0938\u0939-\u092a\u093f\u0920\u0924 \u092d\u094d\u0930\ufffd\u093e\u091a \n\u093f\u0928\u0935\u093e\u0930\u0923 \u0905\u093f\u0927\u093f\u0928\u092f\u092e, 1988 (\u0938\u0902\u0197\u0947\u092a \u092e\u0150 '\u092a\u0940\u0938\u0940 \u0905\u093f\u0927\u093f\u0928\u092f\u092e') \u0915\u0940 \u0927\u093e\u0930\u093e \n13(2) \u090f\u0935\u0902 13(1)(\u0918) \u0924\u0925\u093e \u092d\u093e.\u0926\u0902.\u0938\u0902. \u0915\u0940 \u0927\u093e\u0930\u093e 420, 465, 468 \u0935 \n471 \u0915\u0947 \u0905\u0902\u0924\u0917\u014a\u0924 \u0926\u0902\u0921\u0928\u0940\u092f \u0905\u092a\u0930\u093e\u0927\u094b\u0902 \u0939\u0947\u0924\u0941 \u0906\u0930\u094b\u092a \u093f\u0935\u0930\u093f\u091a\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \n\u093f\u0928\u0926\u0151\u0936 \u093f\u0926\u092f\u093e \u0925\u093e\u0964 \u0907\u0938\u0915\u0947 \u0905\u093f\u0924\u012f\u0930\u0185 \u024a\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u0915\u0941\u091b \u0905\u093f\u092d\u092f\u0941\u0185\u094b\u0902 \n\n3 \n \n\u0915\u094b \u092a\u0940\u0938\u0940 \u0905\u093f\u0927\u093f\u0928\u092f\u092e \u0915\u0940 \u0927\u093e\u0930\u093e 13(2) \u0938\u0939-\u092a\u093f\u0920\u0924 \u0927\u093e\u0930\u093e 13(1)(\u0918) \n\u090f\u0935\u0902 \u092d\u093e.\u0926\u0902.\u0938\u0902. \u0915\u0940 \u0927\u093e\u0930\u093e 420, 465, 468 \u0935 471 \u0915\u0947 \u0924\u0939\u0924 \u0906\u0930\u094b\u092a \n\u093f\u0935\u0930\u093f\u091a\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u092d\u0940 \u093f\u0928\u0926\u0151\u0936 \u093f\u0926\u092f\u093e \u0925\u093e\u0964 \u0939\u093e\u0932\u093e\u0902\u093f\u0915, \u091c\u0939\u093e\u0901 \u0924\u0915 \n\u0935\u0924\u014a\u092e\u093e\u0928 \u0905\u093f\u092a\u0932\u093e\u093f\u0925\u014a\u092f\u094b\u0902 \u0915\u093e \u0938\u0902\u092c\u0902\u0927 \u0939\u0948, \u093f\u0935\u022a\u093e\u0928 \u093f\u0935\u0936\u0947\u0937 \u024a\u093e\u092f\u093e\u0927\u0940\u0936 \u0928\u0947 \n\u0905\u093f\u092d\u092f\u0941\u0185\u0917\u0923 \u0915\u094b \u0909\u0249\u094b\u093f\u091a\u0924 \u0915\u0930 \u093f\u0926\u092f\u093e \u0925\u093e\u0964 \n4. \u0907\u0938\u0938\u0947 \u02a9\u093f\u0925\u0924 \u0939\u094b\u0915\u0930 \u092a\u094d\u0930\u014e\u0917\u0923- \u0915\u0947\u023e\u0940\u092f \u0905\u024b\u0947\u0937\u0923 \u026f\u0942\u0930\u094b \n(\u0938\u0940\u092c\u0940\u0906\u0908) \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0905\u093f\u092d\u092f\u0941\u0185\u0917\u0923, \u093f\u091c\u0928\u0915\u0947 \u093f\u0935\u015c\u0220 \u0906\u0930\u094b\u092a \n\u093f\u0935\u0930\u093f\u091a\u0924 \u093f\u0915\u090f \u0917\u090f \u0925\u0947, \u0928\u0947 \u093f\u0926\u029f\u0940 \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u092e\u0150 \u092a\u0941\u0928\u0930\u0940\u0197\u0923 \n\u092f\u093e\u093f\u091a\u0915\u093e\u090f\u0901 \u0926\u093e\u092f\u0930 \u0915\u0940 \u0925\u0940\u0964 \u0906\u0197\u0947\u093f\u092a\u0924 \u093f\u0928\u0923\u014a\u092f \u022a\u093e\u0930\u093e, \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \n\u093f\u0935\u022a\u093e\u0928 \u090f\u0915\u0932 \u024a\u093e\u092f\u093e\u0927\u0940\u0936 \u0928\u0947 \u093f\u0926\u0928\u093e\u0902\u0915 7 \u0905\u0183\u0942\u092c\u0930, 2015 \u0915\u0947 \u0906\u0926\u0947\u0936 \n\u0915\u094b \u0905\u092a\u093e\u02d1 \u0915\u0930 \u0905\u0927\u0940\u0928\u033e\u0925 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u093f\u0928\u0926\u0151\u0936 \u093f\u0926\u092f\u093e \u093f\u0915 \u0935\u0939 \n\u093f\u0926\u0928\u093e\u0902\u0915 20 \u0905\u0183\u0942\u092c\u0930, 2008 \u0915\u094b \u092d\u093e\u0930\u0924\u0940\u092f \u093f\u091a\u093f\u0915\u0216\u093e \u092a\u012f\u0930\u0937\u0926 \n(\u090f\u092e.\u0938\u0940.\u0906\u0908.) \u022a\u093e\u0930\u093e \u093f\u0915\u090f \u0917\u090f \u093f\u0928\u0930\u0940\u0197\u0923 \u0915\u0940 \u0935\u0940\u093f\u0921\u092f\u094b\u0917\u094d\u0930\u093e (\u093f\u091c\u0938\u0947 \n\u092c\u093e\u0926 \u092e\u0150 \u0938\u0940\u092c\u0940\u0906\u0908 \u0928\u0947 \u091c\u0267 \u0915\u0930 \u093f\u0932\u092f\u093e \u0925\u093e) \u0915\u0940 \u092a\u093f\u0924 \u0938\u092d\u0940 \n\u0905\u093f\u092d\u092f\u0941\u0185\u0917\u0923 \u0915\u094b \u093f\u0935\u093f\u0927\u0935\u0924 \u015d\u092a \u0938\u0947 \u092a\u094d\u0930\u0926\u093e\u0915\u0930 \u0938\u092d\u0940 \u092a\u0197\u094b\u0902 \u0915\u094b \n\u0917\u0941\u0923\u093e\u0917\u0941\u0923 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0928\u090f \u093f\u0938\u0930\u0947 \u0938\u0947 \u0938\u0941\u0928\u0947\u0964 \n\n4 \n \n5. \u0905\u092a\u0940\u0932\u093e\u0925\u014e\u0917\u0923 \u0915\u0947 \u093f\u0935\u022a\u093e\u0928 \u0905\u093f\u0927\u0935\u0185\u093e \u0915\u093e \u092a\u094d\u0930\u093f\u0924\u0935\u093e\u0926 \u0939\u0948 , \u092f\u0228\u093f\u092a \n\u0905\u092a\u0928\u0947 \u093f\u0935\u02d1\u0943\u0924 \u0906\u0926\u0947\u0936 \u022a\u093e\u0930\u093e \u093f\u0935\u022a\u093e\u0928 \u093f\u0935\u091a\u093e\u0930\u0923 \u024a\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u092f\u0939 \u092a\u093e\u092f\u093e \n\u0925\u093e \u093f\u0915 \u0905\u092a\u0940\u0932\u093e\u0925\u014e\u0917\u0923 \u0915\u0947 \u0130\u0916\u0932\u093e\u095e \u092a\u094d\u0930\u0925\u092e\ufffd\ufffd \u0915\u094b\u0908 \u092e\u093e\u092e\u0932\u093e \u0928\u0939\u0940\u0902 \n\u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u093f\u0915\u0236\u0941 \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u093f\u092c\u0928\u093e \u0915\u094b\u0908 \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f \n\u0909\u0928\u0915\u0947 \u0909\u0249\u094b\u091a\u0928 \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u094b \u0905\u092a\u093e\u02d1 \u0915\u0930 \u093f\u0926\u092f\u093e \u0939\u0948\u0964 \u0935\u0947 \u092a\u094d\u0930\ufffd\u0941\n\u0915\u0930\u0924\u0947 \u0939\u0153 \u093f\u0915 \u0909\u0928\u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092f\u093f\u0926 \u0909\u0249\u094b\u091a\u0928 \u0915\u0947 \u0906\u0926\u0947\u0936 \u0915\u094b \u092a\u0932\u091f\u0928\u093e \n\u0939\u0940 \u0925\u093e \u0924\u094b \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e \u092f\u0939 \u0905\u092a\u0947\u0197\u093e \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \n\u093f\u0915 \u0935\u0939 \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u090f \u093f\u0915 \u0909\u024e\u0150 \u0905\u0927\u0940\u0928\u033e\u0925 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0906\u0926\u0947\u0936 \u092e\u0150 \n\u0924\u094d\u0930\u0941 \u0190\u094b\u0902 \u093f\u092e\u0932\u0940 \u0924\u0925\u093e \u0905\u092a\u0940\u0932\u093e\u0925\u014e\u0917\u0923 \u0915\u0947 \u0130\u0916\u0932\u093e\u095e \u092a\u094d\u0930\u0925\u092e\ufffd\ufffd \u092e\u093e\u092e\u0932\u093e \n\u0190\u094b\u0902 \u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e\u0964 \n6. \u093f\u0935\u022a\u093e\u0928 \u0905\u093f\u0924\u012f\u0930\u0185 \u092e\u0939\u093e-\u0938\u093e\u093f\u0932\u093f\u0938\u091f\u0930 \u0936\u094d \u090f\u0938. \u0935\u0940. \u0930\u093e\u091c\u0942 \u0928\u0947 \u0905\u092a\u0940\u0932\u094b\u0902 \u0915\u093e \n\u093f\u0935\u0930\u094b\u0927 \u093f\u0915\u092f\u093e \u0939\u0948\u0964 \u0909\u024e\u094b\u0902\u0928\u0947 \u093f\u0928\u0935\u0947\u0926\u0928 \u093f\u0915\u092f\u093e \u0939\u0948 \u093f\u0915 \u0906\u0197\u0947\u093f\u092a\u0924 \u093f\u0928\u0923\u014a\u092f \n\u022a\u093e\u0930\u093e, \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u093f\u0935\u022a\u093e\u0928 \u090f\u0915\u0932 \u024a\u093e\u092f\u093e\u0927\u0940\u0936 \u0928\u0947 \u0915\u0947\u0935\u0932 \u092e\u093e\u092e\u0932\u0947 \n\u0915\u094b \u093f\u0935\u091a\u093e\u0930\u0923 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u092a\u094d\u0930\u093f\u0924\u092a\u094d\u0930\u0947\u093f\u0937\u0924 \u0915\u0930 \u093f\u0939\u0948\u0964 \u0909\u024e\u094b\u0902\u0928\u0947 \n\u093f\u0928\u0935\u0947\u0926\u0928 \u093f\u0915\u092f\u093e \u0939\u0948 \u093f\u0915 \u0907\u0928 \u0938\u092d\u0940 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u093f\u0924\u092a\u094d\u0930\u0947\u0937\u0923\u0905\u0927\u0940\u0928\u033e\u0925 \n\u024a\u093e\u092f\u093e\u0932\u092f \u022a\u093e\u0930\u093e \u0907\u0928 \u092a\u0930 \u093f\u0935\u091a\u093e\u0930 \u093f\u0915\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u0924\u0925\u093e \u0907\u0938 \u092a\u094d\u0930\u0915, \n\u0905\u092a\u0940\u0932\u093e\u0925\u014e\u0917\u0923 \u092a\u0930 \u0915\u094b\u0908 \u092a\u094d\u0930\u093f\u0924\u0915 \u092a\u094d\u0930\u092d \u0928\u0939\u0940\u0902 \u092a\u095c\u0947\u0917\u093e\u0964 \u0909\u024e\u094b\u0902\u0928\u0947 \u092f\u0939 \n\n5 \n \n\u092d\u0940 \u092a\u094d\u0930\ufffd\u0941\u0924 \u093f\u0915\u092f\u093f\u0915 \u091c\u0939\u093e\u0902 \u0924\u0915 \u0915\u0941\u091b \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0150 \u0935\u0940\u093f\u0921\u092f\u094b\u0917\u094d\u0930\u093e \u0915\u0940 \n\u092a\u094d\u0930\u093f\u0924\u092f \u0915\u0940 \u0906\u092a\u0942\u093f\u0924\u014a \u0915\u0930\u0928\u0947 \u0915\u0947 \u093f\u0928\u0926\u0151\u0936 \u0915\u093e \u0938\u0902\u092c\u0902\u0927 \u0939\u0948, \u0915\u0941\u091b \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0150 \n\u0935\u0940\u093f\u0921\u092f\u094b\u0917\u094d\u0930\u093e \u0915\u0940 \u0915\u094b\u0908 \u092a\u094d\u0930 \u0909\u092a\u0932\u0269 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \n7. \u0939\u092e\u0928\u0947 \u0906\u0197\u0947\u093f\u092a\u0924 \u093f\u0928\u0923\u014a\u092f \u0915\u093e \u0905\u0935\u0932\u094b\u0915\u0928 \u093f\u0915\u092f\u093e \u0939\u0948\u0964 \u0939\u093e\u0932\u093e\u0901\u093f\u0915 \u0909\u01c4 \n\u024a\u093e\u092f\u093e\u0932\u092f \u022a\u093e\u0930\u093e 66 \u0905\u0928\u0941\u01c5\u0947\u0926\u094b\u0902 \u0915\u093e \u093f\u0928\u0923\u014a\u092f \u093f\u0932\u0916\u0928\u0947 \u0915\u093e \u0936\u094d\u0930\u092e \u093f\u0915 \n\u0917\u092f\u093e \u0939\u0948 \u0932\u0947\u093f\u0915\u0928 \u0909\u0938\u092e\u0150 \u0907\u0938 \u092c\u093e\u0924 \u0915\u093e \u0915\u094b\u0908 \u0924\u0915\u014a  \u0928\u0939\u0940\u0902 \u093f\u0926\u092f\u093e \u0939\u0948 \u093f\u0915 \n\u0909\u024e\u0150 \u0905\u092a\u0940\u0932\u093e\u0925\u014e\u0917\u0923 \u0915\u094b \u0909\u0249\u094b\u093f\u091a\u0924 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u093f\u0935\u022a\u093e\u0928 \u093f\u0935\u091a\u093e\u0930\u0923 \n\u024a\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0906\u0926\u0947\u0936 \u092e\u0150 \u0915\u094b\u0908 \u0924\u094d\u0930\u0941 \u0190\u094b\u0902 \u093f\u092e\u0932\u0940\u0964 \u0906\u0197\u0947\u093f\u092a\u0924 \u093f\u0928\u0923\u014a\u092f \n\u022a\u093e\u0930\u093e \u0905\u092a\u0940\u0932\u093e\u0925\u014e\u0917\u0923 \u0915\u0947 \u092a\u0197 \u0915\u094b \u092a\u094d\u0930\u093e\u0909\u0249\u094b\u091a\u0928 \u0915\u093e \u090f\u0915 \u0905\u0939\u092e \n\u0905\u093f\u0927\u0915\u093e\u0930 \u093f\u092c\u0928\u093e \u093f\u0915\u0938\u0940 \u0915\u093e\u0930\u0923 \u092c\u0924\u093e\u092f\u0947 \u091b\u0940\u0928 \u093f\u0932\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964  \n8. \u0907\u0938 \u0938\u0902\u093f\u0197\ufffd \u0906\u0927\u093e\u0930 \u092a\u0930 \u0939\u092e \u0906\u0197\u0947\u093f\u092a\u0924 \u093f\u0928\u0923\u014a\u092f \u0915\u094b \u0930\u021e \u090f\u0935\u0902 \u0905\u092a\u093e\u02d1 \n\u093f\u0915\u092f\u0947 \u091c\u093e\u0928\u0947 \u092f\u094b\u01b6 \u092a\u093e\u0924\u0947 \u0939\u0153\u0964 \n9. \u092a\u012f\u0930\u0923\u093e\u092e \u02e2\u015d\u092a, \u0939\u092e \u0905\u092a\u0940\u0932\u094b\u0902 \u0915\u094b \u02e2\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0153\u0964 \u093f\u0926\u0928\u093e\u0902\u0915 29 \n\u091c\u0941\u0932\u093e\u0908, 2019 \u0915\u0947 \u0906\u0197\u0947\u093f\u092a\u0924 \u093f\u0928\u0923\u014a\u092f \u0915\u094b \u0930\u021e \u090f\u0935\u0902 \u0905\u092a\u093e\u02d1 \u093f\u0915\u092f\u093e \u091c\u093e\u0924\u093e \n\u0939\u0948\u0964 \u0907\u0928 \u092e\u093e\u092e\u0932\u094b\u0902 \u0915\u094b \u0917\u0941\u0923\u093e\u0917\u0941\u0923 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0928\u090f \u093f\u0938\u0930\u0947 \u0938\u0947 \u093f\u0935\u091a\u093e\u0930 \n\u0915\u0930\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f \u090f\u0935\u0902 \u0909\u092a\u0930\u094b\u0185 \u093f\u091f\u0254\u093f\u0923\u092f\u094b\u0902 \u0915\u0947 \u0906\u0932\u094b\u0915 \u092e\u0150 \u093f\u0935\u093f\u0927 \n\n6 \n \n\u0905\u0928\u0941\u0938\u093e\u0930 \u093f\u0928\u0923\u014a\u092f \u0932\u0947\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u094b \u0935\u093e\u092a\u0938 \u092a\u094d\u0930\u0947\u093f\u0937\n\u093f\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \n10. \u091c\u0939\u093e\u0901 \u0924\u0915 \u0915\u0941\u091b \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0150 \u0935\u0940\u093f\u0921\u092f\u094b\u0917\u094d\u0930\u093e\u092b\u0940 \u0915\u0940 \u092a\u094d\u0930\u093f\u0924\u092f\u094b \n\u0905\u0928\u0941\u092a\u0932\u0269\u0924\u093e \u0915\u0947 \u093f\u0935\u0937\u092f \u092e\u0150 \u092a\u094d\u0930\u014e-\u0938\u0940\u092c\u0940\u0906\u0908 \u0915\u0947 \u092a\u094d\u0930\u093f\u0924\u0935\u093e\u0926 \u0915\u093e \u0938\ufffd\n\u0939\u0948, \u092a\u094d\u0930\u014e-\u0938\u0940\u092c\u0940\u0906\u0908 \u092f\u0939 \u0924\u021a \u0909\u01c4 \u024a\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u0197 \u092a\u094d\u0930\ufffd\u0941\n\u0915\u0930\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f \u02e2\u0924\u0902\u0924 \u0939\u0948 \u090f\u0935\u0902 \u0907\u0938 \u092a\u0930 \u093f\u0935\u093f\u0927 \u0905\u0928\u0941\u0938\u093e\u0930 \u093f\u0935\u091a\u093e\u0930 