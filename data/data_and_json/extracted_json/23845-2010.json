    "full_text": "1 \n \n                  \n \n \n \n \u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902 665-666 \u0911\u092b 2011 \n[\u0917\u0948\u0930-\u1cef\u0930\u092a\u094b\u091f\u1b45\u092f\u094b\u1b4f\u092f]        \n\u092d\u093e\u0930\u0924 \u0915\u0947 \u0909\u1cac\u0924\u092e \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u092e\u1c76 \n          \u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u1b60\u092f\u093e\u092f\u093e\u093f\u0927\u0915\u0930\u0923 \n        \u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \u0938\u0902 665-666 \u0911\u092b 2011 \n \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939 \u0914\u0930 \u0905\u1b60\u092f                                             ......\u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923  \n               \u092c\u0928\u093e\u092e \n\u0939\u1cef\u0930\u092f\u093e\u0923\u093e \u0930\u093e\u1b54\u092f \n \n                                          \u2026..... \u0909\u1c6b\u0930\u0926\u093e\u0924\u093e\u0917\u0923 \n                \u093f\u0928\u0923\u1b45\u092f  \n\u0930\u093e\u091c\u0947\u0936 \u1cf2\u092c\u0926\u0932, \u091c\u0947. \n1. \u0936\u0941\u1c67\u0906\u0924 \u092e\u1c76, \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u0947 \u093f\u0935\u1cc7\u093e\u0928 \u0905\u093f\u0927\u0935\u1ca6\u093e \u0928\u0947 \u1ba7\u1b6d\u0924\u0941\u0924 \u1cf0\u0915\u092f\u093e \u1cf0\u0915 \n\u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939 \u092a\u0941\u1ba2 \u091c\u0940\u0935\u0928 \u1cf2\u0938\u0939 \u0907\u0938 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u1b43 \u0905\u092a\u0940\u0932 \u0915\u0947 \u0932\u0902\u093f\u092c\u0924 \n\u0930\u0939\u0928\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u092e\u0943\u1b5c\u092f\u0941 \u0939\u094b \u091c\u093e\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923, \u0909\u0938\u0915\u1cf1 \u0905\u092a\u0940\u0932 \u0938\u092e\u093e\u1cd9 \u0939\u094b \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \n2. \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u1cf1 \u0926\u094b\u0937\u093f\u0938\u093f\u1ccd \u0915\u094b \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u092c\u0930\u0915\u0930\u093e\u0930 \u0930\u0916\u0947 \u091c\u093e\u0928\u0947 \n\u0915\u0947 \u092c\u093e\u0926, 10 \u092e\u0908, 2010, \u1cf0\u0926\u0928\u093e\u0902\u1cf0\u0915\u0924 \u0906\u0926\u0947\u0936 \u0907\u0938 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0915\u0947 \u0938\u092e\u1b43 \u091a\u0941\u0928\u094c\u0924\u0940 \u0915\u0947 \n\u0905\u0927\u0940\u0928 \u0939\u0948\u0964 \u0906\u1b43\u0947\u093f\u092a\u0924 \u0906\u0926\u0947\u0936 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930, \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 (1) \u091c\u0940\u0935\u0928 \u1cf2\u0938\u0939 \n\u0915\u0947 \u092a\u0941\u1ba2 \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939 \u1cc7\u093e\u0930\u093e (2) \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939 \u0915\u0947 \u092a\u0941\u1ba2 \u092e\u093e\u0928 \u1cf2\u0938\u0939 \u1cc7\u093e\u0930\u093e (3) \n\u0917\u0941\u0930\u1b5f\u092f\u0928 \u1cf2\u0938\u0939 \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939 \u0915\u0947 \u092a\u0941\u1ba2 (4) \u0936\u092e\u0936\u0947\u0930 \u1cf2\u0938\u0939 \u0915\u0947 \u092a\u0941\u1ba2 \u0938\u0941\u1cef\u0930\u1b60\u0926\u0930 \u1cf2\u0938\u0939 \n\u0914\u0930 (5) \u091c\u0940\u0935\u0928 \u1cf2\u0938\u0939 \u0915\u0947 \u092a\u0941\u1ba2 \u0928\u093e\u0928\u0915 \u1cf2\u0938\u0939 \u0915\u0947 \u1cc7\u093e\u0930\u093e \u0926\u093e\u092f\u0930 \u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u0905\u092a\u0940\u0932 \n\u0938\u0902 2001 \u0915\u1cf1 843 \u090f\u0938.\u092c\u0940 \u0915\u093e \u093f\u0928\u092a\u091f\u093e\u0930\u093e \u0915\u0930 \u1cf0\u0926\u092f\u093e \u0939\u0948,  \u093f\u091c\u0928\u092e\u1c76 \u0938\u0947 \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939 \n\u0915\u0947 \u093f\u0935\u1c67\u1ccd \u0905\u092a\u0940\u0932 \u0938\u092e\u093e\u1cd9 \u0939\u094b \u0917\u0908 \u0939\u0948\u0964 \u0906\u092a\u0930\u093e\u093f\u0927\u0915 \u092a\u0941\u0928\u0930\u0940\u1b43\u0923 \u0928. 475/2002 \u0914\u0930 \n778/2003 \u0915\u093e \u092d\u0940 \u0909\u0938\u0940 \u0906\u0926\u0947\u0936 \u1cc7\u093e\u0930\u093e \u093f\u0928\u092a\u091f\u093e\u0930\u093e \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \n\u0915\u094b \u092d\u093e\u0930\u0924\u0940\u092f \u0926\u0902\u0921 \u0938\u0902\u093f\u0939\u0924\u093e (\u0906\u0908\u092a\u0940\u0938\u0940) \u0915\u1cf1 \u0927\u093e\u0930\u093e 149 \u0915\u0947 \u0938\u093e\u0925 \u092a\u1cef\u0920\u0924 \u0927\u093e\u0930\u093e \n148,323,325 \u0914\u0930 307 \u0915\u0947 \u0924\u0939\u0924 \u1b9d\u093e\u092f\u0932 \u0915\u094b\u091f\u1b45 \u1cc7\u093e\u0930\u093e \u0926\u094b\u0937\u0940 \u0920\u0939\u0930\u093e\u092f\u093e \u0917\u092f\u093e \n\u0925\u093e\u0964\u0909\u1b60\u0939\u1c76 \u0927\u093e\u0930\u093e 149 \u0915\u0947 \u0938\u093e\u0925 \u092a\u1cef\u0920\u0924 \u0927\u093e\u0930\u093e 148 \u0915\u0947 \u0924\u0939\u0924 \u091b\u0939 \u092e\u0939\u0940\u0928\u0947 \u0915\u0947 \u0915\u0920\u094b\u0930 \n\u0915\u093e\u0930\u093e\u0935\u093e\u0938 \u0915\u1cf1 \u0938\u091c\u093e \u0938\u0941\u0928\u093e\u0908 \u0917\u0908 \u0925\u0940 \u0914\u0930 \u0938\u093e\u0925 \u0939\u0940 \u0927\u093e\u0930\u093e 149 \u0915\u0947 \u0938\u093e\u0925 \u092a\u1cef\u0920\u0924 \n\u0927\u093e\u0930\u093e 323 \u0915\u0947 \u093f\u0932\u090f, \u0927\u093e\u0930\u093e 149 \u0906\u0908\u092a\u0940\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u092a\u1cef\u0920\u0924 \u0927\u093e\u0930\u093e 325 \u0915\u0947 \u0924\u0939\u0924 \n\u0926\u094b \u0938\u093e\u0932 \u0914\u0930 \u0927\u093e\u0930\u093e 149 \u0906\u0908\u092a\u0940\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u092a\u1cef\u0920\u0924 \u0927\u093e\u0930\u093e 307 \u0915\u0947 \u0924\u0939\u0924 \u0938\u093e\u0924 \n\u0938\u093e\u0932 \u0915\u1cf1 \u0938\u091c\u093e \u0938\u0941\u0928\u093e\u0908 \u0917\u0908 \u0925\u0940\u0964 \n3. \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 10 \u092e\u0908, 2010 \u0915\u0947 \u0906\u0926\u0947\u0936 \u1cc7\u093e\u0930\u093e \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u1cf1 \u0905\u092a\u0940\u0932 \n\u0916\u093e\u1cef\u0930\u091c \u0915\u0930 \u0926\u0940\u0964  \u0924\u0925\u093e\u093f\u092a, 28 \u092e\u0908, 2010, \u1cf0\u0926\u0928\u093e\u0902\u1cf0\u0915\u0924 \u092a\u1cdf\u093e\u0924\u0935\u0924\u1c6e \u0906\u0926\u0947\u0936 \u1cc7\u093e\u0930\u093e, \n\n2 \n \n\u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u0938\u091c\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u092d\u093e\u0917 \u0915\u094b \u0938\u0902\u0936\u094b\u093f\u0927\u0924 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \n\u0909\u1ca6 \u0909\u092a\u093e\u0902\u0924\u0930\u0923 \u0915\u0947 \u093f\u0932\u090f \u0915\u0939\u093e \u0917\u092f\u093e \u0915\u093e\u0930\u0923 \u092f\u0939 \u0925\u093e \u1cf0\u0915 \u0915\u093f\u0925\u0924 \u0905\u092a\u0940\u0932 \u092e\u1c76 28 \n\u092e\u0908, 2010, \u1cf0\u0926\u0928\u093e\u0902\u1cf0\u0915\u0924 \u090f\u0915 \u0905\u0902\u0924\u1cef\u0930\u092e \u0906\u0926\u0947\u0936 \u092a\u093e\u1cef\u0930\u0924 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u091c\u094b \n\u092d\u093e\u0930\u0924\u0940\u092f \u0926\u0902\u0921 \u0938\u0902\u093f\u0939\u0924\u093e \u0915\u1cf1 \u0927\u093e\u0930\u093e 149 \u0915\u0947 \u0938\u093e\u0925 \u092a\u1cef\u0920\u0924 \u0927\u093e\u0930\u093e 307 \u0915\u0947 \u0924\u0939\u0924 \n\u0926\u0902\u0921\u093e\u0926\u0947\u0936 \u0915\u094b \u0938\u093e\u0924 \u0935\u0937\u1b45 \u0938\u0947 \u0918\u091f\u093e\u0915\u0930 \u092a\u093e\u0902\u091a \u0935\u0937\u1b45 \u0915\u0930 \u1cf0\u0926\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u0932\u0947\u1cf0\u0915\u0928 \u0909\u1ca6 \n\u0909\u092a\u093e\u0902\u0924\u0930\u0923 \u0915\u094b \u093f\u0935\u1b6d\u0924\u0943\u0924 \u093f\u0928\u0923\u1b45\u092f \u092e\u1c76 \u0936\u093e\u093f\u092e\u0932 \u0928\u0939\u1c6d \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \n4. \u092f\u0939 \u090f\u0915 \u0910\u0938\u093e \u092e\u093e\u092e\u0932\u093e \u0939\u0948 \u093f\u091c\u0938\u092e\u1c76 \u0926\u094b\u0928\u1c82 \u092a\u1b43\u1c82 \u0915\u094b \u091a\u094b\u091f\u1c76 \u0906\u1c8a\u0964 \u090f\u092b\u0906\u0908\u0906\u0930 \n\u0928\u0902.75 \u0924\u093e\u0930\u0940\u0916 27.3.1997 \u091c\u0917\u0926\u0940\u0936 \u091a\u0902\u0926 \u0915\u0947 \u093f\u0936\u0915\u093e\u092f\u0924 \u092a\u0930 \u0926\u091c\u1b45 \u0915\u1cf1 \u0917\u092f\u0940 \u0925\u0940, \n\u093f\u091c\u0938\u092e\u1c76 \u091c\u0917\u0926\u0940\u0936 \u091a\u0902\u0926 \u0928\u0947 \u0906\u0930\u094b\u092a \u0932\u0917\u093e\u092f\u093e \u1cf0\u0915 27.3.1997 \u0915\u1cf1 \u0938\u0941\u092c\u0939 \u0932\u0917\u092d\u0917 \n8.00 \u092c\u091c\u0947 \u0938\u0941\u0930\u1c76\u1ba4 \u1cf2\u0938\u0939 \u0928\u0947 \u093f\u0935\u0935\u093e\u1cf0\u0926\u0924 \u092e\u093e\u0917\u1b45, \u0918\u0930 \u0915\u0947 \u092c\u093e\u0930\u093e \u0938\u0947 \u0905\u092a\u0928\u0940 \u1b9d\u0948\u1b4d\u091f\u0930 \u1b9d\u0949\u0932\u0940 \n\u091a\u0932\u093e\u0928\u0947 \u0915\u1cf1 \u0915\u094b\u093f\u0936\u0936 \u0915\u1cf1\u0964 \u091c\u0917\u0926\u0940\u0936 \u091a\u0902\u0926 \u0915\u0947 \u092d\u0924\u0940\u091c\u0947 \u0930\u093e\u091c\u0947\u0936 \u0915\u0941\u092e\u093e\u0930 \u0928\u0947 \u0909\u1b60\u0939\u1c76 \u0910\u0938\u093e \n\u0928\u0939\u1c6d \u0915\u0930\u0928\u0947 \u0915\u0947 \u093f\u0932\u090f \u0915\u0939\u093e\u0964 \u0906\u0930\u094b\u092a\u0940 \u092e\u093e\u0928 \u1cf2\u0938\u0939, \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939, \u0928\u093e\u0928\u0915 \u1cf2\u0938\u0939 \u0914\u0930 \n\u0917\u0941\u0930\u093f\u0927\u092f\u093e\u0928 \u1cf2\u0938\u0939 \u1b9d\u0948\u1b4d\u091f\u0930 \u1b9d\u0949\u0932\u0940 \u092e\u1c76 \u092c\u0948\u0920\u0947 \u0925\u0947\u0964 \u0909\u1b60\u0939\u1c82\u0928\u0947 \u0930\u093e\u091c\u0947\u0936 \u0915\u0941\u092e\u093e\u0930 \u0914\u0930 \u091c\u0917\u0926\u0940\u0936 \n\u091a\u0902\u0926 \u092a\u0930 \u0932\u093e\u0920\u0940 \u0938\u0947 \u0939\u092e\u0932\u093e \u1cf0\u0915\u092f\u093e\u0964\u0907\u0938\u0915\u0947 \u092c\u093e\u0926, \u0932\u093e\u091c\u0935\u0902\u0924\u0940 (\u0930\u093f\u0935 \u0915\u0941\u092e\u093e\u0930, \u0930\u093e\u091c\u0947\u0936 \n\u0915\u0941\u092e\u093e\u0930 \u0914\u0930 \u0938\u0902\u091c\u0940\u0935 \u0915\u0941\u092e\u093e\u0930 \u0915\u1cf1 \u092e\u093e\u0902) \u0915\u0947 \u093f\u0938\u0930 \u092a\u0930 \u0932\u093e\u0920\u0940 \u091a\u0932\u093e\u0908 \u0917\u0908\u0964\u0936\u094b\u0930 \u092e\u091a\u093e\u0928\u0947 \n\u092a\u0930, \u0930\u093f\u0935 \u0915\u0941\u092e\u093e\u0930 \u0914\u0930 \u0938\u0902\u091c\u0940\u0935 \u0915\u0941\u092e\u093e\u0930 (\u091c\u0917\u0926\u0940\u0936 \u091a\u0902\u0926 \u0915\u0947 \u092d\u0924\u0940\u091c\u0947) \u0909\u1b60\u0939\u1c76 \u092c\u091a\u093e\u0928\u0947 \n\u0906\u090f\u0964\u0917\u0941\u0930\u093f\u0927\u092f\u093e\u0928 \u1cf2\u0938\u0939 \u0928\u0947 \u0930\u093e\u091c\u0947\u0936 \u0915\u0941\u092e\u093e\u0930 \u0915\u0947 \u093f\u0938\u0930 \u092a\u0930 \u0915\u1b6d\u0938\u0940 (\u0915\u0941\u0926\u093e\u0932) \n\u092e\u093e\u0930\u0940\u0964\u0928\u093e\u0928\u0915 \u1cf2\u0938\u0939 \u0928\u0947 \u0930\u093f\u0935 \u0915\u0941\u092e\u093e\u0930 \u0915\u094b \u0932\u093e\u0920\u0940 \u092e\u093e\u0930\u0940, \u091c\u092c\u1cf0\u0915 \u0938\u0941\u1cf3\u0930\u0926\u0930 \u1cf2\u0938\u0939 \u0928\u0947 \n\u0938\u0902\u091c\u0940\u0935 \u0915\u0941\u092e\u093e\u0930 \u0915\u094b \u0932\u093e\u0920\u0940 \u092e\u093e\u0930\u0940\u0964 \u0936\u094b\u0930 \u0936\u0930\u093e\u092c\u093e \u0938\u0941\u0928\u0915\u0930 \u1b95\u093e\u092e\u0940\u0923\u1c82 \u0915\u1cf1 \u092d\u0940\u095c \u091c\u092e\u093e \n\u0939\u094b \u0917\u0908\u0964\u0918\u093e\u092f\u0932\u1c82 \u0915\u094b \u0905\u1b6d\u092a\u0924\u093e\u0932 \u0932\u0947 \u091c\u093e\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u0909\u0928\u0915\u1cf1 \u093f\u091a\u1cf0\u0915\u1b5c\u0938\u0915\u1cf1\u092f \u091c\u093e\u0902\u091a \n\u0915\u1cf1 \u0917\u0908\u0964 \n5. \u0907\u0938\u0915\u0947 \u093f\u0935\u092a\u0930\u0940\u0924, \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u094b \u0915\u0908 \u091a\u094b\u091f\u1c76 \u0906\u1c8a\u0964 \u092a\u0940\u090f\u091a\u0938\u0940 \u092a\u0902\u091c\u094b\u0915\u0930\u093e \u092e\u1c76 \n\u0909\u0928\u0915\u1cf1 \u093f\u091a\u1cf0\u0915\u1b5c\u0938\u0915\u1cf1\u092f \u091c\u093e\u0902\u091a \u092d\u0940 \u0915\u1cf1 \u0917\u0908\u0964 \n6. \u092c\u091a\u093e\u0935 \u092a\u1b43 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930, \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939 \u0915\u1cf1 \u092a\u1cc0\u0940 \u0939\u0930\u092c\u0902\u0938 \u0915\u094c\u0930 \u0914\u0930 \u0932\u093e\u091c\u0935\u0902\u0924\u0940 \n\u0915\u0947 \u092c\u0940\u091a \u091d\u0917\u095c\u093e \u1c5f\u0906 \u0925\u093e\u0964 \u0928\u0924\u0940\u091c\u0924\u0928, \u0926\u094b\u0928\u1c82 \u092a\u1b43\u1c82 \u0915\u0947 \u092a\u0941\u1c67\u0937 \u0938\u0926\u1b6d\u092f \u090f\u0915\u1ba2 \u0939\u094b \n\u0917\u090f \u0914\u0930 \u1b6d\u0935\u0924\u0902\u1ba2 \u0932\u095c\u093e\u0908 \u1c5f\u0908\u0964 \n7. \u092a\u1b43\u1c82 \u0915\u0947 \u092c\u0940\u091a \u093f\u0935\u0935\u093e\u0926, \u091c\u0948\u0938\u093e \u1cf0\u0915 \u0926\u093e\u0935\u093e \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e,  \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \n\u1cc7\u093e\u0930\u093e \u093f\u0935\u0935\u093e\u1cf0\u0926\u0924 \u092e\u093e\u0917\u1b45 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0938\u0902\u0926\u092d\u1b45 \u092e\u1c76 \u0925\u093e\u0964 \u091a\u0942\u0902\u1cf0\u0915 \u0932\u095c\u093e\u0908 \u092e\u1c76 \u0926\u094b\u0928\u1c82 \n\u092a\u1b43\u1c82 \u0915\u094b \u091a\u094b\u091f\u1c76 \u0906\u1c8a, \u0907\u0938\u093f\u0932\u090f \u092f\u0939 \u0928\u0939\u1c6d \u092e\u093e\u0928\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u1cf0\u0915 \u0910\u0938\u0940 \u0915\u094b\u0908 \n\u0918\u091f\u0928\u093e \u0928\u0939\u1c6d \u1c5f\u0908 \u0925\u0940\u0964 \n8. \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u0947 \u093f\u0935\u1cc7\u093e\u0928 \u0905\u093f\u0927\u0935\u1ca6\u093e \u1cc7\u093e\u0930\u093e \u0909\u0920\u093e\u092f\u093e \u0917\u092f\u093e \u0924\u0915\u1b45 \u092f\u0939 \u0925\u093e \u1cf0\u0915 \n\u0939\u093e\u0925 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76, \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0906\u1b93\u093e\u092e\u0915 \u0925\u093e \u1b4d\u092f\u1c82\u1cf0\u0915 \u1cf0\u0926\u0928-\u1ba7\u093f\u0924\u1cf0\u0926\u0928 \u0915\u0947 \n\u0906\u0927\u093e\u0930 \u092a\u0930 \u0935\u0947 \u0909\u1b60\u0939\u1c76 \u0921\u093e\u0902\u091f\u0924\u0947 \u0925\u0947 \u091c\u092c \u0935\u0947 \u092d\u0942\u093f\u092e \u092a\u0930 \u092e\u093e\u0917\u1b45 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \n\u0925\u0947, \u091c\u094b \u1cf0\u0915 \u1b95\u093e\u092e \u092a\u0902\u091a\u093e\u092f\u0924 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u0948\u0964\u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u092d\u0942\u093f\u092e \u0915\u0947 \u0909\u0938 \n\u093f\u0939\u1b6d\u0938\u0947 \u0915\u094b \u0905\u092a\u0928\u093e \u092e\u093e\u0928 \u0930\u0939\u093e \u0925\u093e\u0964\u0935\u093e\u1b6d\u0924\u0935 \u092e\u1c76, 27.3.1997 \u0915\u094b \u0918\u091f\u0928\u093e \u0915\u0947 \u0924\u0941\u0930\u0902\u0924 \n\n3 \n \n\u092c\u093e\u0926 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43\u0915\u093e\u0930, \u0905\u0925\u093e\u1b45\u0924\u094d \u0915\u0941\u0902\u0926\u0928 \u0915\u0947 \u092a\u0941\u1ba2 \u091c\u0917\u0926\u0940\u0936 \u091a\u0902\u0926 \u0914\u0930 \u0915\u0943\u1b6c\u0923 \n\u1cc7\u093e\u0930\u093e \u0905\u091c\u092e\u0947\u0930 \u1cf2\u0938\u0939, \u091c\u0940\u0935\u0928 \u1cf2\u0938\u0939 \u0914\u0930 \u1b5f\u092f\u093e\u0928 \u1cf2\u0938\u0939 \u0915\u0947 \u092a\u0941\u1ba2 \u0928\u093e\u0928\u0915 \u1cf2\u0938\u0939, \u0905\u091c\u092e\u0947\u0930 \n\u1cf2\u0938\u0939 \u0915\u0947 \u092a\u0941\u1ba2 \u092e\u093e\u0928 \u1cf2\u0938\u0939 \u0914\u0930 \u0936\u092e\u0936\u0947\u0930 \u0915\u0947 \u092a\u0941\u1ba2 \u0938\u0941\u0930\u1c76\u1ba4 \u1cf2\u0938\u0939 \u0915\u0947 \u093f\u0935\u1c67\u1ccd \u1b6d\u0925\u093e\u092f\u0940 \n\u1cde\u093e\u0926\u0947\u0936 \u0915\u0947 \u093f\u0932\u090f \u090f\u0915 \u0926\u0940\u0935\u093e\u0928\u0940 \u092e\u0941\u0915\u0926\u092e\u093e \u0926\u093e\u092f\u0930 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0935\u093e\u0926 \u092e\u1c76 \n\u1ba7\u093e\u0925\u1b45\u0928\u093e \u092f\u0939 \u0925\u0940 \u1cf0\u0915 \u0909\u0938\u092e\u1c76 \u1ba7\u093f\u0924\u0935\u093e\u1cf0\u0926\u092f\u1c82 \u0915\u094b \u0935\u093e\u0926\u0940 \u0915\u0947 \u092c\u093e\u0930\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u092e\u093e\u0917\u1b45 \n\u0915\u0947 \u1c68\u092a \u092e\u1c76 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u093e \u091c\u093e\u090f\u0964\u0935\u093e\u0926 31.3.1997 \u0915\u094b \u0926\u093e\u092f\u0930 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \n\u093f\u091c\u0938\u0947 15.1.2003 \u0915\u094b \u0916\u093e\u1cef\u0930\u091c \u0915\u0930 \u1cf0\u0926\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964\u0916\u0938\u0930\u093e \u0928\u0902.117 \u0938\u0947 \u0938\u0902\u092c\u0902\u093f\u0927\u0924 \n\u0935\u093e\u0926\u0940 \u0915\u0947 \u092a\u1b43 \u092e\u1c76 \u1cde\u093e\u0926\u0947\u0936 \u0915\u1cf1 \u0915\u094b\u0908 \u093f\u0921\u1b93\u1cf1 \u092a\u093e\u1cef\u0930\u0924 \u0928\u0939\u1c6d \u0915\u1cf1 \u0917\u0908 \u0925\u0940 , \u093f\u091c\u0938\u0947 \n\u0935\u093e\u0926\u0940 \u0915\u1cf1 \u0938\u0902\u092a\u093f\u1c6b \u0939\u094b\u0928\u0947 \u0915\u093e \u0926\u093e\u0935\u093e \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u1b4d\u092f\u1c82\u1cf0\u0915 \u092f\u0939 \u1b95\u093e\u092e \u092a\u0902\u091a\u093e\u092f\u0924 \n\u0915\u0947 \u1b6d\u0935\u093e\u093f\u092e\u1b5c\u0935 \u092e\u1c76 \u092a\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u0914\u0930 \u0930\u1cf0\u092b\u092f\u093e\u092e \u0915\u0947 \u093f\u0932\u090f \u0906\u0930\u093f\u1b43\u0924 \u0925\u093e\u0964 \n9. \u0909\u1b60\u0939\u1c82\u0928\u0947 \u0906\u0917\u0947 \u1ba7\u1b6d\u0924\u0941\u0924 \u1cf0\u0915\u092f\u093e \u1cf0\u0915 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u092a\u1b43 \u0915\u0947 \u0915\u0908 \u1cde\u093f\u1ca6\u092f\u1c82 \u0915\u094b \u092d\u0940 \n\u091a\u094b\u091f\u1c76 \u0906\u1c8a \u0914\u0930 \u0909\u0928\u092e\u1c76 \u0938\u0947 \u0915\u0941\u091b \u0917\u0902\u092d\u0940\u0930 \u092a\u093e\u090f \u0917\u090f\u0964 \u0939\u093e\u0932\u093e\u0902\u1cf0\u0915, \u0928\u0940\u091a\u0947 \u0915\u1cf1 \u0905\u0926\u093e\u0932\u0924\u1c76 \n\u0907\u0938 \u092a\u0930 \u093f\u0935\u091a\u093e\u0930 \u0915\u0930\u0928\u0947 \u092e\u1c76 \u093f\u0935\u092b\u0932 \u0930\u0939\u0940 \u0939\u1c79\u0964\u0926\u0930\u0905\u0938\u0932, \u092f\u0939 \u0906\u1b5c\u092e\u0930\u1b43\u093e \u0915\u093e \u092e\u093e\u092e\u0932\u093e \n\u0925\u093e\u0964\u0918\u091f\u0928\u093e \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0915\u0947 \u092a\u1cef\u0930\u0938\u0930 \u0915\u0947 \u092c\u093e\u0939\u0930 \u1c5f\u0908 \u0925\u0940, \u0907\u0938\u093f\u0932\u090f \n\u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u094b \u0906\u1b93\u093e\u092e\u0915 \u0928\u0939\u1c6d \u0915\u0939\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0907\u0930\u093e\u0926\u093e \u1b6d\u0925\u093e\u093f\u092a\u0924 \u0928\u0939\u1c6d \n\u1cf0\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u1b4d\u092f\u1c82\u1cf0\u0915 \u1cf0\u0915\u0938\u0940 \u0939\u093f\u0925\u092f\u093e\u0930 \u0915\u093e \u0907\u1b6d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u1c6d \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \n\u0925\u093e\u0964\u0935\u0947 \u0915\u0947\u0935\u0932 \u0905\u092a\u0928\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u0947 \u0915\u0943\u093f\u0937 \u0909\u092a\u0915\u0930\u0923 \u0932\u0947 \u091c\u093e \u0930\u0939\u0947 \u0925\u0947 \u0914\u0930 \u0916\u0947\u0924\u1c82 \u092e\u1c76 \n\u091c\u093e\u0928\u0947 \u0915\u093e \u092f\u0939 \u0938\u093e\u092e\u093e\u1b60\u092f \u0938\u092e\u092f \u0925\u093e \u1b4d\u092f\u1c82\u1cf0\u0915 \u0918\u091f\u0928\u093e \u0932\u0917\u092d\u0917 8.00 a.m. \u092a\u0930 \u1c5f\u0908 \n\u0925\u0940\u0964 \u0906\u0930\u094b\u092a \u092f\u0939 \u0939\u0948 \u1cf0\u0915 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u1b9d\u0948\u1b4d\u091f\u0930 \u1b9d\u0949\u0932\u0940 \u092e\u1c76 \u091c\u093e \u0930\u0939\u0947 \u0925\u0947, \u091c\u092c \n\u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0915\u0947 \u0909\u0915\u0938\u093e\u0935\u0947 \u092a\u0930, \u0918\u091f\u0928\u093e \u1c5f\u0908\u0964 \n10. \u0926\u0942\u0938\u0930\u0940 \u0913\u0930, \u0930\u093e\u1b54\u092f \u0915\u0947 \u093f\u0935\u1cc7\u093e\u0928 \u0905\u093f\u0927\u0935\u1ca6\u093e \u0915\u093e \u0924\u0915\u1b45 \u0925\u093e \u1cf0\u0915 \u092f\u0939 \u090f\u0915 \u0910\u0938\u093e \n\u092e\u093e\u092e\u0932\u093e \u0939\u0948 \u093f\u091c\u0938\u092e\u1c76 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u1c90 \u0915\u094b \u0906\u1b93\u093e\u092e\u0915 \u092a\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964\u0909\u1b60\u0939\u1c82\u0928\u0947 \n\u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0915\u094b \u0917\u0902\u092d\u0940\u0930 \u091a\u094b\u091f\u1c76 \u092a\u1c5f\u0902\u091a\u093e\u0908 \u0925\u1c6d\u0964\u092d\u0932\u0947 \u0939\u0940 \u0909\u1b60\u0939\u1c76 \u0915\u0941\u091b \u091a\u094b\u091f\u1c76 \u0906\u1c8a, \n\u0932\u0947\u1cf0\u0915\u0928 \u0935\u0947 \u093f\u0928\u091c\u0940 \u0930\u1b43\u093e \u0915\u0947 \u0905\u092a\u0928\u0947 \u0905\u093f\u0927\u0915\u093e\u0930 \u0915\u093e \u1ba7\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964\u0918\u093e\u092f\u0932 \n\u0917\u0935\u093e\u0939\u1c82 \u0915\u0947 \u092c\u092f\u093e\u0928\u1c82 \u0915\u0947 \u1c68\u092a \u092e\u1c76 \u0938\u093e\u1b6f\u092f \u0915\u094b \u0916\u093e\u1cef\u0930\u091c \u0928\u0939\u1c6d \u1cf0\u0915\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \n\u0918\u093e\u092f\u0932 \u0917\u0935\u093e\u0939\u1c82 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e, \u1b6d\u0935\u0924\u0902\u1ba2 \u0917\u0935\u093e\u0939\u1c82 \u0915\u094b \u092d\u0940 \u092a\u0947\u0936 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u093f\u091c\u1b60\u0939\u1c82\u0928\u0947 \n\u0905\u093f\u092d\u092f\u094b\u091c\u0928 \u092a\u1b43 \u0915\u0947 \u092c\u092f\u093e\u0928 \u0915\u1cf1 \u092a\u0941\u093f\u1ce5 \u0915\u1cf1 \u0964 \n11. \u092a\u1b43\u1c82 \u0915\u0947 \u093f\u0935\u1cc7\u093e\u0928 \u0905\u093f\u0927\u0935\u1ca6\u093e \u0915\u094b \u0938\u0941\u0928\u093e \u0914\u0930 \u0905\u093f\u092d\u0932\u0947\u0916 \u092a\u0930 \u0938\u093e\u092e\u1b95\u0940 \u0915\u093e \n\u0905\u1b5f\u092f\u092f\u0928 \u1cf0\u0915\u092f\u093e\u0964 \n12. \u0918\u091f\u0928\u093e \u0915\u1cf1 \u0924\u093e\u0930\u0940\u0916 \u0915\u094b \u0932\u0947\u0915\u0930 \u0915\u094b\u0908 \u093f\u0935\u0935\u093e\u0926 \u0928\u0939\u1c6d \u0939\u0948\u0964 \u092f\u0939 \u092d\u0940 \u1cef\u0930\u0915\u0949\u0921\u1b45 \u092a\u0930 \n\u0928\u0939\u1c6d \u0906\u092f\u093e \u0939\u0948 \u1cf0\u0915 \u093f\u091c\u0928 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u1c90 \u0915\u094b \u0939\u092e\u0932\u093e\u0935\u0930 \u0915\u0939\u093e \u0917\u092f\u093e \u0925\u093e \u0914\u0930 \n\u093f\u091c\u1b60\u0939\u1c76 \u0926\u094b\u0937\u0940 \u0920\u0939\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u0909\u1b60\u0939\u1c82\u0928\u0947 \u1cf0\u0915\u0938\u0940 \u092d\u0940 \u0939\u093f\u0925\u092f\u093e\u0930 \u0915\u093e \u0907\u1b6d\u0924\u0947\u092e\u093e\u0932 \n\u1cf0\u0915\u092f\u093e \u0925\u093e \u092f\u093e \u0935\u0947 \u0905\u092a\u0928\u0947 \u092a\u0942\u0935\u1b45 \u093f\u0928\u0927\u093e\u1b45\u1cef\u0930\u0924 \u1cf0\u0926\u092e\u093e\u0917 \u0915\u0947 \u0938\u093e\u0925 \u0918\u091f\u0928\u093e \u1b6d\u0925\u0932 \u092a\u0930 \u0917\u090f \n\u0925\u0947\u0964  \u092f\u0939\u093e\u0902 \u0924\u0915 \u1cf0\u0915 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u1cc7\u093e\u0930\u093e \u1b6d\u0925\u093e\u093f\u092a\u0924 \u092e\u093e\u092e\u0932\u093e \u092f\u0939 \u0925\u093e \u1cf0\u0915 \u0935\u0947 \n\u090f\u0915 \u1b9d\u0949\u0932\u0940 \u092e\u1c76 \u092e\u093e\u0917\u1b45 \u0938\u0947 \u0917\u0941\u091c\u0930 \u0930\u0939\u0947 \u0925\u0947\u0964\u0932\u095c\u093e\u0908 \u092e\u1c76 \u0915\u093f\u0925\u0924 \u0924\u094c\u0930 \u092a\u0930 \u0932\u093e\u0920\u0940 \u0914\u0930 \n\n4 \n \n\u0915\u1b6d\u0938\u0940 (\u0915\u0941\u0926\u093e\u0932) \u0915\u093e \u0907\u1b6d\u0924\u0947\u092e\u093e\u0932 \u1cf0\u0915\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u092f\u0947 \u0938\u093e\u092e\u093e\u1b60\u092f \u0915\u0943\u093f\u0937 \u0909\u092a\u0915\u0930\u0923 \u0939\u1c79 \n\u091c\u094b \u1b95\u093e\u092e\u0940\u0923 \u1b43\u0947\u1ba2\u1c82 \u092e\u1c76 \u0909\u092a\u092f\u094b\u0917 \u1cf0\u0915\u090f \u091c\u093e\u0924\u0947 \u0939\u1c79, \u093f\u091c\u1b60\u0939\u1c76 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0905\u092a\u0928\u0940 \n\u1b9d\u0949\u0932\u0940 \u092e\u1c76 \u0932\u0947 \u091c\u093e \u0930\u0939\u0947 \u0925\u0947\u0964 \n13. \u091c\u0948\u0938\u093e \u1cf0\u0915 \u0905\u093f\u092d\u0932\u0947\u0916 \u0938\u0947 \u1b6d\u092a\u1ce5 \u0939\u0948, \u093f\u0935\u0935\u093e\u0926 \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u1cc7\u093e\u0930\u093e \u092e\u093e\u0917\u1b45 \u0915\u0947 \n\u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u1c76 \u0925\u093e \u093f\u091c\u0938\u0947 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0905\u092a\u0928\u093e \u0939\u094b\u0928\u0947 \u0915\u093e \u0926\u093e\u0935\u093e \u0915\u0930 \n\u0930\u0939\u093e \u0925\u093e\u0964 \u090f\u0915 \u0905\u1b60\u092f \u0924\u1b5d\u092f \u091c\u094b \u1cef\u0930\u0915\u0949\u0921\u1b45 \u092e\u1c76 \u0906\u092f\u093e \u0939\u0948,  \u0935\u0939 \u092f\u0939 \u0939\u0948 \u1cf0\u0915 \u0918\u091f\u0928\u093e \u0915\u0947 \n\u0924\u0941\u0930\u0902\u0924 \u092c\u093e\u0926 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u1cc7\u093e\u0930\u093e \u0926\u093e\u092f\u0930 \u090f\u0915 \u0926\u0940\u0935\u093e\u0928\u0940 \u092e\u093e\u092e\u0932\u0947 \u092e\u1c76 \u090f\u0915 \u093f\u0921\u1b93\u1cf1 \n\u0939\u0948, \u093f\u091c\u0938\u092e\u1c76 \u092f\u0939 \u092e\u093e\u0928\u093e \u0917\u092f\u093e \u0925\u093e \u1cf0\u0915 \u092e\u093e\u0917\u1b45 \u1b95\u093e\u092e \u092a\u0902\u091a\u093e\u092f\u0924 \u0915\u093e \u0939\u0948 \u0914\u0930 \u0935\u0939\u0940 \n\u0930\u1cf0\u092b\u092f\u093e\u092e \u0939\u0948\u0964 \n14. \u0907\u0938\u092e\u1c76 \u0915\u094b\u0908 \u0938\u0902\u0926\u0947\u0939 \u0928\u0939\u1c6d \u0939\u0948 \u1cf0\u0915 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0915\u094b \u091a\u094b\u091f\u1c76 \u0932\u0917\u0940 \u0939\u1c79\u0964 \n\u0939\u093e\u0932\u093e\u0902\u1cf0\u0915, \u0924\u1b5d\u092f \u092f\u0939 \u0939\u0948 \u1cf0\u0915 \u0906\u0930\u094b\u092a\u0940 \u092a\u1b43 \u0915\u094b \u092d\u0940 \u091a\u094b\u091f\u1c76 \u0906\u0908 \u0939\u1c79\u0964\u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \n\u0915\u0947 \u093f\u0928\u0923\u1b45\u092f \u092e\u1c76, \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u094b \u0932\u0917\u0940 \u091a\u094b\u091f\u1c82 \u092a\u0930 \u0909\u093f\u091a\u0924 \u093f\u0935\u091a\u093e\u0930 \u0928\u0939\u1c6d \u1cf0\u0915\u092f\u093e \n\u0917\u092f\u093e \u0939\u0948\u0964 \u092a\u0942\u0930\u093e \u091c\u094b\u0930 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u1cc7\u093e\u0930\u093e \u091d\u0947\u0932\u0940 \u0917\u0908 \u091a\u094b\u091f\u1c82 \u092f\u093e \u0909\u0928\u0915\u0947 \u0928\u0947\u0924\u0943\u1b5c\u0935 \n\u092e\u1c76 \u0938\u092c\u0942\u0924 \u092a\u0930 \u0939\u0948\u0964\u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u1cf1 \u1ba7\u093f\u0924\u0930\u1b43\u093e \u0915\u094b \u091b\u0941\u0906 \u0928\u0939\u1c6d \u0917\u092f\u093e \u0939\u0948\u0964 \u0909\u1cac \n\u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u0928\u0947 \u092f\u0939 \u092d\u0940 \u092e\u0924 \u0925\u093e \u1cf0\u0915 \u0918\u091f\u0928\u093e \u0915\u1cf1 \u091c\u0917\u0939 \u092c\u093e\u0930\u093e \u0914\u0930 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \n\u092a\u1b43 \u0915\u0947 \u0918\u0930 \u0915\u0947 \u092c\u0940\u091a \u0915\u1cf1 \u091c\u0917\u0939 \u0925\u0940\u0964 \u092e\u0941\u1cce\u093e \u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u1cc7\u093e\u0930\u093e \u092a\u093e\u1cef\u0930\u0924 \u092e\u093e\u0917\u1b45 \n\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0925\u093e \u093f\u091c\u0938 \u092a\u0930 \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0906\u092a\u093f\u1c6b \u0909\u0920\u093e \u0930\u0939\u093e \u0925\u093e\u0964 \n15. \u0905\u093f\u092d\u0932\u0947\u0916 \u092a\u0930 \u0909\u0938 \u0938\u093e\u092e\u1b95\u0940 \u0915\u094b \u1b5f\u092f\u093e\u0928 \u092e\u1c76 \u0930\u0916\u0924\u0947 \u1c5f\u090f, \u093f\u091c\u0938 \u092a\u0930 \u090a\u092a\u0930 \u091a\u091a\u093e\u1b45 \n\u0915\u1cf1 \u0917\u0908 \u0939\u0948, \u091c\u0939\u093e\u0902 \u0926\u094b\u0928\u1c82 \u092a\u1b43\u1c82 \u0915\u094b \u1b6d\u0935\u0924\u0902\u1ba2 \u0932\u095c\u093e\u0908 \u092e\u1c76 \u091a\u094b\u091f\u1c76 \u0906\u1c8a \u0914\u0930 \u092e\u093e\u0917\u1b45, \u091c\u094b \n\u0932\u095c\u093e\u0908 \u0915\u093e \u092e\u0942\u0932 \u0915\u093e\u0930\u0923 \u0925\u093e, \u0915\u094b \u1b95\u093e\u092e \u092a\u0902\u091a\u093e\u092f\u0924 \u0914\u0930 \u0930\u1cf0\u092b\u092f\u093e\u092e \u0915\u0947 \u1b6d\u0935\u093e\u093f\u092e\u1b5c\u0935 \n\u0935\u093e\u0932\u093e \u092e\u093e\u0917\u1b45 \u092e\u093e\u0928\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u091c\u094b \u093f\u0936\u0915\u093e\u092f\u0924\u0915\u0924\u093e\u1b45 \u092a\u1b43 \u0938\u0947 \u0938\u0902\u092c\u0902\u093f\u0927\u0924 \u0928\u0939\u1c6d \u0939\u0948, \n\u0939\u092e\u093e\u0930\u0940 \u0930\u093e\u092f \u092e\u1c76, \u0905\u092a\u0940\u0932\u093e\u1cf6\u0925\u092f\u1c82 \u0915\u1cf1 \u0926\u094b\u0937\u093f\u0938\u093f\u1ccd \u0914\u0930 \u0938\u091c\u093e \u0915\u094b \u0915\u093e\u0928\u0942\u0928\u0940 \u1c68\u092a \u0938\u0947 \n\u0915\u093e\u092f\u092e \u0928\u0939\u1c6d \u0930\u0916\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0905\u092a\u0940\u0932\u1c82 \u0915\u094b \u0924\u0926\u0928\u0941\u0938\u093e\u0930 \u0905\u0928\u0941\u092e\u093f\u0924 \u0926\u0940 \u091c\u093e\u0924\u0940 \n\u0939\u0948\u0964\u093f\u0935\u091a\u093e\u0930\u0923 \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u092a\u093e\u1cef\u0930\u0924 \u0914\u0930 \u0909\u1cac \u1b60\u092f\u093e\u092f\u093e\u0932\u092f \u1cc7\u093e\u0930\u093e \u092a\u0941\u093f\u1ce5 \u1cf0\u0915\u090f \u0917\u090f \n\u0926\u094b\u0937\u093f\u0938\u093f\u1ccd \u0914\u0930 \u0926\u0902\u0921\u093e\u0926\u0947\u0936 \u0915\u0947 \u093f\u0928\u0923\u1b45\u092f \u0914\u0930 \u0906\u0926\u0947\u0936 \u0915\u094b \u0905\u092a\u093e\u1b6d\u0924 \u0915\u0930 \u1cf0\u0926\u092f\u093e \u091c\u093e\u0924\u093e \n\u0939\u0948\u0964\u0905\u092a\u0940\u0932\u0915\u0924\u093e\u1b45\u0917\u0923 \u0915\u0947 \u091c\u092e\u093e\u0928\u0924 \u092c\u0902\u0927-\u092a\u1ba2\u1c82 \u0915\u094b \u093f\u0921\u1b6d\u091a\u093e\u091c\u1b45 \u1cf0\u0915\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964  \n                                                           \n \n ................... \u091c\u0947. \n [\u0905\u092d\u092f \u090f\u0938. \u0913\u0915\u093e] \n                                                              \n \n  ..\u2026.............. \u091c\u0947.  \n[\u0930\u093e\u091c\u0947\u0936 \u1cf2\u092c\u0926\u0932] \n\u0928\u0908 \u1cf0\u0926\u1b68\u0932\u0940\u096411 \u0905\u1ba7\u0948\u0932, 2023 \nvLohdj.k%& LFkkuh; Hkk\u2019kk esa vuqokfnr fu.k;Z oknh ds lhfer mi;ksx ds fy, gS rkfd og viuh Hkk\u2019kk esa bls le> lds vkSj \nfdlh vU; m|s\u201d; ds fy, bldk mi;ksx ugha fd;k tk ldrk gSA  lHkh O;ogkfjd vkSj vkf/kdkfjd m|s\u201d;ks ds fy, fu.kZ; dk \nvaxzsth laLdj.k izkekf.kd gksxk vkSj fu\u2019iknu vkSj dk;kZUo;u ds m)s\u201d; ds fy, mi;qDr jgsxkA \n"
